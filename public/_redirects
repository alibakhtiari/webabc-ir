# /public/_redirects

# Root `/` is handled by worker.ts (geo-based locale redirect: fa for Iran/
# Afghanistan/Tajikistan, ar for Arabic-speaking countries, en otherwise) —
# not here, so there's no rule for it in this file.

# Old Next.js site used "seo-title-analyzer" as the slug; renamed on Astro migration.
# Targets carry a trailing slash so this is a single 301 hop, not a 301 into a
# second 307 (the server enforces trailing-slash URLs as canonical).
/en/tools/seo-title-analyzer  /en/tools/headline-analyzer/  301
/fa/tools/seo-title-analyzer  /fa/tools/headline-analyzer/  301
/ar/tools/seo-title-analyzer  /ar/tools/headline-analyzer/  301

# seo-title-checker was merged into headline-analyzer (which now includes the
# meta title/description pixel checker and live SERP preview) to stop the two
# pages cannibalizing the same "seo title checker" query cluster.
