{
  "name": "webabc-ir",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "manifests": "node scripts/resolve-sitemap-lastmod.mjs && node scripts/generate-og-manifest.mjs",
    "llms": "node scripts/generate-llms-index.mjs && node scripts/generate-llms-full.mjs",
    "avif": "node scripts/generate-avif.mjs",
    "avif:check": "node scripts/generate-avif.mjs --check",
    "build": "npm run manifests && npm run llms && node scripts/generate-ai-catalog.mjs && astro build && node scripts/generate-markdown-representations.mjs && node scripts/verify-hreflang-parity.mjs",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy",
    "lint": "oxlint && astro check",
    "lint:ox": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "astro check",
    "test": "node --experimental-strip-types scripts/verify-agentic.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.7",
    "qrcode": "^1.5.4",
    "resend": "^6.37.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/compiler-rs": "^0.5.3",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  }
}
