{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/triple-slash-reference": "off",
    "no-unused-vars": "off",
    "no-useless-escape": "off"
  },
  "ignorePatterns": ["dist/**", ".astro/**", "node_modules/**", "public/**", "src/generated/**"],
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  }
}
