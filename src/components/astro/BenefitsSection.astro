---
import { getDictionary } from '@/i18n/get-dictionary';
import { languages, type SupportedLanguage } from '@/types/language';
import { createTranslator } from '@/i18n/translate';
import AsciiStage from './AsciiStage.astro';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const dictionary = await getDictionary(lang);
const isRtl = languages[lang]?.direction === 'rtl';
const fontClass = lang === 'en' ? 'font-sans' : lang === 'ar' ? 'font-arabic' : 'font-persian';

const t = createTranslator(dictionary);

const benefits = [
  {
    idx: '01',
    metric:
      lang === 'fa'
        ? 'اعتبار · E-E-A-T'
        : lang === 'ar'
          ? 'الموثوقية · E-E-A-T'
          : 'TRUST · E-E-A-T',
    title: t('benefits.brandCredibility.title', { fallback: 'Increase Brand Credibility' }),
    description: t('benefits.brandCredibility.description', {
      fallback: "Boost your brand's credibility with a strong presence in search results.",
    }),
  },
  {
    idx: '02',
    metric:
      lang === 'fa'
        ? 'نرخ تبدیل · رشد درآمد'
        : lang === 'ar'
          ? 'معدل التحويل · نمو الإيرادات'
          : 'CRO · REVENUE',
    title: t('benefits.increaseSales.title', { fallback: 'Increase Sales and Revenue' }),
    description: t('benefits.increaseSales.description', {
      fallback: 'Attract targeted traffic to improve conversion rates and sales.',
    }),
  },
  {
    idx: '03',
    metric:
      lang === 'fa'
        ? 'کاهش ۴۸٪ هزینه جذب'
        : lang === 'ar'
          ? 'خفض 48% تكلفة الاكتساب'
          : 'CAC -48% · ORGANIC',
    title: t('benefits.reduceCosts.title', { fallback: 'Reduce Advertising Costs' }),
    description: t('benefits.reduceCosts.description', {
      fallback: 'Lower your pay-per-click advertising costs by improving organic rankings.',
    }),
  },
  {
    idx: '04',
    metric:
      lang === 'fa'
        ? 'سنگر سئو · رتبه‌های ۱ تا ۳'
        : lang === 'ar'
          ? 'حصن السيو · المراتب 1-3'
          : 'SERP MOAT · TOP-3',
    title: t('benefits.competitiveAdvantage.title', { fallback: 'Gain Competitive Advantage' }),
    description: t('benefits.competitiveAdvantage.description', {
      fallback: 'Get ahead of your competitors with advanced SEO strategies.',
    }),
  },
];

const guaranteeList = [
  t('benefits.guaranteeFeatures.0', {
    fallback: 'Monthly reports with precise metrics',
  }),
  t('benefits.guaranteeFeatures.1', {
    fallback: 'Complete transparency throughout the collaboration',
  }),
  t('benefits.guaranteeFeatures.2', {
    fallback: 'Guaranteed improvement in target keyword rankings',
  }),
  t('benefits.guaranteeFeatures.3', {
    fallback: 'Flexible contracts with no long-term commitment',
  }),
];
---

<section class={`border-b border-[var(--border-hairline)] bg-[var(--bg-canvas)] py-12 md:py-16 ${fontClass}`}>
  <div class="container mx-auto px-4 md:px-6">
    <!-- Part A: /WHY-WEBABC -->
    <div class="mx-auto mb-10 max-w-3xl text-center">
      <div class="mb-2 flex justify-center">
        <span class="slash-eyebrow text-xs" dir={isRtl ? 'rtl' : 'ltr'}>
          {
            lang === 'fa'
              ? `/چرا-وب-ای‌بی‌سی · ${t('benefits.sectionTag', { fallback: 'مزیت مهندسی' })}`
              : lang === 'ar'
                ? `/لماذا-ويب-إي-بي-سي · ${t('benefits.sectionTag', { fallback: 'الميزة الهندسية' })}`
                : `/WHY-WEBABC · ${t('benefits.sectionTag', { fallback: 'ENGINEERING ADVANTAGE' })}`
          }
        </span>
      </div>

      <h2 class="mb-3 text-2xl font-bold tracking-tight text-balance text-[var(--text-primary)] sm:text-3xl md:text-4xl">
        {t('benefits.sectionTitle.prefix', { fallback: 'Why Choose ' })}
        <span class="text-[var(--accent-green)]">
          {t('benefits.sectionTitle.highlight', { fallback: 'WebABC' })}
        </span>
        {t('benefits.sectionTitle.suffix', { fallback: '?' })}
      </h2>

      <p class="text-sm leading-relaxed text-balance text-[var(--text-secondary)] sm:text-base">
        {
          t('benefits.sectionDescription', {
            fallback:
              'Focusing on tangible results and proven strategies, we help your business grow in today’s digital world.',
          })
        }
      </p>
    </div>

    <!-- 4-Card Hairline Grid with Monospace Index Numbers ([01]-[04]) -->
    <div class="mb-12 grid grid-cols-1 gap-px overflow-hidden rounded-lg border border-[var(--border-hairline)] bg-[var(--border-hairline)] md:grid-cols-2">
      {
        benefits.map((benefit) => (
          <div class="bg-[var(--bg-surface)] p-5 transition-colors hover:bg-[var(--bg-elevated)] sm:p-6">
            <div class="mb-3 flex items-center justify-between" dir="ltr">
              <span class="font-mono text-xs font-bold text-[var(--accent-green)]">
                [{benefit.idx}]
              </span>
              <span class="monospace-telemetry-pill">{benefit.metric}</span>
            </div>
            <h3 class="mb-1.5 text-lg font-bold text-[var(--text-primary)]">{benefit.title}</h3>
            <p class="text-xs leading-relaxed text-[var(--text-secondary)] sm:text-sm">
              {benefit.description}
            </p>
          </div>
        ))
      }
    </div>

    <!-- Part B: /RESULTS (Tangible Results with Proven Methods) -->
    <div class="terminal-window">
      <div class="terminal-chrome-bar" dir="ltr">
        <span class="slash-eyebrow text-xs" dir={isRtl ? 'rtl' : 'ltr'}>
          {
            lang === 'fa'
              ? '/نتایج-ملموس · شاخص‌های حیاتی وب و رتبه‌ها'
              : lang === 'ar'
                ? '/النتائج · مؤشرات الويب الأساسية والتصنيفات'
                : '/RESULTS · VERIFIED CORE WEB VITALS & RANKINGS'
          }
        </span>
        <span class="monospace-telemetry-pill">
          star-history-climb · {lang === 'fa' ? 'بازده ۱۲ ماهه' : lang === 'ar' ? 'عائد 12 شهراً' : '12M ROI'}
        </span>
      </div>

      <div class="grid grid-cols-1 items-center divide-y divide-[var(--border-hairline)] lg:grid-cols-12 lg:divide-x lg:divide-y-0 rtl:lg:divide-x-reverse">
        <!-- Left Column: Verified Checklist -->
        <div class="flex flex-col justify-center p-5 sm:p-7 lg:col-span-5">
          <div class="mb-2">
            <span class="monospace-telemetry-pill text-[var(--accent-green)]">
              {t('benefits.guaranteeTag', { fallback: 'RESULTS GUARANTEED' })}
            </span>
          </div>

          <h3 class="mt-1 mb-3 text-xl font-bold text-balance text-[var(--text-primary)] sm:text-2xl">
            {t('benefits.guaranteeTitle.prefix', { fallback: 'Tangible Results with ' })}
            <span class="text-[var(--accent-green)]">
              {t('benefits.guaranteeTitle.highlight', { fallback: 'Proven Methods' })}
            </span>
          </h3>

          <p class="mb-5 text-sm leading-relaxed text-balance text-[var(--text-secondary)]">
            {
              t('benefits.guaranteeDescription', {
                fallback:
                  'We believe that SEO is an ongoing process. With careful planning and sound strategies, we bring long-term and sustainable results to your business.',
              })
            }
          </p>

          <ul class="mb-6 space-y-2.5">
            {
              guaranteeList.map((item) => (
                <li class="flex items-start gap-2 text-xs text-[var(--text-primary)] sm:text-sm">
                  <span class="ltr-isolate mt-0.5 shrink-0 font-mono text-xs font-bold text-[var(--accent-green)]" dir="ltr">
                    [✓]
                  </span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>

          <div>
            <button
              type="button"
              data-open-consultation
              class="inline-flex cursor-pointer items-center gap-2 rounded border border-[var(--accent-green)] bg-[var(--accent-green-dim)] px-4 py-2.5 font-mono text-xs font-bold text-[var(--accent-contrast)] transition-all hover:bg-[var(--accent-green)] hover:text-[#090b0e] sm:text-sm"
            >
              <span>{t('benefits.ctaButton', { fallback: 'Get Free Consultation' })}</span>
              <span aria-hidden="true">{isRtl ? '←' : '→'}</span>
            </button>
          </div>
        </div>

        <!-- Right Column: Live <ascii-art piece="star-history-climb"> Telemetry Card -->
        <div class="bg-[var(--bg-canvas)] p-3 sm:p-5 lg:col-span-7">
          <AsciiStage
            id="results-ascii"
            lang={lang}
            defaultPiece="star-history-climb"
            title={lang === 'fa'
              ? '/تله‌متری · رشد تصاعدی ایمپرشن ارگانیک و رتبه‌های ۱ تا ۳'
              : lang === 'ar'
                ? '/القياس عن بُعد · نمو مرات الظهور وتصدر المراتب الثلاث الأولى'
                : '/TELEMETRY · Compounding Organic Impressions & Top-3 Velocity'}
            meta="66×17 · 24 fps · 3.2 KB"
            size={11.5}
            ariaLabel={t('benefits.imageAlt', {
              fallback: 'Live ASCII chart showing compounding SEO growth and Core Web Vitals metrics',
            })}
          />
        </div>
      </div>
    </div>
  </div>
</section>
