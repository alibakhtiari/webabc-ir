---
import { Picture } from 'astro:assets';
import { getDictionary } from '@/i18n/get-dictionary';
import { languages, type SupportedLanguage } from '@/types/language';
import { createTranslator } from '@/i18n/translate';
import seoResultsImg from '@/assets/images/seo-results.webp';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const dictionary = await getDictionary(lang);
const isRtl = languages[lang]?.direction === 'rtl';
const fontClass = lang === 'en' ? 'font-sans' : lang === 'ar' ? 'font-arabic' : 'font-persian';

const t = createTranslator(dictionary);

const benefits = [
  {
    idx: '01',
    metric:
      lang === 'fa'
        ? 'اعتبار · E-E-A-T'
        : lang === 'ar'
          ? 'الموثوقية · E-E-A-T'
          : 'TRUST · E-E-A-T',
    title: t('benefits.brandCredibility.title', { fallback: 'Increase Brand Credibility' }),
    description: t('benefits.brandCredibility.description', {
      fallback: "Boost your brand's credibility with a strong presence in search results.",
    }),
  },
  {
    idx: '02',
    metric:
      lang === 'fa'
        ? 'نرخ تبدیل · رشد درآمد'
        : lang === 'ar'
          ? 'معدل التحويل · نمو الإيرادات'
          : 'CRO · REVENUE',
    title: t('benefits.increaseSales.title', { fallback: 'Increase Sales and Revenue' }),
    description: t('benefits.increaseSales.description', {
      fallback: 'Attract targeted traffic to improve conversion rates and sales.',
    }),
  },
  {
    idx: '03',
    metric:
      lang === 'fa'
        ? 'کاهش ۴۸٪ هزینه جذب'
        : lang === 'ar'
          ? 'خفض 48% تكلفة الاكتساب'
          : 'CAC -48% · ORGANIC',
    title: t('benefits.reduceCosts.title', { fallback: 'Reduce Advertising Costs' }),
    description: t('benefits.reduceCosts.description', {
      fallback: 'Lower your pay-per-click advertising costs by improving organic rankings.',
    }),
  },
  {
    idx: '04',
    metric:
      lang === 'fa'
        ? 'سنگر سئو · رتبه‌های ۱ تا ۳'
        : lang === 'ar'
          ? 'حصن السيو · المراتب 1-3'
          : 'SERP MOAT · TOP-3',
    title: t('benefits.competitiveAdvantage.title', { fallback: 'Gain Competitive Advantage' }),
    description: t('benefits.competitiveAdvantage.description', {
      fallback: 'Get ahead of your competitors with advanced SEO strategies.',
    }),
  },
];

const guaranteeList = [
  t('benefits.guaranteeFeatures.0', {
    fallback: 'Monthly reports with precise metrics',
  }),
  t('benefits.guaranteeFeatures.1', {
    fallback: 'Complete transparency throughout the collaboration',
  }),
  t('benefits.guaranteeFeatures.2', {
    fallback: 'Guaranteed improvement in target keyword rankings',
  }),
  t('benefits.guaranteeFeatures.3', {
    fallback: 'Flexible contracts with no long-term commitment',
  }),
];
---

<section class={`relative overflow-hidden bg-background py-16 md:py-24 ${fontClass}`} dir={isRtl ? 'rtl' : 'ltr'}>
  <!-- Background subtle glows -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <div class="absolute top-40 -left-20 h-96 w-96 rounded-full bg-primary/5 blur-3xl"></div>
    <div class="absolute bottom-20 -right-20 h-96 w-96 rounded-full bg-primary/8 blur-3xl"></div>
  </div>

  <div class="relative z-10 container mx-auto px-4 md:px-6">
    <!-- Header -->
    <div class="mx-auto mb-14 max-w-3xl text-center">
      <div class="mb-3 flex justify-center">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/10 px-3.5 py-1 text-xs font-semibold text-primary">
          <span class="h-1.5 w-1.5 rounded-full bg-primary animate-pulse"></span>
          {t('benefits.sectionTag', { fallback: 'Why WebABC' })}
        </span>
      </div>

      <h2 class="mb-4 text-3xl font-extrabold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
        {t('benefits.sectionTitle.prefix', { fallback: 'Why Choose ' })}
        <span class="bg-gradient-to-r from-primary to-blue-600 bg-clip-text text-transparent">
          {t('benefits.sectionTitle.highlight', { fallback: 'WebABC' })}
        </span>
        {t('benefits.sectionTitle.suffix', { fallback: '?' })}
      </h2>

      <p class="text-base text-gray-600 dark:text-gray-300 md:text-lg leading-relaxed">
        {
          t('benefits.sectionDescription', {
            fallback:
              'Focusing on tangible results and proven strategies, we help your business achieve compounding growth.',
          })
        }
      </p>
    </div>

    <!-- 4 Benefits Cards with Verified ROI Metrics -->
    <div class="mb-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        benefits.map((benefit) => (
          <div class="group relative flex flex-col justify-between rounded-2xl border border-gray-200/80 bg-white p-6 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900">
            <div>
              <div class="mb-4 flex items-center justify-between">
                <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-primary/10 font-mono text-xs font-bold text-primary">
                  {benefit.idx}
                </span>
                <span class="rounded-md border border-emerald-500/20 bg-emerald-500/10 px-2 py-0.5 text-[11px] font-bold text-emerald-600 dark:text-emerald-400">
                  {benefit.metric}
                </span>
              </div>
              <h3 class="mb-2 text-lg font-bold text-gray-900 transition-colors group-hover:text-primary dark:text-white">
                {benefit.title}
              </h3>
              <p class="text-xs leading-relaxed text-gray-600 dark:text-gray-400 sm:text-sm">
                {benefit.description}
              </p>
            </div>
            <div class="mt-4 flex items-center pt-2 text-xs font-semibold text-primary">
              <span class="flex h-5 w-5 items-center justify-center rounded-full bg-primary/10">✓</span>
              <span class="ms-2">
                {lang === 'fa' ? 'تضمین اثربخشی' : lang === 'ar' ? 'فعالية مضمونة' : 'Proven Impact'}
              </span>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Guarantee & Proof Banner -->
    <div class="overflow-hidden rounded-3xl border border-gray-200/80 bg-gradient-to-br from-white via-blue-50/20 to-white shadow-xl dark:border-slate-800 dark:from-slate-900 dark:via-slate-900/80 dark:to-slate-900">
      <div class="grid grid-cols-1 items-center lg:grid-cols-12">
        <!-- Left: Guarantee Checklist & CTA -->
        <div class="flex flex-col justify-center p-8 sm:p-10 lg:col-span-6 lg:p-12">
          <div class="mb-3 flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-xs font-bold text-emerald-600 dark:text-emerald-400">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
              {t('benefits.guaranteeTag', { fallback: 'Results Guaranteed' })}
            </span>
          </div>

          <h3 class="mb-4 text-2xl font-extrabold text-gray-900 dark:text-white sm:text-3xl">
            {t('benefits.guaranteeTitle.prefix', { fallback: 'Tangible Results with ' })}
            <span class="text-primary">
              {t('benefits.guaranteeTitle.highlight', { fallback: 'Proven Methods' })}
            </span>
          </h3>

          <p class="mb-6 text-sm leading-relaxed text-gray-600 dark:text-gray-300 sm:text-base">
            {
              t('benefits.guaranteeDescription', {
                fallback:
                  'We believe that SEO is an ongoing engineering process. With careful planning and sound strategies, we bring long-term, compounding results to your business.',
              })
            }
          </p>

          <ul class="mb-8 space-y-3">
            {
              guaranteeList.map((item) => (
                <li class="flex items-start gap-3 text-sm text-gray-700 dark:text-gray-200">
                  <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </span>
                  <span class="leading-normal">{item}</span>
                </li>
              ))
            }
          </ul>

          <div class="flex flex-wrap items-center gap-4">
            <button
              type="button"
              data-open-consultation
              class="inline-flex cursor-pointer items-center gap-2 rounded-xl bg-primary px-6 py-3.5 text-sm font-bold text-primary-foreground shadow-md transition-all duration-300 hover:bg-primary/90 hover:shadow-lg hover:-translate-y-0.5"
            >
              <span>{t('benefits.ctaButton', { fallback: 'Get Free Consultation' })}</span>
              <span aria-hidden="true">{isRtl ? '←' : '→'}</span>
            </button>
            <span class="text-xs text-gray-500 dark:text-gray-400">
              {lang === 'fa' ? 'بدون پیش‌پرداخت برای جلسه اول' : lang === 'ar' ? 'جلسة أولى مجانية بالكامل' : '100% Free Initial Strategy Session'}
            </span>
          </div>
        </div>

        <!-- Right: Real Performance Chart Image with Glass Frame -->
        <div class="relative flex items-center justify-center p-6 lg:col-span-6 lg:p-8">
          <div class="overflow-hidden rounded-2xl border border-gray-200/80 bg-gray-50 shadow-inner dark:border-slate-800 dark:bg-slate-950">
            <Picture
              src={seoResultsImg}
              formats={['avif', 'webp']}
              alt={t('benefits.imageAlt', { fallback: 'SEO performance and Core Web Vitals growth chart' })}
              width={640}
              height={420}
              loading="lazy"
              class="h-auto w-full object-cover transition-transform duration-500 hover:scale-105"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
