---
interface RelatedTool {
  key: string;
  route: string;
}

interface Props {
  lang: string;
  t: (key: string, opts?: any) => string;
  related: RelatedTool[];
  ctaHref: string;
  isRtl?: boolean;
}

const { lang, t, related, ctaHref, isRtl = false } = Astro.props;
const fontClass = lang === 'en' ? 'font-sans' : lang === 'ar' ? 'font-arabic' : 'font-persian';

const whatsappMessages: Record<string, string> = {
  fa: 'سلام، از بخش ابزارهای وب‌آ‌بی‌سی پیام می‌دهم و نیاز به مشاوره فنی دارم.',
  ar: 'مرحباً، أتواصل معكم من قسم الأدوات في ويب أيه بي سي وأرغب في استشارة فنية.',
  en: 'Hello, reaching out from WebABC tools to inquire about a technical consultation.',
};
const waMsg = encodeURIComponent(whatsappMessages[lang] || whatsappMessages.en);
const waUrl = `https://wa.me/989125811880?text=${waMsg}`;
const waLabel =
  lang === 'fa'
    ? 'گفتگوی فوری در واتساپ'
    : lang === 'ar'
      ? 'محادثة فورية عبر واتساب'
      : 'Quick WhatsApp Chat';

const trustItems: Record<string, string[]> = {
  fa: [
    'پاسخگویی سریع کمتر از ۱ ساعت',
    'بررسی معماری و مشاوره تکنیکال رایگان',
    'توسعه اختصاصی با تضمین نمره سرعت ۱۰۰',
  ],
  ar: [
    'استجابة سريعة في أقل من ساعة',
    'تدقيق تقني واستشارة أولية مجانية',
    'بنية برمجية فائقة السرعة بنسبة 100%',
  ],
  en: [
    'Fast response under 1 business hour',
    'Free initial technical architecture audit',
    'High-performance 100/100 PageSpeed engineering',
  ],
};
const badges = trustItems[lang] || trustItems.en;
---

{
  related.length > 0 && (
    <section class="border-t border-[var(--border-hairline)] bg-[var(--bg-canvas)] py-16">
      <div class={`container mx-auto max-w-6xl px-4 ${fontClass}`}>
        <div class="mb-2 flex justify-center">
          <span class="slash-eyebrow" dir={isRtl ? 'rtl' : 'ltr'}>
            {
              lang === 'fa'
                ? '/ابزارهای-مرتبط'
                : lang === 'ar'
                  ? '/أدوات-ذات-صلة'
                  : '/RELATED-UTILITIES'
            }
          </span>
        </div>
        <h2 class="mb-8 text-center text-2xl font-bold text-[var(--text-primary)]">
          {t('tools.relatedTitle', { fallback: 'Related Free Tools' })}
        </h2>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          {related.map(({ key, route }, idx) => (
            <a
              href={`/${lang}/tools/${route.endsWith('/') ? route : route + '/'}`}
              class="terminal-window group flex flex-col justify-between p-6 transition-all hover:border-[var(--accent-green)]"
            >
              <div>
                <div class="mb-2 flex items-center justify-between" dir="ltr">
                  <span class="font-mono text-xs text-[var(--accent-green)]">[0{idx + 1}]</span>
                  <span class="monospace-telemetry-pill">{route}</span>
                </div>
                <h3 class="mb-2 text-lg font-bold text-[var(--text-primary)] transition-colors group-hover:text-[var(--accent-green)]">
                  {t(`${key}.title`, { fallback: key })}
                </h3>
                <p class="mb-4 text-sm leading-relaxed text-[var(--text-secondary)]">
                  {t(`${key}.description`, { fallback: '' })}
                </p>
              </div>
              <div class="inline-flex items-center gap-1 font-mono text-xs font-bold text-[var(--accent-green)]">
                {t('common.readMore', { fallback: 'Launch Tool' })} {isRtl ? '←' : '→'}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}

<section class="border-t border-[var(--border-hairline)] bg-[var(--bg-canvas)] py-16">
  <div class={`container mx-auto max-w-4xl px-4 text-center ${fontClass}`}>
    <div class="terminal-window">
      <div class="terminal-chrome-bar" dir={isRtl ? 'rtl' : 'ltr'}>
        <span class="slash-eyebrow text-xs" dir={isRtl ? 'rtl' : 'ltr'}>
          {
            lang === 'fa'
              ? '╭─ /مهندسی-سازمانی · وب اِی‌بی‌سی ─╮'
              : lang === 'ar'
                ? '╭─ /الهندسة-المتقدمة · ويب أيه بي سي ─╮'
                : '╭─ /ENTERPRISE-ENGINEERING · WEBABC ─╮'
          }
        </span>
        <span class="monospace-telemetry-pill">CWV 100/100</span>
      </div>

      <div class="p-8 md:p-12">
        <h2 class="mb-4 text-2xl font-bold text-[var(--text-primary)] md:text-3xl">
          {t('tools.ctaTitle', { fallback: 'Need More Advanced Tools?' })}
        </h2>

        <p class="mx-auto mb-8 max-w-2xl text-base leading-relaxed text-[var(--text-secondary)] md:text-lg">
          {
            t('tools.ctaDescription', {
              fallback:
                'Contact us for custom SEO tools, high-speed web platforms, and advanced analytics solutions tailored to your business.',
            })
          }
        </p>

        <div class="mb-8 flex flex-wrap items-center justify-center gap-3">
          <a
            href={ctaHref.endsWith('/') ? ctaHref : ctaHref + '/'}
            class="inline-flex items-center gap-2 rounded border border-[var(--accent-green)] bg-[var(--accent-green-dim)] px-6 py-3 font-mono text-xs font-bold text-white transition-all hover:bg-[var(--accent-green)] hover:text-[#090b0e] sm:text-sm"
          >
            {t('common.freeConsultation', { fallback: 'Free Consultation' })}
            {isRtl ? '←' : '→'}
          </a>

          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-6 py-3 font-mono text-xs font-bold text-[var(--accent-green)] transition-all hover:border-[var(--accent-green)] sm:text-sm"
          >
            <span>{waLabel}</span>
          </a>
        </div>

        <div class="grid grid-cols-1 gap-3 border-t border-[var(--border-hairline)] pt-6 sm:grid-cols-3">
          {badges.map((b) => (
            <div class="flex items-center justify-center gap-2 text-xs font-medium text-[var(--text-secondary)]">
              <span class="ltr-isolate font-mono text-[var(--accent-green)]" dir="ltr">[✓]</span>
              <span>{b}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
