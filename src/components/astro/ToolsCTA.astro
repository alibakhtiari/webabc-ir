---
interface RelatedTool {
  key: string;
  route: string;
}

interface Props {
  lang: string;
  t: (key: string, opts?: any) => string;
  related: RelatedTool[];
  ctaHref: string;
  isRtl?: boolean;
}

const { lang, t, related, ctaHref, isRtl = false } = Astro.props;
---

{
  related.length > 0 && (
    <section class="border-t border-gray-100 bg-gray-50 py-16 dark:border-slate-800 dark:bg-slate-900/50">
      <div class="container mx-auto max-w-6xl px-4 font-sans">
        <h2 class="mb-8 text-center font-persian text-2xl font-bold text-gray-900 dark:text-white">
          {t('tools.relatedTitle', { fallback: 'Related Free Tools' })}
        </h2>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          {related.map(({ key, route }) => (
            <a
              href={`/${lang}/tools/${route.endsWith('/') ? route : route + '/'}`}
              class="group flex flex-col justify-between rounded-2xl border border-gray-100 bg-white p-6 font-persian shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-primary/20 hover:shadow-lg focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-primary/30"
            >
              <div>
                <h3 class="mb-2 text-lg font-bold text-gray-900 transition-colors group-hover:text-primary dark:text-white">
                  {t(`${key}.title`, { fallback: key })}
                </h3>
                <p class="mb-4 text-sm leading-relaxed text-gray-500 dark:text-gray-400">
                  {t(`${key}.description`, { fallback: '' })}
                </p>
              </div>
              <div class="inline-flex items-center gap-1 font-persian text-xs font-semibold text-primary transition-all group-hover:gap-2">
                {t('common.readMore', { fallback: 'Launch Tool' })} {isRtl ? '←' : '→'}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}

<section class="border-t border-gray-100 bg-white py-16 dark:border-slate-800 dark:bg-slate-950">
  <div class="container mx-auto max-w-3xl px-4 text-center font-persian">
    <h2 class="mb-4 text-2xl font-bold text-gray-900 md:text-3xl dark:text-white">
      {t('tools.ctaTitle', { fallback: 'Need More Advanced Tools?' })}
    </h2>
    <p class="mb-8 leading-relaxed text-gray-600 dark:text-gray-300">
      {
        t('tools.ctaDescription', {
          fallback:
            'Contact us for custom SEO tools and advanced analytics solutions tailored to your business needs.',
        })
      }
    </p>
    <a
      href={ctaHref.endsWith('/') ? ctaHref : ctaHref + '/'}
      class="inline-flex items-center gap-2 rounded-full bg-primary px-8 py-4 font-bold text-primary-foreground transition-colors hover:bg-primary/90 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
    >
      {t('common.freeConsultation', { fallback: 'Free Consultation' })}
      {isRtl ? '←' : '→'}
    </a>
  </div>
</section>
