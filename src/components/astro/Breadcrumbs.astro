---
interface Props {
  items: { label: string; url?: string }[];
  lang: string;
  centered?: boolean;
}

const { items, lang, centered = false } = Astro.props;

const siteUrl = 'https://webabc.ir';
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.label,
    ...(item.url ? { "item": item.url.startsWith('http') ? item.url : `${siteUrl}${item.url.endsWith('/') ? item.url : `${item.url}/`}` } : {})
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<nav class={`text-sm text-gray-500 mb-6 font-persian flex items-center gap-1.5 flex-wrap ${centered ? 'justify-center' : ''}`}>
  {items.map((item, idx) => (
    <>
      {idx > 0 && <span class="text-gray-400 select-none mx-0.5">/</span>}
      {item.url ? (
        <a href={item.url} class="hover:underline hover:text-primary transition-all">
          {item.label}
        </a>
      ) : (
        <span class="text-gray-700 font-medium">{item.label}</span>
      )}
    </>
  ))}
</nav>
