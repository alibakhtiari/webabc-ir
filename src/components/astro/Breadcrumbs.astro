---
interface Props {
  items: { label: string; url?: string }[];
  lang: string;
  centered?: boolean;
}

const { items, lang, centered = false } = Astro.props;

const siteUrl = 'https://webabc.ir';
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.url
      ? {
          item: item.url.startsWith('http')
            ? item.url
            : `${siteUrl}${item.url.endsWith('/') ? item.url : `${item.url}/`}`,
        }
      : {}),
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<nav
  class={`text-sm text-gray-500 dark:text-gray-400 mb-6 font-persian flex items-center gap-1.5 flex-wrap ${centered ? 'justify-center' : ''}`}
>
  {
    items.map((item, idx) => (
      <>
        {idx > 0 && <span class="mx-0.5 text-gray-500 select-none dark:text-gray-400">/</span>}
        {item.url ? (
          <a href={item.url} class="transition-all hover:text-primary hover:underline">
            {item.label}
          </a>
        ) : (
          <span class="font-medium text-gray-700 dark:text-gray-200">{item.label}</span>
        )}
      </>
    ))
  }
</nav>
