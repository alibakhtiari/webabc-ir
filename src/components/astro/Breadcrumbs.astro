---
import { breadcrumbId, canonicalPageUrl } from '@/utils/schemaIds';

interface Props {
  items: { label: string; url?: string }[];
  lang: string;
  centered?: boolean;
}

const { items, lang, centered = false } = Astro.props;
const fontClass = lang === 'fa' ? 'font-persian' : lang === 'ar' ? 'font-arabic' : 'font-sans';

const siteUrl = 'https://webabc.ir';
const pageUrl = canonicalPageUrl(Astro.url.pathname);
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': breadcrumbId(pageUrl),
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.url
      ? {
          item: item.url.startsWith('http')
            ? item.url
            : `${siteUrl}${item.url.endsWith('/') ? item.url : `${item.url}/`}`,
        }
      : {}),
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<nav
  class={`mb-4 flex flex-wrap items-center gap-1.5 font-mono text-xs text-[var(--text-secondary)] ${fontClass} ${centered ? 'justify-center' : ''}`}
  aria-label="Breadcrumb"
>
  {
    items.map((item, idx) => (
      <>
        {idx > 0 && <span class="mx-0.5 text-[var(--border-focus)] select-none">/</span>}
        {item.url ? (
          <a
            href={item.url}
            class="transition-colors hover:text-[var(--accent-green)] hover:underline"
          >
            {item.label}
          </a>
        ) : (
          <span class="font-semibold text-[var(--text-primary)]">{item.label}</span>
        )}
      </>
    ))
  }
</nav>
