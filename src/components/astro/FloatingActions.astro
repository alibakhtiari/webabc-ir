---
import { languages, type SupportedLanguage } from '@/types/language';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const isRtl = languages[lang]?.direction === 'rtl';

const labels = {
  callNow: lang === 'fa' ? 'تماس تلفنی' : lang === 'ar' ? 'اتصل الآن' : 'Call Now',
  whatsapp: lang === 'fa' ? 'واتس‌اپ' : lang === 'ar' ? 'واتساب' : 'WhatsApp',
  backToTop: lang === 'fa' ? 'بازگشت به بالا' : lang === 'ar' ? 'العودة إلى الأعلى' : 'Back to Top',
};

const phoneNumber = '+989125811880';
const whatsappMessages: Record<string, string> = {
  fa: 'سلام، برای مشاوره طراحی سایت و خدمات سئو پیام می‌دهم.',
  ar: 'مرحباً، أود الاستفسار عن خدمات تصميم المواقع وتحسين محركات البحث.',
  en: 'Hello, I would like to inquire about WebABC web design and SEO services.',
};
const encodedMsg = encodeURIComponent(whatsappMessages[lang] || whatsappMessages.en);
const whatsappUrl = `https://wa.me/989125811880?text=${encodedMsg}`;
const fontClass = `font-${lang === 'en' ? 'sans' : lang === 'ar' ? 'arabic' : 'persian'}`;
---

<!-- ==========================================
     1. DESKTOP FLOATING ACTIONS (hidden on mobile: md:flex)
     ========================================== -->
<div
  class={`fixed bottom-6 ${isRtl ? 'left-6' : 'right-6'} z-50 hidden md:flex flex-col gap-3 items-end pointer-events-none ${fontClass}`}
  id="desktop-floating-actions"
  aria-label="Quick Actions"
>
  <!-- Desktop Back to Top Button (revealed on scroll) -->
  <button
    type="button"
    aria-label={labels.backToTop}
    class="back-to-top-trigger group pointer-events-none invisible relative flex h-11 w-11 shrink-0 translate-y-3 cursor-pointer items-center justify-center rounded-full border border-slate-200/90 bg-white/95 text-slate-700 opacity-0 shadow-lg backdrop-blur-md transition-all duration-300 hover:scale-105 hover:border-primary/40 hover:bg-white hover:text-primary hover:shadow-xl focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 active:scale-95 dark:border-slate-700/90 dark:bg-slate-800/95 dark:text-slate-200 dark:hover:border-primary/50 dark:hover:bg-slate-750 dark:hover:text-primary"
  >
    <svg
      aria-hidden="true"
      class="h-5 w-5 transition-transform duration-300 group-hover:-translate-y-0.5"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"></path>
    </svg>
    <span
      class={`absolute ${isRtl ? 'left-14' : 'right-14'} opacity-0 group-hover:opacity-100 transition-opacity duration-200 bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900 border border-slate-700/50 dark:border-slate-300/50 text-xs font-medium py-1 px-2.5 rounded-lg shadow-xl whitespace-nowrap pointer-events-none z-20`}
    >
      {labels.backToTop}
    </span>
  </button>

  <!-- Desktop Call Button -->
  <a
    href={`tel:${phoneNumber}`}
    aria-label={labels.callNow}
    class="group pointer-events-auto relative flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary text-white border border-blue-400/30 shadow-[0_4px_16px_rgba(37,99,235,0.3)] transition-all duration-300 hover:scale-105 hover:shadow-[0_6px_22px_rgba(37,99,235,0.45)] dark:border-blue-400/40 dark:shadow-[0_4px_20px_rgba(37,99,235,0.4)] focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 active:scale-95"
  >
    <svg
      aria-hidden="true"
      class="h-5 w-5 transition-transform duration-300 group-hover:rotate-12"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
      ></path>
    </svg>
    <span
      class={`absolute ${isRtl ? 'left-14' : 'right-14'} opacity-0 group-hover:opacity-100 transition-opacity duration-200 bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900 border border-slate-700/50 dark:border-slate-300/50 text-xs font-semibold py-1 px-2.5 rounded-lg shadow-xl whitespace-nowrap pointer-events-none z-20`}
    >
      {labels.callNow}
    </span>
  </a>

  <!-- Desktop WhatsApp Button -->
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={labels.whatsapp}
    class="group pointer-events-auto relative flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#25D366] text-white border border-emerald-400/40 shadow-[0_4px_16px_rgba(37,211,102,0.3)] transition-all duration-300 hover:scale-105 hover:bg-[#20ba59] hover:shadow-[0_6px_22px_rgba(37,211,102,0.45)] dark:border-emerald-400/40 dark:shadow-[0_4px_20px_rgba(37,211,102,0.4)] focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 active:scale-95"
  >
    <svg aria-hidden="true" class="h-5 w-5 fill-current transition-transform duration-300 group-hover:scale-110" viewBox="0 0 24 24">
      <path
        d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-1.002 3.66 3.745-.993zm11.233-6.793c-.274-.137-1.625-.802-1.876-.893-.252-.092-.435-.137-.618.137-.183.274-.709.893-.869 1.076-.16.183-.32.206-.594.069-.274-.137-1.157-.426-2.204-1.36-.816-.728-1.367-1.628-1.527-1.902-.16-.274-.017-.422.12-.558.123-.122.274-.32.411-.48.137-.16.183-.274.274-.457.091-.183.046-.343-.023-.48-.069-.137-.618-1.486-.847-2.036-.223-.536-.45-.463-.618-.472-.16-.008-.343-.01-.526-.01-.183 0-.48.069-.731.343-.251.274-.96.938-.96 2.288 0 1.35.983 2.653 1.12 2.836.137.184 1.935 2.955 4.689 4.144.655.283 1.166.452 1.564.578.658.209 1.258.179 1.732.108.529-.079 1.625-.664 1.854-1.303.229-.639.229-1.187.16-1.303-.069-.115-.252-.183-.526-.32z"
      ></path>
    </svg>
    <span
      class={`absolute ${isRtl ? 'left-14' : 'right-14'} opacity-0 group-hover:opacity-100 transition-opacity duration-200 bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900 border border-slate-700/50 dark:border-slate-300/50 text-xs font-semibold py-1 px-2.5 rounded-lg shadow-xl whitespace-nowrap pointer-events-none z-20`}
    >
      {labels.whatsapp}
    </span>
  </a>
</div>

<!-- ==========================================
     2. MOBILE FLOATING BACK TO TOP (hidden on desktop: md:hidden)
     ========================================== -->
<button
  type="button"
  aria-label={labels.backToTop}
  class={`back-to-top-trigger fixed bottom-20 ${isRtl ? 'left-4' : 'right-4'} z-40 md:hidden pointer-events-none invisible flex h-11 w-11 items-center justify-center rounded-full border border-slate-200/90 bg-white/95 text-slate-700 opacity-0 shadow-lg backdrop-blur-md transition-all duration-300 hover:scale-105 active:scale-95 dark:border-slate-700/90 dark:bg-slate-800/95 dark:text-slate-200 dark:shadow-[0_4px_16px_rgba(0,0,0,0.4)]`}
>
  <svg
    aria-hidden="true"
    class="h-5 w-5"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    viewBox="0 0 24 24"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"></path>
  </svg>
</button>

<!-- ==========================================
     3. MOBILE HORIZONTAL ACTION BAR (hidden on desktop: md:hidden)
     ========================================== -->
<div
  class={`fixed bottom-0 left-0 right-0 w-full z-40 md:hidden bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-t border-slate-200/80 dark:border-slate-800/80 shadow-[0_-4px_20px_rgba(0,0,0,0.06)] dark:shadow-[0_-4px_25px_rgba(0,0,0,0.5)] px-4 py-2.5 pb-[max(0.625rem,env(safe-area-inset-bottom))] ${fontClass}`}
  aria-label="Mobile Contact Bar"
>
  <div class="flex items-center gap-3 w-full max-w-lg mx-auto">
    <!-- Call Now Button -->
    <a
      href={`tel:${phoneNumber}`}
      aria-label={labels.callNow}
      class="flex-1 flex items-center justify-center gap-2 h-11 px-3 rounded-xl bg-primary hover:bg-primary/90 text-white font-semibold text-sm shadow-sm transition-all active:scale-[0.98] border border-blue-400/30 dark:border-blue-400/40"
    >
      <svg
        aria-hidden="true"
        class="h-4.5 w-4.5 shrink-0"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
        ></path>
      </svg>
      <span class="truncate">{labels.callNow}</span>
    </a>

    <!-- WhatsApp Button -->
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={labels.whatsapp}
      class="flex-1 flex items-center justify-center gap-2 h-11 px-3 rounded-xl bg-[#25D366] hover:bg-[#20ba59] text-white font-semibold text-sm shadow-sm transition-all active:scale-[0.98] border border-emerald-400/30 dark:border-emerald-400/40"
    >
      <svg aria-hidden="true" class="h-4.5 w-4.5 shrink-0 fill-current" viewBox="0 0 24 24">
        <path
          d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-1.002 3.66 3.745-.993zm11.233-6.793c-.274-.137-1.625-.802-1.876-.893-.252-.092-.435-.137-.618.137-.183.274-.709.893-.869 1.076-.16.183-.32.206-.594.069-.274-.137-1.157-.426-2.204-1.36-.816-.728-1.367-1.628-1.527-1.902-.16-.274-.017-.422.12-.558.123-.122.274-.32.411-.48.137-.16.183-.274.274-.457.091-.183.046-.343-.023-.48-.069-.137-.618-1.486-.847-2.036-.223-.536-.45-.463-.618-.472-.16-.008-.343-.01-.526-.01-.183 0-.48.069-.731.343-.251.274-.96.938-.96 2.288 0 1.35.983 2.653 1.12 2.836.137.184 1.935 2.955 4.689 4.144.655.283 1.166.452 1.564.578.658.209 1.258.179 1.732.108.529-.079 1.625-.664 1.854-1.303.229-.639.229-1.187.16-1.303-.069-.115-.252-.183-.526-.32z"
        ></path>
      </svg>
      <span class="truncate">{labels.whatsapp}</span>
    </a>
  </div>
</div>

<script is:inline>
  (() => {
    function setupFloatingActions() {
      const triggers = document.querySelectorAll('.back-to-top-trigger');
      if (!triggers.length) return;

      triggers.forEach((btn) => {
        btn.onclick = (e) => {
          e.preventDefault();
          window.scrollTo({
            top: 0,
            behavior: 'smooth',
          });
        };
      });

      let ticking = false;
      const updateVisibility = () => {
        const isScrolled = window.scrollY > 280;
        triggers.forEach((btn) => {
          if (isScrolled) {
            btn.classList.remove('opacity-0', 'translate-y-3', 'pointer-events-none', 'invisible');
            btn.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
          } else {
            btn.classList.add('opacity-0', 'translate-y-3', 'pointer-events-none', 'invisible');
            btn.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
          }
        });
        ticking = false;
      };

      const onScroll = () => {
        if (!ticking) {
          window.requestAnimationFrame(updateVisibility);
          ticking = true;
        }
      };

      if (window.__webabcFloatingScroll) {
        window.removeEventListener('scroll', window.__webabcFloatingScroll);
      }
      window.__webabcFloatingScroll = onScroll;
      window.addEventListener('scroll', onScroll, { passive: true });
      updateVisibility();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupFloatingActions);
    } else {
      setupFloatingActions();
    }
    document.addEventListener('astro:page-load', setupFloatingActions);
    setupFloatingActions();
  })();
</script>
