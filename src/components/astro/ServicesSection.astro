---
import { Picture } from 'astro:assets';
import { getDictionary } from '@/i18n/get-dictionary';
import { languages, type SupportedLanguage } from '@/types/language';
import { createTranslator } from '@/i18n/translate';
import seoImg from '@/assets/images/services/seo.webp';
import webDesignImg from '@/assets/images/services/web-design.webp';
import contentCreationImg from '@/assets/images/services/content-creation.webp';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const dictionary = await getDictionary(lang);
const isRtl = languages[lang]?.direction === 'rtl';
const fontClass = lang === 'en' ? 'font-sans' : lang === 'ar' ? 'font-arabic' : 'font-persian';

const t = createTranslator(dictionary);

const linkPath = (path: string) => {
  if (!path || path === '/') return `/${lang}/`;
  const cleanPath = path.startsWith('/') ? path : `/${path}`;
  return `/${lang}${cleanPath.endsWith('/') ? cleanPath : cleanPath + '/'}`;
};

const services = [
  {
    id: 'seo',
    image: seoImg,
    tag: lang === 'fa' ? 'سئو تخصصی و رشد رتبه' : lang === 'ar' ? 'سيو وتصدر نتائج البحث' : 'SEO & Search Optimization',
    badge:
      lang === 'fa'
        ? 'سئو تخصصی · رتبه ۱ گوگل'
        : lang === 'ar'
          ? 'سيو متخصص · تصدر نتائج البحث'
          : 'SERP · Organic · CWV',
    href: '/services/seo',
    title: t('services.seo.title', { fallback: 'SEO & Specialized Optimization' }),
    description: t('services.seo.description', {
      fallback:
        'Professional SEO services to boost your search engine ranking. We use advanced, standard techniques to increase organic traffic, improve visibility, and grow your online presence.',
    }),
    features: [
      t('services.seo.features.0', { fallback: 'Keyword Research' }),
      t('services.seo.features.1', { fallback: 'Content Optimization' }),
      t('services.seo.features.2', { fallback: 'Technical SEO' }),
      t('services.seo.features.3', { fallback: 'External Link Building' }),
      t('services.seo.features.4', { fallback: 'Monthly Reporting' }),
    ],
  },
  {
    id: 'web-design',
    image: webDesignImg,
    tag: lang === 'fa' ? 'طراحی سایت اختصاصی' : lang === 'ar' ? 'تصميم مواقع احترافي' : 'Custom Web Design',
    badge:
      lang === 'fa'
        ? 'طراحی اختصاصی · واکنش‌گرا'
        : lang === 'ar'
          ? 'تصميم مواقع مخصص · متجاوب'
          : 'Astro · React · High-Speed',
    href: '/services/web-design',
    title: t('services.webDesign.title', { fallback: 'Custom Website Design' }),
    description: t('services.webDesign.description', {
      fallback:
        'Custom web design and development services for modern businesses. We create attractive, SEO-friendly, and mobile-responsive websites that engage users and drive conversions.',
    }),
    features: [
      t('services.webDesign.features.0', { fallback: 'Responsive Design' }),
      t('services.webDesign.features.1', { fallback: 'Modern User Interface' }),
      t('services.webDesign.features.2', { fallback: 'Fast Loading Speed' }),
      t('services.webDesign.features.3', { fallback: 'SEO Friendly' }),
      t('services.webDesign.features.4', { fallback: 'High Security' }),
    ],
  },
  {
    id: 'content',
    image: contentCreationImg,
    tag: lang === 'fa' ? 'تولید محتوای تخصصی' : lang === 'ar' ? 'صناعة المحتوى التخصصي' : 'Specialized Content',
    badge:
      lang === 'fa'
        ? 'محتوای تخصصی · سئو معنایی'
        : lang === 'ar'
          ? 'محتوى متخصص · سيو دلالي'
          : 'Semantic · AEO · Copy',
    href: '/services/content-creation',
    title: t('services.contentCreation.title', { fallback: 'Specialized Content Creation' }),
    description: t('services.contentCreation.description', {
      fallback:
        'High-quality content creation services tailored to your niche. We produce SEO-optimized articles and copy that resonate with your audience and improve search performance.',
    }),
    features: [
      t('services.contentCreation.features.0', { fallback: 'Specialized Content' }),
      t('services.contentCreation.features.1', { fallback: 'SEO Optimized' }),
      t('services.contentCreation.features.2', { fallback: 'Content Strategy' }),
      t('services.contentCreation.features.3', { fallback: 'Publication Calendar' }),
      t('services.contentCreation.features.4', { fallback: 'Custom Graphics' }),
    ],
  },
];

const supportPillars = [
  {
    idx: '01',
    icon: 'speed',
    badge:
      lang === 'fa'
        ? 'سرعت زیر ۱ ثانیه · قبولی کامل CWV'
        : lang === 'ar'
          ? 'تحميل أقل من ثانية · اجتياز CWV'
          : 'LCP < 0.9s · INP · CLS 0.00',
    title: t('speedOptimization.title', { fallback: 'Core Web Vitals & Speed Optimization' }),
    desc: t('speedOptimization.subtitle', {
      fallback:
        'Achieve lightning-fast load times for better SEO rankings and higher conversions. We optimize images, code, and servers to pass Google Core Web Vitals.',
    }),
    href: linkPath('/services/speed-optimization'),
  },
  {
    idx: '02',
    icon: 'cro',
    badge:
      lang === 'fa'
        ? 'افزایش نرخ تبدیل · هیت‌مپ'
        : lang === 'ar'
          ? 'زيادة معدل التحويل · تدقيق UX'
          : 'CRO · Heatmap · WCAG AA',
    title: t('uiUxAudit.title', { fallback: 'Professional UI/UX Audit' }),
    desc: t('uiUxAudit.subtitle', {
      fallback:
        'Identify and fix hidden friction points on your website that are hurting sales. Get a comprehensive UI/UX audit to boost conversions and user satisfaction.',
    }),
    href: linkPath('/services/ui-ux-audit'),
  },
  {
    idx: '03',
    icon: 'maintenance',
    badge:
      lang === 'fa'
        ? 'آپ‌تایم ۹۹.۹۹٪ · امنیت و بکاپ'
        : lang === 'ar'
          ? 'جاهزية 99.99% · أمان ونسخ احتياطي'
          : '99.99% Uptime · WAF · Backup',
    title: t('maintenance.title', { fallback: 'Website Maintenance & Care Plans' }),
    desc: t('maintenance.subtitle', {
      fallback:
        'Professional website maintenance and security care plans. We keep your site secure, updated, and high-performing while you focus on growing your business.',
    }),
    href: linkPath('/services/website-maintenance'),
  },
];

const processSteps = [
  {
    step: '01',
    tag:
      lang === 'fa'
        ? 'تحلیل و استخراج کلمات'
        : lang === 'ar'
          ? 'استكشاف الكلمات والجمهور'
          : 'Query Discovery',
    title: t('services.keyFeatures.0.title', { fallback: 'Keyword Research' }),
    desc: t('services.keyFeatures.0.desc', {
      fallback: 'Identifying the best keywords and search intent for your business',
    }),
  },
  {
    step: '02',
    tag:
      lang === 'fa'
        ? 'محتوا، کد و اسکیما'
        : lang === 'ar'
          ? 'المحتوى والبيانات المنظمة'
          : 'Semantic HTML & Schema',
    title: t('services.keyFeatures.1.title', { fallback: 'Content Optimization' }),
    desc: t('services.keyFeatures.1.desc', {
      fallback: 'Quality content and structured data optimized for search engines',
    }),
  },
  {
    step: '03',
    tag:
      lang === 'fa'
        ? 'اعتبار و شبکه لینک‌ها'
        : lang === 'ar'
          ? 'بناء السلطة والروابط'
          : 'Authority Graph',
    title: t('services.keyFeatures.2.title', { fallback: 'External Link Building' }),
    desc: t('services.keyFeatures.2.desc', {
      fallback: 'Professional digital PR and backlinks to establish domain authority',
    }),
  },
  {
    step: '04',
    tag:
      lang === 'fa'
        ? 'نرخ تبدیل و سودآوری'
        : lang === 'ar'
          ? 'التحويل ومضاعفة الأرباح'
          : 'CRO & 3× Revenue',
    title:
      lang === 'fa'
        ? 'رشد فروش و نرخ تبدیل'
        : lang === 'ar'
          ? 'مضاعفة الأرباح والتحويل'
          : 'Revenue & Conversion ROI',
    desc:
      lang === 'fa'
        ? 'تبدیل ترافیک ارگانیک به فروش نهایی و بازگشت سرمایه ۳ برابری پایدار'
        : lang === 'ar'
          ? 'تحويل الزيارات إلى مبيعات فعلية وتحقيق عوائد استثمارية مضاعفة'
          : 'Converting organic search traffic into high-value leads and 3× compounding sales revenue',
  },
];
---

<section
  id="services"
  class={`relative overflow-hidden bg-background py-16 md:py-24 ${fontClass}`}
  dir={isRtl ? 'rtl' : 'ltr'}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="mx-auto mb-12 max-w-3xl text-center">
      <div class="mb-3 flex justify-center">
        <span class="inline-flex items-center rounded-full border border-primary/20 bg-primary/10 px-3.5 py-1 text-xs font-bold text-primary">
          {
            lang === 'fa'
              ? 'خدمات تخصصی دیجیتال · ۱۲ راهکار مهندسی'
              : lang === 'ar'
                ? 'الخدمات المتخصصة · 12 حلاً هندسياً متكاملاً'
                : 'Specialized Digital Services · 12 Engineering Solutions'
          }
        </span>
      </div>

      <h2 class="mb-4 text-3xl font-extrabold tracking-tight text-balance text-gray-900 sm:text-4xl lg:text-5xl dark:text-white">
        {t('services.sectionTitle.prefix', { fallback: '' })}
        <span class="text-primary">
          {t('services.sectionTitle.highlight', { fallback: 'Digital Marketing' })}
        </span>
        {t('services.sectionTitle.suffix', { fallback: ' Solutions for Your Business' })}
      </h2>

      <p class="text-base sm:text-lg leading-relaxed text-balance text-gray-600 dark:text-gray-300">
        {
          t('services.sectionDescription', {
            fallback:
              'We provide comprehensive SEO and web development services to help your business succeed online. All our services are designed according to the latest global standards and customized for the specific needs of the market.',
          })
        }
      </p>
    </div>

    <!-- Interactive Tabs Header -->
    <div class="mb-10 flex flex-wrap items-center justify-center gap-2 sm:gap-3">
      {
        services.map((service, idx) => (
          <button
            type="button"
            data-tab-btn={service.id}
            aria-pressed={idx === 0 ? 'true' : 'false'}
            class={`tab-btn cursor-pointer rounded-full px-5 py-2.5 sm:px-6 sm:py-3 text-xs sm:text-sm font-bold transition-all duration-300 ${
              idx === 0
                ? 'active-tab bg-primary text-primary-foreground shadow-md'
                : 'border border-gray-200 bg-white text-gray-700 hover:bg-gray-50 dark:border-slate-800 dark:bg-slate-900 dark:text-gray-300 dark:hover:bg-slate-800 shadow-xs'
            }`}
          >
            {service.tag}
          </button>
        ))
      }
    </div>

    <!-- Active Tab Showcase Pane -->
    <div class="mb-16">
      {
        services.map((service, idx) => (
          <div
            data-tab-content={service.id}
            class={`tab-pane rounded-3xl border border-gray-200/80 bg-white p-7 sm:p-9 lg:p-12 shadow-xl dark:border-slate-800 dark:bg-slate-900 transition-all duration-300 ${
              idx === 0 ? '' : 'hidden'
            }`}
          >
            <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-12">
              <!-- Left Column: Details & Deliverables -->
              <div class="space-y-6 lg:col-span-7">
                <div class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-3.5 py-1 text-xs font-bold text-primary">
                  <span class="h-1.5 w-1.5 rounded-full bg-primary animate-pulse"></span>
                  <span>{service.badge}</span>
                </div>

                <h3 class="text-2xl font-extrabold tracking-tight text-gray-900 sm:text-3xl lg:text-4xl dark:text-white">
                  {service.title}
                </h3>

                <p class="text-base leading-relaxed text-gray-600 dark:text-gray-300 md:text-lg">
                  {service.description}
                </p>

                <!-- Deliverable Checklist -->
                <div class="border-t border-gray-100 pt-6 dark:border-slate-800">
                  <h4 class="mb-4 text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">
                    {lang === 'fa'
                      ? 'استانداردها و دستاوردهای اجرایی'
                      : lang === 'ar'
                        ? 'معايير الإنجاز والمخرجات'
                        : 'Standards & Execution Deliverables'}
                  </h4>
                  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                    {service.features.map((feature) => (
                      <div class="flex items-center gap-2.5 text-sm font-semibold text-gray-800 dark:text-gray-200">
                        <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400">
                          <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                            <path
                              fill-rule="evenodd"
                              d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                              clip-rule="evenodd"
                            />
                          </svg>
                        </span>
                        <span>{feature}</span>
                      </div>
                    ))}
                  </div>
                </div>

                <!-- CTA Actions -->
                <div class="flex flex-wrap items-center gap-4 pt-4">
                  <button
                    type="button"
                    data-open-consultation
                    class="inline-flex cursor-pointer items-center gap-2 rounded-xl bg-primary px-6 py-3.5 text-sm font-bold text-primary-foreground shadow-md transition-all duration-300 hover:bg-primary/90 hover:shadow-lg hover:-translate-y-0.5"
                  >
                    <span>
                      {lang === 'fa'
                        ? `مشاوره تخصصی ${service.tag}`
                        : lang === 'ar'
                          ? `استشارة مجانية في ${service.tag}`
                          : `Consultation for ${service.tag}`}
                    </span>
                    <span aria-hidden="true">{isRtl ? '←' : '→'}</span>
                  </button>

                  <a
                    href={linkPath(service.href)}
                    class="inline-flex items-center gap-1.5 rounded-xl border border-gray-200 bg-gray-50 px-5 py-3.5 text-sm font-semibold text-gray-700 transition-all hover:bg-gray-100 hover:text-primary dark:border-slate-800 dark:bg-slate-800 dark:text-gray-200 dark:hover:bg-slate-700"
                  >
                    <span>{t('common.viewDetails', { fallback: 'View Details' })}</span>
                    <span aria-hidden="true">{isRtl ? '←' : '→'}</span>
                  </a>
                </div>
              </div>

              <!-- Right Column: Visual Showcase -->
              <div class="lg:col-span-5">
                <div class="relative overflow-hidden rounded-2xl border border-gray-200/80 bg-gray-50 shadow-xl dark:border-slate-800 dark:bg-slate-950">
                  <Picture
                    src={service.image}
                    formats={['avif', 'webp']}
                    alt={service.title}
                    width={600}
                    height={500}
                    loading="lazy"
                    class="h-auto w-full object-cover transition-transform duration-500 hover:scale-105"
                  />
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Technical Support & CWV Optimization Pillars -->
    <div class="mb-16">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <span class="inline-flex items-center rounded-full border border-primary/20 bg-primary/10 px-3.5 py-1 text-xs font-bold text-primary">
          {
            lang === 'fa'
              ? 'ستون‌های فنی و بهینه‌سازی سرعت'
              : lang === 'ar'
                ? 'الركائز التقنية وتحسين السرعة'
                : 'Technical Support & CWV Optimization Pillars'
          }
        </span>
        <h3 class="mt-3 text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl dark:text-white">
          {
            lang === 'fa'
              ? 'زیرساخت فوق‌سریع، بهینه‌سازی نرخ تبدیل و امنیت مداوم'
              : lang === 'ar'
                ? 'بنية تحتية فائقة السرعة وتحسين التحويل والأمان الدائم'
                : 'Engineered for Sub-Second Speed & Continuous CRO'
          }
        </h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
          {
            lang === 'fa'
              ? 'بهینه‌سازی مداوم شاخص‌های حیاتی گوگل، رفع موانع فروش و مانیتورینگ ۲۴ ساعته پایداری سایت.'
              : lang === 'ar'
                ? 'تحسين دائم لمؤشرات الويب الأساسية وإزالة نقاط الاحتكاك ومراقبة الأمان على مدار الساعة.'
                : 'Continuous Core Web Vitals refinement, conversion friction audits, and 24/7 proactive security.'
          }
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          supportPillars.map((pillar) => (
            <a
              href={pillar.href}
              class="group flex flex-col justify-between rounded-2xl border border-gray-200/80 bg-white p-6 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900"
            >
              <div>
                <div class="mb-4 flex items-center justify-between">
                  <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
                    {pillar.icon === 'speed' && (
                      <svg class="h-5 w-5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                      </svg>
                    )}
                    {pillar.icon === 'cro' && (
                      <svg class="h-5 w-5 text-purple-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                      </svg>
                    )}
                    {pillar.icon === 'maintenance' && (
                      <svg class="h-5 w-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                      </svg>
                    )}
                  </div>
                  <span class="rounded-full border border-gray-200 bg-gray-50 px-2.5 py-0.5 text-[11px] font-bold text-gray-700 dark:border-slate-700 dark:bg-slate-800 dark:text-gray-300">
                    {pillar.badge}
                  </span>
                </div>

                <h4 class="mb-2 text-base font-bold text-gray-900 transition-colors group-hover:text-primary dark:text-white">
                  {pillar.title}
                </h4>
                <p class="text-xs leading-relaxed text-gray-600 dark:text-gray-300 sm:text-sm">
                  {pillar.desc}
                </p>
              </div>

              <div class="mt-5 flex items-center gap-1 border-t border-gray-100 pt-4 text-xs font-bold text-primary dark:border-slate-800">
                <span>{t('common.viewDetails', { fallback: 'Explore Service' })}</span>
                <span aria-hidden="true">{isRtl ? '←' : '→'}</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>

    <!-- 4-Stage Execution Methodology -->
    <div class="rounded-3xl border border-gray-200/80 bg-gradient-to-br from-gray-50/80 to-white p-8 md:p-10 dark:border-slate-800 dark:from-slate-900/80 dark:to-slate-900">
      <div class="mx-auto mb-8 max-w-2xl text-center">
        <span class="mb-2 inline-flex items-center rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-xs font-bold text-primary">
          {lang === 'fa' ? 'فرآیند اجرای ۴ مرحله‌ای' : lang === 'ar' ? 'مسار التنفيذ في 4 مراحل' : '4-Stage Pipeline'}
        </span>
        <h3 class="text-xl font-extrabold text-gray-900 sm:text-2xl dark:text-white">
          {
            lang === 'fa'
              ? 'متدولوژی مهندسی وب اِی‌بی‌سی'
              : lang === 'ar'
                ? 'منهجية WebABC الهندسية'
                : 'WebABC 4-Stage Execution Methodology'
          }
        </h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
          {
            lang === 'fa'
              ? 'مسیری استاندارد و مبتنی بر داده از اولین تحلیل کلمات تا عقد قراردادهای فروش پایدار.'
              : lang === 'ar'
                ? 'مسار معياري قائم على البيانات من استكشاف الكلمات إلى إتمام الصفقات التجارية.'
                : 'A structured, data-driven pipeline from keyword discovery to closed commercial revenue.'
          }
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          processSteps.map((step) => (
            <div class="relative flex flex-col justify-between rounded-2xl border border-gray-200/80 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900">
              <div>
                <div class="mb-3 flex items-center justify-between">
                  <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-primary text-xs font-extrabold text-primary-foreground shadow-xs">
                    {step.step}
                  </span>
                  <span class="rounded-md bg-gray-100 px-2 py-0.5 text-[10px] font-bold text-gray-600 dark:bg-slate-800 dark:text-gray-400">
                    {step.tag}
                  </span>
                </div>
                <h4 class="mb-1.5 text-sm font-bold text-gray-900 dark:text-white">{step.title}</h4>
                <p class="text-xs leading-relaxed text-gray-600 dark:text-gray-400">{step.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    function initServicesTabs() {
      const tabBtns = document.querySelectorAll('#services [data-tab-btn]');
      const tabPanes = document.querySelectorAll('#services [data-tab-content]');

      if (!tabBtns.length || !tabPanes.length) return;

      const activeClasses = ['active-tab', 'bg-primary', 'text-primary-foreground', 'shadow-md'];
      const inactiveClasses = [
        'border',
        'border-gray-200',
        'bg-white',
        'text-gray-700',
        'hover:bg-gray-50',
        'dark:border-slate-800',
        'dark:bg-slate-900',
        'dark:text-gray-300',
        'dark:hover:bg-slate-800',
        'shadow-xs',
      ];

      tabBtns.forEach((btn) => {
        btn.onclick = () => {
          tabBtns.forEach((b) => {
            b.classList.remove(...activeClasses);
            b.classList.add(...inactiveClasses);
            b.setAttribute('aria-pressed', 'false');
          });
          tabPanes.forEach((pane) => pane.classList.add('hidden'));

          btn.classList.add(...activeClasses);
          btn.classList.remove(...inactiveClasses);
          btn.setAttribute('aria-pressed', 'true');

          const targetId = btn.getAttribute('data-tab-btn');
          const targetPane = document.querySelector(`#services [data-tab-content="${targetId}"]`);
          if (targetPane) targetPane.classList.remove('hidden');
        };
      });
    }

    document.addEventListener('astro:page-load', initServicesTabs);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initServicesTabs();
    }
  })();
</script>
