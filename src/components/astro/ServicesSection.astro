---
import { Picture } from 'astro:assets';
import { getDictionary } from '../../i18n/get-dictionary';
import { languages, type SupportedLanguage } from '../../types/language';
import { createTranslator } from '@/i18n/translate';
import seoImg from '../../assets/images/services/seo.webp';
import webDesignImg from '../../assets/images/services/web-design.webp';
import digitalMarketingImg from '../../assets/images/blog/digital-marketing.webp';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const dictionary = await getDictionary(lang);
const isRtl = languages[lang]?.direction === 'rtl';

// Helper to translate strings
const t = createTranslator(dictionary);

const services = [
  {
    id: 'seo',
    title: t('services.seo.title', { fallback: 'سئو تخصصی و بهینه‌سازی' }),
    description: t('services.seo.description', {
      fallback: 'افزایش رتبه وب‌سایت شما در موتورهای جستجو با استفاده از تکنیک‌های استاندارد سئو.',
    }),
    features: [
      t('services.seo.features.0', { fallback: 'تحقیق کلمات کلیدی' }),
      t('services.seo.features.1', { fallback: 'بهینه‌سازی محتوا' }),
      t('services.seo.features.2', { fallback: 'سئو فنی' }),
      t('services.seo.features.3', { fallback: 'لینک‌سازی خارجی' }),
      t('services.seo.features.4', { fallback: 'گزارش‌دهی ماهانه' }),
    ],
    image: seoImg,
  },
  {
    id: 'web-design',
    title: t('services.webDesign.title', { fallback: 'طراحی سایت اختصاصی' }),
    description: t('services.webDesign.description', {
      fallback: 'طراحی و توسعه وب‌سایت با رابط کاربری جذاب، کدنویسی تمیز و سازگار با موبایل.',
    }),
    features: [
      t('services.webDesign.features.0', { fallback: 'طراحی ریسپانسیو' }),
      t('services.webDesign.features.1', { fallback: 'رابط کاربری مدرن' }),
      t('services.webDesign.features.2', { fallback: 'سرعت بارگذاری بالا' }),
      t('services.webDesign.features.3', { fallback: 'سازگار با سئو' }),
      t('services.webDesign.features.4', { fallback: 'امنیت بالا' }),
    ],
    image: webDesignImg,
  },
  {
    id: 'content',
    title: t('services.contentCreation.title', { fallback: 'تولید محتوای تخصصی' }),
    description: t('services.contentCreation.description', {
      fallback: 'تولید محتوا با کیفیت، اصولی و بهینه شده برای کلمات کلیدی مرتبط با کسب و کار شما.',
    }),
    features: [
      t('services.contentCreation.features.0', { fallback: 'محتوای تخصصی' }),
      t('services.contentCreation.features.1', { fallback: 'بهینه‌شده برای سئو' }),
      t('services.contentCreation.features.2', { fallback: 'استراتژی محتوا' }),
      t('services.contentCreation.features.3', { fallback: 'تقویم انتشار' }),
      t('services.contentCreation.features.4', { fallback: 'گرافیک اختصاصی' }),
    ],
    image: digitalMarketingImg,
  },
];
---

<section
  id="services"
  class="relative overflow-hidden bg-linear-to-b from-background via-background to-muted/20 py-24 font-sans dark:from-background dark:to-slate-950"
>
  <div class="absolute inset-0 overflow-hidden">
    <div class="absolute bottom-0 left-0 h-96 w-96 rounded-full bg-primary/5 blur-3xl"></div>
  </div>

  <div class="relative z-10 container mx-auto px-4 md:px-6">
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <span
        class={`inline-block mb-2 px-3 py-1 rounded-full border border-primary/20 bg-primary/5 text-primary text-sm font-medium font-${lang === 'en' ? 'sans' : 'persian'}`}
      >
        {t('services.sectionTag', { fallback: 'خدمات ما' })}
      </span>

      <h2
        class={`text-3xl md:text-4xl font-bold tracking-tight mb-6 text-balance font-${lang === 'en' ? 'sans' : 'persian'}`}
      >
        {t('services.sectionTitle.prefix', { fallback: 'راهکارهای ' })}
        <span class="text-primary"
          >{t('services.sectionTitle.highlight', { fallback: 'دیجیتال مارکتینگ' })}</span
        >
        {t('services.sectionTitle.suffix', { fallback: ' برای کسب و کار شما' })}
      </h2>

      <p
        class={`text-foreground/80 leading-relaxed text-balance font-${lang === 'en' ? 'sans' : 'persian'}`}
      >
        {
          t('services.sectionDescription', {
            fallback:
              'ما خدمات جامع سئو و توسعه وب را ارائه می‌دهیم تا کسب و کار شما در فضای آنلاین موفق شود. تمامی خدمات ما با استانداردهای روز دنیا و متناسب با نیازهای بازار ایران طراحی شده‌اند.',
          })
        }
      </p>
    </div>

    <!-- Tabs header -->
    <div class="-mx-4 mb-8 flex snap-x overflow-x-auto px-4 pb-4">
      <div class="mx-auto flex gap-2">
        {
          services.map((service, idx) => (
            <button
              type="button"
              data-tab-btn={service.id}
              aria-pressed={idx === 0 ? 'true' : 'false'}
              class={`tab-btn cursor-pointer snap-start rounded-full px-6 py-3 whitespace-nowrap transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 font-${lang === 'en' ? 'sans' : 'persian'} ${
                idx === 0
                  ? 'active-tab bg-primary text-primary-foreground shadow-md'
                  : 'border border-gray-200 bg-white text-foreground/80 hover:bg-gray-50 dark:border-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700'
              }`}
            >
              {service.title}
            </button>
          ))
        }
      </div>
    </div>

    <!-- Tabs Content -->
    <div>
      {
        services.map((service, idx) => (
          <div
            data-tab-content={service.id}
            class={`tab-pane glass-morphism rounded-2xl p-8 transition-all duration-500 ${
              idx === 0 ? '' : 'hidden'
            }`}
            style="min-height: 400px;"
          >
            <div class="grid grid-cols-1 gap-8 md:grid-cols-5">
              <div class="space-y-6 md:col-span-3">
                <h3
                  class={`text-2xl font-bold text-foreground font-${lang === 'en' ? 'sans' : 'persian'}`}
                >
                  {service.title}
                </h3>

                <p
                  class={`leading-relaxed text-foreground/80 font-${lang === 'en' ? 'sans' : 'persian'}`}
                >
                  {service.description}
                </p>

                <ul class="mt-6 space-y-3">
                  {service.features.map((feature) => (
                    <li class={`flex items-center font-${lang === 'en' ? 'sans' : 'persian'}`}>
                      <svg
                        aria-hidden="true"
                        class="me-2 h-5 w-5 shrink-0 text-primary"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                        />
                      </svg>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>

                <button
                  type="button"
                  class={`mt-8 rounded-full bg-primary px-6 py-3 text-primary-foreground shadow-md transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg font-${lang === 'en' ? 'sans' : 'persian'}`}
                >
                  {t('services.consultButton', { fallback: 'مشاوره در مورد' })} {service.title}
                </button>
              </div>

              <div class="md:col-span-2">
                <div class="relative aspect-square w-full overflow-hidden rounded-xl shadow-xl">
                  <Picture
                    src={service.image}
                    formats={['avif', 'webp']}
                    alt={service.title}
                    width={500}
                    height={500}
                    loading="lazy"
                    class="h-full w-full object-cover"
                  />
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Extra features cards -->
    <div class="mt-16 grid grid-cols-1 gap-8 md:grid-cols-3">
      {
        [
          {
            title: t('services.keyFeatures.0.title', { fallback: 'تحقیق کلمات کلیدی' }),
            desc: t('services.keyFeatures.0.desc', {
              fallback: 'شناسایی بهترین کلمات کلیدی برای کسب و کار شما',
            }),
          },
          {
            title: t('services.keyFeatures.1.title', { fallback: 'بهینه‌سازی محتوا' }),
            desc: t('services.keyFeatures.1.desc', {
              fallback: 'محتوای با کیفیت و بهینه شده برای موتورهای جستجو',
            }),
          },
          {
            title: t('services.keyFeatures.2.title', { fallback: 'لینک‌سازی خارجی' }),
            desc: t('services.keyFeatures.2.desc', {
              fallback: 'استراتژی حرفه‌ای لینک‌سازی برای افزایش اعتبار سایت',
            }),
          },
        ].map((item, idx) => (
          <div class="rounded-xl neo-morphism p-6 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary">
              <span class="text-xl font-bold">{idx + 1}</span>
            </div>
            <h3 class={`mb-2 text-xl font-medium font-${lang === 'en' ? 'sans' : 'persian'}`}>
              {item.title}
            </h3>
            <p class={`text-foreground/70 font-${lang === 'en' ? 'sans' : 'persian'}`}>
              {item.desc}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    function initServicesTabs() {
      const tabBtns = document.querySelectorAll('[data-tab-btn]');
      const tabPanes = document.querySelectorAll('[data-tab-content]');

      if (!tabBtns.length) return;

      const activeClasses = ['bg-primary', 'text-primary-foreground', 'shadow-md', 'active-tab'];
      const inactiveClasses = [
        'bg-white',
        'dark:bg-slate-800',
        'text-foreground/80',
        'border',
        'border-gray-200',
        'dark:border-slate-700',
        'hover:bg-gray-50',
        'dark:hover:bg-slate-700',
      ];

      tabBtns.forEach((btn) => {
        btn.onclick = () => {
          tabBtns.forEach((b) => {
            b.classList.remove(...activeClasses);
            b.classList.add(...inactiveClasses);
            b.setAttribute('aria-pressed', 'false');
          });
          tabPanes.forEach((pane) => pane.classList.add('hidden'));

          btn.classList.add(...activeClasses);
          btn.classList.remove(...inactiveClasses);
          btn.setAttribute('aria-pressed', 'true');

          const targetId = btn.getAttribute('data-tab-btn');
          const targetPane = document.querySelector(`[data-tab-content="${targetId}"]`);
          if (targetPane) targetPane.classList.remove('hidden');
        };
      });
    }

    document.addEventListener('astro:page-load', initServicesTabs);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initServicesTabs();
    }
  })();
</script>
