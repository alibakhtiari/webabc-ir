---
import { getDictionary } from '@/i18n/get-dictionary';
import { languages, type SupportedLanguage } from '@/types/language';
import { createTranslator } from '@/i18n/translate';
import AsciiStage from './AsciiStage.astro';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const dictionary = await getDictionary(lang);
const isRtl = languages[lang]?.direction === 'rtl';
const fontClass = lang === 'en' ? 'font-sans' : lang === 'ar' ? 'font-arabic' : 'font-persian';

const t = createTranslator(dictionary);

const linkPath = (path: string) => {
  if (!path || path === '/') return `/${lang}/`;
  const cleanPath = path.startsWith('/') ? path : `/${path}`;
  return `/${lang}${cleanPath.endsWith('/') ? cleanPath : cleanPath + '/'}`;
};

const services = [
  {
    id: 'seo',
    piece: 'live-line-chart',
    badge:
      lang === 'fa'
        ? 'سئو تخصصی · رتبه ۱ گوگل'
        : lang === 'ar'
          ? 'سيو متخصص · تصدر نتائج البحث'
          : 'SERP · ORGANIC · CWV',
    href: '/services/seo',
    title: t('services.seo.title', { fallback: 'SEO & Specialized Optimization' }),
    description: t('services.seo.description', {
      fallback:
        'Professional SEO services to boost your search engine ranking. We use advanced, standard techniques to increase organic traffic, improve visibility, and grow your online presence.',
    }),
    features: [
      t('services.seo.features.0', { fallback: 'Keyword Research' }),
      t('services.seo.features.1', { fallback: 'Content Optimization' }),
      t('services.seo.features.2', { fallback: 'Technical SEO' }),
      t('services.seo.features.3', { fallback: 'External Link Building' }),
      t('services.seo.features.4', { fallback: 'Monthly Reporting' }),
    ],
  },
  {
    id: 'web-design',
    piece: 'code-editor',
    badge:
      lang === 'fa'
        ? 'طراحی اختصاصی · واکنش‌گرا'
        : lang === 'ar'
          ? 'تصميم مواقع مخصص · متجاوب'
          : 'ASTRO · REACT · WOOCOMMERCE',
    href: '/services/web-design',
    title: t('services.webDesign.title', { fallback: 'Custom Website Design' }),
    description: t('services.webDesign.description', {
      fallback:
        'Custom web design and development services for modern businesses. We create attractive, SEO-friendly, and mobile-responsive websites that engage users and drive conversions.',
    }),
    features: [
      t('services.webDesign.features.0', { fallback: 'Responsive Design' }),
      t('services.webDesign.features.1', { fallback: 'Modern User Interface' }),
      t('services.webDesign.features.2', { fallback: 'Fast Loading Speed' }),
      t('services.webDesign.features.3', { fallback: 'SEO Friendly' }),
      t('services.webDesign.features.4', { fallback: 'High Security' }),
    ],
  },
  {
    id: 'content',
    piece: 'syntax-highlight-pass',
    badge:
      lang === 'fa'
        ? 'محتوای تخصصی · سئو معنایی'
        : lang === 'ar'
          ? 'محتوى متخصص · سيو دلالي'
          : 'SEMANTIC · AEO · COPY',
    href: '/services/content-creation',
    title: t('services.contentCreation.title', { fallback: 'Specialized Content Creation' }),
    description: t('services.contentCreation.description', {
      fallback:
        'High-quality content creation services tailored to your niche. We produce SEO-optimized articles and copy that resonate with your audience and improve search performance.',
    }),
    features: [
      t('services.contentCreation.features.0', { fallback: 'Specialized Content' }),
      t('services.contentCreation.features.1', { fallback: 'SEO Optimized' }),
      t('services.contentCreation.features.2', { fallback: 'Content Strategy' }),
      t('services.contentCreation.features.3', { fallback: 'Publication Calendar' }),
      t('services.contentCreation.features.4', { fallback: 'Custom Graphics' }),
    ],
  },
];

const supportPillars = [
  {
    idx: '01',
    piece: 'request-waterfall',
    badge:
      lang === 'fa'
        ? 'سرعت زیر ۱ ثانیه · قبولی کامل CWV'
        : lang === 'ar'
          ? 'تحميل أقل من ثانية · اجتياز CWV'
          : 'LCP < 0.9s · INP · CLS 0.00',
    title: t('speedOptimization.title', { fallback: 'Core Web Vitals & Speed Optimization' }),
    desc: t('speedOptimization.subtitle', {
      fallback:
        'Achieve lightning-fast load times for better SEO rankings and higher conversions. We optimize images, code, and servers to pass Google Core Web Vitals.',
    }),
    href: linkPath('/services/speed-optimization'),
  },
  {
    idx: '02',
    piece: 'signup-funnel',
    badge:
      lang === 'fa'
        ? 'افزایش نرخ تبدیل · هیت‌مپ'
        : lang === 'ar'
          ? 'زيادة معدل التحويل · تدقيق UX'
          : 'CRO · HEATMAP · WCAG AA',
    title: t('uiUxAudit.title', { fallback: 'Professional UI/UX Audit' }),
    desc: t('uiUxAudit.subtitle', {
      fallback:
        'Identify and fix hidden friction points on your website that are hurting sales. Get a comprehensive UI/UX audit to boost conversions and user satisfaction.',
    }),
    href: linkPath('/services/ui-ux-audit'),
  },
  {
    idx: '03',
    piece: 'status-page',
    badge:
      lang === 'fa'
        ? 'آپ‌تایم ۹۹.۹۹٪ · امنیت و بکاپ'
        : lang === 'ar'
          ? 'جاهزية 99.99% · أمان ونسخ احتياطي'
          : '99.99% UPTIME · WAF · BACKUP',
    title: t('maintenance.title', { fallback: 'Website Maintenance & Care Plans' }),
    desc: t('maintenance.subtitle', {
      fallback:
        'Professional website maintenance and security care plans. We keep your site secure, updated, and high-performing while you focus on growing your business.',
    }),
    href: linkPath('/services/website-maintenance'),
  },
];

const processSteps = [
  {
    step: '01',
    tag:
      lang === 'fa'
        ? 'تحلیل و استخراج کلمات'
        : lang === 'ar'
          ? 'استكشاف الكلمات والجمهور'
          : 'QUERY-DISCOVERY',
    title: t('services.keyFeatures.0.title', { fallback: 'Keyword Research' }),
    desc: t('services.keyFeatures.0.desc', {
      fallback: 'Identifying the best keywords and search intent for your business',
    }),
  },
  {
    step: '02',
    tag:
      lang === 'fa'
        ? 'محتوا، کد و اسکیما'
        : lang === 'ar'
          ? 'المحتوى والبيانات المنظمة'
          : 'SEMANTIC-HTML & SCHEMA',
    title: t('services.keyFeatures.1.title', { fallback: 'Content Optimization' }),
    desc: t('services.keyFeatures.1.desc', {
      fallback: 'Quality content and structured data optimized for search engines',
    }),
  },
  {
    step: '03',
    tag:
      lang === 'fa'
        ? 'اعتبار و شبکه لینک‌ها'
        : lang === 'ar'
          ? 'بناء السلطة والروابط'
          : 'AUTHORITY-GRAPH',
    title: t('services.keyFeatures.2.title', { fallback: 'External Link Building' }),
    desc: t('services.keyFeatures.2.desc', {
      fallback: 'Professional digital PR and backlinks to establish domain authority',
    }),
  },
  {
    step: '04',
    tag:
      lang === 'fa'
        ? 'نرخ تبدیل و سودآوری'
        : lang === 'ar'
          ? 'التحويل ومضاعفة الأرباح'
          : 'CRO & 3× REVENUE',
    title:
      lang === 'fa'
        ? 'رشد فروش و نرخ تبدیل'
        : lang === 'ar'
          ? 'مضاعفة الأرباح والتحويل'
          : 'Revenue & Conversion ROI',
    desc:
      lang === 'fa'
        ? 'تبدیل ترافیک ارگانیک به فروش نهایی و بازگشت سرمایه ۳ برابری پایدار'
        : lang === 'ar'
          ? 'تحويل الزيارات إلى مبيعات فعلية وتحقيق عوائد استثمارية مضاعفة'
          : 'Converting organic search traffic into high-value leads and 3× compounding sales revenue',
  },
];
---

<section
  id="services"
  class={`border-b border-[var(--border-hairline)] bg-[var(--bg-canvas)] py-12 md:py-16 ${fontClass}`}
>
  <div class="container mx-auto px-4 md:px-6">
    <!-- Section Header -->
    <div class="mx-auto mb-10 max-w-3xl text-center">
      <div class="mb-2 flex justify-center">
        <span class="slash-eyebrow text-xs" dir={isRtl ? 'rtl' : 'ltr'}>
          {
            lang === 'fa'
              ? '/خدمات-تخصصی · ۱۱ راهکار مهندسی'
              : lang === 'ar'
                ? '/الخدمات-المتخصصة · 11 حلاً هندسياً'
                : '/SERVICES · 11 SPECIALIZED SOLUTIONS'
          }
        </span>
      </div>

      <h2 class="mb-3 text-2xl font-bold tracking-tight text-balance text-[var(--text-primary)] sm:text-3xl md:text-4xl">
        {t('services.sectionTitle.prefix', { fallback: '' })}
        <span class="text-[var(--accent-green)]">
          {t('services.sectionTitle.highlight', { fallback: 'Digital Marketing' })}
        </span>
        {t('services.sectionTitle.suffix', { fallback: ' Solutions for Your Business' })}
      </h2>

      <p class="text-sm leading-relaxed text-balance text-[var(--text-secondary)] sm:text-base">
        {
          t('services.sectionDescription', {
            fallback:
              'We provide comprehensive SEO and web development services to help your business succeed online. All our services are designed according to the latest global standards and customized for the specific needs of the market.',
          })
        }
      </p>
    </div>

    <!-- Interactive Split-Pane Studio -->
    <div class="terminal-window mb-10">
      <!-- Studio Top Tab Bar -->
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--border-hairline)] bg-[var(--bg-elevated)] px-3.5 py-2">
        <div class="flex flex-wrap items-center gap-1.5" role="tablist" aria-label="Core Services Studio">
          {
            services.map((service, idx) => (
              <button
                type="button"
                role="tab"
                data-tab-btn={service.id}
                data-tab-piece={service.piece}
                data-tab-badge={service.badge}
                aria-selected={idx === 0 ? 'true' : 'false'}
                class={`tab-btn cursor-pointer rounded border px-3 py-1.5 text-xs font-bold transition-all sm:text-sm ${
                  idx === 0
                    ? 'active-tab border-[var(--accent-green)] bg-[var(--bg-surface)] text-[var(--accent-green)]'
                    : 'border-[var(--border-hairline)] bg-[var(--bg-canvas)] text-[var(--text-secondary)] hover:border-[var(--border-focus)] hover:text-[var(--text-primary)]'
                }`}
              >
                <span class="ltr-isolate me-1 font-mono text-[11px] text-[var(--accent-purple)]" dir="ltr">
                  [0{idx + 1}]
                </span>
                <span>{service.title}</span>
              </button>
            ))
          }
        </div>
        <span class="monospace-telemetry-pill hidden sm:inline-flex" dir="ltr" id="studio-active-badge">
          {services[0].badge}
        </span>
      </div>

      <!-- Studio Split Body -->
      <div class="grid grid-cols-1 items-center divide-y divide-[var(--border-hairline)] lg:grid-cols-12 lg:divide-x lg:divide-y-0 rtl:lg:divide-x-reverse">
        <!-- Left Pane: Service Copy & Deliverable Pills -->
        <div class="p-5 sm:p-7 lg:col-span-5">
          {
            services.map((service, idx) => (
              <div
                data-tab-content={service.id}
                class={`tab-pane space-y-5 ${idx === 0 ? '' : 'hidden'}`}
              >
                <div>
                  <span class="slash-eyebrow text-[11px]" dir={isRtl ? 'rtl' : 'ltr'}>
                    /{service.id.toUpperCase()} · {
                      lang === 'fa'
                        ? 'مشخصات استودیو'
                        : lang === 'ar'
                          ? 'مواصفات الاستوديو'
                          : 'STUDIO SPECIFICATION'
                    }
                  </span>
                  <h3 class="mt-1 text-xl font-bold text-[var(--text-primary)] sm:text-2xl">
                    {service.title}
                  </h3>
                </div>

                <p class="text-sm leading-relaxed text-[var(--text-secondary)]">
                  {service.description}
                </p>

                <!-- Deliverable Pills -->
                <div>
                  <div class="mb-2 font-mono text-[10px] tracking-wider text-[var(--text-secondary)] uppercase">
                    {
                      lang === 'fa'
                        ? 'دستاوردهای کلیدی و قابلیت‌ها:'
                        : lang === 'ar'
                          ? 'المخرجات والإمكانيات الرئيسية:'
                          : 'DELIVERABLES & CAPABILITIES:'
                    }
                  </div>
                  <ul class="flex flex-wrap gap-1.5">
                    {service.features.map((feature) => (
                      <li class="inline-flex items-center gap-1 rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-2.5 py-1 text-xs font-medium text-[var(--text-primary)]">
                        <span class="ltr-isolate font-mono text-[var(--accent-green)]" dir="ltr">✓</span>
                        <span>{feature}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Action CTAs -->
                <div class="flex flex-wrap items-center gap-2.5 pt-1">
                  <button
                    type="button"
                    data-consult-service={service.title}
                    class="cursor-pointer rounded border border-[var(--accent-green)] bg-[var(--accent-green-dim)] px-4 py-2 text-xs font-bold text-[var(--accent-contrast)] transition-all hover:bg-[var(--accent-green)] hover:text-[#090b0e] sm:text-sm"
                  >
                    {t('services.consultButton', { fallback: 'Consult about' })} {service.title} →
                  </button>

                  <a
                    href={linkPath(service.href)}
                    class="rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3.5 py-2 text-xs font-semibold text-[var(--text-secondary)] transition-colors hover:border-[var(--accent-blue)] hover:text-[var(--accent-blue)] sm:text-sm"
                  >
                    {t('common.viewDetails', { fallback: 'View Details' })}
                  </a>
                </div>
              </div>
            ))
          }
        </div>

        <!-- Right Pane: Live Procedural <ascii-art> Preview -->
        <div class="bg-[var(--bg-canvas)] p-3 sm:p-5 lg:col-span-7">
          <AsciiStage
            id="services-studio-ascii"
            lang={lang}
            defaultPiece="live-line-chart"
            title={lang === 'fa'
              ? '/پیش‌نمایش استودیو · بوم تله‌متری زنده'
              : lang === 'ar'
                ? '/معاينة الاستوديو · لوحة القياس المباشرة'
                : '/STUDIO-PREVIEW · Live Telemetry Canvas'}
            meta="66×17 · 30 fps · 3.3 KB"
            size={11.5}
            ariaLabel={lang === 'fa'
              ? 'پیش‌نمایش تعاملی اسکی سرویس‌های وب اِی‌بی‌سی'
              : lang === 'ar'
                ? 'معاينة تفاعلية لخدمات WebABC'
                : 'Interactive ASCII preview of selected WebABC service'}
          />
        </div>
      </div>
    </div>

    <!-- Secondary Technical Services Bento Row (Support & Optimization Pillars) -->
    <div class="mb-12">
      <div class="mb-3 flex items-center justify-between">
        <span class="slash-eyebrow text-xs" dir={isRtl ? 'rtl' : 'ltr'}>
          {
            lang === 'fa'
              ? '/پشتیبانی-و-بهینه‌سازی · ارکان فنی'
              : lang === 'ar'
                ? '/الدعم-والتحسين · الركائز التقنية'
                : '/SUPPORT-AND-OPTIMIZATION · TECHNICAL PILLARS'
          }
        </span>
        <a
          href={linkPath('/services')}
          class="font-mono text-xs font-bold text-[var(--accent-blue)] hover:underline"
        >
          {t('common.viewAll', { fallback: 'View All' })} (11) {isRtl ? '←' : '→'}
        </a>
      </div>

      <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
        {
          supportPillars.map((pillar) => (
            <div class="terminal-window flex flex-col justify-between">
              <div>
                <div class="terminal-chrome-bar" dir="ltr">
                  <span class="font-mono text-xs text-[var(--accent-amber)]">
                    [{pillar.idx}] {pillar.piece}.js
                  </span>
                  <span class="monospace-telemetry-pill">{pillar.badge}</span>
                </div>

                <div
                  class="crt-scanlines overflow-hidden border-b border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-1 py-1.5"
                  dir="ltr"
                  style="unicode-bidi: isolate;"
                >
                  <ascii-art
                    piece={pillar.piece}
                    lang={lang}
                    size="10.5"
                    max-size="11.5"
                    speed="1"
                    look="original"
                    role="img"
                    aria-label={pillar.title}
                  />
                </div>

                <div class="p-4 sm:p-5">
                  <h3 class="mb-1.5 text-base font-bold text-[var(--text-primary)] sm:text-lg">{pillar.title}</h3>
                  <p class="text-xs leading-relaxed text-[var(--text-secondary)] sm:text-sm">
                    {pillar.desc}
                  </p>
                </div>
              </div>

              <div class="flex items-center justify-between border-t border-[var(--border-subtle)] bg-[var(--bg-elevated)] px-4 py-2.5">
                <button
                  type="button"
                  data-consult-service={pillar.title}
                  class={`cursor-pointer ${isRtl ? (lang === 'ar' ? 'font-arabic' : 'font-persian') : 'font-mono'} text-xs font-bold text-[var(--accent-green)] hover:underline`}
                >
                  {t('common.freeConsultation', { fallback: 'Free Consultation' })} {isRtl ? '←' : '→'}
                </button>
                <a
                  href={pillar.href}
                  class={`${isRtl ? (lang === 'ar' ? 'font-arabic' : 'font-persian') : 'font-mono'} text-xs text-[var(--text-secondary)] hover:text-[var(--text-primary)]`}
                >
                  {t('common.learnMore', { fallback: 'Specs' })} {isRtl ? '←' : '→'}
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- 3-Step Execution Pipeline (/PROCESS) -->
    <div class="terminal-window">
      <div class="terminal-chrome-bar" dir={isRtl ? 'rtl' : 'ltr'}>
        <span class="slash-eyebrow text-xs" dir={isRtl ? 'rtl' : 'ltr'}>
          {
            lang === 'fa'
              ? '/فرآیند-اجرا · پایپ‌لاین ۴ مرحله‌ای سئو و مهندسی وب'
              : lang === 'ar'
                ? '/مسار-التنفيذ · خط أنابيب رباعي المراحل'
                : '/PROCESS · 4-STAGE EXECUTION PIPELINE'
          }
        </span>
        <span class="monospace-telemetry-pill">140×14 · git-branch-graph · 1×</span>
      </div>

      <div class="grid grid-cols-1 divide-y divide-[var(--border-hairline)] sm:grid-cols-2 lg:grid-cols-4 lg:divide-x lg:divide-y-0 rtl:lg:divide-x-reverse">
        {
          processSteps.map((item) => (
            <div class="relative p-5">
              <div class="mb-2.5 flex items-center justify-between" dir={isRtl ? 'rtl' : 'ltr'}>
                <span class="font-mono text-xs font-bold text-[var(--accent-green)]">
                  [{item.step}] {isRtl ? '◄───' : '───►'}
                </span>
                <span class="monospace-telemetry-pill">{item.tag}</span>
              </div>
              <h3 class="mb-1.5 text-base font-bold text-[var(--text-primary)] sm:text-lg">{item.title}</h3>
              <p class="text-xs leading-relaxed text-[var(--text-secondary)] sm:text-sm">{item.desc}</p>
            </div>
          ))
        }
      </div>

      <!-- Live Pipeline ASCII Strip (Full-Width 140-Column Architecture) -->
      <div
        class="crt-scanlines overflow-hidden border-t border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-2 py-3"
        dir="ltr"
        style="unicode-bidi: isolate;"
      >
        <ascii-art
          piece="git-branch-graph"
          lang={lang}
          size="11.5"
          max-size="13.5"
          speed="1"
          look="original"
          role="img"
          aria-label={
            lang === 'fa'
              ? 'گراف ۴ مرحله‌ای اجرای سئو و رشد فروش'
              : lang === 'ar'
                ? 'مخطط مسار تنفيذ السيو ومضاعفة الأرباح رباعي المراحل'
                : '4-stage SEO & revenue execution pipeline graph'
          }
        ></ascii-art>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    function initServicesTabs() {
      const tabBtns = document.querySelectorAll('[data-tab-btn]');
      const tabPanes = document.querySelectorAll('[data-tab-content]');
      const studioAscii = document.getElementById('services-studio-ascii');
      const studioBadge = document.getElementById('studio-active-badge');

      if (!tabBtns.length) return;

      const activeClasses = [
        'active-tab',
        'border-[var(--accent-green)]',
        'bg-[var(--bg-surface)]',
        'text-[var(--accent-green)]',
      ];
      const inactiveClasses = [
        'border-[var(--border-hairline)]',
        'bg-[var(--bg-canvas)]',
        'text-[var(--text-secondary)]',
      ];

      tabBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          tabBtns.forEach((b) => {
            b.classList.remove(...activeClasses);
            b.classList.add(...inactiveClasses);
            b.setAttribute('aria-selected', 'false');
          });
          tabPanes.forEach((pane) => pane.classList.add('hidden'));

          btn.classList.add(...activeClasses);
          btn.classList.remove(...inactiveClasses);
          btn.setAttribute('aria-selected', 'true');

          const targetId = btn.getAttribute('data-tab-btn');
          const pieceSlug = btn.getAttribute('data-tab-piece');
          const badgeText = btn.getAttribute('data-tab-badge');

          const targetPane = document.querySelector(`[data-tab-content="${targetId}"]`);
          if (targetPane) targetPane.classList.remove('hidden');

          const asciiEl =
            studioAscii && studioAscii.tagName.toLowerCase() === 'ascii-art'
              ? studioAscii
              : studioAscii?.querySelector('ascii-art');

          if (asciiEl && pieceSlug) {
            asciiEl.setAttribute('piece', pieceSlug);
          }
          if (studioBadge && badgeText) {
            studioBadge.textContent = badgeText;
          }
        });
      });
    }

    document.addEventListener('astro:page-load', initServicesTabs);
    if (document.readyState !== 'loading') {
      initServicesTabs();
    } else {
      document.addEventListener('DOMContentLoaded', initServicesTabs);
    }
  })();
</script>
