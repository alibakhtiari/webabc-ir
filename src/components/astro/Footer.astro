---
import Logo from './Logo.astro';
import { getDictionary } from '../../i18n/get-dictionary';
import { languages, type SupportedLanguage } from '../../types/language';
import { createTranslator } from '@/i18n/translate';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const dictionary = await getDictionary(lang);
const isRtl = languages[lang]?.direction === 'rtl';

const copyrightYear = new Intl.DateTimeFormat(
  lang === 'fa' ? 'fa-IR' : lang === 'ar' ? 'ar-SA' : 'en-US',
  { year: 'numeric' }
).format(new Date());

// Helper to translate strings
const t = createTranslator(dictionary);

const linkPath = (path: string) => {
  if (!path || path === '/') return `/${lang}/`;
  const cleanPath = path.startsWith('/') ? path : `/${path}`;
  return `/${lang}${cleanPath.endsWith('/') ? cleanPath : cleanPath + '/'}`;
};
---

<footer
  class="border-t border-gray-100 bg-gray-50 pt-16 font-sans dark:border-slate-800 dark:bg-slate-950"
>
  <div class="container mx-auto px-4 md:px-6">
    <div class="mb-12 grid grid-cols-1 gap-8 md:grid-cols-4">
      <div class="md:col-span-1">
        <div class="flex flex-col space-y-4">
          <a href={linkPath('')} class="flex items-center space-x-2" aria-label={t('common.home')}>
            <Logo class="h-auto w-35 sm:w-45" />
          </a>

          <p
            class={`text-sm leading-relaxed text-foreground/70 font-${lang === 'en' ? 'sans' : 'persian'}`}
          >
            {t('common.aboutCompany')}
          </p>

          <!-- Direct Contact Information (Inline) -->
          <div
            class={`space-y-2.5 pt-1 font-${lang === 'en' ? 'sans' : 'persian'} text-sm text-foreground/80`}
          >
            <div class="flex items-center gap-2">
              <svg
                aria-hidden="true"
                class="h-4 w-4 shrink-0 text-primary"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path>
              </svg>
              <div
                class="flex flex-wrap items-center gap-x-2 gap-y-0.5 font-mono text-xs sm:text-sm"
                dir="ltr"
              >
                <a
                  href="tel:+989125811880"
                  class="transition-colors hover:text-primary focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
                >
                  +98 912 581 1880
                </a>
                <span class="text-gray-300 dark:text-gray-700">|</span>
                <a
                  href="tel:+989354767068"
                  class="transition-colors hover:text-primary focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
                >
                  +98 935 476 7068
                </a>
              </div>
            </div>

            <div class="flex items-center gap-2">
              <svg
                aria-hidden="true"
                class="h-4 w-4 shrink-0 text-primary"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
              <a
                href="mailto:info@webabc.ir"
                class="font-mono text-xs transition-colors hover:text-primary focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 sm:text-sm"
              >
                info@webabc.ir
              </a>
            </div>

            {
              lang === 'fa' && (
                <div class="flex items-start gap-2 pt-0.5">
                  <svg
                    aria-hidden="true"
                    class="mt-0.5 h-4 w-4 shrink-0 text-primary"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                    />
                  </svg>
                  <span class="text-xs leading-relaxed text-foreground/70">
                    {t('cta.addressValue')}
                  </span>
                </div>
              )
            }
          </div>

          <div class={`flex space-x-4 pt-1 ${isRtl ? 'space-x-reverse' : ''}`}>
            <!-- Verified Social Links -->
            <a
              href="https://github.com/alibakhtiari"
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-9 w-9 items-center justify-center rounded-full border border-gray-100 bg-white text-gray-600 shadow-xs transition-all hover:bg-primary hover:text-primary-foreground focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-800 dark:text-gray-300"
              aria-label="GitHub"
            >
              <svg aria-hidden="true" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"
                ><path
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                  d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.579.688.481C19.137 20.162 22 16.418 22 12c0-5.523-4.477-10-10-10z"
                ></path></svg
              >
            </a>
            <a
              href="https://x.com/aliib1991"
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-10 w-10 items-center justify-center rounded-full border border-gray-100 bg-white text-gray-600 shadow-xs transition-all hover:bg-primary hover:text-primary-foreground focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-800 dark:text-gray-300"
              aria-label="X (Twitter)"
            >
              <svg aria-hidden="true" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"
                ><path
                  d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                ></path></svg
              >
            </a>
            <a
              href="https://www.linkedin.com/in/alibakhtiarii/"
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-10 w-10 items-center justify-center rounded-full border border-gray-100 bg-white text-gray-600 shadow-xs transition-all hover:bg-primary hover:text-primary-foreground focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-800 dark:text-gray-300"
              aria-label="LinkedIn"
            >
              <svg
                aria-hidden="true"
                class="h-5 w-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                ></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"
                ></circle></svg
              >
            </a>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-8 sm:grid-cols-3 md:col-span-3">
        <div>
          <h3 class={`text-lg font-medium mb-4 font-${lang === 'en' ? 'sans' : 'persian'}`}>
            {t('common.services')}
          </h3>
          <ul class="space-y-2">
            <li>
              <a
                href={linkPath('/services/seo')}
                class="text-foreground/70 transition-colors hover:text-primary"
                >{t('services.seoTitle')}</a
              >
            </li>
            <li>
              <a
                href={linkPath('/services/web-design')}
                class="text-foreground/70 transition-colors hover:text-primary"
                >{t('services.webDesignTitle')}</a
              >
            </li>
            <li>
              <a
                href={linkPath('/services/content-creation')}
                class="text-foreground/70 transition-colors hover:text-primary"
                >{t('services.contentCreationTitle')}</a
              >
            </li>
            <li>
              <a
                href={linkPath('/services/speed-optimization')}
                class="text-foreground/70 transition-colors hover:text-primary"
                >{t('services.technicalOptimization')}</a
              >
            </li>
            <li>
              <a
                href={linkPath('/services/link-building')}
                class="text-foreground/70 transition-colors hover:text-primary"
                >{t('services.linkBuildingTitle')}</a
              >
            </li>
          </ul>
        </div>
        <div>
          <h3 class={`text-lg font-medium mb-4 font-${lang === 'en' ? 'sans' : 'persian'}`}>
            {t('common.company')}
          </h3>
          <ul class="space-y-2">
            <li>
              <a
                href={linkPath('/about')}
                class="text-foreground/70 transition-colors hover:text-primary"
                >{t('common.about')}</a
              >
            </li>
            <li>
              <a
                href={linkPath('/portfolio')}
                class="text-foreground/70 transition-colors hover:text-primary"
                >{t('common.portfolio')}</a
              >
            </li>
            <li>
              <a
                href={linkPath('/service-areas')}
                class="text-foreground/70 transition-colors hover:text-primary"
                >{t('common.serviceAreas')}</a
              >
            </li>
            <li>
              <a
                href={linkPath('/blog')}
                class="text-foreground/70 transition-colors hover:text-primary"
                >{t('common.blog')}</a
              >
            </li>
            <li>
              <a
                href={linkPath('/contact')}
                class="text-foreground/70 transition-colors hover:text-primary"
                >{t('common.contact')}</a
              >
            </li>
            <li>
              <a
                href={linkPath('/privacy')}
                class="text-foreground/70 transition-colors hover:text-primary"
                >{t('common.privacyPolicy')}</a
              >
            </li>
          </ul>
        </div>
        <div>
          <h3 class={`text-lg font-medium mb-4 font-${lang === 'en' ? 'sans' : 'persian'}`}>
            <a href={linkPath('/tools')} class="transition-colors hover:text-primary"
              >{t('common.tools')}</a
            >
          </h3>
          <ul class="space-y-2">
            <li>
              <a
                href={linkPath('/tools/meta-generator')}
                class="text-foreground/70 transition-colors hover:text-primary"
                >{t('metaGenerator.title')}</a
              >
            </li>
            <li>
              <a
                href={linkPath('/tools/serp-preview')}
                class="text-foreground/70 transition-colors hover:text-primary"
                >{t('serpPreview.title')}</a
              >
            </li>
            <li>
              <a
                href={linkPath('/tools/utm-builder')}
                class="text-foreground/70 transition-colors hover:text-primary"
                >{t('utmBuilder.title')}</a
              >
            </li>
            <li>
              <a
                href={linkPath('/tools/faq-generator')}
                class="text-foreground/70 transition-colors hover:text-primary"
                >{t('faqGenerator.title')}</a
              >
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-200 py-4 text-center dark:border-slate-800">
      <p class={`text-foreground/70 text-sm font-${lang === 'en' ? 'sans' : 'persian'}`}>
        {t('common.copyright').replace('{year}', copyrightYear)}
      </p>
    </div>
  </div>
</footer>
