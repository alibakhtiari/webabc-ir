---
import Logo from './Logo.astro';
import { getDictionary } from '@/i18n/get-dictionary';
import { languages, type SupportedLanguage } from '@/types/language';
import { createTranslator } from '@/i18n/translate';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const dictionary = await getDictionary(lang);
const isRtl = languages[lang]?.direction === 'rtl';
const fontClass = lang === 'en' ? 'font-sans' : lang === 'ar' ? 'font-arabic' : 'font-persian';

const copyrightYear = new Intl.DateTimeFormat(
  lang === 'fa' ? 'fa-IR' : lang === 'ar' ? 'ar-SA' : 'en-US',
  { year: 'numeric' }
).format(new Date());

const t = createTranslator(dictionary);

const linkPath = (path: string) => {
  if (!path || path === '/') return `/${lang}/`;
  const cleanPath = path.startsWith('/') ? path : `/${path}`;
  return `/${lang}${cleanPath.endsWith('/') ? cleanPath : cleanPath + '/'}`;
};

const phoneList = [
  {
    tel: '+989125811880',
    number: '+98 912 581 1880',
    name: lang === 'fa' ? '(بختیاری)' : lang === 'ar' ? '(بختیاری)' : '(A. Bakhtiari)',
  },
  {
    tel: '+989354767068',
    number: '+98 935 476 7068',
    name: lang === 'fa' ? '(سبدبافان)' : lang === 'ar' ? '(سبدبافان)' : '(F. SabadBafan)',
  },
];
---

<footer class="border-t border-[var(--border-hairline)] bg-[var(--bg-surface)] pt-14 font-sans text-[var(--text-primary)]">
  <div class="container mx-auto px-4 md:px-6">
    <!-- Top Terminal Status Bar -->
    <div
      class="terminal-chrome-bar mb-10 rounded border border-[var(--border-hairline)]"
      dir="ltr"
    >
      <span class="font-mono text-xs text-[var(--accent-green)]">
        ╭─ {
          lang === 'fa'
            ? '/فوتر · دایرکتوری مهندسی و سئو وب اِی‌بی‌سی'
            : lang === 'ar'
              ? '/التذييل · دليل هندسة وتطوير وسيو WebABC'
              : '/FOOTER · WebABC Engineering & SEO Directory'
        } ─╮
      </span>
      <span class="monospace-telemetry-pill">
        {
          lang === 'fa'
            ? 'قزوین · تهران · دبی · ریاض · مسقط'
            : lang === 'ar'
              ? 'دبي · الرياض · مسقط · قزوين · طهران'
              : 'QAZVIN · TEHRAN · DUBAI · RIYADH · MUSCAT'
        }
      </span>
    </div>

    <div class="mb-12 grid grid-cols-1 gap-8 border-b border-[var(--border-hairline)] pb-12 md:grid-cols-12">
      <!-- Column 1: Agency Summary & Direct Contacts -->
      <div class="space-y-4 md:col-span-4">
        <a href={linkPath('')} class="inline-flex items-center gap-2.5" aria-label={t('common.home')}>
          <span class="ltr-isolate rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-2 py-0.5 font-mono text-xs font-bold text-[var(--accent-green)]" dir="ltr">
            ▓▒░
          </span>
          <Logo class="h-auto w-32 sm:w-40" />
        </a>

        <p class={`text-sm leading-relaxed text-[var(--text-secondary)] ${fontClass}`}>
          {t('common.aboutCompany')}
        </p>

        <div class={`space-y-2.5 pt-1 text-sm ${fontClass}`}>
          {
            phoneList.map((p) => (
              <div class="flex items-center gap-2">
                <span class="ltr-isolate font-mono text-xs text-[var(--accent-green)]" dir="ltr">[TEL]</span>
                <a
                  href={`tel:${p.tel}`}
                  class="inline-flex items-center gap-1.5 text-xs transition-colors hover:text-[var(--accent-green)] sm:text-sm"
                >
                  <span dir="ltr" class="ltr-isolate font-mono text-[var(--text-primary)]">
                    {p.number}
                  </span>
                  <span class="text-[var(--text-secondary)]">{p.name}</span>
                </a>
              </div>
            ))
          }

          <div class="flex items-center gap-2">
            <span class="ltr-isolate font-mono text-xs text-[var(--accent-blue)]" dir="ltr">[MSG]</span>
            <a
              href="mailto:info@webabc.ir"
              class="ltr-isolate font-mono text-xs text-[var(--text-primary)] transition-colors hover:text-[var(--accent-blue)] sm:text-sm"
              dir="ltr"
            >
              info@webabc.ir
            </a>
          </div>

          <div class="flex items-start gap-2 pt-0.5">
            <span class="ltr-isolate font-mono text-xs text-[var(--accent-purple)]" dir="ltr">[LOC]</span>
            <span class="text-xs leading-relaxed text-[var(--text-secondary)]">
              {t('cta.addressValue', {
                fallback: 'Qazvin Science & Technology Park, Km 2 Barajin Road, Qazvin, Iran',
              })}
            </span>
          </div>
        </div>

        <!-- Verified Social Links -->
        <div class={`flex items-center gap-2.5 pt-2 ${isRtl ? 'space-x-reverse' : ''}`}>
          <a
            href="https://github.com/alibakhtiari"
            target="_blank"
            rel="noopener noreferrer"
            class="ltr-isolate inline-flex h-9 items-center gap-1.5 rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 font-mono text-xs text-[var(--text-secondary)] transition-colors hover:border-[var(--accent-green)] hover:text-[var(--accent-green)]"
            dir="ltr"
            aria-label="GitHub"
          >
            <span>GitHub</span>
          </a>
          <a
            href="https://x.com/aliib1991"
            target="_blank"
            rel="noopener noreferrer"
            class="ltr-isolate inline-flex h-9 items-center gap-1.5 rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 font-mono text-xs text-[var(--text-secondary)] transition-colors hover:border-[var(--accent-blue)] hover:text-[var(--accent-blue)]"
            dir="ltr"
            aria-label="X (Twitter)"
          >
            <span>X / Twitter</span>
          </a>
          <a
            href="https://www.linkedin.com/in/alibakhtiarii/"
            target="_blank"
            rel="noopener noreferrer"
            class="ltr-isolate inline-flex h-9 items-center gap-1.5 rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3 font-mono text-xs text-[var(--text-secondary)] transition-colors hover:border-[var(--accent-purple)] hover:text-[var(--accent-purple)]"
            dir="ltr"
            aria-label="LinkedIn"
          >
            <span>LinkedIn</span>
          </a>
        </div>
      </div>

      <!-- Link Columns: Services, Company, Tools -->
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-3 md:col-span-8">
        <!-- /SERVICES -->
        <div>
          <span class="slash-eyebrow mb-1 text-[11px]" dir={isRtl ? 'rtl' : 'ltr'}>
            {lang === 'fa' ? '/خدمات' : lang === 'ar' ? '/الخدمات' : '/SERVICES'}
          </span>
          <h3 class={`mb-4 text-base font-bold text-[var(--text-primary)] ${fontClass}`}>
            {t('common.services')}
          </h3>
          <ul class={`space-y-2.5 text-sm ${fontClass}`}>
            <li>
              <a
                href={linkPath('/services/seo')}
                class="text-[var(--text-secondary)] transition-colors hover:text-[var(--accent-green)]"
              >
                {t('services.seoTitle')}
              </a>
            </li>
            <li>
              <a
                href={linkPath('/services/web-design')}
                class="text-[var(--text-secondary)] transition-colors hover:text-[var(--accent-green)]"
              >
                {t('services.webDesignTitle')}
              </a>
            </li>
            <li>
              <a
                href={linkPath('/services/content-creation')}
                class="text-[var(--text-secondary)] transition-colors hover:text-[var(--accent-green)]"
              >
                {t('services.contentCreationTitle')}
              </a>
            </li>
            <li>
              <a
                href={linkPath('/services/speed-optimization')}
                class="text-[var(--text-secondary)] transition-colors hover:text-[var(--accent-green)]"
              >
                {t('services.technicalOptimization')}
              </a>
            </li>
            <li>
              <a
                href={linkPath('/services/link-building')}
                class="text-[var(--text-secondary)] transition-colors hover:text-[var(--accent-green)]"
              >
                {t('services.linkBuildingTitle')}
              </a>
            </li>
          </ul>
        </div>

        <!-- /COMPANY -->
        <div>
          <span class="slash-eyebrow mb-1 text-[11px]" dir={isRtl ? 'rtl' : 'ltr'}>
            {lang === 'fa' ? '/شرکت' : lang === 'ar' ? '/الشركة' : '/COMPANY'}
          </span>
          <h3 class={`mb-4 text-base font-bold text-[var(--text-primary)] ${fontClass}`}>
            {t('common.company')}
          </h3>
          <ul class={`space-y-2.5 text-sm ${fontClass}`}>
            <li>
              <a
                href={linkPath('/about')}
                class="text-[var(--text-secondary)] transition-colors hover:text-[var(--accent-green)]"
              >
                {t('common.about')}
              </a>
            </li>
            <li>
              <a
                href={linkPath('/portfolio')}
                class="text-[var(--text-secondary)] transition-colors hover:text-[var(--accent-green)]"
              >
                {t('common.portfolio')}
              </a>
            </li>
            <li>
              <a
                href={linkPath('/service-areas')}
                class="text-[var(--text-secondary)] transition-colors hover:text-[var(--accent-green)]"
              >
                {t('common.serviceAreas')}
              </a>
            </li>
            <li>
              <a
                href={linkPath('/blog')}
                class="text-[var(--text-secondary)] transition-colors hover:text-[var(--accent-green)]"
              >
                {t('common.blog')}
              </a>
            </li>
            <li>
              <a
                href={linkPath('/contact')}
                class="text-[var(--text-secondary)] transition-colors hover:text-[var(--accent-green)]"
              >
                {t('common.contact')}
              </a>
            </li>
            <li>
              <a
                href={linkPath('/privacy')}
                class="text-[var(--text-secondary)] transition-colors hover:text-[var(--accent-green)]"
              >
                {t('common.privacyPolicy')}
              </a>
            </li>
          </ul>
        </div>

        <!-- /FREE-TOOLS (All 5 Core Free Tools + Hub) -->
        <div>
          <span class="slash-eyebrow mb-1 text-[11px]" dir={isRtl ? 'rtl' : 'ltr'}>
            {lang === 'fa' ? '/ابزارهای-رایگان' : lang === 'ar' ? '/الأدوات-المجانية' : '/FREE-TOOLS'}
          </span>
          <h3 class={`mb-4 text-base font-bold text-[var(--text-primary)] ${fontClass}`}>
            <a href={linkPath('/tools')} class="transition-colors hover:text-[var(--accent-green)]">
              {t('common.tools')}
            </a>
          </h3>
          <ul class={`space-y-2.5 text-sm ${fontClass}`}>
            <li>
              <a
                href={linkPath('/tools/cost-calculator')}
                class="text-[var(--text-secondary)] transition-colors hover:text-[var(--accent-green)]"
              >
                {t('costCalculator.title', { fallback: 'Website Cost Calculator' })}
              </a>
            </li>
            <li>
              <a
                href={linkPath('/tools/meta-generator')}
                class="text-[var(--text-secondary)] transition-colors hover:text-[var(--accent-green)]"
              >
                {t('metaGenerator.title', { fallback: 'Meta Description & Tag Generator' })}
              </a>
            </li>
            <li>
              <a
                href={linkPath('/tools/headline-analyzer')}
                class="text-[var(--text-secondary)] transition-colors hover:text-[var(--accent-green)]"
              >
                {t('headlineAnalyzer.title', { fallback: 'Headline & Title Checker' })}
              </a>
            </li>
            <li>
              <a
                href={linkPath('/tools/utm-builder')}
                class="text-[var(--text-secondary)] transition-colors hover:text-[var(--accent-green)]"
              >
                {t('utmBuilder.title', { fallback: 'UTM Link Builder & URL Builder' })}
              </a>
            </li>
            <li>
              <a
                href={linkPath('/tools/faq-generator')}
                class="text-[var(--text-secondary)] transition-colors hover:text-[var(--accent-green)]"
              >
                {t('faqGenerator.title', { fallback: 'FAQ Schema Generator' })}
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between gap-3 py-6 text-center sm:flex-row">
      <div class="flex items-center gap-2">
        <!-- Exact-match brand anchor to the locale homepage (brand query 2.5) -->
        <a
          href={linkPath('')}
          class="font-mono text-sm font-bold text-[var(--accent-green)] transition-colors hover:underline"
        >
          WebABC
        </a>
        <span class="text-xs text-[var(--text-secondary)]">·</span>
        <p class={`text-xs text-[var(--text-secondary)] ${fontClass}`}>
          {t('common.copyright').replace('{year}', copyrightYear)}
        </p>
      </div>
      <div class="ltr-isolate flex items-center gap-3 font-mono text-[11px] text-[var(--text-secondary)]" dir="ltr">
        <a href={`/${lang}/llms.txt`} class="hover:text-[var(--accent-blue)]">/llms.txt</a>
        <span>·</span>
        <a href="/ai-catalog.json" class="hover:text-[var(--accent-blue)]">/ai-catalog.json</a>
        <span>·</span>
        <a href="/sitemap-index.xml" class="hover:text-[var(--accent-blue)]">/sitemap</a>
      </div>
    </div>
  </div>
</footer>
