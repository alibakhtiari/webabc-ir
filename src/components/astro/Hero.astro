---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  heroImage?: ImageMetadata;
  breadcrumbs: Array<{ label: string; url?: string }>;
  lang: string;
  gradient?: string;
  className?: string;
  centered?: boolean;
}

const {
  title,
  subtitle,
  description,
  heroImage,
  breadcrumbs,
  lang,
  gradient = heroImage
    ? 'bg-linear-to-b from-primary/10 via-background to-background'
    : 'bg-linear-to-br from-primary/10 via-background to-primary/5',
  className = '',
  centered = !heroImage,
} = Astro.props;

const fontClass = lang === 'en' ? 'font-sans' : lang === 'ar' ? 'font-arabic' : 'font-persian';
---

<section
  class={`relative overflow-hidden ${heroImage ? 'pt-28 pb-16 md:pt-32 md:pb-24' : 'pt-36 pb-20'} ${gradient} ${className}`}
>
  <div class={`relative z-10 container mx-auto px-4 ${heroImage ? 'max-w-6xl' : 'max-w-4xl'}`}>
    <Breadcrumbs items={breadcrumbs} lang={lang} centered={centered} />

    <div
      class={`mt-8 ${heroImage ? 'flex flex-col lg:flex-row items-center gap-12' : 'space-y-6 text-center mx-auto'}`}
    >
      <!-- Text Content -->
      <div class={`${heroImage ? 'lg:w-1/2 w-full' : 'w-full'}`}>
        <h1
          class={`leading-tight font-bold text-gray-900 md:text-5xl dark:text-white ${heroImage ? 'mb-6 text-4xl' : 'text-4xl'} ${fontClass}`}
        >
          {title}
        </h1>
        {
          subtitle && (
            <p class={`mb-6 text-xl leading-relaxed font-medium text-primary ${fontClass}`}>
              {subtitle}
            </p>
          )
        }
        {
          description && (
            <p
              class={`leading-relaxed text-gray-600 dark:text-gray-300 ${heroImage ? 'mb-8 text-lg' : 'mx-auto max-w-3xl text-xl'} ${fontClass}`}
            >
              {description}
            </p>
          )
        }
        <div class={`flex flex-wrap gap-4 ${centered ? 'justify-center' : ''}`}>
          <slot />
        </div>
      </div>

      <!-- Optional Hero Image -->
      {
        heroImage && (
          <div class="mt-8 w-full lg:mt-0 lg:w-1/2">
            <div class="relative h-75 w-full overflow-hidden rounded-2xl shadow-2xl lg:h-100">
              <Picture
                src={heroImage}
                formats={['avif', 'webp']}
                alt={title}
                width={600}
                height={400}
                class="h-full w-full object-cover"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
