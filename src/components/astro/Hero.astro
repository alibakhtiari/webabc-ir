---
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  title: string;
  description?: string;
  breadcrumbs: Array<{ label: string; url?: string }>;
  lang: string;
  gradient?: string;
  className?: string;
}

const {
  title,
  description,
  breadcrumbs,
  lang,
  gradient = 'bg-linear-to-br from-primary/10 via-background to-primary/5',
  className = '',
} = Astro.props;
---

<section class={`pt-36 pb-20 relative overflow-hidden ${gradient} ${className}`}>
  <div class="relative z-10 container mx-auto px-4">
    <div class="mx-auto max-w-4xl space-y-6 text-center">
      <Breadcrumbs items={breadcrumbs} lang={lang} centered={true} />

      <h1
        class="font-persian text-4xl leading-tight font-bold text-gray-900 md:text-5xl dark:text-white"
      >
        {title}
      </h1>

      {
        description && (
          <p class="mx-auto max-w-3xl font-persian text-xl leading-relaxed text-gray-600 dark:text-gray-300">
            {description}
          </p>
        )
      }

      <slot />
    </div>
  </div>
</section>
