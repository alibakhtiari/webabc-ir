---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  heroImage?: ImageMetadata;
  breadcrumbs: Array<{ label: string; url?: string }>;
  lang: string;
  gradient?: string;
  className?: string;
  centered?: boolean;
}

const {
  title,
  subtitle,
  description,
  heroImage,
  breadcrumbs,
  lang,
  className = '',
  centered = !heroImage,
} = Astro.props;

const fontClass = lang === 'en' ? 'font-sans' : lang === 'ar' ? 'font-arabic' : 'font-persian';
const isRtl = lang === 'fa' || lang === 'ar';
---

<section
  class={`relative overflow-hidden border-b border-[var(--border-hairline)] bg-[var(--bg-surface)] ${heroImage ? 'pt-12 pb-16 md:pt-16 md:pb-20' : 'pt-14 pb-16'} ${className}`}
>
  <div class={`relative z-10 container mx-auto px-4 ${heroImage ? 'max-w-6xl' : 'max-w-4xl'}`}>
    <Breadcrumbs items={breadcrumbs} lang={lang} centered={centered} />

    <div
      class={`mt-6 ${heroImage ? 'flex flex-col lg:flex-row items-center gap-12' : 'space-y-5 text-center mx-auto'}`}
    >
      <!-- Text Content -->
      <div class={`${heroImage ? 'lg:w-1/2 w-full' : 'w-full'}`}>
        <div class={`mb-3 ${centered ? 'flex justify-center' : ''}`}>
          <span class="slash-eyebrow" dir={isRtl ? 'rtl' : 'ltr'}>
            {
              lang === 'fa'
                ? '/وب-ای‌بی‌سی · مشخصات فنی و مهندسی'
                : lang === 'ar'
                  ? '/ويب-أيه-بي-سي · المواصفات الفنية'
                  : '/WEBABC · TECHNICAL SPEC'
            }
          </span>
        </div>
        <h1
          class={`leading-tight font-bold text-[var(--text-primary)] md:text-5xl ${heroImage ? 'mb-5 text-3xl sm:text-4xl' : 'text-3xl sm:text-4xl'} ${fontClass}`}
        >
          {title}
        </h1>
        {
          subtitle && (
            <p class={`mb-5 text-lg leading-relaxed font-semibold text-[var(--accent-green)] ${fontClass}`}>
              {subtitle}
            </p>
          )
        }
        {
          description && (
            <p
              class={`leading-relaxed text-[var(--text-secondary)] ${heroImage ? 'mb-8 text-base sm:text-lg' : 'mx-auto max-w-3xl text-base sm:text-lg'} ${fontClass}`}
            >
              {description}
            </p>
          )
        }
        <div class={`flex flex-wrap gap-3 ${centered ? 'justify-center' : ''}`}>
          <slot />
        </div>
      </div>

      <!-- Optional Hero Image inside Terminal Frame -->
      {
        heroImage && (
          <div class="mt-8 w-full lg:mt-0 lg:w-1/2">
            <div class="terminal-window">
              <div class="terminal-chrome-bar" dir={isRtl ? 'rtl' : 'ltr'}>
                <span>
                  {
                    lang === 'fa'
                      ? '╭─ /نمای-بصری · پردازش با کنتراست بالا ─╮'
                      : lang === 'ar'
                        ? '╭─ /عرض-الأصول · معالجة بصرية عالية الدقة ─╮'
                        : '╭─ /ASSET-VIEW · HIGH-CONTRAST RENDER ─╮'
                  }
                </span>
                <span class="monospace-telemetry-pill">AVIF · WEBP</span>
              </div>
              <div class="relative h-72 w-full overflow-hidden lg:h-96">
                <Picture
                  src={heroImage}
                  formats={['avif', 'webp']}
                  alt={title}
                  width={600}
                  height={400}
                  class="h-full w-full object-cover"
                  loading="eager"
                  fetchpriority="high"
                />
              </div>
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
