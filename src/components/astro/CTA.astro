---
import { getDictionary } from '@/i18n/get-dictionary';
import { type SupportedLanguage } from '@/types/language';
import { createTranslator } from '@/i18n/translate';

interface Props {
  lang: SupportedLanguage;
  title?: string;
  description?: string;
  buttonText?: string;
  buttonLink?: string;
  serviceName?: string;
}

const { lang, title, description, buttonText, buttonLink = '/contact', serviceName = '' } = Astro.props;

const dictionary = await getDictionary(lang);
const isRtl = lang === 'fa' || lang === 'ar';
const fontClass = lang === 'en' ? 'font-sans' : lang === 'ar' ? 'font-arabic' : 'font-persian';

const t = createTranslator(dictionary);

const ctaTitle = title || t('cta.title', { fallback: 'Ready to Grow Your Business?' });
const ctaDesc =
  description ||
  t('cta.description', {
    fallback: 'Contact our expert team today to get a customized strategy for your business.',
  });
const ctaBtnText = buttonText || t('cta.primaryButton', { fallback: 'Get Free Consultation' });
---

<div class={`terminal-window my-10 ${fontClass}`}>
  <div class="terminal-chrome-bar" dir={isRtl ? 'rtl' : 'ltr'}>
    <span class="slash-eyebrow text-xs" dir={isRtl ? 'rtl' : 'ltr'}>
      {
        lang === 'fa'
          ? '/شروع-همکاری · استراتژی و ممیزی رایگان'
          : lang === 'ar'
            ? '/ابدأ-الآن · استراتيجية وتدقيق مجاني'
            : '/GET-STARTED · FREE STRATEGY & AUDIT'
      }
    </span>
    <span class="monospace-telemetry-pill text-[var(--accent-green)]">
      ● {lang === 'fa' ? 'پاسخ‌گویی زیر ۲ ساعت' : lang === 'ar' ? 'الرد خلال أقل من ساعتين' : 'SLA < 2H'}
    </span>
  </div>

  <div class="flex flex-col items-center justify-between gap-6 p-6 sm:p-8 md:flex-row">
    <div class="max-w-2xl space-y-2 text-center md:text-start">
      <h3 class="text-xl leading-tight font-bold text-[var(--text-primary)] md:text-2xl">
        {ctaTitle}
      </h3>
      <p class="text-sm leading-relaxed text-[var(--text-secondary)] md:text-base">
        {ctaDesc}
      </p>
    </div>

    <div class="flex shrink-0 flex-wrap items-center justify-center gap-2.5">
      <button
        type="button"
        data-consult-service={serviceName}
        data-open-consultation={!serviceName ? true : undefined}
        class={`inline-flex h-10 cursor-pointer items-center justify-center gap-1.5 rounded border border-[var(--accent-green)] bg-[var(--accent-green-dim)] px-5 ${isRtl ? (lang === 'ar' ? 'font-arabic' : 'font-persian') : 'font-mono'} text-xs font-bold text-[var(--accent-contrast)] transition-all hover:bg-[var(--accent-green)] hover:text-[#090b0e]`}
      >
        <span>{ctaBtnText}</span>
        <span aria-hidden="true">{isRtl ? '←' : '→'}</span>
      </button>

      <a
        href={`/${lang}${buttonLink.endsWith('/') ? buttonLink : buttonLink + '/'}`}
        class={`inline-flex h-10 items-center justify-center rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-4 ${isRtl ? (lang === 'ar' ? 'font-arabic' : 'font-persian') : 'font-mono'} text-xs font-semibold text-[var(--text-primary)] transition-colors hover:border-[var(--accent-blue)] hover:text-[var(--accent-blue)]`}
      >
        <span>{t('common.contactUs', { fallback: 'Contact Page' })}</span>
      </a>
    </div>
  </div>
</div>
