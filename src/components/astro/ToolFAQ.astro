---
import type { SupportedLanguage } from '@/types/language';

interface Props {
  lang: SupportedLanguage;
  faqSchema?: {
    mainEntity?: Array<{
      name: string;
      acceptedAnswer: {
        text: string;
      };
    }>;
  };
}

const { lang, faqSchema } = Astro.props;
const fontClass = lang === 'en' ? 'font-sans' : lang === 'ar' ? 'font-arabic' : 'font-persian';

const items = faqSchema?.mainEntity || [];

const heading =
  lang === 'fa'
    ? 'سوالات متداول (FAQ)'
    : lang === 'ar'
      ? 'الأسئلة الشائعة (FAQ)'
      : 'Frequently Asked Questions (FAQ)';
---

{
  items.length > 0 && (
    <section class="container mx-auto mt-12 px-4 font-sans">
      <div class="mx-auto max-w-4xl space-y-6 rounded-2xl border border-gray-100 bg-white p-6 sm:p-8 dark:border-slate-800 dark:bg-slate-900">
        <h2
          class={`border-b border-gray-100 pb-4 text-xl font-bold text-gray-900 md:text-2xl dark:border-slate-800 dark:text-white ${fontClass}`}
        >
          {heading}
        </h2>
        <div class="space-y-4">
          {items.map((item) => (
            <div class="space-y-2 rounded-xl border border-gray-100 bg-gray-50/50 p-4 dark:border-slate-800 dark:bg-slate-800/50">
              <h3
                class={`text-sm font-bold text-gray-900 sm:text-base dark:text-white ${fontClass}`}
              >
                {item.name}
              </h3>
              <p
                class={`text-xs leading-relaxed text-gray-600 sm:text-sm dark:text-gray-300 ${fontClass}`}
              >
                {item.acceptedAnswer?.text || ''}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
