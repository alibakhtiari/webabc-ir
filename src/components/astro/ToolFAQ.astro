---
import type { SupportedLanguage } from '@/types/language';

interface Props {
  lang: SupportedLanguage;
  faqSchema?: {
    mainEntity?: Array<{
      name: string;
      acceptedAnswer: {
        text: string;
      };
    }>;
  };
}

const { lang, faqSchema } = Astro.props;
const fontClass = lang === 'en' ? 'font-sans' : lang === 'ar' ? 'font-arabic' : 'font-persian';
const isRtl = lang === 'fa' || lang === 'ar';

const items = faqSchema?.mainEntity || [];

const faqJsonLd: string | null = items.length > 0 && faqSchema ? JSON.stringify(faqSchema) : null;

const heading =
  lang === 'fa'
    ? 'سوالات متداول (FAQ)'
    : lang === 'ar'
      ? 'الأسئلة الشائعة (FAQ)'
      : 'Frequently Asked Questions (FAQ)';
---

{faqJsonLd && <script type="application/ld+json" set:html={faqJsonLd} />}
{
  items.length > 0 && (
    <section class="container mx-auto mt-12 px-4 font-sans">
      <div class="terminal-window mx-auto max-w-4xl">
        <div class="terminal-chrome-bar" dir={isRtl ? 'rtl' : 'ltr'}>
          <span class="slash-eyebrow text-xs" dir={isRtl ? 'rtl' : 'ltr'}>
            {
              lang === 'fa'
                ? '/سوالات-متداول · داده‌های ساختاریافته FAQ'
                : lang === 'ar'
                  ? '/الأسئلة-الشائعة · بيانات FAQ المنظمة'
                  : '/TOOL-FAQS · FAQPage JSON-LD'
            }
          </span>
          <span class="monospace-telemetry-pill">
            {
              lang === 'fa'
                ? `${items.length} پرسش و پاسخ`
                : lang === 'ar'
                  ? `${items.length} أسئلة`
                  : `${items.length} QUESTIONS`
            }
          </span>
        </div>

        <div class="space-y-4 p-6 sm:p-8">
          <h2 class={`border-b border-[var(--border-hairline)] pb-4 text-xl font-bold text-[var(--text-primary)] md:text-2xl ${fontClass}`}>
            {heading}
          </h2>
          <div class="space-y-3">
            {items.map((item, idx) => (
              <div class="space-y-1.5 rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] p-4">
                <h3 class={`flex items-start gap-2 text-sm font-bold text-[var(--text-primary)] sm:text-base ${fontClass}`}>
                  <span class="ltr-isolate font-mono text-xs text-[var(--accent-purple)]" dir="ltr">
                    Q.{String(idx + 1).padStart(2, '0')}
                  </span>
                  <span>{item.name}</span>
                </h3>
                <p class={`text-xs leading-relaxed text-[var(--text-secondary)] sm:text-sm ${fontClass}`}>
                  {item.acceptedAnswer?.text || ''}
                </p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}
