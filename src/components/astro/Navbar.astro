<script is:inline>
  (() => {
    let documentListenersBound = false;

    function openConsultationWithService(serviceName) {
      const dialog = document.getElementById('consultation-modal');
      const selectEl = document.getElementById('consultation-service');
      const msgEl = document.getElementById('consultation-message');
      if (selectEl && serviceName) {
        const match = Array.from(selectEl.options).find(
          (o) =>
            o.value.toLowerCase() === serviceName.toLowerCase() ||
            o.text.toLowerCase().includes(serviceName.toLowerCase())
        );
        if (match) {
          selectEl.value = match.value;
        } else {
          const customOpt = document.createElement('option');
          customOpt.value = serviceName;
          customOpt.textContent = serviceName;
          selectEl.appendChild(customOpt);
          selectEl.value = serviceName;
        }
      }
      if (msgEl && serviceName && !msgEl.value) {
        msgEl.placeholder = `Inquiry regarding: ${serviceName}`;
      }
      if (dialog && typeof dialog.showModal === 'function') {
        dialog.showModal();
      }
    }

    window.openConsultationModal = openConsultationWithService;

    function setupNavbar() {
      const mobileBtn = document.getElementById('mobile-menu-btn');
      const drawer = document.getElementById('mobile-drawer');
      const drawerCloseBtn = document.getElementById('mobile-drawer-close');

      function openDrawer() {
        if (!drawer) return;
        drawer.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        if (mobileBtn) mobileBtn.setAttribute('aria-expanded', 'true');
        if (drawerCloseBtn) drawerCloseBtn.focus();
      }

      function closeDrawer() {
        if (!drawer) return;
        drawer.classList.add('hidden');
        document.body.style.overflow = '';
        if (mobileBtn) {
          mobileBtn.setAttribute('aria-expanded', 'false');
          mobileBtn.focus();
        }
      }

      if (mobileBtn && drawer) {
        mobileBtn.onclick = openDrawer;
        if (drawerCloseBtn) drawerCloseBtn.onclick = closeDrawer;
        drawer.onclick = (e) => {
          if (e.target === drawer) closeDrawer();
        };
      }

      document.querySelectorAll('#desktop-services-btn').forEach((btn) => {
        const group = btn.closest('.group');
        if (!group) return;
        const sync = () =>
          btn.setAttribute('aria-expanded', String(group.matches(':hover, :focus-within')));
        group.addEventListener('mouseenter', sync);
        group.addEventListener('mouseleave', sync);
        group.addEventListener('focusin', sync);
        group.addEventListener('focusout', sync);
        sync();
      });

      const mobileLangBtn = document.getElementById('mobile-lang-btn');
      const mobileLangDropdown = document.getElementById('mobile-lang-dropdown');
      if (mobileLangBtn && mobileLangDropdown) {
        mobileLangBtn.onclick = (e) => {
          e.stopPropagation();
          const isOpen = mobileLangDropdown.classList.toggle('hidden');
          mobileLangBtn.setAttribute('aria-expanded', String(!isOpen));
        };
      }

      const themeToggle = document.getElementById('theme-toggle');
      const themeToggleMobile = document.getElementById('theme-toggle-mobile');
      const themeToggleMobileTop = document.getElementById('theme-toggle-mobile-top');

      function syncThemeUI() {
        const root = document.documentElement;
        const isDark = root.classList.contains('dark');
        const activePalette = root.getAttribute('data-palette') || 'blue';
        const labelDark = (themeToggle && themeToggle.dataset.labelDark) || 'Switch to dark mode';
        const labelLight =
          (themeToggle && themeToggle.dataset.labelLight) || 'Switch to light mode';
        const activeLabel = isDark ? labelLight : labelDark;

        document
          .querySelectorAll(
            '#theme-toggle [data-icon="sun"], #theme-toggle-mobile [data-icon="sun"]'
          )
          .forEach((el) => el.classList.toggle('hidden', !isDark));
        document
          .querySelectorAll(
            '#theme-toggle [data-icon="moon"], #theme-toggle-mobile [data-icon="moon"]'
          )
          .forEach((el) => el.classList.toggle('hidden', isDark));

        const modePill = document.querySelector('[data-theme-mode-pill]');
        if (modePill) modePill.textContent = isDark ? 'DARK' : 'WHITE';

        const modePillMobile = document.querySelector('[data-theme-mode-pill-mobile]');
        if (modePillMobile) modePillMobile.textContent = isDark ? 'DARK' : 'WHITE';

        if (themeToggle) themeToggle.setAttribute('aria-label', activeLabel);
        if (themeToggleMobile) {
          themeToggleMobile.setAttribute('aria-label', activeLabel);
          const labelSpan = themeToggleMobile.querySelector('[data-theme-label]');
          if (labelSpan) labelSpan.textContent = activeLabel;
        }

        // Sync active palette swatch buttons
        document.querySelectorAll('[data-palette-btn]').forEach((btn) => {
          const isCurrent = btn.getAttribute('data-palette-btn') === activePalette;
          btn.classList.toggle('is-active', isCurrent);
          btn.setAttribute('aria-pressed', String(isCurrent));
        });
      }

      function toggleTheme() {
        const root = document.documentElement;
        const isDark = root.classList.contains('dark');
        const nextDark = !isDark;
        root.classList.toggle('dark', nextDark);
        root.setAttribute('data-theme', nextDark ? 'dark' : 'light');
        root.style.colorScheme = nextDark ? 'dark' : 'light';
        try {
          localStorage.setItem('theme', nextDark ? 'dark' : 'light');
        } catch (e) {}
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', nextDark ? '#070b14' : '#ffffff');
        syncThemeUI();
      }

      function setPalette(paletteId) {
        if (!paletteId) return;
        const root = document.documentElement;
        root.setAttribute('data-palette', paletteId);
        try {
          localStorage.setItem('palette', paletteId);
        } catch (e) {}
        syncThemeUI();
      }

      if (themeToggle) themeToggle.onclick = toggleTheme;
      if (themeToggleMobile) themeToggleMobile.onclick = toggleTheme;
      if (themeToggleMobileTop) themeToggleMobileTop.onclick = toggleTheme;

      document.querySelectorAll('[data-palette-btn]').forEach((btn) => {
        btn.onclick = () => {
          const pId = btn.getAttribute('data-palette-btn');
          setPalette(pId);
        };
      });

      syncThemeUI();

      const dialog = document.getElementById('consultation-modal');
      const openBtn = document.getElementById('open-consultation-btn');
      const openMobileBtn = document.getElementById('open-consultation-btn-mobile');
      const closeBtn = document.getElementById('close-modal-btn');
      const consultForm = document.getElementById('consultation-form');
      const consultSubmitBtn = document.getElementById('consultation-submit-btn');
      const consultResponseMsg = document.getElementById('consultation-response-msg');

      if (openBtn && dialog) openBtn.onclick = () => openConsultationWithService('');
      if (openMobileBtn && dialog) {
        openMobileBtn.onclick = () => {
          closeDrawer();
          openConsultationWithService('');
        };
      }
      if (closeBtn && dialog) closeBtn.onclick = () => dialog.close();
      if (dialog) {
        dialog.onclick = (e) => {
          if (e.target === dialog) dialog.close();
        };
      }

      // Bind any page button with [data-consult-service] or [data-open-consultation]
      document.querySelectorAll('[data-consult-service], [data-open-consultation]').forEach((btn) => {
        if (btn.id === 'open-consultation-btn' || btn.id === 'open-consultation-btn-mobile') return;
        btn.addEventListener('click', () => {
          const svc = btn.getAttribute('data-consult-service') || '';
          openConsultationWithService(svc);
        });
      });

      if (consultForm && consultSubmitBtn && consultResponseMsg) {
        consultForm.onsubmit = async (e) => {
          e.preventDefault();
          const origText = consultSubmitBtn.textContent;
          consultSubmitBtn.disabled = true;
          consultSubmitBtn.textContent = '...';
          consultResponseMsg.classList.add('hidden');

          const fd = new FormData(consultForm);
          const selectedSvc = fd.get('service');
          const rawMsg = fd.get('message') || '';
          const payload = {
            name: fd.get('name'),
            phone: fd.get('phone'),
            email: fd.get('email'),
            message: selectedSvc ? `[Service: ${selectedSvc}] ${rawMsg}` : rawMsg,
          };

          try {
            const res = await fetch('/api/contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });

            if (res.ok) {
              consultResponseMsg.textContent = '✓ Request submitted successfully!';
              consultResponseMsg.className =
                'text-center font-mono text-xs text-[var(--accent-green)] block';
              consultForm.reset();
              setTimeout(() => {
                if (dialog && dialog.open) dialog.close();
                consultResponseMsg.classList.add('hidden');
                consultSubmitBtn.disabled = false;
                consultSubmitBtn.textContent = origText;
              }, 2000);
            } else {
              const data = await res.json().catch(() => ({}));
              consultResponseMsg.textContent =
                data.error || 'Failed to send request. Please try again.';
              consultResponseMsg.className =
                'text-center font-mono text-xs text-[var(--accent-coral)] block';
              consultSubmitBtn.disabled = false;
              consultSubmitBtn.textContent = origText;
            }
          } catch (err) {
            consultResponseMsg.textContent = 'Network error. Please try again.';
            consultResponseMsg.className =
              'text-center font-mono text-xs text-[var(--accent-coral)] block';
            consultSubmitBtn.disabled = false;
            consultSubmitBtn.textContent = origText;
          }
        };
      }

      if (!documentListenersBound) {
        documentListenersBound = true;
        document.addEventListener('click', (e) => {
          const mBtn = document.getElementById('mobile-lang-btn');
          const mDrop = document.getElementById('mobile-lang-dropdown');
          if (mBtn && mDrop && !mBtn.contains(e.target) && !mDrop.contains(e.target)) {
            mDrop.classList.add('hidden');
            mBtn.setAttribute('aria-expanded', 'false');
          }
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            const d = document.getElementById('mobile-drawer');
            if (d && !d.classList.contains('hidden')) {
              d.classList.add('hidden');
              document.body.style.overflow = '';
            }
          }
        });
      }
    }

    document.addEventListener('astro:page-load', setupNavbar);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      setupNavbar();
    } else {
      document.addEventListener('DOMContentLoaded', setupNavbar);
    }
  })();
</script>
