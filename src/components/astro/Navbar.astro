---
import Logo from './Logo.astro';
import { getDictionary } from '../../i18n/get-dictionary';
import { languages, type SupportedLanguage } from '../../types/language';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const dictionary = await getDictionary(lang);
const isRtl = languages[lang]?.direction === 'rtl';

// Helper to translate strings
const t = (key: string) => {
  const parts = key.split('.');
  let current: any = dictionary;
  for (const part of parts) {
    if (current && current[part] !== undefined) {
      current = current[part];
    } else {
      return key;
    }
  }
  return typeof current === 'string' ? current : key;
};

// Generate relative paths correctly based on lang
const linkPath = (path: string) => {
  return `/${lang}${path}`;
};

const navItems = [
  { key: 'portfolio', label: 'common.portfolio', href: '/portfolio' },
  { key: 'blog', label: 'common.blog', href: '/blog' },
  { key: 'about', label: 'common.about', href: '/about' },
  { key: 'contact', label: 'common.contact', href: '/contact' },
];

const currentPathWithoutLang = Astro.url.pathname.replace(/^\/(en|fa|ar)/, '') || '/';
---

<header id="main-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 ease-in-out px-4 py-5">
  <div class="mx-auto max-w-7xl">
    <div class="flex items-center justify-between backdrop-blur-xl bg-white/40 rounded-full px-6 py-3 shadow-lg border border-white/20">
      
      <!-- Brand Logo -->
      <a href={linkPath('')} class="flex items-center space-x-2" aria-label={t('common.home')}>
        <Logo class="w-[140px] xs:w-[160px] sm:w-[180px] xl:w-[260px] h-auto transition-all" />
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden xl:flex items-center gap-6">
        <!-- Services dropdown (simplified to simple navigation in Astro for speed, or dropdown trigger) -->
        <div class="relative group">
          <button class={`flex items-center gap-1 text-sm font-medium text-foreground/80 hover:text-primary transition-colors font-${lang === 'en' ? 'sans' : 'persian'}`}>
            {t('common.services')}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          <!-- Hover Dropdown content -->
          <div class="absolute top-full left-0 mt-2 w-56 rounded-md shadow-lg bg-white border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 py-2">
            <a href={linkPath('/services/seo')} class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">{t('services.seoTitle')}</a>
            <a href={linkPath('/services/web-design')} class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">{t('services.webDesignTitle')}</a>
            <a href={linkPath('/services/content-creation')} class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">{t('services.contentCreationTitle')}</a>
            <a href={linkPath('/services/speed-optimization')} class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">{t('services.technicalOptimization')}</a>
            <a href={linkPath('/services/link-building')} class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">{t('services.linkBuildingTitle')}</a>
          </div>
        </div>

        {navItems.map((item) => (
          <a href={linkPath(item.href)} class={`text-sm font-medium text-foreground/80 hover:text-primary transition-colors font-${lang === 'en' ? 'sans' : 'persian'}`}>
            {t(item.label)}
          </a>
        ))}

        <!-- Language Select -->
        <div class="relative group">
          <button class="flex items-center gap-1 text-sm font-medium text-foreground/80 hover:text-primary transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>
            <span class="uppercase">{lang}</span>
          </button>
          <div class="absolute top-full right-0 mt-2 w-28 rounded-md shadow-lg bg-white border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 py-1">
            {Object.keys(languages).map((l) => (
              <a href={`/${l}${currentPathWithoutLang}`} class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 text-center uppercase">{l}</a>
            ))}
          </div>
        </div>

        <button id="open-consultation-btn" class="px-4 py-2 bg-primary text-white text-sm font-medium rounded-md hover:bg-primary/95 transition-all">
          {t('common.freeConsultation')}
        </button>
      </nav>

      <!-- Mobile Controls -->
      <div class="xl:hidden flex items-center gap-3">
        <!-- Mobile Language Selector -->
        <div class="relative">
          <button id="mobile-lang-btn" class="flex items-center gap-1.5 text-sm font-semibold px-3 py-1.5 rounded-full bg-white/80 hover:bg-gray-100 text-gray-700 border border-gray-100 shadow-xs transition-all">
            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>
            <span>{languages[lang]?.nativeName}</span>
          </button>
          <div id="mobile-lang-dropdown" class="hidden absolute top-full right-0 mt-2 w-32 rounded-xl shadow-xl bg-white border border-gray-100 z-50 py-1">
            {Object.entries(languages).map(([code, meta]) => (
              <a href={`/${code}${currentPathWithoutLang}`} class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 text-center font-medium">
                {meta.nativeName}
              </a>
            ))}
          </div>
        </div>
        
        <button id="mobile-menu-btn" class="p-2 text-foreground/80 hover:text-foreground focus:outline-none" aria-label="Toggle Menu">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown drawer Menu -->
  <div id="mobile-drawer" class="hidden fixed inset-0 z-40 bg-black/50 backdrop-blur-xs transition-opacity duration-300">
    <div class={`fixed top-0 bottom-0 ${isRtl ? 'left-0' : 'right-0'} w-[85%] max-w-sm bg-white shadow-2xl p-6 flex flex-col h-full overflow-y-auto z-50`}>
      <div class={`flex flex-col space-y-6 font-${lang === 'en' ? 'sans' : 'persian'} h-full justify-between`}>
        
        <div class="space-y-6">
          <!-- Header -->
          <div class="pb-4 border-b border-gray-100 flex items-center justify-between">
            <a href={linkPath('')} class="flex items-center space-x-2">
              <Logo class="w-[130px] h-auto" />
            </a>
            <button id="mobile-drawer-close" class="text-gray-400 hover:text-gray-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
          </div>

          <!-- Links List -->
          <div class="space-y-4">
            <a href={linkPath('')} class="block text-lg font-medium text-gray-900 hover:text-primary transition-colors">{t('common.home')}</a>
            
            <!-- Services Nested Menu -->
            <div class="border-y border-gray-100 py-4 my-2 space-y-4">
              <div class="text-lg font-bold text-gray-900">{t('common.services')}</div>
              <a href={linkPath('/services')} class="block ps-3 border-l-2 border-primary/40 text-foreground/80 hover:text-primary font-medium">{t('common.allServices')}</a>
              
              <!-- SEO Services Subgroup -->
              <div class="ps-3 space-y-2">
                <h4 class="text-xs font-bold text-muted-foreground uppercase tracking-wider">{t('common.seoServices')}</h4>
                <div class="grid grid-cols-2 gap-2 border-l border-gray-100 ps-3">
                  <a href={linkPath('/services/seo')} class="text-sm text-foreground/80 hover:text-primary py-1">{t('services.seoTitle')}</a>
                  <a href={linkPath('/services/local-seo')} class="text-sm text-foreground/80 hover:text-primary py-1">{t('services.localSeoTitle')}</a>
                  <a href={linkPath('/services/link-building')} class="text-sm text-foreground/80 hover:text-primary py-1">{t('services.linkBuildingTitle')}</a>
                  <a href={linkPath('/services/content-creation')} class="text-sm text-foreground/80 hover:text-primary py-1">{t('services.contentCreationTitle')}</a>
                </div>
              </div>

              <!-- Development Services Subgroup -->
              <div class="ps-3 space-y-2">
                <h4 class="text-xs font-bold text-muted-foreground uppercase tracking-wider">{t('common.developmentServices')}</h4>
                <div class="grid grid-cols-2 gap-2 border-l border-gray-100 ps-3">
                  <a href={linkPath('/services/web-development')} class="text-sm text-foreground/80 hover:text-primary py-1">{t('services.webDevTitle')}</a>
                  <a href={linkPath('/services/wordpress-development')} class="text-sm text-foreground/80 hover:text-primary py-1">{t('wordpress.wordpressAndWoocommerce')}</a>
                  <a href={linkPath('/services/web-design')} class="text-sm text-foreground/80 hover:text-primary py-1">{t('common.webDesignAndDevelopment')}</a>
                  <a href={linkPath('/services/modern-web-development')} class="text-sm text-foreground/80 hover:text-primary py-1">{t('common.modernWebDevelopment')}</a>
                </div>
              </div>
            </div>

            <a href={linkPath('/portfolio')} class="block text-lg font-medium text-gray-900 hover:text-primary transition-colors">{t('common.portfolio')}</a>
            <a href={linkPath('/service-areas')} class="block text-lg font-medium text-gray-900 hover:text-primary transition-colors">{t('common.serviceAreas')}</a>
            <a href={linkPath('/blog')} class="block text-lg font-medium text-gray-900 hover:text-primary transition-colors">{t('common.blog')}</a>
            <a href={linkPath('/about')} class="block text-lg font-medium text-gray-900 hover:text-primary transition-colors">{t('common.about')}</a>
            <a href={linkPath('/contact')} class="block text-lg font-medium text-gray-900 hover:text-primary transition-colors">{t('common.contact')}</a>
          </div>
        </div>

        <div>
          <!-- Language buttons Inline -->
          <div class="flex gap-2 py-4 justify-center border-t border-gray-100">
            {Object.entries(languages).map(([code, meta]) => (
              <a
                href={`/${code}${currentPathWithoutLang}`}
                class={`px-4 py-2 text-xs font-bold rounded-lg border transition-all ${lang === code ? 'bg-primary text-white border-primary' : 'bg-white text-gray-600 border-gray-200 hover:bg-gray-50'}`}
              >
                {meta.nativeName}
              </a>
            ))}
          </div>

          <!-- Button -->
          <button id="open-consultation-btn-mobile" class="w-full py-3 bg-primary text-white rounded-xl shadow-md text-center font-bold">
            {t('common.freeConsultation')}
          </button>
        </div>

      </div>
    </div>
  </div>
</header>

<!-- Native HTML5 Dialog for Consultation Form -->
<dialog id="consultation-modal" class="rounded-2xl border-0 p-0 shadow-2xl backdrop:bg-black/50 max-w-lg w-full overflow-hidden">
  <div class="p-6 bg-white space-y-6 relative">
    <button id="close-modal-btn" class="absolute top-4 right-4 p-2 text-gray-400 hover:text-gray-600">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
    <div class="text-center">
      <h3 class="text-2xl font-bold text-gray-900">{t('common.freeConsultation')}</h3>
      <p class="text-sm text-gray-600 mt-2">Get in touch with our experts for custom advice</p>
    </div>
    <form class="space-y-4">
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Name</label>
        <input type="text" required class="w-full h-11 border border-gray-200 rounded-lg px-4 focus:outline-none focus:border-primary" />
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Email / Phone</label>
        <input type="text" required class="w-full h-11 border border-gray-200 rounded-lg px-4 focus:outline-none focus:border-primary" />
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Message</label>
        <textarea rows="3" required class="w-full border border-gray-200 rounded-lg p-4 focus:outline-none focus:border-primary resize-none"></textarea>
      </div>
      <button type="submit" class="w-full h-11 bg-primary text-white font-bold rounded-lg shadow-md hover:bg-primary/95 transition-all">
        Submit Request
      </button>
    </form>
  </div>
</dialog>

<script is:inline>
  // Dynamic Scroll Behavior
  const header = document.getElementById('main-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 10) {
      header.classList.remove('py-5');
      header.classList.add('py-3');
    } else {
      header.classList.remove('py-3');
      header.classList.add('py-5');
    }
  }, { passive: true });

  // Mobile Menu Drawer Control
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-drawer');
  const drawerCloseBtn = document.getElementById('mobile-drawer-close');

  if (mobileBtn && drawer) {
    mobileBtn.addEventListener('click', () => {
      drawer.classList.remove('hidden');
    });
    if (drawerCloseBtn) {
      drawerCloseBtn.addEventListener('click', () => {
        drawer.classList.add('hidden');
      });
    }
    drawer.addEventListener('click', (e) => {
      if (e.target === drawer) drawer.classList.add('hidden');
    });
  }

  // Mobile Language Dropdown Toggle
  const mobileLangBtn = document.getElementById('mobile-lang-btn');
  const mobileLangDropdown = document.getElementById('mobile-lang-dropdown');
  if (mobileLangBtn && mobileLangDropdown) {
    mobileLangBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      mobileLangDropdown.classList.toggle('hidden');
    });
    document.addEventListener('click', (e) => {
      if (!mobileLangBtn.contains(e.target)) {
        mobileLangDropdown.classList.add('hidden');
      }
    });
  }

  // Dialog Controls
  const dialog = document.getElementById('consultation-modal');
  const openBtn = document.getElementById('open-consultation-btn');
  const openMobileBtn = document.getElementById('open-consultation-btn-mobile');
  const closeBtn = document.getElementById('close-modal-btn');

  const openModal = () => dialog && dialog.showModal();
  const closeModal = () => dialog && dialog.close();

  if (openBtn) openBtn.addEventListener('click', openModal);
  if (openMobileBtn) openMobileBtn.addEventListener('click', () => {
    if (drawer) drawer.classList.add('hidden');
    openModal();
  });
  if (closeBtn) closeBtn.addEventListener('click', closeModal);
</script>
