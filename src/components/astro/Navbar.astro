---
import Logo from './Logo.astro';
import { getDictionary } from '../../i18n/get-dictionary';
import { languages, type SupportedLanguage } from '../../types/language';
import { createTranslator } from '@/i18n/translate';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const dictionary = await getDictionary(lang);
const isRtl = languages[lang]?.direction === 'rtl';

const t = createTranslator(dictionary);

const linkPath = (path: string) => {
  if (!path || path === '/') return `/${lang}/`;
  const cleanPath = path.startsWith('/') ? path : `/${path}`;
  return `/${lang}${cleanPath.endsWith('/') ? cleanPath : cleanPath + '/'}`;
};

const navItems = [
  { key: 'service-areas', label: 'common.serviceAreas', href: '/service-areas' },
  { key: 'portfolio', label: 'common.portfolio', href: '/portfolio' },
  { key: 'tools', label: 'common.tools', href: '/tools' },
  { key: 'blog', label: 'common.blog', href: '/blog' },
  { key: 'about', label: 'common.about', href: '/about' },
  { key: 'contact', label: 'common.contact', href: '/contact' },
];

const currentPathWithoutLang = Astro.url.pathname.replace(/^\/(en|fa|ar)/, '') || '/';
const isActive = (href: string) =>
  currentPathWithoutLang === href || currentPathWithoutLang.startsWith(`${href}/`);

const fontClass = lang === 'en' ? 'font-sans' : lang === 'ar' ? 'font-arabic' : 'font-persian';

const whatsappMessages: Record<string, string> = {
  fa: 'سلام، مایل به دریافت مشاوره رایگان طراحی سایت و سئو هستم.',
  ar: 'مرحباً، أود الحصول على استشارة مجانية لتصميم المواقع والسيو.',
  en: 'Hello, I would like to request a free web design and SEO consultation.',
};
const encodedNavMsg = encodeURIComponent(whatsappMessages[lang] || whatsappMessages.en);
const navWhatsappUrl = `https://wa.me/989125811880?text=${encodedNavMsg}`;
const waDirectLabel =
  lang === 'fa'
    ? 'یا گفتگوی فوری در واتساپ'
    : lang === 'ar'
      ? 'أو تحدث معنا مباشرة عبر واتساب'
      : 'Or Chat Directly on WhatsApp';

const formFeedback = {
  success:
    lang === 'fa'
      ? 'درخواست شما با موفقیت ثبت شد! کارشناسان ما به‌زودی با شما تماس می‌گیرند.'
      : lang === 'ar'
        ? 'تم إرسال طلبك بنجاح! سيتواصل معك فريقنا قريباً.'
        : 'Request submitted! Our engineering team will contact you shortly.',
  error:
    lang === 'fa'
      ? 'ارسال درخواست انجام نشد. لطفاً دوباره تلاش کنید.'
      : lang === 'ar'
        ? 'تعذر إرسال الطلب. يرجى المحاولة مرة أخرى.'
        : 'Could not send request. Please try again.',
  network:
    lang === 'fa'
      ? 'خطا در ارتباط شبکه. لطفاً اتصال خود را بررسی کنید یا از واتساپ پیام دهید.'
      : lang === 'ar'
        ? 'خطأ في الشبكة. يرجى المحاولة مجدداً أو مراسلتنا عبر واتساب.'
        : 'Network error. Please try again or reach us via WhatsApp.',
};
---

<header
  id="main-header"
  class="fixed top-0 right-0 left-0 z-50 px-4 py-3 transition-colors duration-300"
>
  <div class="mx-auto max-w-7xl">
    <div
      class="flex items-center justify-between rounded-full border border-white/20 bg-white/75 px-6 py-3 shadow-lg backdrop-blur-xl dark:border-slate-800/80 dark:bg-slate-900/85"
    >
      <!-- Brand Logo -->
      <a href={linkPath('')} class="flex items-center gap-2 shrink-0" aria-label={t('common.home')}>
        <Logo class="h-8 w-auto min-w-[140px] sm:min-w-[160px] md:min-w-[180px] sm:h-9 xl:h-10 shrink-0" />
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="mx-4 hidden grow items-center justify-center gap-3.5 xl:gap-5 lg:flex">
        <!-- Services Mega Menu -->
        <div class="group relative">
          <button
            type="button"
            id="desktop-services-btn"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="desktop-services-panel"
            class={`flex cursor-pointer items-center gap-1 text-sm font-medium text-foreground/80 hover:text-primary transition-colors ${fontClass}`}
          >
            {t('common.services')}
            <svg
              aria-hidden="true"
              class="h-4 w-4 transition-transform duration-200 group-focus-within:rotate-180 group-hover:rotate-180"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"></path></svg
            >
          </button>

          <!-- Mega Menu dropdown content -->
          <div
            id="desktop-services-panel"
            class={`absolute top-full ${isRtl ? '-right-25' : '-left-25'} mt-2 w-185 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-opacity duration-200 z-50 ${fontClass}`}
          >
            <div
              class="rounded-2xl border border-gray-100 bg-white p-6 shadow-2xl dark:border-slate-800 dark:bg-slate-900"
            >
              <div class="grid grid-cols-3 gap-6 text-start">
                <!-- SEO Services Column -->
                <div class="space-y-4">
                  <div
                    class="mb-2 flex items-center gap-2 border-b border-gray-100 pb-2 dark:border-slate-800"
                  >
                    <svg
                      aria-hidden="true"
                      class="h-4 w-4 text-primary"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
                      ></path></svg
                    >
                    <p class="text-sm font-bold text-primary">
                      {t('common.seoServices', { fallback: 'SEO Services' })}
                    </p>
                  </div>
                  <ul class="space-y-3">
                    <li>
                      <a
                        href={linkPath('/services/seo')}
                        class="block text-sm text-gray-700 transition-colors hover:text-primary dark:text-gray-200 dark:hover:text-primary"
                      >
                        <span class="block font-semibold"
                          >{t('services.seoTitle', { fallback: 'SEO Optimization' })}</span
                        >
                        <span class="line-clamp-1 text-[11px] text-gray-500 dark:text-gray-400"
                          >{
                            t('services.seoDescription', { fallback: 'Search ranking growth' })
                          }</span
                        >
                      </a>
                    </li>
                    <li>
                      <a
                        href={linkPath('/services/local-seo')}
                        class="block text-sm text-gray-700 transition-colors hover:text-primary dark:text-gray-200 dark:hover:text-primary"
                      >
                        <span class="block font-semibold"
                          >{t('services.localSeoTitle', { fallback: 'Local SEO' })}</span
                        >
                        <span class="line-clamp-1 text-[11px] text-gray-500 dark:text-gray-400"
                          >{
                            t('services.localSeoDescription', { fallback: 'Google Maps marketing' })
                          }</span
                        >
                      </a>
                    </li>
                    <li>
                      <a
                        href={linkPath('/services/link-building')}
                        class="block text-sm text-gray-700 transition-colors hover:text-primary dark:text-gray-200 dark:hover:text-primary"
                      >
                        <span class="block font-semibold"
                          >{t('services.linkBuildingTitle', { fallback: 'Link Building' })}</span
                        >
                        <span class="line-clamp-1 text-[11px] text-gray-500 dark:text-gray-400"
                          >{
                            t('services.linkBuildingDescription', {
                              fallback: 'Authority enhancement',
                            })
                          }</span
                        >
                      </a>
                    </li>
                    <li>
                      <a
                        href={linkPath('/services/content-creation')}
                        class="block text-sm text-gray-700 transition-colors hover:text-primary dark:text-gray-200 dark:hover:text-primary"
                      >
                        <span class="block font-semibold"
                          >{
                            t('services.contentCreationTitle', { fallback: 'Content Strategy' })
                          }</span
                        >
                        <span class="line-clamp-1 text-[11px] text-gray-500 dark:text-gray-400"
                          >{
                            t('services.contentCreationDescription', {
                              fallback: 'SEO articles writing',
                            })
                          }</span
                        >
                      </a>
                    </li>
                  </ul>
                </div>

                <!-- Development Column -->
                <div class="space-y-4">
                  <div
                    class="mb-2 flex items-center gap-2 border-b border-gray-100 pb-2 dark:border-slate-800"
                  >
                    <svg
                      aria-hidden="true"
                      class="h-4 w-4 text-primary"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg
                    >
                    <p class="text-sm font-bold text-primary">
                      {t('common.developmentServices', { fallback: 'Development' })}
                    </p>
                  </div>
                  <ul class="space-y-3">
                    <li>
                      <a
                        href={linkPath('/services/web-development')}
                        class="block text-sm text-gray-700 transition-colors hover:text-primary dark:text-gray-200 dark:hover:text-primary"
                      >
                        <span class="block font-semibold"
                          >{t('services.webDevTitle', { fallback: 'Web Development' })}</span
                        >
                        <span class="line-clamp-1 text-[11px] text-gray-500 dark:text-gray-400"
                          >{
                            t('services.webDevDescription', {
                              fallback: 'Custom web projects coding',
                            })
                          }</span
                        >
                      </a>
                    </li>
                    <li>
                      <a
                        href={linkPath('/services/wordpress-development')}
                        class="block text-sm text-gray-700 transition-colors hover:text-primary dark:text-gray-200 dark:hover:text-primary"
                      >
                        <span class="block font-semibold"
                          >{
                            t('wordpress.wordpressAndWoocommerce', { fallback: 'WordPress & Shop' })
                          }</span
                        >
                        <span class="line-clamp-1 text-[11px] text-gray-500 dark:text-gray-400"
                          >{t('wordpress.subtitle', { fallback: 'CMS sites development' })}</span
                        >
                      </a>
                    </li>
                    <li>
                      <a
                        href={linkPath('/services/web-design')}
                        class="block text-sm text-gray-700 transition-colors hover:text-primary dark:text-gray-200 dark:hover:text-primary"
                      >
                        <span class="block font-semibold"
                          >{t('common.webDesignAndDevelopment', { fallback: 'Web Design' })}</span
                        >
                        <span class="line-clamp-1 text-[11px] text-gray-500 dark:text-gray-400"
                          >{
                            t('services.webDevDescription', {
                              fallback: 'UI/UX layouts & prototypes',
                            })
                          }</span
                        >
                      </a>
                    </li>
                    <li>
                      <a
                        href={linkPath('/services/ecommerce')}
                        class="block text-sm text-gray-700 transition-colors hover:text-primary dark:text-gray-200 dark:hover:text-primary"
                      >
                        <span class="block font-semibold"
                          >{t('ecommerce.title', { fallback: 'E-commerce' })}</span
                        >
                        <span class="line-clamp-1 text-[11px] text-gray-500 dark:text-gray-400"
                          >{
                            t('ecommerce.storeSetup', { fallback: 'Shopify & WooCommerce stores' })
                          }</span
                        >
                      </a>
                    </li>
                  </ul>
                </div>

                <!-- Support & Optimization Column -->
                <div class="space-y-4">
                  <div
                    class="mb-2 flex items-center gap-2 border-b border-gray-100 pb-2 dark:border-slate-800"
                  >
                    <svg
                      aria-hidden="true"
                      class="h-4 w-4 text-primary"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                      ></path></svg
                    >
                    <p class="text-sm font-bold text-primary">
                      {t('common.supportServices', { fallback: 'Support & B2B' })}
                    </p>
                  </div>
                  <ul class="space-y-3">
                    <li>
                      <a
                        href={linkPath('/services/speed-optimization')}
                        class="block text-sm text-gray-700 transition-colors hover:text-primary dark:text-gray-200 dark:hover:text-primary"
                      >
                        <span class="block font-semibold"
                          >{lang === 'fa' ? 'افزایش سرعت سایت' : lang === 'ar' ? 'تحسين سرعة الموقع' : 'Speed Optimization'}</span
                        >
                        <span class="line-clamp-1 text-[11px] text-gray-500 dark:text-gray-400"
                          >Core Web Vitals (LCP, INP)</span
                        >
                      </a>
                    </li>
                    <li>
                      <a
                        href={linkPath('/services/ui-ux-audit')}
                        class="block text-sm text-gray-700 transition-colors hover:text-primary dark:text-gray-200 dark:hover:text-primary"
                      >
                        <span class="block font-semibold"
                          >{lang === 'fa' ? 'ممیزی UI/UX و CRO' : lang === 'ar' ? 'تدقيق UI/UX والتحويل' : 'UI/UX & CRO Audit'}</span
                        >
                        <span class="line-clamp-1 text-[11px] text-gray-500 dark:text-gray-400"
                          >{lang === 'fa' ? 'رفع گلوگاه‌های تبدیل' : lang === 'ar' ? 'تحسين مسار المبيعات' : 'Usability & funnel fixes'}</span
                        >
                      </a>
                    </li>
                    <li>
                      <a
                        href={linkPath('/services/website-maintenance')}
                        class="block text-sm text-gray-700 transition-colors hover:text-primary dark:text-gray-200 dark:hover:text-primary"
                      >
                        <span class="block font-semibold"
                          >{lang === 'fa' ? 'پشتیبانی و امنیت سایت' : lang === 'ar' ? 'صيانة وأمان المواقع' : 'Maintenance & Security'}</span
                        >
                        <span class="line-clamp-1 text-[11px] text-gray-500 dark:text-gray-400"
                          >{lang === 'fa' ? 'بکاپ، آپتایم و به‌روزرسانی' : lang === 'ar' ? 'نسخ احتياطي وحماية مستمرة' : 'Backups, WAF & 24/7 uptime'}</span
                        >
                      </a>
                    </li>
                  </ul>
                </div>
              </div>

              <!-- Enterprise B2B Strip + View All -->
              <div
                class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-gray-100 pt-4 text-xs dark:border-slate-800"
              >
                <div class="flex flex-wrap items-center gap-2">
                  <span class="font-bold text-gray-400 uppercase">B2B:</span>
                  <a
                    href={linkPath('/industrial-web-design')}
                    class="rounded-md bg-gray-50 px-2.5 py-1 font-semibold text-gray-700 transition-colors hover:bg-primary/10 hover:text-primary dark:bg-slate-800 dark:text-gray-200"
                  >
                    {lang === 'fa' ? 'طراحی سایت صنعتی' : lang === 'ar' ? 'المواقع الصناعية' : 'Industrial B2B'}
                  </a>
                  <a
                    href={linkPath('/export-web-design')}
                    class="rounded-md bg-gray-50 px-2.5 py-1 font-semibold text-gray-700 transition-colors hover:bg-primary/10 hover:text-primary dark:bg-slate-800 dark:text-gray-200"
                  >
                    {lang === 'fa' ? 'طراحی سایت صادراتی' : lang === 'ar' ? 'مواقع التصدير' : 'Export & Multilingual'}
                  </a>
                  <a
                    href={linkPath('/enterprise-automation')}
                    class="rounded-md bg-gray-50 px-2.5 py-1 font-semibold text-gray-700 transition-colors hover:bg-primary/10 hover:text-primary dark:bg-slate-800 dark:text-gray-200"
                  >
                    {lang === 'fa' ? 'اتوماسیون ERP/CRM' : lang === 'ar' ? 'أتمتة ERP/CRM' : 'ERP/CRM Automation'}
                  </a>
                </div>

                <a
                  href={linkPath('/services')}
                  class="inline-flex items-center gap-1 font-bold text-primary hover:underline"
                >
                  <span>{t('common.viewAll')} {t('common.services')}</span>
                  <span aria-hidden="true">{isRtl ? '←' : '→'}</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        {
          navItems.map((item) => (
            <a
              href={linkPath(item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class={`rounded-md px-1 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 ${fontClass} ${isActive(item.href) ? 'font-semibold text-primary' : 'text-foreground/80 hover:text-primary'}`}
            >
              {t(item.label)}
            </a>
          ))
        }
      </nav>

      <!-- Desktop Right-Side Actions -->
      <div class="hidden items-center gap-3 xl:gap-4 lg:flex">
        <!-- Language Select -->
        <div class="group relative">
          <button
            type="button"
            id="desktop-lang-btn"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="desktop-lang-panel"
            class="flex cursor-pointer items-center gap-1 text-sm font-medium text-foreground/80 transition-colors hover:text-primary focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
          >
            <svg
              aria-hidden="true"
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
              ></path></svg
            >
            <span class="uppercase">{lang}</span>
          </button>
          <div
            id="desktop-lang-panel"
            class="invisible absolute top-full end-0 z-50 mt-2 w-28 rounded-md border border-gray-100 bg-white py-1 opacity-0 shadow-lg transition-opacity duration-200 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100 dark:border-slate-800 dark:bg-slate-900"
          >
            {
              Object.keys(languages).map((l) => (
                <a
                  href={`/${l}${currentPathWithoutLang}`}
                  aria-current={lang === l ? 'true' : undefined}
                  class="block px-4 py-2 text-center text-sm text-gray-700 uppercase hover:bg-gray-50 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:text-gray-200 dark:hover:bg-slate-800"
                >
                  {l}
                </a>
              ))
            }
          </div>
        </div>

        <button
          type="button"
          id="theme-toggle"
          data-label-dark={t('common.switchToDark', { fallback: 'Switch to dark mode' })}
          data-label-light={t('common.switchToLight', { fallback: 'Switch to light mode' })}
          class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-900 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:text-gray-300 dark:hover:bg-slate-800 dark:hover:text-white"
          aria-label={t('common.switchToDark', { fallback: 'Switch to dark mode' })}
        >
          <svg
            data-icon="sun"
            aria-hidden="true"
            class="hidden h-5 w-5 text-yellow-400"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            ><circle cx="12" cy="12" r="4"></circle><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
            ></path></svg
          >
          <svg
            data-icon="moon"
            aria-hidden="true"
            class="h-5 w-5 text-gray-600 dark:text-gray-300"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg
          >
        </button>

        <button
          type="button"
          id="open-consultation-btn"
          class={`cursor-pointer rounded-xl bg-primary px-4 py-2 text-sm font-bold text-primary-foreground transition-colors hover:bg-primary/95 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 ${fontClass}`}
        >
          {t('common.freeConsultation')}
        </button>
      </div>

      <!-- Mobile Controls -->
      <div class="flex items-center gap-3 lg:hidden">
        <div class="relative">
          <button
            type="button"
            id="mobile-lang-btn"
            aria-expanded="false"
            aria-controls="mobile-lang-dropdown"
            class="flex min-h-11 items-center gap-1.5 rounded-full border border-gray-100 bg-white/80 px-3 py-1.5 text-sm font-semibold text-gray-700 shadow-xs transition-colors hover:bg-gray-100 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-800/80 dark:text-gray-200 dark:hover:bg-slate-700"
          >
            <svg
              aria-hidden="true"
              class="h-4 w-4 text-gray-500 dark:text-gray-400"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
              ></path></svg
            >
            <span>{languages[lang]?.nativeName}</span>
          </button>
          <div
            id="mobile-lang-dropdown"
            class="absolute top-full end-0 z-50 mt-2 hidden w-32 rounded-xl border border-gray-100 bg-white py-1 shadow-xl dark:border-slate-800 dark:bg-slate-900"
          >
            {
              Object.entries(languages).map(([code, meta]) => (
                <a
                  href={`/${code}${currentPathWithoutLang}`}
                  aria-current={lang === code ? 'true' : undefined}
                  class="block px-4 py-2.5 text-center text-sm font-medium text-gray-700 hover:bg-gray-50 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:text-gray-200 dark:hover:bg-slate-800"
                >
                  {meta.nativeName}
                </a>
              ))
            }
          </div>
        </div>

        <button
          type="button"
