---
import Logo from './Logo.astro';
import { getDictionary } from '../../i18n/get-dictionary';
import { languages, type SupportedLanguage } from '../../types/language';
import { createTranslator } from '@/i18n/translate';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const dictionary = await getDictionary(lang);
const isRtl = languages[lang]?.direction === 'rtl';

// Helper to translate strings
const t = createTranslator(dictionary);

// Generate relative paths correctly based on lang with trailing slashes
const linkPath = (path: string) => {
  if (!path || path === '/') return `/${lang}/`;
  const cleanPath = path.startsWith('/') ? path : `/${path}`;
  return `/${lang}${cleanPath.endsWith('/') ? cleanPath : cleanPath + '/'}`;
};

const navItems = [
  { key: 'service-areas', label: 'common.serviceAreas', href: '/service-areas' },
  { key: 'portfolio', label: 'common.portfolio', href: '/portfolio' },
  { key: 'blog', label: 'common.blog', href: '/blog' },
  { key: 'about', label: 'common.about', href: '/about' },
  { key: 'contact', label: 'common.contact', href: '/contact' },
];

const currentPathWithoutLang = Astro.url.pathname.replace(/^\/(en|fa|ar)/, '') || '/';
const isActive = (href: string) =>
  currentPathWithoutLang === href || currentPathWithoutLang.startsWith(`${href}/`);
---

<header id="main-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 ease-in-out px-4 py-3">
  <div class="mx-auto max-w-7xl">
    <div class="flex items-center justify-between backdrop-blur-xl bg-white/40 rounded-full px-6 py-3 shadow-lg border border-white/20">
      <!-- Brand Logo -->
      <a href={linkPath('')} class="flex items-center space-x-2" aria-label={t('common.home')}>
        <Logo class="w-[140px] xs:w-[160px] sm:w-[180px] xl:w-[260px] h-auto" />
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden xl:flex items-center justify-center gap-6 grow mx-4">
        <!-- Services Mega Menu -->
        <div class="relative group">
          <button type="button" class={`flex items-center gap-1 text-sm font-medium text-foreground/80 hover:text-primary transition-colors font-${lang === 'en' ? 'sans' : 'persian'}`}>
            {t('common.services')}
            <svg aria-hidden="true" class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          
          <!-- Mega Menu dropdown content -->
          <div class={`absolute top-full ${isRtl ? 'right-[-100px]' : 'left-[-100px]'} mt-2 w-[720px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-y-2 group-hover:translate-y-0 z-50`}>
            <div class="bg-white p-6 shadow-2xl rounded-2xl border border-gray-100">
              <div class="grid grid-cols-3 gap-6 text-start">
                
                <!-- SEO Services Column -->
                <div class="space-y-4">
                  <div class="flex items-center gap-2 mb-2 pb-2 border-b border-gray-100">
                    <svg aria-hidden="true" class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>
                    <p class="font-bold text-sm text-primary font-persian">{t('common.seoServices', { fallback: 'SEO Services' })}</p>
                  </div>
                  <ul class="space-y-3">
                    <li>
                      <a href={linkPath('/services/seo')} class="block text-sm text-gray-700 hover:text-primary transition-colors font-persian">
                        <span class="block font-semibold">{t('services.seoTitle', { fallback: 'SEO Optimization' })}</span>
                        <span class="text-[11px] text-gray-400 line-clamp-1">{t('services.seoDescription', { fallback: 'Search ranking growth' })}</span>
                      </a>
                    </li>
                    <li>
                      <a href={linkPath('/services/local-seo')} class="block text-sm text-gray-700 hover:text-primary transition-colors font-persian">
                        <span class="block font-semibold">{t('services.localSeoTitle', { fallback: 'Local SEO' })}</span>
                        <span class="text-[11px] text-gray-400 line-clamp-1">{t('services.localSeoDescription', { fallback: 'Google Maps marketing' })}</span>
                      </a>
                    </li>
                    <li>
                      <a href={linkPath('/services/link-building')} class="block text-sm text-gray-700 hover:text-primary transition-colors font-persian">
                        <span class="block font-semibold">{t('services.linkBuildingTitle', { fallback: 'Link Building' })}</span>
                        <span class="text-[11px] text-gray-400 line-clamp-1">{t('services.linkBuildingDescription', { fallback: 'Authority enhancement' })}</span>
                      </a>
                    </li>
                    <li>
                      <a href={linkPath('/services/content-creation')} class="block text-sm text-gray-700 hover:text-primary transition-colors font-persian">
                        <span class="block font-semibold">{t('services.contentCreationTitle', { fallback: 'Content Strategy' })}</span>
                        <span class="text-[11px] text-gray-400 line-clamp-1">{t('services.contentCreationDescription', { fallback: 'SEO articles writing' })}</span>
                      </a>
                    </li>
                  </ul>
                </div>

                <!-- Development Column -->
                <div class="space-y-4">
                  <div class="flex items-center gap-2 mb-2 pb-2 border-b border-gray-100">
                    <svg aria-hidden="true" class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
                    <p class="font-bold text-sm text-primary font-persian">{t('common.developmentServices', { fallback: 'Development' })}</p>
                  </div>
                  <ul class="space-y-3">
                    <li>
                      <a href={linkPath('/services/web-development')} class="block text-sm text-gray-700 hover:text-primary transition-colors font-persian">
                        <span class="block font-semibold">{t('services.webDevTitle', { fallback: 'Web Development' })}</span>
                        <span class="text-[11px] text-gray-400 line-clamp-1">{t('services.webDevDescription', { fallback: 'Custom web projects coding' })}</span>
                      </a>
                    </li>
                    <li>
                      <a href={linkPath('/services/wordpress-development')} class="block text-sm text-gray-700 hover:text-primary transition-colors font-persian">
                        <span class="block font-semibold">{t('wordpress.wordpressAndWoocommerce', { fallback: 'WordPress & Shop' })}</span>
                        <span class="text-[11px] text-gray-400 line-clamp-1">{t('wordpress.subtitle', { fallback: 'CMS sites development' })}</span>
                      </a>
                    </li>
                    <li>
                      <a href={linkPath('/services/web-design')} class="block text-sm text-gray-700 hover:text-primary transition-colors font-persian">
                        <span class="block font-semibold">{t('common.webDesignAndDevelopment', { fallback: 'Web Design' })}</span>
                        <span class="text-[11px] text-gray-400 line-clamp-1">{t('services.webDevDescription', { fallback: 'Premium layouts & prototypes' })}</span>
                      </a>
                    </li>
                    <li>
                      <a href={linkPath('/services/ecommerce')} class="block text-sm text-gray-700 hover:text-primary transition-colors font-persian">
                        <span class="block font-semibold">{t('ecommerce.title', { fallback: 'E-commerce' })}</span>
                        <span class="text-[11px] text-gray-400 line-clamp-1">{t('ecommerce.storeSetup', { fallback: 'Shopify & WooCommerce stores' })}</span>
                      </a>
                    </li>
                  </ul>
                </div>

                <!-- Support Services Column -->
                <div class="space-y-4">
                  <div class="flex items-center gap-2 mb-2 pb-2 border-b border-gray-100">
                    <svg aria-hidden="true" class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                    <p class="font-bold text-sm text-primary font-persian">{t('common.supportServices', { fallback: 'Support' })}</p>
                  </div>
                  <ul class="space-y-3">
                    <li>
                      <a href={linkPath('/services/website-maintenance')} class="block text-sm text-gray-700 hover:text-primary transition-colors font-persian">
                        <span class="block font-semibold">{t('maintenance.title', { fallback: 'Maintenance' })}</span>
                        <span class="text-[11px] text-gray-400 line-clamp-1">{t('maintenance.subtitle', { fallback: 'Backup, updates & uptime monitoring' })}</span>
                      </a>
                    </li>
                    <li>
                      <a href={linkPath('/services/speed-optimization')} class="block text-sm text-gray-700 hover:text-primary transition-colors font-persian">
                        <span class="block font-semibold">{t('speedOptimization.title', { fallback: 'Speed Optimization' })}</span>
                        <span class="text-[11px] text-gray-400 line-clamp-1">{t('speedOptimization.subtitle', { fallback: 'Core Web Vitals tuning' })}</span>
                      </a>
                    </li>
                    <li>
                      <a href={linkPath('/services/ui-ux-audit')} class="block text-sm text-gray-700 hover:text-primary transition-colors font-persian">
                        <span class="block font-semibold">{t('uiUxAudit.title', { fallback: 'UI/UX Audit' })}</span>
                        <span class="text-[11px] text-gray-400 line-clamp-1">{t('uiUxAudit.subtitle', { fallback: 'Usability, flows & audit report' })}</span>
                      </a>
                    </li>
                  </ul>
                </div>

              </div>
              
              <div class="pt-4 mt-6 border-t border-gray-100 flex justify-end">
                <a href={linkPath('/services')} class="inline-flex items-center gap-1 text-xs font-bold text-primary hover:underline">
                  {t('common.viewAll')} {t('common.services')}
                  {isRtl ? (
                    <svg aria-hidden="true" class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                  ) : (
                    <svg aria-hidden="true" class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                  )}
                </a>
              </div>
            </div>
          </div>
        </div>

{navItems.map((item) => (
          <a href={linkPath(item.href)} aria-current={isActive(item.href) ? 'page' : undefined} class={`text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 rounded-md px-1 font-${lang === 'en' ? 'sans' : 'persian'} ${isActive(item.href) ? 'text-primary font-semibold' : 'text-foreground/80 hover:text-primary'}`}>
            {t(item.label)}
          </a>
        ))}
      </nav>

      <!-- Desktop Right-Side Actions -->
      <div class="hidden xl:flex items-center gap-4">
        <!-- Language Select -->
        <div class="relative group">
          <button type="button" class="flex items-center gap-1 text-sm font-medium text-foreground/80 hover:text-primary transition-colors focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
            <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>
            <span class="uppercase">{lang}</span>
          </button>
          <div class="absolute top-full right-0 mt-2 w-28 rounded-md shadow-lg bg-white border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 py-1">
            {Object.keys(languages).map((l) => (
              <a href={`/${l}${currentPathWithoutLang}`} class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 text-center uppercase focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">{l}</a>
            ))}
          </div>
        </div>

        <button type="button" id="open-consultation-btn" class="px-4 py-2 bg-primary text-primary-foreground text-sm font-medium rounded-md hover:bg-primary/95 transition-all focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
          {t('common.freeConsultation')}
        </button>
      </div>

      <!-- Mobile Controls -->
      <div class="xl:hidden flex items-center gap-3">
        <!-- Mobile Language Selector -->
        <div class="relative">
          <button type="button" id="mobile-lang-btn" class="flex items-center gap-1.5 text-sm font-semibold px-3 py-1.5 rounded-full bg-white/80 hover:bg-gray-100 text-gray-700 border border-gray-100 shadow-xs transition-all focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
            <svg aria-hidden="true" class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>
            <span>{languages[lang]?.nativeName}</span>
          </button>
          <div id="mobile-lang-dropdown" class="hidden absolute top-full right-0 mt-2 w-32 rounded-xl shadow-xl bg-white border border-gray-100 z-50 py-1">
            {Object.entries(languages).map(([code, meta]) => (
              <a href={`/${code}${currentPathWithoutLang}`} class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 text-center font-medium focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
                {meta.nativeName}
              </a>
            ))}
          </div>
        </div>
        
        <button type="button" id="mobile-menu-btn" class="p-2 text-foreground/80 hover:text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 rounded-lg" aria-label="Toggle Menu">
          <svg aria-hidden="true" class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown drawer Menu -->
  <div id="mobile-drawer" class="hidden fixed inset-0 z-40 bg-black/50 backdrop-blur-xs transition-opacity duration-300">
    <div class={`fixed top-0 bottom-0 ${isRtl ? 'left-0' : 'right-0'} w-[85%] max-w-sm bg-white shadow-2xl p-6 flex flex-col h-full overflow-y-auto z-50`}>
      <div class={`flex flex-col space-y-6 font-${lang === 'en' ? 'sans' : 'persian'} h-full justify-between`}>
        
        <div class="space-y-6">
          <!-- Header -->
          <div class="pb-4 border-b border-gray-100 flex items-center justify-between">
            <a href={linkPath('')} class="flex items-center space-x-2">
              <Logo class="w-[130px] h-auto" />
            </a>
            <button type="button" id="mobile-drawer-close" class="text-gray-400 hover:text-gray-600 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
              <svg aria-hidden="true" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
          </div>

          <!-- Links List -->
          <div class="space-y-4">
            <a href={linkPath('')} aria-current={currentPathWithoutLang === '/' ? 'page' : undefined} class={`block text-lg font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 rounded-sm ${currentPathWithoutLang === '/' ? 'text-primary' : 'text-gray-900 hover:text-primary'}`}>{t('common.home')}</a>
            
             <!-- Services Nested Menu -->
            <div class="border-y border-gray-100 py-4 my-2 space-y-4">
              <div class="text-lg font-bold text-gray-900">{t('common.services')}</div>
              <a href={linkPath('/services')} aria-current={isActive('/services') ? 'page' : undefined} class={`block ps-3 border-s-2 transition-colors font-medium focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 rounded-sm ${isActive('/services') ? 'border-primary text-primary' : 'border-primary/40 text-foreground/80 hover:text-primary'}`}>{t('common.allServices')}</a>
              
              <!-- SEO Services Subgroup -->
              <div class="ps-3 space-y-2">
                <p class="text-xs font-bold text-muted-foreground uppercase tracking-wider">{t('common.seoServices')}</p>
                <div class="grid grid-cols-2 gap-2 border-s border-gray-100 ps-3">
                  <a href={linkPath('/services/seo')} class="text-sm text-foreground/80 hover:text-primary py-1 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">{t('services.seoTitle')}</a>
                  <a href={linkPath('/services/local-seo')} class="text-sm text-foreground/80 hover:text-primary py-1 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">{t('services.localSeoTitle')}</a>
                  <a href={linkPath('/services/link-building')} class="text-sm text-foreground/80 hover:text-primary py-1 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">{t('services.linkBuildingTitle')}</a>
                  <a href={linkPath('/services/content-creation')} class="text-sm text-foreground/80 hover:text-primary py-1 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">{t('services.contentCreationTitle')}</a>
                </div>
              </div>

              <!-- Development Services Subgroup -->
              <div class="ps-3 space-y-2">
                <p class="text-xs font-bold text-muted-foreground uppercase tracking-wider">{t('common.developmentServices')}</p>
                <div class="grid grid-cols-2 gap-2 border-s border-gray-100 ps-3">
                  <a href={linkPath('/services/web-development')} class="text-sm text-foreground/80 hover:text-primary py-1 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">{t('services.webDevTitle')}</a>
                  <a href={linkPath('/services/wordpress-development')} class="text-sm text-foreground/80 hover:text-primary py-1 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">{t('wordpress.wordpressAndWoocommerce')}</a>
                  <a href={linkPath('/services/web-design')} class="text-sm text-foreground/80 hover:text-primary py-1 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">{t('common.webDesignAndDevelopment')}</a>
                  <a href={linkPath('/services/ecommerce')} class="text-sm text-foreground/80 hover:text-primary py-1 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">{t('ecommerce.title', { fallback: 'E-commerce' })}</a>
                </div>
              </div>
            </div>

            <a href={linkPath('/portfolio')} aria-current={isActive('/portfolio') ? 'page' : undefined} class={`block text-lg font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 rounded-sm ${isActive('/portfolio') ? 'text-primary' : 'text-gray-900 hover:text-primary'}`}>{t('common.portfolio')}</a>
            <a href={linkPath('/service-areas')} aria-current={isActive('/service-areas') ? 'page' : undefined} class={`block text-lg font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 rounded-sm ${isActive('/service-areas') ? 'text-primary' : 'text-gray-900 hover:text-primary'}`}>{t('common.serviceAreas')}</a>
            <a href={linkPath('/blog')} aria-current={isActive('/blog') ? 'page' : undefined} class={`block text-lg font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 rounded-sm ${isActive('/blog') ? 'text-primary' : 'text-gray-900 hover:text-primary'}`}>{t('common.blog')}</a>
            <a href={linkPath('/about')} aria-current={isActive('/about') ? 'page' : undefined} class={`block text-lg font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 rounded-sm ${isActive('/about') ? 'text-primary' : 'text-gray-900 hover:text-primary'}`}>{t('common.about')}</a>
            <a href={linkPath('/contact')} aria-current={isActive('/contact') ? 'page' : undefined} class={`block text-lg font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 rounded-sm ${isActive('/contact') ? 'text-primary' : 'text-gray-900 hover:text-primary'}`}>{t('common.contact')}</a>
          </div>
        </div>

        <div>
          <!-- Language buttons Inline -->
          <div class="flex gap-2 py-4 justify-center border-t border-gray-100">
            {Object.entries(languages).map(([code, meta]) => (
              <a
                href={`/${code}${currentPathWithoutLang}`}
                class={`px-4 py-2 text-xs font-bold rounded-lg border transition-all ${lang === code ? 'bg-primary text-primary-foreground border-primary' : 'bg-white text-gray-600 border-gray-200 hover:bg-gray-50'}`}
              >
                {meta.nativeName}
              </a>
            ))}
          </div>

          <!-- Button -->
          <button type="button" id="open-consultation-btn-mobile" class="w-full py-3 bg-primary text-primary-foreground rounded-xl shadow-md text-center font-bold focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
            {t('common.freeConsultation')}
          </button>
        </div>

      </div>
    </div>
  </div>
</header>

<!-- Native HTML5 Dialog for Consultation Form -->
<dialog id="consultation-modal" class="rounded-2xl border-0 p-0 shadow-2xl backdrop:bg-black/50 max-w-lg w-full overflow-hidden">
  <div class="p-6 bg-white space-y-6 relative">
    <button type="button" id="close-modal-btn" class="absolute top-4 right-4 p-2 text-gray-400 hover:text-gray-600 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
      <svg aria-hidden="true" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
    <div class="text-center">
      <div class="text-2xl font-bold text-gray-900">{t('common.freeConsultation')}</div>
      <p class="text-sm text-gray-600 mt-2">Get in touch with our experts for custom advice</p>
    </div>
    <form class="space-y-4">
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Name</label>
        <input type="text" required class="w-full h-11 border border-gray-200 rounded-lg px-4 focus:outline-none focus:border-primary" />
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Email / Phone</label>
        <input type="text" required class="w-full h-11 border border-gray-200 rounded-lg px-4 focus:outline-none focus:border-primary" />
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Message</label>
        <textarea rows="3" required class="w-full border border-gray-200 rounded-lg p-4 focus:outline-none focus:border-primary resize-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"></textarea>
      </div>
      <button type="submit" class="w-full h-11 bg-primary text-primary-foreground font-bold rounded-lg shadow-md hover:bg-primary/95 transition-all focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
        Submit Request
      </button>
    </form>
  </div>
</dialog>

<script is:inline>
  // Mobile Menu Drawer Control
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-drawer');
  const drawerCloseBtn = document.getElementById('mobile-drawer-close');

  if (mobileBtn && drawer) {
    mobileBtn.addEventListener('click', () => {
      drawer.classList.remove('hidden');
    });
    if (drawerCloseBtn) {
      drawerCloseBtn.addEventListener('click', () => {
        drawer.classList.add('hidden');
      });
    }
    drawer.addEventListener('click', (e) => {
      if (e.target === drawer) drawer.classList.add('hidden');
    });
  }

  // Mobile Language Dropdown Toggle
  const mobileLangBtn = document.getElementById('mobile-lang-btn');
  const mobileLangDropdown = document.getElementById('mobile-lang-dropdown');
  if (mobileLangBtn && mobileLangDropdown) {
    mobileLangBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      mobileLangDropdown.classList.toggle('hidden');
    });
    document.addEventListener('click', (e) => {
      if (!mobileLangBtn.contains(e.target)) {
        mobileLangDropdown.classList.add('hidden');
      }
    });
  }

  // Dialog Controls
  const dialog = document.getElementById('consultation-modal');
  const openBtn = document.getElementById('open-consultation-btn');
  const openMobileBtn = document.getElementById('open-consultation-btn-mobile');
  const closeBtn = document.getElementById('close-modal-btn');

  const openModal = () => dialog && dialog.showModal();
  const closeModal = () => dialog && dialog.close();

  if (openBtn) openBtn.addEventListener('click', openModal);
  if (openMobileBtn) openMobileBtn.addEventListener('click', () => {
    if (drawer) drawer.classList.add('hidden');
    openModal();
  });
  if (closeBtn) closeBtn.addEventListener('click', closeModal);
</script>
