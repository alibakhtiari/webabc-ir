---
import Logo from './Logo.astro';
import { getDictionary } from '@/i18n/get-dictionary';
import { languages, type SupportedLanguage } from '@/types/language';
import { createTranslator } from '@/i18n/translate';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const dictionary = await getDictionary(lang);
const isRtl = languages[lang]?.direction === 'rtl';

// Helper to translate strings
const t = createTranslator(dictionary);

// Generate relative paths correctly based on lang with trailing slashes
const linkPath = (path: string) => {
  if (!path || path === '/') return `/${lang}/`;
  const cleanPath = path.startsWith('/') ? path : `/${path}`;
  return `/${lang}${cleanPath.endsWith('/') ? cleanPath : cleanPath + '/'}`;
};

const navItems = [
  { key: 'service-areas', label: 'common.serviceAreas', href: '/service-areas' },
  { key: 'portfolio', label: 'common.portfolio', href: '/portfolio' },
  { key: 'blog', label: 'common.blog', href: '/blog' },
  { key: 'about', label: 'common.about', href: '/about' },
  { key: 'contact', label: 'common.contact', href: '/contact' },
];

const currentPathWithoutLang = Astro.url.pathname.replace(/^\/(en|fa|ar)/, '') || '/';
const isActive = (href: string) =>
  currentPathWithoutLang === href || currentPathWithoutLang.startsWith(`${href}/`);

const fontClass = lang === 'en' ? 'font-sans' : lang === 'ar' ? 'font-arabic' : 'font-persian';
---

<header
  id="main-header"
  class="fixed top-0 right-0 left-0 z-50 px-4 py-3 transition-all duration-300 ease-in-out"
>
  <div class="mx-auto max-w-7xl">
    <div
      class="flex items-center justify-between rounded-full border border-white/20 bg-white/70 px-6 py-3 shadow-lg backdrop-blur-xl dark:border-slate-800/80 dark:bg-slate-900/80"
    >
      <!-- Brand Logo -->
      <a href={linkPath('')} class="flex items-center space-x-2" aria-label={t('common.home')}>
        <Logo class="xs:w-40 h-auto w-35 sm:w-45 xl:w-65" />
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="mx-4 hidden grow items-center justify-center gap-6 xl:flex">
        <!-- Services Mega Menu -->
        <div class="group relative">
          <button
            type="button"
            id="desktop-services-btn"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="desktop-services-panel"
            class={`flex items-center gap-1 text-sm font-medium text-foreground/80 hover:text-primary transition-colors ${fontClass}`}
          >
            {t('common.services')}
            <svg
              aria-hidden="true"
              class="h-4 w-4 transition-transform duration-200 group-focus-within:rotate-180 group-hover:rotate-180"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"></path></svg
            >
          </button>

          <!-- Mega Menu dropdown content -->
          <div
            id="desktop-services-panel"
            class={`absolute top-full ${isRtl ? '-right-25' : '-left-25'} mt-2 w-180 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-300 transform translate-y-2 group-hover:translate-y-0 group-focus-within:translate-y-0 z-50`}
          >
            <div
              class="rounded-2xl border border-gray-100 bg-white p-6 shadow-2xl dark:border-slate-800 dark:bg-slate-900"
            >
              <div class="grid grid-cols-3 gap-6 text-start">
                <!-- SEO Services Column -->
                <div class="space-y-4">
                  <div
                    class="mb-2 flex items-center gap-2 border-b border-gray-100 pb-2 dark:border-slate-800"
                  >
                    <svg
                      aria-hidden="true"
                      class="h-4 w-4 text-primary"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
                      ></path></svg
                    >
                    <p class="font-persian text-sm font-bold text-primary">
                      {t('common.seoServices', { fallback: 'SEO Services' })}
                    </p>
                  </div>
                  <ul class="space-y-3">
                    <li>
                      <a
                        href={linkPath('/services/seo')}
                        class="block font-persian text-sm text-gray-700 transition-colors hover:text-primary dark:text-gray-200 dark:hover:text-primary"
                      >
                        <span class="block font-semibold"
                          >{t('services.seoTitle', { fallback: 'SEO Optimization' })}</span
                        >
                        <span class="line-clamp-1 text-[11px] text-gray-400 dark:text-gray-500"
                          >{
                            t('services.seoDescription', { fallback: 'Search ranking growth' })
                          }</span
                        >
                      </a>
                    </li>
                    <li>
                      <a
                        href={linkPath('/services/local-seo')}
                        class="block font-persian text-sm text-gray-700 transition-colors hover:text-primary dark:text-gray-200 dark:hover:text-primary"
                      >
                        <span class="block font-semibold"
                          >{t('services.localSeoTitle', { fallback: 'Local SEO' })}</span
                        >
                        <span class="line-clamp-1 text-[11px] text-gray-400 dark:text-gray-500"
                          >{
                            t('services.localSeoDescription', { fallback: 'Google Maps marketing' })
                          }</span
                        >
                      </a>
                    </li>
                    <li>
                      <a
                        href={linkPath('/services/link-building')}
                        class="block font-persian text-sm text-gray-700 transition-colors hover:text-primary dark:text-gray-200 dark:hover:text-primary"
                      >
                        <span class="block font-semibold"
                          >{t('services.linkBuildingTitle', { fallback: 'Link Building' })}</span
                        >
                        <span class="line-clamp-1 text-[11px] text-gray-400 dark:text-gray-500"
                          >{
                            t('services.linkBuildingDescription', {
                              fallback: 'Authority enhancement',
                            })
                          }</span
                        >
                      </a>
                    </li>
                    <li>
                      <a
                        href={linkPath('/services/content-creation')}
                        class="block font-persian text-sm text-gray-700 transition-colors hover:text-primary dark:text-gray-200 dark:hover:text-primary"
                      >
                        <span class="block font-semibold"
                          >{
                            t('services.contentCreationTitle', { fallback: 'Content Strategy' })
                          }</span
                        >
                        <span class="line-clamp-1 text-[11px] text-gray-400 dark:text-gray-500"
                          >{
                            t('services.contentCreationDescription', {
                              fallback: 'SEO articles writing',
                            })
                          }</span
                        >
                      </a>
                    </li>
                  </ul>
                </div>

                <!-- Development Column -->
                <div class="space-y-4">
                  <div
                    class="mb-2 flex items-center gap-2 border-b border-gray-100 pb-2 dark:border-slate-800"
                  >
                    <svg
                      aria-hidden="true"
                      class="h-4 w-4 text-primary"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg
                    >
                    <p class="font-persian text-sm font-bold text-primary">
                      {t('common.developmentServices', { fallback: 'Development' })}
                    </p>
                  </div>
                  <ul class="space-y-3">
                    <li>
                      <a
                        href={linkPath('/services/web-development')}
                        class="block font-persian text-sm text-gray-700 transition-colors hover:text-primary dark:text-gray-200 dark:hover:text-primary"
                      >
                        <span class="block font-semibold"
                          >{t('services.webDevTitle', { fallback: 'Web Development' })}</span
                        >
                        <span class="line-clamp-1 text-[11px] text-gray-400 dark:text-gray-500"
                          >{
                            t('services.webDevDescription', {
                              fallback: 'Custom web projects coding',
                            })
                          }</span
                        >
                      </a>
                    </li>
                    <li>
                      <a
                        href={linkPath('/services/wordpress-development')}
                        class="block font-persian text-sm text-gray-700 transition-colors hover:text-primary dark:text-gray-200 dark:hover:text-primary"
                      >
                        <span class="block font-semibold"
                          >{
                            t('wordpress.wordpressAndWoocommerce', { fallback: 'WordPress & Shop' })
                          }</span
                        >
                        <span class="line-clamp-1 text-[11px] text-gray-400 dark:text-gray-500"
                          >{t('wordpress.subtitle', { fallback: 'CMS sites development' })}</span
                        >
                      </a>
                    </li>
                    <li>
                      <a
                        href={linkPath('/services/web-design')}
                        class="block font-persian text-sm text-gray-700 transition-colors hover:text-primary dark:text-gray-200 dark:hover:text-primary"
                      >
                        <span class="block font-semibold"
                          >{t('common.webDesignAndDevelopment', { fallback: 'Web Design' })}</span
                        >
                        <span class="line-clamp-1 text-[11px] text-gray-400 dark:text-gray-500"
                          >{
                            t('services.webDevDescription', {
                              fallback: 'Premium layouts & prototypes',
                            })
                          }</span
                        >
                      </a>
                    </li>
                    <li>
                      <a
                        href={linkPath('/services/ecommerce')}
                        class="block font-persian text-sm text-gray-700 transition-colors hover:text-primary dark:text-gray-200 dark:hover:text-primary"
                      >
                        <span class="block font-semibold"
                          >{t('ecommerce.title', { fallback: 'E-commerce' })}</span
                        >
                        <span class="line-clamp-1 text-[11px] text-gray-400 dark:text-gray-500"
                          >{
                            t('ecommerce.storeSetup', { fallback: 'Shopify & WooCommerce stores' })
                          }</span
                        >
                      </a>
                    </li>
                  </ul>
                </div>

                <!-- Support Services Column -->
                <div class="space-y-4">
                  <div
                    class="mb-2 flex items-center gap-2 border-b border-gray-100 pb-2 dark:border-slate-800"
                  >
                    <svg
                      aria-hidden="true"
                      class="h-4 w-4 text-primary"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                      ></path></svg
                    >
                    <p class="font-persian text-sm font-bold text-primary">
                      {t('common.supportServices', { fallback: 'Support' })}
                    </p>
                  </div>
                  <ul class="space-y-3">
                    <li>
                      <a
                        href={linkPath('/services/website-maintenance')}
                        class="block font-persian text-sm text-gray-700 transition-colors hover:text-primary dark:text-gray-200 dark:hover:text-primary"
                      >
                        <span class="block font-semibold"
                          >{t('maintenance.title', { fallback: 'Maintenance' })}</span
                        >
                        <span class="line-clamp-1 text-[11px] text-gray-400 dark:text-gray-500"
                          >{
                            t('maintenance.subtitle', {
                              fallback: 'Backup, updates & uptime monitoring',
                            })
                          }</span
                        >
                      </a>
                    </li>
                    <li>
                      <a
                        href={linkPath('/services/speed-optimization')}
                        class="block font-persian text-sm text-gray-700 transition-colors hover:text-primary dark:text-gray-200 dark:hover:text-primary"
                      >
                        <span class="block font-semibold"
                          >{t('speedOptimization.title', { fallback: 'Speed Optimization' })}</span
                        >
                        <span class="line-clamp-1 text-[11px] text-gray-400 dark:text-gray-500"
                          >{
                            t('speedOptimization.subtitle', { fallback: 'Core Web Vitals tuning' })
                          }</span
                        >
                      </a>
                    </li>
                    <li>
                      <a
                        href={linkPath('/services/ui-ux-audit')}
                        class="block font-persian text-sm text-gray-700 transition-colors hover:text-primary dark:text-gray-200 dark:hover:text-primary"
                      >
                        <span class="block font-semibold"
                          >{t('uiUxAudit.title', { fallback: 'UI/UX Audit' })}</span
                        >
                        <span class="line-clamp-1 text-[11px] text-gray-400 dark:text-gray-500"
                          >{
                            t('uiUxAudit.subtitle', { fallback: 'Usability, flows & audit report' })
                          }</span
                        >
                      </a>
                    </li>
                  </ul>
                </div>
              </div>

              <div
                class="mt-6 flex justify-end border-t border-gray-100 pt-4 dark:border-slate-800"
              >
                <a
                  href={linkPath('/services')}
                  class="inline-flex items-center gap-1 text-xs font-bold text-primary hover:underline"
                >
                  {t('common.viewAll')}
                  {t('common.services')}
                  {
                    isRtl ? (
                      <svg
                        aria-hidden="true"
                        class="h-3 w-3"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M10 19l-7-7m0 0l7-7m-7 7h18"
                        />
                      </svg>
                    ) : (
                      <svg
                        aria-hidden="true"
                        class="h-3 w-3"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M14 5l7 7m0 0l-7 7m7-7H3"
                        />
                      </svg>
                    )
                  }
                </a>
              </div>
            </div>
          </div>
        </div>

        {
          navItems.map((item) => (
            <a
              href={linkPath(item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class={`rounded-md px-1 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 ${fontClass} ${isActive(item.href) ? 'font-semibold text-primary' : 'text-foreground/80 hover:text-primary'}`}
            >
              {t(item.label)}
            </a>
          ))
        }
      </nav>

      <!-- Desktop Right-Side Actions -->
      <div class="hidden items-center gap-4 xl:flex">
        <!-- Language Select -->
        <div class="group relative">
          <button
            type="button"
            id="desktop-lang-btn"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="desktop-lang-panel"
            class="flex items-center gap-1 text-sm font-medium text-foreground/80 transition-colors hover:text-primary focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
          >
            <svg
              aria-hidden="true"
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
              ></path></svg
            >
            <span class="uppercase">{lang}</span>
          </button>
          <div
            id="desktop-lang-panel"
            class="invisible absolute top-full right-0 z-50 mt-2 w-28 rounded-md border border-gray-100 bg-white py-1 opacity-0 shadow-lg transition-all duration-200 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100 dark:border-slate-800 dark:bg-slate-900"
          >
            {
              Object.keys(languages).map((l) => (
                <a
                  href={`/${l}${currentPathWithoutLang}`}
                  aria-current={lang === l ? 'true' : undefined}
                  class="block px-4 py-2 text-center text-sm text-gray-700 uppercase hover:bg-gray-50 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:text-gray-200 dark:hover:bg-slate-800"
                >
                  {l}
                </a>
              ))
            }
          </div>
        </div>

        <button
          type="button"
          id="theme-toggle"
          data-label-dark={t('common.switchToDark', { fallback: 'Switch to dark mode' })}
          data-label-light={t('common.switchToLight', { fallback: 'Switch to light mode' })}
          class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-900 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:text-gray-300 dark:hover:bg-slate-800 dark:hover:text-white"
          aria-label={t('common.switchToDark', { fallback: 'Switch to dark mode' })}
        >
          <svg
            data-icon="sun"
            aria-hidden="true"
            class="hidden h-5 w-5 text-yellow-400"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            ><circle cx="12" cy="12" r="4"></circle><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
            ></path></svg
          >
          <svg
            data-icon="moon"
            aria-hidden="true"
            class="h-5 w-5 text-gray-600 dark:text-gray-300"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg
          >
        </button>

        <button
          type="button"
          id="open-consultation-btn"
          class="cursor-pointer rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-all hover:bg-primary/95 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
        >
          {t('common.freeConsultation')}
        </button>
      </div>

      <!-- Mobile Controls -->
      <div class="flex items-center gap-3 xl:hidden">
        <!-- Mobile Language Selector -->
        <div class="relative">
          <button
            type="button"
            id="mobile-lang-btn"
            aria-expanded="false"
            aria-controls="mobile-lang-dropdown"
            class="flex items-center gap-1.5 rounded-full border border-gray-100 bg-white/80 px-3 py-1.5 text-sm font-semibold text-gray-700 shadow-xs transition-all hover:bg-gray-100 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-800/80 dark:text-gray-200 dark:hover:bg-slate-700"
          >
            <svg
              aria-hidden="true"
              class="h-4 w-4 text-gray-500 dark:text-gray-400"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
              ></path></svg
            >
            <span>{languages[lang]?.nativeName}</span>
          </button>
          <div
            id="mobile-lang-dropdown"
            class="absolute top-full right-0 z-50 mt-2 hidden w-32 rounded-xl border border-gray-100 bg-white py-1 shadow-xl dark:border-slate-800 dark:bg-slate-900"
          >
            {
              Object.entries(languages).map(([code, meta]) => (
                <a
                  href={`/${code}${currentPathWithoutLang}`}
                  aria-current={lang === code ? 'true' : undefined}
                  class="block px-4 py-2.5 text-center text-sm font-medium text-gray-700 hover:bg-gray-50 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:text-gray-200 dark:hover:bg-slate-800"
                >
                  {meta.nativeName}
                </a>
              ))
            }
          </div>
        </div>

        <button
          type="button"
          id="mobile-menu-btn"
          class="rounded-lg p-2 text-foreground/80 hover:text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
          aria-label="Toggle Menu"
          aria-expanded="false"
          aria-controls="mobile-drawer"
        >
          <svg
            aria-hidden="true"
            class="h-6 w-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path></svg
          >
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown drawer Menu -->
  <div
    id="mobile-drawer"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile Navigation"
    class="fixed inset-0 z-40 hidden bg-black/60 backdrop-blur-xs transition-opacity duration-300"
  >
    <div
      class={`fixed top-0 bottom-0 ${isRtl ? 'left-0' : 'right-0'} w-[85%] max-w-sm bg-white dark:bg-slate-900 text-foreground shadow-2xl p-6 flex flex-col h-full overflow-y-auto z-50 border-s border-transparent dark:border-slate-800`}
    >
      <div class={`flex flex-col space-y-6 ${fontClass} h-full justify-between`}>
        <div class="space-y-6">
          <!-- Header -->
          <div
            class="flex items-center justify-between border-b border-gray-100 pb-4 dark:border-slate-800"
          >
            <a href={linkPath('')} class="flex items-center space-x-2">
              <Logo class="h-auto w-32.5" />
            </a>
            <button
              type="button"
              id="mobile-drawer-close"
              class="cursor-pointer text-gray-400 hover:text-gray-600 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:hover:text-gray-200"
            >
              <svg
                aria-hidden="true"
                class="h-6 w-6"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                ><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"
                ></path></svg
              >
            </button>
          </div>

          <!-- Links List -->
          <div class="space-y-4">
            <a
              href={linkPath('')}
              aria-current={currentPathWithoutLang === '/' ? 'page' : undefined}
              class={`block text-lg font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 rounded-sm ${currentPathWithoutLang === '/' ? 'text-primary' : 'text-gray-900 dark:text-gray-100 hover:text-primary'}`}
              >{t('common.home')}</a
            >

            <!-- Services Nested Menu -->
            <div class="my-2 space-y-4 border-y border-gray-100 py-4 dark:border-slate-800">
              <div class="text-lg font-bold text-gray-900 dark:text-white">
                {t('common.services')}
              </div>
              <a
                href={linkPath('/services')}
                aria-current={isActive('/services') ? 'page' : undefined}
