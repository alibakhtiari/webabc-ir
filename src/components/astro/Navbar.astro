<!-- Native HTML5 Dialog for Consultation Form -->
<dialog
  id="consultation-modal"
  class={`fixed inset-0 m-auto max-h-[90vh] w-[calc(100%-2rem)] max-w-lg overflow-y-auto rounded-3xl border border-gray-100 bg-white p-0 ${fontClass} shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-xs dark:border-slate-800 dark:bg-slate-900`}
>
  <div class="relative p-6 text-foreground sm:p-8">
    <button
      type="button"
      id="close-modal-btn"
      class="absolute top-4 right-4 cursor-pointer rounded-full p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-600 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:hover:bg-slate-800 dark:hover:text-gray-200"
      aria-label={t('consultation.cancel', { fallback: 'Close' })}
    >
      <svg aria-hidden="true" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path></svg
      >
    </button>
    <div class="mb-6 text-center">
      <div class="text-2xl font-bold text-gray-900 dark:text-white">
        {t('consultation.title', { fallback: 'Free Consultation' })}
      </div>
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
        {
          t('consultation.description', {
            fallback: 'Fill out the form below to request a consultation.',
          })
        }
      </p>
    </div>
    <form id="consultation-form" class="space-y-4">
      <div>
        <label class="mb-1.5 block text-sm font-semibold text-gray-700 dark:text-gray-300">
          {t('consultation.fullName', { fallback: 'Full Name' })}
        </label>
        <input
          type="text"
          name="name"
          required
          class="h-11 w-full rounded-xl border border-gray-200 bg-white px-4 text-sm text-gray-900 focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-slate-700 dark:bg-slate-800 dark:text-white"
        />
      </div>
      <div>
        <label class="mb-1.5 block text-sm font-semibold text-gray-700 dark:text-gray-300">
          {t('consultation.phone', { fallback: 'Phone Number' })}
        </label>
        <input
          type="tel"
          name="phone"
          required
          class="h-11 w-full rounded-xl border border-gray-200 bg-white px-4 text-sm text-gray-900 focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-slate-700 dark:bg-slate-800 dark:text-white"
          dir="ltr"
        />
      </div>
      <div>
        <label class="mb-1.5 block text-sm font-semibold text-gray-700 dark:text-gray-300">
          {t('consultation.email', { fallback: 'Email Address' })}
        </label>
        <input
          type="email"
          name="email"
          class="h-11 w-full rounded-xl border border-gray-200 bg-white px-4 text-sm text-gray-900 focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-slate-700 dark:bg-slate-800 dark:text-white"
          dir="ltr"
        />
      </div>
      <div>
        <label class="mb-1.5 block text-sm font-semibold text-gray-700 dark:text-gray-300">
          {t('consultation.message', { fallback: 'Message' })}
        </label>
        <textarea
          name="message"
          rows="3"
          required
          class="w-full resize-none rounded-xl border border-gray-200 bg-white p-3 text-sm text-gray-900 focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-slate-700 dark:bg-slate-800 dark:text-white"
        ></textarea>
      </div>
      <button
        type="submit"
        id="consultation-submit-btn"
        class="h-11 w-full cursor-pointer rounded-xl bg-primary font-bold text-primary-foreground shadow-md transition-all hover:bg-primary/95 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 disabled:opacity-60"
      >
        {t('consultation.sendRequest', { fallback: 'Send Request' })}
      </button>
      <p
        id="consultation-response-msg"
        role="status"
        aria-live="polite"
        class="hidden text-center text-sm font-medium"
      >
      </p>
    </form>
  </div>
</dialog>

<script is:inline>
  (() => {
    function setupNavbar() {
      // Mobile Menu Drawer Control
      const mobileBtn = document.getElementById('mobile-menu-btn');
      const drawer = document.getElementById('mobile-drawer');
      const drawerCloseBtn = document.getElementById('mobile-drawer-close');

      function openDrawer() {
        if (!drawer) return;
        drawer.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        if (mobileBtn) mobileBtn.setAttribute('aria-expanded', 'true');
        if (drawerCloseBtn) drawerCloseBtn.focus();
      }

      function closeDrawer() {
        if (!drawer) return;
        drawer.classList.add('hidden');
        document.body.style.overflow = '';
        if (mobileBtn) {
          mobileBtn.setAttribute('aria-expanded', 'false');
          mobileBtn.focus();
        }
      }

      function trapDrawerFocus(e) {
        if (!drawer || drawer.classList.contains('hidden')) return;
        if (e.key !== 'Tab') return;
        const focusables = drawer.querySelectorAll(
          'a[href], button:not([disabled]), textarea, input, select, [tabindex]:not([tabindex="-1"])'
        );
        if (!focusables.length) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          if (last && typeof last.focus === 'function') last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          if (first && typeof first.focus === 'function') first.focus();
        }
      }

      if (mobileBtn && drawer) {
        mobileBtn.onclick = openDrawer;
        if (drawerCloseBtn) {
          drawerCloseBtn.onclick = closeDrawer;
        }
        drawer.onclick = (e) => {
          if (e.target === drawer) closeDrawer();
        };
        drawer.addEventListener('keydown', trapDrawerFocus);
      }

      // Desktop hover/focus dropdowns: keep aria-expanded in sync with CSS state
      document.querySelectorAll('#desktop-services-btn, #desktop-lang-btn').forEach((btn) => {
        const group = btn.closest('.group');
        if (!group) return;
        const sync = () =>
          btn.setAttribute('aria-expanded', String(group.matches(':hover, :focus-within')));
        group.addEventListener('mouseenter', sync);
        group.addEventListener('mouseleave', sync);
        group.addEventListener('focusin', sync);
        group.addEventListener('focusout', sync);
        sync();
      });

      // Mobile Language Dropdown Toggle
      const mobileLangBtn = document.getElementById('mobile-lang-btn');
      const mobileLangDropdown = document.getElementById('mobile-lang-dropdown');
      if (mobileLangBtn && mobileLangDropdown) {
        mobileLangBtn.onclick = (e) => {
          e.stopPropagation();
          const isOpen = mobileLangDropdown.classList.toggle('hidden');
          mobileLangBtn.setAttribute('aria-expanded', String(!isOpen));
        };
        document.addEventListener('click', (e) => {
          if (!mobileLangBtn.contains(e.target)) {
            mobileLangDropdown.classList.add('hidden');
            mobileLangBtn.setAttribute('aria-expanded', 'false');
          }
        });
      }

      // Theme Toggle Controls
      const themeToggle = document.getElementById('theme-toggle');
      const themeToggleMobile = document.getElementById('theme-toggle-mobile');

      function syncThemeUI() {
        const isDark = document.documentElement.classList.contains('dark');
        const labelDark = (themeToggle && themeToggle.dataset.labelDark) || 'Switch to dark mode';
        const labelLight =
          (themeToggle && themeToggle.dataset.labelLight) || 'Switch to light mode';
        const activeLabel = isDark ? labelLight : labelDark;

        document
          .querySelectorAll(
            '#theme-toggle [data-icon="sun"], #theme-toggle-mobile [data-icon="sun"]'
          )
          .forEach((el) => {
            el.classList.toggle('hidden', !isDark);
          });
        document
          .querySelectorAll(
            '#theme-toggle [data-icon="moon"], #theme-toggle-mobile [data-icon="moon"]'
          )
          .forEach((el) => {
            el.classList.toggle('hidden', isDark);
          });

        if (themeToggle) themeToggle.setAttribute('aria-label', activeLabel);
        if (themeToggleMobile) {
          themeToggleMobile.setAttribute('aria-label', activeLabel);
          const labelSpan = themeToggleMobile.querySelector('[data-theme-label]');
          if (labelSpan) labelSpan.textContent = activeLabel;
        }
      }

      function toggleTheme() {
        const isDark = document.documentElement.classList.contains('dark');
        const nextDark = !isDark;
        document.documentElement.classList.toggle('dark', nextDark);
        document.documentElement.style.colorScheme = nextDark ? 'dark' : 'light';
        try {
          localStorage.setItem('theme', nextDark ? 'dark' : 'light');
        } catch (e) {}
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', nextDark ? '#020617' : '#4361ee');
        syncThemeUI();
      }

      if (themeToggle) themeToggle.onclick = toggleTheme;
      if (themeToggleMobile) themeToggleMobile.onclick = toggleTheme;

      syncThemeUI();

      // Dialog Controls
      const dialog = document.getElementById('consultation-modal');
      const openBtn = document.getElementById('open-consultation-btn');
      const openMobileBtn = document.getElementById('open-consultation-btn-mobile');
      const closeBtn = document.getElementById('close-modal-btn');
      const consultForm = document.getElementById('consultation-form');
      const consultSubmitBtn = document.getElementById('consultation-submit-btn');
      const consultResponseMsg = document.getElementById('consultation-response-msg');

      if (openBtn && dialog) openBtn.onclick = () => dialog.showModal();
      if (openMobileBtn && dialog) {
        openMobileBtn.onclick = () => {
          closeDrawer();
          dialog.showModal();
        };
      }
      if (closeBtn && dialog) closeBtn.onclick = () => dialog.close();
      if (dialog) {
        dialog.onclick = (e) => {
          if (e.target === dialog) dialog.close();
        };
      }

      // Consultation Form AJAX Submission
      if (consultForm && consultSubmitBtn && consultResponseMsg) {
        consultForm.onsubmit = async (e) => {
          e.preventDefault();
          const origText = consultSubmitBtn.textContent;
          consultSubmitBtn.disabled = true;
          consultSubmitBtn.textContent = '...';
          consultResponseMsg.classList.add('hidden');

          const fd = new FormData(consultForm);
          const payload = {
            name: fd.get('name'),
            phone: fd.get('phone'),
            email: fd.get('email'),
            message: fd.get('message'),
          };

          try {
            const res = await fetch('/api/contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });

            if (res.ok) {
              consultResponseMsg.textContent = 'Request submitted successfully!';
              consultResponseMsg.className =
                'text-center text-sm text-green-600 dark:text-green-400 block';
              consultForm.reset();
              setTimeout(() => {
                if (dialog && dialog.open) dialog.close();
                consultResponseMsg.classList.add('hidden');
                consultSubmitBtn.disabled = false;
                consultSubmitBtn.textContent = origText;
              }, 2000);
            } else {
              const data = await res.json().catch(() => ({}));
              consultResponseMsg.textContent =
                data.error || 'Failed to send request. Please try again.';
              consultResponseMsg.className =
                'text-center text-sm text-red-600 dark:text-red-400 block';
              consultSubmitBtn.disabled = false;
              consultSubmitBtn.textContent = origText;
            }
          } catch (err) {
            consultResponseMsg.textContent = 'Network error. Please try again.';
            consultResponseMsg.className =
              'text-center text-sm text-red-600 dark:text-red-400 block';
            consultSubmitBtn.disabled = false;
            consultSubmitBtn.textContent = origText;
          }
        };
      }

      // Global Escape Key Listener for Dialogs and Drawers
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          if (drawer && !drawer.classList.contains('hidden')) {
            closeDrawer();
          }
        }
      });
    }

    document.addEventListener('astro:page-load', setupNavbar);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      setupNavbar();
    }
  })();
</script>
