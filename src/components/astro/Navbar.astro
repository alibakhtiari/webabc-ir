---
import Logo from './Logo.astro';
import { getDictionary } from '../../i18n/get-dictionary';
import { languages, type SupportedLanguage } from '../../types/language';
import { createTranslator } from '@/i18n/translate';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const dictionary = await getDictionary(lang);
const isRtl = languages[lang]?.direction === 'rtl';

const t = createTranslator(dictionary);

const linkPath = (path: string) => {
  if (!path || path === '/') return `/${lang}/`;
  const cleanPath = path.startsWith('/') ? path : `/${path}`;
  return `/${lang}${cleanPath.endsWith('/') ? cleanPath : cleanPath + '/'}`;
};

const navItems = [
  { key: 'tools', label: 'common.tools', href: '/tools' },
  { key: 'portfolio', label: 'common.portfolio', href: '/portfolio' },
  { key: 'service-areas', label: 'common.serviceAreas', href: '/service-areas' },
  { key: 'blog', label: 'common.blog', href: '/blog' },
  { key: 'about', label: 'common.about', href: '/about' },
  { key: 'contact', label: 'common.contact', href: '/contact' },
];

const currentPathWithoutLang = Astro.url.pathname.replace(/^\/(en|fa|ar)/, '') || '/';
const isActive = (href: string) =>
  currentPathWithoutLang === href || currentPathWithoutLang.startsWith(`${href}/`);

const fontClass = lang === 'en' ? 'font-sans' : lang === 'ar' ? 'font-arabic' : 'font-persian';

const whatsappMessages: Record<string, string> = {
  fa: 'سلام، مایل به دریافت مشاوره رایگان طراحی سایت و سئو هستم.',
  ar: 'مرحباً، أود الحصول على استشارة مجانية لتصميم المواقع والسيو.',
  en: 'Hello, I would like to request a free web design and SEO consultation.',
};
const encodedNavMsg = encodeURIComponent(whatsappMessages[lang] || whatsappMessages.en);
const navWhatsappUrl = `https://wa.me/989125811880?text=${encodedNavMsg}`;
const waDirectLabel =
  lang === 'fa'
    ? 'یا گفتگوی فوری در واتساپ'
    : lang === 'ar'
      ? 'أو تحدث معنا مباشرة عبر واتساب'
      : 'Or Chat Directly on WhatsApp';

const colorPalettes = [
  { id: 'blue', label: 'Blue', dotColor: '#38bdf8' },
  { id: 'mono', label: 'Dark/White', dotColor: '#ffffff', border: true },
  { id: 'emerald', label: 'Green', dotColor: '#7ee787' },
  { id: 'cyan', label: 'Teal', dotColor: '#2dd4bf' },
  { id: 'violet', label: 'Violet', dotColor: '#a78bfa' },
  { id: 'amber', label: 'Amber', dotColor: '#fbbf24' },
];

const serviceOptions = [
  {
    value: 'SEO & Specialized Optimization',
    label: t('services.seoTitle', { fallback: 'SEO & Specialized Optimization' }),
  },
  {
    value: 'Local SEO',
    label: t('services.localSeoTitle', { fallback: 'Local SEO' }),
  },
  {
    value: 'Link Building',
    label: t('services.linkBuildingTitle', { fallback: 'Link Building' }),
  },
  {
    value: 'Specialized Content Creation',
    label: t('services.contentCreationTitle', { fallback: 'Specialized Content Creation' }),
  },
  {
    value: 'Custom Web Development',
    label: t('services.webDevTitle', { fallback: 'Web Development' }),
  },
  {
    value: 'WordPress & WooCommerce',
    label: t('wordpress.wordpressAndWoocommerce', { fallback: 'WordPress & WooCommerce' }),
  },
  {
    value: 'Custom Website Design',
    label: t('common.webDesignAndDevelopment', { fallback: 'Custom Website Design' }),
  },
  {
    value: 'E-commerce Website Design & Development',
    label: t('ecommerce.title', { fallback: 'E-commerce Website Design & Development' }),
  },
  {
    value: 'Website Maintenance & Care Plans',
    label: t('maintenance.title', { fallback: 'Website Maintenance & Care Plans' }),
  },
  {
    value: 'Core Web Vitals & Speed Optimization',
    label: t('speedOptimization.title', { fallback: 'Core Web Vitals & Speed Optimization' }),
  },
  {
    value: 'Professional UI/UX Audit',
    label: t('uiUxAudit.title', { fallback: 'Professional UI/UX Audit' }),
  },
];
---

<header
  id="main-header"
  class="sticky top-0 right-0 left-0 z-50 border-b border-[var(--border-hairline)] bg-[var(--bg-surface)]/95 backdrop-blur-md transition-colors duration-200"
>
  <!-- Top Bar: Telemetry + Instant Color & Dark/White Switcher -->
  <div
    class="border-b border-[var(--border-subtle)] bg-[var(--bg-canvas)] px-4 py-1.5 text-xs"
    dir="ltr"
    style="unicode-bidi: isolate;"
  >
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-2 font-mono">
      <!-- Left: CWV Telemetry + Free Tools Link -->
      <div class="flex items-center gap-3 text-[11px] text-[var(--text-secondary)]">
        <span class="inline-flex items-center gap-1.5">
          <span
            class="inline-block h-2 w-2 rounded-full bg-[var(--accent-green)]"
            aria-hidden="true"></span>
          <span class="font-semibold text-[var(--accent-green)]">CWV: PASS</span>
          <span class="hidden md:inline">· LCP 0.8s · INP 24ms · CLS 0.00</span>
        </span>
        <span class="hidden text-[var(--border-focus)] sm:inline">|</span>
        <a
          href={linkPath('/tools')}
          class="hidden items-center gap-1 font-medium text-[var(--accent-blue)] transition-colors hover:underline sm:inline-flex"
        >
          <span>5 Free SEO &amp; Web Tools →</span>
        </a>
      </div>

      <!-- Right: Live Color Palette Switcher (Blue, Dark/White, Green, Teal, Violet, Amber) -->
      <div class="flex items-center gap-1.5 overflow-x-auto" role="group" aria-label="Color Theme Switcher">
        <span class="text-[10px] tracking-wider text-[var(--text-secondary)] uppercase">
          COLOR:
        </span>
        {
          colorPalettes.map((p) => (
            <button
              type="button"
              data-palette-btn={p.id}
              class="palette-swatch-btn"
              title={`Switch site palette to ${p.label}`}
            >
              <span
                class="inline-block h-2.5 w-2.5 shrink-0 rounded-full"
                style={`background-color: ${p.dotColor}; ${p.border ? 'border: 1px solid #71717a;' : ''}`}
              />
              <span>{p.label}</span>
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Main Single-Line Navigation Bar -->
  <div class="mx-auto max-w-7xl px-4 py-2.5">
    <div class="flex items-center justify-between gap-3">
      <!-- Clean Brand Logo (No redundant badges crowding the nav) -->
      <a
        href={linkPath('')}
        class="flex shrink-0 items-center focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-green)]"
        aria-label={t('common.home')}
      >
        <Logo class="h-auto w-28 sm:w-32" />
      </a>

      <!-- Desktop Single-Line Navigation Menu -->
      <nav class="mx-2 hidden grow items-center justify-center gap-1 lg:flex xl:gap-2">
        <!-- 3-Column Services Mega-Menu Trigger -->
        <div class="group relative shrink-0">
          <button
            type="button"
            id="desktop-services-btn"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="desktop-services-panel"
            class={`flex cursor-pointer items-center gap-1 rounded px-2.5 py-1.5 text-[13px] font-medium whitespace-nowrap text-[var(--text-primary)] transition-colors hover:bg-[var(--bg-elevated)] hover:text-[var(--accent-green)] ${fontClass}`}
          >
            <span>{t('common.services')}</span>
            <svg
              aria-hidden="true"
              class="h-3.5 w-3.5 shrink-0 text-[var(--text-secondary)] transition-transform duration-200 group-focus-within:rotate-180 group-hover:rotate-180"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>

          <!-- Mega-Menu Dropdown Content (Compact, no service descriptions) -->
          <div
            id="desktop-services-panel"
            class={`invisible absolute top-full ${isRtl ? '-right-12' : '-left-12'} z-50 mt-2 w-[36rem] max-w-[calc(100vw-2rem)] translate-y-1 opacity-0 transition-all duration-200 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 xl:w-[39rem]`}
          >
            <div class="terminal-window border border-[var(--border-hairline)] bg-[var(--bg-surface)] shadow-2xl">
              <div class="terminal-chrome-bar" dir="ltr">
                <span>╭─ /SERVICES · 11 SPECIALIZED SOLUTIONS ─╮</span>
                <span class="monospace-telemetry-pill">EN · FA · AR</span>
              </div>

              <div class="grid grid-cols-3 divide-x divide-[var(--border-hairline)] p-4 text-start rtl:divide-x-reverse">
                <!-- Column 1: /SEO-SERVICES -->
                <div class="space-y-2 pe-3">
                  <div class="border-b border-[var(--border-subtle)] pb-1.5">
                    <span class="slash-eyebrow text-[10px]" dir="ltr">/SEO-SERVICES</span>
                  </div>
                  <ul class="space-y-1">
                    <li>
                      <a
                        href={linkPath('/services/seo')}
                        class={`group/item flex items-center gap-2 rounded px-2 py-1.5 text-xs font-semibold text-[var(--text-primary)] transition-colors hover:bg-[var(--bg-elevated)] hover:text-[var(--accent-green)] ${fontClass}`}
                      >
                        <span class="ltr-isolate shrink-0 font-mono text-[10px] text-[var(--accent-green)]" dir="ltr">[01]</span>
                        <span>{t('services.seoTitle', { fallback: 'SEO Services' })}</span>
                      </a>
                    </li>
                    <li>
                      <a
                        href={linkPath('/services/local-seo')}
                        class={`group/item flex items-center gap-2 rounded px-2 py-1.5 text-xs font-semibold text-[var(--text-primary)] transition-colors hover:bg-[var(--bg-elevated)] hover:text-[var(--accent-green)] ${fontClass}`}
                      >
                        <span class="ltr-isolate shrink-0 font-mono text-[10px] text-[var(--accent-green)]" dir="ltr">[02]</span>
                        <span>{t('services.localSeoTitle', { fallback: 'Local SEO' })}</span>
                      </a>
                    </li>
                    <li>
                      <a
                        href={linkPath('/services/link-building')}
                        class={`group/item flex items-center gap-2 rounded px-2 py-1.5 text-xs font-semibold text-[var(--text-primary)] transition-colors hover:bg-[var(--bg-elevated)] hover:text-[var(--accent-green)] ${fontClass}`}
                      >
                        <span class="ltr-isolate shrink-0 font-mono text-[10px] text-[var(--accent-green)]" dir="ltr">[03]</span>
                        <span>{t('services.linkBuildingTitle', { fallback: 'Link Building' })}</span>
                      </a>
                    </li>
                    <li>
                      <a
                        href={linkPath('/services/content-creation')}
                        class={`group/item flex items-center gap-2 rounded px-2 py-1.5 text-xs font-semibold text-[var(--text-primary)] transition-colors hover:bg-[var(--bg-elevated)] hover:text-[var(--accent-green)] ${fontClass}`}
                      >
                        <span class="ltr-isolate shrink-0 font-mono text-[10px] text-[var(--accent-green)]" dir="ltr">[04]</span>
                        <span>{t('services.contentCreationTitle', { fallback: 'Content Creation' })}</span>
                      </a>
                    </li>
                  </ul>
                </div>

                <!-- Column 2: /DEVELOPMENT-SERVICES -->
                <div class="space-y-2 px-3">
                  <div class="border-b border-[var(--border-subtle)] pb-1.5">
                    <span class="slash-eyebrow text-[10px]" dir="ltr">/DEVELOPMENT</span>
                  </div>
                  <ul class="space-y-1">
                    <li>
                      <a
                        href={linkPath('/services/web-development')}
                        class={`group/item flex items-center gap-2 rounded px-2 py-1.5 text-xs font-semibold text-[var(--text-primary)] transition-colors hover:bg-[var(--bg-elevated)] hover:text-[var(--accent-blue)] ${fontClass}`}
                      >
                        <span class="ltr-isolate shrink-0 font-mono text-[10px] text-[var(--accent-blue)]" dir="ltr">[05]</span>
                        <span>{t('services.webDevTitle', { fallback: 'Web Development' })}</span>
                      </a>
                    </li>
                    <li>
                      <a
                        href={linkPath('/services/wordpress-development')}
                        class={`group/item flex items-center gap-2 rounded px-2 py-1.5 text-xs font-semibold text-[var(--text-primary)] transition-colors hover:bg-[var(--bg-elevated)] hover:text-[var(--accent-blue)] ${fontClass}`}
                      >
                        <span class="ltr-isolate shrink-0 font-mono text-[10px] text-[var(--accent-blue)]" dir="ltr">[06]</span>
                        <span>{t('wordpress.wordpressAndWoocommerce', { fallback: 'WordPress & WooCommerce' })}</span>
                      </a>
                    </li>
                    <li>
                      <a
                        href={linkPath('/services/web-design')}
                        class={`group/item flex items-center gap-2 rounded px-2 py-1.5 text-xs font-semibold text-[var(--text-primary)] transition-colors hover:bg-[var(--bg-elevated)] hover:text-[var(--accent-blue)] ${fontClass}`}
                      >
                        <span class="ltr-isolate shrink-0 font-mono text-[10px] text-[var(--accent-blue)]" dir="ltr">[07]</span>
                        <span>{t('common.webDesignAndDevelopment', { fallback: 'Web Design & Development' })}</span>
                      </a>
                    </li>
                    <li>
                      <a
                        href={linkPath('/services/ecommerce')}
                        class={`group/item flex items-center gap-2 rounded px-2 py-1.5 text-xs font-semibold text-[var(--text-primary)] transition-colors hover:bg-[var(--bg-elevated)] hover:text-[var(--accent-blue)] ${fontClass}`}
                      >
                        <span class="ltr-isolate shrink-0 font-mono text-[10px] text-[var(--accent-blue)]" dir="ltr">[08]</span>
                        <span>{t('ecommerce.title', { fallback: 'E-commerce Design & Dev' })}</span>
                      </a>
                    </li>
                  </ul>
                </div>

                <!-- Column 3: /SUPPORT-AND-OPTIMIZATION -->
                <div class="space-y-2 ps-3">
                  <div class="border-b border-[var(--border-subtle)] pb-1.5">
                    <span class="slash-eyebrow text-[10px]" dir="ltr">/OPTIMIZATION</span>
                  </div>
                  <ul class="space-y-1">
                    <li>
                      <a
                        href={linkPath('/services/website-maintenance')}
                        class={`group/item flex items-center gap-2 rounded px-2 py-1.5 text-xs font-semibold text-[var(--text-primary)] transition-colors hover:bg-[var(--bg-elevated)] hover:text-[var(--accent-amber)] ${fontClass}`}
                      >
                        <span class="ltr-isolate shrink-0 font-mono text-[10px] text-[var(--accent-amber)]" dir="ltr">[09]</span>
                        <span>{t('maintenance.title', { fallback: 'Website Maintenance' })}</span>
                      </a>
                    </li>
                    <li>
                      <a
                        href={linkPath('/services/speed-optimization')}
                        class={`group/item flex items-center gap-2 rounded px-2 py-1.5 text-xs font-semibold text-[var(--text-primary)] transition-colors hover:bg-[var(--bg-elevated)] hover:text-[var(--accent-amber)] ${fontClass}`}
                      >
                        <span class="ltr-isolate shrink-0 font-mono text-[10px] text-[var(--accent-amber)]" dir="ltr">[10]</span>
                        <span>{t('speedOptimization.title', { fallback: 'Speed & Core Web Vitals' })}</span>
                      </a>
                    </li>
                    <li>
                      <a
                        href={linkPath('/services/ui-ux-audit')}
                        class={`group/item flex items-center gap-2 rounded px-2 py-1.5 text-xs font-semibold text-[var(--text-primary)] transition-colors hover:bg-[var(--bg-elevated)] hover:text-[var(--accent-amber)] ${fontClass}`}
                      >
                        <span class="ltr-isolate shrink-0 font-mono text-[10px] text-[var(--accent-amber)]" dir="ltr">[11]</span>
                        <span>{t('uiUxAudit.title', { fallback: 'Professional UI/UX Audit' })}</span>
                      </a>
                    </li>
                  </ul>
                </div>
              </div>

              <div class="flex items-center justify-between border-t border-[var(--border-hairline)] bg-[var(--bg-elevated)] px-4 py-2">
                <span class="ltr-isolate font-mono text-[10px] text-[var(--text-secondary)]" dir="ltr">
                  ╰─ 11 SERVICES · CWV 99/100 GUARANTEED ─╯
                </span>
                <a
                  href={linkPath('/services')}
                  class={`inline-flex items-center gap-1 font-mono text-xs font-bold text-[var(--accent-green)] hover:underline ${fontClass}`}
                >
                  <span>{t('common.viewAll')} {t('common.services')}</span>
                  <span aria-hidden="true">{isRtl ? '←' : '→'}</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        {
          navItems.map((item) => (
            <a
              href={linkPath(item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class={`shrink-0 rounded px-2.5 py-1.5 text-[13px] font-medium whitespace-nowrap transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-green)] ${fontClass} ${
                isActive(item.href)
                  ? 'bg-[var(--bg-elevated)] font-semibold text-[var(--accent-green)]'
                  : 'text-[var(--text-secondary)] hover:bg-[var(--bg-elevated)] hover:text-[var(--text-primary)]'
              }`}
            >
              {t(item.label)}
            </a>
          ))
        }
      </nav>

      <!-- Desktop Right Utility Cluster (Single-line guaranteed) -->
      <div class="hidden shrink-0 items-center gap-2 lg:flex">
        <!-- Segmented Locale Switcher (en | fa | ar) -->
        <div
          class="ltr-isolate inline-flex shrink-0 items-center rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] p-0.5 font-mono text-xs"
          dir="ltr"
          role="group"
          aria-label="Language switcher"
        >
          {
            Object.keys(languages).map((l) => (
              <a
                href={`/${l}${currentPathWithoutLang}`}
                aria-current={lang === l ? 'true' : undefined}
                class={`rounded-xs px-2 py-1 text-[11px] font-bold uppercase transition-colors ${
                  lang === l
                    ? 'bg-[var(--bg-elevated)] text-[var(--accent-green)]'
                    : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)]'
                }`}
              >
                {l}
              </a>
            ))
          }
        </div>

        <!-- Dark / White Mode Toggle Button -->
        <button
          type="button"
          id="theme-toggle"
          data-label-dark={t('common.switchToDark', { fallback: 'Switch to dark mode' })}
          data-label-light={t('common.switchToLight', { fallback: 'Switch to light mode' })}
          class="ltr-isolate inline-flex h-8 shrink-0 cursor-pointer items-center gap-1.5 rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-2.5 font-mono text-xs whitespace-nowrap text-[var(--text-secondary)] transition-colors hover:border-[var(--border-focus)] hover:text-[var(--text-primary)] focus-visible:ring-2 focus-visible:ring-[var(--accent-green)]"
          dir="ltr"
          aria-label={t('common.switchToDark', { fallback: 'Switch to dark mode' })}
        >
          <svg
            data-icon="sun"
            aria-hidden="true"
            class="hidden h-3.5 w-3.5 shrink-0 text-[var(--accent-amber)]"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
            ></path>
          </svg>
          <svg
            data-icon="moon"
            aria-hidden="true"
            class="h-3.5 w-3.5 shrink-0 text-[var(--accent-blue)]"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
          <span data-theme-mode-pill class="text-[11px] font-semibold">DARK</span>
        </button>

        <!-- Primary Action Button: Free Consultation (Single-line whitespace-nowrap) -->
        <button
          type="button"
          id="open-consultation-btn"
          data-open-consultation
          class={`inline-flex h-8 shrink-0 cursor-pointer items-center gap-1 rounded border border-[var(--accent-green)] bg-[var(--accent-green-dim)] px-3.5 text-xs font-bold whitespace-nowrap text-[var(--accent-contrast)] transition-all hover:bg-[var(--accent-green)] hover:text-[#090b0e] focus-visible:ring-2 focus-visible:ring-[var(--accent-green)] ${fontClass}`}
        >
          <span>{t('common.freeConsultation')}</span>
          <span aria-hidden="true">{isRtl ? '←' : '→'}</span>
        </button>
      </div>

      <!-- Mobile Controls -->
      <div class="flex items-center gap-2 lg:hidden">
        <!-- Mobile Dark/White Quick Toggle -->
        <button
          type="button"
          id="theme-toggle-mobile-top"
          class="ltr-isolate inline-flex h-8 cursor-pointer items-center gap-1 rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-2 font-mono text-[11px] font-bold text-[var(--text-primary)]"
          dir="ltr"
          aria-label="Toggle Dark or White mode"
        >
          <span data-theme-mode-pill-mobile>DARK</span>
        </button>

        <!-- Mobile Language Selector -->
        <div class="relative">
          <button
            type="button"
            id="mobile-lang-btn"
            aria-expanded="false"
            aria-controls="mobile-lang-dropdown"
            class="ltr-isolate flex h-8 items-center gap-1 rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-2.5 font-mono text-xs font-bold text-[var(--text-primary)] uppercase"
            dir="ltr"
          >
            <span>{lang}</span>
            <span aria-hidden="true">▾</span>
          </button>
          <div
            id="mobile-lang-dropdown"
            class="absolute top-full right-0 z-50 mt-1 hidden w-32 rounded border border-[var(--border-hairline)] bg-[var(--bg-surface)] py-1 shadow-xl"
          >
            {
              Object.entries(languages).map(([code, meta]) => (
                <a
                  href={`/${code}${currentPathWithoutLang}`}
                  aria-current={lang === code ? 'true' : undefined}
                  class="block px-3 py-2 text-center text-xs font-medium text-[var(--text-primary)] hover:bg-[var(--bg-elevated)] hover:text-[var(--accent-green)]"
                >
                  {meta.nativeName} ({code.toUpperCase()})
                </a>
              ))
            }
          </div>
        </div>

        <button
          type="button"
          id="mobile-menu-btn"
          class="rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] p-1.5 text-[var(--text-primary)] hover:border-[var(--border-focus)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-green)]"
          aria-label="Toggle Menu"
          aria-expanded="false"
          aria-controls="mobile-drawer"
        >
          <svg
            aria-hidden="true"
            class="h-5 w-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
