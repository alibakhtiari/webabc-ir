---
import { getDictionary } from '@/i18n/get-dictionary';
import { type SupportedLanguage } from '@/types/language';
import { canonicalPageUrl, webpageId, websiteId } from '@/utils/schemaIds';

interface Props {
  faqList: { question: string; answer: string }[];
  lang: SupportedLanguage;
  breadcrumbId?: string;
}

const { faqList, lang, breadcrumbId: breadcrumbRef } = Astro.props;
const dictionary = await getDictionary(lang);
const fontClass = lang === 'fa' ? 'font-persian' : lang === 'ar' ? 'font-arabic' : 'font-sans';

const titleText =
  dictionary.home?.faq?.title || dictionary.blog?.faq || 'Frequently Asked Questions';

const pageUrl = canonicalPageUrl(Astro.url.pathname);
const webpageRef = webpageId(pageUrl);
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  isPartOf: { '@id': webpageRef },
  inLanguage: lang === 'en' ? 'en-US' : lang === 'ar' ? 'ar-SA' : 'fa-IR',
  mainEntity: faqList.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
const webpageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': webpageRef,
  url: pageUrl,
  inLanguage: lang === 'en' ? 'en-US' : lang === 'ar' ? 'ar-SA' : 'fa-IR',
  isPartOf: { '@id': websiteId(lang) },
  ...(breadcrumbRef ? { breadcrumb: { '@id': breadcrumbRef } } : {}),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(webpageSchema)} />

<div class={`terminal-window mb-8 ${fontClass}`}>
  <div class="terminal-chrome-bar" dir="ltr">
    <span class="slash-eyebrow text-xs" dir={lang === 'fa' || lang === 'ar' ? 'rtl' : 'ltr'}>
      {
        lang === 'fa'
          ? '/سوالات-متداول · پاسخ‌های فنی و تجاری'
          : lang === 'ar'
            ? '/الأسئلة-الشائعة · إجابات تقنية وتجارية'
            : '/FAQS · TECHNICAL & COMMERCIAL ANSWERS'
      }
    </span>
    <span class="monospace-telemetry-pill">
      FAQPage JSON-LD · {faqList.length} {lang === 'fa' ? 'مورد' : lang === 'ar' ? 'عناصر' : 'ITEMS'}
    </span>
  </div>

  <div class="p-6 sm:p-8">
    <h2 class="mb-6 flex items-center gap-2 text-2xl font-bold text-[var(--text-primary)]">
      {titleText}
    </h2>

    <div class="divide-y divide-[var(--border-hairline)] border-t border-[var(--border-hairline)]">
      {
        faqList.map((item, idx) => (
          <div class="py-4">
            <button
              type="button"
              class="faq-btn flex w-full cursor-pointer items-start justify-between gap-4 py-1 text-start font-bold text-[var(--text-primary)] transition-colors hover:text-[var(--accent-green)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-green)]"
              data-faq-target={`faq-answer-${idx}`}
              aria-expanded={idx === 0 ? 'true' : 'false'}
              aria-controls={`faq-answer-${idx}`}
            >
              <span class="flex items-start gap-2.5">
                <span class="ltr-isolate mt-0.5 shrink-0 font-mono text-xs font-bold text-[var(--accent-purple)]" dir="ltr">
                  Q.{String(idx + 1).padStart(2, '0')}
                </span>
                <span>{item.question}</span>
              </span>
              <span
                aria-hidden="true"
                class={`faq-icon ltr-isolate shrink-0 font-mono text-xs text-[var(--accent-green)] transition-transform duration-200 ${idx === 0 ? 'rotate-180' : ''}`}
                dir="ltr"
              >
                [▾]
              </span>
            </button>
            <div
              id={`faq-answer-${idx}`}
              class={`faq-answer mt-3 ps-9 text-sm leading-relaxed text-[var(--text-secondary)] ${idx === 0 ? '' : 'hidden'}`}
            >
              <span class="ltr-isolate me-1.5 font-mono text-xs font-bold text-[var(--accent-green)]" dir="ltr">
                A.
              </span>
              {item.answer}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    function initFaq() {
      const faqButtons = document.querySelectorAll('.faq-btn');
      faqButtons.forEach((btn) => {
        btn.onclick = () => {
          const targetId = btn.getAttribute('data-faq-target');
          const targetAnswer = document.getElementById(targetId);
          const icon = btn.querySelector('.faq-icon');

          if (targetAnswer) {
            const isHidden = targetAnswer.classList.toggle('hidden');
            if (icon) icon.classList.toggle('rotate-180', !isHidden);
            btn.setAttribute('aria-expanded', String(!isHidden));
          }
        };
      });
    }

    document.addEventListener('astro:page-load', initFaq);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initFaq();
    }
  })();
</script>
