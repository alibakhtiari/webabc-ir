---
import type { ImageMetadata } from 'astro';
import Hero from './Hero.astro';

interface Props {
  title: string;
  subtitle: string;
  description?: string;
  heroImage?: ImageMetadata;
  breadcrumbs: Array<{ label: string; url?: string }>;
  lang: string;
  gradient?: string;
  className?: string;
}
---

<Hero {...Astro.props}>
  <slot />
</Hero>
