---
import { getDictionary } from '@/i18n/get-dictionary';
import { languages, type SupportedLanguage } from '@/types/language';
import { createTranslator } from '@/i18n/translate';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const dictionary = await getDictionary(lang);
const isRtl = languages[lang]?.direction === 'rtl';
const fontClass = lang === 'en' ? 'font-sans' : lang === 'ar' ? 'font-arabic' : 'font-persian';

const t = createTranslator(dictionary);

const linkPath = (path: string) => {
  if (!path || path === '/') return `/${lang}/`;
  const cleanPath = path.startsWith('/') ? path : `/${path}`;
  return `/${lang}${cleanPath.endsWith('/') ? cleanPath : cleanPath + '/'}`;
};

const steps =
  lang === 'fa'
    ? [
        { num: '01', title: 'آنالیز رایگان سایت و رقبا', time: 'ظرف ۲۴ ساعت' },
        { num: '02', title: 'جلسه مشاوره و نقشه راه اختصاصی', time: '۳۰ دقیقه آنلاین/تلفنی' },
        { num: '03', title: 'پیشنهاد قیمت شفاف و شروع رشد', time: 'تضمین نتیجه' },
      ]
    : lang === 'ar'
      ? [
          { num: '01', title: 'تدقيق مجاني للموقع والمنافسين', time: 'خلال 24 ساعة' },
          { num: '02', title: 'جلسة استشارة وخارطة طريق مخصصة', time: '30 دقيقة مجاناً' },
          { num: '03', title: 'عرض سعر ثابت وبدء التنفيذ', time: 'ضمان النتائج' },
        ]
      : [
          { num: '01', title: 'Free Website & Competitor Audit', time: 'Within 24 Hours' },
          { num: '02', title: '1-on-1 Strategy & Growth Roadmap', time: '30-Min Free Call' },
          { num: '03', title: 'Fixed-Price Proposal & Execution', time: 'Guaranteed CWV/SEO' },
        ];

const whatsappMessages: Record<string, string> = {
  fa: 'سلام، برای دریافت مشاوره رایگان و آنالیز سایت پیام می‌دهم.',
  ar: 'مرحباً، أود الحصول على استشارة مجانية وتدقيق لموقعي.',
  en: 'Hello, I would like to request a free website audit and growth consultation.',
};
const waUrl = `https://wa.me/989125811880?text=${encodeURIComponent(whatsappMessages[lang] || whatsappMessages.en)}`;
---

<section id="contact" class={`border-t border-[var(--border-hairline)] bg-[var(--bg-canvas)] py-14 md:py-20 ${fontClass}`}>
  <div class="container mx-auto px-4 md:px-6">
    <div class="mx-auto max-w-5xl">
      <div class="terminal-window border border-[var(--border-focus)]">
        <div class="terminal-chrome-bar" dir="ltr">
          <span class="slash-eyebrow text-xs" dir={isRtl ? 'rtl' : 'ltr'}>
            {
              lang === 'fa'
                ? '╭─ /شروع-همکاری · مشاوره و آنالیز بدون ریسک ─╮'
                : lang === 'ar'
                  ? '╭─ /ابدأ-الآن · استشارة وتدقيق بلا مخاطرة ─╮'
                  : '╭─ /GET-STARTED · ZERO-RISK CONSULTATION & AUDIT ─╮'
            }
          </span>
          <span class="monospace-telemetry-pill text-[var(--accent-green)]">
            ● {lang === 'fa' ? 'پاسخ‌گویی زیر ۲ ساعت' : lang === 'ar' ? 'الرد خلال أقل من ساعتين' : 'REPLY IN < 2 HOURS'}
          </span>
        </div>

        <div class="p-6 text-center sm:p-10">
          <h2 class="mb-3 text-2xl font-bold text-balance text-[var(--text-primary)] sm:text-3xl md:text-4xl">
            {t('cta.title', { fallback: 'Ready to take your business to the next level?' })}
          </h2>

          <p class="mx-auto mb-8 max-w-2xl text-sm text-balance text-[var(--text-secondary)] sm:text-base">
            {
              t('cta.description', {
                fallback:
                  'Get a free consultation and receive a custom SEO and web development strategy for your business.',
              })
            }
          </p>

          <!-- 3-Step "What Happens Next" Clarity Strip (Reduces anxiety & boosts conversion) -->
          <div class="mb-8 grid grid-cols-1 gap-3 text-start md:grid-cols-3">
            {
              steps.map((s) => (
                <div class="rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] p-4">
                  <div class="mb-1.5 flex items-center justify-between" dir="ltr">
                    <span class="font-mono text-xs font-bold text-[var(--accent-green)]">
                      {
                        lang === 'fa'
                          ? `[گام ${s.num}]`
                          : lang === 'ar'
                            ? `[خطوة ${s.num}]`
                            : `[STEP ${s.num}]`
                      }
                    </span>
                    <span class="monospace-telemetry-pill">{s.time}</span>
                  </div>
                  <div class="text-sm font-bold text-[var(--text-primary)]">{s.title}</div>
                </div>
              ))
            }
          </div>

          <!-- Primary & Multi-Channel Conversion Buttons -->
          <div class="flex flex-wrap items-center justify-center gap-3">
            <button
              type="button"
              id="cta-consultation-btn"
              data-open-consultation
              class={`inline-flex h-11 cursor-pointer items-center gap-2 rounded border border-[var(--accent-green)] bg-[var(--accent-green-dim)] px-6 ${isRtl ? (lang === 'ar' ? 'font-arabic' : 'font-persian') : 'font-mono'} text-xs font-bold text-[var(--accent-contrast)] transition-all hover:bg-[var(--accent-green)] hover:text-[#090b0e] sm:text-sm`}
            >
              <span>{t('cta.primaryButton', { fallback: 'Get Free Consultation' })}</span>
              <span aria-hidden="true">{isRtl ? '←' : '→'}</span>
            </button>

            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class={`inline-flex h-11 items-center gap-2 rounded border border-[var(--accent-green)]/50 bg-[var(--bg-canvas)] px-5 ${isRtl ? (lang === 'ar' ? 'font-arabic' : 'font-persian') : 'font-mono'} text-xs font-bold text-[var(--accent-green)] transition-all hover:bg-[var(--accent-green)] hover:text-[#090b0e] sm:text-sm`}
            >
              <span>
                {lang === 'fa'
                  ? 'چت فوری در واتساپ'
                  : lang === 'ar'
                    ? 'محادثة فورية عبر واتساب'
                    : 'Instant WhatsApp Chat'}
              </span>
            </a>

            <a
              href={linkPath('/tools/cost-calculator')}
              class={`inline-flex h-11 items-center gap-1.5 rounded border border-[var(--border-hairline)] bg-[var(--bg-elevated)] px-5 ${isRtl ? (lang === 'ar' ? 'font-arabic' : 'font-persian') : 'font-mono'} text-xs font-semibold text-[var(--text-primary)] transition-all hover:border-[var(--accent-blue)] hover:text-[var(--accent-blue)] sm:text-sm`}
            >
              <span dir="ltr">⚡</span>
              <span>
                {lang === 'fa'
                  ? 'ماشین‌حساب هزینه پروژه'
                  : lang === 'ar'
                    ? 'حاسبة تكلفة المشروع'
                    : 'Calculate Project Cost'}
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
