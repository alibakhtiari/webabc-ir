---
import { getDictionary } from '../../i18n/get-dictionary';
import { languages, type SupportedLanguage } from '../../types/language';
import { createTranslator } from '@/i18n/translate';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const dictionary = await getDictionary(lang);
const isRtl = languages[lang]?.direction === 'rtl';

// Helper to translate strings
const t = createTranslator(dictionary);

const linkPath = (path: string) => {
  return `/${lang}${path}`;
};
---

<section id="contact" class="py-24 relative overflow-hidden font-sans">
  <div class="container mx-auto px-4 md:px-6 relative z-10">
    <div class="max-w-5xl mx-auto">
      <div class="bg-primary rounded-3xl p-8 md:p-12 relative overflow-hidden">
        <!-- Background elements -->
        <div class="absolute inset-0 overflow-hidden">
          <div class="absolute top-0 right-0 w-64 h-64 rounded-full bg-white/10 blur-3xl"></div>
          <div class="absolute bottom-0 left-0 w-80 h-80 rounded-full bg-white/5 blur-3xl"></div>
        </div>

        <div class="relative z-10 text-center">
          <h2 class={`text-3xl md:text-4xl font-bold text-white mb-6 text-balance font-${lang === 'en' ? 'sans' : 'persian'}`}>
            {t('cta.title')}
          </h2>

          <p class={`text-white/90 text-lg mb-8 max-w-3xl mx-auto text-balance font-${lang === 'en' ? 'sans' : 'persian'}`}>
            {t('cta.description')}
          </p>

          <div class={`flex flex-col sm:flex-row items-center justify-center gap-4 mt-10 font-${lang === 'en' ? 'sans' : 'persian'}`}>
            <button
              id="cta-consultation-btn"
              class={`px-6 py-3 rounded-full bg-white text-primary font-medium transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-0.5 flex items-center gap-2 ${isRtl ? 'flex-row-reverse' : ''}`}
            >
              <span>{t('cta.primaryButton')}</span>
            </button>
            <a
              href={linkPath('/contact')}
              class="px-6 py-3 rounded-full bg-transparent text-white border border-white/30 transition-all duration-300 hover:bg-white/10"
            >
              <span>{t('cta.secondaryButton')}</span>
            </a>
          </div>
        </div>
      </div>

      <div class={`grid grid-cols-1 ${lang === 'fa' ? 'md:grid-cols-3' : 'md:grid-cols-2 max-w-2xl mx-auto'} gap-8 mt-16`}>
        {[
          ...(lang === 'fa' ? [{
            title: t('cta.address'),
            content: t('cta.addressValue')
          }] : []),
          {
            title: t('cta.phone'),
            content: t('cta.phoneValue')
          },
          {
            title: t('cta.email'),
            content: t('cta.emailValue')
          }
        ].map((item) => (
          <div class="neo-morphism p-6 rounded-xl text-center transition-all duration-300 hover:shadow-md">
            <h3 class={`text-xl font-medium mb-2 font-${lang === 'en' ? 'sans' : 'persian'}`}>{item.title}</h3>
            <p class={`text-foreground/80 font-${lang === 'en' ? 'sans' : 'persian'}`}>{item.content}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Connect CTA button to consultation modal trigger
  const ctaBtn = document.getElementById('cta-consultation-btn');
  const consultationModal = document.getElementById('consultation-modal');
  if (ctaBtn && consultationModal) {
    ctaBtn.addEventListener('click', () => {
      consultationModal.showModal();
    });
  }
</script>
