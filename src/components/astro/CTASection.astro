---
import { getDictionary } from '../../i18n/get-dictionary';
import { languages, type SupportedLanguage } from '../../types/language';
import { createTranslator } from '@/i18n/translate';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const dictionary = await getDictionary(lang);
const isRtl = languages[lang]?.direction === 'rtl';

// Helper to translate strings
const t = createTranslator(dictionary);

const linkPath = (path: string) => {
  if (!path || path === '/') return `/${lang}/`;
  const cleanPath = path.startsWith('/') ? path : `/${path}`;
  return `/${lang}${cleanPath.endsWith('/') ? cleanPath : cleanPath + '/'}`;
};
---

<section id="contact" class="relative overflow-hidden py-24 font-sans">
  <div class="relative z-10 container mx-auto px-4 md:px-6">
    <div class="mx-auto max-w-5xl">
      <div class="relative overflow-hidden rounded-3xl bg-primary p-8 md:p-12">
        <!-- Background elements -->
        <div class="absolute inset-0 overflow-hidden">
          <div class="absolute top-0 right-0 h-64 w-64 rounded-full bg-white/10 blur-3xl"></div>
          <div class="absolute bottom-0 left-0 h-80 w-80 rounded-full bg-white/5 blur-3xl"></div>
        </div>

        <div class="relative z-10 text-center">
          <h2
            class={`text-3xl md:text-4xl font-bold text-white mb-6 text-balance font-${lang === 'en' ? 'sans' : 'persian'}`}
          >
            {t('cta.title')}
          </h2>

          <p
            class={`text-white/90 text-lg mb-8 max-w-3xl mx-auto text-balance font-${lang === 'en' ? 'sans' : 'persian'}`}
          >
            {t('cta.description')}
          </p>

          <div
            class={`flex flex-col sm:flex-row items-center justify-center gap-4 mt-10 font-${lang === 'en' ? 'sans' : 'persian'}`}
          >
            <button
              type="button"
              id="cta-consultation-btn"
              class={`px-6 py-3 rounded-full bg-white text-primary font-medium transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-0.5 flex items-center gap-2 ${isRtl ? 'flex-row-reverse' : ''}`}
            >
              <span>{t('cta.primaryButton')}</span>
            </button>
            <a
              href={linkPath('/contact')}
              class="rounded-full border border-white/30 bg-transparent px-6 py-3 text-white transition-all duration-300 hover:bg-white/10 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
            >
              <span>{t('cta.secondaryButton')}</span>
            </a>
          </div>
        </div>
      </div>

      <div
        class={`grid grid-cols-1 ${lang === 'fa' ? 'md:grid-cols-3' : 'md:grid-cols-2 max-w-2xl mx-auto'} gap-8 mt-16`}
      >
        {
          [
            ...(lang === 'fa'
              ? [
                  {
                    title: t('cta.address'),
                    type: 'address' as const,
                    content: t('cta.addressValue'),
                  },
                ]
              : []),
            {
              title: t('cta.phone'),
              type: 'phone' as const,
              phones: [
                {
                  tel: '+989125811880',
                  label: t('contact.phoneValue', { fallback: '+98 912 581 1880' }),
                },
                {
                  tel: '+989354767068',
                  label: t('contact.phoneValue2', { fallback: '+98 935 476 7068' }),
                },
              ],
            },
            {
              title: t('cta.email'),
              type: 'email' as const,
              email: t('cta.emailValue', { fallback: 'info@webabc.ir' }),
            },
          ].map((item) => (
            <div class="rounded-xl neo-morphism p-6 text-center transition-all duration-300 hover:shadow-md">
              <h3 class={`mb-2 text-xl font-medium font-${lang === 'en' ? 'sans' : 'persian'}`}>
                {item.title}
              </h3>
              {item.type === 'phone' ? (
                <div class="space-y-1.5">
                  {item.phones?.map((p) => (
                    <div>
                      <a
                        href={`tel:${p.tel}`}
                        class={`inline-block text-foreground/80 transition-colors hover:text-primary focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 font-${lang === 'en' ? 'sans' : 'persian'}`}
                        dir="ltr"
                      >
                        {p.label}
                      </a>
                    </div>
                  ))}
                </div>
              ) : item.type === 'email' ? (
                <p>
                  <a
                    href={`mailto:${item.email}`}
                    class={`inline-block text-foreground/80 transition-colors hover:text-primary focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 font-${lang === 'en' ? 'sans' : 'persian'}`}
                  >
                    {item.email}
                  </a>
                </p>
              ) : (
                <p
                  class={`text-foreground/80 font-${lang === 'en' ? 'sans' : 'persian'} whitespace-pre-line`}
                >
                  {item.content}
                </p>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    function initCta() {
      const ctaBtn = document.getElementById('cta-consultation-btn');
      const consultationModal = document.getElementById('consultation-modal');
      if (ctaBtn && consultationModal) {
        ctaBtn.onclick = () => {
          consultationModal.showModal();
        };
      }
    }

    document.addEventListener('astro:page-load', initCta);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initCta();
    }
  })();
</script>
