---
import { getDictionary } from '@/i18n/get-dictionary';
import { languages, type SupportedLanguage } from '@/types/language';
import { createTranslator } from '@/i18n/translate';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const dictionary = await getDictionary(lang);
const isRtl = languages[lang]?.direction === 'rtl';
const fontClass = lang === 'fa' ? 'font-persian' : lang === 'ar' ? 'font-arabic' : 'font-sans';

const t = createTranslator(dictionary);

const linkPath = (path: string) => {
  if (!path || path === '/') return `/${lang}/`;
  const cleanPath = path.startsWith('/') ? path : `/${path}`;
  return `/${lang}${cleanPath.endsWith('/') ? cleanPath : cleanPath + '/'}`;
};
---

<section id="contact" class={`relative overflow-hidden py-20 ${fontClass} md:py-24`}>
  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-3xl bg-primary p-8 md:p-12 lg:p-16">
      <div class="absolute inset-0 overflow-hidden">
        <div class="absolute top-0 end-0 h-64 w-64 rounded-full bg-white/10 blur-3xl"></div>
        <div class="absolute bottom-0 start-0 h-80 w-80 rounded-full bg-white/5 blur-3xl"></div>
      </div>

      <div class="relative z-10 text-center">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white mb-4 text-balance">
          {t('cta.title')}
        </h2>

        <p class="text-white/90 text-base sm:text-lg mb-8 max-w-3xl mx-auto leading-relaxed text-balance">
          {t('cta.description')}
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-10">
          <button
            type="button"
            id="cta-consultation-btn"
            class={`min-h-12 cursor-pointer px-6 py-3 rounded-full bg-white text-primary font-bold transition-colors shadow-md hover:bg-gray-50 focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-primary flex items-center gap-2 ${isRtl ? 'flex-row-reverse' : ''}`}
          >
            <span>{t('cta.primaryButton')}</span>
          </button>
          <a
            href={linkPath('/contact')}
            class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/40 bg-transparent px-6 py-3 font-semibold text-white transition-colors hover:bg-white/10 focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-primary"
          >
            <span>{t('cta.secondaryButton')}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    function initCta() {
      const ctaBtn = document.getElementById('cta-consultation-btn');
      const consultationModal = document.getElementById('consultation-modal');
      if (ctaBtn && consultationModal) {
        ctaBtn.onclick = () => {
          consultationModal.showModal();
        };
      }
    }

    document.addEventListener('astro:page-load', initCta);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initCta();
    }
  })();
</script>
