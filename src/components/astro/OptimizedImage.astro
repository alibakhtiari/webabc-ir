---
/**
 * Serves a static image with AVIF when the browser supports it and falls back
 * to WebP. Use for images living in `public/` (referenced by string path),
 * which Astro's <Image> cannot transform at build time.
 *
 * Props mirror <img>; `src` must be a webp path (e.g. /images/blog/foo.webp).
 * The AVIF sibling (foo.avif) is generated by scripts/generate-avif.mjs.
 */
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  decoding?: 'async' | 'sync' | 'auto';
  style?: string;
  sizes?: string;
  srcset?: string;
  title?: string;
}

const { src, alt, srcset, sizes, ...attrs } = Astro.props;
const avifSrc = src.replace(/\.webp$/i, '.avif');
const avifSrcset = srcset ? srcset.replace(/\.webp/gi, '.avif') : undefined;
---

<picture>
  <source type="image/avif" srcset={avifSrcset || avifSrc} sizes={sizes} />
  <source type="image/webp" srcset={srcset || src} sizes={sizes} />
  <img src={src} alt={alt} srcset={srcset} sizes={sizes} {...attrs} />
</picture>
