---
import { getDictionary } from '../../i18n/get-dictionary';
import { type SupportedLanguage } from '../../types/language';

interface Props {
  takeaways: string[];
  lang: SupportedLanguage;
}

const { takeaways, lang } = Astro.props;
const dictionary = await getDictionary(lang);

const titleText = dictionary.blog?.keyTakeaways || 'خلاصه و نکات کلیدی (TL;DR)';
---

<div class="mb-8 bg-linear-to-br from-primary/5 to-white border border-primary/20 p-6 rounded-2xl font-persian relative overflow-hidden">
  <div class="absolute -right-4 -top-4 w-16 h-16 bg-primary/10 rounded-full blur-xl"></div>
  
  <h2 class="text-xl font-bold mb-4 flex items-center gap-2 text-primary">
    <svg aria-hidden="true" class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
    {titleText}
  </h2>
  
  <ul class="space-y-3">
    {takeaways.map((item) => (
      <li class="flex items-start gap-2.5 text-gray-700 text-sm leading-relaxed">
        <div class="mt-1.5 bg-primary/10 text-primary p-0.5 rounded-full shrink-0">
          <svg aria-hidden="true" class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
        </div>
        <span>{item}</span>
      </li>
    ))}
  </ul>
</div>
