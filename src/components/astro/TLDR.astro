---
import { getDictionary } from '../../i18n/get-dictionary';
import { type SupportedLanguage } from '../../types/language';

interface Props {
  takeaways: string[];
  lang: SupportedLanguage;
}

const { takeaways, lang } = Astro.props;
const dictionary = await getDictionary(lang);

const titleText = dictionary.blog?.keyTakeaways || 'خلاصه و نکات کلیدی (TL;DR)';
---

<div
  class="relative mb-8 overflow-hidden rounded-2xl border border-primary/20 bg-linear-to-br from-primary/5 to-white p-6 font-persian dark:border-slate-800 dark:to-slate-900"
>
  <div class="absolute -top-4 -right-4 h-16 w-16 rounded-full bg-primary/10 blur-xl"></div>

  <h2 class="mb-4 flex items-center gap-2 text-xl font-bold text-primary">
    <svg
      aria-hidden="true"
      class="h-5 w-5 shrink-0"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      viewBox="0 0 24 24"
      ><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"
      ></path></svg
    >
    {titleText}
  </h2>

  <ul class="space-y-3">
    {
      takeaways.map((item) => (
        <li class="flex items-start gap-2.5 text-sm leading-relaxed text-gray-700 dark:text-gray-300">
          <div class="mt-1.5 shrink-0 rounded-full bg-primary/10 p-0.5 text-primary">
            <svg
              aria-hidden="true"
              class="h-3 w-3"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <span>{item}</span>
        </li>
      ))
    }
  </ul>
</div>
