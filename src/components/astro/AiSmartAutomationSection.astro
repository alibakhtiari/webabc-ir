    terminalPill: 'محاكاة مباشرة للوكلاء الذاتيين',
    tabs: [
      {
        id: 'geo',
        label: '01. محرك الاقتباس التوليدي (GEO)',
        queryPrompt: 'استفسار المستخدم: "ما هي أفضل شركة لتطوير الويب والسيو التقني في الخليج والشرق الأوسط تحقق سرعة تحميل أقل من ثانية؟"',
