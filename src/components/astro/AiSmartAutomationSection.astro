const t = copy[lang] || copy.en;
---

<section
  id="ai-smart-automation"
  class={`relative overflow-hidden bg-background py-16 md:py-24 ${fontClass}`}
  dir={isRtl ? 'rtl' : 'ltr'}
>
  <div class="container mx-auto px-4 md:px-6">
    <!-- Header -->
    <div class="mx-auto mb-14 max-w-4xl text-center">
      <div class="mb-3 flex flex-wrap items-center justify-center gap-2">
        <span class="inline-flex items-center rounded-full border border-primary/20 bg-primary/10 px-3.5 py-1 text-xs font-bold text-primary">
          {t.slashEyebrow}
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-xs font-bold text-emerald-600 dark:text-emerald-400">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          {t.telemetryBadge}
        </span>
      </div>

      <h2 class="mb-4 text-3xl font-extrabold tracking-tight text-balance text-gray-900 sm:text-4xl lg:text-5xl dark:text-white">
        {t.titlePrefix}
        <span class="text-primary">
          {t.titleHighlight}
        </span>
        {t.titleSuffix}
      </h2>

      <p class="mx-auto max-w-3xl text-base sm:text-lg leading-relaxed text-balance text-gray-600 dark:text-gray-300">
        {t.leadDescription}
      </p>
    </div>

    <!-- 3 Core Feature Pillars Grid -->
    <div class="mb-14 grid grid-cols-1 gap-6 lg:grid-cols-3">
      {
        t.pillars.map((pillar) => (
          <div class="group flex flex-col justify-between rounded-3xl border border-gray-100 bg-white p-7 shadow-lg transition-all duration-300 hover:-translate-y-1.5 hover:border-primary/30 hover:shadow-2xl dark:border-slate-800 dark:bg-slate-900 sm:p-8">
            <div>
              <div class="mb-4 flex items-center justify-between">
                <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-primary/10 text-xs font-bold text-primary">
                  {pillar.idx}
                </span>
                <span class="rounded-full border border-gray-200/80 bg-gray-50 px-2.5 py-0.5 text-[10px] font-semibold text-gray-600 dark:border-slate-700 dark:bg-slate-800 dark:text-gray-300">
                  {pillar.badge}
                </span>
              </div>

              <h3 class="mb-1 text-xl font-bold tracking-tight text-gray-900 dark:text-white">
                {pillar.title}
              </h3>

              <div class="mb-3 text-xs font-semibold text-primary sm:text-sm">
                {pillar.subtitle}
              </div>

              <p class="mb-6 text-xs leading-relaxed text-gray-600 dark:text-gray-300 sm:text-sm">
                {pillar.description}
              </p>

              <div class="mb-6 border-t border-gray-100 pt-4 dark:border-slate-800">
                <ul class="space-y-2.5">
                  {pillar.features.map((feature) => (
                    <li class="flex items-start gap-2 text-xs text-gray-700 dark:text-gray-300 sm:text-sm">
                      <svg class="h-4 w-4 shrink-0 text-emerald-500 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                      </svg>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="pt-2 border-t border-gray-100 dark:border-slate-800">
              <a
                href={pillar.toolHref}
                class="inline-flex items-center gap-1.5 text-xs font-bold text-primary transition-all hover:underline"
              >
                <span>{pillar.toolLabel}</span>
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Interactive Simulation Showcase -->
    <div class="mb-14 overflow-hidden rounded-3xl border border-gray-200/80 bg-white/95 shadow-xl backdrop-blur-xl dark:border-slate-800 dark:bg-slate-900/95" data-ai-terminal>
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-gray-100 bg-gray-50/80 px-6 py-3.5 dark:border-slate-800 dark:bg-slate-800/50">
        <div class="flex items-center gap-2.5">
          <span class="inline-block h-2.5 w-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-xs font-bold text-gray-900 dark:text-white">
            {t.terminalTitle}
          </span>
        </div>
        <div class="flex items-center gap-2">
          <span class="rounded-full border border-emerald-500/20 bg-emerald-500/10 px-2.5 py-0.5 text-[11px] font-bold text-emerald-600 dark:text-emerald-400">
            {t.terminalPill}
          </span>
        </div>
      </div>

      <!-- Tab Switcher Bar -->
      <div class="flex flex-wrap gap-2 border-b border-gray-100 bg-gray-50/40 p-3 dark:border-slate-800 dark:bg-slate-800/30">
        {
          t.tabs.map((tab, idx) => (
            <button
              type="button"
              data-target-tab={tab.id}
              aria-selected={idx === 0 ? 'true' : 'false'}
              class={`ai-tab-btn cursor-pointer rounded-xl px-4 py-2 text-xs font-bold transition-all ${
                idx === 0
                  ? 'is-active bg-primary text-primary-foreground shadow-sm'
                  : 'bg-white text-gray-700 hover:bg-gray-100 dark:bg-slate-800 dark:text-gray-300 dark:hover:bg-slate-700'
              }`}
            >
              {tab.label}
            </button>
          ))
        }
      </div>

      <!-- Tab Panels -->
      <div class="p-6 sm:p-8">
        {
          t.tabs.map((tab, idx) => (
            <div
              id={`tab-panel-${tab.id}`}
              class={`ai-tab-panel space-y-4 ${idx === 0 ? 'block' : 'hidden'}`}
            >
              <!-- Query Input Callout -->
              <div class="rounded-2xl border border-gray-200/80 bg-gray-50/80 p-4 dark:border-slate-700/80 dark:bg-slate-800/50">
                <div class="text-[11px] font-bold uppercase tracking-wider text-primary mb-1">
                  Query Context
                </div>
                <div class="text-xs sm:text-sm font-semibold text-gray-800 dark:text-gray-200">
                  {tab.queryPrompt}
                </div>
              </div>

              <!-- Synthesized Response -->
              <div class="rounded-2xl border border-primary/20 bg-primary/5 p-5 dark:border-primary/20 dark:bg-primary/10">
                <div class="text-[11px] font-bold uppercase tracking-wider text-primary mb-2">
                  {tab.responseTitle}
                </div>
                <div class="whitespace-pre-line text-xs sm:text-sm leading-relaxed text-gray-800 dark:text-gray-200">
                  {tab.responseBody}
                </div>
              </div>

              <!-- Live Status Pill -->
              <div class="flex items-center gap-2 pt-2">
                <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-xs font-bold text-emerald-600 dark:text-emerald-400">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                  {tab.status}
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Interactive Tools Strip -->
    <div class="mb-14">
      <div class="mx-auto mb-6 max-w-2xl text-center">
        <h3 class="text-lg font-bold text-gray-900 sm:text-xl dark:text-white">
          {t.toolsHeading}
        </h3>
        <p class="mt-1 text-xs text-gray-600 dark:text-gray-300">
          {t.toolsDescription}
        </p>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          t.tools.map((tool) => (
            <a
              href={linkPath(`/tools/${tool.slug}`)}
              class="group flex flex-col justify-between rounded-2xl border border-gray-100 bg-white p-5 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900"
            >
              <div>
                <div class="mb-3 flex items-center justify-between">
                  <span class="rounded-md border border-primary/20 bg-primary/5 px-2 py-0.5 text-[10px] font-bold text-primary">
                    {tool.badge}
                  </span>
                  <span class="text-xs text-gray-400 transition-transform group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5 group-hover:text-primary">
                    {isRtl ? '←' : '→'}
                  </span>
                </div>
                <h4 class="mb-1.5 text-sm font-bold text-gray-900 transition-colors group-hover:text-primary dark:text-white">
                  {tool.title}
                </h4>
                <p class="text-xs leading-relaxed text-gray-600 dark:text-gray-400">
                  {tool.desc}
                </p>
              </div>
            </a>
          ))
        }
      </div>
    </div>

    <!-- Conversion Banner -->
    <div class="rounded-3xl border border-primary/20 bg-linear-to-b from-primary/5 via-primary/10 to-transparent p-8 text-center sm:p-12 dark:border-slate-800 dark:from-slate-900 dark:via-primary/5 dark:to-slate-900">
      <div class="mx-auto max-w-2xl space-y-4">
        <h3 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl dark:text-white">
          {t.ctaTitle}
        </h3>
        <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-300">
          {t.ctaSubtitle}
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
          <button
            type="button"
            data-open-consultation
            class="inline-flex cursor-pointer items-center justify-center rounded-xl bg-primary px-6 py-3 text-sm font-bold text-primary-foreground shadow-md transition-all hover:bg-primary/95 hover:shadow-lg"
          >
            {t.ctaPrimary}
          </button>
          <a
            href={linkPath('/tools')}
            class="inline-flex items-center justify-center rounded-xl border border-gray-200 bg-white px-6 py-3 text-sm font-semibold text-gray-700 shadow-xs transition-all hover:border-primary/40 hover:text-primary dark:border-slate-800 dark:bg-slate-800 dark:text-gray-200"
          >
            {t.ctaSecondary}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupAiTerminal() {
    const terminals = document.querySelectorAll('[data-ai-terminal]');
    terminals.forEach((terminal) => {
      const buttons = terminal.querySelectorAll<HTMLButtonElement>('[data-target-tab]');
      const panels = terminal.querySelectorAll<HTMLElement>('.ai-tab-panel');

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetId = btn.getAttribute('data-target-tab');
          if (!targetId) return;

          buttons.forEach((b) => {
            b.classList.remove('is-active', 'bg-primary', 'text-primary-foreground', 'shadow-sm');
            b.classList.add('bg-white', 'text-gray-700', 'dark:bg-slate-800', 'dark:text-gray-300');
            b.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('is-active', 'bg-primary', 'text-primary-foreground', 'shadow-sm');
          btn.classList.remove('bg-white', 'text-gray-700', 'dark:bg-slate-800', 'dark:text-gray-300');
          btn.setAttribute('aria-selected', 'true');

          panels.forEach((p) => {
            if (p.id === `tab-panel-${targetId}`) {
              p.classList.remove('hidden');
              p.classList.add('block');
            } else {
              p.classList.remove('block');
              p.classList.add('hidden');
            }
          });
        });
      });
    });
  }

  setupAiTerminal();
  document.addEventListener('astro:page-load', setupAiTerminal);
</script>
