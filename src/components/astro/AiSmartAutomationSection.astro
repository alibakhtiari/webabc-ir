        badge: 'توقع CTR',
      },
      {
        slug: 'paa-scraper',
        title: 'أداة استخراج أسئلة الناس أيضاً (PAA)',
        desc: 'استكشاف نية البحث من جوجل وتوليد ملخصات المحتوى المتوافقة مع محركات الإجابة GEO.',
        badge: 'ملخصات GEO',
      },
      {
        slug: 'readability-checker',
        title: 'أداة فحص وضوح القراءة',
        desc: 'قياس درجات فليش-كينكيد وضمان أقصى درجات الوضوح وسهولة الاستيعاب البشري والآلي.',
        badge: 'وضوح النماذج',
      },
      {
        slug: 'keyword-density-analyzer',
        title: 'محلل كثافة الكلمات الدلالي',
        desc: 'تحليل البنية الدلالية وتوزيع الكيانات لتجنب عقوبات الإفراط في التحسين.',
        badge: 'توازن الكيانات',
      },
    ],

    ctaTitle: 'هل أنت جاهز لتصدر إجابات الذكاء الاصطناعي وأتمتة مؤسستك؟',
    ctaSubtitle:
      'تحدث مع مهندسي ويب إيه بي سي (ويب سي) لتأسيس حضور علامتك التجارية في Perplexity و ChatGPT، وتدشين وكلاء RAG مخصصين لشركتك.',
    ctaPrimary: 'حجز استشارة استراتيجية للذكاء الاصطناعي ←',
    ctaSecondary: 'استكشف 21 أداة سئو وتطوير مجانية',
  },
