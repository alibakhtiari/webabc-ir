---
import FAQ from '../astro/FAQ.astro';
import { type SupportedLanguage } from '../../types/language';
import { createTranslator } from '@/i18n/translate';

interface Props {
  lang: SupportedLanguage;
  dictionary: any;
}

const { lang, dictionary } = Astro.props;

const t = createTranslator(dictionary);

const faqList = [1, 2, 3, 4]
  .map((n) => ({
    question: t(`ecommerce.faq.q${n}`, ''),
    answer: t(`ecommerce.faq.a${n}`, ''),
  }))
  .filter((item) => item.question && item.answer);
---

<div class="space-y-16 py-8">
  <!-- What is E-commerce Web Design? -->
  <section class="bg-white dark:bg-slate-950">
    <div class="mx-auto max-w-4xl space-y-6 text-center">
      <h2 class="font-persian text-3xl font-bold text-gray-900 dark:text-white">
        {t('ecommerce.whatIs.title', 'What Is E-commerce Web Design?')}
      </h2>
      <div class="space-y-4 font-persian leading-relaxed text-gray-600 dark:text-gray-300">
        <p class="text-lg">{t('ecommerce.whatIs.p1', '')}</p>
        <p>{t('ecommerce.whatIs.p2', '')}</p>
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section
    class="rounded-3xl border border-gray-100 bg-gray-50/50 p-8 py-12 dark:border-slate-800 dark:bg-slate-900"
  >
    <div class="mx-auto max-w-6xl">
      <h2 class="mb-12 text-center font-persian text-3xl font-bold">
        {t('ecommerce.ourServices', 'E-commerce Offerings')}
      </h2>

      <div class="grid gap-8 md:grid-cols-2">
        <div
          class="rounded-2xl border border-gray-100 bg-white p-8 shadow-xs transition-shadow hover:shadow-md dark:border-slate-800/80 dark:bg-slate-900"
        >
          <div class="mb-6 text-primary">
            <svg
              aria-hidden="true"
              class="h-12 w-12"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path
                d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg
            >
          </div>
          <h3 class="mb-4 font-persian text-2xl font-bold">
            {t('ecommerce.storeSetup', 'Store Setup & Migration')}
          </h3>
          <p class="mb-6 font-persian text-gray-600 dark:text-gray-300">
            {t('ecommerce.storeSetupDesc', '')}
          </p>
          <div class="grid grid-cols-1 gap-3 font-persian text-sm">
            {
              ['productPages', 'payments', 'inventory'].map((feature) => (
                <div class="flex items-center gap-2">
                  <div class="h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
                  <span class="text-gray-700 dark:text-gray-200">
                    {t(`ecommerce.feature.${feature}`, feature)}
                  </span>
                </div>
              ))
            }
          </div>
        </div>

        <div
          class="rounded-2xl border border-gray-100 bg-white p-8 shadow-xs transition-shadow hover:shadow-md dark:border-slate-800/80 dark:bg-slate-900"
        >
          <div class="mb-6 text-primary">
            <svg
              aria-hidden="true"
              class="h-12 w-12"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline
                points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"
              ></polyline></svg
            >
          </div>
          <h3 class="mb-4 font-persian text-2xl font-bold">
            {t('ecommerce.customStorefronts', 'Custom Storefronts')}
          </h3>
          <p class="mb-6 font-persian text-gray-600 dark:text-gray-300">
            {t('ecommerce.customStorefrontsDesc', '')}
          </p>
          <div class="grid grid-cols-1 gap-3 font-persian text-sm">
            {
              ['checkout', 'mobile', 'schema'].map((feature) => (
                <div class="flex items-center gap-2">
                  <div class="h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
                  <span class="text-gray-700 dark:text-gray-200">
                    {t(`ecommerce.feature.${feature}`, feature)}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Platforms -->
  <section class="bg-white dark:bg-slate-950">
    <div class="mx-auto max-w-6xl text-center">
      <h2 class="mb-4 font-persian text-3xl font-bold">
        {t('ecommerce.platforms.title', 'Platforms We Build On')}
      </h2>
      <p class="mx-auto mb-12 max-w-2xl font-persian text-gray-600 dark:text-gray-300">
        {t('ecommerce.platforms.description', '')}
      </p>

      <div class="mx-auto grid max-w-5xl grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          [
            { name: 'Shopify', key: 'shopify' },
            { name: 'WooCommerce', key: 'woocommerce' },
            { name: 'Next.js Headless', key: 'nextHeadless' },
            { name: 'Astro Headless', key: 'astroHeadless' },
          ].map(({ name, key }) => (
            <div class="space-y-2 rounded-2xl border border-gray-100 bg-gray-50/50 p-6 text-center dark:border-slate-800 dark:bg-slate-900">
              <div class="font-bold text-gray-800 dark:text-gray-100">{name}</div>
              <p class="font-persian text-xs leading-relaxed text-gray-500 dark:text-gray-400">
                {t(`ecommerce.platforms.${key}`, '')}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Which Platform Is Right For You -->
  <section
    class="rounded-3xl border border-gray-100 bg-gray-50/50 py-16 dark:border-slate-800 dark:bg-slate-900"
  >
    <div class="mx-auto max-w-3xl space-y-4 px-4 text-center">
      <h2 class="font-persian text-2xl font-bold">
        {t('ecommerce.rightFor.title', 'Which Platform Is Right for You?')}
      </h2>
      <p class="font-persian leading-relaxed text-gray-600 dark:text-gray-300">
        {t('ecommerce.rightFor.text', '')}
      </p>
    </div>
  </section>

  <!-- FAQ Section -->
  {
    faqList.length > 0 && (
      <section class="mx-auto max-w-3xl">
        <FAQ faqList={faqList} lang={lang} />
      </section>
    )
  }
</div>
