---
import FAQ from '../astro/FAQ.astro';
import { type SupportedLanguage } from '@/types/language';
import { createTranslator } from '@/i18n/translate';

interface Props {
  lang: SupportedLanguage;
  dictionary: any;
}

const { lang, dictionary } = Astro.props;
const fontClass = lang === 'fa' ? 'font-persian' : lang === 'ar' ? 'font-arabic' : 'font-sans';

const t = createTranslator(dictionary);

const faqList = [1, 2, 3, 4]
  .map((n) => ({
    question: t(`ecommerce.faq.q${n}`, ''),
    answer: t(`ecommerce.faq.a${n}`, ''),
  }))
  .filter((item) => item.question && item.answer);

const quickAnswer =
  lang === 'fa'
    ? 'طراحی فروشگاه اینترنتی در وب اِی‌بی‌سی شامل ساخت ویترین‌های فروشگاهی سریع و موبایل‌محور روی ووکامرس، شاپیفای یا معماری هدلس Astro/Next.js همراه با تسویه‌حساب کم‌اصطکاک، اتصال درگاه‌های پرداخت داخلی و بین‌المللی، همگام‌سازی انبار و پیاده‌سازی اسکیمای Product برای کسب ورودی خریداران گوگل است.'
    : lang === 'ar'
      ? 'يشمل تصميم وتطوير المتاجر الإلكترونية في ويب إيه بي سي بناء منصات بيع سريعة ومهيأة للجوال على WooCommerce أو Shopify أو بنية Headless، مع تبسيط خطوات الدفع وربط البوابات الخليجية والمحلية والمخزون وتضمين بيانات Product المنظمة لتصدر نتائج التسوق في جوجل.'
      : 'WebABC e-commerce website design and development builds mobile-first online stores on WooCommerce, Shopify, or headless Astro/Next.js—combining frictionless checkouts, regional and global payment rails, automated inventory/ERP sync, and Product JSON-LD schema that earns rich merchant snippets in search.';

const ecomTable =
  lang === 'fa'
    ? {
        title: 'مقایسه پلتفرم‌های فروشگاهی برای انتخاب زیرساخت بهینه',
        headers: ['معیار تصمیم‌گیری', 'ووکامرس اختصاصی', 'شاپیفای (Shopify)', 'فروشگاه هدلس (Astro / Next.js)'],
        rows: [
          ['مناسب برای بازار هدف', 'ایران + چندزبانه منطقه‌ای', 'امارات، عمان، عربستان و بین‌الملل', 'برندهای پرترافیک و چندکشوری B2C/B2B'],
          ['درگاه‌های پرداخت', 'کلیه درگاه‌های شاپرک + ارزی', 'Stripe، Tabby، Tamara، PayPal', 'هر درگاه بانکی یا فین‌تک از طریق API'],
          ['سرعت بارگذاری موبایل', '۱.۲ تا ۱.۸ ثانیه (با بهینه‌سازی)', '۱.۵ تا ۲.۲ ثانیه', 'زیر ۰.۸ ثانیه در شبکه Edge'],
          ['اتصال به انبار و سپیدار/راهکاران', 'افزونه اختصاصی REST وب‌هوک', 'اپلیکیشن‌های میان‌افزار ابری', 'میان‌افزار مستقیم دوطرفه بدون تاخیر'],
        ],
      }
    : lang === 'ar'
      ? {
          title: 'مقارنة منصات التجارة الإلكترونية لاختيار البنية الأنسب',
          headers: ['معيار الاختيار', 'ووكومرس مخصص', 'شوبيفاي (Shopify)', 'بنية Headless (Astro / Next.js)'],
          rows: [
            ['السوق الأنسب', 'المتاجر الإقليمية والمرنة', 'دول الخليج والبيع الدولي السريع', 'العلامات الكبرى ومنصات B2B/B2C'],
            ['بوابات الدفع', 'جميع البوابات المحلية والإقليمية', 'Mada وApple Pay وTabby وTamara وStripe', 'ربط مخصص لأي بوابة عبر API'],
            ['سرعة الجوال', '1.2 إلى 1.8 ثانية (محسّن)', '1.5 إلى 2.2 ثانية', 'أقل من 0.8 ثانية عبر Edge'],
            ['الربط بالمخزون والمحاسبة', 'وحدة ربط REST مخصصة', 'تطبيقات الربط السحابي', 'مزامنة فورية ثنائية الاتجاه'],
          ],
        }
      : {
          title: 'E-Commerce Platform Comparison Matrix (2026)',
          headers: ['Decision Factor', 'Custom WooCommerce', 'Shopify / Shopify Plus', 'Headless (Astro / Next.js)'],
          rows: [
            ['Primary Market Fit', 'Full-ownership regional & hybrid B2B/B2C', 'GCC & global direct-to-consumer retail', 'High-SKU, multi-region & custom logic'],
            ['Payment Gateways', 'Local Shaparak + regional gateways', 'Stripe, Apple Pay, Mada, Tabby, Tamara', 'Any gateway or split-settlement API'],
            ['Mobile Load Speed (LCP)', '1.2s – 1.8s (hand-coded theme)', '1.5s – 2.2s', '< 0.8s edge-cached storefront'],
            ['ERP & Inventory Sync', 'Custom webhook/REST bridge', 'Managed app ecosystem', 'Direct event-driven ERP middleware'],
          ],
        };
---

<div class={`space-y-16 py-8 ${fontClass}`}>
  <!-- What is E-commerce Web Design? -->
  <section class="bg-white dark:bg-slate-950">
    <div class="mx-auto max-w-4xl space-y-6 text-center">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white">
        {t('ecommerce.whatIs.title', 'What Is E-commerce Web Design?')}
      </h2>
      <div class="space-y-4 leading-relaxed text-gray-600 dark:text-gray-300">
        <p class="text-lg">{t('ecommerce.whatIs.p1', '')}</p>
        <p>{t('ecommerce.whatIs.p2', '')}</p>
      </div>
    </div>
  </section>

  <!-- AEO Quick Answer Capsule -->
  <section class="mx-auto max-w-4xl px-4">
    <aside class="aeo-quick-answer rounded-2xl border-s-4 border-primary bg-primary/5 p-6 sm:p-8 dark:bg-slate-900/80">
      <div class="mb-2 text-xs font-bold uppercase tracking-wider text-primary">
        {lang === 'fa' ? 'خلاصه اجرایی طراحی فروشگاه اینترنتی (AEO)' : lang === 'ar' ? 'خلاصة تطوير المتاجر الإلكترونية (AEO)' : 'Quick Answer: E-Commerce Engineering (AEO)'}
      </div>
      <p class="text-base leading-relaxed font-medium text-gray-800 dark:text-gray-100">
        {quickAnswer}
      </p>
    </aside>
  </section>

  <!-- Services Grid -->
  <section
    class="rounded-3xl border border-gray-100 bg-gray-50/50 p-8 py-12 dark:border-slate-800 dark:bg-slate-900"
  >
    <div class="mx-auto max-w-7xl">
      <h2 class="mb-12 text-center text-3xl font-bold text-gray-900 dark:text-white">
        {t('ecommerce.ourServices', 'E-commerce Offerings')}
      </h2>

      <div class="grid gap-8 md:grid-cols-2">
        <div
          class="rounded-2xl border border-gray-100 bg-white p-8 shadow-xs transition-shadow hover:shadow-md dark:border-slate-800/80 dark:bg-slate-900"
        >
          <div class="mb-6 text-primary">
            <svg aria-hidden="true" class="h-12 w-12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
          </div>
          <h3 class="mb-4 text-2xl font-bold text-gray-900 dark:text-white">
            {t('ecommerce.storeSetup', 'Store Setup & Migration')}
          </h3>
          <p class="mb-6 text-gray-600 dark:text-gray-300">
            {t('ecommerce.storeSetupDesc', '')}
          </p>
          <div class="grid grid-cols-1 gap-3 text-sm">
            {
              ['productPages', 'payments', 'inventory'].map((feature) => (
                <div class="flex items-center gap-2">
                  <div class="h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
                  <span class="text-gray-700 dark:text-gray-200">
                    {t(`ecommerce.feature.${feature}`, feature)}
                  </span>
                </div>
              ))
            }
          </div>
        </div>

        <div
          class="rounded-2xl border border-gray-100 bg-white p-8 shadow-xs transition-shadow hover:shadow-md dark:border-slate-800/80 dark:bg-slate-900"
        >
          <div class="mb-6 text-primary">
            <svg aria-hidden="true" class="h-12 w-12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
          </div>
          <h3 class="mb-4 text-2xl font-bold text-gray-900 dark:text-white">
            {t('ecommerce.customStorefronts', 'Custom Storefronts')}
          </h3>
          <p class="mb-6 text-gray-600 dark:text-gray-300">
            {t('ecommerce.customStorefrontsDesc', '')}
          </p>
          <div class="grid grid-cols-1 gap-3 text-sm">
            {
              ['checkout', 'mobile', 'schema'].map((feature) => (
                <div class="flex items-center gap-2">
                  <div class="h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
                  <span class="text-gray-700 dark:text-gray-200">
                    {t(`ecommerce.feature.${feature}`, feature)}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Platform Comparison Matrix -->
  <section class="mx-auto max-w-6xl">
    <h2 class="mb-6 text-center text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white">
      {ecomTable.title}
    </h2>
    <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white shadow-xs dark:border-slate-800 dark:bg-slate-900">
      <table class="w-full border-collapse text-start text-sm">
        <thead>
          <tr class="border-b border-gray-200 bg-gray-50 dark:border-slate-800 dark:bg-slate-800/70">
            {ecomTable.headers.map((h) => (
              <th class="px-4 py-3.5 font-bold text-gray-900 dark:text-white">{h}</th>
            ))}
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-slate-800">
          {ecomTable.rows.map((r) => (
            <tr class="hover:bg-gray-50/60 dark:hover:bg-slate-800/40">
              <td class="px-4 py-3 font-semibold text-gray-900 dark:text-white">{r[0]}</td>
              <td class="px-4 py-3 text-gray-700 dark:text-gray-200">{r[1]}</td>
              <td class="px-4 py-3 text-gray-700 dark:text-gray-200">{r[2]}</td>
              <td class="px-4 py-3 font-medium text-primary">{r[3]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Platforms -->
  <section class="bg-white dark:bg-slate-950">
    <div class="mx-auto max-w-7xl text-center">
      <h2 class="mb-4 text-3xl font-bold text-gray-900 dark:text-white">
        {t('ecommerce.platforms.title', 'Platforms We Build On')}
      </h2>
      <p class="mx-auto mb-12 max-w-2xl text-gray-600 dark:text-gray-300">
        {t('ecommerce.platforms.description', '')}
      </p>

      <div class="mx-auto grid max-w-7xl grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          [
            { name: 'Shopify', key: 'shopify' },
            { name: 'WooCommerce', key: 'woocommerce' },
            { name: 'Next.js Headless', key: 'nextHeadless' },
            { name: 'Astro Headless', key: 'astroHeadless' },
          ].map(({ name, key }) => (
            <div class="space-y-2 rounded-2xl border border-gray-100 bg-gray-50/50 p-6 text-center dark:border-slate-800 dark:bg-slate-900">
              <div class="font-bold text-gray-800 dark:text-gray-100">{name}</div>
              <p class="text-xs leading-relaxed text-gray-500 dark:text-gray-400">
                {t(`ecommerce.platforms.${key}`, '')}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Verified E-Commerce Case Studies & Cost Guide -->
  <section class="mx-auto max-w-6xl space-y-10">
    <div class="rounded-3xl border border-gray-100 bg-gray-50/50 py-12 px-6 text-center dark:border-slate-800 dark:bg-slate-900">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
        {t('ecommerce.rightFor.title', 'Which Platform Is Right for You?')}
      </h2>
      <p class="mx-auto mt-4 max-w-3xl leading-relaxed text-gray-600 dark:text-gray-300">
        {t('ecommerce.rightFor.text', '')}
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      <a
        href={`/${lang}/portfolio/odyps/`}
        class="rounded-2xl border border-gray-200 bg-white p-6 transition-colors hover:border-primary/50 dark:border-slate-800 dark:bg-slate-900"
      >
        <div class="text-xs font-bold uppercase text-primary">ODYPS · +210% Organic</div>
        <h3 class="mt-1 text-lg font-bold text-gray-900 dark:text-white">
          {lang === 'fa' ? 'فروشگاه چندزبانه فرش دستباف ODYPS' : lang === 'ar' ? 'متجر أوديبس متعدد اللغات' : 'ODYPS Multilingual Luxury Store'}
        </h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
          {lang === 'fa' ? 'رشد +۲۱۰٪ ترافیک ارگانیک و امتیاز سرعت ۹۶ از ۱۰۰ در بازار عمان و اروپا.' : lang === 'ar' ? 'نمو عضوي +210% وسرعة 96/100 في أسواق عُمان وأوروبا.' : '+210% organic growth and 96/100 PageSpeed across Oman and European markets.'}
        </p>
      </a>

      <a
        href={`/${lang}/portfolio/zeytoun-masoud/`}
        class="rounded-2xl border border-gray-200 bg-white p-6 transition-colors hover:border-primary/50 dark:border-slate-800 dark:bg-slate-900"
      >
        <div class="text-xs font-bold uppercase text-primary">B2B + B2C Hybrid</div>
        <h3 class="mt-1 text-lg font-bold text-gray-900 dark:text-white">
          {lang === 'fa' ? 'فروشگاه خرده و عمده زیتون مسعود' : lang === 'ar' ? 'منصة زيتون مسعود للتجارة' : 'Zeytoun Masoud B2B/B2C Commerce'}
        </h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
          {lang === 'fa' ? 'ترکیب فروش آنلاین مصرف‌کننده با پورتال سفارش عمده رستوران‌ها.' : lang === 'ar' ? 'دمج مبيعات التجزئة مع بوابة طلبات الجملة للمطاعم.' : 'Unified retail storefront and wholesale restaurant ordering portal.'}
        </p>
      </a>

      <a
        href={`/${lang}/blog/ecommerce-web-design-guide-2026/`}
        class="rounded-2xl border border-gray-200 bg-white p-6 transition-colors hover:border-primary/50 dark:border-slate-800 dark:bg-slate-900"
      >
        <div class="text-xs font-bold uppercase text-primary">
          {lang === 'fa' ? 'راهنمای جامع ۲۰۲۶' : lang === 'ar' ? 'دليل المتاجر 2026' : '2026 Architecture Guide'}
        </div>
        <h3 class="mt-1 text-lg font-bold text-gray-900 dark:text-white">
          {lang === 'fa' ? 'راهنمای طراحی سایت فروشگاهی و افزایش نرخ خرید' : lang === 'ar' ? 'دليل تصميم المتاجر الإلكترونية ورفع التحويل' : 'E-Commerce Web Design & Checkout Guide'}
        </h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
          {lang === 'fa' ? 'اصول کاهش رهاسازی سبد خرید، سئوی صفحات محصول و انتخاب درگاه.' : lang === 'ar' ? 'تقليل التخلي عن السلة وتحسين سيو المنتجات والدفع.' : 'Checkout UX patterns, Product schema, and cart-abandonment fixes.'}
        </p>
      </a>
    </div>
  </section>

  <!-- FAQ Section -->
  {
    faqList.length > 0 && (
      <section class="mx-auto max-w-3xl">
        <FAQ faqList={faqList} lang={lang} emitWebPage={false} />
      </section>
    )
  }
</div>
