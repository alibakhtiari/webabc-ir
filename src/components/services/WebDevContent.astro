---
import FAQ from '../astro/FAQ.astro';
import { type SupportedLanguage } from '@/types/language';
import { createTranslator } from '@/i18n/translate';

interface Props {
  lang: SupportedLanguage;
  dictionary: any;
}

const { lang, dictionary } = Astro.props;
const isRtl = lang === 'fa' || lang === 'ar';
const fontClass = lang === 'fa' ? 'font-persian' : lang === 'ar' ? 'font-arabic' : 'font-sans';

const t = createTranslator(dictionary);

const faqList = [1, 2, 3, 4]
  .map((n) => ({
    question: t(`webDevelopmentServices.faq.q${n}`, ''),
    answer: t(`webDevelopmentServices.faq.a${n}`, ''),
  }))
  .filter((item) => item.question && item.answer);

const quickAnswer =
  lang === 'fa'
    ? 'توسعه وب اختصاصی وب اِی‌بی‌سی خدمتی مهندسی فول‌استک برای ساخت وب‌اپلیکیشن‌ها، پلتفرم‌های SaaS و پورتال‌های سازمانی با Astro، React، Next.js، Node.js و پایتون است که بدون وابستگی به افزونه‌های آماده، بارگذاری زیر یک ثانیه در شبکه لبه کلودفلر، امنیت سطح API و مالکیت کامل کد منبع را برای کسب‌وکارها تضمین می‌کند.'
    : lang === 'ar'
      ? 'تطوير الويب المخصص من ويب إيه بي سي هو خدمة هندسية متكاملة لبناء تطبيقات الويب ومنصات SaaS والبوابات المؤسسية باستخدام Astro وReact وNext.js وNode.js وPython، لتحقيق سرعة تحميل دون الثانية على شبكة Cloudflare Edge وأمان برمجي عالٍ وملكية كاملة للكود المصدري.'
      : 'WebABC custom web development engineers full-stack web applications, SaaS platforms, and B2B portals using Astro, React, Next.js, TypeScript, Node.js, and Python—delivering sub-second Cloudflare Edge rendering, clean REST/GraphQL API integrations, and full source-code ownership without third-party plugin bloat.';

const stackComparison =
  lang === 'fa'
    ? {
        title: 'مقایسه معماری توسعه وب اختصاصی با سیستم‌های آماده',
        headers: ['شاخص فنی', 'توسعه اختصاصی (Astro / Next.js)', 'وردپرس سفارشی', 'سایت‌سازهای آماده'],
        rows: [
          ['زمان بارگذاری (LCP)', 'زیر ۰.۸ ثانیه روی Edge', '۱.۲ تا ۲.۰ ثانیه (با کش بهینه)', '۲.۵ تا ۴.۵+ ثانیه'],
          ['پاسخگویی تعاملی (INP)', 'کمتر از ۱۰۰ میلی‌ثانیه', '۱۰۰ تا ۲۰۰ میلی‌ثانیه', 'اغلب بالای ۲۰۰ میلی‌ثانیه'],
          ['یکپارچه‌سازی ERP / API', 'دو طرفه نامحدود + صف رویداد', 'محدود به هوک‌های PHP/REST', 'بسیار محدود و بسته'],
          ['سطح حمله امنیتی', 'حداقلی (بدون افزونه عمومی)', 'نیازمند نگهداری منظم افزونه‌ها', 'وابسته به پلتفرم میزبان'],
          ['مالکیت کد و مقیاس‌پذیری', '۱۰۰٪ مالکیت کد منبع در Git', 'مالکیت قالب سفارشی', 'قفل‌شده در اشتراک ماهانه'],
        ],
      }
    : lang === 'ar'
      ? {
          title: 'مقارنة معمارية: التطوير المخصص مقابل الأنظمة الجاهزة',
          headers: ['المعيار التقني', 'برمجة مخصصة (Astro / Next.js)', 'ووردبريس مخصص', 'منصات السحب والإفلات'],
          rows: [
            ['سرعة التحميل (LCP)', 'أقل من 0.8 ثانية عبر Edge', '1.2 إلى 2.0 ثانية', '2.5 إلى 4.5+ ثانية'],
            ['استجابة التفاعل (INP)', 'أقل من 100 مللي ثانية', '100 إلى 200 مللي ثانية', 'غالباً فوق 200 مللي ثانية'],
            ['تكامل أنظمة ERP وAPI', 'ربط ثنائي غير محدود', 'مرتبط بواجهات ووردبريس', 'محدود ومغلق'],
            ['الأمان وتقليل الثغرات', 'أعلى أمان (دون إضافات خارجية)', 'يتطلب تحديثات دورية', 'يعتمد على المنصة المستضيفة'],
            ['ملكية الكود والتوسع', 'ملكية كاملة للكود المصدري Git', 'ملكية القالب المخصص', 'مقيد باشتراك المنصة'],
          ],
        }
      : {
          title: 'Architecture Comparison: Custom Engineering vs. CMS & Site Builders',
          headers: ['Engineering Metric', 'Custom Stack (Astro / Next.js)', 'Custom WordPress', 'SaaS Site Builders'],
          rows: [
            ['Largest Contentful Paint (LCP)', '< 0.8s on Cloudflare Edge', '1.2s – 2.0s (tuned cache)', '2.5s – 4.5s+'],
            ['Interaction to Next Paint (INP)', '< 100ms minimal JS hydration', '100ms – 200ms', 'Often > 200ms script load'],
            ['ERP, CRM & Custom API Sync', 'Native bi-directional + queues', 'Bounded by PHP/REST hooks', 'Restricted to preset apps'],
            ['Security Attack Surface', 'Minimal (zero public plugins)', 'Requires ongoing patch care', 'Vendor-controlled black box'],
            ['Code Ownership & Portability', '100% Git repo ownership', 'Full theme/database control', 'Locked into platform tier'],
          ],
        };
---

<div class={`space-y-16 py-8 ${fontClass}`}>
  <!-- What is Custom Web Development? -->
  <section class="bg-white dark:bg-slate-950">
    <div class="mx-auto max-w-4xl space-y-6 text-center">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white">
        {t('webDevelopmentServices.whatIs.title', 'What is Custom Web Development?')}
      </h2>
      <div class="space-y-4 leading-relaxed text-gray-600 dark:text-gray-300">
        <p class="text-lg">{t('webDevelopmentServices.whatIs.p1', '')}</p>
        <p>{t('webDevelopmentServices.whatIs.p2', '')}</p>
      </div>
    </div>
  </section>

  <!-- AEO Quick Answer Capsule -->
  <section class="mx-auto max-w-4xl px-4">
    <aside class="aeo-quick-answer rounded-2xl border-s-4 border-primary bg-primary/5 p-6 sm:p-8 dark:bg-slate-900/80">
      <div class="mb-2 text-xs font-bold uppercase tracking-wider text-primary">
        {lang === 'fa' ? 'خلاصه اجرایی مهندسی وب (AEO)' : lang === 'ar' ? 'الملخص الهندسي المباشر (AEO)' : 'Quick Answer: Engineering Scope (AEO)'}
      </div>
      <p class="text-base leading-relaxed font-medium text-gray-800 dark:text-gray-100">
        {quickAnswer}
      </p>
    </aside>
  </section>

  <!-- Services Grid Section -->
  <section
    class="rounded-3xl border border-gray-100 bg-gray-50/50 p-8 py-12 dark:border-slate-800 dark:bg-slate-900"
  >
    <div class="mx-auto max-w-7xl">
      <h2 class="mb-12 text-center text-3xl font-bold text-gray-900 dark:text-white">
        {t('webDevelopmentServices.ourServices', 'Development Offerings')}
      </h2>

      <div class="grid gap-8 md:grid-cols-2">
        <!-- Frontend Development -->
        <div
          class="rounded-2xl border border-gray-100 bg-white p-8 shadow-xs transition-shadow hover:shadow-md dark:border-slate-800/80 dark:bg-slate-900"
        >
          <div class="mb-6 text-primary">
            <svg
              aria-hidden="true"
              class="h-12 w-12"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line
                x1="3"
                y1="9"
                x2="21"
                y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg
            >
          </div>
          <h3 class="mb-4 text-2xl font-bold text-gray-900 dark:text-white">
            {t('webDevelopmentServices.frontendDev', 'Frontend Development')}
          </h3>
          <p class="mb-6 text-gray-600 dark:text-gray-300">
            {t('webDevelopmentServices.frontendDesc', '')}
          </p>
          <div class="grid grid-cols-2 gap-3 text-sm">
            {
              [
                'uiuxDesign',
                'reactNextjs',
                'responsiveDesign',
                'webVitals',
                'animations',
                'apiIntegration',
              ].map((feature) => (
                <div class="flex items-center gap-2">
                  <div class="h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
                  <span class="text-gray-700 dark:text-gray-200">
                    {t(`webDevelopmentServices.feature.${feature}`, feature)}
                  </span>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Backend Development -->
        <div
          class="rounded-2xl border border-gray-100 bg-white p-8 shadow-xs transition-shadow hover:shadow-md dark:border-slate-800/80 dark:bg-slate-900"
        >
          <div class="mb-6 text-primary">
            <svg
              aria-hidden="true"
              class="h-12 w-12"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect
                x="2"
                y="14"
                width="20"
                height="8"
                rx="2"
                ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line
                x1="6"
                y1="18"
                x2="6.01"
                y2="18"></line></svg
            >
          </div>
          <h3 class="mb-4 text-2xl font-bold text-gray-900 dark:text-white">
            {t('webDevelopmentServices.backendDev', 'Backend Development')}
          </h3>
          <p class="mb-6 text-gray-600 dark:text-gray-300">
            {t('webDevelopmentServices.backendDesc', '')}
          </p>
          <div class="grid grid-cols-2 gap-3 text-sm">
            {
              ['restApi', 'python', 'nodejs', 'database', 'auth', 'cloudIntegration'].map(
                (feature) => (
                  <div class="flex items-center gap-2">
                    <div class="h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
                    <span class="text-gray-700 dark:text-gray-200">
                      {t(`webDevelopmentServices.feature.${feature}`, feature)}
                    </span>
                  </div>
                )
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Architecture Comparison Table -->
  <section class="mx-auto max-w-6xl">
    <h2 class="mb-6 text-center text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white">
      {stackComparison.title}
    </h2>
    <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white shadow-xs dark:border-slate-800 dark:bg-slate-900">
      <table class="w-full border-collapse text-start text-sm">
        <thead>
          <tr class="border-b border-gray-200 bg-gray-50 dark:border-slate-800 dark:bg-slate-800/70">
            {stackComparison.headers.map((h) => (
              <th class="px-4 py-3.5 font-bold text-gray-900 dark:text-white">{h}</th>
            ))}
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-slate-800">
          {stackComparison.rows.map((r) => (
            <tr class="hover:bg-gray-50/60 dark:hover:bg-slate-800/40">
              <td class="px-4 py-3 font-semibold text-gray-900 dark:text-white">{r[0]}</td>
              <td class="px-4 py-3 font-medium text-primary">{r[1]}</td>
              <td class="px-4 py-3 text-gray-600 dark:text-gray-300">{r[2]}</td>
              <td class="px-4 py-3 text-gray-500 dark:text-gray-400">{r[3]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Technologies Section -->
  <section class="bg-white dark:bg-slate-950">
    <div class="mx-auto max-w-7xl">
      <h2 class="mb-4 text-center text-3xl font-bold text-gray-900 dark:text-white">
        {t('webDevelopmentServices.technologies.title', 'Our Tech Stack')}
      </h2>
      <p class="mx-auto mb-12 max-w-2xl text-center text-gray-600 dark:text-gray-300">
        {t('webDevelopmentServices.technologies.description', '')}
      </p>

      <div class="grid grid-cols-2 gap-6 md:grid-cols-4">
        {
          [
            {
              icon: 'Code2',
              key: 'frontend',
              items: ['Astro 7', 'React & Next.js', 'TypeScript', 'Tailwind CSS'],
            },
            { icon: 'Server', key: 'backend', items: ['Node.js', 'Python', 'Express / FastAPI', 'Cloudflare Workers'] },
            {
              icon: 'Database',
              key: 'database',
              items: ['PostgreSQL', 'MongoDB', 'Redis', 'MySQL / D1'],
            },
            { icon: 'Cloud', key: 'devops', items: ['Cloudflare Edge', 'Docker', 'GitHub CI/CD', 'AWS / Vercel'] },
          ].map((tech) => (
            <div class="rounded-2xl border border-gray-100 bg-gray-50/50 p-6 text-center dark:border-slate-800 dark:bg-slate-900">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-white text-primary shadow-xs dark:bg-slate-800">
                {tech.icon === 'Code2' && (
                  <svg aria-hidden="true" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <polyline points="16 18 22 12 16 6" />
                    <polyline points="8 6 2 12 8 18" />
                  </svg>
                )}
                {tech.icon === 'Server' && (
                  <svg aria-hidden="true" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="2" y="2" width="20" height="8" rx="2" ry="2" />
                    <rect x="2" y="14" width="20" height="8" rx="2" ry="2" />
                    <line x1="6" y1="6" x2="6.01" y2="6" />
                    <line x1="6" y1="18" x2="6.01" y2="18" />
                  </svg>
                )}
                {tech.icon === 'Database' && (
                  <svg aria-hidden="true" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <ellipse cx="12" cy="5" rx="9" ry="3" />
                    <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
                    <path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3" />
                  </svg>
                )}
                {tech.icon === 'Cloud' && (
                  <svg aria-hidden="true" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z" />
                  </svg>
                )}
              </div>
              <h3 class="mb-3 font-bold text-gray-900 dark:text-white">
                {t(`webDevelopmentServices.technologies.${tech.key}`, tech.key)}
              </h3>
              <ul class="space-y-1 text-sm text-gray-600 dark:text-gray-300">
                {tech.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="bg-white dark:bg-slate-950">
    <div class="mx-auto max-w-7xl">
      <div class="mb-12 text-center">
        <h2 class="mb-4 text-3xl font-bold text-gray-900 dark:text-white">
          {t('webDevelopmentServices.process.title', 'Execution Process')}
        </h2>
        <p class="mx-auto max-w-2xl text-gray-600 dark:text-gray-300">
          {t('webDevelopmentServices.process.description', '')}
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          [
            { icon: 'Code2', step: 1 },
            { icon: 'Layout', step: 2 },
            { icon: 'ShieldCheck', step: 3 },
            { icon: 'Rocket', step: 4 },
          ].map((item, index) => (
            <div class="relative">
              <div class="flex h-full flex-col items-center rounded-2xl border border-gray-100 bg-white p-6 text-center shadow-xs transition-shadow hover:shadow-md dark:border-slate-800 dark:bg-slate-900">
                <div class="mb-4 flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
                  {item.icon === 'Code2' && (
                    <svg aria-hidden="true" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <polyline points="16 18 22 12 16 6" />
                      <polyline points="8 6 2 12 8 18" />
                    </svg>
                  )}
                  {item.icon === 'Layout' && (
                    <svg aria-hidden="true" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                      <line x1="3" y1="9" x2="21" y2="9" />
                      <line x1="9" y1="21" x2="9" y2="9" />
                    </svg>
                  )}
                  {item.icon === 'ShieldCheck' && (
                    <svg aria-hidden="true" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                      <polyline points="9 11 11 13 15 9" />
                    </svg>
                  )}
                  {item.icon === 'Rocket' && (
                    <svg aria-hidden="true" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
                    </svg>
                  )}
                </div>
                <h3 class="mb-3 text-xl font-bold text-gray-900 dark:text-white">
                  {t(`webDevelopmentServices.process.step${item.step}.title`, `Step ${item.step}`)}
                </h3>
                <p class="text-sm leading-relaxed text-gray-500 dark:text-gray-400">
                  {t(`webDevelopmentServices.process.step${item.step}.desc`, '')}
                </p>
              </div>
              {index < 3 && (
                <div class="absolute top-1/2 -end-4 z-10 hidden -translate-y-1/2 transform lg:block">
                  <div class="h-0.5 w-8 bg-gray-200 dark:bg-slate-700" />
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Verified Case Studies & Planning Resources -->
  <section class="mx-auto max-w-7xl">
    <div class="grid gap-6 md:grid-cols-3">
      <a
        href={`/${lang}/portfolio/ramzarz-negaran/`}
        class="rounded-2xl border border-gray-200 bg-white p-6 transition-colors hover:border-primary/50 dark:border-slate-800 dark:bg-slate-900"
      >
        <div class="text-xs font-bold uppercase text-primary">
          {lang === 'fa' ? 'کیس‌استدی واقعی' : lang === 'ar' ? 'دراسة حالة' : 'Case Study · Fintech'}
        </div>
        <h3 class="mt-1 text-lg font-bold text-gray-900 dark:text-white">
          {lang === 'fa' ? 'پلتفرم رمزارز نگاران + ماشین‌حساب زنده' : lang === 'ar' ? 'منصة رمزارز نكاران وحاسبة الربحية' : 'Ramzarz Negaran Platform & Live Calculator'}
        </h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
          {lang === 'fa' ? 'رتبه ۱ گوگل در تجهیزات ماینینگ قانونی همراه با محاسبه‌گر لحظه‌ای درآمد.' : lang === 'ar' ? 'المرتبة الأولى في جوجل مع محرك حساب ربحية فوري.' : 'Rank #1 on Google with custom real-time profitability engineering.'}
        </p>
      </a>

      <a
        href={`/${lang}/blog/web-development-guide-2026/`}
        class="rounded-2xl border border-gray-200 bg-white p-6 transition-colors hover:border-primary/50 dark:border-slate-800 dark:bg-slate-900"
      >
        <div class="text-xs font-bold uppercase text-primary">
          {lang === 'fa' ? 'راهنمای معماری ۲۰۲۶' : lang === 'ar' ? 'دليل الهندسة 2026' : '2026 Engineering Guide'}
        </div>
        <h3 class="mt-1 text-lg font-bold text-gray-900 dark:text-white">
          {lang === 'fa' ? 'راهنمای جامع توسعه وب و انتخاب پیمانکار' : lang === 'ar' ? 'دليل تطوير الويب واختيار المورد التقني' : 'Complete Web Development & Vendor Guide'}
        </h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
          {lang === 'fa' ? 'بررسی مراحل اجرای پروژه از بریف فنی تا استقرار نهایی و تحویل کد.' : lang === 'ar' ? 'خطوات تنفيذ المشروع من التوصيف الفني حتى الإطلاق.' : 'Compare architectures, milestones, and technical acceptance criteria.'}
        </p>
      </a>

      <a
        href={`/${lang}/enterprise-automation/`}
        class="rounded-2xl border border-gray-200 bg-white p-6 transition-colors hover:border-primary/50 dark:border-slate-800 dark:bg-slate-900"
      >
        <div class="text-xs font-bold uppercase text-primary">
          {lang === 'fa' ? 'اتوماسیون سازمانی' : lang === 'ar' ? 'أتمتة المؤسسات' : 'Enterprise Systems'}
        </div>
        <h3 class="mt-1 text-lg font-bold text-gray-900 dark:text-white">
          {lang === 'fa' ? 'یکپارچه‌سازی اختصاصی ERP و CRM' : lang === 'ar' ? 'تكامل أنظمة ERP وCRM المخصص' : 'Custom ERP & CRM Middleware'}
        </h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
          {lang === 'fa' ? 'اتصال دوطرفه وب‌اپلیکیشن به سپیدار، راهکاران، زوهو و Salesforce.' : lang === 'ar' ? 'ربط ثنائي الاتجاه مع أنظمة المحاسبة والمخزون وبوابات الشركات.' : 'Bi-directional sync with Sepidar, Rahkaran, Zoho, Odoo, and Salesforce.'}
        </p>
      </a>
    </div>
  </section>

  <!-- FAQ Section -->
  {
    faqList.length > 0 && (
      <section class="mx-auto max-w-3xl">
        <FAQ faqList={faqList} lang={lang} emitWebPage={false} />
      </section>
    )
  }
</div>
