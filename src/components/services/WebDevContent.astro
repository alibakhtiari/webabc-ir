---
import FAQ from '../astro/FAQ.astro';
import { type SupportedLanguage } from '@/types/language';
import { createTranslator } from '@/i18n/translate';

interface Props {
  lang: SupportedLanguage;
  dictionary: any;
}

const { lang, dictionary } = Astro.props;

// Translate helpers
const t = createTranslator(dictionary);

const faqList = [1, 2, 3, 4]
  .map((n) => ({
    question: t(`webDevelopmentServices.faq.q${n}`, ''),
    answer: t(`webDevelopmentServices.faq.a${n}`, ''),
  }))
  .filter((item) => item.question && item.answer);
---

<div class="space-y-16 py-8">
  <!-- What is Custom Web Development? -->
  <section class="bg-white dark:bg-slate-950">
    <div class="mx-auto max-w-4xl space-y-6 text-center">
      <h2 class="font-persian text-3xl font-bold text-gray-900 dark:text-white">
        {t('webDevelopmentServices.whatIs.title', 'What is Custom Web Development?')}
      </h2>
      <div class="space-y-4 font-persian leading-relaxed text-gray-600 dark:text-gray-300">
        <p class="text-lg">{t('webDevelopmentServices.whatIs.p1', '')}</p>
        <p>{t('webDevelopmentServices.whatIs.p2', '')}</p>
      </div>
    </div>
  </section>

  <!-- Services Grid Section -->
  <section
    class="rounded-3xl border border-gray-100 bg-gray-50/50 p-8 py-12 dark:border-slate-800 dark:bg-slate-900"
  >
    <div class="mx-auto max-w-6xl">
      <h2 class="mb-12 text-center font-persian text-3xl font-bold">
        {t('webDevelopmentServices.ourServices', 'Development Offerings')}
      </h2>

      <div class="grid gap-8 md:grid-cols-2">
        <!-- Frontend Development -->
        <div
          class="rounded-2xl border border-gray-100 bg-white p-8 shadow-xs transition-shadow hover:shadow-md dark:border-slate-800/80 dark:bg-slate-900"
        >
          <div class="mb-6 text-primary">
            <svg
              aria-hidden="true"
              class="h-12 w-12"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line
                x1="3"
                y1="9"
                x2="21"
                y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg
            >
          </div>
          <h3 class="mb-4 font-persian text-2xl font-bold">
            {t('webDevelopmentServices.frontendDev', 'Frontend Development')}
          </h3>
          <p class="mb-6 font-persian text-gray-600 dark:text-gray-300">
            {t('webDevelopmentServices.frontendDesc', '')}
          </p>
          <div class="grid grid-cols-2 gap-3 font-persian text-sm">
            {
              [
                'uiuxDesign',
                'reactNextjs',
                'responsiveDesign',
                'webVitals',
                'animations',
                'apiIntegration',
              ].map((feature) => (
                <div class="flex items-center gap-2">
                  <div class="h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
                  <span class="text-gray-700 dark:text-gray-200">
                    {t(`webDevelopmentServices.feature.${feature}`, feature)}
                  </span>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Backend Development -->
        <div
          class="rounded-2xl border border-gray-100 bg-white p-8 shadow-xs transition-shadow hover:shadow-md dark:border-slate-800/80 dark:bg-slate-900"
        >
          <div class="mb-6 text-primary">
            <svg
              aria-hidden="true"
              class="h-12 w-12"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect
                x="2"
                y="14"
                width="20"
                height="8"
                rx="2"
                ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line
                x1="6"
                y1="18"
                x2="6.01"
                y2="18"></line></svg
            >
          </div>
          <h3 class="mb-4 font-persian text-2xl font-bold">
            {t('webDevelopmentServices.backendDev', 'Backend Development')}
          </h3>
          <p class="mb-6 font-persian text-gray-600 dark:text-gray-300">
            {t('webDevelopmentServices.backendDesc', '')}
          </p>
          <div class="grid grid-cols-2 gap-3 font-persian text-sm">
            {
              ['restApi', 'python', 'nodejs', 'database', 'auth', 'cloudIntegration'].map(
                (feature) => (
                  <div class="flex items-center gap-2">
                    <div class="h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
                    <span class="text-gray-700 dark:text-gray-200">
                      {t(`webDevelopmentServices.feature.${feature}`, feature)}
                    </span>
                  </div>
                )
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Technologies Section -->
  <section class="bg-white dark:bg-slate-950">
    <div class="mx-auto max-w-6xl">
      <h2 class="mb-4 text-center font-persian text-3xl font-bold">
        {t('webDevelopmentServices.technologies.title', 'Our Tech Stack')}
      </h2>
      <p class="mx-auto mb-12 max-w-2xl text-center font-persian text-gray-600 dark:text-gray-300">
        {t('webDevelopmentServices.technologies.description', '')}
      </p>

      <div class="grid grid-cols-2 gap-6 md:grid-cols-4">
        {
          [
            {
              icon: 'Code2',
              key: 'frontend',
              items: ['React', 'Next.js', 'TypeScript', 'Tailwind CSS'],
            },
            { icon: 'Server', key: 'backend', items: ['Node.js', 'Python', 'Express', 'Django'] },
            {
              icon: 'Database',
              key: 'database',
              items: ['MongoDB', 'PostgreSQL', 'Redis', 'MySQL'],
            },
            { icon: 'Cloud', key: 'devops', items: ['Docker', 'AWS', 'CI/CD', 'Vercel'] },
          ].map((tech) => (
            <div class="rounded-2xl border border-gray-100 bg-gray-50/50 p-6 text-center dark:border-slate-800 dark:bg-slate-900">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-white text-primary shadow-xs dark:bg-slate-800">
                {tech.icon === 'Code2' && (
                  <svg
                    aria-hidden="true"
                    class="h-6 w-6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <polyline points="16 18 22 12 16 6" />
                    <polyline points="8 6 2 12 8 18" />
                  </svg>
                )}
                {tech.icon === 'Server' && (
                  <svg
                    aria-hidden="true"
                    class="h-6 w-6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <rect x="2" y="2" width="20" height="8" rx="2" ry="2" />
                    <rect x="2" y="14" width="20" height="8" rx="2" ry="2" />
                    <line x1="6" y1="6" x2="6.01" y2="6" />
                    <line x1="6" y1="18" x2="6.01" y2="18" />
                  </svg>
                )}
                {tech.icon === 'Database' && (
                  <svg
                    aria-hidden="true"
                    class="h-6 w-6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <ellipse cx="12" cy="5" rx="9" ry="3" />
                    <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
                    <path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3" />
                  </svg>
                )}
                {tech.icon === 'Cloud' && (
                  <svg
                    aria-hidden="true"
                    class="h-6 w-6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z" />
                  </svg>
                )}
              </div>
              <h3 class="mb-3 font-persian font-bold text-gray-900 dark:text-white">
                {t(`webDevelopmentServices.technologies.${tech.key}`, tech.key)}
              </h3>
              <ul class="space-y-1 text-sm text-gray-600 dark:text-gray-300">
                {tech.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Industries Section -->
  <section class="rounded-3xl border border-primary/10 bg-primary/5 p-8 py-16">
    <div class="mx-auto max-w-6xl">
      <h2 class="mb-4 text-center font-persian text-3xl font-bold">
        {t('webDevelopmentServices.industries.title', 'Industries We Serve')}
      </h2>
      <p class="mx-auto mb-12 max-w-2xl text-center font-persian text-gray-600 dark:text-gray-300">
        {t('webDevelopmentServices.industries.description', '')}
      </p>

      <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-6">
        {
          [
            { icon: 'ShoppingCart', key: 'ecommerce' },
            { icon: 'Stethoscope', key: 'healthcare' },
            { icon: 'Briefcase', key: 'fintech' },
            { icon: 'GraduationCap', key: 'education' },
            { icon: 'Home', key: 'realEstate' },
            { icon: 'Plane', key: 'travel' },
          ].map((industry) => (
            <div class="flex min-h-27.5 flex-col items-center justify-center rounded-xl border border-gray-100 bg-white p-4 text-center shadow-xs transition-all hover:shadow-md dark:border-slate-800 dark:bg-slate-900">
              <div class="mb-2 text-primary">
                {industry.icon === 'ShoppingCart' && (
                  <svg
                    aria-hidden="true"
                    class="h-6 w-6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <circle cx="9" cy="21" r="1" />
                    <circle cx="20" cy="21" r="1" />
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                  </svg>
                )}
                {industry.icon === 'Stethoscope' && (
                  <svg
                    aria-hidden="true"
                    class="h-6 w-6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <circle cx="18" cy="5" r="3" />
                    <path d="M3 5h4v14H3zM10 5h5v5h-5zM10 14h11v5H10z" />
                  </svg>
                )}
                {industry.icon === 'Briefcase' && (
                  <svg
                    aria-hidden="true"
                    class="h-6 w-6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2" />
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                  </svg>
                )}
                {industry.icon === 'GraduationCap' && (
                  <svg
                    aria-hidden="true"
                    class="h-6 w-6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                    <path d="M6 12v5c0 2 2 3 6 3s6-1 6-3v-5" />
                  </svg>
                )}
                {industry.icon === 'Home' && (
                  <svg
                    aria-hidden="true"
                    class="h-6 w-6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                    <polyline points="9 22 9 12 15 12 15 22" />
                  </svg>
                )}
                {industry.icon === 'Plane' && (
                  <svg
                    aria-hidden="true"
                    class="h-6 w-6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path d="M21 16V8a2 2 0 0 0-2-2h-3L11 2H9v4L6 8H3a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h3l3 2v4h2l5-4h3a2 2 0 0 0 2-2z" />
                  </svg>
                )}
              </div>
              <span class="font-persian text-xs font-semibold text-gray-800 dark:text-gray-100">
                {t(`webDevelopmentServices.industries.${industry.key}`, industry.key)}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="bg-white dark:bg-slate-950">
    <div class="mx-auto max-w-6xl">
      <div class="mb-12 text-center">
        <h2 class="mb-4 font-persian text-3xl font-bold">
          {t('webDevelopmentServices.process.title', 'Execution Process')}
        </h2>
        <p class="mx-auto max-w-2xl font-persian text-gray-600 dark:text-gray-300">
          {t('webDevelopmentServices.process.description', '')}
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          [
            { icon: 'Code2', step: 1 },
            { icon: 'Layout', step: 2 },
            { icon: 'ShieldCheck', step: 3 },
            { icon: 'Rocket', step: 4 },
          ].map((item, index) => (
            <div class="relative">
              <div class="flex h-full flex-col items-center rounded-2xl border border-gray-100 bg-white p-6 text-center shadow-xs transition-all hover:shadow-md dark:border-slate-800 dark:bg-slate-900">
                <div class="mb-4 flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
                  {item.icon === 'Code2' && (
                    <svg
                      aria-hidden="true"
                      class="h-6 w-6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                    >
                      <polyline points="16 18 22 12 16 6" />
                      <polyline points="8 6 2 12 8 18" />
                    </svg>
                  )}
                  {item.icon === 'Layout' && (
                    <svg
                      aria-hidden="true"
                      class="h-6 w-6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                    >
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                      <line x1="3" y1="9" x2="21" y2="9" />
                      <line x1="9" y1="21" x2="9" y2="9" />
                    </svg>
                  )}
                  {item.icon === 'ShieldCheck' && (
                    <svg
                      aria-hidden="true"
                      class="h-6 w-6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                    >
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                      <polyline points="9 11 11 13 15 9" />
                    </svg>
                  )}
                  {item.icon === 'Rocket' && (
                    <svg
                      aria-hidden="true"
                      class="h-6 w-6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                    >
                      <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
                    </svg>
                  )}
                </div>
                <h3 class="mb-3 font-persian text-xl font-bold">
                  {t(`webDevelopmentServices.process.step${item.step}.title`, `Step ${item.step}`)}
                </h3>
                <p class="font-persian text-sm leading-relaxed text-gray-500 dark:text-gray-400">
                  {t(`webDevelopmentServices.process.step${item.step}.desc`, '')}
                </p>
              </div>
              {index < 3 && (
                <div class="absolute top-1/2 -right-4 z-10 hidden -translate-y-1/2 transform lg:block">
                  <div class="h-0.5 w-8 bg-gray-200" />
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  {
    faqList.length > 0 && (
      <section class="mx-auto max-w-3xl">
        <FAQ faqList={faqList} lang={lang} />
      </section>
    )
  }
</div>
