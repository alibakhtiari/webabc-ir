---
import FAQ from '../astro/FAQ.astro';
import { type SupportedLanguage } from '../../types/language';
import { createTranslator } from '@/i18n/translate';

interface Props {
  lang: SupportedLanguage;
  dictionary: any;
}

const { lang, dictionary } = Astro.props;

// Translate helpers
const t = createTranslator(dictionary);



const faqList = [1, 2, 3, 4]
  .map(n => ({
    question: t(`webDevelopmentServices.faq.q${n}`, ""),
    answer: t(`webDevelopmentServices.faq.a${n}`, "")
  }))
  .filter(item => item.question && item.answer);

---

<div class="space-y-16 py-8">
  
  <!-- What is Custom Web Development? -->
  <section class="bg-white">
    <div class="max-w-4xl mx-auto text-center space-y-6">
      <h2 class="text-3xl font-bold text-gray-900 font-persian">{t('webDevelopmentServices.whatIs.title', "What is Custom Web Development?")}</h2>
      <div class="text-gray-600 leading-relaxed font-persian space-y-4">
        <p class="text-lg">{t('webDevelopmentServices.whatIs.p1', "")}</p>
        <p>{t('webDevelopmentServices.whatIs.p2', "")}</p>
      </div>
    </div>
  </section>

  <!-- Services Grid Section -->
  <section class="py-12 bg-gray-50/50 rounded-3xl p-8 border border-gray-100">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold mb-12 text-center font-persian">
        {t('webDevelopmentServices.ourServices', "Development Offerings")}
      </h2>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- Frontend Development -->
        <div class="bg-white p-8 rounded-2xl shadow-xs border border-gray-100/80 hover:shadow-md transition-shadow">
          <div class="mb-6 text-primary">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
          </div>
          <h3 class="text-2xl font-bold mb-4 font-persian">
            {t('webDevelopmentServices.frontendDev', "Frontend Development")}
          </h3>
          <p class="text-gray-600 mb-6 font-persian">
            {t('webDevelopmentServices.frontendDesc', "")}
          </p>
          <div class="grid grid-cols-2 gap-3 font-persian text-sm">
            {['uiuxDesign', 'reactNextjs', 'responsiveDesign', 'webVitals', 'animations', 'apiIntegration'].map((feature) => (
              <div class="flex items-center gap-2">
                <div class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></div>
                <span class="text-gray-700">{t(`webDevelopmentServices.feature.${feature}`, feature)}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Backend Development -->
        <div class="bg-white p-8 rounded-2xl shadow-xs border border-gray-100/80 hover:shadow-md transition-shadow">
          <div class="mb-6 text-primary">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>
          </div>
          <h3 class="text-2xl font-bold mb-4 font-persian">
            {t('webDevelopmentServices.backendDev', "Backend Development")}
          </h3>
          <p class="text-gray-600 mb-6 font-persian">
            {t('webDevelopmentServices.backendDesc', "")}
          </p>
          <div class="grid grid-cols-2 gap-3 font-persian text-sm">
            {['restApi', 'python', 'nodejs', 'database', 'auth', 'cloudIntegration'].map((feature) => (
              <div class="flex items-center gap-2">
                <div class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></div>
                <span class="text-gray-700">{t(`webDevelopmentServices.feature.${feature}`, feature)}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Technologies Section -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold mb-4 text-center font-persian">{t('webDevelopmentServices.technologies.title', "Our Tech Stack")}</h2>
      <p class="text-gray-600 text-center mb-12 max-w-2xl mx-auto font-persian">{t('webDevelopmentServices.technologies.description', "")}</p>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {[
          { icon: 'Code2', key: 'frontend', items: ['React', 'Next.js', 'TypeScript', 'Tailwind CSS'] },
          { icon: 'Server', key: 'backend', items: ['Node.js', 'Python', 'Express', 'Django'] },
          { icon: 'Database', key: 'database', items: ['MongoDB', 'PostgreSQL', 'Redis', 'MySQL'] },
          { icon: 'Cloud', key: 'devops', items: ['Docker', 'AWS', 'CI/CD', 'Vercel'] }
        ].map((tech) => (
          <div class="bg-gray-50/50 p-6 rounded-2xl border border-gray-100 text-center">
            <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center text-primary mx-auto mb-4 shadow-xs">
              {tech.icon === 'Code2' && <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>}
              {tech.icon === 'Server' && <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>}
              {tech.icon === 'Database' && <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path><path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3"></path></svg>}
              {tech.icon === 'Cloud' && <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path></svg>}
            </div>
            <h3 class="font-bold text-gray-900 mb-3 font-persian">{t(`webDevelopmentServices.technologies.${tech.key}`, tech.key)}</h3>
            <ul class="text-sm text-gray-600 space-y-1">
              {tech.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Industries Section -->
  <section class="py-16 bg-primary/5 rounded-3xl p-8 border border-primary/10">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold mb-4 text-center font-persian">{t('webDevelopmentServices.industries.title', "Industries We Serve")}</h2>
      <p class="text-gray-600 text-center mb-12 max-w-2xl mx-auto font-persian">{t('webDevelopmentServices.industries.description', "")}</p>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        {[
          { icon: 'ShoppingCart', key: 'ecommerce' },
          { icon: 'Stethoscope', key: 'healthcare' },
          { icon: 'Briefcase', key: 'fintech' },
          { icon: 'GraduationCap', key: 'education' },
          { icon: 'Home', key: 'realEstate' },
          { icon: 'Plane', key: 'travel' }
        ].map((industry) => (
          <div class="bg-white p-4 rounded-xl text-center shadow-xs hover:shadow-md transition-all border border-gray-100 flex flex-col items-center justify-center min-h-[110px]">
            <div class="text-primary mb-2">
              {industry.icon === 'ShoppingCart' && <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>}
              {industry.icon === 'Stethoscope' && <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="18" cy="5" r="3"></circle><path d="M3 5h4v14H3zM10 5h5v5h-5zM10 14h11v5H10z"></path></svg>}
              {industry.icon === 'Briefcase' && <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>}
              {industry.icon === 'GraduationCap' && <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c0 2 2 3 6 3s6-1 6-3v-5"></path></svg>}
              {industry.icon === 'Home' && <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>}
              {industry.icon === 'Plane' && <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-2-2h-3L11 2H9v4L6 8H3a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h3l3 2v4h2l5-4h3a2 2 0 0 0 2-2z"></path></svg>}
            </div>
            <span class="font-semibold text-xs text-gray-800 font-persian">{t(`webDevelopmentServices.industries.${industry.key}`, industry.key)}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4 font-persian">{t('webDevelopmentServices.process.title', "Execution Process")}</h2>
        <p class="text-gray-600 max-w-2xl mx-auto font-persian">{t('webDevelopmentServices.process.description', "")}</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {[
          { icon: 'Code2', step: 1 },
          { icon: 'Layout', step: 2 },
          { icon: 'ShieldCheck', step: 3 },
          { icon: 'Rocket', step: 4 }
        ].map((item, index) => (
          <div class="relative">
            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-xs h-full hover:shadow-md transition-all flex flex-col items-center text-center">
              <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center text-primary mb-4 shrink-0">
                {item.icon === 'Code2' && <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>}
                {item.icon === 'Layout' && <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>}
                {item.icon === 'ShieldCheck' && <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 11 11 13 15 9"></polyline></svg>}
                {item.icon === 'Rocket' && <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"></path></svg>}
              </div>
              <h3 class="text-xl font-bold mb-3 font-persian">
                {t(`webDevelopmentServices.process.step${item.step}.title`, `Step ${item.step}`)}
              </h3>
              <p class="text-gray-500 text-sm leading-relaxed font-persian">
                {t(`webDevelopmentServices.process.step${item.step}.desc`, "")}
              </p>
            </div>
            {index < 3 && (
              <div class="hidden lg:block absolute top-1/2 -right-4 transform -translate-y-1/2 z-10">
                <div class="w-8 h-0.5 bg-gray-200"></div>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  {faqList.length > 0 && (
    <section class="max-w-3xl mx-auto">
      <FAQ faqList={faqList} lang={lang} />
    </section>
  )}
</div>
