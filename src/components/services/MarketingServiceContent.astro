---
import FAQ from '../astro/FAQ.astro';
import { type SupportedLanguage } from '@/types/language';
import { createTranslator } from '@/i18n/translate';

interface Props {
  slug: string;
  lang: SupportedLanguage;
  dictionary: any;
}

const { slug, lang, dictionary } = Astro.props;

// Translate helpers
const t = createTranslator(dictionary);

const ns = slug === 'content-creation' ? 'contentCreation' : 'linkBuilding';

const faqList = [1, 2, 3, 4]
  .map((n) => ({
    question: t(`${ns}.faq.q${n}`, ''),
    answer: t(`${ns}.faq.a${n}`, ''),
  }))
  .filter((item) => item.question && item.answer);

// Content features definitions
const contentCreationFeatures = [
  { key: 'blogging', icon: 'FileText', color: 'text-blue-500' },
  { key: 'copywriting', icon: 'PenTool', color: 'text-green-500' },
  { key: 'strategy', icon: 'BarChart', color: 'text-purple-500' },
  { key: 'social', icon: 'Share2', color: 'text-pink-500' },
  { key: 'email', icon: 'Mail', color: 'text-orange-500' },
  { key: 'editing', icon: 'Edit3', color: 'text-indigo-500' },
];

const linkBuildingFeatures = [
  { key: 'guestPosting', icon: 'Users', color: 'text-blue-500' },
  { key: 'brokenLink', icon: 'Link2', color: 'text-red-500' },
  { key: 'outreach', icon: 'Share2', color: 'text-green-500' },
  { key: 'unlinkedMentions', icon: 'Search', color: 'text-purple-500' },
  { key: 'authority', icon: 'TrendingUp', color: 'text-orange-500' },
  { key: 'audit', icon: 'Shield', color: 'text-indigo-500' },
];

const features = slug === 'content-creation' ? contentCreationFeatures : linkBuildingFeatures;
---

<div class="space-y-16 py-8">
  <!-- Intro Section -->
  <section class="bg-white dark:bg-slate-950">
    <div class="mx-auto max-w-4xl space-y-6 text-center">
      <h2 class="font-persian text-3xl font-bold">
        {t(`${ns}.intro.title`, 'What This Service Includes')}
      </h2>
      <p class="font-persian text-lg leading-relaxed text-gray-600 dark:text-gray-300">
        {t(`${ns}.intro.text`, '')}
      </p>
    </div>
  </section>

  <!-- Services Details -->
  <section class="bg-white dark:bg-slate-950">
    <div class="mx-auto max-w-6xl">
      <h2 class="mb-12 text-center font-persian text-3xl font-bold">
        {t(`${ns}.ourServices`, 'Our Services')}
      </h2>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          features.map(({ key, icon, color }) => (
            <div class="flex flex-col rounded-2xl border border-gray-100 bg-white p-6 shadow-xs transition-all hover:shadow-lg dark:border-slate-800 dark:bg-slate-900">
              <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-gray-50 text-primary dark:bg-slate-800">
                {icon === 'FileText' && (
                  <svg
                    aria-hidden="true"
                    class={`h-8 w-8 ${color}`}
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <line x1="16" y1="13" x2="8" y2="13" />
                    <line x1="16" y1="17" x2="8" y2="17" />
                  </svg>
                )}
                {icon === 'PenTool' && (
                  <svg
                    aria-hidden="true"
                    class={`h-8 w-8 ${color}`}
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  </svg>
                )}
                {icon === 'BarChart' && (
                  <svg
                    aria-hidden="true"
                    class={`h-8 w-8 ${color}`}
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <line x1="18" y1="20" x2="18" y2="10" />
                    <line x1="12" y1="20" x2="12" y2="4" />
                    <line x1="6" y1="20" x2="6" y2="14" />
                  </svg>
                )}
                {icon === 'Share2' && (
                  <svg
                    aria-hidden="true"
                    class={`h-8 w-8 ${color}`}
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <circle cx="18" cy="5" r="3" />
                    <circle cx="6" cy="12" r="3" />
                    <circle cx="18" cy="19" r="3" />
                    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
                    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
                  </svg>
                )}
                {icon === 'Mail' && (
                  <svg
                    aria-hidden="true"
                    class={`h-8 w-8 ${color}`}
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                    <polyline points="22,6 12,13 2,6" />
                  </svg>
                )}
                {icon === 'Edit3' && (
                  <svg
                    aria-hidden="true"
                    class={`h-8 w-8 ${color}`}
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path d="M12 20h9" />
                    <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                  </svg>
                )}
                {icon === 'Users' && (
                  <svg
                    aria-hidden="true"
                    class={`h-8 w-8 ${color}`}
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                  </svg>
                )}
                {icon === 'Link2' && (
                  <svg
                    aria-hidden="true"
                    class={`h-8 w-8 ${color}`}
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path d="M15 7h3a5 5 0 0 1 5 5 5 5 0 0 1-5 5h-3m-6 0H6a5 5 0 0 1-5-5 5 5 0 0 1 5-5h3" />
                    <line x1="8" y1="12" x2="16" y2="12" />
                  </svg>
                )}
                {icon === 'Search' && (
                  <svg
                    aria-hidden="true"
                    class={`h-8 w-8 ${color}`}
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                  </svg>
                )}
                {icon === 'TrendingUp' && (
                  <svg
                    aria-hidden="true"
                    class={`h-8 w-8 ${color}`}
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <polyline points="23 6 13.5 15.5 8.5 10.5 1 18" />
                    <polyline points="17 6 23 6 23 12" />
                  </svg>
                )}
                {icon === 'Shield' && (
                  <svg
                    aria-hidden="true"
                    class={`h-8 w-8 ${color}`}
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  </svg>
                )}
              </div>
              <h3 class="mb-3 font-persian text-xl font-bold">
                {t(`${ns}.features.${key}.title`, key)}
              </h3>
              <p class="grow font-persian text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                {t(`${ns}.features.${key}.description`, '')}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Process -->
  <section
    class="rounded-3xl border border-gray-100 bg-gray-50/50 p-8 py-16 dark:border-slate-800 dark:bg-slate-900"
  >
    <div class="mx-auto max-w-4xl">
      <h2 class="mb-12 text-center font-persian text-3xl font-bold">
        {t(`${ns}.process.title`, 'Our Process')}
      </h2>

      <div class="mx-auto max-w-2xl space-y-8">
        {
          [1, 2, 3, 4, 5].map((step) => (
            <div class="flex items-start gap-6 font-persian">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary text-xl font-bold text-primary-foreground shadow-xs">
                {step}
              </div>
              <div class="mt-1 space-y-1">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white">
                  {t(`${ns}.process.step${step}.title`, `Step ${step}`)}
                </h3>
                <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                  {t(`${ns}.process.step${step}.description`, '')}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  {
    faqList.length > 0 && (
      <section class="mx-auto max-w-3xl">
        <FAQ faqList={faqList} lang={lang} />
      </section>
    )
  }
</div>
