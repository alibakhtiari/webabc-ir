---
import FAQ from '../astro/FAQ.astro';
import { type SupportedLanguage } from '@/types/language';
import { createTranslator } from '@/i18n/translate';

interface Props {
  lang: SupportedLanguage;
  dictionary: any;
}

const { lang, dictionary } = Astro.props;

// Translate helpers
const t = createTranslator(dictionary);
const fontClass = lang === 'fa' ? 'font-persian' : lang === 'ar' ? 'font-arabic' : 'font-sans';

const faqList = [1, 2, 3, 4, 5]
  .map((n) => ({
    question: t(`localSeo.faq.q${n}`, ''),
    answer: t(`localSeo.faq.a${n}`, ''),
  }))
  .filter((item) => item.question && item.answer);

const pricingData = (dictionary?.localSeo as any)?.pricing;
const localProofData = (dictionary?.localSeo as any)?.localProof;
const rightForBullets = (dictionary?.localSeo as any)?.rightFor?.bullets || [];

const tiers = [
  {
    key: 'tier1',
    data: pricingData?.tier1,
    accent: 'blue',
  },
  {
    key: 'tier2',
    data: pricingData?.tier2,
    accent: 'primary',
    popular: true,
  },
  {
    key: 'tier3',
    data: pricingData?.tier3,
    accent: 'amber',
  },
];
---

<div class={`space-y-20 py-8 ${fontClass}`}>
  <!-- 1. What Is Local SEO -->
  <section class="bg-white dark:bg-slate-950">
    <div class="mx-auto max-w-4xl space-y-6 text-center">
      <div class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-4 py-1.5 text-xs font-semibold text-primary">
        <span>📍</span>
        <span>
          {lang === 'fa' ? 'تسلط بر نقشه و جستجوی شهری' : lang === 'ar' ? 'تصدر الخرائط والبحث الجغرافي' : 'Local Search & Map Dominance'}
        </span>
      </div>
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
        {t('localSeo.whatIs.title', 'What Are Local SEO Services and How Do They Work?')}
      </h2>
      <div class="space-y-4 text-base leading-relaxed text-gray-600 sm:text-lg dark:text-gray-300">
        <p>{t('localSeo.whatIs.p1', '')}</p>
        <p>{t('localSeo.whatIs.p2', '')}</p>
      </div>

      <!-- Quick Trust Badges -->
      <div class="pt-4 flex flex-wrap items-center justify-center gap-3 text-xs font-medium text-gray-700 dark:text-gray-300">
        <span class="rounded-lg border border-gray-200 bg-gray-50/80 px-3 py-1.5 dark:border-slate-800 dark:bg-slate-900">
          ✓ {lang === 'fa' ? 'بسته ۳تایی گوگل مپ (Google 3-Pack)' : lang === 'ar' ? 'حزمة خرائط جوجل الثلاثية' : 'Google Map 3-Pack'}
        </span>
        <span class="rounded-lg border border-gray-200 bg-gray-50/80 px-3 py-1.5 dark:border-slate-800 dark:bg-slate-900">
          ✓ {lang === 'fa' ? 'نقشه‌های نشان و بلد' : lang === 'ar' ? 'تطبيقات الملاحة الإقليمية' : 'Domestic Navigation Maps'}
        </span>
        <span class="rounded-lg border border-gray-200 bg-gray-50/80 px-3 py-1.5 dark:border-slate-800 dark:bg-slate-900">
          ✓ {lang === 'fa' ? 'انطباق ۱۰۰٪ استنادهای NAP' : lang === 'ar' ? 'تطابق بيانات NAP بنسبة 100%' : '100% Strict NAP Integrity'}
        </span>
        <span class="rounded-lg border border-gray-200 bg-gray-50/80 px-3 py-1.5 dark:border-slate-800 dark:bg-slate-900">
          ✓ {lang === 'fa' ? 'اسکیمای LocalBusiness' : lang === 'ar' ? 'بيانات LocalBusiness المنظمة' : 'LocalBusiness Schema'}
        </span>
      </div>
    </div>
  </section>

  <!-- 2. What Local SEO Includes (6 Core Pillars) -->
  <section class="bg-white dark:bg-slate-950">
    <div class="mx-auto max-w-6xl">
      <div class="mb-12 text-center">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
          {t('localSeo.features.title', 'What Does Local SEO Include?')}
        </h2>
        {
          pricingData?.subtitle && (
            <p class="mt-3 text-base text-gray-600 sm:text-lg dark:text-gray-300">
              {t('localSeo.features.subtitle', '')}
            </p>
          )
        }
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        <!-- Pillar 1: Technical Local Audit -->
        <div
          class="group rounded-2xl border border-transparent bg-blue-50/50 p-6 transition-all duration-300 hover:border-blue-100/50 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:border-blue-500/30"
        >
          <div
            class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-white text-blue-600 shadow-sm transition-transform group-hover:scale-110 dark:bg-slate-800"
          >
            <svg
              aria-hidden="true"
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
          </div>
          <h3 class="mb-3 text-xl font-bold text-gray-900 dark:text-white">
            {t('localSeo.feature.audit', 'Technical Local SEO Audit')}
          </h3>
          <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-300">
            {t('localSeo.feature.auditDesc', 'Auditing mobile speed, LocalBusiness schema, and geo-landing pages.')}
          </p>
        </div>

        <!-- Pillar 2: Google Business Profile (GBP) -->
        <div
          class="group rounded-2xl border border-transparent bg-emerald-50/50 p-6 transition-all duration-300 hover:border-emerald-100/50 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:border-emerald-500/30"
        >
          <div
            class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-white text-emerald-600 shadow-sm transition-transform group-hover:scale-110 dark:bg-slate-800"
          >
            <svg
              aria-hidden="true"
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </div>
          <h3 class="mb-3 text-xl font-bold text-gray-900 dark:text-white">
            {t('localSeo.feature.gmb', 'Google Business Profile (GBP)')}
          </h3>
          <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-300">
            {t('localSeo.feature.gmbDesc', 'Optimizing Google Business Profile categories, photos, and weekly posts.')}
          </p>
        </div>

        <!-- Pillar 3: Domestic Maps (Neshan & Balad) -->
        <div
          class="group rounded-2xl border border-transparent bg-indigo-50/50 p-6 transition-all duration-300 hover:border-indigo-100/50 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:border-indigo-500/30"
        >
          <div
            class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-white text-indigo-600 shadow-sm transition-transform group-hover:scale-110 dark:bg-slate-800"
          >
            <svg
              aria-hidden="true"
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
            </svg>
          </div>
          <h3 class="mb-3 text-xl font-bold text-gray-900 dark:text-white">
            {t('localSeo.feature.iranMaps', 'Navigation Maps (Neshan & Balad)')}
          </h3>
          <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-300">
            {t('localSeo.feature.iranMapsDesc', 'Registration and verification on leading regional navigation apps.')}
          </p>
        </div>

        <!-- Pillar 4: NAP Consistency & Local Citations -->
        <div
          class="group rounded-2xl border border-transparent bg-amber-50/50 p-6 transition-all duration-300 hover:border-amber-100/50 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:border-amber-500/30"
        >
          <div
            class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-white text-amber-600 shadow-sm transition-transform group-hover:scale-110 dark:bg-slate-800"
          >
            <svg
              aria-hidden="true"
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-12a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <h3 class="mb-3 text-xl font-bold text-gray-900 dark:text-white">
            {t('localSeo.feature.nap', 'NAP Consistency & Directory Citations')}
          </h3>
          <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-300">
            {t('localSeo.feature.napDesc', 'Building strict NAP consistency across trusted directories and trade registries.')}
          </p>
        </div>

        <!-- Pillar 5: Review & Reputation Management -->
        <div
          class="group rounded-2xl border border-transparent bg-rose-50/50 p-6 transition-all duration-300 hover:border-rose-100/50 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:border-rose-500/30"
        >
          <div
            class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-white text-rose-600 shadow-sm transition-transform group-hover:scale-110 dark:bg-slate-800"
          >
            <svg
              aria-hidden="true"
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </div>
          <h3 class="mb-3 text-xl font-bold text-gray-900 dark:text-white">
            {t('localSeo.feature.reviews', 'Review & Reputation Management')}
          </h3>
          <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-300">
            {t('localSeo.feature.reviewsDesc', 'Workflows for capturing 5-star reviews and professional customer responses.')}
          </p>
        </div>

        <!-- Pillar 6: Geo Keywords & 'Near Me' Search -->
        <div
          class="group rounded-2xl border border-transparent bg-purple-50/50 p-6 transition-all duration-300 hover:border-purple-100/50 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:border-purple-500/30"
        >
          <div
            class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-white text-purple-600 shadow-sm transition-transform group-hover:scale-110 dark:bg-slate-800"
          >
            <svg
              aria-hidden="true"
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
          <h3 class="mb-3 text-xl font-bold text-gray-900 dark:text-white">
            {t('localSeo.feature.nearMe', 'Geo-Targeted & Near Me Search')}
          </h3>
          <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-300">
            {t('localSeo.feature.nearMeDesc', 'Structuring content to capture high-intent city queries and urgent near-me searches.')}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Transparent Local SEO Price Band (Repo Facts) -->
  <section class="rounded-3xl border border-gray-100 bg-gray-50/60 p-8 py-16 dark:border-slate-800 dark:bg-slate-900/60">
    <div class="mx-auto max-w-6xl">
      <div class="mb-12 text-center">
        <div class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-3.5 py-1 text-xs font-bold text-emerald-700 dark:text-emerald-400">
          <span>💰</span>
          <span>{lang === 'fa' ? 'تعرفه مصوب و شفاف' : lang === 'ar' ? 'أسعار واضحة وموثقة' : 'Transparent Pricing'}</span>
        </div>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
          {t('localSeo.pricing.title', 'Transparent Local SEO Pricing & Packages (2026)')}
        </h2>
        {
          pricingData?.subtitle && (
            <p class="mt-3 text-base text-gray-600 sm:text-lg dark:text-gray-300">
              {pricingData.subtitle}
            </p>
          )
        }
        {
          pricingData?.note && (
            <p class="mx-auto mt-2 max-w-2xl text-xs text-gray-500 dark:text-gray-400">
              {pricingData.note}
            </p>
          )
        }
      </div>

      <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
        {
          tiers.map((tier) => {
            const data = tier.data;
            if (!data) return null;
            const isPopular = tier.popular;
            return (
              <div
                class={`relative flex flex-col rounded-3xl bg-white p-8 transition-all duration-300 dark:bg-slate-900 ${
                  isPopular
                    ? 'border-2 border-primary shadow-xl ring-2 ring-primary/20 dark:border-primary'
                    : 'border border-gray-100 shadow-sm hover:shadow-lg dark:border-slate-800'
                }`}
              >
                {isPopular && (
                  <div class="absolute -top-3.5 start-1/2 -translate-x-1/2 rounded-full bg-primary px-4 py-1 text-xs font-bold text-primary-foreground shadow-md">
                    {lang === 'fa' ? 'محبوب‌ترین پکیج رقابتی' : lang === 'ar' ? 'الباقة الأكثر طلباً' : 'Most Popular Retainer'}
                  </div>
                )}

                <div class="mb-6">
                  <h3 class="text-xl font-bold text-gray-900 dark:text-white">
                    {data.name}
                  </h3>
                  <p class="mt-2 text-xs leading-relaxed text-gray-500 dark:text-gray-400">
                    {data.desc}
                  </p>
                </div>

                <div class="mb-6 rounded-2xl bg-gray-50 p-4 dark:bg-slate-800/60">
                  <div class="text-2xl font-black text-gray-900 sm:text-3xl dark:text-white">
                    {data.price}
                  </div>
                  <div class="mt-1 text-xs font-medium text-gray-500 dark:text-gray-400">
                    {data.period} {data.usdPrice && `• ${data.usdPrice}`}
                  </div>
                </div>

                <div class="mb-8 grow">
                  <div class="mb-3 text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300">
                    {lang === 'fa' ? 'خروجی‌ها و اقدامات کلیدی:' : lang === 'ar' ? 'المخرجات والإجراءات الرئيسية:' : 'Key Deliverables:'}
                  </div>
                  <ul class="space-y-2.5 text-xs text-gray-600 dark:text-gray-300">
                    {Array.isArray(data.deliverables) &&
                      data.deliverables.map((item: string) => (
                        <li class="flex items-start gap-2">
                          <svg
                            aria-hidden="true"
                            class="h-4 w-4 shrink-0 text-emerald-600 dark:text-emerald-400"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            viewBox="0 0 24 24"
                          >
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                          </svg>
                          <span>{item}</span>
                        </li>
                      ))}
                  </ul>
                </div>

                <a
                  href={`/${lang}/contact/`}
                  class={`inline-flex w-full items-center justify-center rounded-xl py-3 text-sm font-bold transition-all ${
                    isPopular
                      ? 'bg-primary text-primary-foreground shadow-md hover:bg-primary/90'
                      : 'border border-gray-200 bg-white text-gray-800 hover:bg-gray-50 dark:border-slate-700 dark:bg-slate-800 dark:text-white dark:hover:bg-slate-700'
                  }`}
                >
                  {lang === 'fa' ? 'درخواست مشاوره و سفارش' : lang === 'ar' ? 'طلب استشارة وعقد' : 'Request Consultation'}
                </a>
              </div>
            );
          })
        }
      </div>

      <!-- Cross-Link to Full Pricing Guide -->
      <div class="mt-10 text-center">
        <a
          href={pricingData?.ctaUrl || `/${lang}/blog/seo-services-pricing-guide-2026/`}
          class="inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 text-sm font-bold text-gray-900 shadow-sm border border-gray-200 transition-all hover:border-primary hover:text-primary dark:border-slate-800 dark:bg-slate-900 dark:text-white dark:hover:text-primary"
        >
          <span>
            {t('localSeo.pricing.cta', 'View Comprehensive 2026 SEO Pricing Guide')}
          </span>
          <span class="text-primary transition-transform group-hover:translate-x-1" aria-hidden="true">
            {lang === 'en' ? '→' : '←'}
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- 4. Verifiable Regional Proof & Case Studies (Qazvin & Beyond) -->
  <section class="mx-auto max-w-6xl space-y-12">
    <div class="text-center">
      <div class="inline-flex items-center gap-1.5 rounded-full bg-blue-500/10 px-3.5 py-1 text-xs font-bold text-blue-700 dark:text-blue-400">
        <span>🏢</span>
        <span>{lang === 'fa' ? 'نتایج و سوابق اثبات‌شده' : lang === 'ar' ? 'نتائج مثبتة وموثقة' : 'Verifiable Local Track Record'}</span>
      </div>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
        {t('localSeo.localProof.title', 'Verifiable Regional Track Record: From Qazvin to Capital Hubs')}
      </h2>
      {
        localProofData?.subtitle && (
          <p class="mt-3 text-base text-gray-600 sm:text-lg dark:text-gray-300">
            {localProofData.subtitle}
          </p>
        )
      }
    </div>

    <!-- Verified Regional Proof Highlights Banner -->
    {
      localProofData?.points && Array.isArray(localProofData.points) && (
        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          {localProofData.points.map((point: any) => (
            <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900">
              <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
                📍
              </div>
              <h3 class="mb-2 text-lg font-bold text-gray-900 dark:text-white">
                {point.title}
              </h3>
              <p class="text-xs leading-relaxed text-gray-600 dark:text-gray-300">
                {point.desc}
              </p>
            </div>
          ))}
        </div>
      )
    }

    <!-- Case Studies Cards Grid (Frontmatter-Reconciled Data) -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        [
          {
            slug: 'mehromah-qazvin',
            title: lang === 'fa' ? 'مجتمع تجاری مهروماه قزوین' : lang === 'ar' ? 'مجمع مهروماه التجاري قزوين' : 'Mehromah Mall Qazvin',
            tag: lang === 'fa' ? 'رتبه ۱ گوگل مپ قزوین' : lang === 'ar' ? 'المرتبة 1 خرائط جوجل' : '#1 Google Maps Qazvin',
            desc: lang === 'fa'
              ? 'بزرگ‌ترین مرکز خرید و پارکینگ هوشمند قزوین با بیش از ۳۰۰ واحد تجاری و تصاحب رتبه ۱ جستجوهای مراکز تجاری'
              : lang === 'ar'
              ? 'أكبر مركز تسوق ومواقف ذكية في قزوين وتصدر نتائج البحث مع أكثر من 300 متجر تجاري'
              : 'Premier commercial retail & smart parking hub (+300 retail units) capturing top regional search visibility',
          },
          {
            slug: 'behrad-dc',
            title: lang === 'fa' ? 'کلینیک دندانپزشکی بهراد کرج' : lang === 'ar' ? 'عيادة بهراد لطب الأسنان كرج' : 'Behrad Dental Clinic Karaj',
            tag: lang === 'fa' ? '+۲۳۰٪ نوبت‌دهی آنلاین' : lang === 'ar' ? '+230% حجز المواعيد' : '+230% Online Appointments',
            desc: lang === 'fa'
              ? 'افزایش ۲۳۰ درصدی نوبت‌دهی آنلاین و تصدر نتایج دندانپزشکی در منطقه شاهین ویلا و البرز'
              : lang === 'ar'
              ? 'زيادة حجز المواعيد بنسبة 230% وتصدر نتائج البحث الطبي لطب الأسنان في كرج'
              : '230% surge in patient appointments through targeted geo-intent keyword dominance in Karaj',
          },
          {
            slug: 'tahami-clinic',
            title: lang === 'fa' ? 'کلینیک زیبایی تهامی تهران' : lang === 'ar' ? 'عيادة تهامي لجراحة التجميل طهران' : 'Tahami Aesthetic Clinic Tehran',
            tag: lang === 'fa' ? '+۳۴۰٪ ورودی ارگانیک' : lang === 'ar' ? '+340% زيارات عضوية' : '+340% Organic Search',
            desc: lang === 'fa'
              ? 'سئوی محلی تخصصی و تسلط بر جستجوهای جراحی زیبایی و درماتولوژی با رشد ۳۴۰ درصدی ورودی ارگانیک در تهران'
              : lang === 'ar'
              ? 'تصدر عبارات جراحة التجميل والجلدية عالية المنافسة مع نمو 340% في الزيارات العضوية بطهران'
              : 'Dominating competitive aesthetic and dermatology queries across Tehran with +340% organic traffic growth',
          },
        ].map((cs) => (
          <a
            href={`/${lang}/portfolio/${cs.slug}/`}
            class="group block rounded-2xl border border-gray-100 bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900"
          >
            <div class="mb-2">
              <span class="inline-block rounded-md bg-primary/10 px-2.5 py-1 text-xs font-semibold text-primary">
                {cs.tag}
              </span>
            </div>
            <h3 class="mb-2 text-lg font-bold text-gray-900 transition-colors group-hover:text-primary dark:text-white">
              {cs.title}
            </h3>
            <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-300">
              {cs.desc}
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- 5. Process Section -->
  <section
