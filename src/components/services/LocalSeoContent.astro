---
import FAQ from '../astro/FAQ.astro';
import { type SupportedLanguage } from '@/types/language';
import { createTranslator } from '@/i18n/translate';

interface Props {
  lang: SupportedLanguage;
  dictionary: any;
}

const { lang, dictionary } = Astro.props;

// Translate helpers
const t = createTranslator(dictionary);

const faqList = [1, 2, 3, 4]
  .map((n) => ({
    question: t(`localSeo.faq.q${n}`, ''),
    answer: t(`localSeo.faq.a${n}`, ''),
  }))
  .filter((item) => item.question && item.answer);
---

<div class="space-y-16 py-8">
  <!-- What Is Local SEO -->
  <section class="bg-white dark:bg-slate-950">
    <div class="mx-auto max-w-4xl space-y-6 text-center">
      <h2 class="font-persian text-3xl font-bold">
        {t('localSeo.whatIs.title', 'What Is Local SEO?')}
      </h2>
      <div class="space-y-4 font-persian leading-relaxed text-gray-600 dark:text-gray-300">
        <p class="text-lg">{t('localSeo.whatIs.p1', '')}</p>
        <p>{t('localSeo.whatIs.p2', '')}</p>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="bg-white dark:bg-slate-950">
    <div class="mx-auto max-w-6xl">
      <h2 class="mb-12 text-center font-persian text-3xl font-bold">
        {t('localSeo.features.title', 'Local SEO Solutions')}
      </h2>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        <!-- Card 1: GMB -->
        <div
          class="group rounded-2xl border border-transparent bg-blue-50/50 p-6 transition-all duration-300 hover:border-blue-100/50 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:border-blue-500/30"
        >
          <div
            class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-white text-blue-600 shadow-sm transition-transform group-hover:scale-110 dark:bg-slate-800"
          >
            <svg
              aria-hidden="true"
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"
              ></line><path
                d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
              ></path></svg
            >
          </div>
          <h3 class="mb-3 font-persian text-xl font-bold text-gray-900 dark:text-white">
            {t('localSeo.feature.gmb', 'Google Business Profile')}
          </h3>
          <p class="font-persian text-sm leading-relaxed text-gray-600 dark:text-gray-300">
            {
              t(
                'localSeo.feature.gmbDesc',
                'Claiming, optimizing, and keeping your Google Business Profile updated.'
              )
            }
          </p>
        </div>

        <!-- Card 2: Local Keywords -->
        <div
          class="group rounded-2xl border border-transparent bg-green-50/50 p-6 transition-all duration-300 hover:border-green-100/50 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:border-green-500/30"
        >
          <div
            class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-white text-green-600 shadow-sm transition-transform group-hover:scale-110 dark:bg-slate-800"
          >
            <svg
              aria-hidden="true"
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"
              ></circle><circle cx="12" cy="12" r="2"></circle></svg
            >
          </div>
          <h3 class="mb-3 font-persian text-xl font-bold text-gray-900 dark:text-white">
            {t('localSeo.feature.localKeywords', 'Local Keyword Targeting')}
          </h3>
          <p class="font-persian text-sm leading-relaxed text-gray-600 dark:text-gray-300">
            {
              t(
                'localSeo.feature.localKeywordsDesc',
                'Targeting local keywords that potential customers in your area search for.'
              )
            }
          </p>
        </div>

        <!-- Card 3: Near Me -->
        <div
          class="group rounded-2xl border border-transparent bg-purple-50/50 p-6 transition-all duration-300 hover:border-purple-100/50 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:border-purple-500/30"
        >
          <div
            class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-white text-purple-600 shadow-sm transition-transform group-hover:scale-110 dark:bg-slate-800"
          >
            <svg
              aria-hidden="true"
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"
              ></line></svg
            >
          </div>
          <h3 class="mb-3 font-persian text-xl font-bold text-gray-900 dark:text-white">
            {t('localSeo.feature.nearMe', 'Near Me Optimization')}
          </h3>
          <p class="font-persian text-sm leading-relaxed text-gray-600 dark:text-gray-300">
            {
              t(
                'localSeo.feature.nearMeDesc',
                "Structuring layout content to capture highly-relevant 'near me' search queries."
              )
            }
          </p>
        </div>

        <!-- Card 4: Local Links -->
        <div
          class="group rounded-2xl border border-transparent bg-amber-50/50 p-6 transition-all duration-300 hover:border-amber-100/50 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:border-amber-500/30"
        >
          <div
            class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-white text-amber-600 shadow-sm transition-transform group-hover:scale-110 dark:bg-slate-800"
          >
            <svg
              aria-hidden="true"
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path d="M21 10c0 7-9 13-9 13s-9-6-9-12a9 9 0 0 1 18 0z"></path><circle
                cx="12"
                cy="10"
                r="3"></circle></svg
            >
          </div>
          <h3 class="mb-3 font-persian text-xl font-bold text-gray-900 dark:text-white">
            {t('localSeo.feature.localLinks', 'Local Link Building')}
          </h3>
          <p class="font-persian text-sm leading-relaxed text-gray-600 dark:text-gray-300">
            {
              t(
                'localSeo.feature.localLinksDesc',
                'Earning high-quality backlinks from popular regional sites and directories.'
              )
            }
          </p>
        </div>

        <!-- Card 5: Reviews -->
        <div
          class="group rounded-2xl border border-transparent bg-rose-50/50 p-6 transition-all duration-300 hover:border-rose-100/50 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:border-rose-500/30"
        >
          <div
            class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-white text-rose-600 shadow-sm transition-transform group-hover:scale-110 dark:bg-slate-800"
          >
            <svg
              aria-hidden="true"
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline
                points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="21"
              ></line><polyline points="8 17 10 19 15 14"></polyline></svg
            >
          </div>
          <h3 class="mb-3 font-persian text-xl font-bold text-gray-900 dark:text-white">
            {t('localSeo.feature.reviews', 'Review Management')}
          </h3>
          <p class="font-persian text-sm leading-relaxed text-gray-600 dark:text-gray-300">
            {
              t(
                'localSeo.feature.reviewsDesc',
                'Strategies for gathering positive client reviews and professional responses.'
              )
            }
          </p>
        </div>

        <!-- Card 6: Reports -->
        <div
          class="group rounded-2xl border border-transparent bg-indigo-50/50 p-6 transition-all duration-300 hover:border-indigo-100/50 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:border-indigo-500/30"
        >
          <div
            class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-white text-indigo-600 shadow-sm transition-transform group-hover:scale-110 dark:bg-slate-800"
          >
            <svg
              aria-hidden="true"
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"
              ></line><line x1="6" y1="20" x2="6" y2="14"></line></svg
            >
          </div>
          <h3 class="mb-3 font-persian text-xl font-bold text-gray-900 dark:text-white">
            {t('localSeo.feature.localReports', 'Local Performance Reports')}
          </h3>
          <p class="font-persian text-sm leading-relaxed text-gray-600 dark:text-gray-300">
            {
              t(
                'localSeo.feature.localReportsDesc',
                'Clear details on rank growth, Google Maps traffic, and interactions.'
              )
            }
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section
    class="rounded-3xl border border-gray-100 bg-gray-50/50 p-8 py-16 dark:border-slate-800 dark:bg-slate-900"
  >
    <div class="mx-auto max-w-6xl">
      <h2 class="mb-12 text-center font-persian text-3xl font-bold">
        {t('localSeo.process.title', 'Our Execution Process')}
      </h2>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          [1, 2, 3, 4].map((step) => (
            <div class="group relative rounded-2xl border border-gray-100/80 bg-white p-8 transition-all hover:shadow-xl dark:border-slate-800 dark:bg-slate-900">
              <div class="absolute -top-4 -left-4 flex h-12 w-12 rotate-3 items-center justify-center rounded-xl bg-primary text-xl font-bold text-primary-foreground shadow-lg transition-transform group-hover:scale-110 group-hover:rotate-6">
                0{step}
              </div>
              <h3 class="mt-2 mb-4 font-persian text-xl font-bold text-gray-900 dark:text-white">
                {t(`localSeo.process.step${step}.title`, `Step ${step}`)}
              </h3>
              <p class="font-persian text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                {t(`localSeo.process.step${step}.desc`, '')}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Is This Right For You -->
  <section
    class="rounded-3xl border border-gray-100 bg-gray-50/50 py-16 dark:border-slate-800 dark:bg-slate-900"
  >
    <div class="mx-auto max-w-3xl space-y-4 px-4 text-center">
      <h2 class="font-persian text-2xl font-bold">
        {t('localSeo.rightFor.title', 'Is Local SEO Right for Your Business?')}
      </h2>
      <p class="font-persian leading-relaxed text-gray-600 dark:text-gray-300">
        {t('localSeo.rightFor.text', '')}
      </p>
    </div>
  </section>

  <!-- Target Service Areas Grid -->
  <section class="mx-auto max-w-6xl">
    <div class="mb-10 text-center">
      <h2 class="font-persian text-3xl font-bold text-gray-900 dark:text-white">
        {lang === 'fa' ? 'مناطق تحت پوشش سئو محلی' : lang === 'ar' ? 'المناطق والمدن المشمولة بالسيو المحلي' : 'Target Service Areas for Local SEO'}
      </h2>
      <p class="mt-3 font-persian text-gray-600 dark:text-gray-300">
        {lang === 'fa' 
          ? 'استراتژی‌های سئو شهری متناسب با قوانین نقشه، دایرکتوری‌های بومی و رفتار کاربران هر منطقه'
          : lang === 'ar'
          ? 'استراتيجيات متخصصة لتصدر حزمة الخرائط والنتائج المحلية في كبرى مدن الخليج والشرق الأوسط'
          : 'Tailored local search optimization for specific regional business hubs and municipal search algorithms'}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        [
          {
            slug: 'tehran',
            name: lang === 'fa' ? 'تهران' : lang === 'ar' ? 'طهران' : 'Tehran',
            desc: lang === 'fa' ? 'سئو محلی در پایتخت، تسلط بر جستجوهای مناطق ۲۲ گانه و نقشه گوگل' : lang === 'ar' ? 'سيو محلي متقدم للمؤسسات والشركات في العاصمة الإيرانية' : 'Local business dominance across Tehran districts & Google Maps Pack',
          },
          {
            slug: 'qazvin',
            name: lang === 'fa' ? 'قزوین' : lang === 'ar' ? 'قزوين' : 'Qazvin',
            desc: lang === 'fa' ? 'سئو شهرک‌های صنعتی، بازار سنتی و حضور در رتبه اول نشان و بلد با دفتر مرکزی قزوین' : lang === 'ar' ? 'سيو الأنشطة الصناعية والتجارية والمراكز التجارية في قزوين' : 'Industrial hub & retail SEO with on-site headquarters support in Qazvin',
          },
          {
            slug: 'dubai',
            name: lang === 'fa' ? 'دبی و امارات' : lang === 'ar' ? 'دبي والإمارات' : 'Dubai & UAE',
            desc: lang === 'fa' ? 'سئو دوزبانه انگلیسی/عربی، Google Maps و 2GIS در بازار فوق‌رقابتی امارات' : lang === 'ar' ? 'تصدر نتائج البحث في دبي والشارقة وخرائط جوجل والمنصات المحلية' : 'Bilingual English & Arabic Local SEO for the ultra-competitive UAE market',
          },
          {
            slug: 'muscat',
            name: lang === 'fa' ? 'مسقط و عمان' : lang === 'ar' ? 'مسقط وعُمان' : 'Muscat & Oman',
            desc: lang === 'fa' ? 'بهینه‌سازی دوزبانه برای شرکت‌ها و استارتاپ‌های فعال در سلطنت عمان' : lang === 'ar' ? 'حلول السيو المحلي للشركات والمتاجر الإلكترونية في سلطنة عمان' : 'High-intent localized search campaigns for businesses in Muscat & Oman',
          },
          {
            slug: 'riyadh',
            name: lang === 'fa' ? 'ریاض و عربستان' : lang === 'ar' ? 'الرياض والسعودية' : 'Riyadh & Saudi Arabia',
            desc: lang === 'fa' ? 'همگام با چشم‌انداز ۲۰۳۰ و جذب مشتریان بومی در پایتخت عربستان' : lang === 'ar' ? 'حزم السيو المحلي المتوافقة مع رؤية 2030 في الرياض والمملكة' : 'Vision 2030-aligned Local SEO strategies for businesses targeting Riyadh',
          },
          {
            slug: 'abu-dhabi',
            name: lang === 'fa' ? 'ابوظبی' : lang === 'ar' ? 'أبوظبي' : 'Abu Dhabi',
            desc: lang === 'fa' ? 'سئوی سازمانی و جذب مشتریان دولتی و تجاری در پایتخت امارات' : lang === 'ar' ? 'سيو قطاع الأعمال والمؤسسات الكبرى في العاصمة الإماراتية' : 'Enterprise local authority and commercial search rankings in Abu Dhabi',
          },
        ].map((loc) => (
          <a
            href={`/${lang}/service-areas/${loc.slug}/`}
            class="group block rounded-2xl border border-gray-100 bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900"
          >
            <div class="mb-3 flex items-center justify-between">
              <h3 class="font-persian text-xl font-bold text-gray-900 transition-colors group-hover:text-primary dark:text-white">
                {loc.name}
              </h3>
              <span class="text-primary transition-transform group-hover:translate-x-1">
                {lang === 'en' ? '→' : '←'}
              </span>
            </div>
            <p class="font-persian text-sm leading-relaxed text-gray-600 dark:text-gray-300">
              {loc.desc}
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Local Case Studies Grid -->
  <section class="mx-auto max-w-6xl">
    <div class="mb-10 text-center">
      <h2 class="font-persian text-3xl font-bold text-gray-900 dark:text-white">
        {lang === 'fa' ? 'مطالعات موردی و نتایج اثبات‌شده سئو محلی' : lang === 'ar' ? 'دراسات حالة ونتائج حقيقية في السيو المحلي' : 'Verified Local SEO Case Studies'}
      </h2>
      <p class="mt-3 font-persian text-gray-600 dark:text-gray-300">
        {lang === 'fa'
          ? 'چگونه مشتریان ما در صنایع مختلف به رتبه ۱ نتایج شهری و نقشه گوگل دست یافتند'
          : lang === 'ar'
          ? 'قصص نجاح عملائنا في تصدر نتائج الخرائط ومحركات البحث بمختلف القطاعات'
          : 'How our clients in healthcare, retail, and manufacturing captured #1 local rankings'}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        [
          {
            slug: 'mehromah-qazvin',
            title: lang === 'fa' ? 'مجتمع تجاری مهروماه قزوین' : lang === 'ar' ? 'مجمع مهروماه التجاري قزوين' : 'Mehromah Mall Qazvin',
            tag: lang === 'fa' ? 'رتبه ۱ گوگل مپ قزوین' : lang === 'ar' ? 'المرتبة 1 خرائط جوجل' : '#1 Google Maps Qazvin',
            desc: lang === 'fa' ? 'بزرگ‌ترین مرکز خرید و پارکینگ هوشمند قزوین با تصاحب رتبه اول جستجوهای مراکز تجاری' : lang === 'ar' ? 'أكبر مركز تسوق ومواقف ذكية في قزوين وتصدر نتائج البحث' : 'Premier commercial retail & smart parking hub capturing top regional search visibility',
          },
          {
            slug: 'behrad-dc',
            title: lang === 'fa' ? 'کلینیک دندانپزشکی بهراد کرج' : lang === 'ar' ? 'عيادة بهراد لطب الأسنان كرج' : 'Behrad Dental Clinic Karaj',
            tag: lang === 'fa' ? 'سئوی پزشکی و محلی' : lang === 'ar' ? 'سيو طبي ومحلي' : 'Medical Local SEO',
            desc: lang === 'fa' ? 'افزایش ۳۰۰ درصدی نوبت‌دهی آنلاین و تصدر نتایج دندانپزشکی در منطقه کرج' : lang === 'ar' ? 'زيادة حجز المواعيد بنسبة 300% وتصدر نتائج البحث الطبي في كرج' : '300% surge in patient appointments through targeted geo-intent keyword dominance',
          },
          {
            slug: 'tahami-clinic',
            title: lang === 'fa' ? 'کلینیک زیبایی تهامی تهران' : lang === 'ar' ? 'عيادة تهامي لجراحة التجميل طهران' : 'Tahami Aesthetic Clinic Tehran',
            tag: lang === 'fa' ? 'رتبه ۱ عبارات پررقابت تهران' : lang === 'ar' ? 'المرتبة 1 في طهران' : '#1 High-Intent Aesthetic Search',
            desc: lang === 'fa' ? 'سئوی محلی تخصصی و تسلط بر جستجوهای جراحی زیبایی و درماتولوژی در تهران' : lang === 'ar' ? 'تصدر عبارات جراحة التجميل والجلدية عالية المنافسة في طهران' : 'Dominating competitive aesthetic and dermatology queries across Tehran districts',
          },
        ].map((cs) => (
          <a
            href={`/${lang}/portfolio/${cs.slug}/`}
            class="group block rounded-2xl border border-gray-100 bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900"
          >
            <div class="mb-2">
              <span class="inline-block rounded-md bg-primary/10 px-2.5 py-1 text-xs font-semibold text-primary">
                {cs.tag}
              </span>
            </div>
            <h3 class="mb-2 font-persian text-lg font-bold text-gray-900 transition-colors group-hover:text-primary dark:text-white">
              {cs.title}
            </h3>
            <p class="font-persian text-sm leading-relaxed text-gray-600 dark:text-gray-300">
              {cs.desc}
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Strategic Guides & Pricing Benchmarks -->
  <section class="mx-auto max-w-6xl">
    <div class="mb-10 text-center">
      <h2 class="font-persian text-3xl font-bold text-gray-900 dark:text-white">
        {lang === 'fa' ? 'راهنماهای تحلیلی، استراتژی و تعرفه سئو' : lang === 'ar' ? 'أدلة السيو الاستراتيجية وجدول الأسعار' : 'Strategic SEO & Pricing Guides'}
      </h2>
      <p class="mt-3 font-persian text-gray-600 dark:text-gray-300">
        {lang === 'fa'
          ? 'بررسی عمیق هزینه‌ها، استانداردهای سئو محلی و تکنیک‌های برتر رتبه‌گیری در سال ۲۰۲۶'
          : lang === 'ar'
          ? 'تفاصيل أسعار باقات السيو واستراتيجيات تصدر الأسواق الإقليمية لعام 2026'
          : 'In-depth analysis of SEO retainers, local map ranking benchmarks, and ROI formulas'}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        [
          {
            slug: 'seo-services-pricing-guide-2026',
