---
import FAQ from '../astro/FAQ.astro';
import { type SupportedLanguage } from '../../types/language';
import { createTranslator } from '@/i18n/translate';

interface Props {
  lang: SupportedLanguage;
  dictionary: any;
}

const { lang, dictionary } = Astro.props;

// Translate helpers
const t = createTranslator(dictionary);



const faqList = [1, 2, 3, 4]
  .map(n => ({
    question: t(`wordpress.faq.q${n}`, ""),
    answer: t(`wordpress.faq.a${n}`, "")
  }))
  .filter(item => item.question && item.answer);
---

<div class="space-y-16 py-8">

  <!-- Intro Section -->
  <section class="bg-white">
    <div class="max-w-4xl mx-auto text-center space-y-6">
      <h2 class="text-3xl font-bold font-persian">{t('wordpress.introTitle', 'What Is Professional WordPress Development?')}</h2>
      <p class="text-gray-600 leading-relaxed font-persian text-lg">{t('wordpress.introText', '')}</p>
    </div>
  </section>

  <!-- Features Section -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-2 gap-8">
        <!-- Card 1: Custom Themes -->
        <div class="bg-white p-8 rounded-2xl shadow-xs border border-gray-100 hover:shadow-md transition-shadow">
          <div class="mb-6 text-primary">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
          </div>
          <h3 class="text-2xl font-bold mb-4 font-persian">{t('wordpress.customTheme', "Custom Themes")}</h3>
          <p class="text-gray-600 leading-relaxed font-persian">{t('wordpress.customThemeDesc', "")}</p>
        </div>

        <!-- Card 2: WooCommerce -->
        <div class="bg-white p-8 rounded-2xl shadow-xs border border-gray-100 hover:shadow-md transition-shadow">
          <div class="mb-6 text-primary">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
          </div>
          <h3 class="text-2xl font-bold mb-4 font-persian">{t('wordpress.woocommerce', "WooCommerce Setup")}</h3>
          <p class="text-gray-600 leading-relaxed font-persian">{t('wordpress.woocommerceDesc', "")}</p>
        </div>

        <!-- Card 3: Plugins -->
        <div class="bg-white p-8 rounded-2xl shadow-xs border border-gray-100 hover:shadow-md transition-shadow">
          <div class="mb-6 text-primary">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold mb-4 font-persian">{t('wordpress.pluginDev', "Plugin Development")}</h3>
          <p class="text-gray-600 leading-relaxed font-persian">{t('wordpress.pluginDevDesc', "")}</p>
        </div>

        <!-- Card 4: Responsive -->
        <div class="bg-white p-8 rounded-2xl shadow-xs border border-gray-100 hover:shadow-md transition-shadow">
          <div class="mb-6 text-primary">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>
          </div>
          <h3 class="text-2xl font-bold mb-4 font-persian">{t('wordpress.responsive', "Responsive Layout")}</h3>
          <p class="text-gray-600 leading-relaxed font-persian">{t('wordpress.responsiveDesc', "")}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="bg-gray-50/50 py-16 rounded-3xl border border-gray-100">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-12 font-persian">{t('wordpress.processTitle', 'Our WordPress Development Process')}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {[1, 2, 3, 4].map(n => (
          <div class="bg-white p-6 rounded-2xl shadow-xs border border-gray-100/80">
            <div class="w-9 h-9 rounded-full bg-primary/10 text-primary font-bold flex items-center justify-center mb-4">{n}</div>
            <h3 class="font-bold text-gray-800 mb-2 font-persian">{t(`wordpress.process${n}Title`, '')}</h3>
            <p class="text-sm text-gray-600 leading-relaxed font-persian">{t(`wordpress.process${n}Desc`, '')}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Is This Right For You Section -->
  <section class="bg-white">
    <div class="max-w-3xl mx-auto text-center space-y-4">
      <h2 class="text-2xl font-bold font-persian">{t('wordpress.rightForTitle', 'Is WordPress Right for Your Business?')}</h2>
      <p class="text-gray-600 leading-relaxed font-persian">{t('wordpress.rightForText', '')}</p>
    </div>
  </section>

  <!-- FAQ Section -->
  {faqList.length > 0 && (
    <section class="max-w-3xl mx-auto">
      <FAQ faqList={faqList} lang={lang} />
    </section>
  )}
</div>
