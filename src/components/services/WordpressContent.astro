---
import FAQ from '../astro/FAQ.astro';
import { type SupportedLanguage } from '@/types/language';
import { createTranslator } from '@/i18n/translate';

interface Props {
  lang: SupportedLanguage;
  dictionary: any;
}

const { lang, dictionary } = Astro.props;

// Translate helpers
const t = createTranslator(dictionary);

const faqList = [1, 2, 3, 4]
  .map((n) => ({
    question: t(`wordpress.faq.q${n}`, ''),
    answer: t(`wordpress.faq.a${n}`, ''),
  }))
  .filter((item) => item.question && item.answer);
---

<div class="space-y-16 py-8">
  <!-- Intro Section -->
  <section class="bg-white dark:bg-slate-950">
    <div class="mx-auto max-w-4xl space-y-6 text-center">
      <h2 class="font-persian text-3xl font-bold">
        {t('wordpress.introTitle', 'What Is Professional WordPress Development?')}
      </h2>
      <p class="font-persian text-lg leading-relaxed text-gray-600 dark:text-gray-300">
        {t('wordpress.introText', '')}
      </p>
    </div>
  </section>

  <!-- Features Section -->
  <section class="bg-white dark:bg-slate-950">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-8 md:grid-cols-2">
        <!-- Card 1: Custom Themes -->
        <div
          class="rounded-2xl border border-gray-100 bg-white p-8 shadow-xs transition-shadow hover:shadow-md dark:border-slate-800 dark:bg-slate-900"
        >
          <div class="mb-6 text-primary">
            <svg
              aria-hidden="true"
              class="h-12 w-12"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line
                x1="3"
                y1="9"
                x2="21"
                y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg
            >
          </div>
          <h3 class="mb-4 font-persian text-2xl font-bold">
            {t('wordpress.customTheme', 'Custom Themes')}
          </h3>
          <p class="font-persian leading-relaxed text-gray-600 dark:text-gray-300">
            {t('wordpress.customThemeDesc', '')}
          </p>
        </div>

        <!-- Card 2: WooCommerce -->
        <div
          class="rounded-2xl border border-gray-100 bg-white p-8 shadow-xs transition-shadow hover:shadow-md dark:border-slate-800 dark:bg-slate-900"
        >
          <div class="mb-6 text-primary">
            <svg
              aria-hidden="true"
              class="h-12 w-12"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path
                d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg
            >
          </div>
          <h3 class="mb-4 font-persian text-2xl font-bold">
            {t('wordpress.woocommerce', 'WooCommerce Setup')}
          </h3>
          <p class="font-persian leading-relaxed text-gray-600 dark:text-gray-300">
            {t('wordpress.woocommerceDesc', '')}
          </p>
        </div>

        <!-- Card 3: Plugins -->
        <div
          class="rounded-2xl border border-gray-100 bg-white p-8 shadow-xs transition-shadow hover:shadow-md dark:border-slate-800 dark:bg-slate-900"
        >
          <div class="mb-6 text-primary">
            <svg
              aria-hidden="true"
              class="h-12 w-12"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><circle cx="12" cy="12" r="3"></circle><path
                d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
              ></path></svg
            >
          </div>
          <h3 class="mb-4 font-persian text-2xl font-bold">
            {t('wordpress.pluginDev', 'Plugin Development')}
          </h3>
          <p class="font-persian leading-relaxed text-gray-600 dark:text-gray-300">
            {t('wordpress.pluginDevDesc', '')}
          </p>
        </div>

        <!-- Card 4: Responsive -->
        <div
          class="rounded-2xl border border-gray-100 bg-white p-8 shadow-xs transition-shadow hover:shadow-md dark:border-slate-800 dark:bg-slate-900"
        >
          <div class="mb-6 text-primary">
            <svg
              aria-hidden="true"
              class="h-12 w-12"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line
                x1="12"
                y1="18"
                x2="12.01"
                y2="18"></line></svg
            >
          </div>
          <h3 class="mb-4 font-persian text-2xl font-bold">
            {t('wordpress.responsive', 'Responsive Layout')}
          </h3>
          <p class="font-persian leading-relaxed text-gray-600 dark:text-gray-300">
            {t('wordpress.responsiveDesc', '')}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section
    class="rounded-3xl border border-gray-100 bg-gray-50/50 py-16 dark:border-slate-800 dark:bg-slate-900"
  >
    <div class="mx-auto max-w-5xl px-4">
      <h2 class="mb-12 text-center font-persian text-3xl font-bold">
        {t('wordpress.processTitle', 'Our WordPress Development Process')}
      </h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          [1, 2, 3, 4].map((n) => (
            <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-xs dark:border-slate-800/80 dark:bg-slate-900">
              <div class="mb-4 flex h-9 w-9 items-center justify-center rounded-full bg-primary/10 font-bold text-primary">
                {n}
              </div>
              <h3 class="mb-2 font-persian font-bold text-gray-800 dark:text-gray-100">
                {t(`wordpress.process${n}Title`, '')}
              </h3>
              <p class="font-persian text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                {t(`wordpress.process${n}Desc`, '')}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Is This Right For You Section -->
  <section class="bg-white dark:bg-slate-950">
    <div class="mx-auto max-w-3xl space-y-4 text-center">
      <h2 class="font-persian text-2xl font-bold">
        {t('wordpress.rightForTitle', 'Is WordPress Right for Your Business?')}
      </h2>
      <p class="font-persian leading-relaxed text-gray-600 dark:text-gray-300">
        {t('wordpress.rightForText', '')}
      </p>
    </div>
  </section>

  <!-- FAQ Section -->
  {
    faqList.length > 0 && (
      <section class="mx-auto max-w-3xl">
        <FAQ faqList={faqList} lang={lang} />
      </section>
    )
  }
</div>
