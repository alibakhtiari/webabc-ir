---
import FAQ from '../astro/FAQ.astro';
import { type SupportedLanguage } from '@/types/language';
import { createTranslator } from '@/i18n/translate';

interface Props {
  slug: string;
  lang: SupportedLanguage;
  dictionary: any;
}

const { slug, lang, dictionary } = Astro.props;
const fontClass = lang === 'fa' ? 'font-persian' : lang === 'ar' ? 'font-arabic' : 'font-sans';

const t = createTranslator(dictionary);

const slugNamespaceMap: Record<string, string> = {
  'speed-optimization': 'speedOptimization',
  'ui-ux-audit': 'uiUxAudit',
  'website-maintenance': 'maintenance',
};

const ns = slugNamespaceMap[slug] || 'services';

const features = [0, 1, 2, 3, 4].map((idx) => t(`${ns}.features.${idx}`, `Feature ${idx + 1}`));

const benefits = [0, 1, 2, 3].map((idx) => ({
  title: t(`${ns}.benefits.${idx}.title`, `Benefit ${idx + 1}`),
  description: t(`${ns}.benefits.${idx}.description`, ''),
}));

const processes = [0, 1, 2, 3].map((idx) => ({
  title: t(`${ns}.process.${idx}.title`, `Step ${idx + 1}`),
  description: t(`${ns}.process.${idx}.description`, ''),
}));

const faqList = [1, 2, 3, 4]
  .map((idx) => ({
    question: t(`${ns}.faq.q${idx}`, ''),
    answer: t(`${ns}.faq.a${idx}`, ''),
  }))
  .filter((item) => item.question && item.answer);

const colorThemes: Record<
  string,
  { bg: string; text: string; iconColor: string; border: string; headerText: string }
> = {
  'speed-optimization': {
    bg: 'bg-orange-600',
    text: 'text-orange-600',
    iconColor: 'text-orange-500',
    border: 'border-orange-100',
    headerText: 'text-orange-600 dark:text-orange-400',
  },
  'ui-ux-audit': {
    bg: 'bg-indigo-600',
    text: 'text-indigo-600',
    iconColor: 'text-indigo-500',
    border: 'border-indigo-100',
    headerText: 'text-indigo-600 dark:text-indigo-400',
  },
  'website-maintenance': {
    bg: 'bg-cyan-600',
    text: 'text-cyan-600',
    iconColor: 'text-cyan-500',
    border: 'border-cyan-100',
    headerText: 'text-cyan-700 dark:text-cyan-400',
  },
};

const theme = colorThemes[slug] || colorThemes['website-maintenance'];

const quickAnswer =
  slug === 'speed-optimization'
    ? lang === 'fa'
      ? 'خدمات افزایش سرعت سایت و بهینه‌سازی Core Web Vitals وب اِی‌بی‌سی با ثبت خط مبنای آزمایشگاهی و میدانی، منشأ دقیق کندی در LCP، INP و CLS را در وردپرس، ووکامرس یا وب‌اپلیکیشن‌های اختصاصی برطرف کرده و قیمت بهینه سازی سرعت سایت را به‌صورت شفاف بر اساس صفحات و گلوگاه‌های واقعی تعیین می‌کند.'
      : lang === 'ar'
        ? 'تعمل خدمة تحسين سرعة الموقع ومؤشرات Core Web Vitals في ويب إيه بي سي على قياس خط الأساس الميداني والمختبري، ومعالجة اختناقات LCP وINP وCLS في مواقع ووردبريس والمتاجر والمنصات المخصصة، مع تسعير شفاف وإعادة فحص موثقة بعد النشر.'
        : 'WebABC website speed optimization diagnoses and fixes Largest Contentful Paint (LCP), Interaction to Next Paint (INP), and Cumulative Layout Shift (CLS) bottlenecks across WordPress, WooCommerce, and custom web apps—benchmarking affected templates before and after deployment against Google Core Web Vitals thresholds.'
    : slug === 'ui-ux-audit'
      ? lang === 'fa'
        ? 'ممیزی تخصصی UI/UX وب اِی‌بی‌سی یک ارزیابی ساختاریافته از قیف خرید، سلسله‌مراتب بصری، تجربه موبایل و استانداردهای دسترس‌پذیری WCAG 2.2 است که گلوگاه‌های افت نرخ تبدیل را شناسایی کرده و فهرست اولویت‌بندی‌شده اصلاحات طراحی و فنی را تحویل می‌دهد.'
        : lang === 'ar'
          ? 'يقدّم تدقيق UI/UX التخصصي من ويب إيه بي سي فحصاً منهجياً لمسار الشراء والتسلسل البصري وتجربة الجوال ومعايير الوصول WCAG 2.2، لاكتشاف نقاط تسرب العملاء وتقديم خارطة إصلاحات مرتبة حسب الأثر على معدل التحويل.'
          : 'WebABC UI/UX diagnostic audits evaluate conversion funnels, mobile touch ergonomics, visual hierarchy, and WCAG 2.2 accessibility compliance on your live product—delivering a prioritized engineering and design backlog that removes checkout and signup friction.'
      : lang === 'fa'
        ? 'خدمات پشتیبانی، نگهداری و امنیت وب‌سایت وب اِی‌بی‌سی شامل بکاپ‌گیری خودکار ابری خارج از سرور، پایش ۲۴/۷ دسترس‌پذیری، به‌روزرسانی آزمایش‌شده هسته و افزونه‌ها در محیط استیجینگ، فایروال لبه و رفع فوری خطاهای فنی برای حفظ پایداری مداوم کسب‌وکار شماست.'
        : lang === 'ar'
          ? 'تشمل باقات صيانة وأمان المواقع من ويب إيه بي سي النسخ الاحتياطي السحابي التلقائي، ومراقبة التوافر على مدار الساعة، وتحديثات النظام والإضافات عبر بيئة تجريبية آمنة، وتحصين جدار الحماية لضمان استقرار موقعك وحمايته المستمرة.'
          : 'WebABC website maintenance and security care plans provide automated off-site backups, 24/7 uptime monitoring, staging-verified CMS and dependency updates, WAF hardening, and proactive Core Web Vitals checks so your site stays fast and protected year-round.';

const benchmarkTable =
  slug === 'speed-optimization'
    ? lang === 'fa'
      ? {
          title: 'معیارهای استاندارد گوگل (Core Web Vitals) و محدوده بهینه‌سازی',
          headers: ['شاخص کلیدی', 'آستانه سبز گوگل', 'اقدامات فنی ما در پروژه افزایش سرعت'],
          rows: [
            ['LCP (بارگذاری بزرگ‌ترین عنصر)', '≤ ۲.۵ ثانیه', 'تبدیل AVIF/WebP، پیش‌بارگذاری تصویر شاخص، کش لبه و کاهش TTFB سرور'],
            ['INP (پاسخگویی به تعامل کاربر)', '≤ ۲۰۰ میلی‌ثانیه', 'حذف جاوااسکریپت مسدودکننده، شکستن وظایف طولانی ترد اصلی و بهینه‌سازی هندلرها'],
            ['CLS (پایداری چیدمان بصری)', '≤ ۰.۱', 'تعیین ابعاد صریح رسانه‌ها، فونت‌های خودمیزبان swap و رزرو فضای بنرها'],
          ],
        }
      : lang === 'ar'
        ? {
            title: 'معايير Core Web Vitals المستهدفة ونطاق المعالجة الهندسية',
            headers: ['المؤشر الحيوي', 'حد النجاح في جوجل', 'الإجراءات الهندسية المنفذة'],
            rows: [
              ['LCP (سرعة عرض المحتوى الرئيسي)', '≤ 2.5 ثانية', 'صيغ AVIF/WebP، التحميل المسبق، تخزين Edge وتقليل زمن استجابة الخادم TTFB'],
              ['INP (استجابة التفاعل)', '≤ 200 مللي ثانية', 'تقليص حزم JavaScript وتفكيك المهام الطويلة على الخيط الرئيسي'],
              ['CLS (ثبات التخطيط البصري)', '≤ 0.1', 'تحديد أبعاد الصور والخطوط المستضافة محلياً لمنع قفز العناصر'],
            ],
          }
        : {
            title: 'Core Web Vitals Targets & Engineering Remediation Scope',
            headers: ['Core Metric', 'Google Good Threshold', 'Engineering Remediation Actions'],
            rows: [
              ['Largest Contentful Paint (LCP)', '≤ 2.5 seconds', 'AVIF/WebP pipeline, hero fetchpriority="high", edge caching & TTFB tuning'],
              ['Interaction to Next Paint (INP)', '≤ 200 milliseconds', 'Deferring non-critical JS, breaking up long main-thread tasks & third-party scripts'],
              ['Cumulative Layout Shift (CLS)', '≤ 0.10 score', 'Explicit media aspect ratios, self-hosted font metric matching & slot reservation'],
            ],
          }
    : null;
---

<div class={`space-y-16 py-8 ${fontClass}`}>
  <div class="mx-auto max-w-7xl space-y-16">
    <!-- Intro & Main Description -->
    <div class="mx-auto max-w-4xl space-y-6 text-center">
      <h2 class="text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white">{t(`${ns}.intro.title`, '')}</h2>
      <p class="text-lg leading-relaxed text-gray-600 dark:text-gray-300">
        {t(`${ns}.description`, '')}
      </p>
      <p class="leading-relaxed text-gray-600 dark:text-gray-300">
        {t(`${ns}.intro.text`, '')}
      </p>
      {
        slug === 'speed-optimization' && (
          <div class="pt-2">
            <a
              href={`/${lang}/blog/website-speed-optimization-pricing-guide-2026/`}
              class="inline-flex items-center gap-2 rounded-xl border border-primary/30 bg-primary/5 px-5 py-2.5 text-sm font-bold text-primary transition-colors hover:bg-primary/10"
            >
              <span>{t('speedOptimization.pricingGuideLabel', 'Read the 2026 Speed Optimization Pricing Guide')}</span>
              <span aria-hidden="true">{lang === 'en' ? '→' : '←'}</span>
            </a>
          </div>
        )
      }
    </div>

    <!-- AEO Quick Answer Capsule -->
    <aside class="aeo-quick-answer mx-auto max-w-4xl rounded-2xl border-s-4 border-primary bg-primary/5 p-6 sm:p-8 dark:bg-slate-900/80">
      <div class="mb-2 text-xs font-bold uppercase tracking-wider text-primary">
        {lang === 'fa' ? 'خلاصه اجرایی و پاسخ مستقیم (AEO)' : lang === 'ar' ? 'الإجابة المباشرة وخلاصة الخدمة (AEO)' : 'Quick Answer: Service Scope (AEO)'}
      </div>
      <p class="text-base leading-relaxed font-medium text-gray-800 dark:text-gray-100">
        {quickAnswer}
      </p>
    </aside>

    <!-- Optional Core Web Vitals Benchmark Table for speed-optimization -->
    {
      benchmarkTable && (
        <div class="mx-auto max-w-5xl">
          <h2 class="mb-6 text-center text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white">
            {benchmarkTable.title}
          </h2>
          <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white shadow-xs dark:border-slate-800 dark:bg-slate-900">
            <table class="w-full border-collapse text-start text-sm">
              <thead>
                <tr class="border-b border-gray-200 bg-gray-50 dark:border-slate-800 dark:bg-slate-800/70">
                  {benchmarkTable.headers.map((h) => (
                    <th class="px-4 py-3.5 font-bold text-gray-900 dark:text-white">{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100 dark:divide-slate-800">
                {benchmarkTable.rows.map((r) => (
                  <tr class="hover:bg-gray-50/60 dark:hover:bg-slate-800/40">
                    <td class="px-4 py-3 font-semibold text-gray-900 dark:text-white">{r[0]}</td>
                    <td class="px-4 py-3 font-bold text-emerald-700 dark:text-emerald-400">{r[1]}</td>
                    <td class="px-4 py-3 text-gray-600 dark:text-gray-300">{r[2]}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )
    }

    <!-- Core Features Checklist Card -->
    <div
      class="rounded-2xl border border-gray-100 bg-white p-8 shadow-xs dark:border-slate-800 dark:bg-slate-900"
    >
      <h3 class="mb-6 flex items-center gap-3 text-2xl font-bold text-gray-900 dark:text-white">
        {
          slug === 'speed-optimization' && (
            <svg aria-hidden="true" class="h-8 w-8 text-orange-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
            </svg>
          )
        }
        {
          slug === 'ui-ux-audit' && (
            <svg aria-hidden="true" class="h-8 w-8 text-indigo-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
              <line x1="3" y1="9" x2="21" y2="9" />
              <line x1="9" y1="21" x2="9" y2="9" />
            </svg>
          )
        }
        {
          slug === 'website-maintenance' && (
            <svg aria-hidden="true" class="h-8 w-8 text-cyan-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              <polyline points="9 11 11 13 15 9" />
            </svg>
          )
        }
        <span>{t(`${ns}.title`, slug)}</span>
      </h3>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          features.map((feature) => (
            <div class="flex items-center gap-3 rounded-xl p-3 transition-colors hover:bg-gray-50/50 dark:hover:bg-slate-800">
              <svg
                aria-hidden="true"
                class="h-5 w-5 shrink-0 text-emerald-600"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                />
              </svg>
              <span class="text-sm font-semibold text-gray-700 dark:text-gray-200">{feature}</span>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Benefits Section -->
    <div>
      <h2 class="mb-10 text-center text-3xl font-bold text-gray-900 dark:text-white">
        {t('common.whyChooseUs', 'Why Choose Us')}
      </h2>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {
          benefits.map((benefit) => (
            <div class="rounded-2xl border border-gray-100 bg-linear-to-br from-gray-50/50 to-white p-6 shadow-xs transition-shadow hover:shadow-md dark:border-slate-800 dark:from-slate-900 dark:to-slate-900/80">
              <h3 class={`mb-3 text-xl font-bold ${theme.headerText}`}>
                {benefit.title}
              </h3>
              <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                {benefit.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Process Section -->
    <div>
      <h2 class="mb-10 text-center text-3xl font-bold text-gray-900 dark:text-white">
        {t('common.howItWorks', 'Our Work Process')}
      </h2>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          processes.map((process, i) => (
            <div class="relative rounded-2xl border border-gray-200/80 bg-white p-6 pt-12 text-center shadow-xs transition-shadow hover:shadow-md dark:border-slate-800 dark:bg-slate-900">
              <div
                class={`absolute -top-5 left-1/2 h-10 w-10 -translate-x-1/2 ${theme.bg} flex items-center justify-center rounded-full text-lg font-bold text-white shadow-md`}
              >
                {i + 1}
              </div>
              <h3 class="mt-2 mb-3 text-lg font-bold text-gray-800 dark:text-gray-100">
                {process.title}
              </h3>
              <p class="text-xs leading-relaxed text-gray-500 dark:text-gray-400">
                {process.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Contextual Guides -->
    <div class="mx-auto max-w-4xl grid gap-6 md:grid-cols-2">
      {
        slug === 'speed-optimization' && (
          <>
            <a
              href={`/${lang}/blog/core-web-vitals-inp-guide-2026/`}
              class="rounded-2xl border border-gray-200 bg-white p-6 transition-colors hover:border-primary/50 dark:border-slate-800 dark:bg-slate-900"
            >
              <div class="text-xs font-bold uppercase text-primary">Core Web Vitals · INP</div>
              <h3 class="mt-1 text-base font-bold text-gray-900 dark:text-white">
                {lang === 'fa' ? 'راهنمای فنی بهینه‌سازی شاخص INP و LCP در ۲۰۲۶' : lang === 'ar' ? 'دليل تحسين مؤشرات Core Web Vitals وINP' : 'Core Web Vitals & INP Engineering Guide (2026)'}
              </h3>
            </a>
            <a
              href={`/${lang}/blog/website-speed-optimization-guide-2026/`}
              class="rounded-2xl border border-gray-200 bg-white p-6 transition-colors hover:border-primary/50 dark:border-slate-800 dark:bg-slate-900"
            >
              <div class="text-xs font-bold uppercase text-primary">Step-by-Step Playbook</div>
              <h3 class="mt-1 text-base font-bold text-gray-900 dark:text-white">
                {lang === 'fa' ? 'چک‌لیست گام‌به‌گام افزایش سرعت سایت' : lang === 'ar' ? 'دليل تسريع الموقع خطوة بخطوة' : 'Hands-On Website Speed Optimization Checklist'}
              </h3>
            </a>
          </>
        )
      }
      {
        slug === 'ui-ux-audit' && (
          <>
            <a
              href={`/${lang}/blog/ui-ux-audit-redesign-guide-2026/`}
              class="rounded-2xl border border-gray-200 bg-white p-6 transition-colors hover:border-primary/50 dark:border-slate-800 dark:bg-slate-900"
            >
              <div class="text-xs font-bold uppercase text-primary">CRO & Audit Framework</div>
              <h3 class="mt-1 text-base font-bold text-gray-900 dark:text-white">
                {lang === 'fa' ? 'راهنمای ممیزی UI/UX و افزایش نرخ تبدیل ۲۰۲۶' : lang === 'ar' ? 'دليل تدقيق UI/UX ورفع معدل التحويل' : 'UI/UX Audit & Conversion Redesign Guide 2026'}
              </h3>
            </a>
            <a
              href={`/${lang}/tools/color-contrast-checker/`}
              class="rounded-2xl border border-gray-200 bg-white p-6 transition-colors hover:border-primary/50 dark:border-slate-800 dark:bg-slate-900"
            >
              <div class="text-xs font-bold uppercase text-primary">WCAG Accessibility Tool</div>
              <h3 class="mt-1 text-base font-bold text-gray-900 dark:text-white">
                {lang === 'fa' ? 'ابزار آنلاین تست کنتراست رنگ و دسترس‌پذیری' : lang === 'ar' ? 'أداة فحص تباين الألوان وإمكانية الوصول' : 'Interactive WCAG Color Contrast Checker'}
              </h3>
            </a>
          </>
        )
      }
      {
        slug === 'website-maintenance' && (
          <>
            <a
              href={`/${lang}/blog/website-maintenance-security-guide-2026/`}
              class="rounded-2xl border border-gray-200 bg-white p-6 transition-colors hover:border-primary/50 dark:border-slate-800 dark:bg-slate-900"
            >
              <div class="text-xs font-bold uppercase text-primary">Security & Uptime</div>
              <h3 class="mt-1 text-base font-bold text-gray-900 dark:text-white">
                {lang === 'fa' ? 'راهنمای جامع نگهداری، بکاپ و امنیت سایت ۲۰۲۶' : lang === 'ar' ? 'دليل صيانة وأمان المواقع لعام 2026' : 'Website Maintenance & Security Guide 2026'}
              </h3>
            </a>
            <a
              href={`/${lang}/tools/robots-generator/`}
              class="rounded-2xl border border-gray-200 bg-white p-6 transition-colors hover:border-primary/50 dark:border-slate-800 dark:bg-slate-900"
            >
              <div class="text-xs font-bold uppercase text-primary">Crawler Governance</div>
              <h3 class="mt-1 text-base font-bold text-gray-900 dark:text-white">
                {lang === 'fa' ? 'سازنده استاندارد Robots.txt و مدیریت خزنده‌ها' : lang === 'ar' ? 'منشئ ملف Robots.txt وخريطة الموقع' : 'Robots.txt & Crawler Directive Generator'}
              </h3>
            </a>
          </>
        )
      }
    </div>

    <!-- FAQ Accordion -->
    {
      faqList.length > 0 && (
        <div class="mx-auto max-w-3xl">
          <FAQ faqList={faqList} lang={lang} emitWebPage={false} />
        </div>
      )
    }
  </div>
</div>
