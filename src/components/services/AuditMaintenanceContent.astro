---
import FAQ from '../astro/FAQ.astro';
import { type SupportedLanguage } from '../../types/language';
import { createTranslator } from '@/i18n/translate';

interface Props {
  slug: string;
  lang: SupportedLanguage;
  dictionary: any;
}

const { slug, lang, dictionary } = Astro.props;

// Translate helpers
const t = createTranslator(dictionary);

// Map slug to namespace
const slugNamespaceMap: Record<string, string> = {
  'speed-optimization': 'speedOptimization',
  'ui-ux-audit': 'uiUxAudit',
  'website-maintenance': 'maintenance',
};

const ns = slugNamespaceMap[slug] || 'services';

// Features checklist (0 to 4)
const features = [0, 1, 2, 3, 4].map((idx) => t(`${ns}.features.${idx}`, `Feature ${idx + 1}`));

// Benefits grid (0 to 3)
const benefits = [0, 1, 2, 3].map((idx) => ({
  title: t(`${ns}.benefits.${idx}.title`, `Benefit ${idx + 1}`),
  description: t(`${ns}.benefits.${idx}.description`, ''),
}));

// Process steps (0 to 3)
const processes = [0, 1, 2, 3].map((idx) => ({
  title: t(`${ns}.process.${idx}.title`, `Step ${idx + 1}`),
  description: t(`${ns}.process.${idx}.description`, ''),
}));

// FAQ items (q1/a1 to q4/a4)
const faqList = [1, 2, 3, 4]
  .map((idx) => ({
    question: t(`${ns}.faq.q${idx}`, ''),
    answer: t(`${ns}.faq.a${idx}`, ''),
  }))
  .filter((item) => item.question && item.answer);

// Custom theme styling properties
const colorThemes: Record<
  string,
  { bg: string; text: string; iconColor: string; border: string; headerText: string }
> = {
  'speed-optimization': {
    bg: 'bg-orange-500',
    text: 'text-orange-500',
    iconColor: 'text-orange-500',
    border: 'border-orange-100',
    headerText: 'text-orange-600',
  },
  'ui-ux-audit': {
    bg: 'bg-indigo-600',
    text: 'text-indigo-600',
    iconColor: 'text-indigo-500',
    border: 'border-indigo-100',
    headerText: 'text-indigo-600',
  },
  'website-maintenance': {
    bg: 'bg-cyan-600',
    text: 'text-cyan-600',
    iconColor: 'text-cyan-500',
    border: 'border-cyan-100',
    headerText: 'text-cyan-700',
  },
};

const theme = colorThemes[slug] || colorThemes['website-maintenance'];
---

<div class="space-y-16 py-8">
  <!-- Key Takeaways (TL;DR) -->

  <div class="mx-auto max-w-4xl">
    <!-- Main description paragraph -->
    <div class="prose mb-12 max-w-none">
      <p class="text-center font-persian text-xl leading-relaxed text-gray-600 dark:text-gray-300">
        {t(`${ns}.description`, '')}
      </p>
    </div>

    <!-- Intro Section -->
    <div class="mb-12 space-y-4 text-center">
      <h2 class="font-persian text-2xl font-bold">{t(`${ns}.intro.title`, '')}</h2>
      <p class="font-persian leading-relaxed text-gray-600 dark:text-gray-300">
        {t(`${ns}.intro.text`, '')}
      </p>
    </div>

    <!-- Core Features Checklist Card -->
    <div
      class="mb-16 rounded-2xl border border-gray-100 bg-white p-8 shadow-xs dark:border-slate-800 dark:bg-slate-900"
    >
      <h3 class="mb-6 flex items-center gap-3 font-persian text-2xl font-bold">
        {
          slug === 'speed-optimization' && (
            <svg
              aria-hidden="true"
              class="h-8 w-8 text-orange-500"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
            </svg>
          )
        }
        {
          slug === 'ui-ux-audit' && (
            <svg
              aria-hidden="true"
              class="h-8 w-8 text-indigo-500"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <>
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                <line x1="3" y1="9" x2="21" y2="9" />
                <line x1="9" y1="21" x2="9" y2="9" />
              </>
            </svg>
          )
        }
        {
          slug === 'website-maintenance' && (
            <svg
              aria-hidden="true"
              class="h-8 w-8 text-cyan-500"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <>
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                <polyline points="9 11 11 13 15 9" />
              </>
            </svg>
          )
        }
        {t(`${ns}.title`, slug)}
      </h3>
      <div class="grid grid-cols-1 gap-6 font-persian md:grid-cols-2">
        {
          features.map((feature) => (
            <div class="flex items-center gap-3 rounded-xl p-3 transition-colors hover:bg-gray-50/50 dark:hover:bg-slate-800">
              <svg
                aria-hidden="true"
                class="h-5 w-5 shrink-0 text-green-500"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                />
              </svg>
              <span class="text-sm font-semibold text-gray-700 dark:text-gray-200">{feature}</span>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Benefits Section -->
    <div class="mb-20">
      <h2 class="mb-10 text-center font-persian text-3xl font-bold text-gray-900 dark:text-white">
        {t('common.whyChooseUs', 'Why Choose Us')}
      </h2>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {
          benefits.map((benefit) => (
            <div class="rounded-2xl border border-gray-100 bg-linear-to-br from-gray-50/50 to-white p-6 shadow-xs transition-shadow hover:shadow-md dark:border-slate-800 dark:from-slate-900 dark:to-slate-900/80">
              <h3 class={`mb-3 text-xl font-bold ${theme.headerText} font-persian`}>
                {benefit.title}
              </h3>
              <p class="font-persian text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                {benefit.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Process Section -->
    <div class="mb-20">
      <h2 class="mb-10 text-center font-persian text-3xl font-bold text-gray-900 dark:text-white">
        {t('common.howItWorks', 'Our Work Process')}
      </h2>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          processes.map((process, i) => (
            <div class="relative rounded-2xl border border-gray-200/80 bg-white p-6 pt-12 text-center shadow-xs transition-shadow hover:shadow-md dark:border-slate-800 dark:bg-slate-900">
              <div
                class={`absolute -top-5 left-1/2 h-10 w-10 -translate-x-1/2 ${theme.bg} flex items-center justify-center rounded-full text-lg font-bold text-white shadow-md`}
              >
                {i + 1}
              </div>
              <h3 class="mt-2 mb-3 font-persian text-lg font-bold text-gray-800 dark:text-gray-100">
                {process.title}
              </h3>
              <p class="font-persian text-xs leading-relaxed text-gray-500 dark:text-gray-400">
                {process.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- FAQ Accordion -->
    {faqList.length > 0 && <FAQ faqList={faqList} lang={lang} />}
  </div>
</div>
