---
import FAQ from '../astro/FAQ.astro';
import { type SupportedLanguage } from '@/types/language';
import { createTranslator } from '@/i18n/translate';

interface Props {
  lang: SupportedLanguage;
  dictionary: any;
}

const { lang, dictionary } = Astro.props;

// Translate helpers
const t = createTranslator(dictionary);

const faqList = [1, 2, 3, 4]
  .map((n) => ({
    question: t(`seoService.faq.q${n}`, ''),
    answer: t(`seoService.faq.a${n}`, ''),
  }))
  .filter((item) => item.question && item.answer);
---

<div class="space-y-16 py-8">
  <!-- Intro Section -->
  <section class="bg-white dark:bg-slate-950">
    <div class="mx-auto max-w-4xl space-y-6 text-center">
      <h2 class="font-persian text-3xl font-bold">
        {t('seoService.intro.title', 'What Does Our SEO Service Actually Cover?')}
      </h2>
      <p class="font-persian text-lg leading-relaxed text-gray-600 dark:text-gray-300">
        {t('seoService.intro.text', '')}
      </p>
    </div>
  </section>

  <!-- Services Cards Section -->
  <section class="bg-white dark:bg-slate-950">
    <div class="mx-auto max-w-6xl">
      <h2 class="mb-12 text-center font-persian text-3xl font-bold">
        {t('seoService.servicesTitle', 'Our SEO Services')}
      </h2>

      <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
        <!-- Card 1: On-Page SEO -->
        <div
          class="group rounded-2xl border border-transparent bg-blue-50/50 p-8 transition-all duration-300 hover:border-blue-100/50 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:border-blue-500/30"
        >
          <div
            class="mb-6 flex h-14 w-14 items-center justify-center rounded-xl bg-white text-blue-600 shadow-sm transition-transform group-hover:scale-110 dark:bg-slate-800"
          >
            <svg
              aria-hidden="true"
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"
              ></line></svg
            >
          </div>
          <h3 class="mb-4 font-persian text-xl font-bold text-gray-900 dark:text-white">
            {t('seoService.onPageSeo', 'On-Page SEO')}
          </h3>
          <p class="mb-6 font-persian leading-relaxed text-gray-600 dark:text-gray-300">
            {t('seoService.contentStrategyDesc', 'Comprehensive content strategy and optimization')}
          </p>
          <ul class="space-y-3 font-persian">
            {
              [
                t('seoService.feature.keywordResearch', 'Keyword Research'),
                t('seoService.feature.qualityContent', 'Quality Content Production'),
                t('seoService.feature.titleOptimization', 'Title & Meta Optimization'),
                t('seoService.feature.headings', 'Heading Structure'),
              ].map((feat) => (
                <li class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-200">
                  <svg
                    aria-hidden="true"
                    class="h-4 w-4 shrink-0 text-blue-600 opacity-80"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{feat}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Card 2: Technical SEO -->
        <div
          class="group rounded-2xl border border-transparent bg-green-50/50 p-8 transition-all duration-300 hover:border-green-100/50 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:border-green-500/30"
        >
          <div
            class="mb-6 flex h-14 w-14 items-center justify-center rounded-xl bg-white text-green-600 shadow-sm transition-transform group-hover:scale-110 dark:bg-slate-800"
          >
            <svg
              aria-hidden="true"
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"
              ></line><path
                d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
              ></path></svg
            >
          </div>
          <h3 class="mb-4 font-persian text-xl font-bold text-gray-900 dark:text-white">
            {t('seoService.technicalSeo', 'Technical SEO')}
          </h3>
          <p class="mb-6 font-persian leading-relaxed text-gray-600 dark:text-gray-300">
            {t('seoService.technicalSeoDesc', 'Optimizing site structure and performance')}
          </p>
          <ul class="space-y-3 font-persian">
            {
              [
                t('seoService.feature.pageSpeed', 'Page Speed Optimization'),
                t('seoService.feature.technicalErrors', 'Fixing Technical Errors'),
                t('seoService.feature.urlStructure', 'URL Structure Optimization'),
                t('seoService.feature.schema', 'Schema Markup Implementation'),
              ].map((feat) => (
                <li class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-200">
                  <svg
                    aria-hidden="true"
                    class="h-4 w-4 shrink-0 text-green-600 opacity-80"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{feat}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Card 3: Off-Page SEO -->
        <div
          class="group rounded-2xl border border-transparent bg-purple-50/50 p-8 transition-all duration-300 hover:border-purple-100/50 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:border-purple-500/30"
        >
          <div
            class="mb-6 flex h-14 w-14 items-center justify-center rounded-xl bg-white text-purple-600 shadow-sm transition-transform group-hover:scale-110 dark:bg-slate-800"
          >
            <svg
              aria-hidden="true"
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path
                d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg
            >
          </div>
          <h3 class="mb-4 font-persian text-xl font-bold text-gray-900 dark:text-white">
            {t('seoService.offPageSeo', 'Off-Page SEO')}
          </h3>
          <p class="mb-6 font-persian leading-relaxed text-gray-600 dark:text-gray-300">
            {t('seoService.offPageSeoDesc', 'Building authority and backlinks')}
          </p>
          <ul class="space-y-3 font-persian">
            {
              [
                t('seoService.feature.linkProfile', 'Link Profile Analysis'),
                t('seoService.feature.linkOpportunities', 'Link Building Opportunities'),
                t('seoService.feature.linkableContent', 'Creating Linkable Content'),
                t('seoService.feature.authorityLinks', 'High Authority Backlinks'),
              ].map((feat) => (
                <li class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-200">
                  <svg
                    aria-hidden="true"
                    class="h-4 w-4 shrink-0 text-purple-600 opacity-80"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{feat}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Card 4: Local SEO -->
        <div
          class="group rounded-2xl border border-transparent bg-amber-50/50 p-8 transition-all duration-300 hover:border-amber-100/50 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:border-amber-500/30"
        >
          <div
            class="mb-6 flex h-14 w-14 items-center justify-center rounded-xl bg-white text-amber-600 shadow-sm transition-transform group-hover:scale-110 dark:bg-slate-800"
          >
            <svg
              aria-hidden="true"
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path d="M21.21 15.89A10 10 0 1 1 8 2.83"></path><path
                d="M22 12A10 10 0 0 0 12 2v10z"></path></svg
            >
          </div>
          <h3 class="mb-4 font-persian text-xl font-bold text-gray-900 dark:text-white">
            {t('seoService.localSeo', 'Local SEO')}
          </h3>
          <p class="mb-6 font-persian leading-relaxed text-gray-600 dark:text-gray-300">
            {t('seoService.localSeoDesc', 'Dominating local search results')}
          </p>
          <ul class="space-y-3 font-persian">
            {
              [
                t('seoService.feature.gmb', 'Google Business Profile'),
                t('seoService.feature.reviews', 'Review Management'),
                t('seoService.feature.localKeywords', 'Local Keyword Targeting'),
                t('seoService.feature.nearMe', 'Near Me Optimization'),
              ].map((feat) => (
                <li class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-200">
                  <svg
                    aria-hidden="true"
                    class="h-4 w-4 shrink-0 text-amber-600 opacity-80"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{feat}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Results Section -->
  <section
    class="rounded-3xl border border-gray-100 bg-gray-50/50 p-8 py-16 dark:border-slate-800 dark:bg-slate-900"
  >
    <div class="mx-auto max-w-2xl space-y-6 text-center">
      <h2 class="font-persian text-3xl font-bold">
        {t('seoService.results.title', 'Results Our Clients Have Seen')}
      </h2>
      <p class="font-persian leading-relaxed text-gray-600 dark:text-gray-300">
        {
          t(
            'seoService.results.description',
            "Every SEO engagement starts with clear goals and ends with outcomes we can show you, not just promise. Explore real case studies from businesses we've helped grow online."
          )
        }
      </p>
      <a
        href={`/${lang}/portfolio/`}
        class="inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3 font-bold text-primary-foreground shadow-md transition-all hover:bg-primary/90 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
      >
        {t('seoService.results.cta', 'View Case Studies')}
      </a>
    </div>
  </section>

  <!-- Process Section -->
  <section class="bg-white dark:bg-slate-950">
    <div class="mx-auto max-w-6xl">
      <h2 class="mb-12 text-center font-persian text-3xl font-bold">
        {t('seoService.process.title', 'Our SEO Process')}
      </h2>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        <div
          class="group relative rounded-2xl border border-transparent bg-gray-50/50 p-8 transition-all hover:border-gray-100 hover:bg-white hover:shadow-xl dark:bg-slate-900 dark:hover:border-slate-700 dark:hover:bg-slate-800"
        >
          <div
            class="absolute -top-4 -left-4 flex h-12 w-12 rotate-3 items-center justify-center rounded-xl bg-blue-500 text-xl font-bold text-white shadow-lg transition-transform group-hover:scale-110 group-hover:rotate-6"
          >
            01
          </div>
          <h3 class="mt-2 mb-4 font-persian text-xl font-bold text-gray-900 dark:text-white">
            {t('seoService.process.step1.title', 'Research & Analysis')}
          </h3>
          <p class="font-persian leading-relaxed text-gray-600 dark:text-gray-300">
            {
              t(
                'seoService.process.step1.description',
                'We analyze your website, competitors, and target keywords to create a comprehensive SEO strategy.'
              )
            }
          </p>
        </div>

        <div
          class="group relative rounded-2xl border border-transparent bg-gray-50/50 p-8 transition-all hover:border-gray-100 hover:bg-white hover:shadow-xl dark:bg-slate-900 dark:hover:border-slate-700 dark:hover:bg-slate-800"
        >
          <div
            class="absolute -top-4 -left-4 flex h-12 w-12 rotate-3 items-center justify-center rounded-xl bg-green-500 text-xl font-bold text-white shadow-lg transition-transform group-hover:scale-110 group-hover:rotate-6"
          >
            02
          </div>
          <h3 class="mt-2 mb-4 font-persian text-xl font-bold text-gray-900 dark:text-white">
            {t('seoService.process.step2.title', 'Implementation')}
          </h3>
          <p class="font-persian leading-relaxed text-gray-600 dark:text-gray-300">
            {
              t(
                'seoService.process.step2.description',
                'Our team implements on-page and technical SEO optimizations based on our research findings.'
              )
            }
          </p>
        </div>

        <div
          class="group relative rounded-2xl border border-transparent bg-gray-50/50 p-8 transition-all hover:border-gray-100 hover:bg-white hover:shadow-xl dark:bg-slate-900 dark:hover:border-slate-700 dark:hover:bg-slate-800"
        >
          <div
            class="absolute -top-4 -left-4 flex h-12 w-12 rotate-3 items-center justify-center rounded-xl bg-purple-500 text-xl font-bold text-white shadow-lg transition-transform group-hover:scale-110 group-hover:rotate-6"
          >
            03
          </div>
          <h3 class="mt-2 mb-4 font-persian text-xl font-bold text-gray-900 dark:text-white">
            {t('seoService.process.step3.title', 'Monitor & Optimize')}
          </h3>
          <p class="font-persian leading-relaxed text-gray-600 dark:text-gray-300">
            {
              t(
                'seoService.process.step3.description',
                'We continuously monitor rankings and traffic, making data-driven adjustments to improve results.'
              )
            }
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  {
    faqList.length > 0 && (
      <section class="mx-auto max-w-3xl">
        <FAQ faqList={faqList} lang={lang} />
      </section>
    )
  }
</div>
