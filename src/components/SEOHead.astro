---
interface Props {
  title: string;
  description: string;
  lang: string;
  slug?: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title,
  description,
  lang,
  slug = '',
  canonical,
  ogImage = '/images/og-image.webp',
} = Astro.props;

const canonicalUrl = canonical || (slug ? `https://webabc.ir/${lang}/${slug}/` : `https://webabc.ir/${lang}/`);
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImage.startsWith('http') ? ogImage : `https://webabc.ir${ogImage}`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage.startsWith('http') ? ogImage : `https://webabc.ir${ogImage}`} />
