---
interface Props {
  title: string;
  description: string;
  href: string;
  badge?: string;
  icon?: string;
  features?: string[];
  lang?: string;
  class?: string;
}

const {
  title,
  description,
  href,
  badge,
  features = [],
  lang = 'en',
  class: className = '',
} = Astro.props;
---

<div
  class={`group rounded-2xl border border-gray-100 bg-white p-7 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 ${className}`}
>
  {badge && (
    <div class="mb-4 inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/10 px-3 py-0.5 text-xs font-bold text-primary">
      {badge}
    </div>
  )}
  <h3 class="mb-3 text-xl font-bold text-gray-900 transition-colors group-hover:text-primary dark:text-white">
    {title}
  </h3>
  <p class="mb-5 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
    {description}
  </p>
  {features.length > 0 && (
    <ul class="mb-6 space-y-2 text-xs font-medium text-gray-700 dark:text-gray-300">
      {features.map((item) => (
        <li class="flex items-center gap-2">
          <span class="text-primary font-bold">✓</span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  )}
  <a
    href={href}
    class="inline-flex items-center gap-1.5 text-xs font-bold text-primary transition-all group-hover:gap-2.5"
  >
    <span>{lang === 'fa' ? 'مشاهده جزئیات' : lang === 'ar' ? 'عرض التفاصيل' : 'View Details'}</span>
    <span aria-hidden="true">{lang === 'en' ? '→' : '←'}</span>
  </a>
</div>
