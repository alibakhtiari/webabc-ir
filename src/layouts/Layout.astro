---
import { ClientRouter } from 'astro:transitions';
import { languages, type SupportedLanguage } from '../types/language';
import { getDictionary } from '../i18n/get-dictionary';
import Navbar from '../components/astro/Navbar.astro';
import Footer from '../components/astro/Footer.astro';
import FloatingActions from '../components/astro/FloatingActions.astro';
import '../styles/globals.css';


function createOrganizationSchema(url: string, logo: string, contactPoints: { telephone: string; contactType: string }[], lang: string) {
  return {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "@id": `${url}/#organization`,
    "url": url,
    "logo": `${url}${logo}`,
    "name": "WebABC",
    "telephone": "+989125811880",
    "email": "info@webabc.ir",
    "contactPoint": contactPoints.map(cp => ({
      "@type": "ContactPoint",
      "telephone": cp.telephone,
      "contactType": cp.contactType
    })),
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Qazvin Science & Technology Park, Km 2 Barajin Road",
      "addressLocality": "Qazvin",
      "addressCountry": "IR"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 36.3156,
      "longitude": 50.0381
    },
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Saturday", "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday"],
        "opens": "09:00",
        "closes": "18:00"
      }
    ],
    "sameAs": [
      "https://facebook.com/webabc",
      "https://twitter.com/webabc",
      "https://instagram.com/webabc",
      "https://linkedin.com/company/webabc"
    ]
  };
}

interface Props {
  title?: string;
  description?: string;
  lang: SupportedLanguage;
  slug?: string;
  mainClass?: string;
  noindex?: boolean;
}

const { title, description, lang, slug = '', mainClass = "grow w-full overflow-x-hidden bg-gray-50/50 pt-0 pb-20", noindex = false } = Astro.props;

const languageMeta = languages[lang] || languages.fa;
const isRtl = languageMeta.direction === 'rtl';
const dictionary = await getDictionary(lang);

const siteUrl = 'https://webabc.ir';
const canonicalPath = slug ? `/${lang}/${slug}/` : `/${lang}/`;
const canonicalUrl = `${siteUrl}${canonicalPath}`;

// Get default meta titles/descriptions from dictionary
const pageTitle = title || dictionary.home?.title || 'WebABC';
const pageDescription = description || dictionary.home?.description || 'Web Design and Development Services';

// Schema Organisation
const organizationSchema = createOrganizationSchema(
  siteUrl,
  '/images/logo.webp',
  [{ telephone: '+989125811880', contactType: 'customer service' }],
  lang
);
---

<!doctype html>
<html lang={lang} dir={languageMeta.direction} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="preload" as="font" type="font/woff2" href={lang === 'en' ? '/fonts/ltr.woff2' : '/fonts/rtl.woff2'} crossorigin />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    
    <!-- SEO / Canonical / alternates -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}/en${slug ? `/${slug}/` : '/'}`} />
    <link rel="alternate" hreflang="fa" href={`${siteUrl}/fa${slug ? `/${slug}/` : '/'}`} />
    <link rel="alternate" hreflang="ar" href={`${siteUrl}/ar${slug ? `/${slug}/` : '/'}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/en${slug ? `/${slug}/` : '/'}`} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    
    <!-- Inline Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    
    <slot name="head" />
  </head>
  <body class={`bg-background text-foreground min-h-screen flex flex-col font-${lang === 'en' ? 'sans' : lang === 'ar' ? 'arabic' : 'persian'}`}>
    <Navbar lang={lang} />
    <main class={mainClass}>
      <slot />
    </main>
    <Footer lang={lang} />
    <FloatingActions lang={lang} />
    <ClientRouter fallback="swap" />
  </body>
</html>
