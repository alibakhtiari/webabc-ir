---
import Layout from '../layouts/Layout.astro';
import { getDictionary } from '../i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';
import type { SupportedLanguage } from '../types/language';

// Inspect requested URL pathname during SSR/prerender to determine requested language
const pathname = Astro.url.pathname;
let detectedLang: SupportedLanguage = 'en';

if (pathname.startsWith('/fa')) {
  detectedLang = 'fa';
} else if (pathname.startsWith('/ar')) {
  detectedLang = 'ar';
}

const lang = detectedLang;
const dictionary = await getDictionary(lang);
const t = createTranslator(dictionary);

const title = `${t('common.notFound.title', { fallback: '404 - Page Not Found' })} | WebABC`;
const description = t('common.notFound.subtitle', {
  fallback: 'The page you requested could not be found.',
});

const quickLinks = [
  { label: t('common.home'), url: `/${lang}` },
  { label: t('common.services'), url: `/${lang}/services` },
  { label: t('common.portfolio'), url: `/${lang}/portfolio` },
  { label: t('common.about'), url: `/${lang}/about` },
  { label: t('common.contact'), url: `/${lang}/contact` },
];
---

<Layout title={title} description={description} lang={lang} noindex={true}>
  <!-- Client-side URL fallback for purely static routing -->
  <Fragment slot="head">
    <script is:inline>
      (function () {
        var path = window.location.pathname;
        if (path.startsWith('/fa') && document.documentElement.lang !== 'fa') {
          window.location.reload();
        } else if (path.startsWith('/ar') && document.documentElement.lang !== 'ar') {
          window.location.reload();
        }
      })();
    </script>
  </Fragment>

  <div
    class="flex min-h-[70vh] items-center justify-center bg-linear-to-b from-gray-50 via-white to-gray-50/50 px-4 py-16"
  >
    <div class="w-full max-w-2xl space-y-8 text-center">
      <!-- 404 Card Header -->
      <div class="space-y-6 rounded-3xl border border-gray-100 bg-white p-8 shadow-xl sm:p-12">
        <div class="flex justify-center">
          <span
            class="rounded-full bg-primary/10 px-5 py-2 font-mono text-sm font-black tracking-widest text-primary uppercase shadow-xs"
          >
            404
          </span>
        </div>

        <div class="space-y-4">
          <h1 class="text-3xl leading-tight font-black tracking-tight text-gray-900 sm:text-5xl">
            {
              t('common.notFound.title', {
                fallback:
                  lang === 'fa'
                    ? 'صفحه مورد نظر پیدا نشد'
                    : lang === 'ar'
                      ? 'الصفحة المطلوبة غير موجودة'
                      : 'Page Not Found',
              })
            }
          </h1>
          <p class="mx-auto max-w-xl text-lg leading-relaxed text-gray-600">
            {
              t('common.notFound.subtitle', {
                fallback:
                  lang === 'fa'
                    ? 'صفحه‌ای که به دنبال آن هستید تغییر آدرس داده یا وجود ندارد. می‌توانید از بخش‌های اصلی سایت دیدن کنید یا با ما در ارتباط باشید.'
                    : lang === 'ar'
                      ? 'قد تكون الصفحة التي تبحث عنها قد تم نقلها أو التغيير في عنوانها. يمكنك استكشاف الخدمات أو زيارة الروابط السريعة أدناه.'
                      : "The page you are looking for has been moved or doesn't exist.",
              })
            }
          </p>
        </div>

        <!-- Quick Navigation Links -->
        <div class="border-t border-gray-100 pt-6">
          <p class="mb-4 text-xs font-semibold tracking-wider text-gray-400 uppercase">
            {
              lang === 'fa'
                ? 'دسترسی سریع به بخش‌های اصلی'
                : lang === 'ar'
                  ? 'روابط سريعة'
                  : 'Quick Navigation'
            }
          </p>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            {
              quickLinks.slice(0, 4).map((link) => (
                <a
                  href={link.url}
                  class="rounded-xl border border-gray-100 bg-gray-50 p-3 text-sm font-bold text-gray-700 shadow-xs transition-all hover:bg-primary hover:text-primary-foreground focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
                >
                  {link.label} {lang === 'en' ? '→' : '←'}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
