---
import Layout from '@/layouts/Layout.astro';
import { getDictionary } from '@/i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';
import type { SupportedLanguage } from '@/types/language';

const pathname = Astro.url.pathname;
let detectedLang: SupportedLanguage = 'en';

if (pathname.startsWith('/fa')) {
  detectedLang = 'fa';
} else if (pathname.startsWith('/ar')) {
  detectedLang = 'ar';
}

const lang = detectedLang;
const dictionary = await getDictionary(lang);
const t = createTranslator(dictionary);

const title = `${t('common.notFound.title', { fallback: '404 - Page Not Found' })} | WebABC`;
const description = t('common.notFound.subtitle', {
  fallback: 'The page you requested could not be found.',
});

const quickLinks = [
  { label: t('common.home'), url: `/${lang}/` },
  { label: t('common.services'), url: `/${lang}/services/` },
  { label: t('common.portfolio'), url: `/${lang}/portfolio/` },
  { label: t('common.about'), url: `/${lang}/about/` },
  { label: t('common.contact'), url: `/${lang}/contact/` },
];
---

<Layout title={title} description={description} lang={lang} noindex={true}>
  <Fragment slot="head">
    <script is:inline>
      (function () {
        var path = window.location.pathname;
        if (path.startsWith('/fa') && document.documentElement.lang !== 'fa') {
          window.location.reload();
        } else if (path.startsWith('/ar') && document.documentElement.lang !== 'ar') {
          window.location.reload();
        }
      })();
    </script>
  </Fragment>

  <div class="flex min-h-[75vh] items-center justify-center bg-[var(--bg-canvas)] px-4 py-16">
    <div class="w-full max-w-3xl space-y-8 text-center">
      <div class="terminal-window">
        <div class="terminal-chrome-bar" dir="ltr">
          <span class="font-mono text-xs font-bold text-[var(--accent-coral)]">
            ╭─ /ERROR-404 · lost-in-space-404.js ─╮
          </span>
          <span class="monospace-telemetry-pill">HTTP 404 · RECOVERY</span>
        </div>

        <div
          class="crt-scanlines overflow-x-auto border-b border-[var(--border-hairline)] bg-[var(--bg-canvas)] py-2"
          dir="ltr"
          style="min-height: 210px; unicode-bidi: isolate;"
        >
          <ascii-art
            piece="lost-in-space-404"
            size="11"
            speed="1"
            look="original"
            role="img"
            aria-label="404 route not found ASCII telemetry"
          ></ascii-art>
        </div>

        <div class="space-y-6 p-8 sm:p-10">
          <div class="space-y-3">
            <h1 class="text-3xl leading-tight font-black tracking-tight text-[var(--text-primary)] sm:text-4xl">
              {
                t('common.notFound.title', {
                  fallback:
                    lang === 'fa'
                      ? 'صفحه مورد نظر پیدا نشد'
                      : lang === 'ar'
                        ? 'الصفحة المطلوبة غير موجودة'
                        : 'Page Not Found',
                })
              }
            </h1>
            <p class="mx-auto max-w-xl text-base leading-relaxed text-[var(--text-secondary)]">
              {
                t('common.notFound.subtitle', {
                  fallback:
                    lang === 'fa'
                      ? 'صفحه‌ای که به دنبال آن هستید تغییر آدرس داده یا وجود ندارد. می‌توانید از بخش‌های اصلی سایت دیدن کنید یا با ما در ارتباط باشید.'
                      : lang === 'ar'
                        ? 'قد تكون الصفحة التي تبحث عنها قد تم نقلها أو التغيير في عنوانها. يمكنك استكشاف الخدمات أو زيارة الروابط السريعة أدناه.'
                        : "The page you are looking for has been moved or doesn't exist.",
                })
              }
            </p>
          </div>

          <div class="border-t border-[var(--border-hairline)] pt-6">
            <p class="mb-4 font-mono text-xs font-semibold tracking-wider text-[var(--text-secondary)] uppercase">
              {
                lang === 'fa'
                  ? 'دسترسی سریع به بخش‌های اصلی'
                  : lang === 'ar'
                    ? 'روابط سريعة'
                    : 'Quick Navigation'
              }
            </p>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
              {
                quickLinks.slice(0, 4).map((link) => (
                  <a
                    href={link.url}
                    class="rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] p-3 font-mono text-xs font-bold text-[var(--text-primary)] transition-all hover:border-[var(--accent-green)] hover:text-[var(--accent-green)]"
                  >
                    {link.label} {lang === 'en' ? '→' : '←'}
                  </a>
                ))
              }
            </div>
          </div>

          <nav aria-label="Agent recovery links" class="border-t border-[var(--border-hairline)] pt-5 text-xs">
            <p class="font-mono font-semibold tracking-wider text-[var(--text-secondary)] uppercase">
              {
                lang === 'fa'
                  ? 'راهنمای ربات‌ها و لینک‌های بازیابی'
                  : lang === 'ar'
                    ? 'روابط استرداد الذكاء الاصطناعي'
                    : 'Agent & Crawler Recovery Links'
              }
            </p>
            <div class="ltr-isolate mt-2.5 flex flex-wrap justify-center gap-3 font-mono text-[11px]" dir="ltr">
              <a href="/llms.txt" class="text-[var(--accent-blue)] underline hover:text-[var(--accent-green)]">/llms.txt</a>
              <span class="text-[var(--border-focus)]">•</span>
              <a href="/llms-full.txt" class="text-[var(--accent-blue)] underline hover:text-[var(--accent-green)]">/llms-full.txt</a>
              <span class="text-[var(--border-focus)]">•</span>
              <a href="/sitemap-index.xml" class="text-[var(--accent-blue)] underline hover:text-[var(--accent-green)]">/sitemap-index.xml</a>
              <span class="text-[var(--border-focus)]">•</span>
              <a href="/404.md" class="text-[var(--accent-blue)] underline hover:text-[var(--accent-green)]">/404.md</a>
            </div>
          </nav>
        </div>
      </div>
    </div>
  </div>
</Layout>
