---
import '../styles/globals.css';
// Global catch-all 404 — served for any unmatched route by the static host.
// Not locale-aware (Astro/Cloudflare serve this one file for every unresolved
// path), so it defaults to English with quick links into all 3 locale homepages.
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Page Not Found | WebABC</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body class="min-h-screen flex items-center justify-center bg-gray-50 px-4">
    <div class="max-w-lg w-full text-center space-y-6 py-16">
      <p class="text-7xl font-black text-primary">404</p>
      <h1 class="text-2xl md:text-3xl font-bold text-gray-900">Page Not Found</h1>
      <p class="text-gray-600 leading-relaxed">
        The page you're looking for doesn't exist or has moved. Head back to the homepage or pick your language below.
      </p>
      <div class="flex flex-wrap gap-3 justify-center pt-2">
        <a href="/en" class="px-6 py-2.5 bg-primary text-white font-bold rounded-xl shadow-md hover:bg-primary/90 transition-all">
          Go to Homepage
        </a>
      </div>
      <div class="flex gap-4 justify-center pt-4 text-sm text-gray-500">
        <a href="/en" class="hover:text-primary transition-colors">English</a>
        <span>·</span>
        <a href="/fa" class="hover:text-primary transition-colors">فارسی</a>
        <span>·</span>
        <a href="/ar" class="hover:text-primary transition-colors">العربية</a>
      </div>
    </div>
  </body>
</html>
