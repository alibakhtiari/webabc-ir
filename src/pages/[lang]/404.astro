---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/astro/Hero.astro';
import ServicesSection from '../../components/astro/ServicesSection.astro';
import CTA from '../../components/astro/CTA.astro';
import { getLanguageStaticPaths, languages, type SupportedLanguage } from '../../types/language';
import { getDictionary } from '../../i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);

const t = createTranslator(dictionary);
const isRtl = languages[supportedLang]?.direction === 'rtl';

const title = `${t('common.notFound.title', { fallback: '404 - Page Not Found' })} | WebABC`;
const description = t('common.notFound.subtitle', {
  fallback:
    'The page you requested could not be found. Explore our services or return to the homepage.',
});

const breadcrumbs = [{ label: t('common.home'), url: `/${supportedLang}/` }, { label: '404' }];

const origin = 'https://webabc.ir';

// Schema.org for AI search engines & crawlers (GEO / AEO optimized)
const pageNotFoundSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${origin}/${supportedLang}/404#webpage`,
  url: `${origin}/${supportedLang}/404`,
  name: title,
  description: description,
  inLanguage: supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR',
  isPartOf: { '@id': `${origin}/${supportedLang}#website` },
  publisher: { '@id': `${origin}/#organization` },
};

const quickLinks = [
  { label: t('common.home'), url: `/${supportedLang}/` },
  { label: t('common.services'), url: `/${supportedLang}/services/` },
  { label: t('common.portfolio'), url: `/${supportedLang}/portfolio/` },
  { label: t('common.about'), url: `/${supportedLang}/about/` },
  { label: t('common.contact'), url: `/${supportedLang}/contact/` },
];
---

<Layout title={title} description={description} lang={supportedLang} slug="404" noindex={true}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(pageNotFoundSchema)} />

  <Hero
    title={t('common.notFound.title', { fallback: 'Page Not Found' })}
    description={t('common.notFound.subtitle', {
      fallback:
        'The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.',
    })}
    breadcrumbs={breadcrumbs}
    lang={supportedLang}
  />

  <section class="bg-white py-16 font-persian font-sans dark:bg-slate-950">
    <div class="container mx-auto max-w-4xl space-y-12 px-4 text-center">
      <!-- Interactive 404 Hero Card -->
      <div
        class="space-y-6 rounded-3xl border border-gray-100 bg-gray-50 p-8 shadow-xs md:p-12 dark:border-slate-800 dark:bg-slate-900"
      >
        <span
          class="inline-block rounded-full bg-primary/10 px-4 py-1.5 font-mono text-sm font-black tracking-wider text-primary uppercase"
        >
          Error 404
        </span>
        <h2 class="text-3xl leading-tight font-extrabold text-gray-900 md:text-4xl dark:text-white">
          {
            supportedLang === 'fa'
              ? 'صفحه مورد نظر شما پیدا نشد'
              : supportedLang === 'ar'
                ? 'الصفحة المطلوبة غير موجودة'
                : 'Looking for Web Design or SEO Services?'
          }
        </h2>
        <p class="mx-auto max-w-2xl leading-relaxed text-gray-600 dark:text-gray-300">
          {
            supportedLang === 'fa'
              ? 'ممکن است آدرس صفحه تغییر کرده یا حذف شده باشد. از لینک‌های سریع زیر برای دسترسی به بخش‌های اصلی سایت استفاده کنید.'
              : supportedLang === 'ar'
                ? 'قد تكون الصفحة قد تم نقلها أو حذفها. يمكنك استخدام الروابط السريعة أدناه للوصول إلى أقسام الموقع الرئيسية.'
                : 'The link you followed may be broken or the page has moved. Browse our core agency solutions below or head straight to our home page.'
          }
        </p>

        <!-- Navigation Buttons -->
        <div class="flex flex-wrap justify-center gap-4 pt-2">
          <a
            href={`/${supportedLang}/`}
            class="flex items-center gap-2 rounded-xl bg-primary px-8 py-3.5 font-bold text-primary-foreground shadow-md transition-all hover:bg-primary/95 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
          >
            <svg
              aria-hidden="true"
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 00-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
              ></path>
            </svg>
            {t('common.notFound.backHome', { fallback: 'Return to Homepage' })}
          </a>
          <a
            href={`/${supportedLang}/contact/`}
            class="rounded-xl border border-gray-200 bg-white px-8 py-3.5 font-bold text-gray-700 transition-all hover:bg-gray-100 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-800 dark:text-gray-200 dark:hover:bg-slate-700"
          >
            {t('common.contactUs', { fallback: 'Contact Support' })}
          </a>
        </div>

        <!-- Quick Links Pill Cloud -->
        <div class="border-t border-gray-200/60 pt-6 dark:border-slate-800">
          <p
            class="mb-3 text-xs font-semibold tracking-wider text-gray-400 uppercase dark:text-gray-500"
          >
            {
              supportedLang === 'fa'
                ? 'دسترسی سریع'
                : supportedLang === 'ar'
                  ? 'روابط سريعة'
                  : 'Quick Site Navigation'
            }
          </p>
          <div class="flex flex-wrap justify-center gap-2">
            {
              quickLinks.map((link) => (
                <a
                  href={link.url}
                  class="rounded-lg border border-gray-200 bg-white px-3.5 py-1.5 text-sm text-gray-700 shadow-xs transition-colors hover:border-primary/40 hover:text-primary focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-800 dark:text-gray-200 dark:hover:text-primary"
                >
                  {link.label}
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Featured Services Section for AEO / Link Equity Retention -->
      <div class="space-y-6 text-start">
        <h3 class="text-center text-2xl font-bold text-gray-900 dark:text-white">
          {
            supportedLang === 'fa'
              ? 'خدمات محبوب وب‌اِی‌بی‌سی'
              : supportedLang === 'ar'
                ? 'خدماتنا المميزة'
                : 'Popular Digital Services'
          }
        </h3>
        <ServicesSection lang={supportedLang} />
      </div>

      <!-- Conversion CTA Callout -->
      <CTA
        lang={supportedLang}
        title={t('common.freeConsultation', { fallback: 'Need help with Web Design or SEO?' })}
        description={supportedLang === 'fa'
          ? 'تیم متخصصین وب‌اِی‌بی‌سی آماده ارائه مشاوره رایگان سئو و طراحی سایت به شماست.'
          : supportedLang === 'ar'
            ? 'فريق خبراء WebABC مستعد لتقديم استشارة مجانية حول التصميم وتحسين محركات البحث.'
            : 'Speak with our technical team today to audit your web application or digital marketing strategy.'}
        buttonText={t('common.contactUs', { fallback: 'Get in Touch' })}
      />
    </div>
  </section>
</Layout>
