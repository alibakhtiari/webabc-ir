---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/astro/Hero.astro';
import ServicesSection from '@/components/astro/ServicesSection.astro';
import CTA from '@/components/astro/CTA.astro';
import { getLanguageStaticPaths, type SupportedLanguage } from '@/types/language';
import { getDictionary } from '@/i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);

const t = createTranslator(dictionary);

const title = `${t('common.notFound.title', { fallback: '404 - Page Not Found' })} | WebABC`;
const description = t('common.notFound.subtitle', {
  fallback:
    'The page you requested could not be found. Explore our services or return to the homepage.',
});

const breadcrumbs = [{ label: t('common.home'), url: `/${supportedLang}/` }, { label: '404' }];

const origin = 'https://webabc.ir';

const pageNotFoundSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${origin}/${supportedLang}/404#webpage`,
  url: `${origin}/${supportedLang}/404`,
  name: title,
  description: description,
  inLanguage: supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR',
  isPartOf: { '@id': `${origin}/${supportedLang}/#website` },
  publisher: { '@id': `${origin}/#organization` },
};

const quickLinks = [
  { label: t('common.home'), url: `/${supportedLang}/` },
  { label: t('common.services'), url: `/${supportedLang}/services/` },
  { label: t('common.portfolio'), url: `/${supportedLang}/portfolio/` },
  { label: t('common.about'), url: `/${supportedLang}/about/` },
  { label: t('common.contact'), url: `/${supportedLang}/contact/` },
];
---

<Layout title={title} description={description} lang={supportedLang} slug="404" noindex={true}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(pageNotFoundSchema)} />

  <Hero
    title={t('common.notFound.title', { fallback: 'Page Not Found' })}
    description={t('common.notFound.subtitle', {
      fallback:
        'The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.',
    })}
    breadcrumbs={breadcrumbs}
    lang={supportedLang}
  />

  <section class="bg-[var(--bg-canvas)] py-16 font-persian font-sans">
    <div class="container mx-auto max-w-4xl space-y-12 px-4 text-center">
      <!-- Interactive 404 Terminal Card -->
      <div class="terminal-window">
        <div class="terminal-chrome-bar" dir="ltr">
          <span class="font-mono text-xs font-bold text-[var(--accent-coral)]">
            ╭─ /ERROR-404 · lost-in-space-404.js ─╮
          </span>
          <span class="monospace-telemetry-pill">STATUS 404 · RECOVERY</span>
        </div>

        <div
          class="crt-scanlines overflow-x-auto border-b border-[var(--border-hairline)] bg-[var(--bg-canvas)] py-2"
          dir="ltr"
          style="min-height: 210px; unicode-bidi: isolate;"
        >
          <ascii-art
            piece="lost-in-space-404"
            size="11"
            speed="1"
            look="original"
            role="img"
            aria-label="404 route not found ASCII telemetry"
          ></ascii-art>
        </div>

        <div class="space-y-6 p-8 md:p-10">
          <span class="monospace-telemetry-pill text-[var(--accent-coral)]" dir="ltr">
            Error 404
          </span>
          <h2 class="text-2xl leading-tight font-extrabold text-[var(--text-primary)] md:text-3xl">
            {
              supportedLang === 'fa'
                ? 'صفحه مورد نظر شما پیدا نشد'
                : supportedLang === 'ar'
                  ? 'الصفحة المطلوبة غير موجودة'
                  : 'Looking for Web Design or SEO Services?'
            }
          </h2>
          <p class="mx-auto max-w-2xl leading-relaxed text-[var(--text-secondary)]">
            {
              supportedLang === 'fa'
                ? 'ممکن است آدرس صفحه تغییر کرده یا حذف شده باشد. از لینک‌های سریع زیر برای دسترسی به بخش‌های اصلی سایت استفاده کنید.'
                : supportedLang === 'ar'
                  ? 'قد تكون الصفحة قد تم نقلها أو حذفها. يمكنك استخدام الروابط السريعة أدناه للوصول إلى أقسام الموقع الرئيسية.'
                  : 'The link you followed may be broken or the page has moved. Browse our core agency solutions below or head straight to our home page.'
            }
          </p>

          <!-- Navigation Buttons -->
          <div class="flex flex-wrap justify-center gap-3 pt-2">
            <a
              href={`/${supportedLang}/`}
              class="inline-flex items-center gap-2 rounded border border-[var(--accent-green)] bg-[var(--accent-green-dim)] px-6 py-3 font-mono text-xs font-bold text-white transition-all hover:bg-[var(--accent-green)] hover:text-[#090b0e] sm:text-sm"
            >
              <span>{t('common.notFound.backHome', { fallback: 'Return to Homepage' })}</span>
            </a>
            <a
              href={`/${supportedLang}/contact/`}
              class="rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-6 py-3 font-mono text-xs font-bold text-[var(--text-primary)] transition-all hover:border-[var(--accent-blue)] hover:text-[var(--accent-blue)] sm:text-sm"
            >
              {t('common.contactUs', { fallback: 'Contact Support' })}
            </a>
          </div>

          <!-- Quick Links Pill Cloud -->
          <div class="border-t border-[var(--border-hairline)] pt-6">
            <p class="mb-3 font-mono text-xs font-semibold tracking-wider text-[var(--text-secondary)] uppercase">
              {
                supportedLang === 'fa'
                  ? 'دسترسی سریع'
                  : supportedLang === 'ar'
                    ? 'روابط سريعة'
                    : 'Quick Site Navigation'
              }
            </p>
            <div class="flex flex-wrap justify-center gap-2">
              {
                quickLinks.map((link) => (
                  <a
                    href={link.url}
                    class="rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3.5 py-1.5 text-xs text-[var(--text-primary)] transition-colors hover:border-[var(--accent-green)] hover:text-[var(--accent-green)]"
                  >
                    {link.label}
                  </a>
                ))
              }
            </div>
          </div>

          <!-- Machine-Readable Agent Recovery Links -->
          <nav aria-label="Agent recovery links" class="border-t border-[var(--border-hairline)] pt-5 text-xs">
            <p class="font-mono font-semibold tracking-wider text-[var(--text-secondary)] uppercase">
              {
                supportedLang === 'fa'
                  ? 'راهنمای ربات‌ها و بازیابی آدرس'
                  : supportedLang === 'ar'
                    ? 'روابط استرداد الذكاء الاصطناعي'
                    : 'Agent & Crawler Recovery Links'
              }
            </p>
            <div class="ltr-isolate mt-2.5 flex flex-wrap justify-center gap-3 font-mono text-[11px]" dir="ltr">
              <a href={`/${supportedLang}/llms.txt`} class="text-[var(--accent-blue)] underline hover:text-[var(--accent-green)]">/{supportedLang}/llms.txt</a>
              <span class="text-[var(--border-focus)]">•</span>
              <a href={`/${supportedLang}/llms-full.txt`} class="text-[var(--accent-blue)] underline hover:text-[var(--accent-green)]">/{supportedLang}/llms-full.txt</a>
              <span class="text-[var(--border-focus)]">•</span>
              <a href="/sitemap-index.xml" class="text-[var(--accent-blue)] underline hover:text-[var(--accent-green)]">/sitemap-index.xml</a>
              <span class="text-[var(--border-focus)]">•</span>
              <a href="/404.md" class="text-[var(--accent-blue)] underline hover:text-[var(--accent-green)]">/404.md</a>
            </div>
          </nav>
        </div>
      </div>

      <!-- Featured Services Section for AEO / Link Equity Retention -->
      <div class="space-y-6 text-start">
        <h3 class="text-center text-2xl font-bold text-[var(--text-primary)]">
          {
            supportedLang === 'fa'
              ? 'خدمات محبوب وب اِی‌بی‌سی'
              : supportedLang === 'ar'
                ? 'خدماتنا المميزة'
                : 'Popular Digital Services'
          }
        </h3>
        <ServicesSection lang={supportedLang} />
      </div>

      <!-- Conversion CTA Callout -->
      <CTA
        lang={supportedLang}
        title={t('common.freeConsultation', { fallback: 'Need help with Web Design or SEO?' })}
        description={supportedLang === 'fa'
          ? 'تیم متخصصین وب اِی‌بی‌سی آماده ارائه مشاوره رایگان سئو و طراحی سایت به شماست.'
          : supportedLang === 'ar'
            ? 'فريق خبراء WebABC مستعد لتقديم استشارة مجانية حول التصميم وتحسين محركات البحث.'
            : 'Speak with our technical team today to audit your web application or digital marketing strategy.'}
        buttonText={t('common.contactUs', { fallback: 'Get in Touch' })}
      />
    </div>
  </section>
</Layout>
