---
import { Picture } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/astro/Breadcrumbs.astro';
import FAQ from '@/components/astro/FAQ.astro';
import { getLanguageStaticPaths, type SupportedLanguage, languages } from '@/types/language';
import { getDictionary } from '@/i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';
import { breadcrumbId, canonicalPageUrl, webpageId, websiteId } from '@/utils/schemaIds';
import industrialHeroImg from '@/assets/images/services/industrial-web-design.webp';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);
const isRtl = languages[supportedLang]?.direction === 'rtl';
const fontClass =
  supportedLang === 'fa' ? 'font-persian' : supportedLang === 'ar' ? 'font-arabic' : 'font-sans';

const t = createTranslator(dictionary);

const pageTitle = t('industrial.pageTitle', {
  fallback: 'Industrial Web Design & B2B Manufacturing SEO',
});
const pageDescription = t('industrial.pageDescription', {
  fallback: 'Specialized web design and B2B SEO for industrial enterprises, factories, and manufacturers.',
});
const heroHeading = t('industrial.heroHeading', {
  fallback: 'Industrial Web Design & Technical B2B SEO',
});
const heroSubtitle = t('industrial.heroSubtitle', {
  fallback: 'Transform your manufacturing website into a high-converting B2B pipeline.',
});

const breadcrumbs = [
  { label: t('common.home', { fallback: 'Home' }), url: `/${supportedLang}/` },
  { label: t('services.title', { fallback: 'Services' }), url: `/${supportedLang}/services/` },
  { label: pageTitle },
];

const pageUrl = canonicalPageUrl(`/${supportedLang}/industrial-web-design/`);
const inLang = supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR';

const faqItems = [
  { question: t('industrial.q1'), answer: t('industrial.a1') },
  { question: t('industrial.q2'), answer: t('industrial.a2') },
  { question: t('industrial.q3'), answer: t('industrial.a3') },
];

const quickAnswer =
  supportedLang === 'fa'
    ? 'طراحی سایت صنعتی و سئوی B2B خدمتی مهندسی ویژه کارخانه‌ها، تولیدکنندگان و شرکت‌های بازرگانی است که کاتالوگ‌های فنی، برگه‌های مشخصات (Datasheet)، فرم‌های استعلام قیمت عمده (RFQ) و اسکیمای استاندارد محصولات صنعتی را روی معماری فوق‌سریع پیاده‌سازی می‌کند تا خریداران سازمانی و مدیران تدارکات مستقیماً از طریق گوگل و موتورهای هوش مصنوعی جذب شوند.'
    : supportedLang === 'ar'
      ? 'تصميم المواقع الصناعية وسيو الشركات (B2B) هو خدمة هندسية مخصصة للمصانع والمنشآت الإنتاجية تحوّل الكتالوجات الفنية وملفات المواصفات ونماذج طلب عروض الأسعار (RFQ) إلى منصة رقمية فائقة السرعة مدعومة ببيانات منظمة، لاستقطاب مديري المشتريات وعقود التوريد مباشرة من جوجل ومحركات البحث الذكية.'
      : 'Industrial web design and B2B manufacturing SEO is a specialized engineering service that pairs sub-second catalog architecture, searchable technical datasheets, multi-SKU Request-for-Quote (RFQ) workflows, and Schema.org Product/Service JSON-LD so factories and industrial suppliers capture procurement leads directly from Google and AI answer engines.';

const industrialSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': webpageId(pageUrl),
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: inLang,
      isPartOf: { '@id': websiteId(supportedLang) },
      about: { '@id': 'https://webabc.ir/#organization' },
      breadcrumb: { '@id': breadcrumbId(pageUrl) },
      mainEntity: { '@id': `${pageUrl}#service` },
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['h1', '.aeo-quick-answer'],
      },
    },
    {
      '@type': 'Service',
      '@id': `${pageUrl}#service`,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      mainEntityOfPage: { '@id': webpageId(pageUrl) },
      provider: {
        '@id': 'https://webabc.ir/#organization',
      },
      serviceType: 'Industrial Web Design & B2B SEO',
      areaServed: ['Iran', 'United Arab Emirates', 'Saudi Arabia', 'Oman'],
      offers: {
        '@type': 'Offer',
        availability: 'https://schema.org/InStock',
        priceSpecification: {
          '@type': 'PriceSpecification',
          priceCurrency: supportedLang === 'fa' ? 'IRR' : 'USD',
        },
      },
    },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} lang={supportedLang} slug="industrial-web-design">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(industrialSchema)} />

  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-linear-to-b from-primary/10 via-background to-background pt-32 pb-16 font-sans md:pt-36 md:pb-24">
    <div class="container mx-auto px-4 max-w-7xl">
      <Breadcrumbs items={breadcrumbs} lang={supportedLang} centered={false} />

      <div class="mt-8 grid grid-cols-1 items-center gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/5 px-3 py-1 text-xs font-medium text-primary">
            <span>{t('industrial.eyebrow')}</span>
          </div>

          <h1 class={`text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl lg:text-5xl dark:text-white ${fontClass}`}>
            {heroHeading}
          </h1>

          <p class={`text-base leading-relaxed text-gray-600 sm:text-lg dark:text-gray-300 ${fontClass}`}>
            {heroSubtitle}
          </p>

          <!-- Architecture Badges -->
          <div class="flex flex-wrap items-center gap-2 pt-1">
            <span class="inline-flex items-center gap-1 rounded-md border border-emerald-500/20 bg-emerald-500/10 px-2.5 py-1 text-xs font-medium text-emerald-700 dark:text-emerald-400">
              ✓ B2B RFQ Architecture
            </span>
            <span class="inline-flex items-center gap-1 rounded-md border border-blue-500/20 bg-blue-500/10 px-2.5 py-1 text-xs font-medium text-blue-700 dark:text-blue-400">
              ✓ Specs Catalog Engine
            </span>
            <span class="inline-flex items-center gap-1 rounded-md border border-purple-500/20 bg-purple-500/10 px-2.5 py-1 text-xs font-medium text-purple-700 dark:text-purple-400">
              ✓ Industrial Schema JSON-LD
            </span>
          </div>

          <!-- Hero Actions -->
          <div class={`flex flex-col sm:flex-row gap-3 pt-2 ${fontClass}`}>
            <a
              href={`/${supportedLang}/consultation/`}
              class="inline-flex h-12 items-center justify-center gap-2 rounded-lg bg-primary px-6 text-sm font-bold text-primary-foreground shadow-md transition-colors hover:bg-primary/90 focus-visible:ring-2 focus-visible:ring-primary"
            >
              <span>{t('industrial.rfqButton')}</span>
              <span aria-hidden="true">{isRtl ? '←' : '→'}</span>
            </a>
            <a
              href={`/${supportedLang}/tools/cost-calculator/`}
              class="inline-flex h-12 items-center justify-center gap-2 rounded-lg border border-gray-200 bg-white px-6 text-sm font-semibold text-gray-700 transition-colors hover:bg-gray-50 dark:border-slate-700 dark:bg-slate-800 dark:text-gray-200 dark:hover:bg-slate-700"
            >
              <span>
                {supportedLang === 'fa'
                  ? 'برآورد آنلاین هزینه سایت صنعتی'
                  : supportedLang === 'ar'
                    ? 'حاسبة تكلفة الموقع الصناعي'
                    : 'Estimate B2B Project Cost'}
              </span>
            </a>
            <a
              href="tel:+989125811880"
              class="inline-flex h-12 items-center justify-center gap-2 rounded-lg border border-gray-200 bg-white px-4 text-sm font-semibold text-primary transition-colors hover:bg-gray-50 dark:border-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700"
              title={supportedLang === 'fa' ? 'تماس مستقیم با سرپرست فنی' : 'Direct Call'}
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span dir="ltr">+98 912 581 1880</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="relative overflow-hidden rounded-2xl border border-gray-100 bg-white p-2 shadow-2xl dark:border-slate-800 dark:bg-slate-900">
            <Picture
              src={industrialHeroImg}
              formats={['avif', 'webp']}
              alt={pageTitle}
              width={600}
              height={500}
              class="h-auto w-full rounded-xl object-cover"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class={`mx-auto w-full max-w-7xl px-4 pt-12 pb-20 sm:px-6 lg:px-8 ${fontClass}`}>
    <!-- AEO Quick Answer Capsule -->
    <aside
      aria-label={supportedLang === 'fa' ? 'خلاصه مهندسی سایت صنعتی' : supportedLang === 'ar' ? 'ملخص الخدمة' : 'Quick Overview'}
      class="aeo-quick-answer mb-16 rounded-2xl border-s-4 border-primary bg-primary/5 p-6 dark:bg-slate-900/80"
    >
      <p class="text-sm leading-relaxed text-gray-800 sm:text-base dark:text-gray-200">
        {quickAnswer}
      </p>
    </aside>

    <!-- Section: Why Traditional Industrial Sites Fail -->
    <div>
      <div class="text-center">
        <h2 class="text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white">
          {t('industrial.painSectionTitle')}
        </h2>
        <p class="mx-auto mt-2 max-w-2xl text-sm leading-relaxed text-gray-600 sm:text-base dark:text-gray-300">
          {t('industrial.painSectionSubtitle')}
        </p>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl border border-red-100 bg-red-50/40 p-6 transition-shadow hover:shadow-md dark:border-red-950/40 dark:bg-red-950/10">
          <div class="font-mono text-xs font-bold text-rose-600 dark:text-rose-400">[PROBLEM 01]</div>
          <h3 class="mt-2 text-base font-bold text-gray-900 dark:text-white">
            {t('industrial.pain1Title')}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
            {t('industrial.pain1Desc')}
          </p>
        </div>

        <div class="rounded-2xl border border-red-100 bg-red-50/40 p-6 transition-shadow hover:shadow-md dark:border-red-950/40 dark:bg-red-950/10">
          <div class="font-mono text-xs font-bold text-rose-600 dark:text-rose-400">[PROBLEM 02]</div>
          <h3 class="mt-2 text-base font-bold text-gray-900 dark:text-white">
            {t('industrial.pain2Title')}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
            {t('industrial.pain2Desc')}
          </p>
        </div>

        <div class="rounded-2xl border border-red-100 bg-red-50/40 p-6 transition-shadow hover:shadow-md dark:border-red-950/40 dark:bg-red-950/10">
          <div class="font-mono text-xs font-bold text-rose-600 dark:text-rose-400">[PROBLEM 03]</div>
          <h3 class="mt-2 text-base font-bold text-gray-900 dark:text-white">
            {t('industrial.pain3Title')}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
            {t('industrial.pain3Desc')}
          </p>
        </div>

        <div class="rounded-2xl border border-red-100 bg-red-50/40 p-6 transition-shadow hover:shadow-md dark:border-red-950/40 dark:bg-red-950/10">
          <div class="font-mono text-xs font-bold text-rose-600 dark:text-rose-400">[PROBLEM 04]</div>
          <h3 class="mt-2 text-base font-bold text-gray-900 dark:text-white">
            {t('industrial.pain4Title')}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
            {t('industrial.pain4Desc')}
          </p>
        </div>
      </div>
    </div>

    <!-- Section: The WebABC Solution Blueprint -->
    <div class="mt-20">
      <div class="text-center">
        <h2 class="text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white">
          {t('industrial.solutionSectionTitle')}
        </h2>
        <p class="mx-auto mt-2 max-w-2xl text-sm leading-relaxed text-gray-600 sm:text-base dark:text-gray-300">
          {t('industrial.solutionSectionSubtitle')}
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-xs transition-colors hover:border-primary/50 hover:shadow-md dark:border-slate-800 dark:bg-slate-900">
          <div class="flex items-center justify-between border-b border-gray-100 pb-3 dark:border-slate-800" dir={isRtl ? 'rtl' : 'ltr'}>
            <span class="text-xs font-semibold text-primary">ENGINE 01 · RFQ ARCHITECTURE</span>
            <span class="inline-flex rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">Interactive</span>
          </div>
          <div class="pt-4">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white">
              {t('industrial.sol1Title')}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
              {t('industrial.sol1Desc')}
            </p>
          </div>
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-xs transition-colors hover:border-primary/50 hover:shadow-md dark:border-slate-800 dark:bg-slate-900">
          <div class="flex items-center justify-between border-b border-gray-100 pb-3 dark:border-slate-800" dir={isRtl ? 'rtl' : 'ltr'}>
            <span class="text-xs font-semibold text-primary">ENGINE 02 · SPECS & DATASHEETS</span>
            <span class="inline-flex rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">Dynamic</span>
          </div>
          <div class="pt-4">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white">
              {t('industrial.sol2Title')}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
              {t('industrial.sol2Desc')}
            </p>
          </div>
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-xs transition-colors hover:border-primary/50 hover:shadow-md dark:border-slate-800 dark:bg-slate-900">
          <div class="flex items-center justify-between border-b border-gray-100 pb-3 dark:border-slate-800" dir={isRtl ? 'rtl' : 'ltr'}>
            <span class="text-xs font-semibold text-primary">ENGINE 03 · B2B TECHNICAL SEO</span>
            <span class="inline-flex rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">High Intent</span>
          </div>
          <div class="pt-4">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white">
              {t('industrial.sol3Title')}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
              {t('industrial.sol3Desc')}
            </p>
          </div>
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-xs transition-colors hover:border-primary/50 hover:shadow-md dark:border-slate-800 dark:bg-slate-900">
          <div class="flex items-center justify-between border-b border-gray-100 pb-3 dark:border-slate-800" dir={isRtl ? 'rtl' : 'ltr'}>
            <span class="text-xs font-semibold text-primary">ENGINE 04 · INDUSTRIAL JSON-LD</span>
            <span class="inline-flex rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">Schema.org</span>
          </div>
          <div class="pt-4">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white">
              {t('industrial.sol4Title')}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
              {t('industrial.sol4Desc')}
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Section: Real Case Studies -->
    <div id="cases" class="mt-20 scroll-mt-24">
      <div class="text-center">
        <div class="mb-2 flex justify-center">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/5 px-3 py-1 text-xs font-medium text-primary">
            {supportedLang === 'fa' ? 'شواهد مستند پروژه‌ها' : supportedLang === 'ar' ? 'سجل مشاريع موثقة' : 'Verified Case Evidence'}
          </span>
        </div>
        <h2 class="text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white">
          {t('industrial.casesSectionTitle')}
        </h2>
        <p class="mx-auto mt-2 max-w-2xl text-sm leading-relaxed text-gray-600 sm:text-base dark:text-gray-300">
          {t('industrial.casesSectionSubtitle')}
        </p>
      </div>

      <div class="mt-10 space-y-8">
        <!-- Case 1: Tehran Enamel -->
        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md dark:border-slate-800 dark:bg-slate-900 sm:p-8">
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-100 pb-4 dark:border-slate-800">
            <div>
              <span class="text-xs font-semibold text-primary uppercase">Case 01 · Industrial Metallurgy</span>
              <h3 class="text-xl font-bold text-gray-900 sm:text-2xl dark:text-white">
                {t('industrial.case1Name')}
              </h3>
            </div>
            <span class="inline-flex items-center rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-700 dark:text-emerald-400">
              {t('industrial.case1Badge')}
            </span>
          </div>

          <div class="mt-6 grid gap-6 md:grid-cols-3">
            <div class="rounded-xl border border-gray-100 bg-gray-50/70 p-4 dark:border-slate-800 dark:bg-slate-800/40">
              <div class="text-xs font-bold text-rose-600 dark:text-rose-400">
                [01 · {t('industrial.case1ProblemLabel')}]
              </div>
              <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                {t('industrial.case1Problem')}
              </p>
            </div>

            <div class="rounded-xl border border-gray-100 bg-gray-50/70 p-4 dark:border-slate-800 dark:bg-slate-800/40">
              <div class="text-xs font-bold text-blue-600 dark:text-blue-400">
                [02 · {t('industrial.case1SolutionLabel')}]
              </div>
              <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                {t('industrial.case1Solution')}
              </p>
            </div>

            <div class="rounded-xl border border-emerald-500/30 bg-emerald-50/40 p-4 dark:border-emerald-500/20 dark:bg-emerald-950/20">
              <div class="text-xs font-bold text-emerald-700 dark:text-emerald-400">
                [03 · {t('industrial.case1ResultLabel')}]
              </div>
              <p class="mt-2 text-sm leading-relaxed font-semibold text-gray-900 dark:text-white">
                {t('industrial.case1Result')}
              </p>
            </div>
          </div>

          <div class="mt-6 flex items-center justify-end">
            <a
              href={`/${supportedLang}/portfolio/tehran-enamel/`}
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline"
            >
              <span>{supportedLang === 'fa' ? 'مطالعه کامل کیس‌استدی توسعه لعاب تهران' : supportedLang === 'ar' ? 'قراءة دراسة حالة توسعه لعاب بالكامل' : 'Read Full Tehran Enamel Case Study'}</span>
              <span aria-hidden="true">{isRtl ? '←' : '→'}</span>
            </a>
          </div>
        </div>

        <!-- Case 2: Mapfan -->
        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md dark:border-slate-800 dark:bg-slate-900 sm:p-8">
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-100 pb-4 dark:border-slate-800">
            <div>
              <span class="text-xs font-semibold text-primary uppercase">Case 02 · Plant Automation</span>
              <h3 class="text-xl font-bold text-gray-900 sm:text-2xl dark:text-white">
                {t('industrial.case2Name')}
              </h3>
            </div>
            <span class="inline-flex items-center rounded-full bg-blue-500/10 px-3 py-1 text-xs font-semibold text-blue-700 dark:text-blue-400">
              {t('industrial.case2Badge')}
            </span>
          </div>

          <div class="mt-6 grid gap-6 md:grid-cols-3">
            <div class="rounded-xl border border-gray-100 bg-gray-50/70 p-4 dark:border-slate-800 dark:bg-slate-800/40">
              <div class="text-xs font-bold text-rose-600 dark:text-rose-400">
                [01 · {t('industrial.case2ProblemLabel')}]
              </div>
              <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                {t('industrial.case2Problem')}
              </p>
            </div>

            <div class="rounded-xl border border-gray-100 bg-gray-50/70 p-4 dark:border-slate-800 dark:bg-slate-800/40">
              <div class="text-xs font-bold text-blue-600 dark:text-blue-400">
                [02 · {t('industrial.case2SolutionLabel')}]
              </div>
              <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                {t('industrial.case2Solution')}
              </p>
            </div>

            <div class="rounded-xl border border-blue-500/30 bg-blue-50/40 p-4 dark:border-blue-500/20 dark:bg-blue-950/20">
              <div class="text-xs font-bold text-blue-700 dark:text-blue-400">
                [03 · {t('industrial.case2ResultLabel')}]
              </div>
              <p class="mt-2 text-sm leading-relaxed font-semibold text-gray-900 dark:text-white">
                {t('industrial.case2Result')}
              </p>
            </div>
          </div>

          <div class="mt-6 flex items-center justify-end">
            <a
              href={`/${supportedLang}/portfolio/mapfan/`}
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline"
            >
