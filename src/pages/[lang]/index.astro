---
import Layout from '@/layouts/Layout.astro';
import HeroSection from '@/components/astro/HeroSection.astro';
import ServicesSection from '@/components/astro/ServicesSection.astro';
import BenefitsSection from '@/components/astro/BenefitsSection.astro';
import CaseStudiesPreviewSection from '@/components/astro/CaseStudiesPreviewSection.astro';
import FreeToolsSection from '@/components/astro/FreeToolsSection.astro';
import CTASection from '@/components/astro/CTASection.astro';
import FAQ from '@/components/astro/FAQ.astro';
import { getLanguageStaticPaths, type SupportedLanguage } from '@/types/language';
import { getDictionary } from '@/i18n/get-dictionary';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;

const dictionary = await getDictionary(supportedLang);
const title = dictionary.home?.title || 'WebABC';
const description = dictionary.home?.description || 'Web Design and Development Services';
const homeFaqList = [1, 2, 3, 4]
  .map((n) => ({
    question: dictionary.home?.faq?.[`q${n}`] || '',
    answer: dictionary.home?.faq?.[`a${n}`] || '',
  }))
  .filter((item) => item.question && item.answer);
---

<Layout
  title={title}
  description={description}
  lang={supportedLang}
  slug=""
  mainClass="relative overflow-x-hidden pt-0"
>
  <HeroSection lang={supportedLang} />
  <ServicesSection lang={supportedLang} />
  <BenefitsSection lang={supportedLang} />
  <CaseStudiesPreviewSection lang={supportedLang} />
  <FreeToolsSection lang={supportedLang} />
  {
    homeFaqList.length > 0 && (
      <section class="border-b border-[var(--border-hairline)] bg-[var(--bg-canvas)] py-12 md:py-16">
        <div class="container mx-auto max-w-4xl px-4">
          <FAQ faqList={homeFaqList} lang={supportedLang} />
        </div>
      </section>
    )
  }
  <CTASection lang={supportedLang} />
</Layout>
