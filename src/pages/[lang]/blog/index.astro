---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/astro/Breadcrumbs.astro';
import OptimizedImage from '@/components/astro/OptimizedImage.astro';
import { getLanguageStaticPaths, type SupportedLanguage } from '@/types/language';
import { getDictionary } from '@/i18n/get-dictionary';
import { getCollection } from 'astro:content';
import { createTranslator } from '@/i18n/translate';
import { getCategoryLabel } from '@/utils/category-translator';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);
const isRtl = supportedLang === 'fa' || supportedLang === 'ar';
const fontClass =
  supportedLang === 'en' ? 'font-sans' : supportedLang === 'ar' ? 'font-arabic' : 'font-persian';
const metaFontClass = isRtl ? fontClass : 'font-mono';

// Helper to translate strings
const t = createTranslator(dictionary);

// Fetch items
const allBlogEntries = await getCollection('blog');
const posts = allBlogEntries
  .filter((entry) => entry.id.startsWith(`${supportedLang}/`))
  .map((entry) => ({
    ...entry.data,
    slug: entry.id.replace(`${supportedLang}/`, ''),
  }));
const sortedPosts = posts.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
const categories = [...new Set(sortedPosts.map((p) => p.category))];

const titleText = t('blog.title', { fallback: 'Blog' });
const descriptionText = t('blog.blogDescription', {
  fallback: 'Latest Articles and Industry Insights',
});

// Schema definitions
const origin = 'https://webabc.ir';
const currentUrl = `${origin}/${supportedLang}/blog/`;
const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: titleText,
  description: descriptionText,
  url: currentUrl,
  inLanguage: supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR',
  blogPost: sortedPosts.slice(0, 10).map((post) => ({
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.description,
    image: post.image.startsWith('http') ? post.image : `${origin}${post.image}`,
    datePublished: post.date,
    author: {
      '@type': ['Ali Bakhtiari', 'علی بختیاری', 'علي بختياري'].includes(post.author?.trim() ?? '')
        ? 'Person'
        : 'Organization',
      name:
        post.author ||
        (supportedLang === 'fa'
          ? 'تیم وب اِی‌بی‌سی'
          : supportedLang === 'ar'
            ? 'فريق ويب إيه بي سي'
            : 'WebABC Team'),
    },
    url: `${origin}/${supportedLang}/blog/${post.slug}`,
  })),
};

const breadcrumbs = [
  { label: t('common.home'), url: `/${supportedLang}/` },
  { label: t('common.blog') },
];
---

<Layout title={titleText} description={descriptionText} lang={supportedLang} slug="blog">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(blogSchema)} />

  <!-- Hero Section -->
  <section
    class="relative overflow-hidden bg-linear-to-br from-primary/10 via-primary/5 to-background pt-36 pb-20"
  >
    <div class="relative container mx-auto px-4">
      <div class="mx-auto max-w-3xl text-center">
        <Breadcrumbs items={breadcrumbs} lang={supportedLang} centered={true} />
        <h1 class={`mb-6 text-5xl font-bold text-primary md:text-6xl ${fontClass}`}>
          {titleText}
        </h1>
        <p class={`text-xl leading-relaxed text-muted-foreground md:text-2xl ${fontClass}`}>
          {descriptionText}
        </p>
      </div>
    </div>
  </section>

  <!-- Filter Section -->
  <section
    class={`sticky top-20 z-10 border-y border-gray-100 bg-white py-6 shadow-xs dark:border-slate-800 dark:bg-slate-900 ${fontClass}`}
  >
    <div class="container mx-auto px-4">
      <div class="flex flex-wrap items-center justify-center gap-3">
        <span class="text-sm font-semibold text-gray-600 dark:text-gray-400"
          >{t('blog.filterBy', { fallback: 'Filter By' })}:</span
        >
        <a
          href={`/${supportedLang}/blog/?category=all`}
          data-filter-btn="all"
          aria-current="true"
          class="filter-btn cursor-pointer rounded-full bg-primary px-4 py-2 text-xs font-semibold text-primary-foreground shadow-sm transition-all focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
        >
          {t('blog.allCategories', { fallback: 'All Categories' })}
        </a>
        {
          categories.map((category) => (
            <a
              href={`/${supportedLang}/blog/?category=${encodeURIComponent(category)}`}
              data-filter-btn={category}
              aria-current="false"
              class="filter-btn cursor-pointer rounded-full bg-gray-100 px-4 py-2 text-xs font-semibold text-gray-700 transition-all hover:bg-gray-200 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:bg-slate-800 dark:text-gray-300 dark:hover:bg-slate-700"
            >
              {getCategoryLabel(category, supportedLang)}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Blog Posts Grid -->
  <section class="py-16 font-sans">
    <div class="container mx-auto px-4">
      {
        sortedPosts.length === 0 ? (
          <div class={`py-16 text-center ${fontClass}`}>
            <p class="text-xl text-gray-500 dark:text-gray-400">
              {t('common.noResults', { fallback: 'No results found.' })}
            </p>
          </div>
        ) : (
          <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
            {sortedPosts.map((post) => (
              <div
                data-post-card={post.category}
                class="group block overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm transition-all duration-300 hover:shadow-xl dark:border-slate-800 dark:bg-slate-900"
              >
                <a href={`/${supportedLang}/blog/${post.slug}/`} class="block">
                  <div class="relative aspect-video overflow-hidden">
                    <OptimizedImage
                      src={post.image}
                      alt={post.title}
                      width={400}
                      height={225}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  </div>
                  <div class="space-y-4 p-6">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="rounded bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-600 uppercase dark:bg-slate-800 dark:text-gray-300">
                        {getCategoryLabel(post.category, supportedLang)}
                      </span>
                      <span class={`text-xs text-gray-400 dark:text-gray-500 ${metaFontClass}`}>
                        {new Date(post.date).toLocaleDateString(
                          supportedLang === 'ar'
                            ? 'ar-SA'
                            : supportedLang === 'fa'
                              ? 'fa-IR'
                              : 'en-US',
                          {
                            year: 'numeric',
                            month: 'short',
                            day: 'numeric',
                          }
                        )}
                      </span>
                    </div>
                    <h3
                      class={`text-xl leading-snug font-bold text-gray-900 transition-colors group-hover:text-primary dark:text-white ${fontClass}`}
                    >
                      {post.title}
                    </h3>
                    <p
                      class={`line-clamp-3 text-sm leading-relaxed text-gray-500 dark:text-gray-400 ${fontClass}`}
                    >
                      {post.description}
                    </p>

                    <div
                      class={`flex items-center gap-1 text-sm font-semibold text-primary transition-all group-hover:gap-2 ${fontClass}`}
                    >
                      {t('blog.readMore', { fallback: 'Read More' })} {isRtl ? '←' : '→'}
                    </div>
                  </div>
                </a>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </section>
</Layout>

<script is:inline>
  (() => {
    function initBlogFilter() {
      const filterBtns = document.querySelectorAll('[data-filter-btn]');
      const postCards = document.querySelectorAll('[data-post-card]');

      if (!filterBtns.length) return;

      const activeClass =
        'filter-btn px-4 py-2 text-xs font-semibold rounded-full bg-primary text-primary-foreground shadow-sm cursor-pointer transition-all focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2';
      const inactiveClass =
        'filter-btn px-4 py-2 text-xs font-semibold rounded-full bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 text-gray-700 dark:text-gray-300 cursor-pointer transition-all focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2';

      function applyFilter(selected) {
        filterBtns.forEach((b) => {
          b.className = inactiveClass;
          b.removeAttribute('aria-current');
        });
        const activeBtn =
          document.querySelector(`[data-filter-btn="${selected}"]`) ||
          document.querySelector('[data-filter-btn="all"]');
        if (activeBtn) {
          activeBtn.className = activeClass;
          activeBtn.setAttribute('aria-current', 'true');
        }

        postCards.forEach((card) => {
          const cardCat = card.getAttribute('data-post-card');
          if (selected === 'all' || cardCat === selected) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      }

      filterBtns.forEach((btn) => {
        btn.onclick = (e) => {
          e.preventDefault();
          const selected = btn.getAttribute('data-filter-btn');

          applyFilter(selected);

          const url = new URL(window.location);
          if (selected === 'all') {
            url.searchParams.delete('category');
          } else {
            url.searchParams.set('category', selected);
          }
          window.history.pushState({}, '', url);
        };
      });

      const urlParams = new URLSearchParams(window.location.search);
      const initialCategory = urlParams.get('category');
      if (initialCategory) {
        applyFilter(decodeURIComponent(initialCategory));
      }
    }

    document.addEventListener('astro:page-load', initBlogFilter);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initBlogFilter();
    }
  })();
</script>
