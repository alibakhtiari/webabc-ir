---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/astro/Breadcrumbs.astro';
import TableOfContents from '@/components/astro/TableOfContents.astro';
import TLDR from '@/components/astro/TLDR.astro';
import FAQ from '@/components/astro/FAQ.astro';
import OptimizedImage from '@/components/astro/OptimizedImage.astro';
import { getCollection, render } from 'astro:content';
import { type SupportedLanguage, languages } from '@/types/language';
import { getDictionary } from '@/i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';
import { getCategoryLabel } from '@/utils/category-translator';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => {
    const [lang, slug] = post.id.split('/');
    return {
      params: { lang, slug },
      props: { post },
    };
  });
}

const { lang, slug } = Astro.params;
const { post } = Astro.props;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);

if (!post) {
  return Astro.redirect(`/${supportedLang}/404`);
}

// Helper to translate strings
const t = createTranslator(dictionary);
const isRtl = languages[supportedLang]?.direction === 'rtl';
const fontClass =
  supportedLang === 'en' ? 'font-sans' : supportedLang === 'ar' ? 'font-arabic' : 'font-persian';
const metaFontClass = isRtl ? fontClass : 'font-mono';

// Formatter date
const formatDate = (dateString: string | Date) => {
  const date = new Date(dateString);
  return date.toLocaleDateString(
    supportedLang === 'ar' ? 'ar-SA' : supportedLang === 'fa' ? 'fa-IR' : 'en-US',
    {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }
  );
};

// Render content dynamically
const { Content, headings } = await render(post);

const origin = 'https://webabc.ir';

// Author identity is language-agnostic: the same person appears as
// "Ali Bakhtiari" (en), "علی بختیاری" (fa) and "علي بختياري" (ar) in frontmatter.
const ALI_BAKHTIARI_ALIASES = ['Ali Bakhtiari', 'علی بختیاری', 'علي بختياري'];
const isAliBakhtiari = ALI_BAKHTIARI_ALIASES.includes(post.data.author?.trim() ?? '');

// Strip Markdown/MDX/JSX syntax before counting so wordCount reflects actual
// readable text, not markup tokens (code fences, JSX tags, link syntax, etc.)
const plainTextWordCount = (post.body || '')
  .replace(/```[\s\S]*?```/g, ' ')
  .replace(/<[^>]+>/g, ' ')
  .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
  .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
  .replace(/[#*_>`~]/g, ' ')
  .split(/\s+/)
  .filter(Boolean).length;

const translatedAuthor =
  (post.data.author || '').includes('Team') ||
  (post.data.author || '').includes('تیم') ||
  (post.data.author || '').includes('فريق')
    ? supportedLang === 'fa'
      ? 'تیم وب اِی‌بی‌سی'
      : supportedLang === 'ar'
        ? 'فريق ويب إيه بي سي'
        : 'WebABC Team'
    : isAliBakhtiari
      ? supportedLang === 'fa'
        ? 'علی بختیاری'
        : supportedLang === 'ar'
          ? 'علي بختياري'
          : 'Ali Bakhtiari'
      : post.data.author;

// Schema JSON-LDs
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${origin}/${supportedLang}/blog/${slug}/#article`,
  headline: post.data.title,
  description: post.data.description,
  image: post.data.image.startsWith('http') ? post.data.image : `${origin}${post.data.image}`,
  datePublished: post.data.date,
  dateModified: post.data.updatedDate || post.data.date,
  author: isAliBakhtiari
    ? {
        '@type': 'Person',
        name:
          supportedLang === 'fa'
            ? 'علی بختیاری'
            : supportedLang === 'ar'
              ? 'علي بختياري'
              : 'Ali Bakhtiari',
        url: `${origin}/${supportedLang}/about/ali-bakhtiari/`,
        image: `${origin}/ali-bakhtiari.webp`,
        sameAs: [
          'https://www.linkedin.com/in/alibakhtiarii/',
          'https://github.com/alibakhtiari',
          'https://www.instagram.com/aliibakhtiari/',
          'https://www.facebook.com/Alii.bakhtiari',
          'https://x.com/aliib1991',
          'https://alibakhtiari.ir',
          'https://aliib.ir',
        ],
      }
    : {
        '@type': 'Organization',
        name: translatedAuthor,
        url: `${origin}/${supportedLang}/about/`,
        logo: `${origin}/webabc.webp`,
      },

  publisher: {
    '@id': 'https://webabc.ir/#organization',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `${origin}/${supportedLang}/blog/${slug}/`,
  },
  keywords: post.data.tags?.join(', ') || '',
  articleSection: post.data.category,
  wordCount: plainTextWordCount,
  inLanguage: supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR',
};

const breadcrumbs = [
  { label: t('common.home'), url: `/${supportedLang}/` },
  { label: t('common.blog'), url: `/${supportedLang}/blog/` },
  { label: post.data.title },
];

const authorBio = isAliBakhtiari
  ? supportedLang === 'fa'
    ? 'من علی بختیاری هستم، توسعه‌دهنده ۳۵ ساله وردپرس و متخصص سئو با اشتیاق فراوان برای خلق تجربه‌های دیجیتال استثنایی. با سال‌ها تجربه، تخصص من در طراحی و ساخت وب‌سایت‌هایی است که علاوه بر جذابیت بصری، برای موتورهای جستجو نیز بهینه‌سازی شده‌اند.'
    : supportedLang === 'ar'
      ? 'أنا علي بختياري، مطور ووردبريس ومستشار سيو (SEO) أبلغ من العمر 35 عاماً، شغوف بتقديم تجارب رقمية استثنائية. من خلال سنوات خبرتي الطويلة، أتخصص في إنشاء مواقع ويب ليست فقط جذابة بصرياً ولكنها محسنة بالكامل لمحركات البحث.'
      : "I'm Ali Bakhtiari, a 35-year-old WordPress developer and SEO specialist with a passion for crafting exceptional digital experiences. With years of experience under my belt, I specialize in creating websites that are not only visually appealing but also optimized for search engines."
  : supportedLang === 'fa'
    ? 'تیم تخصصی وب اِی‌بی‌سی متشکل از کارشناسان ارشد سئو و طراحان وب با بیش از یک دهه تجربه در توسعه سیستم‌های تحت وب و بهینه‌سازی موتورهای جستجو.'
    : supportedLang === 'ar'
      ? 'فريق خبراء ويب إيه بي سي يضم نخبة من مستشاري السيو ومطوري الويب ذوي الخبرة الطويلة في تحسين محركات البحث وتطوير التطبيقات.'
      : 'The WebABC editorial team consists of senior SEO strategists and web developers with over a decade of experience in building high-performance applications.';

const authorRole = isAliBakhtiari
  ? supportedLang === 'fa'
    ? 'توسعه‌دهنده وردپرس و متخصص سئو'
    : supportedLang === 'ar'
      ? 'مطور ووردبريس وأخصائي سيو'
      : 'WordPress Developer & SEO Specialist'
  : '';
---

<Layout
  title={post.data.title}
  description={post.data.description}
  lang={supportedLang}
  slug={`blog/${slug}`}
  ogImage={post.data.image}
  ogType="article"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleSchema)} />
  <link
    slot="head"
    rel="image_src"
    href={post.data.image.startsWith('http') ? post.data.image : `${origin}${post.data.image}`}
  />
  <meta
    slot="head"
    property="article:published_time"
    content={new Date(post.data.date).toISOString()}
  />
  {
    post.data.updatedDate && (
      <meta
        slot="head"
        property="article:modified_time"
        content={new Date(post.data.updatedDate).toISOString()}
      />
    )
  }
  <meta
    slot="head"
    property="article:author"
    content={isAliBakhtiari ? 'https://aliib.ir/' : `${origin}/${supportedLang}/about/`}
  />
  <meta slot="head" property="article:section" content={post.data.category} />

  <!-- Post Wrapper -->
  <div class="container mx-auto px-4 pt-32 pb-8">
    <div class="mx-auto max-w-3xl">
      <!-- Breadcrumbs Component -->
      <Breadcrumbs items={breadcrumbs} lang={supportedLang} />

      <div class="mb-8 aspect-video overflow-hidden rounded-2xl shadow-xs">
        <OptimizedImage
          src={post.data.image}
          alt={post.data.title}
          width={1200}
          height={630}
          fetchpriority="high"
          loading="eager"
          class="h-full w-full object-cover"
        />
      </div>

      <!-- Post Info Header -->
      <div class="mb-8 space-y-4">
        <div class="flex flex-wrap gap-2">
          <span
            class="rounded bg-primary px-2.5 py-1 text-xs font-semibold text-primary-foreground uppercase"
            >{getCategoryLabel(post.data.category, supportedLang)}</span
          >
          {
            post.data.tags?.map((tag) => (
              <a
                href={`/${supportedLang}/blog/?tag=${encodeURIComponent(tag)}`}
                class="rounded bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-600 transition-all hover:bg-primary/10 hover:text-primary focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:bg-slate-800 dark:text-gray-300"
              >
                #{tag}
              </a>
            ))
          }
        </div>

        <h1
          class={`mb-6 text-4xl leading-tight font-bold text-gray-900 md:text-5xl dark:text-white ${fontClass}`}
        >
          {post.data.title}
        </h1>

        <div
          class={`flex flex-wrap items-center gap-4 text-sm text-gray-500 dark:text-gray-400 ${metaFontClass}`}
        >
          <span class="flex items-center gap-1">
            <svg
              aria-hidden="true"
              class="h-4 w-4 text-gray-500 dark:text-gray-400"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg
            >
            {
              isAliBakhtiari ? (
                <a
                  href={`/${supportedLang}/about/ali-bakhtiari/`}
                  class="transition-colors hover:text-primary focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
                  rel="author"
                >
                  {translatedAuthor}
                </a>
              ) : (
                translatedAuthor
              )
            }
          </span>
          <span class="flex items-center gap-1">
            <svg
              aria-hidden="true"
              class="h-4 w-4 text-gray-500 dark:text-gray-400"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path></svg
            >
            {formatDate(post.data.date)}
          </span>
          {
            post.data.updatedDate && (
              <span class="flex items-center gap-1 text-primary">
                <svg
                  aria-hidden="true"
                  class="h-4 w-4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                  />
                </svg>
                {t('blog.updated', { fallback: 'Updated' })}: {formatDate(post.data.updatedDate)}
              </span>
            )
          }
          <span class="flex items-center gap-1">
            <svg
              aria-hidden="true"
              class="h-4 w-4 text-gray-500 dark:text-gray-400"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
            >
            {post.data.readTime}
            {t('blog.minuteRead', { fallback: 'mins' })}
          </span>
        </div>
      </div>

      <!-- Table of Contents Component -->
      <TableOfContents headings={headings} lang={supportedLang} />

      <!-- TLDR Component (Key Takeaways summary callout) -->
      {
        post.data.keyTakeaways && post.data.keyTakeaways.length > 0 && (
          <TLDR takeaways={post.data.keyTakeaways} lang={supportedLang} />
        )
      }

      <!-- Content Body -->
      <article class="prose prose-lg mb-12 max-w-none font-persian dark:prose-invert">
        <Content components={{ img: OptimizedImage }} />
      </article>

      <!-- EEAT Author Box Component -->
      <div
        class="my-12 flex flex-col items-center gap-6 rounded-2xl border border-gray-100 bg-white p-6 font-persian shadow-xs md:flex-row md:items-start md:p-8 dark:border-slate-800 dark:bg-slate-900"
      >
        <h2 class="sr-only">About the Author</h2>
        {
          isAliBakhtiari ? (
            <div class="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-full border-2 border-white bg-gray-50 shadow-md ring-4 ring-primary/10 dark:border-slate-700 dark:bg-slate-800">
              <OptimizedImage
                src="/ali-bakhtiari.webp"
                alt={`${translatedAuthor} - WebABC`}
                class="h-full w-full object-cover"
                width={64}
                height={64}
              />
            </div>
          ) : (
            <div class="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-full border border-gray-100 bg-gray-50 dark:border-slate-700 dark:bg-slate-800">
              <OptimizedImage
                src="/images/logo.webp"
                alt="WebABC Agency Logo"
                class="h-auto w-12"
                width={48}
                height={48}
                loading="lazy"
              />
            </div>
          )
        }
        <div class="grow space-y-3 text-center md:text-start">
          <div class="space-y-0.5">
            <p class="text-xs font-bold tracking-wider text-primary uppercase">
              {t('blog.author', { fallback: 'Author' })}
            </p>
            <p class="text-lg font-bold text-gray-900 dark:text-white">{translatedAuthor}</p>
            {
              authorRole && (
                <p class="text-xs font-medium text-gray-500 dark:text-gray-400">{authorRole}</p>
              )
            }
          </div>
          <p class="max-w-2xl text-sm leading-relaxed text-gray-600 dark:text-gray-300">
            {authorBio}
          </p>

          {
            isAliBakhtiari && (
              <div class="flex flex-wrap justify-center gap-4 pt-2 md:justify-start">
                <a
                  href="https://www.linkedin.com/in/alibakhtiarii/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-gray-500 transition-colors hover:text-[#0077b5] dark:text-gray-400"
                  title="LinkedIn"
                >
                  <svg aria-hidden="true" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                  </svg>
                </a>
                <a
                  href="https://github.com/alibakhtiari"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-gray-500 transition-colors hover:text-[#24292e] dark:text-gray-400"
                  title="GitHub"
                >
                  <svg aria-hidden="true" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                    <path
                      fill-rule="evenodd"
                      clip-rule="evenodd"
                      d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.579.688.481C19.137 20.162 22 16.418 22 12c0-5.523-4.477-10-10-10z"
                    />
                  </svg>
                </a>
                <a
                  href="https://www.instagram.com/aliibakhtiari/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-gray-500 transition-colors hover:text-[#e1306c] dark:text-gray-400"
                  title="Instagram"
                >
                  <svg
                    aria-hidden="true"
                    class="h-5 w-5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <>
                      <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                      <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                    </>
                  </svg>
                </a>
                <a
                  href="https://www.facebook.com/Alii.bakhtiari"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-gray-500 transition-colors hover:text-[#1877f2] dark:text-gray-400"
                  title="Facebook"
                >
                  <svg aria-hidden="true" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z" />
                  </svg>
                </a>
                <a
                  href="https://x.com/aliib1991"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-gray-500 transition-colors hover:text-[#1da1f2] dark:text-gray-400"
                  title="Twitter (X)"
                >
                  <svg aria-hidden="true" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                  </svg>
                </a>
                <a
                  href="https://aliib.ir/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-gray-500 transition-colors hover:text-primary dark:text-gray-400"
                  title="Website"
                >
                  <svg
                    aria-hidden="true"
                    class="h-5 w-5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <>
                      <circle cx="12" cy="12" r="10" />
                      <line x1="2" y1="12" x2="22" y2="12" />
                      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                    </>
                  </svg>
                </a>
                <a
                  href="mailto:Ali.Bakhtiarii@gmail.com"
                  class="text-gray-500 transition-colors hover:text-[#dd4b39] dark:text-gray-400"
                  title="Email"
                >
                  <svg
                    aria-hidden="true"
                    class="h-5 w-5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <>
                      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                      <polyline points="22,6 12,13 2,6" />
                    </>
                  </svg>
                </a>
              </div>
            )
          }
        </div>
      </div>

      <!-- FAQ Component -->
      {
        post.data.faq && post.data.faq.length > 0 && (
          <FAQ faqList={post.data.faq} lang={supportedLang} />
        )
      }
    </div>
  </div>
</Layout>
