                      const relLabel = getCategoryLabel(rel.category, supportedLang);
                      return relLabel ? (
                        <span class="absolute top-2.5 start-2.5 rounded-md bg-black/60 backdrop-blur-xs px-2 py-0.5 text-[10px] font-bold text-white uppercase">
