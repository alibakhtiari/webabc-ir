const defaultServiceTool: Record<SupportedLanguage, ServiceToolMeta> = {
  fa: {
    serviceUrl: '/fa/services/web-design/',
    serviceTitle: 'خدمات طراحی سایت و توسعه وب',
    serviceDesc: 'راهکارهای جامع توسعه دیجیتال، سئو تکنیکال و تجربه کاربری مدرن.',
    toolUrl: '/fa/tools/headline-analyzer/',
    toolTitle: 'تحلیل‌گر آنلاین هدلاین و عنوان سئو',
  },
  en: {
    serviceUrl: '/en/services/web-design/',
    serviceTitle: 'Web Design & Digital Growth Solutions',
    serviceDesc: 'Comprehensive digital engineering, technical SEO, and conversion UX.',
    toolUrl: '/en/tools/headline-analyzer/',
    toolTitle: 'SEO Headline & Title Analyzer Tool',
  },
  ar: {
    serviceUrl: '/ar/services/web-design/',
    serviceTitle: 'تصميم المواقع وحلول النمو الرقمي',
    serviceDesc: 'حلول متكاملة لهندسة المواقع وتصدر محركات البحث وتجربة المستخدم.',
    toolUrl: '/ar/tools/headline-analyzer/',
