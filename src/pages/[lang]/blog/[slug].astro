                  <div class="flex flex-1 flex-col justify-between p-4 space-y-3">
                    <h3 class="line-clamp-2 text-sm font-bold text-gray-900 group-hover:text-primary transition-colors dark:text-white">
                      {rel.title}
                    </h3>
                    <div class="flex items-center justify-between text-[11px] text-gray-500 dark:text-gray-400">
                      <span>{formatDate(rel.date)}</span>
                      <span>
                        {rel.readTime}{' '}
                        {supportedLang === 'fa'
                          ? 'دقیقه'
                          : supportedLang === 'ar'
                            ? 'دقائق'
                            : 'min read'}
                      </span>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>
