                  ? 'راهنماها و مقالات مرتبط'
                  : supportedLang === 'ar'
                    ? 'مقالات وأدلة ذات صلة'
                    : 'Related Guides & Articles'}
              </h2>
              <a
                href={`/${supportedLang}/blog/`}
                class="text-xs font-bold text-primary hover:underline"
              >
                {supportedLang === 'fa'
                  ? 'مشاهده همه مقالات ←'
                  : supportedLang === 'ar'
                    ? 'جميع المقالات ←'
                    : 'View All Articles →'}
              </a>
            </div>

            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3">
              {relatedPosts.map((rel) => (
                <a
                  href={`/${supportedLang}/blog/${rel.slug}/`}
                  class="group flex flex-col overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900"
