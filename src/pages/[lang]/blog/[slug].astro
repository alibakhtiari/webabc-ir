const activeServiceTool =
  serviceToolDict[post.data.category]?.[supportedLang] || defaultServiceTool[supportedLang];
---

<Layout
  title={post.data.title}
  description={post.data.description}
  lang={supportedLang}
  slug={`blog/${slug}`}
  ogImage={post.data.image}
  ogType="article"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleSchema)} />
  <link
    slot="head"
    rel="image_src"
    href={post.data.image.startsWith('http') ? post.data.image : `${origin}${post.data.image}`}
  />
  <meta
    slot="head"
    property="article:published_time"
    content={new Date(post.data.date).toISOString()}
  />
  {
    post.data.updatedDate && (
      <meta
        slot="head"
        property="article:modified_time"
        content={new Date(post.data.updatedDate).toISOString()}
      />
    )
  }
  <meta
    slot="head"
    property="article:author"
    content={isAliBakhtiari ? 'https://aliib.ir/' : `${origin}/${supportedLang}/about/`}
  />
  <meta slot="head" property="article:section" content={post.data.category} />

  <!-- Post Wrapper -->
  <div class="container mx-auto px-4 pt-32 pb-8">
    <div class="mx-auto max-w-3xl">
      <!-- Breadcrumbs Component -->
      <Breadcrumbs items={breadcrumbs} lang={supportedLang} />

      <div class="mb-8 aspect-video overflow-hidden rounded-2xl shadow-xs">
        <OptimizedImage
          src={post.data.image}
          alt={post.data.imageAlt || post.data.title}
          width={1200}
          height={630}
          fetchpriority="high"
          loading="eager"
          class="h-full w-full object-cover"
        />
      </div>

      <!-- Post Info Header -->
      <div class="mb-8 space-y-4">
        <div class="flex flex-wrap gap-2">
          {(() => {
            const categoryLabel = getCategoryLabel(post.data.category, supportedLang);
            return categoryLabel ? (
              <span class="rounded bg-primary px-2.5 py-1 text-xs font-semibold text-primary-foreground uppercase">
                {categoryLabel}
              </span>
            ) : null;
          })()}
          {
            post.data.tags?.map((tag) => (
              <a
                href={`/${supportedLang}/blog/?tag=${encodeURIComponent(tag)}`}
                class="rounded bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-600 transition-all hover:bg-primary/10 hover:text-primary focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:bg-slate-800 dark:text-gray-300"
              >
                #{tag}
              </a>
            ))
          }
        </div>

        <h1
          class={`mb-6 text-4xl leading-tight font-bold text-gray-900 md:text-5xl dark:text-white ${fontClass}`}
        >
          {post.data.title}
        </h1>

        <div
          class={`flex flex-wrap items-center gap-4 text-sm text-gray-500 dark:text-gray-400 ${metaFontClass}`}
        >
          <span class="flex items-center gap-1">
            <svg
              aria-hidden="true"
              class="h-4 w-4 text-gray-500 dark:text-gray-400"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg
            >
            {
              isAliBakhtiari ? (
                <a
                  href={`/${supportedLang}/about/ali-bakhtiari/`}
                  class="transition-colors hover:text-primary focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
                  rel="author"
                >
                  {translatedAuthor}
                </a>
              ) : (
                translatedAuthor
              )
            }
          </span>
          <span class="flex items-center gap-1">
            <svg
              aria-hidden="true"
              class="h-4 w-4 text-gray-500 dark:text-gray-400"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path></svg
            >
            {formatDate(post.data.date)}
          </span>
          {
            post.data.updatedDate && (
              <span class="flex items-center gap-1 text-primary">
                <svg
                  aria-hidden="true"
                  class="h-4 w-4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                  />
                </svg>
                {t('blog.updated', { fallback: 'Updated' })}: {formatDate(post.data.updatedDate)}
              </span>
            )
          }
          <span class="flex items-center gap-1">
            <svg
              aria-hidden="true"
              class="h-4 w-4 text-gray-500 dark:text-gray-400"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
            >
            {post.data.readTime}
            {t('blog.minuteRead', { fallback: 'mins' })}
          </span>
        </div>
      </div>

      <!-- Table of Contents Component -->
      <TableOfContents headings={headings} lang={supportedLang} />

      <!-- TLDR Component (Key Takeaways summary callout) -->
      {
