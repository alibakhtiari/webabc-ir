---
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/astro/Breadcrumbs.astro";
import CTA from "@/components/astro/CTA.astro";
import OptimizedImage from "@/components/astro/OptimizedImage.astro";
import { getCollection, render } from "astro:content";
import { type SupportedLanguage, languages } from "@/types/language";
import { getDictionary } from "@/i18n/get-dictionary";
import { createTranslator } from "@/i18n/translate";
import {
  getProjectPillar,
  getProjectMeta,
  PILLAR_LABELS,
  type PortfolioPillar,
} from "@/data/portfolio-meta";

export async function getStaticPaths() {
  const items = await getCollection("portfolio");
  return items.map((item) => {
    const [lang, slug] = item.id.split("/");
    return {
      params: { lang, slug },
      props: { project: item },
    };
  });
}

const { lang, slug } = Astro.params;
const { project } = Astro.props;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);
const isRtl = languages[supportedLang]?.direction === "rtl";
const fontClass =
  supportedLang === "en" ? "font-sans" : supportedLang === "ar" ? "font-arabic" : "font-persian";

if (!project) {
  return Astro.redirect(`/${supportedLang}/404/`);
}

// Helper to translate strings
const t = createTranslator(dictionary);

const { Content } = await render(project);

// Metadata & Pillar resolution
const projectPillar = getProjectPillar(slug, project.data.category);
const pillarLabel = PILLAR_LABELS[supportedLang][projectPillar];
const meta = getProjectMeta(slug, supportedLang);
const faqs = project.data.faq || meta.faqs || [];
const market = project.data.market || meta.market;
const timeline = project.data.timeline || meta.timeline;

// Estimated reading time
const wordCount = (project.body || "")
  .replace(/```[\s\S]*?```/g, " ")
  .replace(/<[^>]+>/g, " ")
  .replace(/!\[[^\]]*\]\([^)]*\)/g, " ")
  .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
  .replace(/[#*_>`~]/g, " ")
  .split(/\s+/)
  .filter(Boolean).length;
const estimatedReadTime = Math.max(3, Math.ceil(wordCount / (supportedLang === "en" ? 200 : 160)));

// Clean domain extraction for browser mockup frame
let cleanDomain = "webabc.ir";
try {
  cleanDomain = new URL(project.data.projectUrl).hostname.replace(/^www\./, "");
} catch {
  cleanDomain = project.data.projectUrl
    .replace(/^https?:\/\//, "")
    .replace(/^www\./, "")
    .split("/")[0];
}

const origin = "https://webabc.ir";
const canonicalUrl = `${origin}/${supportedLang}/portfolio/${slug}/`;
const shareText = encodeURIComponent(`${project.data.title} | WebABC`);
const shareTwitter = `https://twitter.com/intent/tweet?text=${shareText}&url=${encodeURIComponent(canonicalUrl)}`;
const shareLinkedIn = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalUrl)}`;
const shareWhatsApp = `https://api.whatsapp.com/send?text=${shareText}%20${encodeURIComponent(canonicalUrl)}`;

// Breadcrumbs
const breadcrumbs = [
  { label: t("common.home", { fallback: "Home" }), url: `/${supportedLang}/` },
  { label: t("common.portfolio", { fallback: "Portfolio" }), url: `/${supportedLang}/portfolio/` },
  { label: project.data.title },
];

// Review / Testimonial data
const entryReviews = project.data.reviews ?? [];
const entryRating = project.data.rating;
const hasReviewData = entryReviews.length > 0 || entryRating !== undefined;

const reviewSchemaPart = hasReviewData
  ? {
      ...(entryReviews.length > 0
        ? {
            review: entryReviews.map((r) => ({
              "@type": "Review",
              author: { "@type": "Person", name: r.author },
              reviewBody: r.text,
              ...(typeof r.rating === "number"
                ? { reviewRating: { "@type": "Rating", ratingValue: r.rating, bestRating: 5 } }
                : {}),
            })),
          }
        : {}),
      ...(entryRating
        ? {
            aggregateRating: {
              "@type": "AggregateRating",
              ratingValue: entryRating.ratingValue,
              reviewCount: entryRating.reviewCount,
            },
          }
        : {}),
    }
  : {};

const caseStudySchema = {
  "@type": ["CreativeWork", "CaseStudy"],
  "@id": `${origin}/${supportedLang}/portfolio/${slug}/#project`,
  name: project.data.title,
  description: project.data.description,
  image: project.data.image.startsWith("http")
    ? project.data.image
    : `${origin}${project.data.image}`,
  url: `${origin}/${supportedLang}/portfolio/${slug}/`,
  about: pillarLabel,
  keywords: project.data.technologies?.join(", ") || "",
  creator: { "@id": `${origin}/#organization` },
  publisher: { "@id": `${origin}/#organization` },
  author: { "@id": `${origin}/${supportedLang}/about/ali-bakhtiari/#person` },
  inLanguage: supportedLang === "en" ? "en-US" : supportedLang === "ar" ? "ar-SA" : "fa-IR",
  ...reviewSchemaPart,
};

const faqSchema =
  faqs.length > 0
    ? {
        "@type": "FAQPage",
        "@id": `${origin}/${supportedLang}/portfolio/${slug}/#faq`,
        mainEntity: faqs.map((f) => ({
          "@type": "Question",
          name: f.question,
          acceptedAnswer: {
            "@type": "Answer",
            text: f.answer,
          },
        })),
      }
    : null;

const fullSchema = {
  "@context": "https://schema.org",
  "@graph": [caseStudySchema, ...(faqSchema ? [faqSchema] : [])],
};

// Fetch related projects & Next/Previous navigation
const allProjects = await getCollection("portfolio");
const langProjects = allProjects.filter((p) => p.id.startsWith(`${supportedLang}/`));

const currentIndex = langProjects.findIndex((p) => {
  const pSlug = p.id.replace(`${supportedLang}/`, "").replace(/\.mdx?$/, "");
  return pSlug === slug;
});

const prevProjectEntry =
  currentIndex > 0
    ? langProjects[currentIndex - 1]
    : langProjects[langProjects.length - 1];

const nextProjectEntry =
  currentIndex >= 0 && currentIndex < langProjects.length - 1
    ? langProjects[currentIndex + 1]
    : langProjects[0];

const prevProject = prevProjectEntry
  ? {
      slug: prevProjectEntry.id.replace(`${supportedLang}/`, "").replace(/\.mdx?$/, ""),
      title: prevProjectEntry.data.title,
      category:
        PILLAR_LABELS[supportedLang][
          getProjectPillar(
            prevProjectEntry.id.replace(`${supportedLang}/`, "").replace(/\.mdx?$/, ""),
            prevProjectEntry.data.category
          )
        ],
    }
  : null;

const nextProject = nextProjectEntry
  ? {
      slug: nextProjectEntry.id.replace(`${supportedLang}/`, "").replace(/\.mdx?$/, ""),
      title: nextProjectEntry.data.title,
      category:
        PILLAR_LABELS[supportedLang][
          getProjectPillar(
            nextProjectEntry.id.replace(`${supportedLang}/`, "").replace(/\.mdx?$/, ""),
            nextProjectEntry.data.category
          )
        ],
    }
  : null;

// Related projects: prioritize same pillar, take up to 3
const otherProjects = langProjects
  .filter((p) => {
    const pSlug = p.id.replace(`${supportedLang}/`, "").replace(/\.mdx?$/, "");
    return pSlug !== slug;
  })
  .map((p) => {
    const pSlug = p.id.replace(`${supportedLang}/`, "").replace(/\.mdx?$/, "");
    const pPillar = getProjectPillar(pSlug, p.data.category);
    return {
      slug: pSlug,
      title: p.data.title,
      description: p.data.description,
      client: p.data.client,
      pillar: pPillar,
      pillarLabel: PILLAR_LABELS[supportedLang][pPillar],
      image: p.data.image,
      results: p.data.results || [],
    };
  });

const samePillar = otherProjects.filter((p) => p.pillar === projectPillar);
const otherPillar = otherProjects.filter((p) => p.pillar !== projectPillar);
const relatedProjects = [...samePillar, ...otherPillar].slice(0, 3);

// Contextual Internal Linking: Related Services, Pillar Guides & Free Tools
interface PillarResource {
  serviceUrl: string;
  serviceTitle: string;
  guideUrl: string;
