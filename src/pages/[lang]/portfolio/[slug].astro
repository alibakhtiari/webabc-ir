          >
            <div class="mb-2 flex items-center gap-2 text-xs font-bold text-gray-500 uppercase dark:text-gray-400">
              <span class="transition-transform group-hover:-translate-x-1 rtl:group-hover:translate-x-1">
                {isRtl ? "→" : "←"}
              </span>
              <span>{t("portfolio.detail.prevProject", { fallback: "Previous Project" })}</span>
            </div>
            <div class="line-clamp-1 font-bold text-gray-900 transition-colors group-hover:text-primary dark:text-white">
              {prevProject.title}
            </div>
            <div class="mt-1 text-xs font-medium text-primary">
              {prevProject.category}
            </div>
          </a>
        )}

        {nextProject && (
          <a
            href={`/${supportedLang}/portfolio/${nextProject.slug}/`}
            class="group flex flex-col items-end text-end rounded-2xl border border-gray-200/80 bg-white p-6 shadow-xs transition-all hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md dark:border-slate-800 dark:bg-slate-900"
          >
            <div class="mb-2 flex items-center gap-2 text-xs font-bold text-gray-500 uppercase dark:text-gray-400">
              <span>{t("portfolio.detail.nextProject", { fallback: "Next Project" })}</span>
              <span class="transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1">
                {isRtl ? "←" : "→"}
              </span>
            </div>
            <div class="line-clamp-1 font-bold text-gray-900 transition-colors group-hover:text-primary dark:text-white">
              {nextProject.title}
            </div>
            <div class="mt-1 text-xs font-medium text-primary">
              {nextProject.category}
            </div>
          </a>
        )}
      </nav>

      <!-- Related Case Studies -->
      {relatedProjects.length > 0 && (
        <section id="related" aria-label="Related Projects" class="scroll-mt-36 my-16 space-y-8">
          <div class="text-center md:text-start">
            <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">
              {t("portfolio.detail.relatedTitle", { fallback: "Related Case Studies" })}
            </h2>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
              {t("portfolio.detail.relatedSubtitle", {
                fallback: "Explore how we solved similar architectural and growth challenges for other brands.",
              })}
            </p>
          </div>

          <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
            {relatedProjects.map((rel) => (
              <a
                href={`/${supportedLang}/portfolio/${rel.slug}/`}
                class="group flex flex-col overflow-hidden rounded-2xl border border-gray-200/80 bg-white shadow-xs transition-all hover:-translate-y-1 hover:border-primary/40 hover:shadow-md dark:border-slate-800 dark:bg-slate-900"
              >
                <div class="relative aspect-video overflow-hidden bg-gray-100 dark:bg-slate-800">
                  <OptimizedImage
                    src={rel.image}
                    alt={rel.title}
                    width={450}
                    height={253}
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  <div class="absolute top-2.5 start-2.5">
                    <span class="rounded-full bg-black/60 px-2.5 py-0.5 text-[10px] font-semibold text-white backdrop-blur-md">
                      {rel.pillarLabel}
                    </span>
                  </div>
                </div>
                <div class="flex flex-1 flex-col justify-between p-5">
                  <div>
                    <div class="text-xs font-semibold text-primary mb-1">{rel.client}</div>
                    <h3 class="line-clamp-2 text-sm font-bold text-gray-900 transition-colors group-hover:text-primary dark:text-white">
                      {rel.title}
                    </h3>
                  </div>
                  {rel.results.length > 0 && (
                    <div class="mt-4 border-t border-gray-100 pt-3 dark:border-slate-800 flex items-center justify-between text-xs">
                      <span class="text-gray-500 dark:text-gray-400 truncate">{rel.results[0].label}</span>
                      <span class="font-mono font-bold text-primary shrink-0">{rel.results[0].value}</span>
                    </div>
                  )}
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Premium Consultation CTA -->
      <CTA
        lang={supportedLang}
        title={t("portfolio.detail.consultationTitle", { fallback: "Need Similar Results for Your Business?" })}
        description={t("portfolio.detail.consultationDesc", {
          fallback:
            "Schedule a free technical and SEO consultation. We will analyze your website and provide a concrete execution blueprint.",
        })}
        buttonText={t("portfolio.detail.consultationBtn", { fallback: "Book Free Consultation" })}
      />
    </div>
  </article>
</Layout>

<script is:inline>
  (() => {
    function initCaseStudyUtilities() {
      // 1. Copy Link handler
      const copyBtn = document.getElementById("copy-case-study-btn");
      const copyLabel = document.getElementById("copy-btn-label");
      if (copyBtn && copyLabel) {
        copyBtn.onclick = async () => {
          const originalText = copyBtn.getAttribute("data-original-text") || "Copy Link";
          const copiedText = copyBtn.getAttribute("data-copied-text") || "Copied! ✓";
          try {
            await navigator.clipboard.writeText(window.location.href);
            copyLabel.textContent = copiedText;
            copyBtn.classList.add("border-emerald-500", "text-emerald-600", "dark:text-emerald-400");
            setTimeout(() => {
              copyLabel.textContent = originalText;
              copyBtn.classList.remove("border-emerald-500", "text-emerald-600", "dark:text-emerald-400");
            }, 2500);
          } catch {
            copyLabel.textContent = copiedText;
            setTimeout(() => {
              copyLabel.textContent = originalText;
            }, 2500);
          }
        };
      }

      // 2. Sticky Section Navigator Scrollspy
      const navPills = document.querySelectorAll("[data-nav-pill]");
      if (!navPills.length) return;

      const activeClass =
        "rounded-full px-3 py-1 text-xs font-semibold transition-all border border-primary bg-primary text-primary-foreground shadow-2xs";
      const inactiveClass =
        "rounded-full px-3 py-1 text-xs font-semibold text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-slate-800 border border-transparent transition-all";

      const sectionIds = Array.from(navPills).map((p) => p.getAttribute("href")?.replace("#", "")).filter(Boolean);
      const sections = sectionIds.map((id) => document.getElementById(id)).filter(Boolean);

      function updateActivePill() {
        const scrollPosition = window.scrollY + 180;
        let currentSectionId = sectionIds[0];

        for (const section of sections) {
          if (section && section.offsetTop <= scrollPosition) {
            currentSectionId = section.id;
          }
        }

        navPills.forEach((pill) => {
          const href = pill.getAttribute("href");
          if (href === `#${currentSectionId}`) {
            pill.className = activeClass;
          } else {
            pill.className = inactiveClass;
          }
        });
      }

      window.addEventListener("scroll", updateActivePill, { passive: true });
      updateActivePill();
    }

    document.addEventListener("astro:page-load", initCaseStudyUtilities);
    if (document.readyState === "complete" || document.readyState === "interactive") {
      initCaseStudyUtilities();
    }
  })();
</script>
