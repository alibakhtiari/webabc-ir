const pillarResource = PILLAR_RESOURCES[projectPillar][supportedLang];
---

<Layout
  title={project.data.title}
  description={project.data.description}
  lang={supportedLang}
  slug={`portfolio/${slug}`}
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(fullSchema)} />

  <article class={`container mx-auto px-4 pt-32 pb-16 ${fontClass}`}>
    <div class="mx-auto max-w-5xl space-y-8">
      <!-- Breadcrumbs Component -->
      <Breadcrumbs items={breadcrumbs} lang={supportedLang} />

      <!-- Header & Badges -->
      <header class="space-y-4">
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="rounded-full bg-primary px-3.5 py-1 text-xs font-bold text-primary-foreground shadow-xs">
            {pillarLabel}
          </span>
          <span class="rounded-full border border-gray-200 bg-white px-3.5 py-1 text-xs font-semibold text-gray-700 dark:border-slate-700 dark:bg-slate-800 dark:text-gray-300">
            {project.data.client}
          </span>
          <span class="rounded-full border border-gray-200 bg-gray-50 px-3 py-1 text-xs font-medium text-gray-600 dark:border-slate-800 dark:bg-slate-900 dark:text-gray-400">
            {market}
          </span>
        </div>

        <h1 class="text-3xl font-extrabold leading-tight text-gray-900 md:text-5xl dark:text-white">
          {project.data.title}
        </h1>

        <p class="text-lg leading-relaxed text-gray-600 md:text-xl dark:text-gray-300">
          {project.data.description}
        </p>

        <!-- Action & Utility Bar -->
        <div class="flex flex-wrap items-center justify-between gap-3 border-y border-gray-100 py-3.5 dark:border-slate-800">
          <!-- Reading time & verified tag -->
          <div class="flex items-center gap-3 text-xs text-gray-500 dark:text-gray-400">
            <span class="inline-flex items-center gap-1.5 font-medium">
              <svg aria-hidden="true" class="h-4 w-4 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>{estimatedReadTime} {t("portfolio.detail.minutes", { fallback: "min read" })}</span>
            </span>
            <span class="h-3 w-px bg-gray-200 dark:bg-slate-700"></span>
            <span class="inline-flex items-center gap-1 font-semibold text-emerald-600 dark:text-emerald-400">
              <svg aria-hidden="true" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>{t("portfolio.card.verifiedImpact", { fallback: "Verified Case Study" })}</span>
            </span>
          </div>

          <!-- Share & Copy Link utilities -->
          <div class="flex items-center gap-2">
            <!-- Copy Link Button -->
            <button
              type="button"
              id="copy-case-study-btn"
              data-copied-text={t("portfolio.detail.copied", { fallback: "Copied! ✓" })}
              data-original-text={t("portfolio.detail.copyLink", { fallback: "Copy Link" })}
              class="inline-flex items-center gap-1.5 rounded-full border border-gray-200 bg-white px-3 py-1 text-xs font-semibold text-gray-700 shadow-xs transition-all hover:border-primary hover:text-primary dark:border-slate-700 dark:bg-slate-800 dark:text-gray-300 dark:hover:border-primary"
            >
              <svg aria-hidden="true" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span id="copy-btn-label">{t("portfolio.detail.copyLink", { fallback: "Copy Link" })}</span>
            </button>

            <!-- Social Share shortcuts -->
            <a
              href={shareTwitter}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Share on X"
              class="flex h-7 w-7 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-600 transition-colors hover:border-primary hover:text-primary dark:border-slate-700 dark:bg-slate-800 dark:text-gray-300"
            >
              <svg aria-hidden="true" class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
              </svg>
            </a>

            <a
              href={shareLinkedIn}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Share on LinkedIn"
              class="flex h-7 w-7 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-600 transition-colors hover:border-primary hover:text-primary dark:border-slate-700 dark:bg-slate-800 dark:text-gray-300"
            >
              <svg aria-hidden="true" class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.6 1.6 0 0 0-1.6 1.6 1.6 1.6 0 0 0 1.6 1.6 1.6 1.6 0 0 0 1.6-1.6 1.6 1.6 0 0 0-1.6-1.6z" />
              </svg>
            </a>

            <a
              href={shareWhatsApp}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Share on WhatsApp"
              class="flex h-7 w-7 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-600 transition-colors hover:border-emerald-500 hover:text-emerald-500 dark:border-slate-700 dark:bg-slate-800 dark:text-gray-300"
            >
              <svg aria-hidden="true" class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.24-.75-.67-1.25-1.49-1.4-1.74-.14-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.77 2.7 4.29 3.79.6.26 1.07.41 1.44.53.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.07-.1-.23-.17-.48-.29z" />
              </svg>
            </a>

            <!-- Visit Live Website Button -->
            <a
              href={project.data.projectUrl}
              target="_blank"
              rel="noopener noreferrer nofollow external"
              class="inline-flex items-center gap-1 rounded-full bg-primary px-3 py-1 text-xs font-bold text-primary-foreground shadow-xs transition-all hover:bg-primary/90"
            >
              <span>{t("portfolio.detail.visitLive", { fallback: "Visit Live Site" })}</span>
              <svg aria-hidden="true" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </header>

