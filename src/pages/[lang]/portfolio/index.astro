---
import Layout from '../../../layouts/Layout.astro';
import Hero from '../../../components/astro/Hero.astro';
import OptimizedImage from '../../../components/astro/OptimizedImage.astro';
import { getLanguageStaticPaths, type SupportedLanguage, languages } from '../../../types/language';
import { getDictionary } from '../../../i18n/get-dictionary';
import { getCollection } from 'astro:content';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);
const isRtl = languages[supportedLang]?.direction === 'rtl';

// Fetch projects
const allProjects = await getCollection('portfolio');
const filteredProjects = allProjects.filter((proj) => proj.id.startsWith(`${supportedLang}/`));

const items = filteredProjects.map((p) => ({
  slug: p.id.replace(`${supportedLang}/`, '').replace(/\.mdx?$/, ''),
  title: p.data.title,
  description: p.data.description,
  category: p.data.category,
  image: p.data.image,
  technologies: p.data.technologies || [],
}));

const categories = ['all', ...new Set(items.map((item) => item.category))];

const titleText = t('portfolio.title', { fallback: 'Case Studies' });
const descriptionText = t('portfolio.description', { fallback: 'Showcasing our projects' });

const getCategoryLabel = (category: string) => {
  if (category === 'all') return t('portfolio.allProjects', { fallback: 'All Projects' });
  if (category === 'Web Design') return t('portfolio.webDesign', { fallback: 'Web Design' });
  if (category === 'SEO') return t('portfolio.seoProjects', { fallback: 'SEO Projects' });
  if (category === 'Local SEO') return t('portfolio.localSeo', { fallback: 'Local SEO' });
  if (category === 'E-commerce') return t('portfolio.ecommerce', { fallback: 'E-Commerce' });
  return category;
};

const breadcrumbs = [
  { label: t('common.home'), url: `/${supportedLang}/` },
  { label: t('common.portfolio') },
];

// Helper to translate strings
function t(key: string, options?: { fallback: string }) {
  const parts = key.split('.');
  let current: any = dictionary;
  for (const part of parts) {
    if (current && current[part] !== undefined) {
      current = current[part];
    } else {
      return options?.fallback || key;
    }
  }
  return typeof current === 'string' ? current : options?.fallback || key;
}
---

<Layout title={titleText} description={descriptionText} lang={supportedLang} slug="portfolio">
  <Hero
    title={titleText}
    description={descriptionText}
    breadcrumbs={breadcrumbs}
    lang={supportedLang}
  />

  <!-- Portfolio Grid Section -->
  <section class="py-16 font-sans">
    <div class="container mx-auto px-4">
      <h2
        class={`text-2xl font-bold text-gray-900 dark:text-white mb-8 text-center font-${supportedLang === 'en' ? 'sans' : 'persian'}`}
      >
        {
          supportedLang === 'fa'
            ? 'نمونه کارهای سئو و طراحی سایت'
            : supportedLang === 'ar'
              ? 'معرض أعمالنا وحالات الدراسة'
              : 'Featured Client Case Studies & Projects'
        }
      </h2>

      <!-- Category Filter -->
      <div class="mb-12 flex flex-wrap justify-center gap-3 font-persian">
        {
          categories.map((category, idx) => (
            <a
              href={`/${supportedLang}/portfolio/?category=${encodeURIComponent(category)}`}
              data-filter-btn={category}
              aria-current={idx === 0 ? 'true' : 'false'}
              class={`cursor-pointer rounded-full border px-5 py-2.5 text-xs font-semibold transition-all focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 ${
                idx === 0
                  ? 'border-primary bg-primary text-primary-foreground shadow-sm'
                  : 'border-gray-200 bg-white text-gray-700 hover:bg-gray-50 dark:border-slate-700 dark:bg-slate-800 dark:text-gray-300 dark:hover:bg-slate-700'
              }`}
            >
              {getCategoryLabel(category)}
            </a>
          ))
        }
      </div>

      <!-- Portfolio Grid -->
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          items.map((item) => (
            <div
              data-portfolio-card={item.category}
              class="group overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm transition-all duration-300 hover:shadow-xl dark:border-slate-800 dark:bg-slate-900"
            >
              <a href={`/${supportedLang}/portfolio/${item.slug}/`} class="block">
                <div class="relative aspect-video overflow-hidden">
                  <OptimizedImage
                    src={item.image}
                    alt={item.title}
                    width={400}
                    height={225}
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                    <div class="absolute bottom-4 left-4">
                      <span class="rounded bg-primary px-2.5 py-1 text-xs font-semibold text-primary-foreground">
                        {getCategoryLabel(item.category)}
                      </span>
                    </div>
                  </div>
                </div>
                <div class="space-y-4 p-6">
                  <h3 class="mb-2 line-clamp-1 font-persian text-xl font-bold text-gray-900 transition-colors group-hover:text-primary dark:text-white">
                    {item.title}
                  </h3>
                  <p class="mb-4 line-clamp-2 font-persian text-sm leading-relaxed text-gray-500 dark:text-gray-400">
                    {item.description}
                  </p>

                  <div class="flex items-center gap-1 font-persian text-sm font-semibold text-primary transition-all group-hover:gap-2">
                    {t('common.viewDetails', { fallback: 'View Details' })}
                    {isRtl ? (
                      <svg
                        aria-hidden="true"
                        class="h-4 w-4 rotate-180 transform"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M14 5l7 7m0 0l-7 7m7-7H3"
                        />
                      </svg>
                    ) : (
                      <svg
                        aria-hidden="true"
                        class="h-4 w-4"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M14 5l7 7m0 0l-7 7m7-7H3"
                        />
                      </svg>
                    )}
                  </div>
                </div>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  (() => {
    function initPortfolioFilter() {
      const filterBtns = document.querySelectorAll('[data-filter-btn]');
      const portfolioCards = document.querySelectorAll('[data-portfolio-card]');

      if (!filterBtns.length) return;

      const activeClass =
        'px-5 py-2.5 text-xs font-semibold rounded-full border border-primary bg-primary text-primary-foreground shadow-sm cursor-pointer transition-all focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2';
      const inactiveClass =
        'px-5 py-2.5 text-xs font-semibold rounded-full border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-700 cursor-pointer transition-all focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2';

      function applyFilter(selected) {
        filterBtns.forEach((b) => {
          b.className = inactiveClass;
          b.removeAttribute('aria-current');
        });
        const activeBtn =
          document.querySelector(`[data-filter-btn="${selected}"]`) ||
          document.querySelector('[data-filter-btn="all"]');
        if (activeBtn) {
          activeBtn.className = activeClass;
          activeBtn.setAttribute('aria-current', 'true');
        }

        portfolioCards.forEach((card) => {
          const cardCat = card.getAttribute('data-portfolio-card');
          if (selected === 'all' || cardCat === selected) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      }

      filterBtns.forEach((btn) => {
        btn.onclick = (e) => {
          e.preventDefault();
          const selected = btn.getAttribute('data-filter-btn');

          applyFilter(selected);

          const url = new URL(window.location);
          if (selected === 'all') {
            url.searchParams.delete('category');
          } else {
            url.searchParams.set('category', selected);
          }
          window.history.pushState({}, '', url);
        };
      });

      const urlParams = new URLSearchParams(window.location.search);
      const initialCategory = urlParams.get('category');
      if (initialCategory) {
        applyFilter(decodeURIComponent(initialCategory));
      }
    }

    document.addEventListener('astro:page-load', initPortfolioFilter);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initPortfolioFilter();
    }
  })();
</script>
