---
import ToolLayout from '@/layouts/ToolLayout.astro';
import { getLanguageStaticPaths, type SupportedLanguage } from '@/types/language';
import { getDictionary } from '@/i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);

const t = createTranslator(dictionary);

const titleText = t('socialPreview.title', { fallback: 'Social Media Preview' });
const descriptionText = t('socialPreview.description', {
  fallback: 'Visualize how your website content will look on Facebook, Twitter, and LinkedIn.',
});

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name:
        supportedLang === 'fa'
          ? 'پیش‌نمایش تگ‌های Open Graph و Twitter Card چیست؟'
          : supportedLang === 'ar'
            ? 'ما هي أداة معاينة بطاقات Open Graph و Twitter Cards؟'
            : 'What is Open Graph & Twitter Card Social Preview?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:
          supportedLang === 'fa'
            ? 'تگ‌های Open Graph تعیین می‌کنند که هنگام اشتراک‌گذاری لینک صفحه در فیس‌بوک، تلگرام، توییتر و لینکدین، چه تصویر، عنوان و توضیحاتی قرار می‌گیرد.'
            : supportedLang === 'ar'
              ? 'تحدد علامات Open Graph كيفية ظهور الصورة والعنوان والوصف عند مشاركة رابط الموقع على شبكات التواصل.'
              : 'Open Graph and Twitter Card tags control how your site link, thumbnail image, title, and description render when shared across social networks.',
      },
    },
  ],
};

const defaultTitle = t('socialPreview.defaultTitle', { fallback: 'Your Title Here' });
const defaultDesc = t('socialPreview.defaultDesc', {
  fallback: 'Your description will appear here...',
});
---

<ToolLayout
  title={titleText}
  description={descriptionText}
  lang={supportedLang}
  slug="social-media-preview"
  dictionary={dictionary}
  faqSchema={faqSchema}
>
  <!-- Main Workspace -->
  <section class="container mx-auto mt-12 px-4 font-sans">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 lg:grid-cols-2">
      <!-- Inputs Panel -->
      <div
        class="space-y-5 rounded-2xl border border-gray-100 bg-white p-6 font-persian shadow-sm dark:border-slate-800 dark:bg-slate-900"
      >
        <div class="space-y-1.5">
          <label for="smp-image" class="text-sm font-medium text-gray-700 dark:text-gray-200"
            >{t('socialPreview.imageLabel', { fallback: 'Image URL or Upload' })}</label
          >
          <div class="flex items-center gap-3">
            <input
              id="smp-image"
              type="text"
              dir="ltr"
              placeholder="https://example.com/image.jpg"
              class="h-11 flex-1 rounded-lg border border-gray-200 bg-white px-4 text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
            />
            <label
              class="flex h-11 shrink-0 cursor-pointer items-center rounded-lg border border-gray-200 bg-white px-3 text-gray-900 transition-colors hover:bg-gray-50 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
            >
              <svg
                aria-hidden="true"
                class="h-5 w-5 text-gray-500 dark:text-gray-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"
                ></path></svg
              >
              <input type="file" id="smp-upload" accept="image/*" class="hidden" />
            </label>
          </div>
        </div>

        <div class="space-y-1.5">
          <label for="smp-title" class="text-sm font-medium text-gray-700 dark:text-gray-200"
            >{t('socialPreview.titleLabel', { fallback: 'Title' })}</label
          >
          <input
            id="smp-title"
            type="text"
            placeholder={t('socialPreview.titlePlaceholder', { fallback: 'Your Post Title' })}
            class="h-11 w-full rounded-lg border border-gray-200 bg-white px-4 text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
          />
        </div>

        <div class="space-y-1.5">
          <label for="smp-desc" class="text-sm font-medium text-gray-700 dark:text-gray-200"
            >{t('socialPreview.descriptionLabel', { fallback: 'Description' })}</label
          >
          <textarea
            id="smp-desc"
            rows="4"
            placeholder={t('socialPreview.descriptionPlaceholder', {
              fallback: 'A brief description of your content...',
            })}
            class="w-full resize-none rounded-lg border border-gray-200 bg-white p-4 text-gray-900 focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
          ></textarea>
        </div>
      </div>

      <!-- Preview Panel -->
      <div
        class="space-y-6 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900"
      >
        <div class="mx-auto flex w-fit gap-2 rounded-xl bg-gray-100 p-1 dark:bg-slate-800">
          <button
            type="button"
            data-platform="facebook"
            aria-pressed="true"
            class="smp-tab rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-all focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
            >Facebook</button
          >
          <button
            type="button"
            data-platform="twitter"
            aria-pressed="false"
            class="smp-tab rounded-lg px-4 py-2 text-sm font-medium text-gray-600 transition-all hover:bg-gray-200 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:text-gray-300 dark:hover:bg-slate-700"
            >Twitter</button
          >
          <button
            type="button"
            data-platform="linkedin"
            aria-pressed="false"
            class="smp-tab rounded-lg px-4 py-2 text-sm font-medium text-gray-600 transition-all hover:bg-gray-200 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:text-gray-300 dark:hover:bg-slate-700"
            >LinkedIn</button
          >
        </div>

        <div class="mx-auto w-full max-w-sm">
          <!-- Facebook -->
          <div
            id="smp-facebook"
            class="smp-card overflow-hidden rounded-lg border border-gray-200 bg-white text-gray-900 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-white"
          >
            <div
              class="relative flex aspect-[1.91/1] items-center justify-center bg-gray-100 text-gray-400 dark:bg-slate-800 dark:text-gray-500"
            >
              <img
                id="smp-img-fb"
                width="600"
                height="314"
                class="hidden h-full w-full object-cover"
                alt="Facebook Social Preview"
              />
              <svg
                aria-hidden="true"
                id="smp-icon-fb"
                class="h-12 w-12"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14M14 8h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                ></path></svg
              >
            </div>
            <div
              class="border-t border-gray-200 bg-[#f0f2f5] p-4 dark:border-slate-800 dark:bg-slate-800/80"
            >
              <p
                class="mb-1 truncate text-xs font-medium text-gray-500 uppercase dark:text-gray-400"
              >
                example.com
              </p>
              <h3
                id="smp-title-fb"
                class="mb-1 line-clamp-2 text-base leading-tight font-bold text-gray-900 dark:text-white"
              >
                {defaultTitle}
              </h3>
              <p id="smp-desc-fb" class="line-clamp-1 text-sm text-gray-600 dark:text-gray-300">
                {defaultDesc}
              </p>
            </div>
          </div>

          <!-- Twitter -->
          <div
            id="smp-twitter"
            class="smp-card hidden overflow-hidden rounded-xl border border-gray-200 bg-white text-gray-900 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-white"
          >
            <div
              class="relative flex aspect-2/1 items-center justify-center bg-gray-100 text-gray-400 dark:bg-slate-800 dark:text-gray-500"
            >
              <img
                id="smp-img-tw"
                width="600"
                height="300"
                class="hidden h-full w-full object-cover"
                alt="Twitter Social Preview"
              />
              <svg
                aria-hidden="true"
                id="smp-icon-tw"
                class="h-12 w-12"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14M14 8h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                ></path></svg
              >
            </div>
            <div class="p-4">
              <h3 id="smp-title-tw" class="mb-1 text-base font-bold text-gray-900 dark:text-white">
                {defaultTitle}
              </h3>
              <p
                id="smp-desc-tw"
                class="mb-2 line-clamp-2 text-sm text-gray-600 dark:text-gray-300"
              >
                {defaultDesc}
              </p>
              <p class="text-sm text-gray-500 dark:text-gray-400">example.com</p>
            </div>
          </div>

          <!-- LinkedIn -->
          <div
            id="smp-linkedin"
            class="smp-card hidden overflow-hidden rounded-lg border border-gray-200 bg-white text-gray-900 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-white"
          >
            <div
              class="relative flex aspect-[1.91/1] items-center justify-center bg-gray-100 text-gray-400 dark:bg-slate-800 dark:text-gray-500"
            >
              <img
                id="smp-img-li"
                width="600"
                height="314"
                class="hidden h-full w-full object-cover"
                alt="LinkedIn Social Preview"
              />
              <svg
                aria-hidden="true"
                id="smp-icon-li"
                class="h-12 w-12"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14M14 8h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                ></path></svg
              >
            </div>
            <div
              class="border-t border-gray-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900"
            >
              <h3
                id="smp-title-li"
                class="mb-1 line-clamp-2 text-base font-semibold text-gray-900 dark:text-white"
              >
                {defaultTitle}
              </h3>
              <p class="text-xs text-gray-500 dark:text-gray-400">example.com</p>
            </div>
          </div>
        </div>

        <p class="text-center font-persian text-sm text-gray-500 dark:text-gray-400">
          {
            t('socialPreview.previewNote', {
              fallback: 'This is a simulation. Actual appearance may vary slightly by platform.',
            })
          }
        </p>
      </div>
    </div>
  </section>
</ToolLayout>

<script is:inline data-astro-rerun>
  (() => {
    const imageInput = document.getElementById('smp-image');
    const uploadInput = document.getElementById('smp-upload');
    const titleInput = document.getElementById('smp-title');
    const descInput = document.getElementById('smp-desc');

    const defaultTitle = document.getElementById('smp-title-fb').textContent;
    const defaultDesc = document.getElementById('smp-desc-fb').textContent;

    const tabs = document.querySelectorAll('.smp-tab');
    const cards = document.querySelectorAll('.smp-card');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const platform = tab.dataset.platform;
        tabs.forEach((tb) => {
          tb.className =
            'smp-tab rounded-lg px-4 py-2 text-sm font-medium transition-all text-gray-600 hover:bg-gray-200 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:text-gray-300 dark:hover:bg-slate-700';
          tb.setAttribute('aria-pressed', 'false');
        });
        tab.className =
          'smp-tab rounded-lg px-4 py-2 text-sm font-medium transition-all bg-primary text-primary-foreground focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2';
        tab.setAttribute('aria-pressed', 'true');
        cards.forEach((c) => c.classList.add('hidden'));
        document.getElementById(`smp-${platform}`).classList.remove('hidden');
      });
    });

    function updateImage(src) {
      ['fb', 'tw', 'li'].forEach((suffix) => {
        const img = document.getElementById(`smp-img-${suffix}`);
        const icon = document.getElementById(`smp-icon-${suffix}`);
        if (src) {
          img.src = src;
          img.classList.remove('hidden');
          icon.classList.add('hidden');
        } else {
          img.classList.add('hidden');
          icon.classList.remove('hidden');
        }
      });
    }

    function update() {
      const title = titleInput.value || defaultTitle;
      const desc = descInput.value || defaultDesc;
      ['fb', 'tw', 'li'].forEach((suffix) => {
        const titleEl = document.getElementById(`smp-title-${suffix}`);
        if (titleEl) titleEl.textContent = title;
        const descEl = document.getElementById(`smp-desc-${suffix}`);
        if (descEl) descEl.textContent = desc;
      });
      updateImage(imageInput.value.trim());
    }

    imageInput.addEventListener('input', update);
    titleInput.addEventListener('input', update);
    descInput.addEventListener('input', update);

    uploadInput.addEventListener('change', (e) => {
      const file = e.target.files && e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onloadend = () => {
        imageInput.value = reader.result;
        update();
      };
      reader.readAsDataURL(file);
    });
  })();
</script>
