---
import ToolLayout from '@/layouts/ToolLayout.astro';
import { getLanguageStaticPaths, type SupportedLanguage } from '@/types/language';
import { getDictionary } from '@/i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);

const t = createTranslator(dictionary);

const titleText = t('qrGenerator.title', { fallback: 'QR Code Generator' });
const descriptionText = t('qrGenerator.description', {
  fallback: 'Generate customizable QR codes for website URLs, phone numbers, or Wi-Fi networks.',
});

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name:
        supportedLang === 'fa'
          ? 'کد QR چیست و چگونه می‌توان کدهای QR باکیفیت برای وب‌سایت ساخت؟'
          : supportedLang === 'ar'
            ? 'ما هو رمز QR وكيف يمكنك إنشاء رموز QR عالية الجودة للمواقع؟'
            : 'What is a QR Code and how do high-resolution QR codes work?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:
          supportedLang === 'fa'
            ? 'کد QR یک بارکد دوبعدی است که اطلاعات متنی یا آدرس URL را ذخیره کرده و به کاربران اجازه می‌دهد با اسکن توسط دوربین گوشی فوراً وارد وب‌سایت شوند.'
            : supportedLang === 'ar'
              ? 'رمز QR هو باركود ثنائي الأبعاد يخزن الروابط والمعلومات لفتح المواقع بسرعة عبر الكاميرا.'
              : 'A QR Code is a two-dimensional barcode encoding website URLs or text data for instant smartphone camera scanning.',
      },
    },
  ],
};
---

<ToolLayout
  title={titleText}
  description={descriptionText}
  lang={supportedLang}
  slug="qr-generator"
  dictionary={dictionary}
  faqSchema={faqSchema}
>
  <!-- Main Workspace -->
  <section class="container mx-auto mt-12 mb-20 px-4 font-sans">
    <div class="mx-auto max-w-4xl space-y-8">
      <div class="grid grid-cols-1 items-start gap-8 md:grid-cols-2">
        <!-- Controls -->
        <div
          class="space-y-4 rounded-2xl border border-gray-100 bg-white p-6 font-persian shadow-sm dark:border-slate-800 dark:bg-slate-900"
        >
          <h2
            class="border-b border-gray-100 pb-2 text-base font-bold text-gray-800 dark:border-slate-800 dark:text-gray-100"
          >
            {t('qrGenerator.settings', { fallback: 'QR Content & Settings' })}
          </h2>

          <div>
            <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
              >{t('qrGenerator.contentLabel', { fallback: 'URL or Text' })} *</label
            >
            <input
              type="text"
              id="qr-text"
              value="https://webabc.ir"
              class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
            />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
                >{t('qrGenerator.fgColor', { fallback: 'Foreground Color' })}</label
              >
              <input
                type="color"
                id="qr-fg"
                value="#0052CC"
                class="h-10 w-full cursor-pointer rounded-lg border border-gray-200 bg-white p-1 text-gray-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>
            <div>
              <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
                >{t('qrGenerator.bgColor', { fallback: 'Background Color' })}</label
              >
              <input
                type="color"
                id="qr-bg"
                value="#FFFFFF"
                class="h-10 w-full cursor-pointer rounded-lg border border-gray-200 bg-white p-1 text-gray-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>
          </div>

          <div>
            <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
              >{t('qrGenerator.dimensionsLabel', { fallback: 'Dimensions (px)' })}</label
            >
            <select
              id="qr-size"
              class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
            >
              <option value="200">200 x 200</option>
              <option value="300" selected>300 x 300</option>
              <option value="400">400 x 400</option>
            </select>
          </div>
        </div>

        <!-- QR Code Output -->
        <div
          class="space-y-6 rounded-2xl border border-gray-100 bg-white p-8 text-center font-persian shadow-sm dark:border-slate-800 dark:bg-slate-900"
        >
          <div
            class="flex min-h-65 items-center justify-center rounded-2xl border border-gray-100 bg-gray-50 p-4 dark:border-slate-700 dark:bg-slate-800"
          >
            <canvas
              id="qr-canvas"
              class="rounded-lg shadow-xs transition-all duration-300"
              role="img"
              aria-label={t('qrGenerator.altText', { fallback: 'Generated QR Code' })}></canvas>
          </div>

          <a
            id="qr-download"
            download="qrcode.png"
            href="#"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-6 py-2.5 text-sm font-bold text-primary-foreground shadow-md transition-all hover:bg-primary/90 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
          >
            <svg
              aria-hidden="true"
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg
            >
            {t('qrGenerator.download', { fallback: 'Download PNG Image' })}
          </a>
        </div>
      </div>
    </div>
  </section>
</ToolLayout>

<script>
  // Bundled + tree-shaken by Astro/Vite for the browser (no server call, no external API).
  import QRCode from 'qrcode';
  // Exposed on window so the is:inline wiring script below (which re-runs on every
  // client-router navigation via data-astro-rerun) can call it without re-importing.
  window.QRCode = QRCode;
</script>

<script type="module" is:inline data-astro-rerun>
  const qrText = document.getElementById('qr-text');
  const qrFg = document.getElementById('qr-fg');
  const qrBg = document.getElementById('qr-bg');
  const qrSize = document.getElementById('qr-size');
  const qrCanvas = document.getElementById('qr-canvas');
  const qrDownload = document.getElementById('qr-download');

  function updateQrCode() {
    if (!window.QRCode) return;

    const text = qrText.value.trim() || 'https://webabc.ir';
    const fg = qrFg.value;
    const bg = qrBg.value;
    const size = parseInt(qrSize.value, 10);

    window.QRCode.toCanvas(
      qrCanvas,
      text,
      {
        width: size,
        margin: 2,
        color: { dark: fg, light: bg },
      },
      function (error) {
        if (error) return;
        qrDownload.href = qrCanvas.toDataURL('image/png');
      }
    );
  }

  [qrText, qrFg, qrBg, qrSize].forEach((el) => el.addEventListener('input', updateQrCode));
  updateQrCode();
</script>
