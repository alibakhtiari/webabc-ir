---
import Layout from '../../../layouts/Layout.astro';
import ToolsCTA from '../../../components/astro/ToolsCTA.astro';
import Breadcrumbs from '../../../components/astro/Breadcrumbs.astro';
import { getLanguageStaticPaths, type SupportedLanguage } from '../../../types/language';
import { getDictionary } from '../../../i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);

const t = createTranslator(dictionary);

const titleText = t('schemaGenerator.title', { fallback: 'Schema Markup Generator (JSON-LD)' });
const descriptionText = t('schemaGenerator.description', {
  fallback:
    'Generate valid JSON-LD structured data for Local Business, Articles, FAQs, Products, and Organizations.',
});

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `https://webabc.ir/${supportedLang}/tools/schema-generator/#webapp`,
  name: titleText,
  description: descriptionText,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'All',
  browserRequirements: 'Requires HTML5 support',
  inLanguage: supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name:
        supportedLang === 'fa'
          ? 'اسکیما مپینگ (Schema Markup) چیست و چه تاثیری بر سئو دارد؟'
          : supportedLang === 'ar'
            ? 'ما هو مخطط البيانات المنظمة (Schema Markup) وما تأثيره على السيو؟'
            : 'What is Schema Markup and how does it help SEO?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:
          supportedLang === 'fa'
            ? 'کدهای اسکیما (JSON-LD) به گوگل و هوش مصنوعی کمک می‌کنند تا ساختار محتوای وب‌سایت شما مانند سازمان، محصولات، مقالات و سوالات متداول را به درستی درک کرده و نتایج غنی (Rich Results) نمایش دهند.'
            : supportedLang === 'ar'
              ? 'تساعد أكواد الشفرة المنظمة موتورات البحث والذكاء الاصطناعي على فهم هيكل المحتوى وتوليد نتائج غنية في نتائج البحث.'
              : 'Schema markup (JSON-LD) provides structured data to search engines and AI engines, enabling Rich Snippets, Knowledge Graph panels, and better SERP visibility.',
      },
    },
  ],
};

const breadcrumbs = [
  { label: t('common.home'), url: `/${supportedLang}/` },
  { label: t('common.tools'), url: `/${supportedLang}/tools/` },
  { label: titleText },
];
---

<Layout
  title={titleText}
  description={descriptionText}
  lang={supportedLang}
  slug="tools/schema-generator"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero Section -->
  <section
    class="border-b border-gray-100 bg-linear-to-b from-primary/10 via-background to-background pt-24 pb-12 font-sans md:pt-40 md:pb-24 dark:border-slate-800"
  >
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-3xl text-center">
        <Breadcrumbs items={breadcrumbs} lang={supportedLang} centered={true} />
        <h1
          class="mb-6 bg-linear-to-r from-primary via-primary/80 to-primary/60 bg-clip-text font-persian text-3xl leading-normal font-bold text-transparent md:text-5xl"
        >
          {titleText}
        </h1>
        <p class="font-persian text-lg leading-relaxed text-gray-600 md:text-xl dark:text-gray-300">
          {descriptionText}
        </p>
      </div>
    </div>
  </section>

  <!-- Main Workspace -->
  <section class="container mx-auto mt-12 mb-20 px-4 font-sans">
    <div class="mx-auto max-w-5xl space-y-8">
      <!-- Schema Type Tabs -->
      <div
        class="rounded-2xl border border-gray-100 bg-white p-4 font-persian shadow-sm dark:border-slate-800 dark:bg-slate-900"
      >
        <label
          class="mb-3 block text-start text-xs font-bold tracking-wider text-gray-400 uppercase"
          >{t('schemaGenerator.selectType', { fallback: 'Select Schema Type' })}</label
        >
        <div class="flex flex-wrap gap-2">
          <button
            data-type="LocalBusiness"
            aria-pressed="true"
            class="tab-btn rounded-xl bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition-all focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
            >{t('schemaGenerator.typeLocalBusiness', { fallback: 'Local Business' })}</button
          >
          <button
            data-type="Article"
            aria-pressed="false"
            class="tab-btn rounded-xl bg-gray-100 px-4 py-2 text-sm font-semibold text-gray-700 transition-all hover:bg-gray-200 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:bg-slate-800 dark:text-gray-300 dark:hover:bg-slate-700"
            >{t('schemaGenerator.typeArticle', { fallback: 'Article' })}</button
          >
          <button
            data-type="FAQPage"
            aria-pressed="false"
            class="tab-btn rounded-xl bg-gray-100 px-4 py-2 text-sm font-semibold text-gray-700 transition-all hover:bg-gray-200 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:bg-slate-800 dark:text-gray-300 dark:hover:bg-slate-700"
            >{t('schemaGenerator.typeFaqPage', { fallback: 'FAQ Page' })}</button
          >
          <button
            data-type="Organization"
            aria-pressed="false"
            class="tab-btn rounded-xl bg-gray-100 px-4 py-2 text-sm font-semibold text-gray-700 transition-all hover:bg-gray-200 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:bg-slate-800 dark:text-gray-300 dark:hover:bg-slate-700"
            >{t('schemaGenerator.typeOrganization', { fallback: 'Organization' })}</button
          >
          <button
            data-type="Product"
            aria-pressed="false"
            class="tab-btn rounded-xl bg-gray-100 px-4 py-2 text-sm font-semibold text-gray-700 transition-all hover:bg-gray-200 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:bg-slate-800 dark:text-gray-300 dark:hover:bg-slate-700"
            >{t('schemaGenerator.typeProduct', { fallback: 'Product' })}</button
          >
        </div>
      </div>

      <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-2">
        <!-- Input Form Section -->
        <div
          class="space-y-4 rounded-2xl border border-gray-100 bg-white p-6 font-persian shadow-sm dark:border-slate-800 dark:bg-slate-900"
          id="schema-form-container"
        >
          <!-- Local Business Form -->
          <div id="form-LocalBusiness" class="schema-form space-y-4">
            <h3
              class="border-b border-gray-100 pb-2 text-base font-bold text-gray-800 dark:border-slate-800 dark:text-gray-100"
            >
              {t('schemaGenerator.lbHeading', { fallback: 'Local Business Details' })}
            </h3>
            <div>
              <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
                >{t('schemaGenerator.lbName', { fallback: 'Business Name' })} *</label
              >
              <input
                type="text"
                id="lb-name"
                value="WebABC Agency"
                class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
                  >{t('schemaGenerator.phone', { fallback: 'Phone Number' })}</label
                >
                <input
                  type="text"
                  id="lb-phone"
                  value="+989125811880"
                  class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                />
              </div>
              <div>
                <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
                  >{t('schemaGenerator.priceRange', { fallback: 'Price Range' })}</label
                >
                <input
                  type="text"
                  id="lb-price"
                  value="$$"
                  class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                />
              </div>
            </div>
            <div>
              <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
                >{t('schemaGenerator.websiteUrl', { fallback: 'Website URL' })}</label
              >
              <input
                type="url"
                id="lb-url"
                value="https://webabc.ir"
                class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>
            <div>
              <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
                >{t('schemaGenerator.city', { fallback: 'City / Region' })}</label
              >
              <input
                type="text"
                id="lb-city"
                value="Qazvin, Iran"
                class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>
          </div>

          <!-- Article Form -->
          <div id="form-Article" class="schema-form hidden space-y-4">
            <h3
              class="border-b border-gray-100 pb-2 text-base font-bold text-gray-800 dark:border-slate-800 dark:text-gray-100"
            >
              {t('schemaGenerator.artHeading', { fallback: 'Article Details' })}
            </h3>
            <div>
              <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
                >{t('schemaGenerator.headline', { fallback: 'Headline' })} *</label
              >
              <input
                type="text"
                id="art-title"
                value="How to Boost Website Speed in 2025"
                class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>
            <div>
              <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
                >{t('schemaGenerator.artImage', { fallback: 'Article Image URL' })}</label
              >
              <input
                type="url"
                id="art-image"
                value="https://webabc.ir/images/homepage-hero.webp"
                class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
                  >{t('schemaGenerator.authorName', { fallback: 'Author Name' })}</label
                >
                <input
                  type="text"
                  id="art-author"
                  value="Ali Bakhtiari"
                  class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                />
              </div>
              <div>
                <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
                  >{t('schemaGenerator.publisherName', { fallback: 'Publisher Name' })}</label
                >
                <input
                  type="text"
                  id="art-publisher"
                  value="WebABC"
                  class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                />
              </div>
            </div>
          </div>

          <!-- FAQ Form -->
          <div id="form-FAQPage" class="schema-form hidden space-y-4">
            <h3
              class="border-b border-gray-100 pb-2 text-base font-bold text-gray-800 dark:border-slate-800 dark:text-gray-100"
            >
              {t('schemaGenerator.faqHeading', { fallback: 'FAQ Question & Answer' })}
            </h3>
            <div>
              <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
                >{t('schemaGenerator.q1', { fallback: 'Question 1' })} *</label
              >
              <input
                type="text"
                id="faq-q1"
                value="What services does WebABC offer?"
                class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>
            <div>
              <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
                >{t('schemaGenerator.a1', { fallback: 'Answer 1' })} *</label
              >
              <textarea
                id="faq-a1"
                rows="2"
                class="w-full resize-none rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                >WebABC offers custom web development, WordPress tuning, UI/UX design, and technical
                SEO optimization.</textarea
              >
            </div>
            <div>
              <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
                >{t('schemaGenerator.q2', { fallback: 'Question 2' })}</label
              >
              <input
                type="text"
                id="faq-q2"
                value="How long does a website project take?"
                class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>
            <div>
              <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
                >{t('schemaGenerator.a2', { fallback: 'Answer 2' })}</label
              >
              <textarea
                id="faq-a2"
                rows="2"
                class="w-full resize-none rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                >Standard web development projects typically take 2 to 4 weeks depending on
                requirements.</textarea
              >
            </div>
          </div>

          <!-- Organization Form -->
          <div id="form-Organization" class="schema-form hidden space-y-4">
            <h3
              class="border-b border-gray-100 pb-2 text-base font-bold text-gray-800 dark:border-slate-800 dark:text-gray-100"
            >
              {t('schemaGenerator.orgHeading', { fallback: 'Organization Details' })}
            </h3>
            <div>
              <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
                >{t('schemaGenerator.orgName', { fallback: 'Organization Name' })} *</label
              >
              <input
                type="text"
                id="org-name"
                value="WebABC Digital Agency"
                class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>
            <div>
              <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
                >{t('schemaGenerator.orgUrl', { fallback: 'Organization URL' })}</label
              >
              <input
                type="url"
                id="org-url"
                value="https://webabc.ir"
                class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>
            <div>
              <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
                >{t('schemaGenerator.logoUrl', { fallback: 'Logo URL' })}</label
              >
              <input
                type="url"
                id="org-logo"
                value="https://webabc.ir/images/logo.webp"
                class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>
          </div>

          <!-- Product Form -->
          <div id="form-Product" class="schema-form hidden space-y-4">
            <h3
              class="border-b border-gray-100 pb-2 text-base font-bold text-gray-800 dark:border-slate-800 dark:text-gray-100"
            >
              {t('schemaGenerator.prodHeading', { fallback: 'Product Details' })}
            </h3>
            <div>
              <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
                >{t('schemaGenerator.prodName', { fallback: 'Product Name' })} *</label
              >
              <input
                type="text"
                id="prod-name"
                value="Custom E-Commerce Package"
                class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
                  >{t('schemaGenerator.price', { fallback: 'Price ($)' })}</label
                >
                <input
                  type="text"
                  id="prod-price"
                  value="999"
                  class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                />
              </div>
              <div>
                <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
                  >{t('schemaGenerator.currency', { fallback: 'Currency' })}</label
                >
                <input
                  type="text"
                  id="prod-currency"
                  value="USD"
                  class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                />
              </div>
            </div>
            <div>
              <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
                >{t('schemaGenerator.prodDescLabel', { fallback: 'Description' })}</label
              >
              <input
                type="text"
                id="prod-desc"
                value="High performance custom online shop with payment gateway."
                class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>
          </div>
        </div>

        <!-- JSON Output Section -->
        <div
          class="sticky top-28 space-y-4 rounded-2xl border border-gray-100 bg-white p-6 font-persian shadow-sm dark:border-slate-800 dark:bg-slate-900"
        >
          <div
            class="flex items-center justify-between border-b border-gray-100 pb-3 dark:border-slate-800"
          >
            <h3 class="text-base font-bold text-gray-800 dark:text-gray-100">
              {t('schemaGenerator.outputHeading', { fallback: 'Generated JSON-LD' })}
            </h3>
            <button
              type="button"
              id="copy-json-btn"
              class="flex items-center gap-1 rounded-lg bg-primary px-3 py-1.5 text-xs font-bold text-primary-foreground transition-all hover:bg-primary/90 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
            >
              <svg
                aria-hidden="true"
                class="h-3.5 w-3.5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                ></path></svg
              >
              {t('schemaGenerator.copyBtn', { fallback: 'Copy Code' })}
            </button>
          </div>

          <pre
            id="json-output"
            dir="ltr"
            class="min-h-75 overflow-x-auto rounded-xl bg-gray-900 p-4 font-mono text-xs leading-relaxed text-green-400">
          </pre>

          <div
            id="copy-status"
            class="text-center text-xs font-semibold text-green-600 opacity-0 transition-opacity"
          >
            {t('schemaGenerator.copiedStatus', { fallback: 'Copied script tag to clipboard!' })}
          </div>
        </div>
      </div>
    </div>
  </section>

  <ToolsCTA
    lang={supportedLang}
    t={t}
    related={[
      { key: 'faqGenerator', route: 'faq-generator' },
      { key: 'metaGenerator', route: 'meta-generator' },
      { key: 'serpPreview', route: 'serp-preview' },
    ]}
    ctaHref={`/${supportedLang}/services/seo`}
    isRtl={supportedLang !== 'en'}
  />
</Layout>

<script is:inline data-astro-rerun>
  (() => {
    let currentType = 'LocalBusiness';

    const tabBtns = document.querySelectorAll('.tab-btn');
    const forms = document.querySelectorAll('.schema-form');
    const jsonOutput = document.getElementById('json-output');
    const copyBtn = document.getElementById('copy-json-btn');
    const copyStatus = document.getElementById('copy-status');

    function generateJsonLd() {
      let schemaObj = {};

      if (currentType === 'LocalBusiness') {
        schemaObj = {
          '@context': 'https://schema.org',
          '@type': 'LocalBusiness',
          name: document.getElementById('lb-name').value,
          telephone: document.getElementById('lb-phone').value,
          priceRange: document.getElementById('lb-price').value,
          url: document.getElementById('lb-url').value,
          address: {
            '@type': 'PostalAddress',
            addressLocality: document.getElementById('lb-city').value,
          },
        };
      } else if (currentType === 'Article') {
        schemaObj = {
          '@context': 'https://schema.org',
          '@type': 'Article',
          headline: document.getElementById('art-title').value,
          image: [document.getElementById('art-image').value],
          author: {
            '@type': 'Person',
            name: document.getElementById('art-author').value,
          },
          publisher: {
            '@type': 'Organization',
            name: document.getElementById('art-publisher').value,
          },
        };
      } else if (currentType === 'FAQPage') {
        schemaObj = {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: [
            {
              '@type': 'Question',
              name: document.getElementById('faq-q1').value,
              acceptedAnswer: {
                '@type': 'Answer',
                text: document.getElementById('faq-a1').value,
              },
            },
            {
              '@type': 'Question',
              name: document.getElementById('faq-q2').value,
              acceptedAnswer: {
                '@type': 'Answer',
                text: document.getElementById('faq-a2').value,
              },
            },
          ],
        };
      } else if (currentType === 'Organization') {
        schemaObj = {
          '@context': 'https://schema.org',
          '@type': 'Organization',
          name: document.getElementById('org-name').value,
          url: document.getElementById('org-url').value,
          logo: document.getElementById('org-logo').value,
        };
      } else if (currentType === 'Product') {
        schemaObj = {
          '@context': 'https://schema.org',
          '@type': 'Product',
          name: document.getElementById('prod-name').value,
          description: document.getElementById('prod-desc').value,
          offers: {
            '@type': 'Offer',
            price: document.getElementById('prod-price').value,
            priceCurrency: document.getElementById('prod-currency').value,
            availability: 'https://schema.org/InStock',
          },
        };
      }

      const scriptTag = `<script type="application/ld+json">\n${JSON.stringify(schemaObj, null, 2)}\n<\/script>`;
      jsonOutput.textContent = scriptTag;
    }

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabBtns.forEach((b) => {
          b.className =
            'tab-btn rounded-xl bg-gray-100 px-4 py-2 text-sm font-semibold text-gray-700 transition-all hover:bg-gray-200 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:bg-slate-800 dark:text-gray-300 dark:hover:bg-slate-700';
          b.setAttribute('aria-pressed', 'false');
        });
        btn.className =
          'tab-btn rounded-xl bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition-all focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2';
        btn.setAttribute('aria-pressed', 'true');

        currentType = btn.getAttribute('data-type');
        forms.forEach((f) => f.classList.add('hidden'));
        document.getElementById(`form-${currentType}`).classList.remove('hidden');

        generateJsonLd();
      });
    });

    document.getElementById('schema-form-container').addEventListener('input', generateJsonLd);
    generateJsonLd();

    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(jsonOutput.textContent).then(() => {
        copyStatus.classList.remove('opacity-0');
        setTimeout(() => copyStatus.classList.add('opacity-0'), 2000);
      });
    });
  })();
</script>
