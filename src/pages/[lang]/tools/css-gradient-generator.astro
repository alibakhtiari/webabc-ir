---
import Layout from '../../../layouts/Layout.astro';
import ToolsCTA from '../../../components/astro/ToolsCTA.astro';
import Breadcrumbs from '../../../components/astro/Breadcrumbs.astro';
import { getLanguageStaticPaths, type SupportedLanguage } from '../../../types/language';
import { getDictionary } from '../../../i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);

const t = createTranslator(dictionary);

const titleText = t('gradientGen.title', { fallback: 'CSS Gradient Generator' });
const descriptionText = t('gradientGen.description', {
  fallback: 'Design beautiful linear and radial CSS gradients visually with copyable CSS code.',
});

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `https://webabc.ir/${supportedLang}/tools/css-gradient-generator/#webapp`,
  name: titleText,
  description: descriptionText,
  applicationCategory: 'DesignApplication',
  operatingSystem: 'All',
  browserRequirements: 'Requires HTML5 support',
  inLanguage: supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name:
        supportedLang === 'fa'
          ? 'تفاوت گرادیانت خطی (Linear) و شعاعی (Radial) در CSS چیست؟'
          : supportedLang === 'ar'
            ? 'ما الفرق بين التدرج الخطي والشعاعي في CSS؟'
            : 'What is the difference between Linear and Radial CSS Gradients?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:
          supportedLang === 'fa'
            ? 'گرادیانت خطی (linear-gradient) تغییر رنگ‌ها را در طول یک خط راست با زاویه مشخص انجام می‌دهد، در حالی که گرادیانت شعاعی (radial-gradient) از یک نقطه مرکزی دایره‌ای یا بیضوی به سمت بیرون پخش می‌شود.'
            : supportedLang === 'ar'
              ? 'ينتقل التدرج الخطي بين الألوان عبر خط مستقيم بزاوية محددة، بينما ينبثق التدرج الشعاعي من نقطة مركزية نحو الخارج.'
              : 'A linear gradient transitions colors along a straight axis at a specified angle, whereas a radial gradient radiates outward from a central point in a circular or elliptical pattern.',
      },
    },
  ],
};

const breadcrumbs = [
  { label: t('common.home'), url: `/${supportedLang}/` },
  { label: t('common.tools'), url: `/${supportedLang}/tools/` },
  { label: titleText },
];
---

<Layout
  title={titleText}
  description={descriptionText}
  lang={supportedLang}
  slug="tools/css-gradient-generator"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero Section -->
  <section
    class="border-b border-gray-100 bg-linear-to-b from-primary/10 via-background to-background pt-24 pb-12 font-sans md:pt-40 md:pb-24 dark:border-slate-800"
  >
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-3xl text-center">
        <Breadcrumbs items={breadcrumbs} lang={supportedLang} centered={true} />
        <h1
          class="mb-6 bg-linear-to-r from-primary via-primary/80 to-primary/60 bg-clip-text font-persian text-3xl leading-normal font-bold text-transparent md:text-5xl"
        >
          {titleText}
        </h1>
        <p class="font-persian text-lg leading-relaxed text-gray-600 md:text-xl dark:text-gray-300">
          {descriptionText}
        </p>
      </div>
    </div>
  </section>

  <!-- Main Workspace -->
  <section class="container mx-auto mt-12 mb-20 px-4 font-sans">
    <div class="mx-auto max-w-5xl space-y-8">
      <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-2">
        <!-- Gradient Controls -->
        <div
          class="space-y-5 rounded-2xl border border-gray-100 bg-white p-6 font-persian shadow-sm dark:border-slate-800 dark:bg-slate-900"
        >
          <h3
            class="border-b border-gray-100 pb-2 text-base font-bold text-gray-800 dark:border-slate-800 dark:text-gray-100"
          >
            {t('gradientGen.settings', { fallback: 'Gradient Settings' })}
          </h3>

          <!-- Type & Angle -->
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
                >{t('gradientGen.typeLabel', { fallback: 'Type' })}</label
              >
              <select
                id="grad-type"
                class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              >
                <option value="linear">{t('gradientGen.linear', { fallback: 'Linear' })}</option>
                <option value="radial">{t('gradientGen.radial', { fallback: 'Radial' })}</option>
              </select>
            </div>
            <div id="angle-container">
              <div
                class="mb-1 flex justify-between text-xs font-semibold text-gray-600 dark:text-gray-300"
              >
                <span>{t('gradientGen.angleLabel', { fallback: 'Angle' })}</span>
                <span id="angle-val" class="font-mono text-primary">135°</span>
              </div>
              <input
                type="range"
                id="grad-angle"
                min="0"
                max="360"
                value="135"
                class="w-full accent-primary"
              />
            </div>
          </div>

          <!-- Color Stops -->
          <div class="space-y-3 pt-2">
            <h4 class="text-xs font-bold text-gray-700 uppercase dark:text-gray-200">
              {t('gradientGen.colorStops', { fallback: 'Color Stops' })}
            </h4>

            <div class="flex items-center gap-3">
              <input
                type="color"
                id="color-1"
                value="#0052CC"
                class="h-10 w-10 cursor-pointer rounded-lg border border-gray-200 bg-white p-1 text-gray-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
              <input
                type="text"
                id="hex-1"
                value="#0052CC"
                class="w-24 rounded-lg border border-gray-200 bg-white px-3 py-1.5 font-mono text-xs text-gray-900 uppercase focus:border-primary dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
              <input
                type="range"
                id="stop-1"
                min="0"
                max="100"
                value="0"
                class="grow accent-primary"
              />
              <span id="stop-val-1" class="w-8 font-mono text-xs">0%</span>
            </div>

            <div class="flex items-center gap-3">
              <input
                type="color"
                id="color-2"
                value="#6554C0"
                class="h-10 w-10 cursor-pointer rounded-lg border border-gray-200 bg-white p-1 text-gray-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
              <input
                type="text"
                id="hex-2"
                value="#6554C0"
                class="w-24 rounded-lg border border-gray-200 bg-white px-3 py-1.5 font-mono text-xs text-gray-900 uppercase focus:border-primary dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
              <input
                type="range"
                id="stop-2"
                min="0"
                max="100"
                value="100"
                class="grow accent-primary"
              />
              <span id="stop-val-2" class="w-8 font-mono text-xs">100%</span>
            </div>
          </div>
        </div>

        <!-- Preview & Output -->
        <div class="space-y-6">
          <div
            id="grad-preview"
            class="h-64 w-full rounded-2xl border border-gray-200 bg-white text-gray-900 shadow-sm transition-all duration-300 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
          >
          </div>

          <div
            class="space-y-3 rounded-2xl border border-gray-100 bg-white p-6 font-persian shadow-sm dark:border-slate-800 dark:bg-slate-900"
          >
            <div
              class="flex items-center justify-between border-b border-gray-100 pb-2 dark:border-slate-800"
            >
              <h3 class="text-sm font-bold text-gray-800 dark:text-gray-100">
                {t('gradientGen.generatedCss', { fallback: 'Generated CSS' })}
              </h3>
              <button
                type="button"
                id="copy-grad-btn"
                class="rounded-lg bg-primary px-3 py-1.5 text-xs font-bold text-primary-foreground transition-all hover:bg-primary/90 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
                >{t('gradientGen.copy', { fallback: 'Copy CSS' })}</button
              >
            </div>
            <pre
              id="grad-output"
              dir="ltr"
              class="overflow-x-auto rounded-xl bg-gray-900 p-4 font-mono text-xs text-primary">background: linear-gradient(135deg, #0052CC 0%, #6554C0 100%);</pre>
            <p
              id="copy-status"
              class="text-center text-xs font-semibold text-green-600 opacity-0 transition-opacity"
            >
              {t('gradientGen.copied', { fallback: 'Copied to clipboard!' })}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ToolsCTA
    lang={supportedLang}
    t={t}
    related={[
      { key: 'glassGen', route: 'glassmorphism-generator' },
      { key: 'boxShadow', route: 'box-shadow-generator' },
      { key: 'colorContrast', route: 'color-contrast-checker' },
    ]}
    ctaHref={`/${supportedLang}/services/web-design`}
    isRtl={supportedLang !== 'en'}
  />
</Layout>

<script is:inline data-astro-rerun>
  (() => {
    const gradType = document.getElementById('grad-type');
    const gradAngle = document.getElementById('grad-angle');
    const angleVal = document.getElementById('angle-val');
    const angleContainer = document.getElementById('angle-container');

    const color1 = document.getElementById('color-1');
    const hex1 = document.getElementById('hex-1');
    const stop1 = document.getElementById('stop-1');
    const stopVal1 = document.getElementById('stop-val-1');

    const color2 = document.getElementById('color-2');
    const hex2 = document.getElementById('hex-2');
    const stop2 = document.getElementById('stop-2');
    const stopVal2 = document.getElementById('stop-val-2');

    const preview = document.getElementById('grad-preview');
    const output = document.getElementById('grad-output');
    const copyBtn = document.getElementById('copy-grad-btn');
    const copyStatus = document.getElementById('copy-status');

    function updateGradient() {
      const type = gradType.value;
      const angle = gradAngle.value;
      const c1 = color1.value;
      const s1 = stop1.value;
      const c2 = color2.value;
      const s2 = stop2.value;

      angleVal.textContent = `${angle}°`;
      stopVal1.textContent = `${s1}%`;
      stopVal2.textContent = `${s2}%`;
      hex1.value = c1.toUpperCase();
      hex2.value = c2.toUpperCase();

      if (type === 'radial') {
        angleContainer.classList.add('opacity-50', 'pointer-events-none');
      } else {
        angleContainer.classList.remove('opacity-50', 'pointer-events-none');
      }

      const cssRule =
        type === 'linear'
          ? `linear-gradient(${angle}deg, ${c1} ${s1}%, ${c2} ${s2}%)`
          : `radial-gradient(circle, ${c1} ${s1}%, ${c2} ${s2}%)`;

      preview.style.background = cssRule;
      output.textContent = `background: ${cssRule};`;
    }

    [gradType, gradAngle, color1, stop1, color2, stop2].forEach((el) =>
      el.addEventListener('input', updateGradient)
    );
    updateGradient();

    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(output.textContent).then(() => {
        copyStatus.classList.remove('opacity-0');
        setTimeout(() => copyStatus.classList.add('opacity-0'), 2000);
      });
    });
  })();
</script>
