---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/astro/Breadcrumbs.astro';
import { getLanguageStaticPaths, type SupportedLanguage, languages } from '../../../types/language';
import { getDictionary } from '../../../i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);
const isRtl = languages[supportedLang]?.direction === 'rtl';

const t = createTranslator(dictionary);

const titleText = t('gradientGen.title', { fallback: 'CSS Gradient Generator' });
const descriptionText = t('gradientGen.description', { fallback: 'Design beautiful linear and radial CSS gradients visually with copyable CSS code.' });

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": `https://webabc.ir/${supportedLang}/tools/css-gradient-generator/#webapp`,
  "name": titleText,
  "description": descriptionText,
  "applicationCategory": "DesignApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires HTML5 support",
  "inLanguage": supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR'
};

const breadcrumbs = [
  { label: t('common.home'), url: `/${supportedLang}` },
  { label: t('common.tools'), url: `/${supportedLang}/tools` },
  { label: titleText }
];
---

<Layout title={titleText} description={descriptionText} lang={supportedLang} slug="tools/css-gradient-generator">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webAppSchema)} />

  <!-- Hero Section -->
  <section class="bg-linear-to-b from-primary/5 to-white pt-24 pb-12 md:pt-40 md:pb-24 border-b border-gray-100 font-sans">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <Breadcrumbs items={breadcrumbs} lang={supportedLang} centered={true} />
        <h1 class="text-3xl md:text-5xl font-bold mb-6 bg-linear-to-r from-primary via-primary/80 to-primary/60 bg-clip-text text-transparent leading-normal font-persian">
          {titleText}
        </h1>
        <p class="text-lg md:text-xl text-gray-600 leading-relaxed font-persian">
          {descriptionText}
        </p>
      </div>
    </div>
  </section>

  <!-- Main Workspace -->
  <section class="container mx-auto px-4 mt-12 mb-20 font-sans">
    <div class="max-w-5xl mx-auto space-y-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
        
        <!-- Gradient Controls -->
        <div class="bg-white border border-gray-100 rounded-2xl shadow-sm p-6 space-y-5 font-persian">
          <h3 class="text-base font-bold text-gray-800 border-b border-gray-100 pb-2">Gradient Settings</h3>
          
          <!-- Type & Angle -->
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1">Type</label>
              <select id="grad-type" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:border-primary focus:outline-none">
                <option value="linear">Linear</option>
                <option value="radial">Radial</option>
              </select>
            </div>
            <div id="angle-container">
              <div class="flex justify-between text-xs font-semibold text-gray-600 mb-1">
                <span>Angle</span>
                <span id="angle-val" class="font-mono text-primary">135°</span>
              </div>
              <input type="range" id="grad-angle" min="0" max="360" value="135" class="w-full accent-primary" />
            </div>
          </div>

          <!-- Color Stops -->
          <div class="space-y-3 pt-2">
            <h4 class="text-xs font-bold text-gray-700 uppercase">Color Stops</h4>
            
            <div class="flex items-center gap-3">
              <input type="color" id="color-1" value="#0052CC" class="w-10 h-10 rounded-lg cursor-pointer border border-gray-200 p-1" />
              <input type="text" id="hex-1" value="#0052CC" class="w-24 border border-gray-200 rounded-lg px-3 py-1.5 text-xs font-mono uppercase focus:border-primary" />
              <input type="range" id="stop-1" min="0" max="100" value="0" class="grow accent-primary" />
              <span id="stop-val-1" class="text-xs font-mono w-8">0%</span>
            </div>

            <div class="flex items-center gap-3">
              <input type="color" id="color-2" value="#6554C0" class="w-10 h-10 rounded-lg cursor-pointer border border-gray-200 p-1" />
              <input type="text" id="hex-2" value="#6554C0" class="w-24 border border-gray-200 rounded-lg px-3 py-1.5 text-xs font-mono uppercase focus:border-primary" />
              <input type="range" id="stop-2" min="0" max="100" value="100" class="grow accent-primary" />
              <span id="stop-val-2" class="text-xs font-mono w-8">100%</span>
            </div>
          </div>
        </div>

        <!-- Preview & Output -->
        <div class="space-y-6">
          <div id="grad-preview" class="w-full h-64 rounded-2xl border border-gray-200 shadow-sm transition-all duration-300"></div>

          <div class="bg-white border border-gray-100 rounded-2xl shadow-sm p-6 space-y-3 font-persian">
            <div class="flex justify-between items-center border-b border-gray-100 pb-2">
              <h3 class="text-sm font-bold text-gray-800">Generated CSS</h3>
              <button id="copy-grad-btn" class="px-3 py-1.5 bg-primary text-white text-xs font-bold rounded-lg hover:bg-primary/90 transition-all">Copy CSS</button>
            </div>
            <pre id="grad-output" dir="ltr" class="p-4 bg-gray-900 text-primary rounded-xl font-mono text-xs overflow-x-auto">background: linear-gradient(135deg, #0052CC 0%, #6554C0 100%);</pre>
            <p id="copy-status" class="text-xs text-green-600 font-semibold opacity-0 transition-opacity text-center">Copied to clipboard!</p>
          </div>
        </div>

      </div>

    </div>
  </section>

</Layout>

<script is:inline data-astro-rerun>
  const gradType = document.getElementById('grad-type');
  const gradAngle = document.getElementById('grad-angle');
  const angleVal = document.getElementById('angle-val');
  const angleContainer = document.getElementById('angle-container');

  const color1 = document.getElementById('color-1');
  const hex1 = document.getElementById('hex-1');
  const stop1 = document.getElementById('stop-1');
  const stopVal1 = document.getElementById('stop-val-1');

  const color2 = document.getElementById('color-2');
  const hex2 = document.getElementById('hex-2');
  const stop2 = document.getElementById('stop-2');
  const stopVal2 = document.getElementById('stop-val-2');

  const preview = document.getElementById('grad-preview');
  const output = document.getElementById('grad-output');
  const copyBtn = document.getElementById('copy-grad-btn');
  const copyStatus = document.getElementById('copy-status');

  function updateGradient() {
    const type = gradType.value;
    const angle = gradAngle.value;
    const c1 = color1.value;
    const s1 = stop1.value;
    const c2 = color2.value;
    const s2 = stop2.value;

    angleVal.textContent = `${angle}°`;
    stopVal1.textContent = `${s1}%`;
    stopVal2.textContent = `${s2}%`;
    hex1.value = c1.toUpperCase();
    hex2.value = c2.toUpperCase();

    if (type === 'radial') {
      angleContainer.classList.add('opacity-50', 'pointer-events-none');
    } else {
      angleContainer.classList.remove('opacity-50', 'pointer-events-none');
    }

    const cssRule = type === 'linear'
      ? `linear-gradient(${angle}deg, ${c1} ${s1}%, ${c2} ${s2}%)`
      : `radial-gradient(circle, ${c1} ${s1}%, ${c2} ${s2}%)`;

    preview.style.background = cssRule;
    output.textContent = `background: ${cssRule};`;
  }

  [gradType, gradAngle, color1, stop1, color2, stop2].forEach(el => el.addEventListener('input', updateGradient));
  updateGradient();

  copyBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(output.textContent).then(() => {
      copyStatus.classList.remove('opacity-0');
      setTimeout(() => copyStatus.classList.add('opacity-0'), 2000);
    });
  });
</script>
