---
import Layout from '../../../layouts/Layout.astro';
import Hero from '../../../components/astro/Hero.astro';
import { type SupportedLanguage, languages } from '../../../types/language';
import { getDictionary } from '../../../i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export async function getStaticPaths() {
  // Tools with their own dedicated page under src/pages/[lang]/tools/ are intentionally
  // excluded here — this route only serves the remaining not-yet-built placeholder tools.
  const tools = [
    'lorem-generator', 'meta-generator', 'faq-generator', 'qr-generator',
    'css-gradient-generator'
  ];

  const params = [];
  for (const lang of Object.keys(languages)) {
    for (const tool of tools) {
      params.push({
        params: { lang, tool }
      });
    }
  }
  return params;
}

const { lang, tool } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);

// Helper to translate strings
const t = createTranslator(dictionary);

// Map slug to translation namespaces
const toolMapping: Record<string, string> = {
  'faq-generator': 'faqGenerator',
  'lorem-generator': 'loremGenerator',
  'meta-generator': 'metaGenerator',
  'qr-generator': 'qrGenerator',
  'css-gradient-generator': 'gradientGen'
};

const getToolMetadata = (toolVal: string) => {
  const nsKey = toolMapping[toolVal];
  const dictionarySection = nsKey ? (dictionary as any)[nsKey] : null;
  
  if (dictionarySection && dictionarySection.title) {
    return {
      title: dictionarySection.title,
      desc: dictionarySection.description || dictionarySection.subtitle || `Use our free online ${toolVal} tool.`
    };
  }
  
  const formattedTitle = toolVal.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
  return {
    title: formattedTitle,
    desc: `Use our free online ${formattedTitle} tool to improve your web workflows and metadata tags.`
  };
};

const meta = getToolMetadata(tool);

const breadcrumbs = [
  { label: t('common.home'), url: `/${supportedLang}` },
  { label: t('tools.title', { fallback: 'Tools' }), url: `/${supportedLang}/tools` },
  { label: meta.title }
];
---

<Layout title={meta.title} description={meta.desc} lang={supportedLang} slug={`tools/${tool}`} noindex={true}>
  <Hero title={meta.title} description={meta.desc} breadcrumbs={breadcrumbs} lang={supportedLang} />

  <!-- Workspace card -->
  <section class="py-16 bg-white font-sans font-persian">
    <div class="container mx-auto px-4 max-w-3xl">
      <div class="bg-white border border-gray-100 rounded-2xl p-8 shadow-xs text-center space-y-6">
        <h2 class="text-2xl font-bold text-gray-900">{meta.title} Workspace</h2>
        <p class="text-gray-500 leading-relaxed max-w-lg mx-auto">
          This tool is currently undergoing automated refactoring to support faster client side calculations and offline processing.
        </p>
        <div class="pt-4">
          <a
            href={`/${supportedLang}/contact`}
            class="inline-block px-8 py-3 bg-primary text-white font-bold rounded-lg shadow-sm hover:bg-primary/95 transition-all"
          >
            Request Access
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
