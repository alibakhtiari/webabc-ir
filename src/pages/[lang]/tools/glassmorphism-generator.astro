---
import Layout from '../../../layouts/Layout.astro';
import ToolsCTA from '../../../components/astro/ToolsCTA.astro';
import Breadcrumbs from '../../../components/astro/Breadcrumbs.astro';
import { getLanguageStaticPaths, type SupportedLanguage, languages } from '../../../types/language';
import { getDictionary } from '../../../i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);
const isRtl = languages[supportedLang]?.direction === 'rtl';

const t = createTranslator(dictionary);

const titleText = t('glassGen.title', { fallback: 'CSS Glassmorphism Generator' });
const descriptionText = t('glassGen.description', { fallback: 'Generate modern CSS glassmorphism effects for your UI designs.' });

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": `https://webabc.ir/${supportedLang}/tools/glassmorphism-generator/#webapp`,
  "name": titleText,
  "description": descriptionText,
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires HTML5 support",
  "inLanguage": supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR'
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": supportedLang === 'fa' ? 'افکت گلاسمورفیسم (Glassmorphism) چیست و چگونه در CSS ساخته می‌شود؟' : supportedLang === 'ar' ? 'ما هو تأثير الزجاج الضبابي (Glassmorphism) وكيف يتم إنشاؤه في CSS؟' : 'What is Glassmorphism and how is it implemented in CSS?',
      "acceptedAnswer": {
        "@type": "Answer",
        "text": supportedLang === 'fa' ? 'گلاسمورفیسم یک افکت طراحی مدرن است که با ترکیب شفافیت پس‌زمینه (Background Transparency)، فیلتر بلر (backdrop-filter: blur) و حاشیه نازک سفید نمایی از شیشه مات ایجاد می‌کند.' : supportedLang === 'ar' ? 'تأثير Glassmorphism يمنح المكونات مظهراً زجاجياً ضبابياً باستخدام الشفافية وفلاتر backdrop-filter في CSS.' : 'Glassmorphism creates a frosted glass visual effect using translucent background colors, backdrop-filter blur properties, and subtle light borders.'
      }
    }
  ]
};

const breadcrumbs = [
  { label: t('common.home'), url: `/${supportedLang}/` },
  { label: t('common.tools'), url: `/${supportedLang}/tools/` },
  { label: titleText }
];
---

<Layout title={titleText} description={descriptionText} lang={supportedLang} slug="tools/glassmorphism-generator">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />
      <!-- Hero Section -->
    <section class="bg-linear-to-b from-primary/5 to-white pt-24 pb-12 md:pt-40 md:pb-24 border-b border-gray-100">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center">
          <Breadcrumbs items={breadcrumbs} lang={supportedLang} centered={true} />
          <h1 class="text-3xl md:text-5xl font-bold mb-6 bg-linear-to-r from-primary via-primary/80 to-primary/60 bg-clip-text text-transparent leading-normal font-persian">
            {titleText}
          </h1>
          <p class="text-lg md:text-xl text-gray-600 leading-relaxed font-persian">
            {descriptionText}
          </p>
        </div>
      </div>
    </section>

    <!-- Main Workspace -->
    <section class="container mx-auto px-4 mt-12 font-sans">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-6xl mx-auto">

        <!-- Settings Panel -->
        <div class="bg-white border border-gray-100 rounded-2xl shadow-sm p-6 space-y-6 font-persian">
          <h3 class="text-sm font-bold text-gray-800">{t('glassGen.settings', { fallback: 'Effect Settings' })}</h3>

          <div class="space-y-2">
            <div class="flex justify-between text-sm">
              <label for="blur-slider" class="font-medium text-gray-700">{t('glassGen.blur', { fallback: 'Blur' })}</label>
              <span id="blur-val" class="font-mono text-primary font-semibold">16px</span>
            </div>
            <input id="blur-slider" type="range" min="0" max="40" step="1" value="16" class="w-full h-2 bg-gray-100 rounded-lg appearance-none cursor-pointer accent-primary" />
          </div>

          <div class="space-y-2">
            <div class="flex justify-between text-sm">
              <label for="opacity-slider" class="font-medium text-gray-700">{t('glassGen.opacity', { fallback: 'Opacity' })}</label>
              <span id="opacity-val" class="font-mono text-primary font-semibold">50%</span>
            </div>
            <input id="opacity-slider" type="range" min="0" max="100" step="1" value="50" class="w-full h-2 bg-gray-100 rounded-lg appearance-none cursor-pointer accent-primary" />
          </div>

          <div class="space-y-2">
            <div class="flex justify-between text-sm">
              <label for="saturation-slider" class="font-medium text-gray-700">{t('glassGen.saturation', { fallback: 'Saturation' })}</label>
              <span id="saturation-val" class="font-mono text-primary font-semibold">150%</span>
            </div>
            <input id="saturation-slider" type="range" min="0" max="200" step="1" value="150" class="w-full h-2 bg-gray-100 rounded-lg appearance-none cursor-pointer accent-primary" />
          </div>

          <div class="space-y-2">
            <label for="color-input" class="text-sm font-medium text-gray-700">{t('glassGen.color', { fallback: 'Base Color' })}</label>
            <div class="flex items-center gap-3">
              <input id="color-input" type="color" value="#ffffff" class="h-10 w-16 rounded-lg border border-gray-200 cursor-pointer" />
              <span id="color-val" class="text-sm font-mono text-gray-500">#ffffff</span>
            </div>
          </div>
        </div>

        <!-- Preview Panel -->
        <div class="space-y-6">
          <div class="bg-white border border-gray-100 rounded-2xl shadow-sm p-6 space-y-4">
            <h3 class="text-sm font-bold text-gray-800 font-persian">{t('glassGen.preview', { fallback: 'Live Preview' })}</h3>
            <div class="h-64 rounded-xl bg-linear-to-br from-purple-500 via-pink-500 to-red-500 flex items-center justify-center p-8 relative overflow-hidden">
              <div class="absolute top-4 left-4 w-16 h-16 bg-white/30 rounded-full blur-xl"></div>
              <div class="absolute bottom-4 right-4 w-24 h-24 bg-blue-500/30 rounded-full blur-xl"></div>
              <div id="glass-preview" class="w-full h-full rounded-xl flex items-center justify-center text-white font-medium p-4 text-center font-persian relative z-10">
                {t('glassGen.previewText', { fallback: 'Glassmorphism Effect' })}
              </div>
            </div>
          </div>

          <div class="bg-white border border-gray-100 rounded-2xl shadow-sm p-6 space-y-3">
            <div class="flex justify-between items-center">
              <h3 class="text-sm font-bold text-gray-800 font-persian">{t('glassGen.cssOutput', { fallback: 'CSS Code' })}</h3>
              <button type="button" id="copy-btn" class="text-xs font-semibold text-primary hover:underline font-persian focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
                {t('glassGen.copy', { fallback: 'Copy CSS' })}
              </button>
            </div>
            <pre id="css-output" dir="ltr" class="bg-slate-950 text-slate-50 p-4 rounded-lg font-mono text-xs whitespace-pre-wrap break-all"></pre>
            <p id="copy-feedback" class="text-xs text-green-600 font-semibold font-persian opacity-0 transition-opacity">
              {t('glassGen.copied', { fallback: 'CSS copied to clipboard!' })}
            </p>
          </div>
        </div>

      </div>
    </section>
  
  
  <ToolsCTA lang={supportedLang} t={t} related={[{ key: 'gradientGen', route: 'css-gradient-generator' }, { key: 'boxShadow', route: 'box-shadow-generator' }, { key: 'colorContrast', route: 'color-contrast-checker' }]} ctaHref={`/${supportedLang}/services/web-design`} isRtl={isRtl} />
</Layout>

<script is:inline data-astro-rerun>
  const blurSlider = document.getElementById('blur-slider');
  const opacitySlider = document.getElementById('opacity-slider');
  const saturationSlider = document.getElementById('saturation-slider');
  const colorInput = document.getElementById('color-input');

  const blurVal = document.getElementById('blur-val');
  const opacityVal = document.getElementById('opacity-val');
  const saturationVal = document.getElementById('saturation-val');
  const colorVal = document.getElementById('color-val');

  const glassPreview = document.getElementById('glass-preview');
  const cssOutput = document.getElementById('css-output');
  const copyBtn = document.getElementById('copy-btn');
  const copyFeedback = document.getElementById('copy-feedback');

  function hexToRgb(hex) {
    const r = parseInt(hex.substr(1, 2), 16);
    const g = parseInt(hex.substr(3, 2), 16);
    const b = parseInt(hex.substr(5, 2), 16);
    return `${r}, ${g}, ${b}`;
  }

  function update() {
    const blur = blurSlider.value;
    const opacity = (opacitySlider.value / 100).toFixed(2);
    const saturation = saturationSlider.value;
    const color = colorInput.value;
    const rgb = hexToRgb(color);

    blurVal.textContent = `${blur}px`;
    opacityVal.textContent = `${opacitySlider.value}%`;
    saturationVal.textContent = `${saturation}%`;
    colorVal.textContent = color;

    const cssCode = `backdrop-filter: blur(${blur}px) saturate(${saturation}%);\nbackground-color: rgba(${rgb}, ${opacity});\nborder: 1px solid rgba(255, 255, 255, 0.3);`;

    glassPreview.style.backdropFilter = `blur(${blur}px) saturate(${saturation}%)`;
    glassPreview.style.webkitBackdropFilter = `blur(${blur}px) saturate(${saturation}%)`;
    glassPreview.style.backgroundColor = `rgba(${rgb}, ${opacity})`;
    glassPreview.style.border = '1px solid rgba(255, 255, 255, 0.3)';
    glassPreview.style.boxShadow = '0 4px 30px rgba(0, 0, 0, 0.1)';

    cssOutput.textContent = cssCode;
  }

  [blurSlider, opacitySlider, saturationSlider, colorInput].forEach(el => {
    el.addEventListener('input', update);
  });

  copyBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(cssOutput.textContent).then(() => {
      copyFeedback.classList.remove('opacity-0');
      setTimeout(() => copyFeedback.classList.add('opacity-0'), 1800);
    });
  });

  update();
</script>
