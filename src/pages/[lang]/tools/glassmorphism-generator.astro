---
import Layout from '../../../layouts/Layout.astro';
import ToolsCTA from '../../../components/astro/ToolsCTA.astro';
import Breadcrumbs from '../../../components/astro/Breadcrumbs.astro';
import { getLanguageStaticPaths, type SupportedLanguage, languages } from '../../../types/language';
import { getDictionary } from '../../../i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);
const isRtl = languages[supportedLang]?.direction === 'rtl';

const t = createTranslator(dictionary);

const titleText = t('glassGen.title', { fallback: 'CSS Glassmorphism Generator' });
const descriptionText = t('glassGen.description', {
  fallback: 'Generate modern CSS glassmorphism effects for your UI designs.',
});

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `https://webabc.ir/${supportedLang}/tools/glassmorphism-generator/#webapp`,
  name: titleText,
  description: descriptionText,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'All',
  browserRequirements: 'Requires HTML5 support',
  inLanguage: supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name:
        supportedLang === 'fa'
          ? 'افکت گلاسمورفیسم (Glassmorphism) چیست و چگونه در CSS ساخته می‌شود؟'
          : supportedLang === 'ar'
            ? 'ما هو تأثير الزجاج الضبابي (Glassmorphism) وكيف يتم إنشاؤه في CSS؟'
            : 'What is Glassmorphism and how is it implemented in CSS?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:
          supportedLang === 'fa'
            ? 'گلاسمورفیسم یک افکت طراحی مدرن است که با ترکیب شفافیت پس‌زمینه (Background Transparency)، فیلتر بلر (backdrop-filter: blur) و حاشیه نازک سفید نمایی از شیشه مات ایجاد می‌کند.'
            : supportedLang === 'ar'
              ? 'تأثير Glassmorphism يمنح المكونات مظهراً زجاجياً ضبابياً باستخدام الشفافية وفلاتر backdrop-filter في CSS.'
              : 'Glassmorphism creates a frosted glass visual effect using translucent background colors, backdrop-filter blur properties, and subtle light borders.',
      },
    },
  ],
};

const breadcrumbs = [
  { label: t('common.home'), url: `/${supportedLang}/` },
  { label: t('common.tools'), url: `/${supportedLang}/tools/` },
  { label: titleText },
];
---

<Layout
  title={titleText}
  description={descriptionText}
  lang={supportedLang}
  slug="tools/glassmorphism-generator"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />
  <!-- Hero Section -->
  <section
    class="border-b border-gray-100 bg-linear-to-b from-primary/10 via-background to-background pt-24 pb-12 md:pt-40 md:pb-24 dark:border-slate-800"
  >
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-3xl text-center">
        <Breadcrumbs items={breadcrumbs} lang={supportedLang} centered={true} />
        <h1
          class="mb-6 bg-linear-to-r from-primary via-primary/80 to-primary/60 bg-clip-text font-persian text-3xl leading-normal font-bold text-transparent md:text-5xl"
        >
          {titleText}
        </h1>
        <p class="font-persian text-lg leading-relaxed text-gray-600 md:text-xl dark:text-gray-300">
          {descriptionText}
        </p>
      </div>
    </div>
  </section>

  <!-- Main Workspace -->
  <section class="container mx-auto mt-12 px-4 font-sans">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 lg:grid-cols-2">
      <!-- Settings Panel -->
      <div
        class="space-y-6 rounded-2xl border border-gray-100 bg-white p-6 font-persian shadow-sm dark:border-slate-800 dark:bg-slate-900"
      >
        <h3 class="text-sm font-bold text-gray-800 dark:text-gray-100">
          {t('glassGen.settings', { fallback: 'Effect Settings' })}
        </h3>

        <div class="space-y-2">
          <div class="flex justify-between text-sm">
            <label for="blur-slider" class="font-medium text-gray-700 dark:text-gray-200"
              >{t('glassGen.blur', { fallback: 'Blur' })}</label
            >
            <span id="blur-val" class="font-mono font-semibold text-primary">16px</span>
          </div>
          <input
            id="blur-slider"
            type="range"
            min="0"
            max="40"
            step="1"
            value="16"
            class="h-2 w-full cursor-pointer appearance-none rounded-lg bg-gray-100 accent-primary dark:bg-slate-800"
          />
        </div>

        <div class="space-y-2">
          <div class="flex justify-between text-sm">
            <label for="opacity-slider" class="font-medium text-gray-700 dark:text-gray-200"
              >{t('glassGen.opacity', { fallback: 'Opacity' })}</label
            >
            <span id="opacity-val" class="font-mono font-semibold text-primary">50%</span>
          </div>
          <input
            id="opacity-slider"
            type="range"
            min="0"
            max="100"
            step="1"
            value="50"
            class="h-2 w-full cursor-pointer appearance-none rounded-lg bg-gray-100 accent-primary dark:bg-slate-800"
          />
        </div>

        <div class="space-y-2">
          <div class="flex justify-between text-sm">
            <label for="saturation-slider" class="font-medium text-gray-700 dark:text-gray-200"
              >{t('glassGen.saturation', { fallback: 'Saturation' })}</label
            >
            <span id="saturation-val" class="font-mono font-semibold text-primary">150%</span>
          </div>
          <input
            id="saturation-slider"
            type="range"
            min="0"
            max="200"
            step="1"
            value="150"
            class="h-2 w-full cursor-pointer appearance-none rounded-lg bg-gray-100 accent-primary dark:bg-slate-800"
          />
        </div>

        <div class="space-y-2">
          <label for="color-input" class="text-sm font-medium text-gray-700 dark:text-gray-200"
            >{t('glassGen.color', { fallback: 'Base Color' })}</label
          >
          <div class="flex items-center gap-3">
            <input
              id="color-input"
              type="color"
              value="#ffffff"
              class="h-10 w-16 cursor-pointer rounded-lg border border-gray-200 bg-white text-gray-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
            />
            <span id="color-val" class="font-mono text-sm text-gray-500 dark:text-gray-400"
              >#ffffff</span
            >
          </div>
        </div>
      </div>

      <!-- Preview Panel -->
      <div class="space-y-6">
        <div
          class="space-y-4 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900"
        >
          <h3 class="font-persian text-sm font-bold text-gray-800 dark:text-gray-100">
            {t('glassGen.preview', { fallback: 'Live Preview' })}
          </h3>
          <div
            class="relative flex h-64 items-center justify-center overflow-hidden rounded-xl bg-linear-to-br from-purple-500 via-pink-500 to-red-500 p-8"
          >
            <div class="absolute top-4 left-4 h-16 w-16 rounded-full bg-white/30 blur-xl"></div>
            <div class="absolute right-4 bottom-4 h-24 w-24 rounded-full bg-blue-500/30 blur-xl">
            </div>
            <div
              id="glass-preview"
              class="relative z-10 flex h-full w-full items-center justify-center rounded-xl p-4 text-center font-persian font-medium text-white"
            >
              {t('glassGen.previewText', { fallback: 'Glassmorphism Effect' })}
            </div>
          </div>
        </div>

        <div
          class="space-y-3 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900"
        >
          <div class="flex items-center justify-between">
            <h3 class="font-persian text-sm font-bold text-gray-800 dark:text-gray-100">
              {t('glassGen.cssOutput', { fallback: 'CSS Code' })}
            </h3>
            <button
              type="button"
              id="copy-btn"
              class="font-persian text-xs font-semibold text-primary hover:underline focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
            >
              {t('glassGen.copy', { fallback: 'Copy CSS' })}
            </button>
          </div>
          <pre
            id="css-output"
            dir="ltr"
            class="rounded-lg bg-slate-950 p-4 font-mono text-xs break-all whitespace-pre-wrap text-slate-50">
          </pre>
          <p
            id="copy-feedback"
            class="font-persian text-xs font-semibold text-green-600 opacity-0 transition-opacity"
          >
            {t('glassGen.copied', { fallback: 'CSS copied to clipboard!' })}
          </p>
        </div>
      </div>
    </div>
  </section>

  <ToolsCTA
    lang={supportedLang}
    t={t}
    related={[
      { key: 'gradientGen', route: 'css-gradient-generator' },
      { key: 'boxShadow', route: 'box-shadow-generator' },
      { key: 'colorContrast', route: 'color-contrast-checker' },
    ]}
    ctaHref={`/${supportedLang}/services/web-design`}
    isRtl={isRtl}
  />
</Layout>

<script is:inline data-astro-rerun>
  (() => {
    const blurSlider = document.getElementById('blur-slider');
    const opacitySlider = document.getElementById('opacity-slider');
    const saturationSlider = document.getElementById('saturation-slider');
    const colorInput = document.getElementById('color-input');

    const blurVal = document.getElementById('blur-val');
    const opacityVal = document.getElementById('opacity-val');
    const saturationVal = document.getElementById('saturation-val');
    const colorVal = document.getElementById('color-val');

    const glassPreview = document.getElementById('glass-preview');
    const cssOutput = document.getElementById('css-output');
    const copyBtn = document.getElementById('copy-btn');
    const copyFeedback = document.getElementById('copy-feedback');

    function hexToRgb(hex) {
      const r = parseInt(hex.substr(1, 2), 16);
      const g = parseInt(hex.substr(3, 2), 16);
      const b = parseInt(hex.substr(5, 2), 16);
      return `${r}, ${g}, ${b}`;
    }

    function update() {
      const blur = blurSlider.value;
      const opacity = (opacitySlider.value / 100).toFixed(2);
      const saturation = saturationSlider.value;
      const color = colorInput.value;
      const rgb = hexToRgb(color);

      blurVal.textContent = `${blur}px`;
      opacityVal.textContent = `${opacitySlider.value}%`;
      saturationVal.textContent = `${saturation}%`;
      colorVal.textContent = color;

      const cssCode = `backdrop-filter: blur(${blur}px) saturate(${saturation}%);\nbackground-color: rgba(${rgb}, ${opacity});\nborder: 1px solid rgba(255, 255, 255, 0.3);`;

      glassPreview.style.backdropFilter = `blur(${blur}px) saturate(${saturation}%)`;
      glassPreview.style.webkitBackdropFilter = `blur(${blur}px) saturate(${saturation}%)`;
      glassPreview.style.backgroundColor = `rgba(${rgb}, ${opacity})`;
      glassPreview.style.border = '1px solid rgba(255, 255, 255, 0.3)';
      glassPreview.style.boxShadow = '0 4px 30px rgba(0, 0, 0, 0.1)';

      cssOutput.textContent = cssCode;
    }

    [blurSlider, opacitySlider, saturationSlider, colorInput].forEach((el) => {
      el.addEventListener('input', update);
    });

    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(cssOutput.textContent).then(() => {
        copyFeedback.classList.remove('opacity-0');
        setTimeout(() => copyFeedback.classList.add('opacity-0'), 1800);
      });
    });

    update();
  })();
</script>
