---
import ToolLayout from '@/layouts/ToolLayout.astro';
import { getLanguageStaticPaths, type SupportedLanguage } from '@/types/language';
import { getDictionary } from '@/i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);

// Helper to translate strings
const t = createTranslator(dictionary);

const titleText = t('tools.jsonFormatter.title', {
  fallback: 'Clientside JSON Formatter & Validator',
});
const descriptionText = t('tools.jsonFormatter.description', {
  fallback: 'Safely format, validate, and structure your JSON data completely inside your browser.',
});

const ui = {
  rawJsonLabel: t('tools.jsonFormatter.rawJsonLabel', { fallback: 'Raw JSON' }),
  formatBtn: t('tools.jsonFormatter.formatBtn', { fallback: 'Format' }),
  minifyBtn: t('tools.jsonFormatter.minifyBtn', { fallback: 'Minify' }),
  textareaPlaceholder: t('tools.jsonFormatter.textareaPlaceholder', {
    fallback: 'Paste raw JSON here...',
  }),
  statusAwaiting: t('tools.jsonFormatter.statusAwaiting', { fallback: 'Awaiting Input' }),
  clearBtn: t('tools.jsonFormatter.clearBtn', { fallback: 'Clear' }),
  outputLabel: t('tools.jsonFormatter.outputLabel', { fallback: 'Formatted Output' }),
  copyBtn: t('tools.jsonFormatter.copyBtn', { fallback: 'Copy' }),
  outputPlaceholder: t('tools.jsonFormatter.outputPlaceholder', {
    fallback: 'Formatted JSON will appear here...',
  }),
  emptyPayload: t('tools.jsonFormatter.emptyPayload', { fallback: 'Empty payload' }),
  validJson: t('tools.jsonFormatter.validJson', { fallback: '✓ Valid JSON' }),
  invalidJson: t('tools.jsonFormatter.invalidJson', { fallback: '✗ Invalid JSON' }),
  copiedStatus: t('tools.jsonFormatter.copiedStatus', { fallback: 'Copied!' }),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name:
        supportedLang === 'fa'
          ? 'فرمت‌کننده و اعتبارسنج JSON چیست و چگونه کار می‌کند؟'
          : supportedLang === 'ar'
            ? 'ما هي أداة تنسيق وفحص JSON وكيف تعمل؟'
            : 'What is a JSON Formatter & Validator?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:
          supportedLang === 'fa'
            ? 'ابزار فرمت JSON رشته‌های متنی JSON را مرتب (Prettify)، فشرده (Minify) و خطایابی ساختاری (Syntax Validation) می‌کند تا خوانایی و اشکال‌زدایی API راحت‌تر شود.'
            : supportedLang === 'ar'
              ? 'تقوم أداة تنسيق JSON بتنظيم الشفرات المكتوبة بصيغة JSON وفحص خطأ بناء الجمل وتسهيل تصحيح أخطاء الـ API.'
              : 'A JSON Formatter formats raw JSON data into clean indented syntax, minifies code, and validates structural syntax errors for developer debugging.',
      },
    },
  ],
};
---

<ToolLayout
  title={titleText}
  description={descriptionText}
  lang={supportedLang}
  slug="json-formatter"
  dictionary={dictionary}
  faqSchema={faqSchema}
>
  <!-- Main Workspace -->
  <section class="container mx-auto mt-12 px-4 font-sans">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 lg:grid-cols-12">
      <!-- Input Panel -->
      <div class="space-y-6 lg:col-span-6">
        <div
          class="space-y-4 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900"
        >
          <div class="flex items-center justify-between">
            <label
              for="json-textarea"
              class="block text-sm font-semibold text-gray-700 dark:text-gray-200"
              >{ui.rawJsonLabel}</label
            >
            <div class="flex gap-2">
              <button
                type="button"
                id="format-btn"
                class="rounded-md bg-primary px-3 py-1 text-xs font-semibold text-primary-foreground focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
                >{ui.formatBtn}</button
              >
              <button
                type="button"
                id="minify-btn"
                class="rounded-md border border-gray-200 bg-white px-3 py-1 text-xs font-semibold text-gray-700 hover:bg-gray-50 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-900 dark:text-gray-200 dark:hover:bg-slate-800"
                >{ui.minifyBtn}</button
              >
            </div>
          </div>

          <textarea
            id="json-textarea"
            rows="15"
            placeholder={ui.textareaPlaceholder}
            class="h-112.5 w-full resize-none rounded-xl border border-gray-200 bg-white p-4 font-mono text-sm text-gray-900 focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
          ></textarea>

          <div class="flex items-center justify-between">
            <span
              role="status"
              aria-live="polite"
              id="validation-status"
              data-awaiting={ui.statusAwaiting}
              data-empty={ui.emptyPayload}
              data-valid={ui.validJson}
              data-invalid={ui.invalidJson}
              class="rounded bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-600 dark:bg-slate-800 dark:text-gray-300"
            >
              {ui.statusAwaiting}
            </span>
            <button
              type="button"
              id="clear-btn"
              class="rounded-lg border border-gray-200 bg-white px-4 py-1.5 text-xs font-medium text-gray-700 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-900 dark:text-gray-200"
            >
              {ui.clearBtn}
            </button>
          </div>
        </div>
      </div>

      <!-- Output Panel -->
      <div class="space-y-6 lg:col-span-6">
        <div
          class="flex h-140 flex-col space-y-4 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900"
        >
          <div class="flex items-center justify-between">
            <span class="block text-sm font-semibold text-gray-700 dark:text-gray-200"
              >{ui.outputLabel}</span
            >
            <button
              type="button"
              id="copy-btn"
              data-copy={ui.copyBtn}
              data-copied={ui.copiedStatus}
              class="flex items-center gap-1 rounded-md bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-700 hover:bg-gray-200 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:bg-slate-800 dark:text-gray-200 dark:hover:bg-slate-700"
            >
              {ui.copyBtn}
            </button>
          </div>

          <div
            class="grow overflow-auto rounded-xl border border-gray-100 bg-gray-50/50 p-4 font-mono text-sm dark:border-slate-800 dark:bg-slate-900"
          >
            <pre
              id="json-output"
              data-placeholder={ui.outputPlaceholder}
              class="break-all whitespace-pre-wrap text-gray-800 dark:text-gray-100">{ui.outputPlaceholder}</pre>
          </div>
        </div>
      </div>
    </div>
  </section>
</ToolLayout>

<script is:inline data-astro-rerun>
  (() => {
    // JSON Formatter/Validator logic
    const textarea = document.getElementById('json-textarea');
    const output = document.getElementById('json-output');
    const formatBtn = document.getElementById('format-btn');
    const minifyBtn = document.getElementById('minify-btn');
    const clearBtn = document.getElementById('clear-btn');
    const copyBtn = document.getElementById('copy-btn');
    const statusSpan = document.getElementById('validation-status');

    // Localized strings rendered server-side; English only as a safety net.
    const msgs = {
      placeholder: output.dataset.placeholder || 'Formatted JSON will appear here...',
      awaiting: statusSpan.dataset.awaiting || 'Awaiting Input',
      empty: statusSpan.dataset.empty || 'Empty payload',
      valid: statusSpan.dataset.valid || '✓ Valid JSON',
      invalid: statusSpan.dataset.invalid || '✗ Invalid JSON',
      copy: copyBtn.dataset.copy || 'Copy',
      copied: copyBtn.dataset.copied || 'Copied!',
    };

    formatBtn.addEventListener('click', () => parseAndRender(2));
    minifyBtn.addEventListener('click', () => parseAndRender(0));

    clearBtn.addEventListener('click', () => {
      textarea.value = '';
      output.textContent = msgs.placeholder;
      statusSpan.textContent = msgs.awaiting;
      statusSpan.className =
        'text-xs font-semibold px-2.5 py-1 rounded bg-gray-100 text-gray-600 dark:bg-slate-800 dark:text-gray-300';
    });

    copyBtn.addEventListener('click', () => {
      const textToCopy = output.textContent;
      if (textToCopy && textToCopy !== msgs.placeholder && !textToCopy.startsWith('Error:')) {
        navigator.clipboard.writeText(textToCopy);
        copyBtn.textContent = msgs.copied;
        setTimeout(() => {
          copyBtn.textContent = msgs.copy;
        }, 1500);
      }
    });

    function parseAndRender(spaces) {
      const rawVal = textarea.value.trim();
      if (!rawVal) {
        statusSpan.textContent = msgs.empty;
        statusSpan.className =
          'text-xs font-semibold px-2.5 py-1 rounded bg-yellow-50 text-yellow-600 dark:bg-yellow-950/40 dark:text-yellow-400';
        return;
      }

      try {
        const parsed = JSON.parse(rawVal);
        const formatted = JSON.stringify(parsed, null, spaces);
        output.textContent = formatted;
        statusSpan.textContent = msgs.valid;
        statusSpan.className =
          'text-xs font-semibold px-2.5 py-1 rounded bg-green-50 text-green-600 dark:bg-green-950/40 dark:text-green-400';
      } catch (e) {
        output.textContent = `Error: ${e.message}`;
        statusSpan.textContent = msgs.invalid;
        statusSpan.className =
          'text-xs font-semibold px-2.5 py-1 rounded bg-red-50 text-red-600 dark:bg-red-950/40 dark:text-red-400';
      }
    }

    // Bind keyup validation
    textarea.addEventListener('input', () => {
      if (!textarea.value.trim()) {
        statusSpan.textContent = msgs.awaiting;
        statusSpan.className =
          'text-xs font-semibold px-2.5 py-1 rounded bg-gray-100 text-gray-600 dark:bg-slate-800 dark:text-gray-300';
        return;
      }
      try {
        JSON.parse(textarea.value);
        statusSpan.textContent = msgs.valid;
        statusSpan.className =
          'text-xs font-semibold px-2.5 py-1 rounded bg-green-50 text-green-600 dark:bg-green-950/40 dark:text-green-400';
      } catch (e) {
        statusSpan.textContent = msgs.invalid;
        statusSpan.className =
          'text-xs font-semibold px-2.5 py-1 rounded bg-red-50 text-red-600 dark:bg-red-950/40 dark:text-red-400';
      }
    });

    // Pre-load default values
    textarea.value = `{"site": "WebABC", "optimization": ["SEO", "AEO", "GEO"], "pages": {"home": "/fa", "tool": "/en/tools/headline-analyzer/"}, "active": true}`;
    parseAndRender(2);
  })();
</script>
