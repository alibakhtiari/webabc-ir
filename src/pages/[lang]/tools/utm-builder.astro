---
import Layout from '../../../layouts/Layout.astro';
import ToolsCTA from '../../../components/astro/ToolsCTA.astro';
import Breadcrumbs from '../../../components/astro/Breadcrumbs.astro';
import { getLanguageStaticPaths, type SupportedLanguage, languages } from '../../../types/language';
import { getDictionary } from '../../../i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);
const isRtl = languages[supportedLang]?.direction === 'rtl';

const t = createTranslator(dictionary);

const titleText = t('utmBuilder.title', { fallback: 'UTM Link Builder' });
const descriptionText = t('utmBuilder.description', {
  fallback: 'Create trackable URLs with UTM parameters for Google Analytics.',
});

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `https://webabc.ir/${supportedLang}/tools/utm-builder/#webapp`,
  name: titleText,
  description: descriptionText,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'All',
  browserRequirements: 'Requires HTML5 support',
  inLanguage: supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name:
        supportedLang === 'fa'
          ? 'پارامترهای UTM چیست و چه کمکی به تحلیل کمپین‌ها می‌کنند؟'
          : supportedLang === 'ar'
            ? 'ما هي معلمات UTM وكيف تساعد في تتبع الحملات؟'
            : 'What are UTM parameters and why are they used in marketing?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:
          supportedLang === 'fa'
            ? 'پارامترهای UTM کدهای متنی هستند که به انتهای لینک‌ها اضافه می‌شوند تا منبع (utmsource)، روش (utmmedium)، و نام کمپین (utmcampaign) را در گوگل آنالیتیکس به دقت ردیابی کنند.'
            : supportedLang === 'ar'
              ? 'معلمات UTM هي تتبعات تضاف لنهاية الروابط لتتبع مصدر الزيارات والحملات في Google Analytics.'
              : 'UTM parameters are query strings added to URLs that allow Google Analytics to track referral sources, channels, and campaign names.',
      },
    },
  ],
};

const breadcrumbs = [
  { label: t('common.home'), url: `/${supportedLang}/` },
  { label: t('common.tools'), url: `/${supportedLang}/tools/` },
  { label: titleText },
];

const fillFieldsText = t('utmBuilder.fillFields', {
  fallback: 'Fill in the fields above to generate your UTM URL',
});
---

<Layout
  title={titleText}
  description={descriptionText}
  lang={supportedLang}
  slug="tools/utm-builder"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />
  <!-- Hero Section -->
  <section
    class="border-b border-gray-100 bg-linear-to-b from-primary/10 via-background to-background pt-24 pb-12 md:pt-40 md:pb-24 dark:border-slate-800"
  >
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-3xl text-center">
        <Breadcrumbs items={breadcrumbs} lang={supportedLang} centered={true} />
        <h1
          class="mb-6 bg-linear-to-r from-primary via-primary/80 to-primary/60 bg-clip-text font-persian text-3xl leading-normal font-bold text-transparent md:text-5xl"
        >
          {titleText}
        </h1>
        <p class="font-persian text-lg leading-relaxed text-gray-600 md:text-xl dark:text-gray-300">
          {descriptionText}
        </p>
      </div>
    </div>
  </section>

  <!-- Main Workspace -->
  <section class="container mx-auto mt-12 px-4 font-sans">
    <div class="mx-auto max-w-3xl space-y-6">
      <div
        class="space-y-5 rounded-2xl border border-gray-100 bg-white p-6 font-persian shadow-sm dark:border-slate-800 dark:bg-slate-900"
      >
        <h3 class="text-sm font-bold text-gray-800 dark:text-gray-100">
          {t('utmBuilder.campaignDetails', { fallback: 'Campaign Details' })}
        </h3>

        <div class="space-y-1.5">
          <label for="utm-url" class="text-sm font-medium text-gray-700 dark:text-gray-200"
            >{t('utmBuilder.websiteUrl', { fallback: 'Website URL (required)' })}</label
          >
          <input
            id="utm-url"
            type="text"
            dir="ltr"
            placeholder={t('utmBuilder.urlPlaceholder', { fallback: 'https://example.com' })}
            class="h-11 w-full rounded-lg border border-gray-200 bg-white px-4 text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
          />
        </div>

        <div class="space-y-1.5">
          <label for="utm-source" class="text-sm font-medium text-gray-700 dark:text-gray-200"
            >{t('utmBuilder.source', { fallback: 'Campaign Source (required)' })}</label
          >
          <input
            id="utm-source"
            type="text"
            dir="ltr"
            placeholder={t('utmBuilder.sourcePlaceholder', {
              fallback: 'google, newsletter, facebook',
            })}
            class="h-11 w-full rounded-lg border border-gray-200 bg-white px-4 text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
          />
          <p class="text-xs text-gray-400">
            {
              t('utmBuilder.sourceHelp', {
                fallback: 'The referrer: google, newsletter, facebook, etc.',
              })
            }
          </p>
        </div>

        <div class="space-y-1.5">
          <label for="utm-medium" class="text-sm font-medium text-gray-700 dark:text-gray-200"
            >{t('utmBuilder.medium', { fallback: 'Campaign Medium (required)' })}</label
          >
          <input
            id="utm-medium"
            type="text"
            dir="ltr"
            placeholder={t('utmBuilder.mediumPlaceholder', { fallback: 'cpc, email, social' })}
            class="h-11 w-full rounded-lg border border-gray-200 bg-white px-4 text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
          />
          <p class="text-xs text-gray-400">
            {t('utmBuilder.mediumHelp', { fallback: 'Marketing medium: cpc, email, social, etc.' })}
          </p>
        </div>

        <div class="space-y-1.5">
          <label for="utm-campaign" class="text-sm font-medium text-gray-700 dark:text-gray-200"
            >{t('utmBuilder.campaign', { fallback: 'Campaign Name (required)' })}</label
          >
          <input
            id="utm-campaign"
            type="text"
            dir="ltr"
            placeholder={t('utmBuilder.campaignPlaceholder', {
              fallback: 'summer_sale, product_launch',
            })}
            class="h-11 w-full rounded-lg border border-gray-200 bg-white px-4 text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
          />
          <p class="text-xs text-gray-400">
            {t('utmBuilder.campaignHelp', { fallback: 'Product, promo code, or slogan' })}
          </p>
        </div>

        <div class="space-y-1.5">
          <label for="utm-term" class="text-sm font-medium text-gray-700 dark:text-gray-200"
            >{t('utmBuilder.term', { fallback: 'Campaign Term (optional)' })}</label
          >
          <input
            id="utm-term"
            type="text"
            dir="ltr"
            placeholder={t('utmBuilder.termPlaceholder', { fallback: 'running+shoes' })}
            class="h-11 w-full rounded-lg border border-gray-200 bg-white px-4 text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
          />
          <p class="text-xs text-gray-400">
            {t('utmBuilder.termHelp', { fallback: 'Identify paid search keywords' })}
          </p>
        </div>

        <div class="space-y-1.5">
          <label for="utm-content" class="text-sm font-medium text-gray-700 dark:text-gray-200"
            >{t('utmBuilder.content', { fallback: 'Campaign Content (optional)' })}</label
          >
          <input
            id="utm-content"
            type="text"
            dir="ltr"
            placeholder={t('utmBuilder.contentPlaceholder', { fallback: 'logolink, textlink' })}
            class="h-11 w-full rounded-lg border border-gray-200 bg-white px-4 text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
          />
          <p class="text-xs text-gray-400">
            {t('utmBuilder.contentHelp', { fallback: 'Differentiate ads or links' })}
          </p>
        </div>
      </div>

      <div
        class="space-y-4 rounded-2xl border border-gray-100 bg-white p-6 font-persian shadow-sm dark:border-slate-800 dark:bg-slate-900"
      >
        <h3 class="text-sm font-bold text-gray-800 dark:text-gray-100">
          {t('utmBuilder.generatedUrl', { fallback: 'Generated UTM URL' })}
        </h3>
        <div
          id="utm-output"
          dir="ltr"
          class="min-h-12 w-full rounded-xl border border-gray-200 bg-gray-50/50 p-4 font-mono text-sm break-all text-gray-500 dark:border-slate-700 dark:bg-slate-900 dark:text-gray-400"
        >
          {fillFieldsText}
        </div>
        <button
          type="button"
          id="utm-copy"
          disabled
          class="w-full rounded-xl bg-primary py-3 text-sm font-bold text-primary-foreground shadow-sm transition-all hover:bg-primary/95 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-40"
        >
          {t('utmBuilder.copyUrl', { fallback: 'Copy URL' })}
        </button>
        <p
          id="utm-copy-feedback"
          class="font-persian text-xs font-semibold text-green-600 opacity-0 transition-opacity"
        >
          {t('utmBuilder.copied', { fallback: 'URL copied to clipboard!' })}
        </p>
      </div>
    </div>
  </section>

  <ToolsCTA
    lang={supportedLang}
    t={t}
    related={[
      { key: 'socialPreview', route: 'social-media-preview' },
      { key: 'slugGenerator', route: 'slug-generator' },
      { key: 'qrGenerator', route: 'qr-generator' },
    ]}
    ctaHref={`/${supportedLang}/services/seo`}
    isRtl={isRtl}
  />
</Layout>

<script type="application/json" id="utm-fill-text" set:html={JSON.stringify(fillFieldsText)} />

<script is:inline data-astro-rerun>
  (() => {
    const fillFieldsText = JSON.parse(document.getElementById('utm-fill-text').textContent);

    const urlInput = document.getElementById('utm-url');
    const sourceInput = document.getElementById('utm-source');
    const mediumInput = document.getElementById('utm-medium');
    const campaignInput = document.getElementById('utm-campaign');
    const termInput = document.getElementById('utm-term');
    const contentInput = document.getElementById('utm-content');

    const output = document.getElementById('utm-output');
    const copyBtn = document.getElementById('utm-copy');
    const copyFeedback = document.getElementById('utm-copy-feedback');

    function buildUrl() {
      const url = urlInput.value.trim();
      if (!url) return '';

      const params = new URLSearchParams();
      if (sourceInput.value.trim()) params.append('utm_source', sourceInput.value.trim());
      if (mediumInput.value.trim()) params.append('utm_medium', mediumInput.value.trim());
      if (campaignInput.value.trim()) params.append('utm_campaign', campaignInput.value.trim());
      if (termInput.value.trim()) params.append('utm_term', termInput.value.trim());
      if (contentInput.value.trim()) params.append('utm_content', contentInput.value.trim());

      const qs = params.toString();
      return qs ? `${url}?${qs}` : url;
    }

    function update() {
      const finalUrl = buildUrl();
      if (finalUrl) {
        output.textContent = finalUrl;
        output.classList.remove('text-gray-500 dark:text-gray-400');
        output.classList.add('text-primary');
      } else {
        output.textContent = fillFieldsText;
        output.classList.add('text-gray-500 dark:text-gray-400');
        output.classList.remove('text-primary');
      }
      copyBtn.disabled = !(
        finalUrl &&
        sourceInput.value.trim() &&
        mediumInput.value.trim() &&
        campaignInput.value.trim()
      );
    }

    [urlInput, sourceInput, mediumInput, campaignInput, termInput, contentInput].forEach((el) => {
      el.addEventListener('input', update);
    });

    copyBtn.addEventListener('click', () => {
      const finalUrl = buildUrl();
      if (!finalUrl) return;
      navigator.clipboard.writeText(finalUrl).then(() => {
        copyFeedback.classList.remove('opacity-0');
        setTimeout(() => copyFeedback.classList.add('opacity-0'), 1800);
      });
    });
  })();
</script>
