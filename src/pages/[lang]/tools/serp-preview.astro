---
import ToolLayout from '@/layouts/ToolLayout.astro';
import { getLanguageStaticPaths, type SupportedLanguage, languages } from '@/types/language';
import { getDictionary } from '@/i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);
const isRtl = languages[supportedLang]?.direction === 'rtl';

const t = createTranslator(dictionary);

const titleText = t('serpPreview.title', { fallback: 'SERP Snippet Preview Tool' });
const descriptionText = t('serpPreview.description', {
  fallback: 'Preview how your website appears in Google search results.',
});

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name:
        supportedLang === 'fa'
          ? 'پیش‌نمایش SERP گوگل چیست و چرا استفاده می‌شود؟'
          : supportedLang === 'ar'
            ? 'ما هي أداة معاينة نتائج بحث جوجل (SERP Preview)؟'
            : 'What is a Google SERP Preview tool?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:
          supportedLang === 'fa'
            ? 'ابزار پیش‌نمایش SERP به شما اجازه می‌دهد عنوان متا و توضیحات صفحه را قبل از انتشار مشاهده کرده و از قطع شدن کاراکترها (Truncation) در دسکتاپ و موبایل جلوگیری کنید.'
            : supportedLang === 'ar'
              ? 'تتيح لك أداة معاينة SERP رؤية كيف سيبدو عنوان المقال والوصف في نتائج بحث جوجل على الهواتف والأجهزة المكتبي.'
              : 'A SERP preview tool simulates how your title tag and meta description will render on Google search result pages across mobile and desktop viewports.',
      },
    },
  ],
};

const guideDict = dictionary.serpPreview?.guide;
const guide = guideDict ? {
  how: {
    title: t('serpPreview.guide.how.title', { fallback: 'How It Works' }),
    paragraphs: Array.isArray(guideDict.how?.paragraphs) ? guideDict.how.paragraphs : [],
  },
  useCases: {
    title: t('serpPreview.guide.useCases.title', { fallback: 'When to Use This Tool' }),
    items: Array.isArray(guideDict.useCases?.items) ? guideDict.useCases.items : [],
  },
} : undefined;

---



<ToolLayout
  title={titleText}
  description={descriptionText}
  lang={supportedLang}
  slug="serp-preview"
  dictionary={dictionary}
  faqSchema={faqSchema}
  guide={guide}
>
  <!-- Main Workspace -->
  <section class="container mx-auto mt-12 px-4 font-sans">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 lg:grid-cols-2">
      <!-- Inputs Panel -->
      <div
        class="space-y-5 rounded-2xl border border-gray-100 bg-white p-6 font-persian shadow-sm dark:border-slate-800 dark:bg-slate-900"
      >
        <h3 class="text-sm font-bold text-gray-800 dark:text-gray-100">
          {t('serpPreview.enterDetails', { fallback: 'Enter Your Details' })}
        </h3>

        <div class="space-y-1.5">
          <label for="sp-title" class="text-sm font-medium text-gray-700 dark:text-gray-200"
            >{t('serpPreview.titleTag', { fallback: 'Title Tag' })}</label
          >
          <input
            id="sp-title"
            type="text"
            dir={isRtl ? 'rtl' : 'ltr'}
            maxlength="70"
            placeholder={t('serpPreview.placeholderTitle', { fallback: 'Your page title' })}
            class="h-11 w-full rounded-lg border border-gray-200 bg-white px-4 text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
          />
          <p id="sp-title-count" class="text-xs text-gray-500 dark:text-gray-400">
            0/60 {t('serpPreview.charsMax', { fallback: 'characters (max' })} 70)
          </p>
        </div>

        <div class="space-y-1.5">
          <label for="sp-url" class="text-sm font-medium text-gray-700 dark:text-gray-200"
            >{t('serpPreview.url', { fallback: 'URL' })}</label
          >
          <input
            id="sp-url"
            type="text"
            dir="ltr"
            placeholder={t('serpPreview.placeholderUrl', { fallback: 'https://example.com/page' })}
            class="h-11 w-full rounded-lg border border-gray-200 bg-white px-4 text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
          />
        </div>

        <div class="space-y-1.5">
          <label for="sp-desc" class="text-sm font-medium text-gray-700 dark:text-gray-200"
            >{t('serpPreview.metaDescription', { fallback: 'Meta Description' })}</label
          >
          <textarea
            id="sp-desc"
            rows="4"
            dir={isRtl ? 'rtl' : 'ltr'}
            maxlength="170"
            placeholder={t('serpPreview.placeholderDesc', { fallback: 'Your meta description' })}
            class="w-full resize-none rounded-lg border border-gray-200 bg-white p-4 text-gray-900 focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
          ></textarea>
          <p id="sp-desc-count" class="text-xs text-gray-500 dark:text-gray-400">
            0/160 {t('serpPreview.charsMax', { fallback: 'characters (max' })} 170)
          </p>
        </div>
      </div>

      <!-- Preview Panel -->
      <div
        class="h-fit overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900"
      >
        <div class="border-b border-gray-100 bg-gray-50 px-6 py-4 dark:border-slate-800">
          <span class="font-persian font-semibold text-gray-800 dark:text-gray-100"
            >{t('serpPreview.googlePreview', { fallback: 'Google Search Preview' })}</span
          >
        </div>
        <div class="bg-white p-6 dark:bg-slate-900" dir="ltr">
          <div
            id="sp-url-preview"
            class="mb-1 font-sans text-sm break-all text-green-700 dark:text-green-400"
          >
            {t('serpPreview.placeholderUrl', { fallback: 'https://example.com/page' })}
          </div>
          <div
            id="sp-title-preview"
            class="mb-2 cursor-pointer font-sans text-xl text-[#1a0dab] hover:underline dark:text-[#8ab4f8]"
          >
            {t('serpPreview.previewTitleDefault', { fallback: 'Your Page Title Will Appear Here' })}
          </div>
          <div
            id="sp-desc-preview"
            class="font-sans text-sm leading-relaxed text-[#4d5156] dark:text-[#bdc1c6]"
          >
            {
              t('serpPreview.previewDescDefault', {
                fallback: 'Your meta description will appear here.',
              })
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</ToolLayout>

<script is:inline data-astro-rerun>
  (() => {
    const titleInput = document.getElementById('sp-title');
    const urlInput = document.getElementById('sp-url');
    const descInput = document.getElementById('sp-desc');

    const titleCount = document.getElementById('sp-title-count');
    const descCount = document.getElementById('sp-desc-count');

    const urlPreview = document.getElementById('sp-url-preview');
    const titlePreview = document.getElementById('sp-title-preview');
    const descPreview = document.getElementById('sp-desc-preview');

    const defaultUrl = urlPreview.textContent.trim();
    const defaultTitle = titlePreview.textContent.trim();
    const defaultDesc = descPreview.textContent.trim();

    function update() {
      const title = titleInput.value;
      const url = urlInput.value;
      const desc = descInput.value;

      titleCount.textContent = `${title.length}/60`;
      titleCount.classList.toggle('text-red-500', title.length > 60);
      titleCount.classList.toggle('text-gray-500 dark:text-gray-400', title.length <= 60);

      descCount.textContent = `${desc.length}/160`;
      descCount.classList.toggle('text-red-500', desc.length > 160);
      descCount.classList.toggle('text-gray-500 dark:text-gray-400', desc.length <= 160);

      urlPreview.textContent = url || defaultUrl;
      titlePreview.textContent = title || defaultTitle;
      descPreview.textContent = desc || defaultDesc;
    }

    [titleInput, urlInput, descInput].forEach((el) => el.addEventListener('input', update));
  })();
</script>
