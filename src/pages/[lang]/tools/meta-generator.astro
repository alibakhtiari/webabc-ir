---
import ToolLayout from '@/layouts/ToolLayout.astro';
import { getLanguageStaticPaths, type SupportedLanguage } from '@/types/language';
import { getDictionary } from '@/i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);

const t = createTranslator(dictionary);

const titleText = t('metaGenerator.title', {
  fallback: 'HTML Meta Tag & Social Preview Generator',
});
const descriptionText = t('metaGenerator.description', {
  fallback:
    'Generate essential HTML meta tags, Open Graph, Twitter cards, and canonical links online.',
});

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name:
        supportedLang === 'fa'
          ? 'تگ‌های متا چیست و چرا برای سئو اهمیت دارند؟'
          : supportedLang === 'ar'
            ? 'ما هي علامات الميتا ولماذا هي مهمة للسيو؟'
            : 'What are Meta Tags and why are they important for SEO?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:
          supportedLang === 'fa'
            ? 'تگ‌های متا (Meta Tags) شامل اطلاعاتی در بخش head وب‌سایت هستند که به موتورهای جستجو عنوان، توضیحات، روبات‌ها و تگ‌های شبکه اجتماعی را برای نمایش بهترSERP ارائه می‌دهند.'
            : supportedLang === 'ar'
              ? 'علامات الميتا توفر لموتورات البحث وشبكات التواصل الاجتماعي المعلومات الأساسية لعرض الصفحة بشكل جذاب وصحيح.'
              : 'Meta tags provide essential page metadata to search engines and social media networks, defining page titles, descriptions, indexing rules, and Open Graph previews.',
      },
    },
  ],
};
---

<ToolLayout
  title={titleText}
  description={descriptionText}
  lang={supportedLang}
  slug="meta-generator"
  dictionary={dictionary}
  faqSchema={faqSchema}
>
  <!-- Main Workspace -->
  <section class="container mx-auto mt-12 mb-20 px-4 font-sans">
    <div class="mx-auto max-w-5xl space-y-8">
      <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-2">
        <!-- Form Inputs -->
        <div
          class="space-y-4 rounded-2xl border border-gray-100 bg-white p-6 font-persian shadow-sm dark:border-slate-800 dark:bg-slate-900"
          id="meta-form"
        >
          <h3
            class="border-b border-gray-100 pb-2 text-base font-bold text-gray-800 dark:border-slate-800 dark:text-gray-100"
          >
            {t('metaGenerator.formHeading', { fallback: 'Page Metadata Details' })}
          </h3>

          <div>
            <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
              >{t('metaGenerator.pageTitle', { fallback: 'Page Title' })} *</label
            >
            <input
              type="text"
              id="meta-title"
              value="WebABC - Web Design & Technical SEO Agency"
              class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
            />
          </div>

          <div>
            <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
              >{t('metaGenerator.metaDescription', { fallback: 'Meta Description' })} *</label
            >
            <textarea
              id="meta-desc"
              rows="3"
              class="w-full resize-none rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              >WebABC is a digital agency specializing in modern web design, performance
              optimization, and search engine optimization.</textarea
            >
          </div>

          <div>
            <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
              >{t('metaGenerator.canonicalUrlLabel', { fallback: 'Canonical Page URL' })}</label
            >
            <input
              type="url"
              id="meta-url"
              value="https://webabc.ir/en"
              class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
            />
          </div>

          <div>
            <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
              >{
                t('metaGenerator.socialImageLabel', { fallback: 'Social Image URL (og:image)' })
              }</label
            >
            <input
              type="url"
              id="meta-image"
              value="https://webabc.ir/images/homepage-hero.webp"
              class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
            />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
                >{t('metaGenerator.authorLabel', { fallback: 'Author' })}</label
              >
              <input
                type="text"
                id="meta-author"
                value="WebABC Team"
                class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>
            <div>
              <label class="mb-1 block text-xs font-semibold text-gray-600 dark:text-gray-300"
                >{t('metaGenerator.robotsLabel', { fallback: 'Robots Directive' })}</label
              >
              <select
                id="meta-robots"
                class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              >
                <option value="index, follow">index, follow</option>
                <option value="noindex, follow">noindex, follow</option>
                <option value="index, nofollow">index, nofollow</option>
                <option value="noindex, nofollow">noindex, nofollow</option>
              </select>
            </div>
          </div>
        </div>

        <!-- HTML Code Output -->
        <div
          class="sticky top-28 space-y-4 rounded-2xl border border-gray-100 bg-white p-6 font-persian shadow-sm dark:border-slate-800 dark:bg-slate-900"
        >
          <div
            class="flex items-center justify-between border-b border-gray-100 pb-3 dark:border-slate-800"
          >
            <h3 class="text-sm font-bold text-gray-800 dark:text-gray-100">
              {t('metaGenerator.generatedTags', { fallback: 'Generated Head HTML' })}
            </h3>
            <button
              type="button"
              id="copy-meta-btn"
              class="rounded-lg bg-primary px-3 py-1.5 text-xs font-bold text-primary-foreground transition-all hover:bg-primary/90 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
            >
              {t('metaGenerator.copy', { fallback: 'Copy HTML' })}
            </button>
          </div>

          <pre
            id="meta-output"
            dir="ltr"
            class="min-h-75 overflow-x-auto rounded-xl bg-gray-900 p-4 font-mono text-xs leading-relaxed text-green-400">
          </pre>

          <p
            role="status"
            aria-live="polite"
            id="copy-status"
            class="text-center text-xs font-semibold text-green-600 opacity-0 transition-opacity"
          >
            {t('metaGenerator.copied', { fallback: 'Meta tags copied to clipboard!' })}
          </p>
        </div>
      </div>
    </div>
  </section>
</ToolLayout>

<script is:inline data-astro-rerun>
  (() => {
    const metaForm = document.getElementById('meta-form');
    const metaOutput = document.getElementById('meta-output');
    const copyBtn = document.getElementById('copy-meta-btn');
    const copyStatus = document.getElementById('copy-status');

    function escapeAttr(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/"/g, '&quot;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
    }

    function updateMeta() {
      const title = escapeAttr(document.getElementById('meta-title').value);
      const desc = escapeAttr(document.getElementById('meta-desc').value);
      const url = escapeAttr(document.getElementById('meta-url').value);
      const image = escapeAttr(document.getElementById('meta-image').value);
      const author = escapeAttr(document.getElementById('meta-author').value);
      const robots = escapeAttr(document.getElementById('meta-robots').value);

      const html = `<!-- Primary Meta Tags -->
<title>${title}</title>
<meta name="title" content="${title}" />
<meta name="description" content="${desc}" />
<meta name="author" content="${author}" />
<meta name="robots" content="${robots}" />
<link rel="canonical" href="${url}" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content="${url}" />
<meta property="og:title" content="${title}" />
<meta property="og:description" content="${desc}" />
<meta property="og:image" content="${image}" />

<!-- Twitter Cards -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content="${url}" />
<meta property="twitter:title" content="${title}" />
<meta property="twitter:description" content="${desc}" />
<meta property="twitter:image" content="${image}" />`;

      metaOutput.textContent = html;
    }

    metaForm.addEventListener('input', updateMeta);
    updateMeta();

    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(metaOutput.textContent).then(() => {
        copyStatus.classList.remove('opacity-0');
        setTimeout(() => copyStatus.classList.add('opacity-0'), 2000);
      });
    });
  })();
</script>
