---
import Layout from '../../../layouts/Layout.astro';
import ToolsCTA from '../../../components/astro/ToolsCTA.astro';
import Breadcrumbs from '../../../components/astro/Breadcrumbs.astro';
import { getLanguageStaticPaths, type SupportedLanguage } from '../../../types/language';
import { getDictionary } from '../../../i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);

const t = createTranslator(dictionary);

const titleText = t('metaGenerator.title', { fallback: 'HTML Meta Tag & Social Preview Generator' });
const descriptionText = t('metaGenerator.description', { fallback: 'Generate essential HTML meta tags, Open Graph, Twitter cards, and canonical links online.' });

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": `https://webabc.ir/${supportedLang}/tools/meta-generator/#webapp`,
  "name": titleText,
  "description": descriptionText,
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires HTML5 support",
  "inLanguage": supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR'
};

const breadcrumbs = [
  { label: t('common.home'), url: `/${supportedLang}` },
  { label: t('common.tools'), url: `/${supportedLang}/tools` },
  { label: titleText }
];
---

<Layout title={titleText} description={descriptionText} lang={supportedLang} slug="tools/meta-generator">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webAppSchema)} />

  <!-- Hero Section -->
  <section class="bg-linear-to-b from-primary/5 to-white pt-24 pb-12 md:pt-40 md:pb-24 border-b border-gray-100 font-sans">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <Breadcrumbs items={breadcrumbs} lang={supportedLang} centered={true} />
        <h1 class="text-3xl md:text-5xl font-bold mb-6 bg-linear-to-r from-primary via-primary/80 to-primary/60 bg-clip-text text-transparent leading-normal font-persian">
          {titleText}
        </h1>
        <p class="text-lg md:text-xl text-gray-600 leading-relaxed font-persian">
          {descriptionText}
        </p>
      </div>
    </div>
  </section>

  <!-- Main Workspace -->
  <section class="container mx-auto px-4 mt-12 mb-20 font-sans">
    <div class="max-w-5xl mx-auto space-y-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
        <!-- Form Inputs -->
        <div class="bg-white border border-gray-100 rounded-2xl shadow-sm p-6 space-y-4 font-persian" id="meta-form">
          <h3 class="text-base font-bold text-gray-800 border-b border-gray-100 pb-2">{t('metaGenerator.formHeading', { fallback: 'Page Metadata Details' })}</h3>

          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1">{t('metaGenerator.pageTitle', { fallback: 'Page Title' })} *</label>
            <input type="text" id="meta-title" value="WebABC - Web Design & Technical SEO Agency" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:border-primary focus:outline-none" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1">{t('metaGenerator.metaDescription', { fallback: 'Meta Description' })} *</label>
            <textarea id="meta-desc" rows="3" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:border-primary focus:outline-none resize-none">WebABC is a digital agency specializing in modern web design, performance optimization, and search engine optimization.</textarea>
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1">{t('metaGenerator.canonicalUrlLabel', { fallback: 'Canonical Page URL' })}</label>
            <input type="url" id="meta-url" value="https://webabc.ir/en" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:border-primary focus:outline-none" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1">{t('metaGenerator.socialImageLabel', { fallback: 'Social Image URL (og:image)' })}</label>
            <input type="url" id="meta-image" value="https://webabc.ir/images/homepage-hero.webp" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:border-primary focus:outline-none" />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1">{t('metaGenerator.authorLabel', { fallback: 'Author' })}</label>
              <input type="text" id="meta-author" value="WebABC Team" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:border-primary focus:outline-none" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1">{t('metaGenerator.robotsLabel', { fallback: 'Robots Directive' })}</label>
              <select id="meta-robots" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:border-primary focus:outline-none">
                <option value="index, follow">index, follow</option>
                <option value="noindex, follow">noindex, follow</option>
                <option value="index, nofollow">index, nofollow</option>
                <option value="noindex, nofollow">noindex, nofollow</option>
              </select>
            </div>
          </div>
        </div>

        <!-- HTML Code Output -->
        <div class="bg-white border border-gray-100 rounded-2xl shadow-sm p-6 space-y-4 font-persian sticky top-28">
          <div class="flex justify-between items-center border-b border-gray-100 pb-3">
            <h3 class="text-sm font-bold text-gray-800">{t('metaGenerator.generatedTags', { fallback: 'Generated Head HTML' })}</h3>
            <button id="copy-meta-btn" class="px-3 py-1.5 bg-primary text-white text-xs font-bold rounded-lg hover:bg-primary/90 transition-all">
              {t('metaGenerator.copy', { fallback: 'Copy HTML' })}
            </button>
          </div>

          <pre id="meta-output" dir="ltr" class="p-4 bg-gray-900 text-green-400 rounded-xl font-mono text-xs overflow-x-auto min-h-[300px] leading-relaxed"></pre>

          <p id="copy-status" class="text-xs text-green-600 font-semibold opacity-0 transition-opacity text-center">
            {t('metaGenerator.copied', { fallback: 'Meta tags copied to clipboard!' })}
          </p>
        </div>
      </div>

    </div>
  </section>


  <ToolsCTA lang={supportedLang} t={t} related={[{ key: 'serpPreview', route: 'serp-preview' }, { key: 'seoTitleChecker', route: 'seo-title-checker' }, { key: 'tools.robotsGenerator', route: 'robots-generator' }]} ctaHref={`/${supportedLang}/services/seo`} isRtl={supportedLang !== 'en'} />
</Layout>

<script is:inline data-astro-rerun>
  const metaForm = document.getElementById('meta-form');
  const metaOutput = document.getElementById('meta-output');
  const copyBtn = document.getElementById('copy-meta-btn');
  const copyStatus = document.getElementById('copy-status');

  function escapeAttr(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/"/g, '&quot;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  function updateMeta() {
    const title = escapeAttr(document.getElementById('meta-title').value);
    const desc = escapeAttr(document.getElementById('meta-desc').value);
    const url = escapeAttr(document.getElementById('meta-url').value);
    const image = escapeAttr(document.getElementById('meta-image').value);
    const author = escapeAttr(document.getElementById('meta-author').value);
    const robots = escapeAttr(document.getElementById('meta-robots').value);

    const html = `<!-- Primary Meta Tags -->
<title>${title}</title>
<meta name="title" content="${title}" />
<meta name="description" content="${desc}" />
<meta name="author" content="${author}" />
<meta name="robots" content="${robots}" />
<link rel="canonical" href="${url}" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content="${url}" />
<meta property="og:title" content="${title}" />
<meta property="og:description" content="${desc}" />
<meta property="og:image" content="${image}" />

<!-- Twitter Cards -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content="${url}" />
<meta property="twitter:title" content="${title}" />
<meta property="twitter:description" content="${desc}" />
<meta property="twitter:image" content="${image}" />`;

    metaOutput.textContent = html;
  }

  metaForm.addEventListener('input', updateMeta);
  updateMeta();

  copyBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(metaOutput.textContent).then(() => {
      copyStatus.classList.remove('opacity-0');
      setTimeout(() => copyStatus.classList.add('opacity-0'), 2000);
    });
  });
</script>
