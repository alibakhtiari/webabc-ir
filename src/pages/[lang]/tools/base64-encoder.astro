---
import Layout from '../../../layouts/Layout.astro';
import ToolsCTA from '../../../components/astro/ToolsCTA.astro';
import Breadcrumbs from '../../../components/astro/Breadcrumbs.astro';
import { getLanguageStaticPaths, type SupportedLanguage } from '../../../types/language';
import { getDictionary } from '../../../i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);

const t = createTranslator(dictionary);

const titleText = t('base64.title', { fallback: 'Base64 Image & Text Encoder/Decoder' });
const descriptionText = t('base64.description', {
  fallback: 'Convert images to Base64 data URLs and encode or decode UTF-8 text strings online.',
});

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `https://webabc.ir/${supportedLang}/tools/base64-encoder/#webapp`,
  name: titleText,
  description: descriptionText,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'All',
  browserRequirements: 'Requires HTML5 support',
  inLanguage: supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name:
        supportedLang === 'fa'
          ? 'کدگذاری Base64 چیست و چه کاربردی در برنامه‌نویسی وب دارد؟'
          : supportedLang === 'ar'
            ? 'ما هو ترميز Base64 وما هي استخداماته في البرمجة؟'
            : 'What is Base64 Encoding and how is it used in web development?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:
          supportedLang === 'fa'
            ? 'کدگذاری Base64 داده‌های باینری مانند تصاویر یا متون را به کاراکترهای ASCII تبدیل می‌کند تا انتقال ایمن داده‌ها در پروتکل‌های وب (مانند Data URI و کدهای API) امکان‌پذیر شود.'
            : supportedLang === 'ar'
              ? 'يحول ترميز Base64 البيانات الثنائية والصور إلى نصوص ASCII لتمكين نقلها بأمان عبر بروتوكولات الويب وواجهات البرمجة.'
              : 'Base64 encoding converts binary data (such as images or files) into ASCII text format for safe transmission over text-based web protocols and Data URIs.',
      },
    },
  ],
};

const breadcrumbs = [
  { label: t('common.home'), url: `/${supportedLang}/` },
  { label: t('common.tools'), url: `/${supportedLang}/tools/` },
  { label: titleText },
];
---

<Layout
  title={titleText}
  description={descriptionText}
  lang={supportedLang}
  slug="tools/base64-encoder"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero Section -->
  <section
    class="border-b border-gray-100 bg-linear-to-b from-primary/10 via-background to-background pt-24 pb-12 font-sans md:pt-40 md:pb-24 dark:border-slate-800"
  >
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-3xl text-center">
        <Breadcrumbs items={breadcrumbs} lang={supportedLang} centered={true} />
        <h1
          class="mb-6 bg-linear-to-r from-primary via-primary/80 to-primary/60 bg-clip-text font-persian text-3xl leading-normal font-bold text-transparent md:text-5xl"
        >
          {titleText}
        </h1>
        <p class="font-persian text-lg leading-relaxed text-gray-600 md:text-xl dark:text-gray-300">
          {descriptionText}
        </p>
      </div>
    </div>
  </section>

  <!-- Main Workspace -->
  <section class="container mx-auto mt-12 mb-20 px-4 font-sans">
    <div class="mx-auto max-w-4xl space-y-8">
      <!-- Mode Tabs -->
      <div
        class="rounded-2xl border border-gray-100 bg-white p-4 font-persian shadow-sm dark:border-slate-800 dark:bg-slate-900"
      >
        <div class="flex gap-2">
          <button
            type="button"
            id="mode-image-btn"
            class="mode-tab rounded-xl bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-all focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
            >{t('base64.modeImage', { fallback: 'Image to Base64' })}</button
          >
          <button
            type="button"
            id="mode-text-btn"
            class="mode-tab rounded-xl bg-gray-100 px-5 py-2.5 text-sm font-semibold text-gray-700 transition-all hover:bg-gray-200 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:bg-slate-800 dark:text-gray-300 dark:hover:bg-slate-700"
            >{t('base64.modeText', { fallback: 'Text Encode / Decode' })}</button
          >
        </div>
      </div>

      <!-- Image to Base64 Converter Section -->
      <div id="section-image" class="space-y-6">
        <div
          id="drop-zone"
          class="cursor-pointer space-y-3 rounded-2xl border-2 border-dashed border-gray-200 bg-white p-10 text-center font-persian transition-all hover:border-primary dark:border-slate-700 dark:bg-slate-900"
        >
          <input type="file" id="file-input" accept="image/*" class="hidden" />
          <div
            class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary"
          >
            <svg
              aria-hidden="true"
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path></svg
            >
          </div>
          <h3 class="text-base font-bold text-gray-800 dark:text-gray-100">
            {t('base64.dropHint', { fallback: 'Drop an Image file here or Click to Upload' })}
          </h3>
          <p class="text-xs text-gray-400">
            {t('base64.dropSubtext', { fallback: 'Supports PNG, JPG, WebP, SVG, GIF up to 5MB' })}
          </p>
        </div>

        <!-- Image Result Box -->
        <div
          id="img-result-box"
          class="hidden space-y-4 rounded-2xl border border-gray-100 bg-white p-6 font-persian shadow-sm dark:border-slate-800 dark:bg-slate-900"
        >
          <div
            class="flex items-center justify-between border-b border-gray-100 pb-3 dark:border-slate-800"
          >
            <h3 class="text-sm font-bold text-gray-800 dark:text-gray-100">
              {t('base64.dataUrlOutput', { fallback: 'Data URL Output' })}
            </h3>
            <button
              type="button"
              id="copy-img-btn"
              class="rounded-lg bg-primary px-3 py-1.5 text-xs font-bold text-primary-foreground transition-all hover:bg-primary/90 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
            >
              {t('base64.copyBase64', { fallback: 'Copy Base64' })}
            </button>
          </div>

          <div class="flex items-center gap-4">
            <img
              id="img-preview"
              alt="Base64 image preview"
              width="64"
              height="64"
              class="h-16 w-16 rounded-lg border border-gray-200 bg-white object-cover text-gray-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
            />
            <div id="img-meta" class="space-y-1 font-mono text-xs text-gray-500 dark:text-gray-400">
            </div>
          </div>

          <textarea
            id="img-output"
            rows="4"
            dir="ltr"
            readonly
            class="w-full resize-none rounded-xl border border-gray-200 bg-gray-50 p-3 font-mono text-xs text-gray-700 dark:border-slate-700 dark:bg-slate-900 dark:text-gray-200"
          ></textarea>
        </div>
      </div>

      <!-- Text Encode/Decode Section -->
      <div id="section-text" class="hidden space-y-6">
        <div
          class="space-y-4 rounded-2xl border border-gray-100 bg-white p-6 font-persian shadow-sm dark:border-slate-800 dark:bg-slate-900"
        >
          <label class="block text-sm font-semibold text-gray-700 dark:text-gray-200"
            >{t('base64.inputTextLabel', { fallback: 'Input Text' })}</label
          >
          <textarea
            id="text-input"
            rows="4"
            dir="auto"
            placeholder={t('base64.textPlaceholder', {
              fallback: 'Enter text to encode or Base64 string to decode...',
            })}
            class="w-full resize-none rounded-xl border border-gray-200 bg-white p-4 text-sm text-gray-900 focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
          ></textarea>

          <div class="flex gap-3">
            <button
              type="button"
              id="encode-btn"
              class="rounded-xl bg-primary px-5 py-2.5 text-xs font-bold text-primary-foreground transition-all hover:bg-primary/90 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
              >{t('base64.encodeBtn', { fallback: 'Encode to Base64' })}</button
            >
            <button
              type="button"
              id="decode-btn"
              class="rounded-xl bg-gray-100 px-5 py-2.5 text-xs font-bold text-gray-700 transition-all hover:bg-gray-200 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:bg-slate-800 dark:text-gray-300 dark:hover:bg-slate-700"
              >{t('base64.decodeBtn', { fallback: 'Decode from Base64' })}</button
            >
          </div>
        </div>

        <div
          class="space-y-4 rounded-2xl border border-gray-100 bg-white p-6 font-persian shadow-sm dark:border-slate-800 dark:bg-slate-900"
        >
          <div
            class="flex items-center justify-between border-b border-gray-100 pb-3 dark:border-slate-800"
          >
            <h3 class="text-sm font-bold text-gray-800 dark:text-gray-100">
              {t('base64.outputResult', { fallback: 'Output Result' })}
            </h3>
            <button
              type="button"
              id="copy-text-btn"
              class="text-xs font-semibold text-primary hover:underline focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
              >{t('base64.copyResult', { fallback: 'Copy Result' })}</button
            >
          </div>
          <div
            id="text-output"
            dir="ltr"
            class="min-h-16 w-full rounded-xl border border-gray-200 bg-gray-50/50 p-4 font-mono text-sm break-all text-gray-800 dark:border-slate-700 dark:bg-slate-900 dark:text-gray-100"
          >
            {t('base64.resultPlaceholder', { fallback: 'Result will appear here...' })}
          </div>
        </div>
      </div>

      <p
        id="copy-status"
        class="text-center font-persian text-xs font-semibold text-green-600 opacity-0 transition-opacity"
      >
        {t('base64.copiedStatus', { fallback: 'Copied to clipboard!' })}
      </p>
    </div>
  </section>

  <ToolsCTA
    lang={supportedLang}
    t={t}
    related={[
      { key: 'qrGenerator', route: 'qr-generator' },
      { key: 'jsonFormatter', route: 'json-formatter' },
      { key: 'tools.metaGen', route: 'meta-generator' },
    ]}
    ctaHref={`/${supportedLang}/services/web-development/`}
    isRtl={supportedLang !== 'en'}
  />
</Layout>

<script is:inline data-astro-rerun>
  (() => {
    const modeImgBtn = document.getElementById('mode-image-btn');
    const modeTextBtn = document.getElementById('mode-text-btn');
    const secImg = document.getElementById('section-image');
    const secText = document.getElementById('section-text');
    const dropZone = document.getElementById('drop-zone');
    const fileInput = document.getElementById('file-input');
    const imgPreview = document.getElementById('img-preview');
    const imgOutput = document.getElementById('img-output');
    const imgMeta = document.getElementById('img-meta');
    const imgResultBox = document.getElementById('img-result-box');
    const copyImgBtn = document.getElementById('copy-img-btn');
    const encodeBtn = document.getElementById('encode-btn');
    const decodeBtn = document.getElementById('decode-btn');
    const textInput = document.getElementById('text-input');
    const textOutput = document.getElementById('text-output');
    const copyTextBtn = document.getElementById('copy-text-btn');
    const copyStatus = document.getElementById('copy-status');

    if (!modeImgBtn || !modeTextBtn) return;

    // Switch modes
    modeImgBtn.addEventListener('click', () => {
      modeImgBtn.className =
        'mode-tab rounded-xl bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-all focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2';
      modeTextBtn.className =
        'mode-tab rounded-xl bg-gray-100 px-5 py-2.5 text-sm font-semibold text-gray-700 transition-all hover:bg-gray-200 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:bg-slate-800 dark:text-gray-300 dark:hover:bg-slate-700';
      secImg.classList.remove('hidden');
      secText.classList.add('hidden');
    });

    modeTextBtn.addEventListener('click', () => {
      modeTextBtn.className =
        'mode-tab rounded-xl bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-all focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2';
      modeImgBtn.className =
        'mode-tab rounded-xl bg-gray-100 px-5 py-2.5 text-sm font-semibold text-gray-700 transition-all hover:bg-gray-200 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:bg-slate-800 dark:text-gray-300 dark:hover:bg-slate-700';
      secText.classList.remove('hidden');
      secImg.classList.add('hidden');
    });

    // Image upload & drag drop
    dropZone.addEventListener('click', () => fileInput.click());

    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('border-primary', 'bg-primary/5');
    });

    dropZone.addEventListener('dragleave', () => {
      dropZone.classList.remove('border-primary', 'bg-primary/5');
    });

    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-primary', 'bg-primary/5');
      if (e.dataTransfer.files && e.dataTransfer.files[0]) {
        processImage(e.dataTransfer.files[0]);
      }
    });

    fileInput.addEventListener('change', (e) => {
      if (e.target.files && e.target.files[0]) {
        processImage(e.target.files[0]);
      }
    });

    function processImage(file) {
      if (!file.type.startsWith('image/')) return;

      const reader = new FileReader();
      reader.onload = function (e) {
        const dataUrl = e.target.result;
        imgPreview.src = dataUrl;
        imgOutput.value = dataUrl;
        imgMeta.innerHTML = `<div>Filename: <strong>${file.name}</strong></div><div>Size: <strong>${(file.size / 1024).toFixed(1)} KB</strong></div><div>Type: <strong>${file.type}</strong></div>`;
        imgResultBox.classList.remove('hidden');
      };
      reader.readAsDataURL(file);
    }

    // Text Encoding / Decoding UTF-8 support
    encodeBtn.addEventListener('click', () => {
      const text = textInput.value;
      if (!text) return;
      try {
        const encoded = btoa(
          encodeURIComponent(text).replace(/%([0-9A-F]{2})/g, (match, p1) =>
            String.fromCharCode('0x' + p1)
          )
        );
        textOutput.textContent = encoded;
      } catch (e) {
        textOutput.textContent = 'Encoding error.';
      }
    });

    decodeBtn.addEventListener('click', () => {
      const text = textInput.value.trim();
      if (!text) return;
      try {
        const decoded = decodeURIComponent(
          Array.prototype.map
            .call(atob(text), (c) => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2))
            .join('')
        );
        textOutput.textContent = decoded;
      } catch (e) {
        textOutput.textContent = 'Invalid Base64 string.';
      }
    });

    copyImgBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(imgOutput.value).then(() => {
        copyStatus.classList.remove('opacity-0');
        setTimeout(() => copyStatus.classList.add('opacity-0'), 2000);
      });
    });

    copyTextBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(textOutput.textContent).then(() => {
        copyStatus.classList.remove('opacity-0');
        setTimeout(() => copyStatus.classList.add('opacity-0'), 2000);
      });
    });
  })();
</script>
