---
import Layout from '../../../layouts/Layout.astro';
import ToolsCTA from '../../../components/astro/ToolsCTA.astro';
import Breadcrumbs from '../../../components/astro/Breadcrumbs.astro';
import { getLanguageStaticPaths, type SupportedLanguage } from '../../../types/language';
import { getDictionary } from '../../../i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);

const t = createTranslator(dictionary);

const titleText = t('base64.title', { fallback: 'Base64 Image & Text Encoder/Decoder' });
const descriptionText = t('base64.description', { fallback: 'Convert images to Base64 data URLs and encode or decode UTF-8 text strings online.' });

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": `https://webabc.ir/${supportedLang}/tools/base64-encoder/#webapp`,
  "name": titleText,
  "description": descriptionText,
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires HTML5 support",
  "inLanguage": supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR'
};

const breadcrumbs = [
  { label: t('common.home'), url: `/${supportedLang}` },
  { label: t('common.tools'), url: `/${supportedLang}/tools` },
  { label: titleText }
];
---

<Layout title={titleText} description={descriptionText} lang={supportedLang} slug="tools/base64-encoder">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webAppSchema)} />

  <!-- Hero Section -->
  <section class="bg-linear-to-b from-primary/5 to-white pt-24 pb-12 md:pt-40 md:pb-24 border-b border-gray-100 font-sans">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <Breadcrumbs items={breadcrumbs} lang={supportedLang} centered={true} />
        <h1 class="text-3xl md:text-5xl font-bold mb-6 bg-linear-to-r from-primary via-primary/80 to-primary/60 bg-clip-text text-transparent leading-normal font-persian">
          {titleText}
        </h1>
        <p class="text-lg md:text-xl text-gray-600 leading-relaxed font-persian">
          {descriptionText}
        </p>
      </div>
    </div>
  </section>

  <!-- Main Workspace -->
  <section class="container mx-auto px-4 mt-12 mb-20 font-sans">
    <div class="max-w-4xl mx-auto space-y-8">
      
      <!-- Mode Tabs -->
      <div class="bg-white border border-gray-100 rounded-2xl shadow-sm p-4 font-persian">
        <div class="flex gap-2">
          <button id="mode-image-btn" class="mode-tab px-5 py-2.5 text-sm font-semibold rounded-xl bg-primary text-white transition-all">{t('base64.modeImage', { fallback: 'Image to Base64' })}</button>
          <button id="mode-text-btn" class="mode-tab px-5 py-2.5 text-sm font-semibold rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 transition-all">{t('base64.modeText', { fallback: 'Text Encode / Decode' })}</button>
        </div>
      </div>

      <!-- Image to Base64 Converter Section -->
      <div id="section-image" class="space-y-6">
        <div id="drop-zone" class="bg-white border-2 border-dashed border-gray-200 hover:border-primary rounded-2xl p-10 text-center cursor-pointer transition-all space-y-3 font-persian">
          <input type="file" id="file-input" accept="image/*" class="hidden" />
          <div class="w-12 h-12 rounded-full bg-primary/10 text-primary mx-auto flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          </div>
          <h3 class="text-base font-bold text-gray-800">{t('base64.dropHint', { fallback: 'Drop an Image file here or Click to Upload' })}</h3>
          <p class="text-xs text-gray-400">{t('base64.dropSubtext', { fallback: 'Supports PNG, JPG, WebP, SVG, GIF up to 5MB' })}</p>
        </div>

        <!-- Image Result Box -->
        <div id="img-result-box" class="bg-white border border-gray-100 rounded-2xl shadow-sm p-6 space-y-4 font-persian hidden">
          <div class="flex justify-between items-center border-b border-gray-100 pb-3">
            <h3 class="text-sm font-bold text-gray-800">{t('base64.dataUrlOutput', { fallback: 'Data URL Output' })}</h3>
            <button id="copy-img-btn" class="px-3 py-1.5 bg-primary text-white text-xs font-bold rounded-lg hover:bg-primary/90 transition-all">
              {t('base64.copyBase64', { fallback: 'Copy Base64' })}
            </button>
          </div>
          
          <div class="flex items-center gap-4">
            <img id="img-preview" alt="Base64 image preview" width="64" height="64" class="w-16 h-16 object-cover rounded-lg border border-gray-200" />
            <div id="img-meta" class="text-xs text-gray-500 font-mono space-y-1"></div>
          </div>

          <textarea id="img-output" rows="4" dir="ltr" readonly class="w-full border border-gray-200 rounded-xl p-3 bg-gray-50 font-mono text-xs text-gray-700 resize-none"></textarea>
        </div>
      </div>

      <!-- Text Encode/Decode Section -->
      <div id="section-text" class="space-y-6 hidden">
        <div class="bg-white border border-gray-100 rounded-2xl shadow-sm p-6 space-y-4 font-persian">
          <label class="block text-sm font-semibold text-gray-700">{t('base64.inputTextLabel', { fallback: 'Input Text' })}</label>
          <textarea id="text-input" rows="4" dir="auto" placeholder={t('base64.textPlaceholder', { fallback: 'Enter text to encode or Base64 string to decode...' })} class="w-full border border-gray-200 rounded-xl p-4 focus:outline-none focus:border-primary text-sm resize-none"></textarea>

          <div class="flex gap-3">
            <button id="encode-btn" class="px-5 py-2.5 bg-primary text-white text-xs font-bold rounded-xl hover:bg-primary/90 transition-all">{t('base64.encodeBtn', { fallback: 'Encode to Base64' })}</button>
            <button id="decode-btn" class="px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-bold rounded-xl transition-all">{t('base64.decodeBtn', { fallback: 'Decode from Base64' })}</button>
          </div>
        </div>

        <div class="bg-white border border-gray-100 rounded-2xl shadow-sm p-6 space-y-4 font-persian">
          <div class="flex justify-between items-center border-b border-gray-100 pb-3">
            <h3 class="text-sm font-bold text-gray-800">{t('base64.outputResult', { fallback: 'Output Result' })}</h3>
            <button id="copy-text-btn" class="text-xs font-semibold text-primary hover:underline">{t('base64.copyResult', { fallback: 'Copy Result' })}</button>
          </div>
          <div id="text-output" dir="ltr" class="w-full min-h-[4rem] border border-gray-200 rounded-xl p-4 bg-gray-50/50 text-gray-800 font-mono text-sm break-all">
            {t('base64.resultPlaceholder', { fallback: 'Result will appear here...' })}
          </div>
        </div>
      </div>

      <p id="copy-status" class="text-xs text-green-600 font-semibold opacity-0 transition-opacity text-center font-persian">
        {t('base64.copiedStatus', { fallback: 'Copied to clipboard!' })}
      </p>

    </div>
  </section>


  <ToolsCTA lang={supportedLang} t={t} related={[{ key: 'tools.jsonFormatter', route: 'json-formatter' }, { key: 'tools.robotsGenerator', route: 'robots-generator' }, { key: 'loremGenerator', route: 'lorem-generator' }]} ctaHref={`/${supportedLang}/services/web-development`} isRtl={supportedLang !== 'en'} />
</Layout>

<script is:inline data-astro-rerun>
  const modeImgBtn = document.getElementById('mode-image-btn');
  const modeTextBtn = document.getElementById('mode-text-btn');
  const secImg = document.getElementById('section-image');
  const secText = document.getElementById('section-text');

  const dropZone = document.getElementById('drop-zone');
  const fileInput = document.getElementById('file-input');
  const imgResultBox = document.getElementById('img-result-box');
  const imgPreview = document.getElementById('img-preview');
  const imgMeta = document.getElementById('img-meta');
  const imgOutput = document.getElementById('img-output');
  const copyImgBtn = document.getElementById('copy-img-btn');

  const textInput = document.getElementById('text-input');
  const textOutput = document.getElementById('text-output');
  const encodeBtn = document.getElementById('encode-btn');
  const decodeBtn = document.getElementById('decode-btn');
  const copyTextBtn = document.getElementById('copy-text-btn');
  const copyStatus = document.getElementById('copy-status');

  // Switch modes
  modeImgBtn.addEventListener('click', () => {
    modeImgBtn.className = 'mode-tab px-5 py-2.5 text-sm font-semibold rounded-xl bg-primary text-white transition-all';
    modeTextBtn.className = 'mode-tab px-5 py-2.5 text-sm font-semibold rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 transition-all';
    secImg.classList.remove('hidden');
    secText.classList.add('hidden');
  });

  modeTextBtn.addEventListener('click', () => {
    modeTextBtn.className = 'mode-tab px-5 py-2.5 text-sm font-semibold rounded-xl bg-primary text-white transition-all';
    modeImgBtn.className = 'mode-tab px-5 py-2.5 text-sm font-semibold rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 transition-all';
    secText.classList.remove('hidden');
    secImg.classList.add('hidden');
  });

  // Image upload & drag drop
  dropZone.addEventListener('click', () => fileInput.click());

  dropZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('border-primary', 'bg-primary/5');
  });

  dropZone.addEventListener('dragleave', () => {
    dropZone.classList.remove('border-primary', 'bg-primary/5');
  });

  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-primary', 'bg-primary/5');
    if (e.dataTransfer.files && e.dataTransfer.files[0]) {
      processImage(e.dataTransfer.files[0]);
    }
  });

  fileInput.addEventListener('change', (e) => {
    if (e.target.files && e.target.files[0]) {
      processImage(e.target.files[0]);
    }
  });

  function processImage(file) {
    if (!file.type.startsWith('image/')) return;

    const reader = new FileReader();
    reader.onload = function(e) {
      const dataUrl = e.target.result;
      imgPreview.src = dataUrl;
      imgOutput.value = dataUrl;
      imgMeta.innerHTML = `<div>Filename: <strong>${file.name}</strong></div><div>Size: <strong>${(file.size / 1024).toFixed(1)} KB</strong></div><div>Type: <strong>${file.type}</strong></div>`;
      imgResultBox.classList.remove('hidden');
    };
    reader.readAsDataURL(file);
  }

  // Text Encoding / Decoding UTF-8 support
  encodeBtn.addEventListener('click', () => {
    const text = textInput.value;
    if (!text) return;
    try {
      const encoded = btoa(encodeURIComponent(text).replace(/%([0-9A-F]{2})/g, (match, p1) => String.fromCharCode('0x' + p1)));
      textOutput.textContent = encoded;
    } catch(e) {
      textOutput.textContent = 'Encoding error.';
    }
  });

  decodeBtn.addEventListener('click', () => {
    const text = textInput.value.trim();
    if (!text) return;
    try {
      const decoded = decodeURIComponent(Array.prototype.map.call(atob(text), c => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)).join(''));
      textOutput.textContent = decoded;
    } catch(e) {
      textOutput.textContent = 'Invalid Base64 string.';
    }
  });

  copyImgBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(imgOutput.value).then(() => {
      copyStatus.classList.remove('opacity-0');
      setTimeout(() => copyStatus.classList.add('opacity-0'), 2000);
    });
  });

  copyTextBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(textOutput.textContent).then(() => {
      copyStatus.classList.remove('opacity-0');
      setTimeout(() => copyStatus.classList.add('opacity-0'), 2000);
    });
  });
</script>
