<script is:inline data-astro-rerun>
  (() => {
    const siteTypeRadios = document.querySelectorAll('input[name="site-type"]');
    const slider = document.getElementById('page-count-slider');
    const pageValText = document.getElementById('page-count-val');

    const featureMultilingual = document.getElementById('feature-multilingual');
    const featureSEO = document.getElementById('feature-seo');
    const featureSpeed = document.getElementById('feature-speed');
    const featureSecurity = document.getElementById('feature-security');

    const baseCostText = document.getElementById('base-cost-text');
    const pagesCostText = document.getElementById('pages-cost-text');
    const addonsCostText = document.getElementById('addons-cost-text');
    const totalPriceText = document.getElementById('total-price-text');
    const summaryCard = document.getElementById('calculator-summary-card');
    const bookBtn = document.getElementById('book-calculator-consultation-btn');

    let currentState = {
      typeLabel: 'WordPress',
      pages: 5,
      addons: [],
      totalFormatted: '$1,050',
    };

    function calculatePrice() {
      if (!slider || !pageValText) return;
      let basePrice = 800;
      let selectedType = 'wordpress';
      let selectedLabel = 'WordPress';
      siteTypeRadios.forEach((radio) => {
        if (radio.checked) {
          selectedType = radio.value;
          selectedLabel = radio.dataset.label || radio.value;
        }
      });

      if (selectedType === 'wordpress') basePrice = 800;
      else if (selectedType === 'custom') basePrice = 1500;
      else if (selectedType === 'ecommerce') basePrice = 1800;

      const pageCount = parseInt(slider.value, 10) || 5;
      pageValText.innerText = `${pageCount} ${
        pageCount > 1 ? pageValText.dataset.pagesMany : pageValText.dataset.pagesOne
      }`;
      const pagesCost = pageCount * 50;

      let addonsCost = 0;
      const activeAddons = [];
      [featureMultilingual, featureSEO, featureSpeed, featureSecurity].forEach((chk) => {
        if (chk && chk.checked) {
          addonsCost += parseFloat(chk.value);
          if (chk.dataset.addonName) activeAddons.push(chk.dataset.addonName);
        }
      });

      const total = basePrice + pagesCost + addonsCost;

      if (baseCostText) baseCostText.innerText = `$${basePrice.toLocaleString()}`;
      if (pagesCostText) pagesCostText.innerText = `$${pagesCost.toLocaleString()}`;
      if (addonsCostText) addonsCostText.innerText = `$${addonsCost.toLocaleString()}`;
      if (totalPriceText) totalPriceText.innerText = `$${total.toLocaleString()}`;

      currentState = {
        typeLabel: selectedLabel,
        pages: pageCount,
        addons: activeAddons,
        totalFormatted: `$${total.toLocaleString()}`,
      };
    }

    siteTypeRadios.forEach((radio) => radio.addEventListener('change', calculatePrice));
    if (slider) slider.addEventListener('input', calculatePrice);
    [featureMultilingual, featureSEO, featureSpeed, featureSecurity].forEach((chk) => {
      if (chk) chk.addEventListener('change', calculatePrice);
    });

    if (bookBtn) {
      bookBtn.addEventListener('click', () => {
        const dialog = document.getElementById('consultation-modal');
        const msgInput = document.getElementById('consultation-message');
        const tpl =
          (summaryCard && summaryCard.dataset.quoteTemplate) ||
          'Platform: {type} | Pages: {pages} | Add-ons: {addons} | Estimated Budget: {total}';
        const addonsStr = currentState.addons.length ? currentState.addons.join(', ') : '—';
        if (msgInput) {
          msgInput.value = tpl
            .replace('{type}', currentState.typeLabel)
            .replace('{pages}', String(currentState.pages))
            .replace('{addons}', addonsStr)
            .replace('{total}', currentState.totalFormatted);
        }
        if (dialog && typeof dialog.showModal === 'function') {
          dialog.showModal();
        } else {
          const activeLang = (summaryCard && summaryCard.dataset.lang) || 'en';
          window.location.href = `/${activeLang}/contact/`;
        }
      });
    }

    calculatePrice();
  })();
</script>
