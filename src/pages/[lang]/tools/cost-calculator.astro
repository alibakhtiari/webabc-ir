---
import ToolLayout from '@/layouts/ToolLayout.astro';
import { getLanguageStaticPaths, type SupportedLanguage, languages } from '@/types/language';
import { getDictionary } from '@/i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);
const isRtl = languages[supportedLang]?.direction === 'rtl';
const fontClass =
  supportedLang === 'fa' ? 'font-persian' : supportedLang === 'ar' ? 'font-arabic' : 'font-sans';

const t = createTranslator(dictionary);

const titleText = t('costCalculator.title', { fallback: 'Website Cost Estimator' });
const descriptionText = t('costCalculator.description', {
  fallback:
    'Estimate the cost of your web development or SEO campaign in seconds with our interactive calculator.',
});

const faqItems =
  supportedLang === 'fa'
    ? [
        {
          question: 'هزینه طراحی سایت وردپرس در سال ۱۴۰۵ (۲۰۲۶) چقدر است؟',
          answer:
            'هزینه طراحی سایت وردپرس حرفه‌ای بر اساس تعداد صفحات و اختصاصی بودن قالب معمولاً از حدود ۸۵۰ تا ۲,۸۰۰ دلار (معادل ریالی روز بازار ایران برای قالب‌های سفارشی و فروشگاهی ووکامرس) متغیر است و امکانات چندزبانه یا سئو پیشرفته به صورت شفاف به پایه اضافه می‌شوند.',
        },
        {
          question: 'تفاوت قیمت طراحی سایت وردپرسی با کدنویسی اختصاصی (Astro / Next.js) چیست؟',
          answer:
            'سایت‌های وردپرسی هزینه اولیه پایین‌تر و پنل مدیریت آماده دارند، در حالی که توسعه اختصاصی با Astro و Next.js هزینه مهندسی بالاتری دارد اما سرعت بارگذاری زیر یک ثانیه، امنیت بدون افزونه و قابلیت اتصال نامحدود به ERP و CRM را فراهم می‌کند.',
        },
        {
          question: 'چه عواملی بیشترین تاثیر را در افزایش قیمت طراحی سایت فروشگاهی دارند؟',
          answer:
            'تعداد قالب‌های اختصاصی، اتصال دوطرفه به نرم‌افزارهای حسابداری و انبارداری (مانند سپیدار و راهکاران)، معماری چندزبانه راست‌به‌چپ و چپ‌به‌راست، درگاه‌های پرداخت چندگانه و پیاده‌سازی اسکیمای پیشرفته محصولات بیشترین سهم را در بودجه دارند.',
        },
        {
          question: 'چگونه پس از محاسبه آنلاین هزینه طراحی سایت پیش‌فاکتور رسمی دریافت کنم؟',
          answer:
            'کافی است گزینه‌های پروژه خود را در ماشین‌حساب بالا انتخاب کرده و روی دکمه «رزرو مشاوره و دریافت پیش‌فاکتور» کلیک کنید تا مشخصات انتخابی شما مستقیماً در فرم مشاوره درج و برای تیم فنی ارسال شود.',
        },
      ]
    : supportedLang === 'ar'
      ? [
          {
            question: 'كم تبلغ تكلفة تصميم موقع إلكتروني احترافي في عام 2026؟',
            answer:
              'تتراوح تكلفة موقع الأعمال الاحترافي المبني على ووردبريس المخصص بين 800 و2,800 دولار أمريكي، بينما تبدأ المتاجر الإلكترونية المتكاملة والمنصات المخصصة عبر Astro وNext.js من 1,500 إلى 8,000+ دولار حسب عدد الصفحات والتكاملات البرمجية.',
          },
          {
            question: 'ما الفرق في التكلفة بين ووردبريس والبرمجة المخصصة (Astro / Next.js)؟',
            answer:
              'يوفر ووردبريس تكلفة تأسيس أقل ولوحة إدارة محتوى جاهزة، بينما تتطلب البرمجة المخصصة استثماراً أولياً أعلى مقابل سرعة تحميل دون الثانية، وأمان خالٍ من ثغرات الإضافات، وربط مرن مع أنظمة ERP وCRM.',
          },
          {
            question: 'ما أبرز العوامل التي ترفع تكلفة تصميم المتاجر الإلكترونية؟',
            answer:
              'بنية تعدد اللغات (العربية والإنجليزية)، وربط بوابات الدفع الخليجية والمحلية (Mada وTabby وTamara وStripe)، ومزامنة المخزون والمحاسبة، وتطبيق بيانات المنتجات المنظمة SEO هي المحركات الرئيسية للتكلفة.',
          },
          {
            question: 'كيف أحصل على عرض سعر رسمي ومفصل بعد استخدام الحاسبة؟',
            answer:
              'اختر نوع الموقع وعدد الصفحات والمزايا المطلوبة في الحاسبة أعلاه ثم اضغط على زر حجز الاستشارة، ليتم نقل تقديرك تلقائياً إلى نموذج التواصل ومراجعته مع مهندسينا مجاناً.',
          },
        ]
      : [
          {
            question: 'How much does a professional website cost in 2026?',
            answer:
              'Custom-themed WordPress business websites typically range from $800 to $2,800, full WooCommerce or Shopify stores run $1,800 to $6,500, and custom full-stack Astro or Next.js web applications range from $1,500 to $12,000+ depending on page scope and API integrations.',
          },
          {
            question: 'Why does custom Astro or Next.js development cost more than WordPress?',
            answer:
              'WordPress reuses an existing CMS core and database schema, lowering initial setup hours. Custom Astro or Next.js engineering hand-builds frontend components, edge routing, and typed API integrations from scratch for sub-second Core Web Vitals and zero plugin maintenance.',
          },
          {
            question: 'Which features increase website development budgets the most?',
            answer:
              'True multilingual RTL/LTR parity (English, Arabic, and Persian), e-commerce checkout and ERP inventory synchronization, custom calculators or client portals, and structured technical SEO/GEO entity graphs are the primary scope multipliers.',
          },
          {
            question: 'How do I turn this instant estimate into a fixed-scope proposal?',
            answer:
              'Select your platform, page count, and add-on modules above, then click Book Consultation—your exact configuration and estimated budget pre-fill directly into our consultation request form for a free technical scoping review.',
          },
        ];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const quickAnswer =
  supportedLang === 'fa'
    ? 'ماشین‌حساب آنلاین هزینه طراحی سایت وب اِی‌بی‌سی بر اساس چهار متغیر واقعی پروژه‌های مهندسی وب—نوع پلتفرم (وردپرس، کدنویسی اختصاصی Astro/Next.js یا فروشگاه اینترنتی)، تعداد صفحات، چندزبانه بودن و ماژول‌های سئو، سرعت و امنیت—بازه شفاف بودجه پروژه شما را در لحظه محاسبه می‌کند.'
    : supportedLang === 'ar'
      ? 'تحسب أداة تقدير تكلفة تصميم المواقع من ويب إيه بي سي ميزانية مشروعك فوريّاً بناءً على المتغيرات الهندسية الفعلية: نوع المنصة (ووردبريس، برمجة مخصصة Astro/Next.js، أو متجر إلكتروني)، وعدد الصفحات، ودعم تعدد اللغات، وإضافات السيو والسرعة والأمان.'
      : 'The WebABC Website Cost Calculator estimates your 2026 web design and development budget in real time using transparent agency scoping variables: base platform (WordPress, custom Astro/Next.js code, or e-commerce), page count, multilingual RTL/LTR parity, technical SEO/GEO setup, Core Web Vitals tuning, and WAF security.';

const costBenchmarks =
  supportedLang === 'fa'
    ? {
        title: 'جدول مرجع تعرفه طراحی سایت در سال ۱۴۰۵ (۲۰۲۶) بر اساس نوع پروژه',
        headers: ['نوع وب‌سایت', 'پشته فنی پیشنهادی', 'زمان تحویل معمول', 'بازه بودجه تخمینی'],
        rows: [
          ['سایت شرکتی و خدماتی استاندارد', 'وردپرس اختصاصی بدون صفحه‌ساز سنگین', '۲ تا ۴ هفته', '$850 – $2,200'],
          ['فروشگاه اینترنتی حرفه‌ای', 'ووکامرس سفارشی / Shopify', '۴ تا ۶ هفته', '$1,800 – $5,500'],
          ['سایت شرکتی و صادراتی چندزبانه', 'Astro 7 + Cloudflare Edge (EN/FA/AR)', '۴ تا ۷ هفته', '$2,000 – $6,000'],
          ['وب‌اپلیکیشن و پورتال سازمانی B2B', 'Next.js / Astro + Node.js + اتصال ERP', '۶ تا ۱۲ هفته', '$3,500 – $12,000+'],
        ],
      }
    : supportedLang === 'ar'
      ? {
          title: 'جدول نطاقات أسعار تصميم وتطوير المواقع لعام 2026',
          headers: ['نوع المشروع', 'التقنية الموصى بها', 'مدة التنفيذ المعتادة', 'النطاق التقديري (USD)'],
          rows: [
            ['موقع تعريفي للشركات والخدمات', 'ووردبريس بقالب مخصص خفيف', '2 إلى 4 أسابيع', '$850 – $2,200'],
            ['متجر إلكتروني متكامل', 'WooCommerce مخصص أو Shopify', '4 إلى 6 أسابيع', '$1,800 – $5,500'],
            ['منصة تصدير متعددة اللغات (AR/EN/FA)', 'Astro 7 + Cloudflare Edge', '4 إلى 7 أسابيع', '$2,000 – $6,000'],
            ['بوابة مؤسسية وتكامل ERP/CRM', 'Next.js / Astro + واجهات API مخصصة', '6 إلى 12 أسبوعاً', '$3,500 – $12,000+'],
          ],
        }
      : {
          title: '2026 Website Development Cost Benchmarks by Project Tier',
          headers: ['Project Tier', 'Recommended Stack', 'Typical Timeline', 'Estimated Budget (USD)'],
          rows: [
            ['Corporate & Service Website', 'Hand-Coded Custom WordPress', '2 – 4 Weeks', '$850 – $2,200'],
            ['Full E-Commerce Storefront', 'Custom WooCommerce / Shopify', '4 – 6 Weeks', '$1,800 – $5,500'],
            ['Multilingual Export Platform', 'Astro 7 + Cloudflare Edge (EN/AR/FA)', '4 – 7 Weeks', '$2,000 – $6,000'],
            ['Custom Web App & ERP Portal', 'Next.js / Astro + Node.js / Python API', '6 – 12 Weeks', '$3,500 – $12,000+'],
          ],
        };

const guideDict = dictionary.costCalculator?.guide;
const guide = guideDict
  ? {
      how: {
        title: t('costCalculator.guide.how.title', { fallback: 'How It Works' }),
        paragraphs: Array.isArray(guideDict.how?.paragraphs) ? guideDict.how.paragraphs : [],
      },
      useCases: {
        title: t('costCalculator.guide.useCases.title', { fallback: 'When to Use This Tool' }),
        items: Array.isArray(guideDict.useCases?.items) ? guideDict.useCases.items : [],
      },
    }
  : undefined;

const quoteTemplate =
  supportedLang === 'fa'
    ? 'درخواست پیش‌فاکتور از ماشین‌حساب سایت: نوع پروژه: {type} | تعداد صفحات: {pages} | امکانات اضافه: {addons} | برآورد اولیه: {total}'
    : supportedLang === 'ar'
      ? 'طلب عرض سعر من حاسبة التكلفة: نوع المشروع: {type} | عدد الصفحات: {pages} | الإضافات: {addons} | التقدير الأولي: {total}'
      : 'Quote request from Cost Calculator: Platform: {type} | Pages: {pages} | Add-ons: {addons} | Estimated Budget: {total}';
---

<ToolLayout
  title={titleText}
  description={descriptionText}
  lang={supportedLang}
  slug="cost-calculator"
  dictionary={dictionary}
  faqSchema={faqSchema}
  guide={guide}
>
  <!-- AEO Quick Answer Capsule -->
  <section class={`container mx-auto mt-8 px-4 ${fontClass}`}>
    <aside class="aeo-quick-answer mx-auto max-w-5xl rounded-2xl border-s-4 border-primary bg-primary/5 p-5 sm:p-6 dark:bg-slate-900/80">
      <p class="text-sm leading-relaxed font-medium text-gray-800 sm:text-base dark:text-gray-100">
        {quickAnswer}
      </p>
    </aside>
  </section>

  <!-- Main Calculator Workspace -->
  <section class={`container mx-auto mt-10 px-4 ${fontClass}`}>
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 lg:grid-cols-12">
      <!-- Interactive Controls -->
      <div class="space-y-6 lg:col-span-8">
        <!-- Step 1: Website Type -->
        <div
          class="space-y-4 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900"
        >
          <h2 class="text-base font-bold text-gray-800 dark:text-gray-100"
            >{t('costCalculator.stepProjectType', { fallback: '1. Project Type' })}</h2
          >
          <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
            <label
              class="relative flex cursor-pointer flex-col items-center space-y-2 rounded-xl border border-gray-200 bg-white p-4 text-center text-gray-900 transition-colors hover:border-primary has-[:checked]:border-primary has-[:checked]:bg-primary/5 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
            >
              <input
                type="radio"
                name="site-type"
                value="wordpress"
                data-label={supportedLang === 'fa' ? 'وردپرس اختصاصی' : supportedLang === 'ar' ? 'ووردبريس مخصص' : 'Custom WordPress'}
                class="absolute top-4 end-4 accent-primary"
                checked
              />
              <span class="text-lg font-bold">WordPress</span>
              <span class="text-xs text-gray-500 dark:text-gray-400"
                >{t('costCalculator.siteTypeWordPressSub', { fallback: 'Flexible CMS & Blog' })}</span
              >
            </label>
            <label
              class="relative flex cursor-pointer flex-col items-center space-y-2 rounded-xl border border-gray-200 bg-white p-4 text-center text-gray-900 transition-colors hover:border-primary has-[:checked]:border-primary has-[:checked]:bg-primary/5 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
            >
              <input
                type="radio"
                name="site-type"
                value="custom"
                data-label={supportedLang === 'fa' ? 'کدنویسی اختصاصی (Astro/Next.js)' : supportedLang === 'ar' ? 'برمجة مخصصة (Astro/Next.js)' : 'Custom Code (Astro/Next.js)'}
                class="absolute top-4 end-4 accent-primary"
              />
              <span class="text-lg font-bold"
                >{t('costCalculator.siteTypeCustom', { fallback: 'Custom Coding' })}</span
              >
              <span class="text-xs text-gray-500 dark:text-gray-400"
                >{t('costCalculator.siteTypeCustomSub', { fallback: 'Next.js / Astro Webapp' })}</span
              >
            </label>
            <label
              class="relative flex cursor-pointer flex-col items-center space-y-2 rounded-xl border border-gray-200 bg-white p-4 text-center text-gray-900 transition-colors hover:border-primary has-[:checked]:border-primary has-[:checked]:bg-primary/5 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
            >
              <input
                type="radio"
                name="site-type"
                value="ecommerce"
                data-label={supportedLang === 'fa' ? 'فروشگاه اینترنتی' : supportedLang === 'ar' ? 'متجر إلكتروني' : 'E-Commerce Store'}
                class="absolute top-4 end-4 accent-primary"
              />
              <span class="text-lg font-bold"
                >{t('costCalculator.siteTypeEcommerce', { fallback: 'E-commerce' })}</span
              >
              <span class="text-xs text-gray-500 dark:text-gray-400"
                >{t('costCalculator.siteTypeEcommerceSub', {
                  fallback: 'Shopify / WooCommerce Store',
                })}</span
              >
            </label>
          </div>
        </div>

        <!-- Step 2: Page count slider -->
        <div
          class="space-y-4 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900"
        >
          <div class="flex items-center justify-between">
            <label for="page-count-slider" class="text-base font-bold text-gray-800 dark:text-gray-100"
              >{t('costCalculator.stepNumberOfPages', { fallback: '2. Number of Pages' })}</label
            >
            <span
              id="page-count-val"
              class="font-bold text-primary"
              data-pages-one={t('costCalculator.pageSingular', { fallback: 'Page' })}
              data-pages-many={t('costCalculator.pagePlural', { fallback: 'Pages' })}
              >{`5 ${t('costCalculator.pagePlural', { fallback: 'Pages' })}`}</span
            >
          </div>
          <input
            type="range"
            id="page-count-slider"
            min="1"
            max="50"
            value="5"
            class="h-2 w-full cursor-pointer appearance-none rounded-lg bg-gray-100 accent-primary dark:bg-slate-800"
          />
        </div>

        <!-- Step 3: Additional Features -->
        <div
          class="space-y-4 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900"
        >
          <h2 class="text-base font-bold text-gray-800 dark:text-gray-100"
            >{t('costCalculator.stepFeatures', { fallback: '3. Features & Addons' })}</h2
          >
          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <label
              class="flex cursor-pointer items-center gap-3 rounded-xl border border-gray-100 p-3 transition-colors hover:bg-gray-50/50 has-[:checked]:border-primary/50 has-[:checked]:bg-primary/5 dark:border-slate-800 dark:hover:bg-slate-800/50"
            >
              <input
                type="checkbox"
                id="feature-multilingual"
                value="500"
                data-addon-name={t('costCalculator.multilingualLabel', { fallback: 'Multilingual (RTL/LTR)' })}
                class="h-4 w-4 rounded accent-primary"
              />
              <div class="flex flex-col">
                <span class="text-sm font-semibold text-gray-800 dark:text-gray-100"
                  >{t('costCalculator.multilingualLabel', { fallback: 'Multilingual (RTL/LTR)' })}</span
                >
                <span class="text-xs text-gray-500 dark:text-gray-400"
                  >{t('costCalculator.multilingualSub', {
                    fallback: 'Arabic, Farsi, and English support',
                  })}</span
                >
              </div>
            </label>
            <label
              class="flex cursor-pointer items-center gap-3 rounded-xl border border-gray-100 p-3 transition-colors hover:bg-gray-50/50 has-[:checked]:border-primary/50 has-[:checked]:bg-primary/5 dark:border-slate-800 dark:hover:bg-slate-800/50"
            >
              <input
                type="checkbox"
                id="feature-seo"
                value="400"
                data-addon-name={t('costCalculator.advancedSeo', { fallback: 'Advanced SEO Setup' })}
                class="h-4 w-4 rounded accent-primary"
              />
              <div class="flex flex-col">
                <span class="text-sm font-semibold text-gray-800 dark:text-gray-100"
                  >{t('costCalculator.advancedSeo', { fallback: 'Advanced SEO Setup' })}</span
                >
                <span class="text-xs text-gray-500 dark:text-gray-400"
                  >{t('costCalculator.advancedSeoSub', {
                    fallback: 'Optimized schemas and structures',
                  })}</span
                >
              </div>
            </label>
            <label
              class="flex cursor-pointer items-center gap-3 rounded-xl border border-gray-100 p-3 transition-colors hover:bg-gray-50/50 has-[:checked]:border-primary/50 has-[:checked]:bg-primary/5 dark:border-slate-800 dark:hover:bg-slate-800/50"
            >
              <input
                type="checkbox"
                id="feature-speed"
                value="300"
                data-addon-name={t('costCalculator.speedOptimization', { fallback: 'Speed Optimization' })}
                class="h-4 w-4 rounded accent-primary"
              />
              <div class="flex flex-col">
                <span class="text-sm font-semibold text-gray-800 dark:text-gray-100"
                  >{t('costCalculator.speedOptimization', { fallback: 'Speed Optimization' })}</span
                >
                <span class="text-xs text-gray-500 dark:text-gray-400"
                  >{t('costCalculator.speedOptimizationSub', {
                    fallback: 'Core Web Vitals max performance',
                  })}</span
                >
              </div>
            </label>
            <label
              class="flex cursor-pointer items-center gap-3 rounded-xl border border-gray-100 p-3 transition-colors hover:bg-gray-50/50 has-[:checked]:border-primary/50 has-[:checked]:bg-primary/5 dark:border-slate-800 dark:hover:bg-slate-800/50"
            >
              <input
                type="checkbox"
                id="feature-security"
                value="250"
                data-addon-name={t('costCalculator.wafSecurity', { fallback: 'WAF & Security Shield' })}
                class="h-4 w-4 rounded accent-primary"
              />
              <div class="flex flex-col">
                <span class="text-sm font-semibold text-gray-800 dark:text-gray-100"
                  >{t('costCalculator.wafSecurity', { fallback: 'WAF & Security Shield' })}</span
                >
                <span class="text-xs text-gray-500 dark:text-gray-400"
                  >{t('costCalculator.wafSecuritySub', {
                    fallback: 'Anti-DDoS, SSL & firewall hardening',
                  })}</span
                >
              </div>
            </label>
          </div>
        </div>
      </div>

      <!-- Sticky Pricing Summary Widget -->
      <div class="lg:col-span-4">
        <div
          id="calculator-summary-card"
          data-lang={supportedLang}
          data-quote-template={quoteTemplate}
          class="sticky top-28 space-y-6 rounded-2xl border border-gray-100 bg-white p-6 shadow-lg dark:border-slate-800 dark:bg-slate-900"
        >
          <h2
            class="border-b border-gray-100 pb-4 text-lg font-bold text-gray-800 dark:border-slate-800 dark:text-gray-100"
          >
            {t('costCalculator.estimateBreakdown', { fallback: 'Estimate Breakdown' })}
          </h2>

          <div class="space-y-3 text-sm">
            <div class="flex justify-between">
              <span class="text-gray-500 dark:text-gray-400"
                >{t('costCalculator.baseTypeCost', { fallback: 'Base Type Cost:' })}</span
              >
              <span dir="ltr" class="font-semibold text-gray-700 dark:text-gray-200" id="base-cost-text"
                >$800</span
