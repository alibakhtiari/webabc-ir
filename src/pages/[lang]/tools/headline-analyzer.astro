---
import Layout from '../../../layouts/Layout.astro';
import ToolsCTA from '../../../components/astro/ToolsCTA.astro';
import Breadcrumbs from '../../../components/astro/Breadcrumbs.astro';
import { getLanguageStaticPaths, type SupportedLanguage, languages } from '../../../types/language';
import { getDictionary } from '../../../i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);
const isRtl = languages[supportedLang]?.direction === 'rtl';

// Helper to translate strings
const t = createTranslator(dictionary);

const titleText = t('headlineAnalyzer.title', { fallback: 'SEO Headline Analyzer' });
const descriptionText = t('headlineAnalyzer.description', { fallback: 'Analyze your headlines for CTR, sentiment, readability and character length to optimize for SEO rankings.' });

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": `https://webabc.ir/${supportedLang}/tools/headline-analyzer/#webapp`,
  "name": titleText,
  "description": descriptionText,
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires HTML5 support",
  "inLanguage": supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR'
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": supportedLang === 'fa' ? 'چگونه عنوان مقاله خود را برای سئو بهینه کنیم؟' : supportedLang === 'ar' ? 'كيف يمكنني تحسين عنوان المقال للسيو؟' : 'How do I optimize a headline for SEO and clicks?',
      "acceptedAnswer": {
        "@type": "Answer",
        "text": supportedLang === 'fa' ? 'عناوین عالی باید بین ۶ تا ۱۲ کلمه، شامل عدد، دارای کلمات جذاب (Power Words) و کلمه کلیدی اصلی در ابتدای متن باشند.' : supportedLang === 'ar' ? 'العناوين الممتازة يجب أن تتراوح بين 6 إلى 12 كلمة وتحتوي على أرقام وكلمات محفزة للنقر.' : 'High-performing headlines should be between 6 and 12 words, include numbers or brackets, contain power words, and front-load target keywords.'
      }
    }
  ]
};

const breadcrumbs = [
  { label: t('common.home'), url: `/${supportedLang}/` },
  { label: t('common.tools'), url: `/${supportedLang}/tools/` },
  { label: titleText }
];
---

<Layout title={titleText} description={descriptionText} lang={supportedLang} slug="tools/headline-analyzer">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />
      <!-- Hero Section -->
    <section class="bg-linear-to-b from-primary/5 to-white pt-24 pb-12 md:pt-40 md:pb-24 border-b border-gray-100">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center">
          <Breadcrumbs items={breadcrumbs} lang={supportedLang} centered={true} />
          <h1 class="text-3xl md:text-5xl font-bold mb-6 bg-linear-to-r from-primary via-primary/80 to-primary/60 bg-clip-text text-transparent leading-normal font-persian">
            {titleText}
          </h1>
          <p class="text-lg md:text-xl text-gray-600 leading-relaxed font-persian">
            {descriptionText}
          </p>
        </div>
      </div>
    </section>

    <!-- Main Workspace -->
    <section class="container mx-auto px-4 mt-12 font-sans">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 max-w-6xl mx-auto">
        
        <!-- Input Panel -->
        <div class="lg:col-span-6 space-y-6">
          <div class="bg-white border border-gray-100 rounded-2xl shadow-sm p-6 space-y-4">
            <label for="headline-input" class="block text-sm font-semibold text-gray-700 font-persian">
              {t('headlineAnalyzer.inputLabel', { fallback: 'Enter your headline:' })}
            </label>
            <input
              type="text"
              id="headline-input"
              placeholder={t('headlineAnalyzer.placeholder', { fallback: 'e.g., 10 Quick Ways to Boost Your SEO Rankings Today' })}
              class="w-full border border-gray-200 rounded-xl p-4 focus:outline-none focus:border-primary text-base font-persian"
            />
            
            <div class="flex justify-between items-center">
              <span id="char-count" class="text-xs text-gray-500 font-persian">0 / 60 characters</span>
              <button type="button" id="analyze-btn" class="px-5 py-2.5 bg-primary text-primary-foreground text-xs font-semibold rounded-lg hover:bg-primary/95 shadow-sm transition-all font-persian focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
                {t('headlineAnalyzer.button', { fallback: 'Analyze' })}
              </button>
            </div>
          </div>

          <!-- Optimization Tips -->
          <div class="bg-white border border-gray-100 rounded-2xl shadow-sm p-6 space-y-3 font-persian">
            <h3 class="text-sm font-bold text-gray-800">SEO Headline Best Practices:</h3>
            <ul class="text-xs text-gray-600 space-y-2 list-disc list-inside">
              <li>Keep it between 50-60 characters so it doesn't get cut off in Google SERPs.</li>
              <li>Include your primary keyword naturally near the beginning.</li>
              <li>Use a number (e.g., "7 Tips") to increase click-through rates by up to 36%.</li>
              <li>Add emotional triggers or power words (like "Proven", "Instantly", "Unbelievable").</li>
            </ul>
          </div>
        </div>

        <!-- Output Panel / Analyzer Dashboard -->
        <div class="lg:col-span-6 space-y-6">
          <div class="bg-white border border-gray-100 rounded-2xl shadow-sm p-6 space-y-6 flex flex-col min-h-[400px]">
            
            <!-- Circular Score Display -->
            <div class="flex items-center gap-6 border-b border-gray-50 pb-6">
              <div class="relative w-24 h-24 flex items-center justify-center rounded-full bg-gray-50 border-4 border-gray-100" id="score-circle">
                <span class="text-3xl font-bold text-gray-400" id="score-val">0</span>
                <span class="absolute text-[10px] text-gray-400 bottom-2">Score</span>
              </div>
              <div class="space-y-1">
                <h4 class="text-lg font-bold text-gray-800 font-persian" id="grade-text">Awaiting Input</h4>
                <p class="text-xs text-gray-500 font-persian" id="grade-desc">Type a headline to see real-time quality analytics.</p>
              </div>
            </div>

            <!-- Analysis Categories -->
            <div class="space-y-4 grow">
              
              <!-- Length Indicator -->
              <div class="space-y-1.5">
                <div class="flex justify-between text-xs">
                  <span class="font-medium text-gray-700 font-persian">SEO Length Match</span>
                  <span class="font-semibold text-gray-600 font-persian" id="length-status">-</span>
                </div>
                <div class="w-full h-2 bg-gray-100 rounded-full overflow-hidden">
                  <div class="h-full bg-gray-300 w-0 transition-all duration-300" id="length-bar"></div>
                </div>
              </div>

              <!-- Keyword Presence -->
              <div class="space-y-1.5">
                <div class="flex justify-between text-xs">
                  <span class="font-medium text-gray-700 font-persian">Sentiment Balance</span>
                  <span class="font-semibold text-gray-600 font-persian" id="sentiment-status">-</span>
                </div>
                <div class="w-full h-2 bg-gray-100 rounded-full overflow-hidden">
                  <div class="h-full bg-gray-300 w-0 transition-all duration-300" id="sentiment-bar"></div>
                </div>
              </div>

              <!-- Power Words Presence -->
              <div class="space-y-1.5">
                <div class="flex justify-between text-xs">
                  <span class="font-medium text-gray-700 font-persian">Power Words & Numbers</span>
                  <span class="font-semibold text-gray-600 font-persian" id="power-status">-</span>
                </div>
                <div class="w-full h-2 bg-gray-100 rounded-full overflow-hidden">
                  <div class="h-full bg-gray-300 w-0 transition-all duration-300" id="power-bar"></div>
                </div>
              </div>

            </div>

          </div>
        </div>

      </div>
    </section>

    <!-- SEO Guide Content -->
    <section class="container mx-auto px-4 mt-16 font-sans">
      <div class="max-w-4xl mx-auto space-y-8">
        <div class="space-y-3">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900">How This Headline Checker Scores Your Title</h2>
          <p class="text-gray-600 leading-relaxed">
            This free SEO headline checker and blog title analyzer scores your headline across three factors that
            correlate with organic click-through rate: <strong>length</strong> (titles between 50–60 characters
            avoid truncation in Google search snippets), <strong>power words &amp; numbers</strong> (headlines with
            a number and an emotional trigger word see measurably higher CTR), and <strong>sentiment balance</strong>
            (questions and exclamations tend to drive more curiosity clicks than flat statements).
          </p>
        </div>

        <div class="grid sm:grid-cols-3 gap-4">
          <div class="bg-white border border-gray-100 rounded-xl p-5">
            <h3 class="text-sm font-bold text-gray-800 mb-2">Headline vs. Title Tag</h3>
            <p class="text-xs text-gray-500 leading-relaxed">
              Your on-page headline (H1) and your search-result title tag can be different. Analyze your H1 here,
              then check the exact &lt;title&gt; and meta description Google will show with our
              <a href={`/${supportedLang}/tools/seo-title-checker`} class="text-primary font-semibold hover:underline">SEO Title Checker</a>.
            </p>
          </div>
          <div class="bg-white border border-gray-100 rounded-xl p-5">
            <h3 class="text-sm font-bold text-gray-800 mb-2">Ideal Headline Length</h3>
            <p class="text-xs text-gray-500 leading-relaxed">
              Aim for 50–60 characters. Shorter headlines lack context and keyword coverage; longer ones risk
              truncation on both desktop and mobile SERPs.
            </p>
          </div>
          <div class="bg-white border border-gray-100 rounded-xl p-5">
            <h3 class="text-sm font-bold text-gray-800 mb-2">Power Words That Work</h3>
            <p class="text-xs text-gray-500 leading-relaxed">
              Words like "proven", "free", "ultimate", or "essential" paired with a digit (e.g. "7 Tips") are the
              highest-performing combination for blog, YouTube, and article headlines.
            </p>
          </div>
        </div>

        <!-- On-Page FAQ / AEO Question Block -->
        <div class="bg-white border border-gray-100 rounded-2xl p-6 sm:p-8 space-y-6">
          <h2 class="text-xl md:text-2xl font-bold text-gray-900 border-b border-gray-100 pb-4">
            {supportedLang === 'fa' ? 'سوالات متداول آنالیزور عنوان سئو (FAQ)' : supportedLang === 'ar' ? 'الأسئلة الشائعة حول محلل العناوين (FAQ)' : 'Frequently Asked Questions (Headline SEO FAQ)'}
          </h2>
          <div class="space-y-4">
            {faqSchema.mainEntity.map((item: any) => (
              <div class="border border-gray-100 rounded-xl p-4 bg-gray-50/50 space-y-2">
                <h3 class="text-sm sm:text-base font-bold text-gray-900">{item.name}</h3>
                <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">{item.acceptedAnswer.text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  
  
  <ToolsCTA lang={supportedLang} t={t} related={[{ key: 'seoTitleChecker', route: 'seo-title-checker' }, { key: 'readabilityChecker', route: 'readability-checker' }, { key: 'tools.keywordDensity', route: 'keyword-density-analyzer' }]} ctaHref={`/${supportedLang}/services/content-creation`} isRtl={isRtl} />
</Layout>

<script is:inline data-astro-rerun>
  const input = document.getElementById('headline-input');
  const analyzeBtn = document.getElementById('analyze-btn');
  const charCount = document.getElementById('char-count');
  
  const scoreVal = document.getElementById('score-val');
  const scoreCircle = document.getElementById('score-circle');
  const gradeText = document.getElementById('grade-text');
  const gradeDesc = document.getElementById('grade-desc');
  
  const lengthStatus = document.getElementById('length-status');
  const lengthBar = document.getElementById('length-bar');
  
  const sentimentStatus = document.getElementById('sentiment-status');
  const sentimentBar = document.getElementById('sentiment-bar');
  
  const powerStatus = document.getElementById('power-status');
  const powerBar = document.getElementById('power-bar');

  // List of common Power/Emotional Words
  const powerWords = [
    'proven', 'boost', 'free', 'easy', 'quick', 'boost', 'secret', 'guide', 'best',
    'top', 'amazing', 'essential', 'insane', 'incredible', 'ultimate', 'how to', 'why',
    'بهترین', 'سریع', 'رایگان', 'راز', 'آموزش', 'افزایش', 'چگونه', 'چرا', 'فرمول', 'ساده',
    'أفضل', 'مجاني', 'سر', 'كيفية', 'زيادة', 'طريقة', 'سهل', 'دليل'
  ];

  function analyzeHeadline() {
    const text = input.value.trim();
    if (!text) return;

    let score = 30; // base score

    // 1. Length check (ideal is between 50-60 characters)
    const len = text.length;
    let lenScore = 0;
    let lenText = 'Too Short';
    let lenColorClass = 'bg-red-500';

    if (len >= 50 && len <= 60) {
      lenScore = 100;
      lenText = 'Perfect (50-60 chars)';
      lenColorClass = 'bg-green-500';
      score += 35;
    } else if (len >= 40 && len < 50) {
      lenScore = 75;
      lenText = 'Good Length';
      lenColorClass = 'bg-yellow-500';
      score += 25;
    } else if (len > 60 && len <= 75) {
      lenScore = 75;
      lenText = 'Slightly Long';
      lenColorClass = 'bg-yellow-500';
      score += 20;
    } else if (len > 75) {
      lenScore = 40;
      lenText = 'Too Long (Will truncate)';
      lenColorClass = 'bg-red-500';
      score += 5;
    } else {
      lenScore = 30;
      lenText = 'Too Short';
      lenColorClass = 'bg-red-500';
      score += 10;
    }

    lengthStatus.innerText = lenText;
    lengthBar.style.width = `${lenScore}%`;
    lengthBar.className = `h-full transition-all duration-300 ${lenColorClass}`;

    // 2. Power words and numbers check
    const words = text.toLowerCase().split(/\s+/);
    const hasNumber = /\d+/.test(text);
    let powerCount = 0;
    
    words.forEach(w => {
      if (powerWords.some(pw => w.includes(pw))) {
        powerCount++;
      }
    });

    let powerScore = 0;
    let powerText = 'No triggers';
    let powerColorClass = 'bg-red-500';

    if (powerCount > 0 && hasNumber) {
      powerScore = 100;
      powerText = 'Numbers & Triggers Present';
      powerColorClass = 'bg-green-500';
      score += 35;
    } else if (powerCount > 0 || hasNumber) {
      powerScore = 70;
      powerText = 'Good Trigger Usage';
      powerColorClass = 'bg-yellow-500';
      score += 20;
    } else {
      powerScore = 20;
      powerText = 'Add numbers or power words';
      powerColorClass = 'bg-red-500';
    }

    powerStatus.innerText = powerText;
    powerBar.style.width = `${powerScore}%`;
    powerBar.className = `h-full transition-all duration-300 ${powerColorClass}`;

    // 3. Sentiment Balance
    // Simple sentiment analyzer based on question marks, exclamation marks, and strong positive verbs
    const hasExclamation = text.includes('!');
    const hasQuestion = text.includes('?');
    let sentimentScore = 50;
    let sentimentText = 'Neutral / Balanced';
    let sentimentColorClass = 'bg-gray-400';

    if (hasExclamation) {
      sentimentScore = 90;
      sentimentText = 'Highly Engaging!';
      sentimentColorClass = 'bg-green-500';
      score += 10;
    } else if (hasQuestion) {
      sentimentScore = 85;
      sentimentText = 'Curiosity Inducing';
      sentimentColorClass = 'bg-blue-500';
      score += 10;
    } else {
      score += 5;
    }

    sentimentStatus.innerText = sentimentText;
    sentimentBar.style.width = `${sentimentScore}%`;
    sentimentBar.className = `h-full transition-all duration-300 ${sentimentColorClass}`;

    // Cap score at 100
    score = Math.min(100, score);
    
    // Update Score Circle & Grade
    scoreVal.innerText = score;
    
    let grade = 'Needs Work';
    let desc = 'Try adding emotional numbers, action verbs, or optimizing length.';
    let circleColor = 'border-red-500 text-red-500';

    if (score >= 80) {
      grade = 'Excellent Headline!';
      desc = 'Your title is perfectly optimized for search performance and user click-through rates.';
      circleColor = 'border-green-500 text-green-500 bg-green-50/50';
    } else if (score >= 60) {
      grade = 'Decent Headline';
      desc = 'A few minor tweaks (like length or power words) could significantly boost your CTR.';
      circleColor = 'border-yellow-500 text-yellow-500 bg-yellow-50/50';
    }

    gradeText.innerText = grade;
    gradeDesc.innerText = desc;
    scoreCircle.className = `relative w-24 h-24 flex items-center justify-center rounded-full border-4 transition-all duration-300 ${circleColor}`;
  }

  input.addEventListener('input', () => {
    const len = input.value.trim().length;
    charCount.innerText = `${len} / 60 characters`;
    if (len > 0) {
      analyzeHeadline();
    }
  });

  analyzeBtn.addEventListener('click', analyzeHeadline);
</script>
