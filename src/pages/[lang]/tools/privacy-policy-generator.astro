---
import ToolLayout from '@/layouts/ToolLayout.astro';
import { getLanguageStaticPaths, type SupportedLanguage } from '@/types/language';
import { getDictionary } from '@/i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);

const t = createTranslator(dictionary);

const titleText = t('privacyGenerator.title', { fallback: 'Privacy Policy Generator' });
const descriptionText = t('privacyGenerator.description', {
  fallback: 'Create professional, GDPR and CCPA compliant privacy policies for your website.',
});

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name:
        supportedLang === 'fa'
          ? 'چرا وجود صفحه سیاست حریم خصوصی (Privacy Policy) برای وب‌سایت الزامی است؟'
          : supportedLang === 'ar'
            ? 'لماذا تعد صفحة سياسة الخصوصية إلزامية للمواقع؟'
            : 'Why is a Privacy Policy required for websites?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:
          supportedLang === 'fa'
            ? 'صفحه حریم خصوصی نحوه جمع‌آوری، کوکی‌ها و حفاظت از اطلاعات کاربران را شفاف کرده و برای قوانین GDPR و مجوزهای تبلیغاتی و اینماد الزامی است.'
            : supportedLang === 'ar'
              ? 'توضح سياسة الخصوصية كيفية جمع بيانات المستخدمين وحمايتها واستخدام الكوكيز، وهو شرط أساسي للامتثال لـ GDPR وجوجل إعلانات.'
              : 'A Privacy Policy discloses how user personal data, cookies, and analytics are collected and protected, satisfying GDPR compliance and ad network standards.',
      },
    },
  ],
};

// Text used by the client script — pulled server-side from the dictionary so it stays translated.
const strings = {
  policyTitle: t('privacyGenerator.policyTitle', { fallback: 'PRIVACY POLICY' }),
  lastUpdated: t('privacyGenerator.lastUpdated', { fallback: 'Last updated' }),
  introTitle: t('privacyGenerator.introTitle', { fallback: '1. INTRODUCTION' }),
  introText: t('privacyGenerator.introText', { fallback: 'Welcome to {companyName}.' }),
  contactTitle: t('privacyGenerator.contactTitle', { fallback: '2. CONTACT DETAILS' }),
  contactText: t('privacyGenerator.contactText', {
    fallback: 'If you have any questions, contact us at:',
  }),
  emailLabel: t('privacyGenerator.emailLabel', { fallback: 'Email:' }),
  addressLabel: t('privacyGenerator.addressLabel', { fallback: 'Address:' }),
  dataTitle: t('privacyGenerator.dataTitle', { fallback: '3. DATA WE COLLECT' }),
  dataIntro: t('privacyGenerator.dataIntro', { fallback: 'We may collect the following data:' }),
  dataIdentity: t('privacyGenerator.dataIdentity', { fallback: '- Identity Data' }),
  dataContact: t('privacyGenerator.dataContact', { fallback: '- Contact Data' }),
  dataTechnical: t('privacyGenerator.dataTechnical', { fallback: '- Technical Data' }),
  cookiesTitle: t('privacyGenerator.cookiesTitle', { fallback: '4. COOKIES' }),
  cookiesText: t('privacyGenerator.cookiesText', { fallback: 'We use cookies to track activity.' }),
  adsTitle: t('privacyGenerator.adsTitle', { fallback: '5. ADVERTISING PARTNERS' }),
  adsText: t('privacyGenerator.adsText', { fallback: 'We may use third-party ad providers.' }),
  securityTitle: t('privacyGenerator.securityTitle', { fallback: '6. DATA SECURITY' }),
  securityText: t('privacyGenerator.securityText', {
    fallback: 'We have appropriate security measures in place.',
  }),
  rightsTitle: t('privacyGenerator.rightsTitle', { fallback: '7. YOUR LEGAL RIGHTS' }),
  rightsText: t('privacyGenerator.rightsText', {
    fallback: 'You have rights under data protection laws.',
  }),
};
---

<ToolLayout
  title={titleText}
  description={descriptionText}
  lang={supportedLang}
  slug="privacy-policy-generator"
  dictionary={dictionary}
  faqSchema={faqSchema}
>
  <!-- Main Workspace -->
  <section class="container mx-auto mt-12 px-4 font-sans">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 lg:grid-cols-2">
      <!-- Form Panel -->
      <div
        class="space-y-4 rounded-2xl border border-gray-100 bg-white p-6 font-persian shadow-sm dark:border-slate-800 dark:bg-slate-900"
      >
        <h2 class="text-sm font-bold text-gray-800 dark:text-gray-100">
          {t('privacyGenerator.companyInfo', { fallback: 'Business Information' })}
        </h2>

        <div class="space-y-1.5">
          <label for="pp-company" class="text-sm font-medium text-gray-700 dark:text-gray-200"
            >{t('privacyGenerator.companyName', { fallback: 'Company Name' })}</label
          >
          <input
            id="pp-company"
            type="text"
            placeholder="e.g. Acme Corp"
            class="h-11 w-full rounded-lg border border-gray-200 bg-white px-4 text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
          />
        </div>

        <div class="space-y-1.5">
          <label for="pp-url" class="text-sm font-medium text-gray-700 dark:text-gray-200"
            >{t('privacyGenerator.websiteUrl', { fallback: 'Website URL' })}</label
          >
          <input
            id="pp-url"
            type="text"
            dir="ltr"
            placeholder="https://example.com"
            class="h-11 w-full rounded-lg border border-gray-200 bg-white px-4 text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
          />
        </div>

        <div class="space-y-1.5">
          <label for="pp-email" class="text-sm font-medium text-gray-700 dark:text-gray-200"
            >{t('privacyGenerator.email', { fallback: 'Contact Email' })}</label
          >
          <input
            id="pp-email"
            type="text"
            dir="ltr"
            placeholder="support@example.com"
            class="h-11 w-full rounded-lg border border-gray-200 bg-white px-4 text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
          />
        </div>

        <div class="space-y-1.5">
          <label for="pp-address" class="text-sm font-medium text-gray-700 dark:text-gray-200"
            >{t('privacyGenerator.address', { fallback: 'Business Address' })}</label
          >
          <input
            id="pp-address"
            type="text"
            placeholder="City, Country"
            class="h-11 w-full rounded-lg border border-gray-200 bg-white px-4 text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
          />
        </div>

        <div class="flex items-center justify-between border-t border-gray-100 pt-2">
          <label for="pp-cookies" class="text-sm font-medium text-gray-700 dark:text-gray-200"
            >{t('privacyGenerator.useCookies', { fallback: 'Do you use cookies?' })}</label
          >
          <input
            id="pp-cookies"
            type="checkbox"
            checked
            class="h-5 w-5 rounded text-primary accent-primary"
          />
        </div>
        <div class="flex items-center justify-between">
          <label for="pp-ads" class="text-sm font-medium text-gray-700 dark:text-gray-200"
            >{t('privacyGenerator.showAds', { fallback: 'Do you show ads (AdSense)?' })}</label
          >
          <input id="pp-ads" type="checkbox" class="h-5 w-5 rounded text-primary accent-primary" />
        </div>

        <button
          type="button"
          id="pp-generate"
          class="mt-2 w-full rounded-xl bg-primary py-3 text-sm font-bold text-primary-foreground shadow-sm transition-all hover:bg-primary/95 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
        >
          {t('privacyGenerator.generate', { fallback: 'Generate Policy' })}
        </button>
      </div>

      <!-- Result Panel -->
      <div
        class="flex flex-col space-y-4 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900"
      >
        <div class="flex items-center justify-between">
          <h2 class="font-persian text-sm font-bold text-gray-800 dark:text-gray-100">
            {t('privacyGenerator.result', { fallback: 'Your Privacy Policy' })}
          </h2>
          <button
            type="button"
            id="pp-copy"
            disabled
            class="font-persian text-xs font-semibold text-primary hover:underline focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-40"
          >
            {t('privacyGenerator.copy', { fallback: 'Copy to Clipboard' })}
          </button>
        </div>
        <pre
          id="pp-output"
          dir="ltr"
          class="max-h-105 min-h-105 grow overflow-y-auto rounded-xl border border-gray-100 bg-gray-50/50 p-4 font-mono text-xs leading-relaxed whitespace-pre-wrap text-gray-700 dark:border-slate-700 dark:bg-slate-800/60 dark:text-gray-200">{t('privacyGenerator.placeholder', { fallback: 'Fill out the form to generate your policy...' })}</pre>
        <p
          role="status"
          aria-live="polite"
          id="pp-copy-feedback"
          class="font-persian text-xs font-semibold text-green-600 opacity-0 transition-opacity"
        >
          {t('privacyGenerator.copied', { fallback: 'Policy copied to clipboard!' })}
        </p>
      </div>
    </div>
  </section>
</ToolLayout>

<script type="application/json" id="pp-strings" set:html={JSON.stringify(strings)} />

<script is:inline data-astro-rerun>
  (() => {
    const S = JSON.parse(document.getElementById('pp-strings').textContent);

    const companyInput = document.getElementById('pp-company');
    const urlInput = document.getElementById('pp-url');
    const emailInput = document.getElementById('pp-email');
    const addressInput = document.getElementById('pp-address');
    const cookiesCheck = document.getElementById('pp-cookies');
    const adsCheck = document.getElementById('pp-ads');
    const generateBtn = document.getElementById('pp-generate');
    const copyBtn = document.getElementById('pp-copy');
    const copyFeedback = document.getElementById('pp-copy-feedback');
    const output = document.getElementById('pp-output');

    generateBtn.addEventListener('click', () => {
      const companyName = companyInput.value || '[Company Name]';
      const websiteUrl = urlInput.value || '[Website URL]';
      const email = emailInput.value || '[Email Address]';
      const address = addressInput.value || '[Physical Address]';

      const introText = S.introText
        .replace('{companyName}', companyName)
        .replace('{websiteUrl}', websiteUrl);

      let policy = `${S.policyTitle}\n${S.lastUpdated}: ${new Date().toLocaleDateString()}\n\n`;
      policy += `${S.introTitle}\n${introText}\n\n`;
      policy += `${S.contactTitle}\n${S.contactText}\n${S.emailLabel} ${email}\n${S.addressLabel} ${address}\n\n`;
      policy += `${S.dataTitle}\n${S.dataIntro}\n${S.dataIdentity}\n${S.dataContact}\n${S.dataTechnical}\n\n`;
      if (cookiesCheck.checked) policy += `${S.cookiesTitle}\n${S.cookiesText}\n\n`;
      if (adsCheck.checked) policy += `${S.adsTitle}\n${S.adsText}\n\n`;
      policy += `${S.securityTitle}\n${S.securityText}\n\n`;
      policy += `${S.rightsTitle}\n${S.rightsText}`;

      output.textContent = policy.trim();
      copyBtn.disabled = false;
    });

    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(output.textContent).then(() => {
        copyFeedback.classList.remove('opacity-0');
        setTimeout(() => copyFeedback.classList.add('opacity-0'), 1800);
      });
    });
  })();
</script>
