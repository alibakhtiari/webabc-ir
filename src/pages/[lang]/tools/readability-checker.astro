---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/astro/Breadcrumbs.astro';
import Footer from '../../../components/astro/Footer.astro';
import { type SupportedLanguage, languages } from '../../../types/language';
import { getDictionary } from '../../../i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'fa' } },
    { params: { lang: 'ar' } },
  ];
}

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);
const isRtl = languages[supportedLang]?.direction === 'rtl';

const t = createTranslator(dictionary);

const titleText = t('readabilityChecker.title', { fallback: 'Readability Checker' });
const descriptionText = t('readabilityChecker.description', { fallback: "Analyze your content's readability with our online checker." });

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": `https://webabc.ir/${supportedLang}/tools/readability-checker/#webapp`,
  "name": titleText,
  "description": descriptionText,
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires HTML5 support",
  "inLanguage": supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR'
};

const breadcrumbs = [
  { label: t('common.home'), url: `/${supportedLang}` },
  { label: t('common.tools'), url: `/${supportedLang}/tools` },
  { label: titleText }
];
---

<Layout title={titleText} description={descriptionText} lang={supportedLang} slug="tools/readability-checker">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webAppSchema)} />
  <main class="grow w-full overflow-x-hidden bg-gray-50/50 pb-20 pt-20">
    <!-- Hero Section -->
    <section class="bg-linear-to-b from-primary/5 to-white pt-24 pb-12 md:pt-40 md:pb-24 border-b border-gray-100">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center">
          <Breadcrumbs items={breadcrumbs} lang={supportedLang} centered={true} />
          <h1 class="text-3xl md:text-5xl font-bold mb-6 bg-linear-to-r from-primary via-primary/80 to-primary/60 bg-clip-text text-transparent leading-normal font-persian">
            {titleText}
          </h1>
          <p class="text-lg md:text-xl text-gray-600 leading-relaxed font-persian">
            {descriptionText}
          </p>
        </div>
      </div>
    </section>

    <!-- Main Workspace -->
    <section class="container mx-auto px-4 mt-12 font-sans">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 max-w-6xl mx-auto">

        <!-- Input Panel -->
        <div class="lg:col-span-7 space-y-6">
          <div class="bg-white border border-gray-100 rounded-2xl shadow-sm p-6 space-y-4">
            <label for="text-input" class="block text-sm font-semibold text-gray-700 font-persian">
              {t('readabilityChecker.textLabel', { fallback: 'Text to Analyze' })}
            </label>
            <textarea
              id="text-input"
              rows="12"
              dir={isRtl ? 'rtl' : 'ltr'}
              placeholder={t('readabilityChecker.placeholder', { fallback: 'Paste your text here...' })}
              class="w-full border border-gray-200 rounded-xl p-4 focus:outline-none focus:border-primary text-base font-persian resize-none"
            ></textarea>
          </div>
        </div>

        <!-- Output Panel -->
        <div class="lg:col-span-5 space-y-6">
          <div class="bg-white border border-gray-100 rounded-2xl shadow-sm p-6 space-y-6 font-persian">
            <h3 class="text-sm font-bold text-gray-800">{t('readabilityChecker.analysis', { fallback: 'Readability Analysis' })}</h3>

            <div class="flex items-center gap-6 border-b border-gray-50 pb-6">
              <div class="relative w-20 h-20 flex items-center justify-center rounded-full bg-gray-50 border-4 border-gray-100 shrink-0" id="score-circle">
                <span class="text-2xl font-bold text-gray-400" id="score-val">0</span>
              </div>
              <div class="space-y-1">
                <div class="text-xs text-gray-500">{t('readabilityChecker.fleschScore', { fallback: 'Flesch Reading Ease' })}</div>
                <div class="text-sm font-bold text-gray-800" id="level-text">{t('readabilityChecker.level', { fallback: 'Level:' })} —</div>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-4 text-center">
              <div class="space-y-0.5">
                <div class="text-xl font-bold text-primary" id="word-count">0</div>
                <div class="text-[11px] text-gray-500">{t('readabilityChecker.totalWords', { fallback: 'Total words' })}</div>
              </div>
              <div class="space-y-0.5">
                <div class="text-xl font-bold text-primary" id="sentence-count">0</div>
                <div class="text-[11px] text-gray-500">{t('readabilityChecker.totalSentences', { fallback: 'Total sentences' })}</div>
              </div>
              <div class="space-y-0.5">
                <div class="text-xl font-bold text-primary" id="avg-words">0</div>
                <div class="text-[11px] text-gray-500">{t('readabilityChecker.avgWords', { fallback: 'Avg Words/Sentence' })}</div>
              </div>
              <div class="space-y-0.5">
                <div class="text-xl font-bold text-primary" id="grade-level">—</div>
                <div class="text-[11px] text-gray-500">{t('readabilityChecker.usGrade', { fallback: 'U.S. Grade Level' })}</div>
              </div>
            </div>
          </div>

          <div class="bg-white border border-gray-100 rounded-2xl shadow-sm p-6 space-y-2 font-persian">
            <h4 class="text-xs font-bold text-gray-800 mb-2">{t('readabilityChecker.scoreGuide', { fallback: 'Score Guide' })}</h4>
            <ul class="text-[11px] text-gray-500 space-y-1">
              <li>{t('readabilityChecker.guide90', { fallback: '90-100: Very easy to read' })}</li>
              <li>{t('readabilityChecker.guide80', { fallback: '80-90: Easy to read' })}</li>
              <li>{t('readabilityChecker.guide70', { fallback: '70-80: Fairly easy to read' })}</li>
              <li>{t('readabilityChecker.guide60', { fallback: '60-70: Standard/Conversational' })}</li>
              <li>{t('readabilityChecker.guide50', { fallback: '50-60: Fairly difficult to read' })}</li>
              <li>{t('readabilityChecker.guide30', { fallback: '30-50: Difficult to read' })}</li>
              <li>{t('readabilityChecker.guide0', { fallback: '0-30: Very difficult to read' })}</li>
            </ul>
          </div>
        </div>

      </div>
    </section>
  </main>

  <Footer lang={supportedLang} />
</Layout>

<script is:inline data-astro-rerun>
  const textInput = document.getElementById('text-input');
  const scoreVal = document.getElementById('score-val');
  const scoreCircle = document.getElementById('score-circle');
  const levelText = document.getElementById('level-text');
  const wordCountEl = document.getElementById('word-count');
  const sentenceCountEl = document.getElementById('sentence-count');
  const avgWordsEl = document.getElementById('avg-words');
  const gradeLevelEl = document.getElementById('grade-level');

  function countSyllables(word) {
    word = word.toLowerCase().replace(/[^a-z]/g, '');
    if (!word) return 1;
    const vowelGroups = word.match(/[aeiouy]+/g);
    let count = vowelGroups ? vowelGroups.length : 1;
    if (word.endsWith('e') && count > 1) count--;
    return Math.max(count, 1);
  }

  function analyze() {
    const text = textInput.value.trim();
    if (!text) {
      scoreVal.textContent = '0';
      levelText.textContent = 'Level: —';
      wordCountEl.textContent = '0';
      sentenceCountEl.textContent = '0';
      avgWordsEl.textContent = '0';
      gradeLevelEl.textContent = '—';
      scoreCircle.className = 'relative w-20 h-20 flex items-center justify-center rounded-full bg-gray-50 border-4 border-gray-100 shrink-0';
      return;
    }

    const words = text.split(/\s+/).filter(Boolean);
    const sentences = text.split(/[.!?؟]+/).filter(s => s.trim().length > 0);
    const wordCount = words.length;
    const sentenceCount = Math.max(sentences.length, 1);
    const syllableCount = words.reduce((sum, w) => sum + countSyllables(w), 0);

    const avgWordsPerSentence = wordCount / sentenceCount;
    const avgSyllablesPerWord = syllableCount / Math.max(wordCount, 1);

    // Flesch Reading Ease
    let score = 206.835 - (1.015 * avgWordsPerSentence) - (84.6 * avgSyllablesPerWord);
    score = Math.max(0, Math.min(100, Math.round(score)));

    // Flesch-Kincaid Grade Level
    let grade = (0.39 * avgWordsPerSentence) + (11.8 * avgSyllablesPerWord) - 15.59;
    grade = Math.max(0, Math.round(grade * 10) / 10);

    let level = 'Very Difficult';
    let colorClass = 'border-red-500 text-red-500 bg-red-50/50';
    if (score >= 90) { level = 'Very Easy'; colorClass = 'border-green-500 text-green-500 bg-green-50/50'; }
    else if (score >= 80) { level = 'Easy'; colorClass = 'border-green-500 text-green-500 bg-green-50/50'; }
    else if (score >= 70) { level = 'Fairly Easy'; colorClass = 'border-lime-500 text-lime-600 bg-lime-50/50'; }
    else if (score >= 60) { level = 'Standard'; colorClass = 'border-yellow-500 text-yellow-500 bg-yellow-50/50'; }
    else if (score >= 50) { level = 'Fairly Difficult'; colorClass = 'border-orange-500 text-orange-500 bg-orange-50/50'; }
    else if (score >= 30) { level = 'Difficult'; colorClass = 'border-red-400 text-red-400 bg-red-50/50'; }

    scoreVal.textContent = score;
    levelText.textContent = `Level: ${level}`;
    wordCountEl.textContent = wordCount;
    sentenceCountEl.textContent = sentenceCount;
    avgWordsEl.textContent = avgWordsPerSentence.toFixed(1);
    gradeLevelEl.textContent = grade;
    scoreCircle.className = `relative w-20 h-20 flex items-center justify-center rounded-full border-4 transition-all duration-300 shrink-0 ${colorClass}`;
  }

  textInput.addEventListener('input', analyze);
</script>
