---
import Layout from '../../../layouts/Layout.astro';
import ToolsCTA from '../../../components/astro/ToolsCTA.astro';
import Breadcrumbs from '../../../components/astro/Breadcrumbs.astro';
import { getLanguageStaticPaths, type SupportedLanguage, languages } from '../../../types/language';
import { getDictionary } from '../../../i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);
const isRtl = languages[supportedLang]?.direction === 'rtl';

const t = createTranslator(dictionary);

const titleText = t('readabilityChecker.title', { fallback: 'Readability Checker' });
const descriptionText = t('readabilityChecker.description', {
  fallback: "Analyze your content's readability with our online checker.",
});

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `https://webabc.ir/${supportedLang}/tools/readability-checker/#webapp`,
  name: titleText,
  description: descriptionText,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'All',
  browserRequirements: 'Requires HTML5 support',
  inLanguage: supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name:
        supportedLang === 'fa'
          ? 'چرا خوانایی متن در سئو اهمیت دارد؟'
          : supportedLang === 'ar'
            ? 'لماذا تؤثر سهولة القراءة على السيو؟'
            : 'Why is content readability important for SEO?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:
          supportedLang === 'fa'
            ? 'متون ساده و خوانا نرخ پرش (Bounce Rate) را کاهش داده، زمان ماندگاری (Dwell Time) کاربر را افزایش می‌دهند و تعامل بیشتری در نتایج گوگل و هوش مصنوعی ایجاد می‌کنند.'
            : supportedLang === 'ar'
              ? 'النصوص السلسة وسهلة القراءة تزيد من وقت بقاء الزائر في الصفحة وتقلل معدل الارتداد.'
              : 'Clear, easy-to-read text improves user retention, lowers bounce rates, and increases dwell time — key engagement metrics for search engines.',
      },
    },
  ],
};

const breadcrumbs = [
  { label: t('common.home'), url: `/${supportedLang}/` },
  { label: t('common.tools'), url: `/${supportedLang}/tools/` },
  { label: titleText },
];
---

<Layout
  title={titleText}
  description={descriptionText}
  lang={supportedLang}
  slug="tools/readability-checker"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />
  <!-- Hero Section -->
  <section
    class="border-b border-gray-100 bg-linear-to-b from-primary/10 via-background to-background pt-24 pb-12 md:pt-40 md:pb-24 dark:border-slate-800"
  >
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-3xl text-center">
        <Breadcrumbs items={breadcrumbs} lang={supportedLang} centered={true} />
        <h1
          class="mb-6 bg-linear-to-r from-primary via-primary/80 to-primary/60 bg-clip-text font-persian text-3xl leading-normal font-bold text-transparent md:text-5xl"
        >
          {titleText}
        </h1>
        <p class="font-persian text-lg leading-relaxed text-gray-600 md:text-xl dark:text-gray-300">
          {descriptionText}
        </p>
      </div>
    </div>
  </section>

  <!-- Main Workspace -->
  <section class="container mx-auto mt-12 px-4 font-sans">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 lg:grid-cols-12">
      <!-- Input Panel -->
      <div class="space-y-6 lg:col-span-7">
        <div
          class="space-y-4 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900"
        >
          <label
            for="text-input"
            class="block font-persian text-sm font-semibold text-gray-700 dark:text-gray-200"
          >
            {t('readabilityChecker.textLabel', { fallback: 'Text to Analyze' })}
          </label>
          <textarea
            id="text-input"
            rows="12"
            dir={isRtl ? 'rtl' : 'ltr'}
            placeholder={t('readabilityChecker.placeholder', {
              fallback: 'Paste your text here...',
            })}
            class="w-full resize-none rounded-xl border border-gray-200 bg-white p-4 font-persian text-base text-gray-900 focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
          ></textarea>
        </div>
      </div>

      <!-- Output Panel -->
      <div class="space-y-6 lg:col-span-5">
        <div
          class="space-y-6 rounded-2xl border border-gray-100 bg-white p-6 font-persian shadow-sm dark:border-slate-800 dark:bg-slate-900"
        >
          <h3 class="text-sm font-bold text-gray-800 dark:text-gray-100">
            {t('readabilityChecker.analysis', { fallback: 'Readability Analysis' })}
          </h3>

          <div class="flex items-center gap-6 border-b border-gray-50 pb-6 dark:border-slate-800">
            <div
              class="relative flex h-20 w-20 shrink-0 items-center justify-center rounded-full border-4 border-gray-100 bg-gray-50 dark:border-slate-700 dark:bg-slate-800"
              id="score-circle"
            >
              <span class="text-2xl font-bold text-gray-400" id="score-val">0</span>
            </div>
            <div class="space-y-1">
              <div class="text-xs text-gray-500 dark:text-gray-400">
                {t('readabilityChecker.fleschScore', { fallback: 'Flesch Reading Ease' })}
              </div>
              <div class="text-sm font-bold text-gray-800 dark:text-gray-100" id="level-text">
                {t('readabilityChecker.level', { fallback: 'Level:' })} —
              </div>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4 text-center">
            <div class="space-y-0.5">
              <div class="text-xl font-bold text-primary" id="word-count">0</div>
              <div class="text-[11px] text-gray-500 dark:text-gray-400">
                {t('readabilityChecker.totalWords', { fallback: 'Total words' })}
              </div>
            </div>
            <div class="space-y-0.5">
              <div class="text-xl font-bold text-primary" id="sentence-count">0</div>
              <div class="text-[11px] text-gray-500 dark:text-gray-400">
                {t('readabilityChecker.totalSentences', { fallback: 'Total sentences' })}
              </div>
            </div>
            <div class="space-y-0.5">
              <div class="text-xl font-bold text-primary" id="avg-words">0</div>
              <div class="text-[11px] text-gray-500 dark:text-gray-400">
                {t('readabilityChecker.avgWords', { fallback: 'Avg Words/Sentence' })}
              </div>
            </div>
            <div class="space-y-0.5">
              <div class="text-xl font-bold text-primary" id="grade-level">—</div>
              <div class="text-[11px] text-gray-500 dark:text-gray-400">
                {t('readabilityChecker.usGrade', { fallback: 'U.S. Grade Level' })}
              </div>
            </div>
          </div>
        </div>

        <div
          class="space-y-2 rounded-2xl border border-gray-100 bg-white p-6 font-persian shadow-sm dark:border-slate-800 dark:bg-slate-900"
        >
          <h4 class="mb-2 text-xs font-bold text-gray-800 dark:text-gray-100">
            {t('readabilityChecker.scoreGuide', { fallback: 'Score Guide' })}
          </h4>
          <ul class="space-y-1 text-[11px] text-gray-500 dark:text-gray-400">
            <li>{t('readabilityChecker.guide90', { fallback: '90-100: Very easy to read' })}</li>
            <li>{t('readabilityChecker.guide80', { fallback: '80-90: Easy to read' })}</li>
            <li>{t('readabilityChecker.guide70', { fallback: '70-80: Fairly easy to read' })}</li>
            <li>
              {t('readabilityChecker.guide60', { fallback: '60-70: Standard/Conversational' })}
            </li>
            <li>
              {t('readabilityChecker.guide50', { fallback: '50-60: Fairly difficult to read' })}
            </li>
            <li>{t('readabilityChecker.guide30', { fallback: '30-50: Difficult to read' })}</li>
            <li>{t('readabilityChecker.guide0', { fallback: '0-30: Very difficult to read' })}</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <ToolsCTA
    lang={supportedLang}
    t={t}
    related={[
      { key: 'headlineAnalyzer', route: 'headline-analyzer' },
      { key: 'tools.keywordDensity', route: 'keyword-density-analyzer' },
      { key: 'faqGenerator', route: 'faq-generator' },
    ]}
    ctaHref={`/${supportedLang}/services/content-creation`}
    isRtl={isRtl}
  />
</Layout>

<script is:inline data-astro-rerun>
  (() => {
    const textInput = document.getElementById('text-input');
    const scoreVal = document.getElementById('score-val');
    const scoreCircle = document.getElementById('score-circle');
    const levelText = document.getElementById('level-text');
    const wordCountEl = document.getElementById('word-count');
    const sentenceCountEl = document.getElementById('sentence-count');
    const avgWordsEl = document.getElementById('avg-words');
    const gradeLevelEl = document.getElementById('grade-level');

    function countSyllables(word) {
      word = word.toLowerCase().replace(/[^a-z]/g, '');
      if (!word) return 1;
      const vowelGroups = word.match(/[aeiouy]+/g);
      let count = vowelGroups ? vowelGroups.length : 1;
      if (word.endsWith('e') && count > 1) count--;
      return Math.max(count, 1);
    }

    function analyze() {
      const text = textInput.value.trim();
      if (!text) {
        scoreVal.textContent = '0';
        levelText.textContent = 'Level: —';
        wordCountEl.textContent = '0';
        sentenceCountEl.textContent = '0';
        avgWordsEl.textContent = '0';
        gradeLevelEl.textContent = '—';
        scoreCircle.className =
          'relative w-20 h-20 flex items-center justify-center rounded-full bg-gray-50 dark:bg-slate-800 border-4 border-gray-100 dark:border-slate-700 shrink-0';
        return;
      }

      const words = text.split(/\s+/).filter(Boolean);
      const sentences = text.split(/[.!?؟]+/).filter((s) => s.trim().length > 0);
      const wordCount = words.length;
      const sentenceCount = Math.max(sentences.length, 1);
      const syllableCount = words.reduce((sum, w) => sum + countSyllables(w), 0);

      const avgWordsPerSentence = wordCount / sentenceCount;
      const avgSyllablesPerWord = syllableCount / Math.max(wordCount, 1);

      // Flesch Reading Ease
      let score = 206.835 - 1.015 * avgWordsPerSentence - 84.6 * avgSyllablesPerWord;
      score = Math.max(0, Math.min(100, Math.round(score)));

      // Flesch-Kincaid Grade Level
      let grade = 0.39 * avgWordsPerSentence + 11.8 * avgSyllablesPerWord - 15.59;
      grade = Math.max(0, Math.round(grade * 10) / 10);

      let level = 'Very Difficult';
      let colorClass = 'border-red-500 text-red-500 bg-red-50/50 dark:bg-red-950/30';
      if (score >= 90) {
        level = 'Very Easy';
        colorClass = 'border-green-500 text-green-500 bg-green-50/50 dark:bg-green-950/30';
      } else if (score >= 80) {
        level = 'Easy';
        colorClass = 'border-green-500 text-green-500 bg-green-50/50 dark:bg-green-950/30';
      } else if (score >= 70) {
        level = 'Fairly Easy';
        colorClass = 'border-lime-500 text-lime-600 bg-lime-50/50 dark:bg-lime-950/30';
      } else if (score >= 60) {
        level = 'Standard';
        colorClass = 'border-yellow-500 text-yellow-500 bg-yellow-50/50 dark:bg-yellow-950/30';
      } else if (score >= 50) {
        level = 'Fairly Difficult';
        colorClass = 'border-orange-500 text-orange-500 bg-orange-50/50 dark:bg-orange-950/30';
      } else if (score >= 30) {
        level = 'Difficult';
        colorClass = 'border-red-400 text-red-400 bg-red-50/50 dark:bg-red-950/30';
      }

      scoreVal.textContent = score;
      levelText.textContent = `Level: ${level}`;
      wordCountEl.textContent = wordCount;
      sentenceCountEl.textContent = sentenceCount;
      avgWordsEl.textContent = avgWordsPerSentence.toFixed(1);
      gradeLevelEl.textContent = grade;
      scoreCircle.className = `relative w-20 h-20 flex items-center justify-center rounded-full border-4 transition-all duration-300 shrink-0 ${colorClass}`;
    }

    textInput.addEventListener('input', analyze);
  })();
</script>
