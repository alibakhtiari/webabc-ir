---
import Layout from '../../../layouts/Layout.astro';
import ToolsCTA from '../../../components/astro/ToolsCTA.astro';
import Breadcrumbs from '../../../components/astro/Breadcrumbs.astro';
import { getLanguageStaticPaths, type SupportedLanguage } from '../../../types/language';
import { getDictionary } from '../../../i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);

const t = createTranslator(dictionary);

const titleText = t('faqGenerator.title', { fallback: 'FAQ Schema & HTML Accordion Generator' });
const descriptionText = t('faqGenerator.description', {
  fallback: 'Generate valid FAQPage JSON-LD schema markup and clean HTML accordions.',
});

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `https://webabc.ir/${supportedLang}/tools/faq-generator/#webapp`,
  name: titleText,
  description: descriptionText,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'All',
  browserRequirements: 'Requires HTML5 support',
  inLanguage: supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name:
        supportedLang === 'fa'
          ? 'چرا کدهای اسکیما FAQPage برای سئو اهمیت دارند؟'
          : supportedLang === 'ar'
            ? 'لماذا تعد كود مخطط FAQPage مهمة للسيو؟'
            : 'Why are FAQPage Schema Markups important for SEO?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:
          supportedLang === 'fa'
            ? 'کدهای FAQPage به موتورهای جستجو و هوش مصنوعی اجازه می‌دهند سوالات و پاسخ‌های متداول را به‌طور مستقیم در نتایج گوگل و پاسخ‌های هوشمند نمایش دهند.'
            : supportedLang === 'ar'
              ? 'تسمح كود مخطط FAQPage لموتورات البحث والذكاء الاصطناعي بتوليد الإجابات المباشرة للأسئلة الشائعة في نتائج البحث.'
              : 'FAQPage Schema allows search engines and AI engines to display rich expandable Q&A accordions directly in search results.',
      },
    },
  ],
};

const breadcrumbs = [
  { label: t('common.home'), url: `/${supportedLang}/` },
  { label: t('common.tools'), url: `/${supportedLang}/tools/` },
  { label: titleText },
];
---

<Layout
  title={titleText}
  description={descriptionText}
  lang={supportedLang}
  slug="tools/faq-generator"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero Section -->
  <section
    class="border-b border-gray-100 bg-linear-to-b from-primary/10 via-background to-background pt-24 pb-12 font-sans md:pt-40 md:pb-24 dark:border-slate-800"
  >
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-3xl text-center">
        <Breadcrumbs items={breadcrumbs} lang={supportedLang} centered={true} />
        <h1
          class="mb-6 bg-linear-to-r from-primary via-primary/80 to-primary/60 bg-clip-text font-persian text-3xl leading-normal font-bold text-transparent md:text-5xl"
        >
          {titleText}
        </h1>
        <p class="font-persian text-lg leading-relaxed text-gray-600 md:text-xl dark:text-gray-300">
          {descriptionText}
        </p>
      </div>
    </div>
  </section>

  <!-- Main Workspace -->
  <section class="container mx-auto mt-12 mb-20 px-4 font-sans">
    <div class="mx-auto max-w-5xl space-y-8">
      <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-2">
        <!-- FAQ Questions Form -->
        <div
          class="space-y-4 rounded-2xl border border-gray-100 bg-white p-6 font-persian shadow-sm dark:border-slate-800 dark:bg-slate-900"
        >
          <div
            class="flex items-center justify-between border-b border-gray-100 pb-3 dark:border-slate-800"
          >
            <h3 class="text-base font-bold text-gray-800 dark:text-gray-100">
              {t('faqGenerator.faqHeading', { fallback: 'Frequently Asked Questions' })}
            </h3>
            <button
              type="button"
              id="add-faq-btn"
              class="flex items-center gap-1 rounded-lg bg-primary/10 px-3 py-1.5 text-xs font-bold text-primary transition-all hover:bg-primary/20 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
            >
              + {t('faqGenerator.addQuestion', { fallback: 'Add Question' })}
            </button>
          </div>

          <div id="faq-list" class="space-y-4">
            <!-- Item 1 -->
            <div
              class="faq-item space-y-2 rounded-xl border border-gray-100 bg-gray-50 p-4 dark:border-slate-700 dark:bg-slate-800/80"
            >
              <input
                type="text"
                class="faq-q w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                value="What is FAQ Schema Markup?"
              />
              <textarea
                class="faq-a w-full resize-none rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                rows="2"
                >FAQ Schema is structured data code added to a website to help search engines
                display interactive rich snippets directly in Google search results.</textarea
              >
            </div>
            <!-- Item 2 -->
            <div
              class="faq-item space-y-2 rounded-xl border border-gray-100 bg-gray-50 p-4 dark:border-slate-700 dark:bg-slate-800/80"
            >
              <input
                type="text"
                class="faq-q w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                value="Does FAQ Schema improve SEO?"
              />
              <textarea
                class="faq-a w-full resize-none rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                >Yes, FAQ schema enhances search visibility, expands your search snippet footprint,
                and increases click-through rates (CTR).</textarea
              >
            </div>
          </div>
        </div>

        <!-- Output Code Blocks -->
        <div class="space-y-6 font-persian">
          <!-- JSON-LD Output -->
          <div
            class="space-y-3 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900"
          >
            <div
              class="flex items-center justify-between border-b border-gray-100 pb-2 dark:border-slate-800"
            >
              <h3 class="text-sm font-bold text-gray-800 dark:text-gray-100">
                {t('faqGenerator.jsonLdCode', { fallback: 'JSON-LD Schema Code' })}
              </h3>
              <button
                type="button"
                id="copy-json-btn"
                class="text-xs font-semibold text-primary hover:underline focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
                >{t('faqGenerator.copyJson', { fallback: 'Copy JSON-LD' })}</button
              >
            </div>
            <pre
              id="json-output"
              dir="ltr"
              class="min-h-40 overflow-x-auto rounded-xl bg-gray-900 p-4 font-mono text-xs text-green-400">
            </pre>
          </div>

          <!-- HTML Accordion Output -->
          <div
            class="space-y-3 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900"
          >
            <div
              class="flex items-center justify-between border-b border-gray-100 pb-2 dark:border-slate-800"
            >
              <h3 class="text-sm font-bold text-gray-800 dark:text-gray-100">
                {t('faqGenerator.htmlAccordion', { fallback: 'HTML Accordion Markup' })}
              </h3>
              <button
                type="button"
                id="copy-html-btn"
                class="text-xs font-semibold text-primary hover:underline focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
                >{t('faqGenerator.copyHtml', { fallback: 'Copy HTML' })}</button
              >
            </div>
            <pre
              id="html-output"
              dir="ltr"
              class="min-h-40 overflow-x-auto rounded-xl bg-gray-900 p-4 font-mono text-xs text-primary">
            </pre>
          </div>

          <p
            id="copy-status"
            class="text-center text-xs font-semibold text-green-600 opacity-0 transition-opacity"
          >
            {t('faqGenerator.copied', { fallback: 'Copied code to clipboard!' })}
          </p>
        </div>
      </div>
    </div>
  </section>

  <ToolsCTA
    lang={supportedLang}
    t={t}
    related={[
      { key: 'schemaGenerator', route: 'schema-generator' },
      { key: 'paaScraper', route: 'paa-scraper' },
      { key: 'tools.keywordDensity', route: 'keyword-density-analyzer' },
    ]}
    ctaHref={`/${supportedLang}/services/content-creation`}
    isRtl={supportedLang !== 'en'}
  />
</Layout>

<script is:inline data-astro-rerun>
  (() => {
    const faqList = document.getElementById('faq-list');
    const addFaqBtn = document.getElementById('add-faq-btn');
    const jsonOutput = document.getElementById('json-output');
    const htmlOutput = document.getElementById('html-output');
    const copyJsonBtn = document.getElementById('copy-json-btn');
    const copyHtmlBtn = document.getElementById('copy-html-btn');
    const copyStatus = document.getElementById('copy-status');

    function updateOutputs() {
      const items = document.querySelectorAll('.faq-item');
      const qaPairs = [];

      items.forEach((item) => {
        const q = item.querySelector('.faq-q').value.trim();
        const a = item.querySelector('.faq-a').value.trim();
        if (q && a) {
          qaPairs.push({ q, a });
        }
      });

      // Generate JSON-LD
      const schemaObj = {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: qaPairs.map((pair) => ({
          '@type': 'Question',
          name: pair.q,
          acceptedAnswer: {
            '@type': 'Answer',
            text: pair.a,
          },
        })),
      };

      jsonOutput.textContent = `<script type="application/ld+json">\n${JSON.stringify(schemaObj, null, 2)}\n<\/script>`;

      // Generate HTML
      let htmlSnippet = `<div class="faq-accordion space-y-3">\n`;
      qaPairs.forEach((pair) => {
        htmlSnippet += `  <details class="border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-gray-900 dark:text-white rounded-lg p-4">\n    <summary class="font-bold cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 rounded-lg">${pair.q}</summary>\n    <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">${pair.a}</p>\n  </details>\n`;
      });
      htmlSnippet += `</div>`;

      htmlOutput.textContent = htmlSnippet;
    }

    addFaqBtn.addEventListener('click', () => {
      const div = document.createElement('div');
      div.className =
        'faq-item p-4 bg-gray-50 dark:bg-slate-800/80 border border-gray-100 dark:border-slate-700 rounded-xl space-y-2';
      div.innerHTML = `
      <input type="text" class="faq-q w-full border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:border-primary focus:outline-none" placeholder="Enter question..." />
      <textarea class="faq-a w-full border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:border-primary focus:outline-none resize-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2" rows="2" placeholder="Enter answer..."></textarea>
    `;
      faqList.appendChild(div);
      updateOutputs();
    });

    faqList.addEventListener('input', updateOutputs);
    updateOutputs();

    copyJsonBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(jsonOutput.textContent).then(() => {
        copyStatus.classList.remove('opacity-0');
        setTimeout(() => copyStatus.classList.add('opacity-0'), 2000);
      });
    });

    copyHtmlBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(htmlOutput.textContent).then(() => {
        copyStatus.classList.remove('opacity-0');
        setTimeout(() => copyStatus.classList.add('opacity-0'), 2000);
      });
    });
  })();
</script>
