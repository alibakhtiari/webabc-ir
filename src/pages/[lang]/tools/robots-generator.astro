---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/astro/Breadcrumbs.astro';
import { getLanguageStaticPaths, type SupportedLanguage } from '../../../types/language';
import { getDictionary } from '../../../i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);

// Helper to translate strings
const t = createTranslator(dictionary);

const titleText = t('tools.robotsGenerator.title', { fallback: 'Robots.txt & Sitemap Graph Builder' });
const descriptionText = t('tools.robotsGenerator.description', { fallback: 'Easily construct optimized crawler directives and map your sitemap configurations dynamically.' });

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": `https://webabc.ir/${supportedLang}/tools/robots-generator/#webapp`,
  "name": titleText,
  "description": descriptionText,
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires HTML5 support",
  "inLanguage": supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR'
};

const breadcrumbs = [
  { label: t('common.home'), url: `/${supportedLang}` },
  { label: t('common.tools', { fallback: 'Tools' }), url: `/${supportedLang}/tools` },
  { label: titleText }
];
---

<Layout title={titleText} description={descriptionText} lang={supportedLang} slug="tools/robots-generator">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webAppSchema)} />
  
      <!-- Hero Section -->
    <section class="bg-linear-to-b from-primary/5 to-white pt-24 pb-12 md:pt-40 md:pb-24 border-b border-gray-100">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center">
          <Breadcrumbs items={breadcrumbs} lang={supportedLang} />
          <h1 class="text-3xl md:text-5xl font-bold mb-6 bg-linear-to-r from-primary via-primary/80 to-primary/60 bg-clip-text text-transparent leading-normal font-persian">
            {titleText}
          </h1>
          <p class="text-lg md:text-xl text-gray-600 leading-relaxed font-persian">
            {descriptionText}
          </p>
        </div>
      </div>
    </section>

    <!-- Main Workspace -->
    <section class="container mx-auto px-4 mt-12 font-sans">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 max-w-6xl mx-auto">
        
        <!-- Input Form Panel -->
        <div class="lg:col-span-6 space-y-6">
          <div class="bg-white border border-gray-100 rounded-2xl shadow-sm p-6 space-y-6">
            <h2 class="text-lg font-bold text-gray-800">Builder Settings</h2>

            <!-- Default User-Agent directive -->
            <div class="space-y-2">
              <label for="ua-select" class="block text-sm font-semibold text-gray-700">Crawler User-Agent</label>
              <select id="ua-select" class="w-full h-11 border border-gray-200 rounded-lg px-4 focus:outline-none focus:border-primary">
                <option value="*">All Bots (*)</option>
                <option value="Googlebot">Googlebot</option>
                <option value="Bingbot">Bingbot</option>
                <option value="Baiduspider">Baiduspider</option>
                <option value="Yandex">Yandex</option>
              </select>
            </div>

            <!-- Crawl delay select -->
            <div class="space-y-2">
              <label for="delay-select" class="block text-sm font-semibold text-gray-700">Crawl Delay (Seconds)</label>
              <select id="delay-select" class="w-full h-11 border border-gray-200 rounded-lg px-4 focus:outline-none focus:border-primary">
                <option value="">No Delay</option>
                <option value="5">5 Seconds</option>
                <option value="10">10 Seconds</option>
                <option value="20">20 Seconds</option>
              </select>
            </div>

            <!-- Sitemap URL input -->
            <div class="space-y-2">
              <label for="sitemap-input" class="block text-sm font-semibold text-gray-700">Sitemap URL</label>
              <input
                id="sitemap-input"
                type="url"
                value="https://webabc.ir/sitemap.xml"
                placeholder="https://example.com/sitemap.xml"
                class="w-full h-11 border border-gray-200 rounded-lg px-4 focus:outline-none focus:border-primary"
              />
            </div>

            <!-- Disallowed paths list -->
            <div class="space-y-2">
              <label for="disallow-input" class="block text-sm font-semibold text-gray-700">Disallowed Directories / Paths</label>
              <div class="flex gap-2">
                <input
                  id="disallow-input"
                  type="text"
                  placeholder="e.g. /admin"
                  class="grow h-11 border border-gray-200 rounded-lg px-4 focus:outline-none focus:border-primary"
                />
                <button id="add-disallow-btn" class="px-4 bg-primary text-white font-semibold rounded-lg">Add</button>
              </div>
              <ul id="paths-list" class="mt-3 space-y-1 text-sm text-gray-600">
                <!-- Injected disallow rules will show here -->
              </ul>
            </div>

          </div>
        </div>

        <!-- Output and Download Panel -->
        <div class="lg:col-span-6 space-y-6">
          <div class="bg-white border border-gray-100 rounded-2xl shadow-sm p-6 space-y-4 flex flex-col h-[520px]">
            <div class="flex justify-between items-center">
              <span class="block text-sm font-semibold text-gray-700">Generated Robots.txt</span>
              <button id="download-btn" class="px-4 py-1.5 bg-primary text-white text-xs font-semibold rounded-md flex items-center gap-1 shadow-sm">
                Download .txt
              </button>
            </div>
            
            <div class="border border-gray-100 rounded-xl p-4 bg-gray-50/50 font-mono text-sm overflow-auto grow">
              <pre id="robots-output" class="text-gray-800 break-all whitespace-pre-wrap">User-agent: *</pre>
            </div>
          </div>
        </div>

      </div>
    </section>
  
  </Layout>

<script is:inline data-astro-rerun>
  // Robots.txt generator logic
  const uaSelect = document.getElementById('ua-select');
  const delaySelect = document.getElementById('delay-select');
  const sitemapInput = document.getElementById('sitemap-input');
  const disallowInput = document.getElementById('disallow-input');
  const addDisallowBtn = document.getElementById('add-disallow-btn');
  const pathsList = document.getElementById('paths-list');
  const robotsOutput = document.getElementById('robots-output');
  const downloadBtn = document.getElementById('download-btn');

  let disallowPaths = ['/admin', '/_backup', '/api'];

  function renderPaths() {
    pathsList.innerHTML = '';
    disallowPaths.forEach((path, idx) => {
      const li = document.createElement('li');
      li.className = "flex justify-between items-center bg-gray-50 px-3 py-1.5 rounded-lg border border-gray-100";
      li.innerHTML = `
        <span>${path}</span>
        <button data-remove-idx="${idx}" class="text-red-500 hover:text-red-700 font-bold">×</button>
      `;
      pathsList.appendChild(li);
    });

    // Bind remove actions
    document.querySelectorAll('[data-remove-idx]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const removeIdx = parseInt(e.target.getAttribute('data-remove-idx'));
        disallowPaths.splice(removeIdx, 1);
        renderPaths();
        updateRobotsText();
      });
    });
  }

  addDisallowBtn.addEventListener('click', () => {
    const val = disallowInput.value.trim();
    if (val && !disallowPaths.includes(val)) {
      disallowPaths.push(val);
      disallowInput.value = '';
      renderPaths();
      updateRobotsText();
    }
  });

  function updateRobotsText() {
    let robots = `# Group 1\n`;
    robots += `User-agent: ${uaSelect.value}\n`;
    
    disallowPaths.forEach(path => {
      robots += `Disallow: ${path}\n`;
    });

    if (delaySelect.value) {
      robots += `Crawl-delay: ${delaySelect.value}\n`;
    }

    if (sitemapInput.value.trim()) {
      robots += `\n# Sitemap URL\n`;
      robots += `Sitemap: ${sitemapInput.value.trim()}\n`;
    }

    robotsOutput.textContent = robots;
  }

  uaSelect.addEventListener('change', updateRobotsText);
  delaySelect.addEventListener('change', updateRobotsText);
  sitemapInput.addEventListener('input', updateRobotsText);

  // File Downloader
  downloadBtn.addEventListener('click', () => {
    const text = robotsOutput.textContent;
    const blob = new Blob([text], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'robots.txt';
    a.click();
    URL.revokeObjectURL(url);
  });

  // Initial render
  renderPaths();
  updateRobotsText();
</script>
