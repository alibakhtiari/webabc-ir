---
import ToolLayout from '@/layouts/ToolLayout.astro';
import { getLanguageStaticPaths, type SupportedLanguage } from '@/types/language';
import { getDictionary } from '@/i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);

// Helper to translate strings
const t = createTranslator(dictionary);

const titleText = t('tools.robotsGenerator.title', {
  fallback: 'Robots.txt & Sitemap Graph Builder',
});
const descriptionText = t('tools.robotsGenerator.description', {
  fallback:
    'Easily construct optimized crawler directives and map your sitemap configurations dynamically.',
});

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name:
        supportedLang === 'fa'
          ? 'فایل robots.txt چیست و چه کاربردی در سئو دارد؟'
          : supportedLang === 'ar'
            ? 'ما هو ملف robots.txt وما هي فائدته للسيو؟'
            : 'What is robots.txt and how does it help SEO?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:
          supportedLang === 'fa'
            ? 'فایل robots.txt دستورالعمل‌هایی به ربات‌ها و خزنده‌های موتورهای جستجو (مانند Googlebot) می‌دهد که کدام مسیرها را خزش کرده و از خزش چه مسیرهایی خودداری کنند.'
            : supportedLang === 'ar'
              ? 'ملف robots.txt يعطي تعليمات لروبوتات ومحركات البحث حول الصفحات التي يجب أو لا يجب فحصها.'
              : 'A robots.txt file instructs search engine crawlers (like Googlebot) which paths or directories on your website they are allowed or forbidden to crawl.',
      },
    },
  ],
};
---

<ToolLayout
  title={titleText}
  description={descriptionText}
  lang={supportedLang}
  slug="robots-generator"
  dictionary={dictionary}
  faqSchema={faqSchema}
>
  <!-- Main Workspace -->
  <section class="container mx-auto mt-12 px-4 font-sans">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 lg:grid-cols-12">
      <!-- Input Form Panel -->
      <div class="space-y-6 lg:col-span-6">
        <div
          class="space-y-6 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900"
        >
          <h2 class="text-lg font-bold text-gray-800 dark:text-gray-100">Builder Settings</h2>

          <!-- Default User-Agent directive -->
          <div class="space-y-2">
            <label
              for="ua-select"
              class="block text-sm font-semibold text-gray-700 dark:text-gray-200"
              >Crawler User-Agent</label
            >
            <select
              id="ua-select"
              class="h-11 w-full rounded-lg border border-gray-200 bg-white px-4 text-gray-900 focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
            >
              <option value="*">All Bots (*)</option>
              <option value="Googlebot">Googlebot</option>
              <option value="Bingbot">Bingbot</option>
              <option value="Baiduspider">Baiduspider</option>
              <option value="Yandex">Yandex</option>
            </select>
          </div>

          <!-- Crawl delay select -->
          <div class="space-y-2">
            <label
              for="delay-select"
              class="block text-sm font-semibold text-gray-700 dark:text-gray-200"
              >Crawl Delay (Seconds)</label
            >
            <select
              id="delay-select"
              class="h-11 w-full rounded-lg border border-gray-200 bg-white px-4 text-gray-900 focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
            >
              <option value="">No Delay</option>
              <option value="5">5 Seconds</option>
              <option value="10">10 Seconds</option>
              <option value="20">20 Seconds</option>
            </select>
          </div>

          <!-- Sitemap URL input -->
          <div class="space-y-2">
            <label
              for="sitemap-input"
              class="block text-sm font-semibold text-gray-700 dark:text-gray-200"
              >Sitemap URL</label
            >
            <input
              id="sitemap-input"
              type="url"
              value="https://webabc.ir/sitemap.xml"
              placeholder="https://example.com/sitemap.xml"
              class="h-11 w-full rounded-lg border border-gray-200 bg-white px-4 text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
            />
          </div>

          <!-- Disallowed paths list -->
          <div class="space-y-2">
            <label
              for="disallow-input"
              class="block text-sm font-semibold text-gray-700 dark:text-gray-200"
              >Disallowed Directories / Paths</label
            >
            <div class="flex gap-2">
              <input
                id="disallow-input"
                type="text"
                placeholder="e.g. /admin"
                class="h-11 grow rounded-lg border border-gray-200 bg-white px-4 text-gray-900 focus:border-primary focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
              <button
                type="button"
                id="add-disallow-btn"
                class="rounded-lg bg-primary px-4 font-semibold text-primary-foreground focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
                >Add</button
              >
            </div>
            <ul id="paths-list" class="mt-3 space-y-1 text-sm text-gray-600 dark:text-gray-300">
              <!-- Injected disallow rules will show here -->
            </ul>
          </div>
        </div>
      </div>

      <!-- Output and Download Panel -->
      <div class="space-y-6 lg:col-span-6">
        <div
          class="flex h-[520px] flex-col space-y-4 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900"
        >
          <div class="flex items-center justify-between">
            <span class="block text-sm font-semibold text-gray-700 dark:text-gray-200"
              >Generated Robots.txt</span
            >
            <button
              type="button"
              id="download-btn"
              class="flex items-center gap-1 rounded-md bg-primary px-4 py-1.5 text-xs font-semibold text-primary-foreground shadow-sm focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
            >
              Download .txt
            </button>
          </div>

          <div
            class="grow overflow-auto rounded-xl border border-gray-100 bg-gray-50/50 p-4 font-mono text-sm"
          >
            <pre
              id="robots-output"
              class="break-all whitespace-pre-wrap text-gray-800 dark:text-gray-100">User-agent: *</pre>
          </div>
        </div>
      </div>
    </div>
  </section>
</ToolLayout>

<script is:inline data-astro-rerun>
  (() => {
    // Robots.txt generator logic
    const uaSelect = document.getElementById('ua-select');
    const delaySelect = document.getElementById('delay-select');
    const sitemapInput = document.getElementById('sitemap-input');
    const disallowInput = document.getElementById('disallow-input');
    const addDisallowBtn = document.getElementById('add-disallow-btn');
    const pathsList = document.getElementById('paths-list');
    const robotsOutput = document.getElementById('robots-output');
    const downloadBtn = document.getElementById('download-btn');

    let disallowPaths = ['/admin', '/_backup', '/api'];

    function renderPaths() {
      pathsList.innerHTML = '';
      disallowPaths.forEach((path, idx) => {
        const li = document.createElement('li');
        li.className =
          'flex justify-between items-center bg-gray-50 px-3 py-1.5 rounded-lg border border-gray-100';
        li.innerHTML = `
        <span>${path}</span>
        <button type="button" data-remove-idx="${idx}" class="text-red-500 hover:text-red-700 font-bold focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">×</button>
      `;
        pathsList.appendChild(li);
      });

      // Bind remove actions
      document.querySelectorAll('[data-remove-idx]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const removeIdx = parseInt(e.target.getAttribute('data-remove-idx'));
          disallowPaths.splice(removeIdx, 1);
          renderPaths();
          updateRobotsText();
        });
      });
    }

    addDisallowBtn.addEventListener('click', () => {
      const val = disallowInput.value.trim();
      if (val && !disallowPaths.includes(val)) {
        disallowPaths.push(val);
        disallowInput.value = '';
        renderPaths();
        updateRobotsText();
      }
    });

    function updateRobotsText() {
      let robots = `# Group 1\n`;
      robots += `User-agent: ${uaSelect.value}\n`;

      disallowPaths.forEach((path) => {
        robots += `Disallow: ${path}\n`;
      });

      if (delaySelect.value) {
        robots += `Crawl-delay: ${delaySelect.value}\n`;
      }

      if (sitemapInput.value.trim()) {
        robots += `\n# Sitemap URL\n`;
        robots += `Sitemap: ${sitemapInput.value.trim()}\n`;
      }

      robotsOutput.textContent = robots;
    }

    uaSelect.addEventListener('change', updateRobotsText);
    delaySelect.addEventListener('change', updateRobotsText);
    sitemapInput.addEventListener('input', updateRobotsText);

    // File Downloader
    downloadBtn.addEventListener('click', () => {
      const text = robotsOutput.textContent;
      const blob = new Blob([text], { type: 'text/plain' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'robots.txt';
      a.click();
      URL.revokeObjectURL(url);
    });

    // Initial render
    renderPaths();
    updateRobotsText();
  })();
</script>
