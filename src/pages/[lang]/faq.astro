---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/astro/Hero.astro';
import { getLanguageStaticPaths, type SupportedLanguage } from '@/types/language';
import { getDictionary } from '@/i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);

// Helper to translate strings
const t = createTranslator(dictionary);

const titleText = t('faq.title', { fallback: 'Frequently Asked Questions' });
const descriptionText = t('faq.subtitle', {
  fallback: 'Find answers to common questions about our services.',
});

const faqKeys = [
  { q: 'faq.q1', a: 'faq.a1' },
  { q: 'faq.q2', a: 'faq.a2' },
  { q: 'faq.q3', a: 'faq.a3' },
  { q: 'faq.q4', a: 'faq.a4' },
  { q: 'faq.q5', a: 'faq.a5' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR',
  mainEntity: faqKeys.map((item) => ({
    '@type': 'Question',
    name: t(item.q),
    acceptedAnswer: {
      '@type': 'Answer',
      text: t(item.a),
    },
  })),
};

const breadcrumbs = [{ label: t('common.home'), url: `/${supportedLang}/` }, { label: titleText }];
---

<Layout title={titleText} description={descriptionText} lang={supportedLang} slug="faq">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <Hero
    title={titleText}
    description={descriptionText}
    breadcrumbs={breadcrumbs}
    lang={supportedLang}
  />

  <div class="py-16">
    <div class="container mx-auto max-w-3xl px-4">
      <div
        class="space-y-4 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm md:p-8 dark:border-slate-800 dark:bg-slate-900"
      >
        {
          faqKeys.map((item) => (
            <details class="group rounded-xl border border-gray-100 px-6 py-4 dark:border-slate-800 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg font-persian text-lg font-medium text-gray-900 transition-colors hover:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:text-white dark:hover:text-primary">
                <span>{t(item.q)}</span>
                <span class="transition-transform duration-300 group-open:-rotate-180">
                  <svg
                    aria-hidden="true"
                    class="h-5 w-5 text-gray-500 dark:text-gray-400"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="mt-4 font-persian text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                {t(item.a)}
              </div>
            </details>
          ))
        }
      </div>

      <div
        class="mt-12 rounded-2xl border border-blue-100 bg-blue-50/50 p-8 text-center font-persian dark:border-slate-800 dark:bg-slate-900"
      >
        <h2 class="mb-4 text-2xl font-bold text-gray-900 dark:text-white">
          {t('faq.stillHaveQuestions', { fallback: 'Still have questions?' })}
        </h2>
        <p class="mb-6 text-gray-600 dark:text-gray-300">
          {
            t('faq.contactText', {
              fallback:
                'If you cannot find answer to your question, please get in touch with our team.',
            })
          }
        </p>
        <a
          href={`/${supportedLang}/contact/`}
          class="inline-flex items-center justify-center rounded-lg border border-transparent bg-primary px-6 py-3 text-base font-bold text-primary-foreground shadow-xs transition-all hover:bg-primary/95 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
        >
          {t('common.contactUs', { fallback: 'Contact Us' })}
        </a>
      </div>
    </div>
  </div>
</Layout>
