---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/astro/Hero.astro';
import { getLanguageStaticPaths, type SupportedLanguage } from '@/types/language';
import { getDictionary } from '@/i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);

// Helper to translate strings
const t = createTranslator(dictionary);

const isRtl = supportedLang === 'fa' || supportedLang === 'ar';
const fontClass =
  supportedLang === 'en' ? 'font-sans' : supportedLang === 'ar' ? 'font-arabic' : 'font-persian';

const titleText = t('faq.title', { fallback: 'Frequently Asked Questions' });
const descriptionText = t('faq.subtitle', {
  fallback: 'Find answers to common questions about our services.',
});

const faqKeys = [
  { q: 'faq.q1', a: 'faq.a1' },
  { q: 'faq.q2', a: 'faq.a2' },
  { q: 'faq.q3', a: 'faq.a3' },
  { q: 'faq.q4', a: 'faq.a4' },
  { q: 'faq.q5', a: 'faq.a5' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR',
  mainEntity: faqKeys.map((item) => ({
    '@type': 'Question',
    name: t(item.q),
    acceptedAnswer: {
      '@type': 'Answer',
      text: t(item.a),
    },
  })),
};

const breadcrumbs = [{ label: t('common.home'), url: `/${supportedLang}/` }, { label: titleText }];
---

<Layout title={titleText} description={descriptionText} lang={supportedLang} slug="faq">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <Hero
    title={titleText}
    description={descriptionText}
    breadcrumbs={breadcrumbs}
    lang={supportedLang}
  />

  <div class={`py-12 md:py-16 bg-[var(--bg-canvas)] ${fontClass}`}>
    <div class="container mx-auto max-w-4xl px-4 space-y-8">
      <div class="terminal-window">
        <div class="terminal-chrome-bar" dir={isRtl ? 'rtl' : 'ltr'}>
          <span class="slash-eyebrow text-xs" dir={isRtl ? 'rtl' : 'ltr'}>
            {
              supportedLang === 'fa'
                ? '/سوالات-متداول · پرسش‌های عمومی و خدمات'
                : supportedLang === 'ar'
                  ? '/الأسئلة-الشائعة · الاستفسارات العامة والخدمات'
                  : '/FAQS · GENERAL & SERVICE INQUIRIES'
            }
          </span>
          <span class="monospace-telemetry-pill">
            {faqKeys.length} {supportedLang === 'fa' ? 'مورد' : supportedLang === 'ar' ? 'عناصر' : 'ENTRIES'}
          </span>
        </div>
        <div class="p-6 md:p-8 space-y-4">
          {faqKeys.map((item) => (
            <details class="group rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-6 py-4 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex cursor-pointer list-none items-center justify-between text-base md:text-lg font-bold text-[var(--text-primary)] transition-colors hover:text-[var(--accent-green)] focus:outline-none">
                <span>{t(item.q)}</span>
                <span class="transition-transform duration-300 group-open:-rotate-180 text-[var(--text-muted)]">
                  <svg aria-hidden="true" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="mt-4 text-sm leading-relaxed text-[var(--text-secondary)]">
                {t(item.a)}
              </div>
            </details>
          ))}
        </div>
      </div>

      <!-- Still have questions terminal card -->
      <div class="terminal-window p-8 text-center bg-[var(--bg-elevated)]" dir={isRtl ? 'rtl' : 'ltr'}>
        <span class="slash-eyebrow text-xs" dir={isRtl ? 'rtl' : 'ltr'}>
          {
            supportedLang === 'fa'
              ? '/ارتباط-مستقیم · پشتیبانی فنی'
              : supportedLang === 'ar'
                ? '/التواصل-المباشر · الدعم التقني'
                : '/SUPPORT-UPLINK · DIRECT ACCESS'
          }
        </span>
        <h2 class="mt-2 mb-3 text-xl md:text-2xl font-bold text-[var(--text-primary)]">
          {t('faq.stillHaveQuestions', { fallback: 'Still have questions?' })}
        </h2>
        <p class="mb-6 max-w-lg mx-auto text-sm text-[var(--text-secondary)] leading-relaxed">
          {t('faq.contactText', {
            fallback: 'If you cannot find the answer to your question, please get in touch with our team for direct technical consultation.',
          })}
        </p>
        <a
          href={`/${supportedLang}/contact/`}
          class="inline-flex items-center justify-center rounded border border-[var(--accent-green)] bg-[var(--accent-green-dim)] px-6 py-2.5 font-mono text-xs font-bold text-[var(--accent-contrast)] transition-all hover:bg-[var(--accent-green)] hover:text-[#090b0e]"
        >
          <span>{t('common.contactUs', { fallback: 'Contact Us' })}</span>
          <span aria-hidden="true" class="ms-1.5">{isRtl ? '←' : '→'}</span>
        </a>
      </div>
    </div>
  </div>
</Layout>
