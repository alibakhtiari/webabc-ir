---
import Layout from '@/layouts/Layout.astro';
import ServiceHero from '@/components/astro/ServiceHero.astro';
import CTA from '@/components/astro/CTA.astro';
import type { ImageMetadata } from 'astro';
import { type SupportedLanguage, languages } from '@/types/language';
import { getDictionary } from '@/i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';
import { serviceSlugs, slugInfoMap } from '@/config/services';
import { createServiceSchema } from '@/utils/serviceSchema';

// Import custom service content components
import SeoContent from '@/components/services/SeoContent.astro';
import LocalSeoContent from '@/components/services/LocalSeoContent.astro';
import WebDevContent from '@/components/services/WebDevContent.astro';
import WordpressContent from '@/components/services/WordpressContent.astro';
import WebDesignContent from '@/components/services/WebDesignContent.astro';
import MarketingServiceContent from '@/components/services/MarketingServiceContent.astro';
import AuditMaintenanceContent from '@/components/services/AuditMaintenanceContent.astro';
import EcommerceContent from '@/components/services/EcommerceContent.astro';

export async function getStaticPaths() {
  const params = [];
  for (const lang of Object.keys(languages)) {
    for (const slug of serviceSlugs) {
      params.push({
        params: { lang, slug },
      });
    }
  }
  return params;
}

const { lang, slug } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);
const isRtl = languages[supportedLang]?.direction === 'rtl';

// Helper to translate strings
const t = createTranslator(dictionary);

const info = slugInfoMap[slug];
const ns = info ? info.ns : 'services';
const serviceData = dictionary[ns] || {};

const pageTitle = t(info?.titleKey || '', { fallback: slug });
const pageDesc = t(info?.subtitleKey || '', {
  fallback: 'Professional services to grow your digital presence.',
});
const heroImage = (info ? info.img : slugInfoMap.seo.img) as ImageMetadata;

const breadcrumbs = [
  { label: t('common.home', { fallback: 'Home' }), url: `/${supportedLang}/` },
  { label: t('common.services', { fallback: 'Services' }), url: `/${supportedLang}/services/` },
  { label: pageTitle },
];

const pageSchema = createServiceSchema(
  slug,
  supportedLang,
  pageTitle,
  pageDesc,
  t('common.home', { fallback: 'Home' }),
  t('common.services', { fallback: 'Services' })
);
---

<Layout title={pageTitle} description={pageDesc} lang={supportedLang} slug={`services/${slug}`}>
  <!-- Inject Schema into Layout Head -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(pageSchema)} />

  <!-- Premium Side-Image Hero Section -->
  <ServiceHero
    title={pageTitle}
    subtitle={pageDesc}
    heroImage={heroImage}
    breadcrumbs={breadcrumbs}
    lang={supportedLang}
  >
    <!-- Action buttons -->
    <a
      href={`/${supportedLang}/contact/`}
      class="rounded-xl bg-primary px-6 py-3 font-persian text-sm font-bold text-primary-foreground shadow-md transition-all duration-300 hover:-translate-y-0.5 hover:bg-primary/95 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
    >
      {t('common.freeConsultation', { fallback: 'Free Consultation' })}
    </a>
    <a
      href={`/${supportedLang}/portfolio/`}
      class="inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-6 py-3 font-persian text-sm font-bold text-gray-700 shadow-xs transition-all duration-300 hover:-translate-y-0.5 hover:bg-gray-50 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-800 dark:text-gray-200 dark:hover:bg-slate-700"
    >
      {t('common.viewPortfolio', { fallback: 'View Portfolio' })}
      {
        isRtl ? (
          <svg
            aria-hidden="true"
            class="h-4 w-4 shrink-0"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
        ) : (
          <svg
            aria-hidden="true"
            class="h-4 w-4 shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        )
      }
    </a>
  </ServiceHero>

  <!-- Detailed Content Section -->
  <section class="py-16 font-sans">
    <div class="container mx-auto max-w-4xl space-y-12 px-4">
      {slug === 'seo' && <SeoContent lang={supportedLang} dictionary={dictionary} />}
      {slug === 'local-seo' && <LocalSeoContent lang={supportedLang} dictionary={dictionary} />}
      {slug === 'web-development' && <WebDevContent lang={supportedLang} dictionary={dictionary} />}
      {
        slug === 'wordpress-development' && (
          <WordpressContent lang={supportedLang} dictionary={dictionary} />
        )
      }
      {slug === 'web-design' && <WebDesignContent lang={supportedLang} dictionary={dictionary} />}
      {slug === 'ecommerce' && <EcommerceContent lang={supportedLang} dictionary={dictionary} />}

      {
        ['content-creation', 'link-building'].includes(slug) && (
          <MarketingServiceContent slug={slug} lang={supportedLang} dictionary={dictionary} />
        )
      }

      {
        ['speed-optimization', 'ui-ux-audit', 'website-maintenance'].includes(slug) && (
          <AuditMaintenanceContent slug={slug} lang={supportedLang} dictionary={dictionary} />
        )
      }

      <!-- Premium Consultation CTA -->
      <CTA
        lang={supportedLang}
        title={serviceData.cta?.title ||
          t('services.ctaTitle', { fallback: 'Ready to Elevate Your Digital Footprint?' })}
        description={serviceData.cta?.description ||
          t('services.ctaDescription', { fallback: 'Contact our team for a tailored approach.' })}
        buttonText={t('common.contactUs', { fallback: 'Contact Us' })}
      />
    </div>
  </section>
</Layout>
