---
import Layout from '../../../layouts/Layout.astro';
import Hero from '../../../components/astro/Hero.astro';
import FAQ from '../../../components/astro/FAQ.astro';
import CTA from '../../../components/astro/CTA.astro';
import { type SupportedLanguage } from '../../../types/language';
import { getDictionary } from '../../../i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'fa' } },
    { params: { lang: 'ar' } },
  ];
}

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);

// Helper to translate strings
const t = createTranslator(dictionary);

const titleText = t('services.title', { fallback: 'Our Services' });
const descriptionText = t('services.description', { fallback: 'Professional Web Design and SEO Services' });

const servicesSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": titleText,
  "description": descriptionText,
  "provider": {
    "@id": "https://webabc.ir/#organization"
  },
  "inLanguage": supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR'
};

const breadcrumbs = [
  { label: t('common.home', { fallback: 'Home' }), url: `/${supportedLang}` },
  { label: t('common.services', { fallback: 'Services' }) }
];

// Define all 7 main services for the list
const servicesList = [
  {
    slug: 'seo',
    title: t('seo.title', { fallback: 'SEO' }),
    desc: t('seo.subtitle', { fallback: '' }),
    color: 'bg-blue-50 text-blue-600 border-blue-100',
    icon: 'seo',
    features: [
      t('seo.onPageSeo', { fallback: 'On-Page SEO' }),
      t('seo.offPageSeo', { fallback: 'Off-Page SEO' }),
      t('seo.technicalSeo', { fallback: 'Technical SEO' }),
      t('seo.localSeo', { fallback: 'Local SEO' })
    ]
  },
  {
    slug: 'web-development',
    title: t('services.webDevelopment', { fallback: 'Web Development' }),
    desc: t('services.webDevelopmentDescription', { fallback: '' }),
    color: 'bg-green-50 text-green-600 border-green-100',
    icon: 'web-dev',
    features: [
      t('services.feature.uiuxDesign', { fallback: 'UI/UX Design' }),
      t('services.feature.responsiveDesign', { fallback: 'Responsive Design' }),
      t('services.feature.apiIntegration', { fallback: 'API Integration' }),
      t('services.feature.database', { fallback: 'Database Setup' })
    ]
  },
  {
    slug: 'wordpress-development',
    title: t('wordpress.wordpressAndWoocommerce', { fallback: 'WordPress & WooCommerce' }),
    desc: t('wordpress.subtitle', { fallback: '' }),
    color: 'bg-purple-50 text-purple-600 border-purple-100',
    icon: 'wordpress',
    features: [
      t('wordpress.themeCustomization', { fallback: 'Theme Customization' }),
      t('wordpress.pluginDevelopment', { fallback: 'Plugin Development' }),
      t('wordpress.ecommerceSetup', { fallback: 'E-commerce Store' }),
      t('wordpress.maintenanceSupport', { fallback: 'CMS Maintenance' })
    ]
  },
  {
    slug: 'local-seo',
    title: t('seo.localSeo', { fallback: 'Local SEO' }),
    desc: t('seo.localSeoDesc', { fallback: '' }),
    color: 'bg-red-50 text-red-600 border-red-100',
    icon: 'local-seo',
    features: [
      t('seo.feature.gmb', { fallback: 'Google Business Profile' }),
      t('seo.feature.reviews', { fallback: 'Review management' }),
      t('seo.feature.localKeywords', { fallback: 'Local Keywords' }),
      t('seo.feature.nearMe', { fallback: 'Near Me targeting' })
    ]
  },
  {
    slug: 'website-maintenance',
    title: t('maintenance.title', { fallback: 'Website Care Plans' }),
    desc: t('maintenance.subtitle', { fallback: '' }),
    color: 'bg-cyan-50 text-cyan-600 border-cyan-100',
    icon: 'maintenance',
    features: [
      t('maintenance.features.0', { fallback: 'WordPress core updates' }),
      t('maintenance.features.1', { fallback: 'Security audits' }),
      t('maintenance.features.2', { fallback: 'Cloud backups' }),
      t('maintenance.features.3', { fallback: 'Speed checkups' })
    ]
  },
  {
    slug: 'ecommerce',
    title: t('ecommerce.title', { fallback: 'E-commerce Development' }),
    desc: t('ecommerce.subtitle', { fallback: '' }),
    color: 'bg-emerald-50 text-emerald-600 border-emerald-100',
    icon: 'ecommerce',
    features: [
      t('ecommerce.feature.productPages', { fallback: 'SEO Product Pages' }),
      t('ecommerce.feature.checkout', { fallback: 'Secure Checkout' }),
      t('ecommerce.feature.payments', { fallback: 'Payment Integration' }),
      t('ecommerce.feature.inventory', { fallback: 'Inventory Management' })
    ]
  },
  {
    slug: 'speed-optimization',
    title: t('speedOptimization.title', { fallback: 'Speed Optimization' }),
    desc: t('speedOptimization.subtitle', { fallback: '' }),
    color: 'bg-orange-50 text-orange-600 border-orange-100',
    icon: 'speed',
    features: [
      t('speedOptimization.features.0', { fallback: 'Image optimization' }),
      t('speedOptimization.features.1', { fallback: 'Database optimization' }),
      t('speedOptimization.features.2', { fallback: 'Browser caching' }),
      t('speedOptimization.features.3', { fallback: 'Code minification' })
    ]
  },
  {
    slug: 'ui-ux-audit',
    title: t('uiUxAudit.title', { fallback: 'UI/UX Audits' }),
    desc: t('uiUxAudit.subtitle', { fallback: '' }),
    color: 'bg-indigo-50 text-indigo-600 border-indigo-100',
    icon: 'ui-ux',
    features: [
      t('uiUxAudit.features.0', { fallback: 'Navigation audits' }),
      t('uiUxAudit.features.1', { fallback: 'Mobile checks' }),
      t('uiUxAudit.features.2', { fallback: 'Conversion checks' }),
      t('uiUxAudit.features.3', { fallback: 'Audits report' })
    ]
  }
];

// FAQ items
const faqList = [
  { question: t('services.faq.costQuestion', { fallback: 'How much do your services cost?' }), answer: t('services.faq.costAnswer', { fallback: '' }) },
  { question: t('services.faq.timelineQuestion', { fallback: 'What is the project timeline?' }), answer: t('services.faq.timelineAnswer', { fallback: '' }) },
  { question: t('services.faq.wordpressQuestion', { fallback: 'Do you build on WordPress?' }), answer: t('services.faq.wordpressAnswer', { fallback: '' }) },
  { question: t('services.faq.multilingualQuestion', { fallback: 'Do you support multi-language?' }), answer: t('services.faq.multilingualAnswer', { fallback: '' }) }
].filter(item => item.question && item.answer);
---

<Layout title={titleText} description={descriptionText} lang={supportedLang} slug="services">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(servicesSchema)} />

  <Hero title={titleText} description={descriptionText} breadcrumbs={breadcrumbs} lang={supportedLang}>
    <!-- Quick navigation links slot -->
    <div class="flex flex-wrap gap-4 justify-center mt-8 font-persian">
      <a href={`/${supportedLang}/services/seo`} class="px-4 py-2 bg-blue-50 text-blue-700 rounded-full hover:bg-blue-100 transition-colors">
        {t('seo.title', { fallback: 'SEO' })}
      </a>
      <a href={`/${supportedLang}/services/web-development`} class="px-4 py-2 bg-green-50 text-green-700 rounded-full hover:bg-green-100 transition-colors">
        {t('services.webDevelopment', { fallback: 'Web Development' })}
      </a>
      <a href={`/${supportedLang}/services/wordpress-development`} class="px-4 py-2 bg-purple-50 text-purple-700 rounded-full hover:bg-purple-100 transition-colors">
        {t('wordpress.title', { fallback: 'WordPress' })}
      </a>
      <a href={`/${supportedLang}/services/local-seo`} class="px-4 py-2 bg-red-50 text-red-700 rounded-full hover:bg-red-100 transition-colors">
        {t('seo.localSeo', { fallback: 'Local SEO' })}
      </a>
    </div>
  </Hero>

  <!-- Services Grid -->
  <section class="py-16 bg-white font-sans">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {servicesList.map((service) => (
          <div class="bg-white border border-gray-100 rounded-2xl p-8 shadow-xs hover:shadow-lg transition-all space-y-6 flex flex-col justify-between group">
            <div class="space-y-4">
              <!-- Icon Container -->
              <div class={`w-12 h-12 rounded-xl flex items-center justify-center border shadow-xs group-hover:scale-105 transition-transform ${service.color}`}>
                {service.icon === 'seo' && <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>}
                {service.icon === 'web-dev' && <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>}
                {service.icon === 'wordpress' && <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Z"></path><path d="M18 14h-8"></path><path d="M15 18h-5"></path><rect x="10" y="6" width="8" height="4" rx="1"></rect></svg>}
                {service.icon === 'local-seo' && <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>}
                {service.icon === 'maintenance' && <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 11 11 13 15 9"></polyline></svg>}
                {service.icon === 'speed' && <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>}
                {service.icon === 'ui-ux' && <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>}
                {service.icon === 'ecommerce' && <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>}
              </div>

              <!-- Title & Subtitle -->
              <h3 class="text-xl font-bold text-gray-900 font-persian">{service.title}</h3>
              <p class="text-gray-500 text-sm leading-relaxed font-persian line-clamp-3">{service.desc}</p>
              
              <!-- Bullet features checklist -->
              <ul class="space-y-2.5 pt-2">
                {service.features.map((feat) => (
                  <li class="flex items-center text-xs text-gray-700 font-persian gap-2">
                    <svg class="w-3.5 h-3.5 text-green-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Learn More Link -->
            <a href={`/${supportedLang}/services/${service.slug}`} class="text-primary font-bold text-sm inline-flex items-center gap-1 font-persian self-start mt-4 group-hover:translate-x-0.5 transition-transform">
              {t('common.readMore', { fallback: 'Read More' })} &rarr;
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  {faqList.length > 0 && (
    <section class="py-16 bg-gray-50/50 border-y border-gray-100">
      <div class="container mx-auto px-4 max-w-4xl">
        <FAQ faqList={faqList} lang={supportedLang} />
      </div>
    </section>
  )}

  <!-- Premium Consultation CTA -->
  <section class="container mx-auto px-4 max-w-4xl">
    <CTA 
      lang={supportedLang} 
      title={t('services.ctaTitle', { fallback: 'Ready to Elevate Your Digital Footprint?' })} 
      description={t('services.ctaDescription', { fallback: 'Contact our team for a tailored approach.' })} 
      buttonText={t('common.contactUs', { fallback: 'Contact Us' })} 
    />
  </section>
</Layout>
