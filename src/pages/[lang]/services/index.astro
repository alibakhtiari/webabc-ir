---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/astro/Hero.astro';
import FAQ from '@/components/astro/FAQ.astro';
import CTA from '@/components/astro/CTA.astro';
import { getLanguageStaticPaths, type SupportedLanguage } from '@/types/language';
import { getDictionary } from '@/i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);
const isRtl = supportedLang === 'fa' || supportedLang === 'ar';

// Helper to translate strings
const t = createTranslator(dictionary);

const titleText = t('services.title', { fallback: 'Our Services' });
const descriptionText = t('services.description', {
  fallback: 'Professional Web Design and SEO Services',
});

const servicesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: titleText,
  description: descriptionText,
  url: `https://webabc.ir/${supportedLang}/services/`,
  inLanguage: supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      item: {
        '@type': 'Service',
        name: t('seo.title', { fallback: 'SEO' }),
        url: `https://webabc.ir/${supportedLang}/services/seo`,
      },
    },
    {
      '@type': 'ListItem',
      position: 2,
      item: {
        '@type': 'Service',
        name: t('services.webDevelopment', { fallback: 'Web Development' }),
        url: `https://webabc.ir/${supportedLang}/services/web-development`,
      },
    },
    {
      '@type': 'ListItem',
      position: 3,
      item: {
        '@type': 'Service',
        name: t('wordpress.wordpressAndWoocommerce', { fallback: 'WordPress & WooCommerce' }),
        url: `https://webabc.ir/${supportedLang}/services/wordpress-development`,
      },
    },
    {
      '@type': 'ListItem',
      position: 4,
      item: {
        '@type': 'Service',
        name: t('seo.localSeo', { fallback: 'Local SEO' }),
        url: `https://webabc.ir/${supportedLang}/services/local-seo`,
      },
    },
    {
      '@type': 'ListItem',
      position: 5,
      item: {
        '@type': 'Service',
        name: t('maintenance.title', { fallback: 'Website Care Plans' }),
        url: `https://webabc.ir/${supportedLang}/services/website-maintenance`,
      },
    },
    {
      '@type': 'ListItem',
      position: 6,
      item: {
        '@type': 'Service',
        name: t('ecommerce.title', { fallback: 'E-commerce Development' }),
        url: `https://webabc.ir/${supportedLang}/services/ecommerce`,
      },
    },
    {
      '@type': 'ListItem',
      position: 7,
      item: {
        '@type': 'Service',
        name: t('speedOptimization.title', { fallback: 'Speed Optimization' }),
        url: `https://webabc.ir/${supportedLang}/services/speed-optimization`,
      },
    },
    {
      '@type': 'ListItem',
      position: 8,
      item: {
        '@type': 'Service',
        name: t('uiUxAudit.title', { fallback: 'UI/UX Audits' }),
        url: `https://webabc.ir/${supportedLang}/services/ui-ux-audit`,
      },
    },
  ],
};

const breadcrumbs = [
  { label: t('common.home', { fallback: 'Home' }), url: `/${supportedLang}/` },
  { label: t('common.services', { fallback: 'Services' }) },
];

// Define all 7 main services for the list
const servicesList = [
  {
    slug: 'seo',
    title: t('seo.title', { fallback: 'SEO' }),
    desc: t('seo.subtitle', { fallback: '' }),
    color: 'bg-blue-50 text-blue-600 border-blue-100',
    icon: 'seo',
    features: [
      t('seo.onPageSeo', { fallback: 'On-Page SEO' }),
      t('seo.offPageSeo', { fallback: 'Off-Page SEO' }),
      t('seo.technicalSeo', { fallback: 'Technical SEO' }),
      t('seo.localSeo', { fallback: 'Local SEO' }),
    ],
  },
  {
    slug: 'web-development',
    title: t('services.webDevelopment', { fallback: 'Web Development' }),
    desc: t('services.webDevelopmentDescription', { fallback: '' }),
    color: 'bg-green-50 text-green-600 border-green-100',
    icon: 'web-dev',
    features: [
      t('services.feature.uiuxDesign', { fallback: 'UI/UX Design' }),
      t('services.feature.responsiveDesign', { fallback: 'Responsive Design' }),
      t('services.feature.apiIntegration', { fallback: 'API Integration' }),
      t('services.feature.database', { fallback: 'Database Setup' }),
    ],
  },
  {
    slug: 'wordpress-development',
    title: t('wordpress.wordpressAndWoocommerce', { fallback: 'WordPress & WooCommerce' }),
    desc: t('wordpress.subtitle', { fallback: '' }),
    color: 'bg-purple-50 text-purple-600 border-purple-100',
    icon: 'wordpress',
    features: [
      t('wordpress.themeCustomization', { fallback: 'Theme Customization' }),
      t('wordpress.pluginDevelopment', { fallback: 'Plugin Development' }),
      t('wordpress.ecommerceSetup', { fallback: 'E-commerce Store' }),
      t('wordpress.maintenanceSupport', { fallback: 'CMS Maintenance' }),
    ],
  },
  {
    slug: 'local-seo',
    title: t('seo.localSeo', { fallback: 'Local SEO' }),
    desc: t('seo.localSeoDesc', { fallback: '' }),
    color: 'bg-red-50 text-red-600 border-red-100',
    icon: 'local-seo',
    features: [
      t('seo.feature.gmb', { fallback: 'Google Business Profile' }),
      t('seo.feature.reviews', { fallback: 'Review management' }),
      t('seo.feature.localKeywords', { fallback: 'Local Keywords' }),
      t('seo.feature.nearMe', { fallback: 'Near Me targeting' }),
    ],
  },
  {
    slug: 'website-maintenance',
    title: t('maintenance.title', { fallback: 'Website Care Plans' }),
    desc: t('maintenance.subtitle', { fallback: '' }),
    color: 'bg-cyan-50 text-cyan-600 border-cyan-100',
    icon: 'maintenance',
    features: [
      t('maintenance.features.0', { fallback: 'WordPress core updates' }),
      t('maintenance.features.1', { fallback: 'Security audits' }),
      t('maintenance.features.2', { fallback: 'Cloud backups' }),
      t('maintenance.features.3', { fallback: 'Speed checkups' }),
    ],
  },
  {
    slug: 'ecommerce',
    title: t('ecommerce.title', { fallback: 'E-commerce Development' }),
    desc: t('ecommerce.subtitle', { fallback: '' }),
    color: 'bg-emerald-50 text-emerald-600 border-emerald-100',
    icon: 'ecommerce',
    features: [
      t('ecommerce.feature.productPages', { fallback: 'SEO Product Pages' }),
      t('ecommerce.feature.checkout', { fallback: 'Secure Checkout' }),
      t('ecommerce.feature.payments', { fallback: 'Payment Integration' }),
      t('ecommerce.feature.inventory', { fallback: 'Inventory Management' }),
    ],
  },
  {
    slug: 'speed-optimization',
    title: t('speedOptimization.title', { fallback: 'Speed Optimization' }),
    desc: t('speedOptimization.subtitle', { fallback: '' }),
    color: 'bg-orange-50 text-orange-600 border-orange-100',
    icon: 'speed',
    features: [
      t('speedOptimization.features.0', { fallback: 'Image optimization' }),
      t('speedOptimization.features.1', { fallback: 'Database optimization' }),
      t('speedOptimization.features.2', { fallback: 'Browser caching' }),
      t('speedOptimization.features.3', { fallback: 'Code minification' }),
    ],
  },
  {
    slug: 'ui-ux-audit',
    title: t('uiUxAudit.title', { fallback: 'UI/UX Audits' }),
    desc: t('uiUxAudit.subtitle', { fallback: '' }),
    color: 'bg-indigo-50 text-indigo-600 border-indigo-100',
    icon: 'ui-ux',
    features: [
      t('uiUxAudit.features.0', { fallback: 'Navigation audits' }),
      t('uiUxAudit.features.1', { fallback: 'Mobile checks' }),
      t('uiUxAudit.features.2', { fallback: 'Conversion checks' }),
      t('uiUxAudit.features.3', { fallback: 'Audits report' }),
    ],
  },
];

// FAQ items
const faqList = [
  {
    question: t('services.faq.costQuestion', { fallback: 'How much do your services cost?' }),
    answer: t('services.faq.costAnswer', { fallback: '' }),
  },
  {
    question: t('services.faq.timelineQuestion', { fallback: 'What is the project timeline?' }),
    answer: t('services.faq.timelineAnswer', { fallback: '' }),
  },
  {
    question: t('services.faq.wordpressQuestion', { fallback: 'Do you build on WordPress?' }),
    answer: t('services.faq.wordpressAnswer', { fallback: '' }),
  },
  {
    question: t('services.faq.multilingualQuestion', {
      fallback: 'Do you support multi-language?',
    }),
    answer: t('services.faq.multilingualAnswer', { fallback: '' }),
  },
].filter((item) => item.question && item.answer);
---

<Layout title={titleText} description={descriptionText} lang={supportedLang} slug="services">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(servicesSchema)} />

  <Hero
    title={titleText}
    description={descriptionText}
    breadcrumbs={breadcrumbs}
    lang={supportedLang}
  >
    <!-- Quick navigation links slot -->
    <div class="mt-8 flex flex-wrap justify-center gap-4 font-persian">
      <a
        href={`/${supportedLang}/services/seo/`}
        class="rounded-full bg-blue-50 px-4 py-2 text-blue-700 transition-colors hover:bg-blue-100 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:bg-blue-950/60 dark:text-blue-300 dark:hover:bg-blue-900/60"
      >
        {t('seo.title', { fallback: 'SEO' })}
      </a>
      <a
        href={`/${supportedLang}/services/web-development/`}
        class="rounded-full bg-green-50 px-4 py-2 text-green-700 transition-colors hover:bg-green-100 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:bg-green-950/60 dark:text-green-300 dark:hover:bg-green-900/60"
      >
        {t('services.webDevelopment', { fallback: 'Web Development' })}
      </a>
      <a
        href={`/${supportedLang}/services/wordpress-development/`}
        class="rounded-full bg-purple-50 px-4 py-2 text-purple-700 transition-colors hover:bg-purple-100 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:bg-purple-950/60 dark:text-purple-300 dark:hover:bg-purple-900/60"
      >
        {t('wordpress.title', { fallback: 'WordPress' })}
      </a>
      <a
        href={`/${supportedLang}/services/local-seo/`}
        class="rounded-full bg-red-50 px-4 py-2 text-red-700 transition-colors hover:bg-red-100 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:bg-red-950/60 dark:text-red-300 dark:hover:bg-red-900/60"
      >
        {t('seo.localSeo', { fallback: 'Local SEO' })}
      </a>
    </div>
  </Hero>

  <!-- Services Grid -->
  <section class="bg-white py-16 font-sans dark:bg-slate-950">
    <div class="container mx-auto max-w-6xl px-4">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          servicesList.map((service) => (
            <div class="group flex flex-col justify-between space-y-6 rounded-2xl border border-gray-100 bg-white p-8 shadow-xs transition-all hover:shadow-lg dark:border-slate-800 dark:bg-slate-900">
              <div class="space-y-4">
                <div
                  class={`flex h-12 w-12 items-center justify-center rounded-xl border shadow-xs transition-transform group-hover:scale-105 ${service.color}`}
                >
                  {service.icon === 'seo' && (
                    <svg
                      aria-hidden="true"
                      class="h-6 w-6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                    >
                      <circle cx="12" cy="12" r="10" />
                      <line x1="2" y1="12" x2="22" y2="12" />
                      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                    </svg>
                  )}
                  {service.icon === 'web-dev' && (
                    <svg
                      aria-hidden="true"
                      class="h-6 w-6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                    >
                      <polygon points="12 2 2 7 12 12 22 7 12 2" />
                      <polyline points="2 17 12 22 22 17" />
                      <polyline points="2 12 12 17 22 12" />
                    </svg>
                  )}
                  {service.icon === 'wordpress' && (
                    <svg
                      aria-hidden="true"
                      class="h-6 w-6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                    >
                      <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Z" />
                      <path d="M18 14h-8" />
                      <path d="M15 18h-5" />
                      <rect x="10" y="6" width="8" height="4" rx="1" />
                    </svg>
                  )}
                  {service.icon === 'local-seo' && (
                    <svg
                      aria-hidden="true"
                      class="h-6 w-6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                    >
                      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                      <circle cx="12" cy="10" r="3" />
                    </svg>
                  )}
                  {service.icon === 'maintenance' && (
                    <svg
                      aria-hidden="true"
                      class="h-6 w-6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                    >
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                      <polyline points="9 11 11 13 15 9" />
                    </svg>
                  )}
                  {service.icon === 'speed' && (
                    <svg
                      aria-hidden="true"
                      class="h-6 w-6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                    >
                      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                    </svg>
                  )}
                  {service.icon === 'ui-ux' && (
                    <svg
                      aria-hidden="true"
                      class="h-6 w-6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                    >
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                      <line x1="3" y1="9" x2="21" y2="9" />
                      <line x1="9" y1="21" x2="9" y2="9" />
                    </svg>
                  )}
                  {service.icon === 'ecommerce' && (
                    <svg
                      aria-hidden="true"
                      class="h-6 w-6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                    >
                      <circle cx="9" cy="21" r="1" />
                      <circle cx="20" cy="21" r="1" />
                      <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                    </svg>
                  )}
                </div>

                <h2 class="font-persian text-xl font-bold text-gray-900 dark:text-white">
                  {service.title}
                </h2>
                <p class="line-clamp-3 font-persian text-sm leading-relaxed text-gray-500 dark:text-gray-400">
                  {service.desc}
                </p>

                <ul class="space-y-2.5 pt-2">
                  {service.features.map((feat) => (
                    <li class="flex items-center gap-2 font-persian text-xs text-gray-700 dark:text-gray-300">
                      <svg
                        aria-hidden="true"
                        class="h-3.5 w-3.5 shrink-0 text-green-500"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        viewBox="0 0 24 24"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <a
                href={`/${supportedLang}/services/${service.slug}/`}
                class={`mt-4 inline-flex items-center gap-1 self-start font-persian text-sm font-bold text-primary ${isRtl ? 'group-hover:-translate-x-0.5' : 'group-hover:translate-x-0.5'} transition-transform`}
              >
                {service.title} {isRtl ? '←' : '→'}
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  {
    faqList.length > 0 && (
      <section class="border-y border-gray-100 bg-gray-50/50 py-16 dark:border-slate-800 dark:bg-slate-900/30">
        <div class="container mx-auto max-w-4xl px-4">
          <FAQ faqList={faqList} lang={supportedLang} />
        </div>
      </section>
    )
  }

  <!-- Premium Consultation CTA -->
  <section class="container mx-auto max-w-4xl px-4">
    <CTA
      lang={supportedLang}
      title={t('services.ctaTitle', { fallback: 'Ready to Elevate Your Digital Footprint?' })}
      description={t('services.ctaDescription', {
        fallback: 'Contact our team for a tailored approach.',
      })}
      buttonText={t('common.contactUs', { fallback: 'Contact Us' })}
    />
  </section>
</Layout>
