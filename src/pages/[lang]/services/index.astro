---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/astro/Hero.astro';
import FAQ from '@/components/astro/FAQ.astro';
import CTA from '@/components/astro/CTA.astro';
import { getLanguageStaticPaths, type SupportedLanguage, languages } from '@/types/language';
import { getDictionary } from '@/i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);
const isRtl = languages[supportedLang]?.direction === 'rtl';
const fontClass =
  supportedLang === 'en' ? 'font-sans' : supportedLang === 'ar' ? 'font-arabic' : 'font-persian';

const t = createTranslator(dictionary);

const titleText = t('services.title', { fallback: 'Our Services' });
const descriptionText = t('services.description', {
  fallback: 'Professional Web Design, Custom Development, Technical SEO, and AEO/GEO Services',
});

// Complete directory of all 11 core services (restoring web-design, content-creation, and link-building)
const servicesList = [
  {
    slug: 'seo',
    title: t('seo.title', { fallback: 'SEO & Search Optimization' }),
    desc: t('seo.subtitle', { fallback: '' }),
    color: 'bg-blue-50 text-blue-600 border-blue-100 dark:bg-blue-950/50 dark:text-blue-400 dark:border-blue-900',
    icon: 'seo',
    features: [
      t('seo.onPageSeo', { fallback: 'On-Page & Semantic SEO' }),
      t('seo.technicalSeo', { fallback: 'Technical SEO & CWV' }),
      t('seo.offPageSeo', { fallback: 'Authority & Digital PR' }),
      t('seo.localSeo', { fallback: 'AEO / GEO Citations' }),
    ],
  },
  {
    slug: 'web-design',
    title: t('webDesign.title', { fallback: 'Custom Web Design & UI/UX' }),
    desc: t('webDesign.description', { fallback: '' }),
    color: 'bg-sky-50 text-sky-600 border-sky-100 dark:bg-sky-950/50 dark:text-sky-400 dark:border-sky-900',
    icon: 'web-design',
    features: [
      t('webDesign.features.uiux.title', { fallback: 'Figma UI/UX Prototyping' }),
      t('webDesign.features.responsive.title', { fallback: 'Mobile-First Design System' }),
      t('webDesign.features.react.title', { fallback: 'Sub-Second Astro & React UI' }),
      t('webDesign.features.seo.title', { fallback: 'Conversion-Focused Layouts' }),
    ],
  },
  {
    slug: 'web-development',
    title: t('services.webDevelopment', { fallback: 'Custom Web Development' }),
    desc: t('services.webDevelopmentDescription', { fallback: '' }),
    color: 'bg-green-50 text-green-600 border-green-100 dark:bg-green-950/50 dark:text-green-400 dark:border-green-900',
    icon: 'web-dev',
    features: [
      t('services.feature.uiuxDesign', { fallback: 'Astro, React & Next.js' }),
      t('services.feature.responsiveDesign', { fallback: 'Responsive Architecture' }),
      t('services.feature.apiIntegration', { fallback: 'REST API & Cloud Edge' }),
      t('services.feature.database', { fallback: 'Database Engineering' }),
    ],
  },
  {
    slug: 'wordpress-development',
    title: t('wordpress.wordpressAndWoocommerce', { fallback: 'WordPress & WooCommerce' }),
    desc: t('wordpress.subtitle', { fallback: '' }),
    color: 'bg-purple-50 text-purple-600 border-purple-100 dark:bg-purple-950/50 dark:text-purple-400 dark:border-purple-900',
    icon: 'wordpress',
    features: [
      t('wordpress.themeCustomization', { fallback: 'Hand-Coded Custom Themes' }),
      t('wordpress.pluginDevelopment', { fallback: 'Custom Plugin Engineering' }),
      t('wordpress.ecommerceSetup', { fallback: 'High-Speed WooCommerce' }),
      t('wordpress.maintenanceSupport', { fallback: 'Zero-Bloat CWV Tuning' }),
    ],
  },
  {
    slug: 'local-seo',
    title: t('seo.localSeo', { fallback: 'Local SEO & Google Maps' }),
    desc: t('seo.localSeoDesc', { fallback: '' }),
    color: 'bg-red-50 text-red-600 border-red-100 dark:bg-red-950/50 dark:text-red-400 dark:border-red-900',
    icon: 'local-seo',
    features: [
      t('seo.feature.gmb', { fallback: 'Google Business Profile' }),
      t('seo.feature.reviews', { fallback: 'Review & NAP Integrity' }),
      t('seo.feature.localKeywords', { fallback: 'City & Regional Keywords' }),
      t('seo.feature.nearMe', { fallback: 'Google 3-Pack & Neshan/Balad' }),
    ],
  },
  {
    slug: 'ecommerce',
    title: t('ecommerce.title', { fallback: 'E-commerce Development' }),
    desc: t('ecommerce.subtitle', { fallback: '' }),
    color: 'bg-emerald-50 text-emerald-600 border-emerald-100 dark:bg-emerald-950/50 dark:text-emerald-400 dark:border-emerald-900',
    icon: 'ecommerce',
    features: [
      t('ecommerce.feature.productPages', { fallback: 'SEO Product & Offer Schema' }),
      t('ecommerce.feature.checkout', { fallback: 'Low-Friction Checkout UX' }),
      t('ecommerce.feature.payments', { fallback: 'Regional & Global Gateways' }),
      t('ecommerce.feature.inventory', { fallback: 'Inventory & ERP Sync' }),
    ],
  },
  {
    slug: 'speed-optimization',
    title: t('speedOptimization.title', { fallback: 'Speed & Core Web Vitals' }),
    desc: t('speedOptimization.subtitle', { fallback: '' }),
    color: 'bg-orange-50 text-orange-600 border-orange-100 dark:bg-orange-950/50 dark:text-orange-400 dark:border-orange-900',
    icon: 'speed',
    features: [
      t('speedOptimization.features.0', { fallback: 'Edge CDN & Caching' }),
      t('speedOptimization.features.1', { fallback: 'AVIF/WebP Asset Pipeline' }),
      t('speedOptimization.features.2', { fallback: 'INP & Main-Thread Tuning' }),
      t('speedOptimization.features.3', { fallback: 'Before/After Verification' }),
    ],
  },
  {
    slug: 'content-creation',
    title: t('contentCreation.title', { fallback: 'SEO & GEO Content Strategy' }),
    desc: t('contentCreation.description', { fallback: '' }),
    color: 'bg-pink-50 text-pink-600 border-pink-100 dark:bg-pink-950/50 dark:text-pink-400 dark:border-pink-900',
    icon: 'content',
    features: [
      t('contentCreation.features.blogging.title', { fallback: 'Answer-First Pillar Guides' }),
      t('contentCreation.features.copywriting.title', { fallback: 'Conversion Landing Copy' }),
      t('contentCreation.features.strategy.title', { fallback: 'Topic Cluster Mapping' }),
      t('contentCreation.features.editing.title', { fallback: 'E-E-A-T Editorial Review' }),
    ],
  },
  {
    slug: 'link-building',
    title: t('linkBuilding.title', { fallback: 'White-Hat Link Building' }),
    desc: t('linkBuilding.description', { fallback: '' }),
    color: 'bg-violet-50 text-violet-600 border-violet-100 dark:bg-violet-950/50 dark:text-violet-400 dark:border-violet-900',
    icon: 'links',
    features: [
      t('linkBuilding.features.guestPosting.title', { fallback: 'Editorial Guest Placements' }),
      t('linkBuilding.features.brokenLink.title', { fallback: 'Broken Link Reclamation' }),
      t('linkBuilding.features.unlinkedMentions.title', { fallback: 'Unlinked Brand Mentions' }),
      t('linkBuilding.features.audit.title', { fallback: 'Backlink Toxicity Audit' }),
    ],
  },
  {
    slug: 'ui-ux-audit',
    title: t('uiUxAudit.title', { fallback: 'UI/UX & Conversion Audit' }),
    desc: t('uiUxAudit.subtitle', { fallback: '' }),
    color: 'bg-indigo-50 text-indigo-600 border-indigo-100 dark:bg-indigo-950/50 dark:text-indigo-400 dark:border-indigo-900',
    icon: 'ui-ux',
    features: [
      t('uiUxAudit.features.0', { fallback: 'Video Journey Walkthrough' }),
      t('uiUxAudit.features.1', { fallback: 'Nielsen Heuristic Review' }),
      t('uiUxAudit.features.2', { fallback: 'Checkout & Form CRO' }),
      t('uiUxAudit.features.3', { fallback: 'WCAG 2.2 AA Accessibility' }),
    ],
  },
  {
    slug: 'website-maintenance',
    title: t('maintenance.title', { fallback: 'Website Maintenance & Care' }),
    desc: t('maintenance.subtitle', { fallback: '' }),
    color: 'bg-cyan-50 text-cyan-600 border-cyan-100 dark:bg-cyan-950/50 dark:text-cyan-400 dark:border-cyan-900',
    icon: 'maintenance',
    features: [
      t('maintenance.features.0', { fallback: '24/7 Security & Uptime' }),
      t('maintenance.features.1', { fallback: 'Staged Weekly Updates' }),
      t('maintenance.features.2', { fallback: 'Daily Off-Site Backups' }),
      t('maintenance.features.3', { fallback: 'Monthly Health Reports' }),
    ],
  },
];

const enterpriseSolutions = [
  {
    href: `/${supportedLang}/industrial-web-design/`,
    badge: supportedLang === 'fa' ? 'صنعتی · B2B' : supportedLang === 'ar' ? 'صناعي · B2B' : 'Manufacturing · B2B',
    title:
      supportedLang === 'fa'
        ? 'طراحی سایت صنعتی و سئوی کارخانجات B2B'
        : supportedLang === 'ar'
          ? 'تصميم المواقع الصناعية وسيو المصانع B2B'
          : 'Industrial Web Design & B2B Manufacturing SEO',
    desc:
      supportedLang === 'fa'
        ? 'کاتالوگ فنی قطعات، سیستم استعلام قیمت عمده (RFQ) و سئوی تخصصی کارخانجات و شهرک‌های صنعتی.'
        : supportedLang === 'ar'
          ? 'كتالوج المواصفات الفنية ونظام طلب عروض الأسعار RFQ والسيو الصناعي للمصانع والشركات الهندسية.'
          : 'Searchable technical datasheets, multi-SKU RFQ quote workflows, and industrial Schema.org architecture.',
  },
  {
    href: `/${supportedLang}/export-web-design/`,
    badge: supportedLang === 'fa' ? 'صادراتی · چندزبانه' : supportedLang === 'ar' ? 'تصدير · متعدد اللغات' : 'Cross-Border · Hreflang',
    title:
      supportedLang === 'fa'
        ? 'طراحی سایت صادراتی و سئوی بین‌المللی چندزبانه'
        : supportedLang === 'ar'
          ? 'تصميم مواقع التصدير والسيو الدولي متعدد اللغات'
          : 'Export Web Design & International Multilingual SEO',
    desc:
      supportedLang === 'fa'
        ? 'معماری سه‌زبانه (فارسی/انگلیسی/عربی) با تقارن کامل hreflang و تحویل زیر نیم‌ثانیه روی لبه کلودفلر.'
        : supportedLang === 'ar'
          ? 'بنية متعددة اللغات (عربي/إنجليزي/فارسي) بتطابق hreflang كامل وتسليم فوري عبر شبكة Cloudflare.'
          : 'Strict EN/AR/FA hreflang parity, native RTL/LTR typography, and Cloudflare Edge delivery for global buyers.',
  },
  {
    href: `/${supportedLang}/enterprise-automation/`,
    badge: supportedLang === 'fa' ? 'اتوماسیون · ERP/CRM' : supportedLang === 'ar' ? 'أتمتة · ERP/CRM' : 'Middleware · ERP/CRM',
    title:
      supportedLang === 'fa'
        ? 'اتوماسیون سازمانی و یکپارچه‌سازی CRM و ERP'
        : supportedLang === 'ar'
          ? 'أتمتة المؤسسات وتكامل أنظمة CRM و ERP'
          : 'Enterprise Automation & Custom CRM/ERP Integration',
    desc:
      supportedLang === 'fa'
        ? 'اتصال دوطرفه سپیدار، راهکاران، Zoho و Salesforce به پورتال مشتریان B2B و صدور خودکار پیش‌فاکتور.'
        : supportedLang === 'ar'
          ? 'ربط ثنائي الاتجاه مع أنظمة المحاسبة وإدارة العملاء وبوابات الخدمة الذاتية للشركات.'
          : 'Bi-directional ERP/CRM sync, self-service B2B client portals, and resilient quote-to-invoice queues.',
  },
];

const servicesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: titleText,
  description: descriptionText,
  url: `https://webabc.ir/${supportedLang}/services/`,
  inLanguage: supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR',
  numberOfItems: servicesList.length + enterpriseSolutions.length,
  itemListElement: [
    ...servicesList.map((srv, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Service',
        name: srv.title,
        description: srv.desc,
        provider: { '@id': 'https://webabc.ir/#organization' },
        url: `https://webabc.ir/${supportedLang}/services/${srv.slug}/`,
      },
    })),
    ...enterpriseSolutions.map((ent, idx) => ({
      '@type': 'ListItem',
      position: servicesList.length + idx + 1,
      item: {
        '@type': 'Service',
        name: ent.title,
        description: ent.desc,
        provider: { '@id': 'https://webabc.ir/#organization' },
        url: `https://webabc.ir${ent.href}`,
      },
    })),
  ],
};

const breadcrumbs = [
  { label: t('common.home', { fallback: 'Home' }), url: `/${supportedLang}/` },
  { label: t('common.services', { fallback: 'Services' }) },
];

const faqList = [
  {
    question: t('services.faq.costQuestion', { fallback: 'How much do your services cost?' }),
    answer: t('services.faq.costAnswer', { fallback: '' }),
  },
  {
    question: t('services.faq.timelineQuestion', { fallback: 'What is the project timeline?' }),
    answer: t('services.faq.timelineAnswer', { fallback: '' }),
  },
  {
    question: t('services.faq.wordpressQuestion', { fallback: 'Do you build on WordPress?' }),
    answer: t('services.faq.wordpressAnswer', { fallback: '' }),
  },
  {
    question: t('services.faq.multilingualQuestion', {
      fallback: 'Do you support multi-language?',
    }),
    answer: t('services.faq.multilingualAnswer', { fallback: '' }),
  },
].filter((item) => item.question && item.answer);
---

<Layout title={titleText} description={descriptionText} lang={supportedLang} slug="services">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(servicesSchema)} />

  <Hero
    title={titleText}
    description={descriptionText}
    breadcrumbs={breadcrumbs}
    lang={supportedLang}
  >
    <!-- Quick navigation links slot -->
    <div class={`mt-8 flex flex-wrap justify-center gap-3 ${fontClass}`}>
      <a
        href={`/${supportedLang}/services/seo/`}
        class="rounded-full bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700 transition-colors hover:bg-blue-100 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:bg-blue-950/60 dark:text-blue-300 dark:hover:bg-blue-900/60"
      >
        {t('seo.title', { fallback: 'SEO' })}
      </a>
      <a
        href={`/${supportedLang}/services/web-design/`}
        class="rounded-full bg-sky-50 px-4 py-2 text-sm font-semibold text-sky-700 transition-colors hover:bg-sky-100 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:bg-sky-950/60 dark:text-sky-300 dark:hover:bg-sky-900/60"
      >
        {t('services.webDesignTitle', { fallback: 'Web Design' })}
      </a>
      <a
        href={`/${supportedLang}/services/web-development/`}
        class="rounded-full bg-green-50 px-4 py-2 text-sm font-semibold text-green-700 transition-colors hover:bg-green-100 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:bg-green-950/60 dark:text-green-300 dark:hover:bg-green-900/60"
      >
        {t('services.webDevelopment', { fallback: 'Web Development' })}
      </a>
      <a
        href={`/${supportedLang}/services/wordpress-development/`}
        class="rounded-full bg-purple-50 px-4 py-2 text-sm font-semibold text-purple-700 transition-colors hover:bg-purple-100 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:bg-purple-950/60 dark:text-purple-300 dark:hover:bg-purple-900/60"
      >
        {t('wordpress.wordpressAndWoocommerce', { fallback: 'WordPress' })}
      </a>
      <a
        href={`/${supportedLang}/services/local-seo/`}
        class="rounded-full bg-red-50 px-4 py-2 text-sm font-semibold text-red-700 transition-colors hover:bg-red-100 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:bg-red-950/60 dark:text-red-300 dark:hover:bg-red-900/60"
      >
        {t('seo.localSeo', { fallback: 'Local SEO' })}
      </a>
      <a
        href={`/${supportedLang}/tools/cost-calculator/`}
        class="rounded-full border border-primary/30 bg-primary/10 px-4 py-2 text-sm font-bold text-primary transition-colors hover:bg-primary hover:text-primary-foreground focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
      >
        {supportedLang === 'fa'
          ? 'ماشین‌حساب آنلاین هزینه'
          : supportedLang === 'ar'
            ? 'حاسبة تكلفة المشروع'
            : 'Cost Calculator'}
      </a>
    </div>
  </Hero>

  <!-- AEO Quick Answer Capsule for Services Hub -->
  <section class={`bg-white pt-10 pb-4 dark:bg-slate-950 ${fontClass}`}>
    <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="aeo-quick-answer mx-auto max-w-4xl rounded-2xl border border-primary/25 bg-linear-to-br from-primary/5 via-primary/[0.02] to-transparent p-6 sm:p-7 shadow-xs dark:border-primary/30 dark:bg-slate-900/60">
        <div class="mb-2.5 flex items-center gap-2">
          <span class="flex h-2 w-2 rounded-full bg-primary animate-pulse"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-primary">
            {supportedLang === 'fa'
              ? 'خلاصه خدمات و تخصص مهندسی وب اِی‌بی‌سی (AEO)'
              : supportedLang === 'ar'
                ? 'ملخص الخدمات والحلول الهندسية (AEO)'
                : 'Quick Answer: WebABC Service Scope (AEO Capsule)'}
          </span>
        </div>
        <p class="text-sm sm:text-base leading-relaxed text-gray-800 dark:text-gray-100 font-medium">
          {supportedLang === 'fa'
            ? 'وب اِی‌بی‌سی (ويب سي) ۱۱ خدمت تخصصی طراحی و مهندسی وب (Astro، Next.js، وردپرس اختصاصی و فروشگاه اینترنتی)، سئو تکنیکال، سئو محلی (گوگل مپ، نشان و بلد)، بهینه‌سازی سرعت Core Web Vitals و بهینه‌سازی موتورهای هوش مصنوعی (AEO/GEO) را به همراه ۳ راهکار سازمانی B2B، صادراتی و اتوماسیون ERP/CRM با قرارداد شفاف و بدون قفل بلندمدت ارائه می‌دهد.'
            : supportedLang === 'ar'
              ? 'تقدم وكالة ويب إيه بي سي (ويب سي) 11 خدمة رقمية متكاملة تشمل هندسة المواقع المخصصة (Astro وNext.js وووردبريس)، المتاجر الإلكترونية، السيو التقني والمحلي، تسريع مؤشرات Core Web Vitals، وتحسين محركات الإجابة الذكية (AEO/GEO)، إضافة إلى 3 مسارات مؤسسية للمصانع والتصدير وأتمتة أنظمة ERP/CRM.'
              : 'WebABC delivers 11 core web engineering and search growth services — spanning custom Astro/React development, bespoke WordPress & WooCommerce builds, technical SEO, Local 3-Pack optimization, Core Web Vitals remediation, UI/UX audits, and AEO/GEO citation architecture — alongside 3 enterprise B2B, multilingual export, and ERP/CRM automation tracks.'}
        </p>
      </div>
    </div>
  </section>

  <!-- 11 Core Services Grid -->
  <section class={`bg-white py-14 dark:bg-slate-950 ${fontClass}`}>
    <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          servicesList.map((service) => (
            <div class="group flex flex-col justify-between space-y-6 rounded-2xl border border-gray-100 bg-white p-8 shadow-xs transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/30 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900">
              <div class="space-y-4">
                <div
                  class={`flex h-12 w-12 items-center justify-center rounded-xl border shadow-xs transition-transform duration-300 group-hover:scale-105 ${service.color}`}
                >
                  {service.icon === 'seo' && (
                    <svg aria-hidden="true" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <circle cx="12" cy="12" r="10" />
                      <line x1="2" y1="12" x2="22" y2="12" />
                      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                    </svg>
                  )}
                  {service.icon === 'web-design' && (
                    <svg aria-hidden="true" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <rect x="3" y="3" width="18" height="18" rx="2" />
                      <path d="M3 9h18M9 21V9" />
                    </svg>
                  )}
                  {service.icon === 'web-dev' && (
                    <svg aria-hidden="true" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <polygon points="12 2 2 7 12 12 22 7 12 2" />
                      <polyline points="2 17 12 22 22 17" />
                      <polyline points="2 12 12 17 22 12" />
                    </svg>
                  )}
                  {service.icon === 'wordpress' && (
                    <svg aria-hidden="true" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Z" />
                      <path d="M18 14h-8" />
                      <path d="M15 18h-5" />
                      <rect x="10" y="6" width="8" height="4" rx="1" />
                    </svg>
                  )}
                  {service.icon === 'local-seo' && (
                    <svg aria-hidden="true" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                      <circle cx="12" cy="10" r="3" />
                    </svg>
                  )}
                  {service.icon === 'maintenance' && (
                    <svg aria-hidden="true" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                      <polyline points="9 11 11 13 15 9" />
                    </svg>
                  )}
                  {service.icon === 'speed' && (
                    <svg aria-hidden="true" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                    </svg>
                  )}
                  {service.icon === 'content' && (
                    <svg aria-hidden="true" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                      <polyline points="14 2 14 8 20 8" />
                      <line x1="16" y1="13" x2="8" y2="13" />
                      <line x1="16" y1="17" x2="8" y2="17" />
                    </svg>
                  )}
                  {service.icon === 'links' && (
                    <svg aria-hidden="true" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                    </svg>
                  )}
                  {service.icon === 'ui-ux' && (
                    <svg aria-hidden="true" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <circle cx="11" cy="11" r="8" />
                      <line x1="21" y1="21" x2="16.65" y2="16.65" />
                    </svg>
                  )}
                  {service.icon === 'ecommerce' && (
                    <svg aria-hidden="true" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <circle cx="9" cy="21" r="1" />
                      <circle cx="20" cy="21" r="1" />
                      <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                    </svg>
                  )}
                </div>

                <h2 class="text-xl font-bold text-gray-900 dark:text-white">
                  <a
                    href={`/${supportedLang}/services/${service.slug}/`}
                    class="transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                  >
                    {service.title}
                  </a>
                </h2>
                <p class="line-clamp-3 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                  {service.desc}
                </p>

                <ul class="space-y-2.5 pt-2">
                  {service.features.map((feat) => (
                    <li class="flex items-center gap-2 text-xs text-gray-700 dark:text-gray-300">
                      <svg
                        aria-hidden="true"
                        class="h-3.5 w-3.5 shrink-0 text-emerald-500"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        viewBox="0 0 24 24"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <a
                href={`/${supportedLang}/services/${service.slug}/`}
                class={`mt-4 inline-flex items-center gap-1.5 self-start text-sm font-bold text-primary ${isRtl ? 'group-hover:-translate-x-0.5' : 'group-hover:translate-x-0.5'} transition-transform focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 rounded-sm`}
              >
                <span>{t('common.viewDetails', { fallback: 'Explore Service' })}</span>
                <span aria-hidden="true">{isRtl ? '←' : '→'}</span>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- B2B & Enterprise Specialized Solutions -->
  <section class={`border-t border-gray-100 bg-gray-50/60 py-16 dark:border-slate-800 dark:bg-slate-900/40 ${fontClass}`}>
    <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/10 px-3.5 py-1 text-xs font-bold text-primary">
          <span class="h-1.5 w-1.5 rounded-full bg-primary animate-pulse"></span>
          {supportedLang === 'fa'
            ? 'راهکارهای سازمانی و صنعتی B2B'
            : supportedLang === 'ar'
              ? 'حلول المؤسسات والمصانع B2B'
              : 'Enterprise & B2B Vertical Solutions'}
        </span>
        <h2 class="mt-3 text-2xl font-extrabold tracking-tight text-gray-900 sm:text-3xl dark:text-white">
          {supportedLang === 'fa'
            ? 'مهندسی وب برای کارخانجات، صادرکنندگان و سازمان‌ها'
            : supportedLang === 'ar'
              ? 'هندسة منصات متخصصة للمصانع والمصدرين والمؤسسات'
              : 'Purpose-Built Platforms for Manufacturers, Exporters & Enterprises'}
        </h2>
      </div>

      <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        {
          enterpriseSolutions.map((ent) => (
            <a
              href={ent.href}
              class="group flex flex-col justify-between rounded-2xl border border-gray-200/80 bg-white p-7 shadow-xs transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900"
            >
              <div class="space-y-3">
                <span class="inline-flex rounded-full border border-primary/20 bg-primary/5 px-3 py-0.5 text-xs font-bold text-primary">
                  {ent.badge}
                </span>
                <h3 class="text-lg font-bold text-gray-900 transition-colors group-hover:text-primary dark:text-white">
                  {ent.title}
                </h3>
                <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                  {ent.desc}
                </p>
              </div>
              <div class="mt-6 flex items-center gap-1.5 border-t border-gray-100 pt-4 text-sm font-bold text-primary dark:border-slate-800">
                <span>{t('common.viewDetails', { fallback: 'View Architecture' })}</span>
                <span aria-hidden="true">{isRtl ? '←' : '→'}</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  {
    faqList.length > 0 && (
      <section class={`border-y border-gray-100 bg-white py-16 dark:border-slate-800 dark:bg-slate-950 ${fontClass}`}>
        <div class="container mx-auto max-w-4xl px-4">
          <FAQ faqList={faqList} lang={supportedLang} />
        </div>
      </section>
    )
  }

  <!-- Consultation CTA -->
  <section class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <CTA
      lang={supportedLang}
      title={t('services.ctaTitle', { fallback: 'Ready to Scale Your Search Visibility & Conversions?' })}
      description={t('services.ctaDescription', {
        fallback: 'Speak directly with our engineering and SEO leads for a scoped project roadmap.',
      })}
      buttonText={t('common.contactUs', { fallback: 'Contact Us' })}
    />
  </section>
</Layout>
