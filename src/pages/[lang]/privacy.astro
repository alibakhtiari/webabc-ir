---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/astro/Breadcrumbs.astro';
import { getLanguageStaticPaths, type SupportedLanguage } from '@/types/language';
import { getDictionary } from '@/i18n/get-dictionary';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);

const isRtl = supportedLang === 'fa' || supportedLang === 'ar';
const fontClass =
  supportedLang === 'en' ? 'font-sans' : supportedLang === 'ar' ? 'font-arabic' : 'font-persian';

const privacy = dictionary.privacyPolicy || {
  title: 'Privacy Policy',
  introduction: 'This privacy policy governs your use of this application.',
  lastUpdated: 'Last Updated:',
  dataCollection: {
    title: 'Information We Collect',
    content: 'We collect relevant details to optimize user interface speeds.',
  },
  dataUsage: {
    title: 'How We Use Information',
    content: 'Details are processed purely client side.',
  },
  thirdPartySharing: { title: 'Third Party Sharing', content: 'We do not sell user data.' },
  dataRetentionAndDeletion: {
    title: 'Retention and Deletion',
    content: 'All logs are processed client side.',
  },
  cookieUsage: { title: 'Cookie Usage', content: 'We employ cookies for analytics.' },
  contactInformation: { title: 'Contact Details', content: 'Get in touch with the team.' },
};

const renderContent = (content: string) => {
  return content.split('\n').map((line) => {
    const parts = line.split(/(\*\*.*?\*\*)/g);
    return parts
      .map((part) => {
        if (part.startsWith('**') && part.endsWith('**')) {
          return `<strong>${part.slice(2, -2)}</strong>`;
        }
        return part;
      })
      .join('');
  });
};

const breadcrumbs = [
  { label: dictionary.common?.home || 'Home', url: `/${supportedLang}/` },
  { label: privacy.title },
];
---

<Layout
  title={privacy.title}
  description={privacy.introduction.substring(0, 160)}
  lang={supportedLang}
  slug="privacy"
>
  <div class={`min-h-screen bg-[var(--bg-canvas)] py-12 md:py-16 pt-32 ${fontClass}`}>
    <div class="container mx-auto max-w-4xl px-4 space-y-6">
      <Breadcrumbs items={breadcrumbs} lang={supportedLang} />

      <div class="terminal-window">
        <div class="terminal-chrome-bar" dir="ltr">
          <span class="slash-eyebrow text-xs">/LEGAL-PRIVACY · COMPLIANCE & DATA INTEGRITY</span>
          <span class="monospace-telemetry-pill">POLICY: ACTIVE</span>
        </div>
        <div class="p-6 md:p-10 space-y-8">
          <div class="border-b border-[var(--border-hairline)] pb-6">
            <h1 class="text-2xl md:text-3xl font-extrabold text-[var(--text-primary)] tracking-tight">
              {privacy.title}
            </h1>
            <p class="mt-1 font-mono text-xs text-[var(--text-muted)]">
              {privacy.lastUpdated}
              {new Date('2026-08-07T00:00:00Z').toLocaleDateString(supportedLang, { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
            <p class="mt-4 text-sm text-[var(--text-secondary)] leading-relaxed">
              {privacy.introduction}
            </p>
          </div>

          <!-- Privacy sections styled with terminal accents -->
          <div class="space-y-8 text-[var(--text-secondary)]">
            <section class="space-y-3">
              <h2 class="text-lg md:text-xl font-bold text-[var(--text-primary)]">
                {privacy.dataCollection.title}
              </h2>
              <div class="space-y-2 text-sm leading-relaxed text-[var(--text-secondary)] [&_strong]:text-[var(--text-primary)]">
                {renderContent(privacy.dataCollection.content).map((paragraph) => (
                  <p set:html={paragraph} />
                ))}
              </div>
            </section>

            <section class="space-y-3">
              <h2 class="text-lg md:text-xl font-bold text-[var(--text-primary)]">
                {privacy.dataUsage.title}
              </h2>
              <div class="space-y-2 text-sm leading-relaxed text-[var(--text-secondary)] [&_strong]:text-[var(--text-primary)]">
                {renderContent(privacy.dataUsage.content).map((paragraph) => (
                  <p set:html={paragraph} />
                ))}
              </div>
            </section>

            <section class="space-y-3">
              <h2 class="text-lg md:text-xl font-bold text-[var(--text-primary)]">
                {privacy.thirdPartySharing.title}
              </h2>
              <div class="space-y-2 text-sm leading-relaxed text-[var(--text-secondary)] [&_strong]:text-[var(--text-primary)]">
                {renderContent(privacy.thirdPartySharing.content).map((paragraph) => (
                  <p set:html={paragraph} />
                ))}
              </div>
            </section>

            <section class="space-y-3">
              <h2 class="text-lg md:text-xl font-bold text-[var(--text-primary)]">
                {privacy.dataRetentionAndDeletion.title}
              </h2>
              <div class="space-y-2 text-sm leading-relaxed text-[var(--text-secondary)] [&_strong]:text-[var(--text-primary)]">
                {renderContent(privacy.dataRetentionAndDeletion.content).map((paragraph) => (
                  <p set:html={paragraph} />
                ))}
              </div>
            </section>

            <section class="space-y-3">
              <h2 class="text-lg md:text-xl font-bold text-[var(--text-primary)]">
                {privacy.cookieUsage.title}
              </h2>
              <div class="space-y-2 text-sm leading-relaxed text-[var(--text-secondary)] [&_strong]:text-[var(--text-primary)]">
                {renderContent(privacy.cookieUsage.content).map((paragraph) => (
                  <p set:html={paragraph} />
                ))}
              </div>
            </section>

            <section class="space-y-3">
              <h2 class="text-lg md:text-xl font-bold text-[var(--text-primary)]">
                {privacy.contactInformation.title}
              </h2>
              <div class="space-y-2 text-sm leading-relaxed text-[var(--text-secondary)] [&_strong]:text-[var(--text-primary)]">
                {renderContent(privacy.contactInformation.content).map((paragraph) => (
                  <p set:html={paragraph} />
                ))}
              </div>
            </section>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
