---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/astro/Hero.astro';
import CTA from '@/components/astro/CTA.astro';
import FAQ from '@/components/astro/FAQ.astro';
import { type SupportedLanguage, languages } from '@/types/language';
import { getDictionary } from '@/i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export async function getStaticPaths() {
  const locations = ['dubai', 'tehran', 'muscat', 'qazvin', 'abu-dhabi', 'riyadh'];
  const params = [];
  for (const lang of Object.keys(languages)) {
    for (const slug of locations) {
      params.push({
        params: { lang, slug },
      });
    }
  }
  return params;
}

const { lang, slug } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);

// Helper to translate strings
const t = createTranslator(dictionary);

const serviceAreasData = dictionary['service-areas'] || {};
const locationsList = serviceAreasData.locations || [];
const locationInfo = locationsList.find((loc: any) => loc.slug === slug) || {};

if (!locationInfo.name) {
  return Astro.redirect(`/${supportedLang}/404`);
}

const titleText =
  locationInfo.title ||
  `${t('service-areas.titlePrefix', { fallback: 'SEO & Web Design Services in' })} ${locationInfo.name}`;
const descriptionText =
  locationInfo.description ||
  `We provide professional localized services in ${locationInfo.name} to help your organization rank organically and load rapidly.`;

const breadcrumbs = [
  { label: t('common.home'), url: `/${supportedLang}/` },
  {
    label: t('service-areas.title', { fallback: 'Service Areas' }),
    url: `/${supportedLang}/service-areas/`,
  },
  { label: locationInfo.name },
];

const faqList = [1, 2, 3]
  .map((n) => ({
    question: t(`service-areas.faq.q${n}`, { fallback: '' }),
    answer: t(`service-areas.faq.a${n}`, { fallback: '' }),
  }))
  .filter((item) => item.question && item.answer);

// Location-level FAQs (per-location `faqs` on the location object, added
// separately) merge into the global list. Guarded: no-op when absent. The
// <FAQ> component below builds the FAQPage JSON-LD from the merged list, so
// no second FAQPage block is emitted here.
const locationFaqs = (Array.isArray(locationInfo.faqs) ? locationInfo.faqs : []).filter(
  (f: any) => f?.question && f?.answer
);
const allFaqs = [...faqList, ...locationFaqs];

// City coords for GeoCoordinates. Country stays an ISO code (lang-neutral);
// locality/country display names keep coming from localized locationInfo.
const LOCATION_GEO: Record<string, { latitude: number; longitude: number; countryCode: string }> = {
  qazvin: { latitude: 36.27, longitude: 50.0, countryCode: 'IR' },
  tehran: { latitude: 35.69, longitude: 51.39, countryCode: 'IR' },
  muscat: { latitude: 23.59, longitude: 58.54, countryCode: 'OM' },
  dubai: { latitude: 25.2, longitude: 55.27, countryCode: 'AE' },
  'abu-dhabi': { latitude: 24.45, longitude: 54.38, countryCode: 'AE' },
  riyadh: { latitude: 24.71, longitude: 46.68, countryCode: 'SA' },
};
const locationGeo = LOCATION_GEO[slug];

const origin = 'https://webabc.ir';
const locationSchema = {
  '@context': 'https://schema.org',
  '@type': ['Service', 'ProfessionalService'],
  '@id': `${origin}/${supportedLang}/service-areas/${slug}/#service`,
  name: titleText,
  description: descriptionText,
  url: `${origin}/${supportedLang}/service-areas/${slug}/`,
  provider: {
    '@type': 'Organization',
    '@id': `${origin}/#organization`,
    name: 'WebABC',
    url: origin,
  },
  areaServed: {
    '@type': 'City',
    name: locationInfo.name,
    containedInPlace: locationInfo.country
      ? { '@type': 'Country', name: locationInfo.country }
      : undefined,
  },
  ...(locationGeo
    ? {
        geo: {
          '@type': 'GeoCoordinates',
          latitude: locationGeo.latitude,
          longitude: locationGeo.longitude,
        },
        address: {
          '@type': 'PostalAddress',
          addressLocality: locationInfo.name,
          addressCountry: locationGeo.countryCode,
        },
      }
    : {}),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `Web & SEO Services in ${locationInfo.name}`,
    itemListElement: (locationInfo.services || []).map((srv: string, idx: number) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: srv,
      },
      position: idx + 1,
    })),
  },
  inLanguage: supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR',
};

// The FAQPage JSON-LD for this list is emitted by the <FAQ> component itself
// (it builds its own schema from the merged list passed to it), so we
// intentionally do NOT emit a second FAQPage script here — two FAQPage blocks
// on one URL is duplicative.

// Internal Linking: Map localized service names to exact service pages
const getServiceLink = (srvName: string) => {
  const lower = srvName.toLowerCase();
  if (lower.includes('local seo') || lower.includes('سئو محلی') || lower.includes('السيو المحلي')) {
    return `/${supportedLang}/services/local-seo/`;
  }
  if (
    lower.includes('web design') ||
    lower.includes('طراحی سایت') ||
    lower.includes('تصميم المواقع')
  ) {
    return `/${supportedLang}/services/web-design/`;
  }
  if (lower.includes('e-commerce') || lower.includes('فروشگاه') || lower.includes('المتاجر')) {
    return `/${supportedLang}/services/ecommerce/`;
  }
  if (lower.includes('speed') || lower.includes('سرعت') || lower.includes('السرعة')) {
    return `/${supportedLang}/services/speed-optimization/`;
  }
  if (lower.includes('wordpress') || lower.includes('وردپرس') || lower.includes('ووردبريس')) {
    return `/${supportedLang}/services/wordpress-development/`;
  }
  if (lower.includes('seo') || lower.includes('سئو') || lower.includes('السيو')) {
    return `/${supportedLang}/services/seo/`;
  }
  return `/${supportedLang}/services/web-development/`;
};

// Internal Linking: Regional case studies and strategic pillar guides per service area
