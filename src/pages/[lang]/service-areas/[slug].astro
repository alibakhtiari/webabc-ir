---

<Layout
  title={titleText}
  description={descriptionText}
  lang={supportedLang}
  slug={`service-areas/${slug}`}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(locationSchema)} />
  <Hero
    title={titleText}
    description={descriptionText}
    breadcrumbs={breadcrumbs}
    lang={supportedLang}
  />

  <!-- Details and AEO Panel -->
  <section class="bg-white py-16 font-persian font-sans dark:bg-slate-950">
    <div class="container mx-auto max-w-5xl px-4">
      <div class="mb-12 grid grid-cols-1 gap-12 lg:grid-cols-3">
        <!-- Main Content Pane -->
        <div class="space-y-12 lg:col-span-2">
          <div class="space-y-4">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
              {t('service-areas.whyChooseUs', { fallback: 'Why Choose WebABC?' })}
            </h2>
            <p class="leading-relaxed text-gray-600 dark:text-gray-300">
              {locationInfo.longDescription}
            </p>
          </div>

          <!-- Services List -->
          {
            locationInfo.services && (
              <div class="space-y-6">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white">
                  {t('service-areas.locationTitle', { fallback: 'Services Offered' })}
                </h3>
                <div class="grid gap-4 sm:grid-cols-2">
                  {locationInfo.services.map((serv: string) => (
                    <a
                      href={getServiceLink(serv)}
                      class="group dark:hover:bg-slate-850 flex items-center justify-between rounded-xl border border-gray-100 bg-gray-50 p-4 transition-all hover:-translate-y-0.5 hover:border-primary/40 hover:bg-white hover:shadow-md dark:border-slate-800 dark:bg-slate-900 dark:hover:border-primary/40"
                    >
                      <div class="flex items-center gap-3">
                        <div class="rounded-lg bg-white p-1.5 text-primary shadow-xs transition-colors group-hover:bg-primary group-hover:text-white dark:bg-slate-800">
                          <svg
                            aria-hidden="true"
                            class="h-4 w-4"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M5 13l4 4L19 7"
                            />
                          </svg>
                        </div>
                        <span class="font-semibold text-gray-800 transition-colors group-hover:text-primary dark:text-gray-200">
                          {serv}
                        </span>
                      </div>
                      <span class="text-xs font-bold text-gray-400 transition-transform group-hover:translate-x-0.5 group-hover:text-primary rtl:group-hover:-translate-x-0.5">
                        {languages[supportedLang]?.direction === 'rtl' ? '←' : '→'}
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            )
          }

          <!-- Local Benefits -->
          {
            locationInfo.benefits && (
              <div class="space-y-6">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white">
                  {t('service-areas.whyChooseUs', { fallback: 'Key Regional Benefits' })}
                </h3>
                <ul class="space-y-3">
                  {locationInfo.benefits.map((benefit: string) => (
                    <li class="flex items-start gap-2.5">
                      <svg
                        aria-hidden="true"
                        class="mt-1 h-5 w-5 shrink-0 text-primary"
