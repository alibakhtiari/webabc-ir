---

<Layout
  title={titleText}
  description={descriptionText}
  lang={supportedLang}
  slug={`service-areas/${slug}`}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(locationSchema)} />
  <Hero
    title={titleText}
    description={descriptionText}
    breadcrumbs={breadcrumbs}
    lang={supportedLang}
  />

  <!-- Details and AEO Panel -->
  <section class={`bg-white py-16 ${fontClass} dark:bg-slate-950`}>
    <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- AEO Quick Answer Capsule -->
      <aside class="aeo-quick-answer mb-12 rounded-2xl border-s-4 border-primary bg-primary/5 p-6 dark:bg-slate-900/80">
        <div class="mb-1.5 text-xs font-bold uppercase tracking-wider text-primary">
          {supportedLang === 'fa' ? `خلاصه خدمات وب اِی‌بی‌سی در ${locationInfo.name}` : supportedLang === 'ar' ? `ملخص خدمات ويب إيه بي سي في ${locationInfo.name}` : `WebABC Regional Summary: ${locationInfo.name}`}
        </div>
        <p class="text-sm leading-relaxed font-medium text-gray-800 sm:text-base dark:text-gray-100">
          {descriptionText} {locationInfo.localNotes || ''}
        </p>
      </aside>

      <div class="mb-12 grid grid-cols-1 gap-12 lg:grid-cols-3">
        <!-- Main Content Pane -->
        <div class="space-y-12 lg:col-span-2">
          <div class="space-y-4">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
              {t('service-areas.whyChooseUs', { fallback: 'Why Choose WebABC?' })}
            </h2>
            <p class="leading-relaxed text-gray-600 dark:text-gray-300">
              {locationInfo.longDescription}
            </p>
          </div>

          <!-- Services List -->
          {
            locationInfo.services && (
              <div class="space-y-6">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white">
                  {t('service-areas.locationTitle', { fallback: 'Services Offered' })}
                </h3>
                <div class="grid gap-4 sm:grid-cols-2">
                  {locationInfo.services.map((serv: string) => (
                    <a
                      href={getServiceLink(serv)}
                      class="group flex items-center justify-between rounded-xl border border-gray-100 bg-gray-50 p-4 transition-colors hover:border-primary/40 hover:bg-white hover:shadow-md dark:border-slate-800 dark:bg-slate-900 dark:hover:border-primary/40"
                    >
                      <div class="flex items-center gap-3">
                        <div class="rounded-lg bg-white p-1.5 text-primary shadow-xs transition-colors group-hover:bg-primary group-hover:text-white dark:bg-slate-800">
                          <svg
                            aria-hidden="true"
                            class="h-4 w-4"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            viewBox="0 0 24 24"
                          >
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                          </svg>
                        </div>
                        <span class="font-semibold text-gray-800 transition-colors group-hover:text-primary dark:text-gray-200">
                          {serv}
                        </span>
                      </div>
                      <span class="text-xs font-bold text-gray-400 group-hover:text-primary" aria-hidden="true">
                        {languages[supportedLang]?.direction === 'rtl' ? '←' : '→'}
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            )
          }

          <!-- Local Benefits -->
          {
            locationInfo.benefits && (
              <div class="space-y-6">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white">
                  {t('service-areas.whyChooseUs', { fallback: 'Key Regional Benefits' })}
                </h3>
                <ul class="space-y-3">
                  {locationInfo.benefits.map((benefit: string) => (
                    <li class="flex items-start gap-2.5">
                      <svg
                        aria-hidden="true"
                        class="mt-1 h-5 w-5 shrink-0 text-primary"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                        />
                      </svg>
                      <span class="leading-relaxed text-gray-700 dark:text-gray-300">
                        {benefit}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>

        <!-- Quick Facts Side Panel -->
        <div class="space-y-8">
          <div
            class="space-y-4 rounded-2xl border border-gray-100 bg-gray-50 p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900"
          >
            <h3
              class="flex items-center gap-2 border-b border-gray-200 pb-3 text-lg font-bold text-gray-900 dark:border-slate-800 dark:text-white"
            >
              <svg aria-hidden="true" class="h-5 w-5 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-8-4.5-8-11a8 8 0 1116 0c0 6.5-8 11-8 11z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
              <span>{locationInfo.name}</span>
            </h3>
            <div class="space-y-4 text-sm">
              <div>
                <div class="text-xs font-semibold text-gray-500 uppercase dark:text-gray-400">
                  {t('service-areas.country', { fallback: 'Country' })}
                </div>
                <div class="font-bold text-gray-800 dark:text-gray-200">{locationInfo.country}</div>
              </div>
              <div>
                <div class="text-xs font-semibold text-gray-500 uppercase dark:text-gray-400">
                  {t('service-areas.serviceDelivery', { fallback: 'Service Delivery' })}
                </div>
                <div class="font-bold text-gray-800 dark:text-gray-200">
                  {
                    t('service-areas.serviceDeliveryValue', {
                      fallback: 'Remote delivery with on-site consultations available',
                    })
                  }
                </div>
              </div>
              <div>
                <div class="text-xs font-semibold text-gray-500 uppercase dark:text-gray-400">
                  {t('service-areas.languages', { fallback: 'Languages' })}
                </div>
                <div class="font-bold text-gray-800 dark:text-gray-200">
                  {t('service-areas.languagesValue', { fallback: 'English, Arabic, Persian' })}
                </div>
              </div>
            </div>
            <div class="pt-2">
              <a
                href={`/${supportedLang}/tools/cost-calculator/`}
                class="inline-flex w-full items-center justify-center rounded-xl bg-primary px-4 py-2.5 text-xs font-bold text-primary-foreground transition-colors hover:bg-primary/90"
              >
                {supportedLang === 'fa' ? 'محاسبه آنلاین هزینه پروژه' : supportedLang === 'ar' ? 'حاسبة تكلفة المشروع الفورية' : 'Estimate Project Cost Online'}
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Local Considerations -->
      {
        locationInfo.localNotes && (
          <div class="mx-auto mb-12 max-w-3xl space-y-4 text-center">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
              {t('service-areas.localConsiderations', { fallback: 'What Matters for This Market' })}
            </h2>
            <p class="leading-relaxed text-gray-600 dark:text-gray-300">
              {locationInfo.localNotes}
            </p>
          </div>
        )
      }

      <!-- FAQ Section -->
      {
        allFaqs.length > 0 && (
          <div class="mx-auto mb-12 max-w-3xl">
            <FAQ faqList={allFaqs} lang={supportedLang} />
          </div>
        )
      }

      <!-- Regional Case Studies & Actionable Guides -->
      <section aria-label="Regional Case Studies and Guides" class="my-16 space-y-8">
        <div class="border-b border-gray-200 pb-4 text-center dark:border-slate-800">
          <h2 class="text-2xl font-bold text-gray-900 md:text-3xl dark:text-white">
            {
              supportedLang === 'fa'
                ? `نمونه‌کارها و راهنماهای مرتبط با ${locationInfo.name}`
                : supportedLang === 'ar'
                  ? `دراسات الحالة والأدلة الموصى بها في ${locationInfo.name}`
                  : `Featured Case Studies & Guides for ${locationInfo.name}`
            }
          </h2>
          <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
            {
              supportedLang === 'fa'
                ? 'بررسی پروژه‌های موفق، سنجه‌های عملکردی و استراتژی‌های اختصاصی برای این بازار.'
                : supportedLang === 'ar'
                  ? 'استكشف المشاريع الرقمية الناجحة والبيانات التحليلية المناسبة لهذا السوق.'
                  : 'Verified client outcomes, performance benchmarks, and local search strategies.'
            }
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <!-- Case Studies Column -->
          {
            regionalData.caseStudies && regionalData.caseStudies.length > 0 && (
              <div class="space-y-4 rounded-3xl border border-gray-100 bg-gray-50/70 p-6 dark:border-slate-800 dark:bg-slate-900">
                <h3 class="flex items-center gap-2 text-base font-bold text-gray-900 dark:text-white">
                  <svg aria-hidden="true" class="h-5 w-5 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                  </svg>
                  <span>
                    {supportedLang === 'fa'
                      ? 'پروژه‌های اجرایی'
                      : supportedLang === 'ar'
                        ? 'مشاريع منفذة في السوق'
                        : 'Regional Case Studies'}
                  </span>
                </h3>
                <div class="space-y-3">
                  {regionalData.caseStudies.map((cs) => (
                    <a
                      href={`/${supportedLang}/portfolio/${cs.slug}/`}
                      class="group flex items-center justify-between rounded-2xl border border-gray-200/80 bg-white p-4 shadow-xs transition-colors hover:border-primary/40 hover:shadow-md dark:border-slate-700 dark:bg-slate-800"
                    >
                      <div>
                        <div class="font-bold text-gray-900 transition-colors group-hover:text-primary dark:text-white">
                          {cs.title}
                        </div>
                        <div class="mt-0.5 text-xs font-medium text-primary">{cs.metric}</div>
                      </div>
                      <span class="text-sm font-bold text-gray-400 group-hover:text-primary" aria-hidden="true">
                        {languages[supportedLang]?.direction === 'rtl' ? '←' : '→'}
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            )
          }

          <!-- Recommended Guides Column -->
          {
            regionalData.guides && regionalData.guides.length > 0 && (
              <div class="space-y-4 rounded-3xl border border-gray-100 bg-gray-50/70 p-6 dark:border-slate-800 dark:bg-slate-900">
                <h3 class="flex items-center gap-2 text-base font-bold text-gray-900 dark:text-white">
                  <svg aria-hidden="true" class="h-5 w-5 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                  </svg>
                  <span>
                    {supportedLang === 'fa'
                      ? 'راهنماهای تحلیلی'
                      : supportedLang === 'ar'
                        ? 'أدلة إرشادية'
                        : 'Recommended Guides'}
                  </span>
                </h3>
                <div class="space-y-3">
                  {regionalData.guides.map((g) => (
                    <a
                      href={`/${supportedLang}/blog/${g.slug}/`}
                      class="group flex items-center justify-between rounded-2xl border border-gray-200/80 bg-white p-4 shadow-xs transition-colors hover:border-primary/40 hover:shadow-md dark:border-slate-700 dark:bg-slate-800"
                    >
                      <div>
                        <div class="font-bold text-gray-900 transition-colors group-hover:text-primary dark:text-white">
                          {g.title}
                        </div>
                        <div class="mt-0.5 line-clamp-1 text-xs text-gray-500 dark:text-gray-400">
                          {g.desc}
                        </div>
                      </div>
                      <span class="text-sm font-bold text-gray-400 group-hover:text-primary" aria-hidden="true">
                        {languages[supportedLang]?.direction === 'rtl' ? '←' : '→'}
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            )
          }
        </div>
      </section>

      <!-- Related Service Areas -->
      {
        siblingAreas.length > 0 && (
          <nav
            aria-label={
              supportedLang === 'fa'
                ? 'سایر مناطق تحت پوشش'
                : supportedLang === 'ar'
                  ? 'مناطق خدمة أخرى'
                  : 'Other Service Areas'
            }
            class="my-16 space-y-6"
          >
            <div class="border-b border-gray-200 pb-4 text-center dark:border-slate-800">
              <h2 class="text-2xl font-bold text-gray-900 md:text-3xl dark:text-white">
                {supportedLang === 'fa'
                  ? 'سایر مناطق تحت پوشش WebABC'
                  : supportedLang === 'ar'
                    ? 'مناطق خدمة أخرى لـ WebABC'
                    : 'Other Areas Served by WebABC'}
              </h2>
              <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
                {supportedLang === 'fa'
                  ? 'خدمات طراحی سایت و سئو در سایر شهرها و بازارهای منطقه.'
                  : supportedLang === 'ar'
                    ? 'خدمات تصميم المواقع والسيو في مدن وأسواق أخرى بالمنطقة.'
                    : 'Web design & SEO services in our other cities and regional markets.'}
              </p>
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {siblingAreas.map((area: any) => (
                <a
                  href={`/${supportedLang}/service-areas/${area.slug}/`}
                  class="group flex items-center justify-between rounded-2xl border border-gray-200/80 bg-white p-4 shadow-xs transition-colors hover:border-primary/40 hover:shadow-md dark:border-slate-700 dark:bg-slate-800"
                >
                  <div>
                    <div class="font-bold text-gray-900 transition-colors group-hover:text-primary dark:text-white">
                      {area.name}
                    </div>
                    {area.country && (
                      <div class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">
                        {area.country}
                      </div>
                    )}
                  </div>
                  <span class="text-sm font-bold text-gray-400 group-hover:text-primary" aria-hidden="true">
                    {languages[supportedLang]?.direction === 'rtl' ? '←' : '→'}
                  </span>
                </a>
              ))}
            </div>
          </nav>
        )
      }

      <!-- Consultation CTA Callout -->
      <CTA
        lang={supportedLang}
        title={t('service-areas.ctaTitle', { fallback: 'Grow Your Regional Search Visibility' })}
        description={t('service-areas.ctaDescription', {
          fallback: 'Get a custom optimization blueprint tailored to your city.',
        })}
        buttonText={t('service-areas.ctaButton', { fallback: 'Get Started' })}
      />
    </div>
  </section>
</Layout>
