      {
        locationInfo.localNotes && (
          <div class="mx-auto mb-12 max-w-3xl space-y-4 text-center">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
              {t('service-areas.localConsiderations', { fallback: 'What Matters for This Market' })}
            </h2>
            <p class="leading-relaxed text-gray-600 dark:text-gray-300">
              {locationInfo.localNotes}
            </p>
          </div>
        )
      }

      <!-- FAQ Section -->
      {
        allFaqs.length > 0 && (
          <div class="mx-auto mb-12 max-w-3xl">
            <FAQ faqList={allFaqs} lang={supportedLang} />
          </div>
        )
      }

      <!-- Regional Case Studies & Actionable Guides -->
      <section aria-label="Regional Case Studies and Guides" class="my-16 space-y-8">
        <div class="border-b border-gray-200 pb-4 text-center dark:border-slate-800">
          <h2 class="text-2xl font-bold text-gray-900 md:text-3xl dark:text-white">
            {
              supportedLang === 'fa'
                ? `نمونه‌کارها و راهنماهای مرتبط با ${locationInfo.name}`
                : supportedLang === 'ar'
                  ? `دراسات الحالة والأدلة الموصى بها في ${locationInfo.name}`
                  : `Featured Case Studies & Guides for ${locationInfo.name}`
            }
          </h2>
          <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
            {
              supportedLang === 'fa'
                ? 'بررسی پروژه‌های موفق، سنجه‌های عملکردی و استراتژی‌های اختصاصی برای این بازار.'
                : supportedLang === 'ar'
                  ? 'استكشف المشاريع الرقمية الناجحة والبيانات التحليلية المناسبة لهذا السوق.'
                  : 'Proven client outcomes, performance benchmarks, and local search strategies.'
            }
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <!-- Case Studies Column -->
          {
            regionalData.caseStudies && regionalData.caseStudies.length > 0 && (
              <div class="space-y-4 rounded-3xl border border-gray-100 bg-gray-50/70 p-6 dark:border-slate-800 dark:bg-slate-900">
                <h3 class="flex items-center gap-2 text-base font-bold text-gray-900 dark:text-white">
                  <span>🏆</span>
                  <span>
                    {supportedLang === 'fa'
                      ? 'پروژه‌های اجرایی'
                      : supportedLang === 'ar'
                        ? 'مشاريع منفذة في السوق'
                        : 'Regional Case Studies'}
                  </span>
                </h3>
                <div class="space-y-3">
                  {regionalData.caseStudies.map((cs) => (
                    <a
                      href={`/${supportedLang}/portfolio/${cs.slug}/`}
                      class="group flex items-center justify-between rounded-2xl border border-gray-200/80 bg-white p-4 shadow-xs transition-all hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md dark:border-slate-700 dark:bg-slate-800"
                    >
                      <div>
                        <div class="font-bold text-gray-900 transition-colors group-hover:text-primary dark:text-white">
                          {cs.title}
                        </div>
                        <div class="mt-0.5 text-xs font-medium text-primary">{cs.metric}</div>
                      </div>
                      <span class="text-sm font-bold text-gray-400 transition-transform group-hover:translate-x-0.5 group-hover:text-primary rtl:group-hover:-translate-x-0.5">
                        {languages[supportedLang]?.direction === 'rtl' ? '←' : '→'}
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            )
          }

          <!-- Recommended Guides Column -->
          {
            regionalData.guides && regionalData.guides.length > 0 && (
              <div class="space-y-4 rounded-3xl border border-gray-100 bg-gray-50/70 p-6 dark:border-slate-800 dark:bg-slate-900">
                <h3 class="flex items-center gap-2 text-base font-bold text-gray-900 dark:text-white">
                  <span>📚</span>
                  <span>
                    {supportedLang === 'fa'
                      ? 'راهنماهای تحلیلی'
                      : supportedLang === 'ar'
                        ? 'أدلة إرشادية'
                        : 'Recommended Guides'}
                  </span>
                </h3>
                <div class="space-y-3">
                  {regionalData.guides.map((g) => (
                    <a
                      href={`/${supportedLang}/blog/${g.slug}/`}
                      class="group flex items-center justify-between rounded-2xl border border-gray-200/80 bg-white p-4 shadow-xs transition-all hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md dark:border-slate-700 dark:bg-slate-800"
                    >
                      <div>
                        <div class="font-bold text-gray-900 transition-colors group-hover:text-primary dark:text-white">
                          {g.title}
                        </div>
                        <div class="mt-0.5 line-clamp-1 text-xs text-gray-500 dark:text-gray-400">
                          {g.desc}
                        </div>
                      </div>
                      <span class="text-sm font-bold text-gray-400 transition-transform group-hover:translate-x-0.5 group-hover:text-primary rtl:group-hover:-translate-x-0.5">
                        {languages[supportedLang]?.direction === 'rtl' ? '←' : '→'}
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            )
          }
        </div>
      </section>

      <!-- Related Service Areas (sibling markets, structural cross-linking) -->
      {
        siblingAreas.length > 0 && (
          <nav
            aria-label={
              supportedLang === 'fa'
                ? 'سایر مناطق تحت پوشش'
                : supportedLang === 'ar'
                  ? 'مناطق خدمة أخرى'
                  : 'Other Service Areas'
            }
            class="my-16 space-y-6"
          >
            <div class="border-b border-gray-200 pb-4 text-center dark:border-slate-800">
              <h2 class="text-2xl font-bold text-gray-900 md:text-3xl dark:text-white">
                {supportedLang === 'fa'
                  ? 'سایر مناطق تحت پوشش WebABC'
                  : supportedLang === 'ar'
                    ? 'مناطق خدمة أخرى لـ WebABC'
                    : 'Other Areas Served by WebABC'}
              </h2>
              <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
                {supportedLang === 'fa'
                  ? 'خدمات طراحی سایت و سئو در سایر شهرها و بازارهای منطقه.'
                  : supportedLang === 'ar'
                    ? 'خدمات تصميم المواقع والسيو في مدن وأسواق أخرى بالمنطقة.'
                    : 'Web design & SEO services in our other cities and regional markets.'}
              </p>
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {siblingAreas.map((area: any) => (
                <a
                  href={`/${supportedLang}/service-areas/${area.slug}/`}
                  class="group flex items-center justify-between rounded-2xl border border-gray-200/80 bg-white p-4 shadow-xs transition-all hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md dark:border-slate-700 dark:bg-slate-800"
                >
                  <div>
                    <div class="font-bold text-gray-900 transition-colors group-hover:text-primary dark:text-white">
                      {area.name}
                    </div>
                    {area.country && (
                      <div class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">
                        {area.country}
                      </div>
                    )}
                  </div>
                  <span class="text-sm font-bold text-gray-400 transition-transform group-hover:translate-x-0.5 group-hover:text-primary rtl:group-hover:-translate-x-0.5">
                    {languages[supportedLang]?.direction === 'rtl' ? '←' : '→'}
                  </span>
                </a>
              ))}
            </div>
          </nav>
        )
      }

      <!-- Premium Consultation CTA Callout -->
      <CTA
        lang={supportedLang}
        title={t('service-areas.ctaTitle', { fallback: 'Dominate Local Search' })}
        description={t('service-areas.ctaDescription', {
          fallback: 'Get a custom optimization blueprint outline.',
        })}
        buttonText={t('service-areas.ctaButton', { fallback: 'Get Started' })}
      />
    </div>
  </section>
</Layout>
