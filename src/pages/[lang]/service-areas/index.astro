---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/astro/Breadcrumbs.astro';
import { type SupportedLanguage } from '../../../types/language';
import { getDictionary } from '../../../i18n/get-dictionary';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'fa' } },
    { params: { lang: 'ar' } },
  ];
}

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);

// Helper to translate strings
const t = (key: string, options?: { fallback: string }) => {
  const parts = key.split('.');
  let current: any = dictionary;
  for (const part of parts) {
    if (current && current[part] !== undefined) {
      current = current[part];
    } else {
      return options?.fallback || key;
    }
  }
  return typeof current === 'string' ? current : options?.fallback || key;
};

const titleText = t('service-areas.title', { fallback: 'Our Service Areas' });
const descriptionText = t('service-areas.description', { fallback: 'We serve clients across multiple cities in the Middle East.' });

const locations = ['dubai', 'tehran', 'muscat', 'qazvin'];

const breadcrumbs = [
  { label: t('common.home'), url: `/${supportedLang}` },
  { label: t('common.serviceAreas') }
];
---

<Layout title={titleText} description={descriptionText} lang={supportedLang} slug="service-areas">
  <main class="grow w-full overflow-x-hidden bg-gray-50/50 pt-0 pb-20">
    <!-- Hero Section -->
    <section class="bg-linear-to-b from-primary/5 to-white pt-36 pb-16 md:pb-24">
      <div class="container mx-auto px-4 max-w-4xl text-center">
          <Breadcrumbs items={breadcrumbs} lang={supportedLang} centered={true} />
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 leading-normal font-persian">{titleText}</h1>
        <p class="text-xl text-gray-600 font-persian leading-relaxed">{descriptionText}</p>
      </div>
    </section>

    <!-- Locations list -->
    <section class="py-16 bg-white font-sans">
      <div class="container mx-auto px-4 max-w-4xl">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {locations.map(loc => (
            <div class="bg-white border border-gray-100 rounded-2xl p-8 shadow-xs hover:shadow-lg transition-all space-y-4 font-persian">
              <h3 class="text-2xl font-bold text-gray-900 uppercase">{loc}</h3>
              <p class="text-gray-500 text-sm">
                Providing localized high-performance web development and customized SEO campaigns.
              </p>
              <a href={`/${supportedLang}/service-areas/${loc}`} class="text-primary font-bold text-sm inline-flex items-center gap-1">
                {t('common.viewDetails', { fallback: 'View Details' })} &rarr;
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
