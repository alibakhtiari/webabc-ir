---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/astro/Breadcrumbs.astro';
import { getLanguageStaticPaths, type SupportedLanguage } from '@/types/language';
import { getDictionary } from '@/i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);
const isRtl = supportedLang === 'fa' || supportedLang === 'ar';

// Helper to translate strings
const t = createTranslator(dictionary);

const titleText = t('service-areas.title', { fallback: 'Our Service Areas' });
const descriptionText = t('service-areas.description', {
  fallback: 'We serve clients across multiple cities in the Middle East.',
});

const serviceAreasData = dictionary['service-areas'] || {};
const locationsList = Array.isArray(serviceAreasData.locations) ? serviceAreasData.locations : [];

const breadcrumbs = [
  { label: t('common.home'), url: `/${supportedLang}/` },
  { label: t('common.serviceAreas') },
];
---

<Layout title={titleText} description={descriptionText} lang={supportedLang} slug="service-areas">
  <!-- Hero Section -->
  <section class="bg-linear-to-b from-primary/10 via-background to-background pt-36 pb-16 md:pb-24">
    <div class="container mx-auto max-w-4xl px-4 text-center">
      <Breadcrumbs items={breadcrumbs} lang={supportedLang} centered={true} />
      <h1
        class={`text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6 leading-normal font-${supportedLang === 'en' ? 'sans' : 'persian'}`}
      >
        {titleText}
      </h1>
      <p
        class={`text-xl text-gray-600 dark:text-gray-300 leading-relaxed font-${supportedLang === 'en' ? 'sans' : 'persian'}`}
      >
        {descriptionText}
      </p>
    </div>
  </section>

  <!-- Locations list -->
  <section class="bg-white py-16 font-sans dark:bg-slate-950">
    <div class="container mx-auto max-w-4xl px-4">
      <h2
        class={`text-2xl font-bold text-gray-900 dark:text-white mb-8 text-center font-${supportedLang === 'en' ? 'sans' : 'persian'}`}
      >
        {
          supportedLang === 'fa'
            ? 'مناطق تحت پوشش خدمات وب‌اِی‌بی‌سی'
            : supportedLang === 'ar'
              ? 'المناطق الجغرافية لخدماتنا'
              : 'Explore Our Service Locations'
        }
      </h2>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {
          locationsList.map((loc: any) => (
            <div
              class={`space-y-4 rounded-2xl border border-gray-100 bg-white p-8 shadow-xs transition-all hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 font-${supportedLang === 'en' ? 'sans' : 'persian'}`}
            >
              <div class="flex items-center justify-between">
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white">{loc.name}</h3>
                {loc.country && (
                  <span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-semibold text-primary">
                    {loc.country}
                  </span>
                )}
              </div>
              <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                {loc.description}
              </p>
              <a
                href={`/${supportedLang}/service-areas/${loc.slug}/`}
                class="inline-flex items-center gap-1 text-sm font-bold text-primary hover:underline"
              >
                {t('common.viewDetails', { fallback: 'View Details' })} {isRtl ? '←' : '→'}
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
