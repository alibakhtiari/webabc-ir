---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/astro/Hero.astro';
import CTA from '@/components/astro/CTA.astro';
import AsciiStage from '@/components/astro/AsciiStage.astro';
import { getLanguageStaticPaths, type SupportedLanguage } from '@/types/language';
import { getDictionary } from '@/i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);
const isRtl = supportedLang === 'fa' || supportedLang === 'ar';
const fontClass =
  supportedLang === 'en' ? 'font-sans' : supportedLang === 'ar' ? 'font-arabic' : 'font-persian';

const t = createTranslator(dictionary);

const titleText = t('service-areas.title', { fallback: 'Our Service Areas' });
const descriptionText = t('service-areas.description', {
  fallback: 'We serve clients across multiple cities in the Middle East.',
});

const serviceAreasData = dictionary['service-areas'] || {};
const locationsList = Array.isArray(serviceAreasData.locations) ? serviceAreasData.locations : [];

const breadcrumbs = [
  { label: t('common.home'), url: `/${supportedLang}/` },
  { label: t('common.serviceAreas') },
];
---

<Layout title={titleText} description={descriptionText} lang={supportedLang} slug="service-areas">
  <Hero
    title={titleText}
    description={descriptionText}
    breadcrumbs={breadcrumbs}
    lang={supportedLang}
  >
    <div class={`mt-4 flex flex-wrap justify-center gap-3 ${fontClass}`}>
      <button
        type="button"
        data-open-consultation
        class="inline-flex h-10 cursor-pointer items-center gap-1.5 rounded border border-[var(--accent-green)] bg-[var(--accent-green-dim)] px-5 font-mono text-xs font-bold text-[var(--accent-contrast)] transition-all hover:bg-[var(--accent-green)] hover:text-[#090b0e] sm:text-sm"
      >
        <span>{t('common.freeConsultation', { fallback: 'Get Regional SEO Consultation' })}</span>
        <span aria-hidden="true">{isRtl ? '←' : '→'}</span>
      </button>
    </div>
  </Hero>

  <!-- Regional Uplink & Network Telemetry Stage -->
  <section class={`border-b border-[var(--border-hairline)] bg-[var(--bg-canvas)] py-8 ${fontClass}`}>
    <div class="container mx-auto max-w-5xl px-4">
      <AsciiStage
        id="service-areas-radar-stage"
        lang={supportedLang}
        defaultPiece="world-map-pings"
        title={
          supportedLang === 'fa'
            ? 'رادار ارتباطات منطقه‌ای و گره‌های شبکه خاورمیانه'
            : supportedLang === 'ar'
              ? 'شبكة التغطية الإقليمية وعقد الاتصال في الشرق الأوسط'
              : 'Middle East Regional Nodes & Telemetry'
        }
        meta="68×18 · 24 fps · Live Network"
      />
    </div>
  </section>

  <!-- Locations list -->
  <section class={`bg-[var(--bg-canvas)] py-12 md:py-16 ${fontClass}`}>
    <div class="container mx-auto max-w-5xl px-4">
      <div class="mb-8 text-center">
        <span class="slash-eyebrow text-xs" dir={isRtl ? 'rtl' : 'ltr'}>
          {
            supportedLang === 'fa'
              ? '/مراکز-منطقه‌ای · سئو محلی و توسعه وب'
              : supportedLang === 'ar'
                ? '/المراكز-الإقليمية · السيو المحلي وتطوير المواقع'
                : '/REGIONAL-HUBS · LOCAL SEO & WEB DEV'
          }
        </span>
        <h2 class="mt-1 text-2xl font-bold text-[var(--text-primary)] sm:text-3xl">
          {
            supportedLang === 'fa'
              ? 'مناطق تحت پوشش خدمات وب اِی‌بی‌سی'
              : supportedLang === 'ar'
                ? 'المناطق الجغرافية لخدماتنا'
                : 'Explore Our Service Locations'
          }
        </h2>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          locationsList.map((loc: any, idx: number) => (
            <div class="terminal-window flex flex-col justify-between">
              <div>
                <div class="terminal-chrome-bar" dir="ltr">
                  <span class="font-mono text-xs font-bold text-[var(--accent-green)]">
                    [HUB 0{idx + 1}] /{loc.slug}
                  </span>
                  {loc.country && (
                    <span class="monospace-telemetry-pill">{loc.country}</span>
                  )}
                </div>

                <div class="space-y-3 p-6">
                  <h3 class="text-xl font-bold text-[var(--text-primary)]">
                    <a
                      href={`/${supportedLang}/service-areas/${loc.slug}/`}
                      class="transition-colors hover:text-[var(--accent-green)]"
                    >
                      {loc.name}
                    </a>
                  </h3>
                  <p class="text-sm leading-relaxed text-[var(--text-secondary)]">
                    {loc.description}
                  </p>
                </div>
              </div>

              <div class="flex items-center justify-between border-t border-[var(--border-hairline)] bg-[var(--bg-elevated)] px-6 py-3">
                <button
                  type="button"
                  data-consult-service={`Local SEO & Web Design (${loc.name})`}
                  class="cursor-pointer font-mono text-xs font-bold text-[var(--accent-green)] hover:underline"
                >
                  {t('common.freeConsultation', { fallback: 'Free Consultation' })} →
                </button>
                <a
                  href={`/${supportedLang}/service-areas/${loc.slug}/`}
                  class="font-mono text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
                >
                  {t('common.viewDetails', { fallback: 'View Details' })} {isRtl ? '←' : '→'}
                </a>
              </div>
            </div>
          ))
        }
      </div>

      <div class="mt-12">
        <CTA lang={supportedLang} />
      </div>
    </div>
  </section>
</Layout>
