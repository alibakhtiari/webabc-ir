---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/astro/Breadcrumbs.astro';
import AsciiStage from '@/components/astro/AsciiStage.astro';
import { getLanguageStaticPaths, type SupportedLanguage, languages } from '@/types/language';
import { getDictionary } from '@/i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);
const isRtl = languages[supportedLang]?.direction === 'rtl';
const fontClass =
  supportedLang === 'fa' ? 'font-persian' : supportedLang === 'ar' ? 'font-arabic' : 'font-sans';

const t = createTranslator(dictionary);

const titleText = t('contact.title', { fallback: 'Contact Us' });
const descriptionText = t('contact.subtitle', { fallback: 'Get in Touch with Our Team' });
const headingText = t('contact.getInTouch', { fallback: 'Get In Touch' });
const formTitle = t('contact.sendMessage', { fallback: 'Send Us A Message' });
const formDescription = t('contact.consultation.description', {
  fallback: 'Fill in the form below and our experts will contact you shortly.',
});
const submitLabel = t('contact.submitMessage', { fallback: 'Send Message' });

const whatsappMessages: Record<string, string> = {
  fa: 'سلام، برای مشاوره و همکاری با وب‌آ‌بی‌سی پیام می‌دهم.',
  ar: 'مرحباً، أتواصل معكم للاستفسار عن خدمات ومشاريع ويب أيه بي سي.',
  en: 'Hello, reaching out to inquire about WebABC web design and SEO services.',
};
const waMsg = encodeURIComponent(whatsappMessages[supportedLang] || whatsappMessages.en);
const whatsappUrl = `https://wa.me/989125811880?text=${waMsg}`;

const quickTopics =
  supportedLang === 'fa'
    ? [
        'سئو و رتبه ۱ گوگل',
        'طراحی سایت اختصاصی',
        'طراحی فروشگاه ووکامرس',
        'بهینه‌سازی سرعت و CWV',
        'ممیزی UI/UX و افزایش فروش',
      ]
    : supportedLang === 'ar'
      ? [
          'تحسين محركات البحث (SEO)',
          'تصميم وتطوير موقع مخصص',
          'متجر إلكتروني ووكومرس',
          'تحسين السرعة و Core Web Vitals',
          'تدقيق UI/UX وزيادة المبيعات',
        ]
      : [
          'SEO & #1 Google Ranking',
          'Custom Website Design',
          'WordPress / WooCommerce Store',
          'Speed & Core Web Vitals',
          'UI/UX Conversion Audit',
        ];

const contactPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  '@id': `https://webabc.ir/${supportedLang}/contact/#webpage`,
  url: `https://webabc.ir/${supportedLang}/contact/`,
  name: titleText,
  description: descriptionText,
  inLanguage: supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR',
  isPartOf: {
    '@type': 'WebSite',
    '@id': `https://webabc.ir/${supportedLang}/#website`,
    name: 'WebABC',
    url: `https://webabc.ir/${supportedLang}/`,
  },
  mainEntity: {
    '@id': 'https://webabc.ir/#organization',
  },
};

const breadcrumbs = [{ label: t('common.home'), url: `/${supportedLang}/` }, { label: headingText }];
---

<Layout title={titleText} description={descriptionText} lang={supportedLang} slug="contact">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(contactPageSchema)} />

  <div class={`mx-auto w-full max-w-6xl px-4 pt-10 pb-16 sm:px-6 lg:px-8 ${fontClass}`}>
    <div class="mx-auto max-w-2xl text-center">
      <Breadcrumbs items={breadcrumbs} lang={supportedLang} centered />
      <div class="mb-2 flex justify-center">
        <span class="slash-eyebrow text-xs" dir={isRtl ? 'rtl' : 'ltr'}>
          {
            supportedLang === 'fa'
              ? '/تماس-با-ما · مشاوره مستقیم فنی و مهندسی'
              : supportedLang === 'ar'
                ? '/اتصل-بنا · استشارة هندسية وتقنية مباشرة'
                : '/CONTACT · DIRECT ENGINEERING CONSULTATION'
          }
        </span>
      </div>
      <h1 class="mb-3 text-3xl leading-tight font-bold text-[var(--text-primary)] md:text-5xl">
        {headingText}
      </h1>
      <p class="text-base leading-relaxed text-[var(--text-secondary)] sm:text-lg">
        {descriptionText}
      </p>
    </div>

    <div class="mt-10 grid gap-8 lg:grid-cols-5 lg:gap-10">
      <div class="terminal-window lg:col-span-3">
        <div class="terminal-chrome-bar" dir={isRtl ? 'rtl' : 'ltr'}>
          <span class="font-mono text-xs font-bold text-[var(--accent-green)]">
            {
              supportedLang === 'fa'
                ? '╭─ /ارسال-پیام · استعلام پروژه و آنالیز رایگان سئو ─╮'
                : supportedLang === 'ar'
                  ? '╭─ /إرسال-طلب · تدقيق مجاني واستشارة للمشروع ─╮'
                  : '╭─ /SEND-INQUIRY · FREE PROJECT & SEO AUDIT ─╮'
            }
          </span>
          <span class="monospace-telemetry-pill">
            {
              supportedLang === 'fa'
                ? 'پاسخ‌گویی زیر ۲ ساعت'
                : supportedLang === 'ar'
                  ? 'الرد خلال أقل من ساعتين'
                  : 'SLA < 2 HOURS'
            }
          </span>
        </div>

        <div class="p-6 sm:p-8">
          <h2 class="text-2xl font-bold text-[var(--text-primary)]">
            {formTitle}
          </h2>
          <p class="mt-1.5 text-sm leading-relaxed text-[var(--text-secondary)]">
            {formDescription}
          </p>

          <!-- CRO Quick Topic Chips (One-click pre-fill to reduce typing friction) -->
          <div class="mt-4">
            <span class="mb-2 block font-mono text-[11px] text-[var(--text-secondary)]">
              {supportedLang === 'fa'
                ? 'انتخاب سریع موضوع پروژه (اختیاری):'
                : supportedLang === 'ar'
                  ? 'اختر موضوع مشروعك سريعاً (اختياري):'
                  : 'QUICK TOPIC SELECT (OPTIONAL):'}
            </span>
            <div class="flex flex-wrap gap-1.5">
              {
                quickTopics.map((topic) => (
                  <button
                    type="button"
                    data-topic-chip={topic}
                    class="look-pill text-xs"
                  >
                    <span>+ {topic}</span>
                  </button>
                ))
              }
            </div>
          </div>

          <form
            id="contact-form"
            class="mt-6 space-y-4"
            novalidate
            data-captcha-required={t('contact.captchaRequired', {
              fallback: 'Please complete the verification captcha.',
            })}
            data-sending={t('contact.sending', { fallback: 'Sending...' })}
            data-success={t('contact.messageSent', { fallback: 'Message sent successfully!' })}
            data-error={t('contact.messageFailed', { fallback: 'Failed to send message.' })}
            data-unexpected={t('contact.unexpectedError', {
              fallback: 'An error occurred. Please try again.',
            })}
            data-submit-label={submitLabel}
            data-err-name={t('contact.consultation.fullNameRequired', {
              fallback: 'Full name is required',
            })}
            data-err-email={t('contact.consultation.emailInvalid', {
              fallback: 'Please enter a valid email address',
            })}
            data-err-message={t('contact.messageTooShort', {
              fallback: 'Please write at least 10 characters.',
            })}
          >
            <div class="hidden" aria-hidden="true">
              <label for="contact-company">Company</label>
              <input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <div>
              <label
                for="contact-name"
                class="mb-1.5 block text-start text-xs font-semibold text-[var(--text-secondary)]"
              >
                {t('contact.consultation.fullName', { fallback: 'Full Name' })}{' '}
                <span class="text-[var(--accent-coral)]" aria-hidden="true">*</span>
              </label>
              <input
                id="contact-name"
                name="name"
                type="text"
                required
                minlength="2"
                maxlength="100"
                autocomplete="name"
                aria-describedby="contact-name-error"
                placeholder={t('contact.consultation.fullName', { fallback: 'Full Name' })}
                class="h-11 w-full rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3.5 text-sm text-[var(--text-primary)] transition-colors focus:border-[var(--accent-green)] focus:outline-none aria-[invalid=true]:border-[var(--accent-coral)]"
              />
              <p id="contact-name-error" class="mt-1 hidden text-start text-xs text-[var(--accent-coral)]"></p>
            </div>

            <div>
              <label
                for="contact-email"
                class="mb-1.5 block text-start text-xs font-semibold text-[var(--text-secondary)]"
              >
                {t('contact.formEmail', { fallback: 'Email' })}{' '}
                <span class="text-[var(--accent-coral)]" aria-hidden="true">*</span>
              </label>
              <input
                id="contact-email"
                name="email"
                type="email"
                required
                maxlength="254"
                autocomplete="email"
                inputmode="email"
                dir="ltr"
                aria-describedby="contact-email-error"
                placeholder="example@domain.com"
                class="ltr-isolate h-11 w-full rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-3.5 font-mono text-sm text-[var(--text-primary)] transition-colors focus:border-[var(--accent-green)] focus:outline-none aria-[invalid=true]:border-[var(--accent-coral)]"
              />
              <p id="contact-email-error" class="mt-1 hidden text-start text-xs text-[var(--accent-coral)]"></p>
            </div>

            <div>
              <label
                for="contact-message"
                class="mb-1.5 block text-start text-xs font-semibold text-[var(--text-secondary)]"
              >
                {t('contact.consultation.message', { fallback: 'Message' })}{' '}
                <span class="text-[var(--accent-coral)]" aria-hidden="true">*</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="4"
                required
                minlength="10"
                maxlength="5000"
                aria-describedby="contact-message-hint contact-message-error"
                placeholder={t('contact.yourMessage', { fallback: 'Write your message...' })}
                class="w-full resize-none rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] p-3.5 text-sm text-[var(--text-primary)] transition-colors focus:border-[var(--accent-green)] focus:outline-none aria-[invalid=true]:border-[var(--accent-coral)]"
              ></textarea>
              <p id="contact-message-hint" class="mt-1 text-start text-xs text-[var(--text-secondary)]">
                {
                  t('contact.messageHint', {
                    fallback: 'Tell us about your project, goals, and timeline (min. 10 characters).',
                  })
                }
              </p>
              <p id="contact-message-error" class="mt-1 hidden text-start text-xs text-[var(--accent-coral)]"></p>
            </div>

            <div id="captcha-container" class="flex min-h-18 justify-center">
              <div
                class="cf-turnstile"
                data-sitekey="0x4AAAAAAD7BmzK13TeKwviJ"
                data-theme="auto"
                data-callback="onTurnstileVerify"
                data-expired-callback="onTurnstileExpired"
                data-error-callback="onTurnstileError"
              >
              </div>
            </div>

            <button
              type="submit"
              id="submit-btn"
              class="flex h-11 w-full cursor-pointer items-center justify-center gap-2 rounded border border-[var(--accent-green)] bg-[var(--accent-green-dim)] font-mono text-sm font-bold text-[var(--accent-contrast)] transition-all hover:bg-[var(--accent-green)] hover:text-[#090b0e] disabled:cursor-not-allowed disabled:opacity-70"
            >
              <svg
                id="submit-spinner"
                class="hidden h-5 w-5 animate-spin"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4z"></path>
              </svg>
              <span id="submit-btn-label">{submitLabel}</span>
            </button>

            <p
              id="response-msg"
              role="status"
              aria-live="polite"
              class="hidden rounded px-4 py-3 text-center font-mono text-xs font-medium"
            >
            </p>
          </form>
        </div>
      </div>

      <aside class="space-y-6 lg:col-span-2">
        <div class="terminal-window">
          <div class="terminal-chrome-bar" dir={isRtl ? 'rtl' : 'ltr'}>
            <span>
              {
                supportedLang === 'fa'
                  ? '/راه‌های-ارتباط-مستقیم'
                  : supportedLang === 'ar'
                    ? '/قنوات-الاتصال-المباشرة'
                    : '/DIRECT-CHANNELS'
              }
            </span>
            <span class="monospace-telemetry-pill">
              {
                supportedLang === 'fa'
                  ? 'پاسخگویی سریع'
                  : supportedLang === 'ar'
                    ? 'استجابة سريعة'
                    : 'FAST RESPONSE'
              }
            </span>
          </div>

          <div class="p-6">
            <h2 class="mb-4 text-lg font-bold text-[var(--text-primary)]">
              {t('contact.contactInfo', { fallback: 'Contact Info' })}
            </h2>
            <ul class="space-y-4 text-sm">
              <li>
                <div class="font-mono text-xs font-bold text-[var(--accent-purple)]" dir={isRtl ? 'rtl' : 'ltr'}>
                  {supportedLang === 'fa' ? '[آدرس]' : supportedLang === 'ar' ? '[العنوان]' : '[ADDRESS]'}
                </div>
                <p class="mt-1 text-xs leading-relaxed text-[var(--text-secondary)] sm:text-sm">
                  {
                    t('contact.addressValue', {
                      fallback: 'Qazvin Science & Technology Park, Km 2 Barajin Road, Qazvin, Iran',
                    })
                  }
                </p>
                <a
                  href="https://www.google.com/maps/search/?api=1&query=36.3156,50.0381"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-1.5 inline-flex items-center gap-1 font-mono text-xs font-bold text-[var(--accent-blue)] hover:underline"
                >
                  <span>{t('contact.locationMap', { fallback: 'View on Map' })}</span>
                  <span>{isRtl ? '←' : '→'}</span>
                </a>
              </li>

              <li>
                <div class="font-mono text-xs font-bold text-[var(--accent-green)]" dir={isRtl ? 'rtl' : 'ltr'}>
                  {supportedLang === 'fa' ? '[شماره تماس]' : supportedLang === 'ar' ? '[الهاتف]' : '[TELEPHONE]'}
                </div>
                <p class="mt-1 font-mono text-sm text-[var(--text-primary)]" dir="ltr">
                  <a href="tel:+989125811880" class="hover:text-[var(--accent-green)]">
                    {t('contact.phoneValue', { fallback: '+98 912 581 1880' })}
                  </a>
                </p>
                <p class="mt-0.5 font-mono text-sm text-[var(--text-primary)]" dir="ltr">
                  <a href="tel:+989354767068" class="hover:text-[var(--accent-green)]">
                    {t('contact.phoneValue2', { fallback: '+98 935 476 7068' })}
                  </a>
                </p>
              </li>

              <li>
                <div class="font-mono text-xs font-bold text-[var(--accent-blue)]" dir={isRtl ? 'rtl' : 'ltr'}>
                  {supportedLang === 'fa' ? '[ایمیل]' : supportedLang === 'ar' ? '[البريد الإلكتروني]' : '[EMAIL]'}
                </div>
                <p class="mt-1 font-mono text-sm text-[var(--text-primary)]" dir="ltr">
                  <a href="mailto:info@webabc.ir" class="hover:text-[var(--accent-blue)]">info@webabc.ir</a>
                </p>
              </li>
            </ul>

            <div class="mt-6 grid grid-cols-2 gap-2.5">
              <a
                href="tel:+989125811880"
                class="flex h-10 items-center justify-center rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] font-mono text-xs font-bold text-[var(--text-primary)] transition-colors hover:border-[var(--accent-blue)] hover:text-[var(--accent-blue)]"
              >
                {t('contact.callNow', { fallback: 'Call Now' })}
              </a>
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-10 items-center justify-center rounded border border-[var(--accent-green)] bg-[var(--accent-green-dim)] font-mono text-xs font-bold text-[var(--accent-contrast)] transition-colors hover:bg-[var(--accent-green)] hover:text-[#090b0e]"
              >
                {t('contact.whatsappChat', { fallback: 'Chat on WhatsApp' })}
              </a>
            </div>
          </div>
        </div>

        <!-- Live Middle East Radar & Uplink Telemetry -->
        <div class="terminal-window">
          <AsciiStage
            id="contact-satellite-uplink"
            lang={supportedLang}
            defaultPiece="webabc-logo-orbit"
            title={
              supportedLang === 'fa'
                ? '/رادار-ارتباطی · گره‌های شبکه خاورمیانه'
                : supportedLang === 'ar'
                  ? '/الرادار-الإقليمي · شبكة محطات الشرق الأوسط'
                  : '/REGIONAL-RADAR · Middle East Telemetry Hubs'
            }
            meta="66×17 · 24 fps"
            size={11}
            ariaLabel="Middle East Regional Telemetry Radar"
          />
        </div>

        <div class="terminal-window">
          <div class="terminal-chrome-bar" dir={isRtl ? 'rtl' : 'ltr'}>
            <span>
              {
                supportedLang === 'fa'
                  ? '/مراحل-همکاری'
                  : supportedLang === 'ar'
                    ? '/الخطوات-التالية'
                    : '/NEXT-STEPS'
              }
            </span>
            <span class="monospace-telemetry-pill">
              {
                supportedLang === 'fa'
                  ? '۳ مرحله'
                  : supportedLang === 'ar'
                    ? '3 مراحل'
                    : '3 STAGES'
              }
            </span>
          </div>
          <div class="p-6">
            <h2 class="mb-4 text-lg font-bold text-[var(--text-primary)]">
              {t('contact.processTitle', { fallback: 'What Happens Next' })}
            </h2>
            <ol class="space-y-3.5 text-xs sm:text-sm">
              <li class="flex gap-2.5">
                <span class="ltr-isolate font-mono font-bold text-[var(--accent-green)]" dir="ltr">[01]</span>
                <p class="leading-relaxed text-[var(--text-secondary)]">
                  {t('contact.step1', { fallback: 'You send the form with a short description of your project or goal.' })}
                </p>
              </li>
              <li class="flex gap-2.5">
                <span class="ltr-isolate font-mono font-bold text-[var(--accent-green)]" dir="ltr">[02]</span>
                <p class="leading-relaxed text-[var(--text-secondary)]">
                  {t('contact.step2', { fallback: 'We review your site and reply within one business day with initial questions.' })}
                </p>
              </li>
              <li class="flex gap-2.5">
                <span class="ltr-isolate font-mono font-bold text-[var(--accent-green)]" dir="ltr">[03]</span>
                <p class="leading-relaxed text-[var(--text-secondary)]">
                  {t('contact.step3', { fallback: 'We schedule a free consultation call and send a fixed-price proposal with scope and timeline.' })}
                </p>
              </li>
            </ol>
          </div>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script is:inline>
  (() => {
    let verifiedToken = null;

    window.onTurnstileVerify = function (token) {
      verifiedToken = token;
    };
    window.onTurnstileExpired = function () {
      verifiedToken = null;
    };
    window.onTurnstileError = function () {
      verifiedToken = null;
    };

    function initContactForm() {
      const form = document.getElementById('contact-form');
      const submitBtn = document.getElementById('submit-btn');
      const submitBtnLabel = document.getElementById('submit-btn-label');
      const submitSpinner = document.getElementById('submit-spinner');
      const responseMsg = document.getElementById('response-msg');
      const msgTextarea = document.getElementById('contact-message');

      // Quick topic chips
      document.querySelectorAll('[data-topic-chip]').forEach((chip) => {
        chip.onclick = () => {
          const topic = chip.getAttribute('data-topic-chip');
          chip.classList.toggle('is-active');
          if (msgTextarea && topic) {
            const prefix = `[Topic: ${topic}] `;
            if (!msgTextarea.value.includes(prefix)) {
              msgTextarea.value = prefix + msgTextarea.value;
            }
            msgTextarea.focus();
          }
        };
      });

      if (!form || form.dataset.bound === 'true') return;
      form.dataset.bound = 'true';

      const msg = (key, fallback) => form.dataset[key] || fallback;
      const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      const fields = {
        name: {
          input: document.getElementById('contact-name'),
          error: document.getElementById('contact-name-error'),
        },
        email: {
          input: document.getElementById('contact-email'),
          error: document.getElementById('contact-email-error'),
        },
        message: {
          input: document.getElementById('contact-message'),
          error: document.getElementById('contact-message-error'),
        },
      };

      const setFieldError = (field, message) => {
        if (!field || !field.input || !field.error) return;
        if (message) {
          field.error.textContent = message;
          field.error.classList.remove('hidden');
          field.input.setAttribute('aria-invalid', 'true');
        } else {
          field.error.textContent = '';
          field.error.classList.add('hidden');
          field.input.removeAttribute('aria-invalid');
        }
      };

      const clearAllErrors = () => {
        Object.values(fields).forEach((f) => setFieldError(f, ''));
      };

      const showStatus = (text, ok) => {
        responseMsg.textContent = text;
        responseMsg.classList.remove('hidden');
        responseMsg.className = ok
          ? 'rounded border border-[var(--accent-green)] bg-[var(--bg-canvas)] px-4 py-3 text-center font-mono text-xs font-medium text-[var(--accent-green)] block'
          : 'rounded border border-[var(--accent-coral)] bg-[var(--bg-canvas)] px-4 py-3 text-center font-mono text-xs font-medium text-[var(--accent-coral)] block';
      };

      const hideStatus = () => {
        responseMsg.textContent = '';
        responseMsg.classList.add('hidden');
      };

      Object.values(fields).forEach((f) => {
        if (f.input) {
          f.input.addEventListener('input', () => setFieldError(f, ''));
        }
      });

      const setLoading = (loading) => {
        submitBtn.disabled = loading;
        submitSpinner.classList.toggle('hidden', !loading);
        submitBtnLabel.textContent = loading
          ? msg('sending', 'Sending...')
          : msg('submitLabel', 'Send Message');
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        clearAllErrors();
        hideStatus();

        const formData = new FormData(form);
        const payload = {
          name: String(formData.get('name') || '').trim(),
          email: String(formData.get('email') || '').trim(),
          message: String(formData.get('message') || '').trim(),
          company: String(formData.get('company') || ''),
          token: verifiedToken,
        };

        let firstInvalid = null;
        if (payload.name.length < 2) {
          setFieldError(fields.name, msg('errName', 'Full name is required'));
          firstInvalid = firstInvalid || fields.name.input;
        }
        if (!emailRe.test(payload.email)) {
          setFieldError(fields.email, msg('errEmail', 'Please enter a valid email address'));
          firstInvalid = firstInvalid || fields.email.input;
        }
        if (payload.message.length < 10) {
          setFieldError(fields.message, msg('errMessage', 'Please write at least 10 characters.'));
          firstInvalid = firstInvalid || fields.message.input;
        }
        if (firstInvalid) {
          firstInvalid.focus();
          return;
        }

        if (!verifiedToken) {
          showStatus(msg('captchaRequired', 'Please complete the verification captcha.'), false);
          return;
        }

        setLoading(true);

        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 15000);

        try {
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(payload),
            signal: controller.signal,
          });

          let result = {};
          try {
            result = await res.json();
          } catch {
            result = {};
          }

          if (res.ok && (result.success || !result.error)) {
            showStatus(result.message || msg('success', 'Message sent successfully!'), true);
            form.reset();
            if (window.turnstile) window.turnstile.reset();
            verifiedToken = null;
          } else {
            const code = result.code;
            if (code === 'invalid_name') {
              setFieldError(fields.name, msg('errName', result.error || 'Invalid name'));
              fields.name.input.focus();
            } else if (code === 'invalid_email') {
              setFieldError(fields.email, msg('errEmail', result.error || 'Invalid email'));
              fields.email.input.focus();
            } else if (code === 'invalid_message') {
              setFieldError(fields.message, msg('errMessage', result.error || 'Invalid message'));
              fields.message.input.focus();
            }
            showStatus(
              code === 'invalid_captcha'
                ? msg('captchaRequired', result.error || 'Invalid captcha')
                : result.error && !code
                  ? result.error
                  : code && code.startsWith('invalid_')
                    ? msg('error', 'Failed to send message.')
                    : result.error || msg('error', 'Failed to send message.'),
              false
            );
          }
        } catch (error) {
          showStatus(msg('unexpected', 'An error occurred. Please try again.'), false);
        } finally {
          clearTimeout(timeout);
          setLoading(false);
        }
      });
    }

    document.addEventListener('astro:page-load', initContactForm);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initContactForm();
    }
  })();
</script>
