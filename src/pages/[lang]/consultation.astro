<script is:inline>
  (function () {
    function initConsultationPage() {
      const form = document.getElementById('consultation-page-form');
      if (!form || form.dataset.bound === 'true') return;
      form.dataset.bound = 'true';

      const nameInput = document.getElementById('consult-name');
      const phoneInput = document.getElementById('consult-phone');
      const websiteInput = document.getElementById('consult-website');
      const msgInput = document.getElementById('consult-message');
      const topicInput = document.getElementById('consult-selected-topic');
      const nameErr = document.getElementById('consult-name-err');
      const phoneErr = document.getElementById('consult-phone-err');
      const submitBtn = document.getElementById('consult-submit-btn');
      const submitSpinner = document.getElementById('consult-spinner');
      const submitLabel = document.getElementById('consult-submit-label');
      const statusMsg = document.getElementById('consult-status-msg');
      const chipsContainer = document.getElementById('topic-chips-container');

      // Chip selection logic
      if (chipsContainer && topicInput) {
        chipsContainer.addEventListener('click', (e) => {
          const btn = e.target.closest('button[data-topic]');
          if (!btn) return;
          const topic = btn.getAttribute('data-topic');
          topicInput.value = topic;

          chipsContainer.querySelectorAll('button[data-topic]').forEach((b) => {
            b.classList.remove('border-primary', 'bg-primary/10', 'text-primary');
            b.classList.add('border-gray-200', 'bg-gray-50', 'text-gray-700');
          });
          btn.classList.remove('border-gray-200', 'bg-gray-50', 'text-gray-700');
          btn.classList.add('border-primary', 'bg-primary/10', 'text-primary');
        });
      }

      const showStatus = (text, isOk) => {
        if (!statusMsg) return;
        statusMsg.textContent = text;
        statusMsg.classList.remove('hidden');
        statusMsg.className = isOk
          ? 'rounded-lg border border-emerald-500/30 bg-emerald-50 px-4 py-3 text-center text-xs font-semibold text-emerald-800 dark:bg-emerald-950/30 dark:text-emerald-400 block'
          : 'rounded-lg border border-rose-500/30 bg-rose-50 px-4 py-3 text-center text-xs font-semibold text-rose-800 dark:bg-rose-950/30 dark:text-rose-400 block';
      };

      const clearErrors = () => {
        if (nameErr) nameErr.classList.add('hidden');
        if (phoneErr) phoneErr.classList.add('hidden');
        if (statusMsg) statusMsg.classList.add('hidden');
      };

      if (nameInput) nameInput.addEventListener('input', () => nameErr && nameErr.classList.add('hidden'));
      if (phoneInput) phoneInput.addEventListener('input', () => phoneErr && phoneErr.classList.add('hidden'));

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        clearErrors();

        const nameVal = (nameInput ? nameInput.value : '').trim();
        const phoneVal = (phoneInput ? phoneInput.value : '').trim();
        const websiteVal = (websiteInput ? websiteInput.value : '').trim();
        const rawMsgVal = (msgInput ? msgInput.value : '').trim();
        const topicVal = (topicInput ? topicInput.value : '').trim();
        const companyVal = (form.querySelector('input[name="company"]')?.value || '').trim();

        let hasError = false;
        if (nameVal.length < 2) {
          if (nameErr) {
            nameErr.textContent = 'لطفاً نام خود را کامل وارد کنید (حداقل ۲ کاراکتر).';
            nameErr.classList.remove('hidden');
          }
          if (!hasError && nameInput) nameInput.focus();
          hasError = true;
        }

        const phoneRe = /^[\d+\-\s()]{7,25}$/;
        if (!phoneRe.test(phoneVal)) {
          if (phoneErr) {
            phoneErr.textContent = 'لطفاً یک شماره تماس معتبر وارد کنید.';
            phoneErr.classList.remove('hidden');
          }
          if (!hasError && phoneInput) phoneInput.focus();
          hasError = true;
        }

        if (hasError) return;

        const constructedMessage = `[درخواست مشاوره تلفنی فوری] موضوع: ${topicVal}${websiteVal ? ` | وب‌سایت: ${websiteVal}` : ''}${rawMsgVal ? ` | پیام: ${rawMsgVal}` : ' | درخواست بررسی و تماس تلفنی'}`;

        const payload = {
          name: nameVal,
          phone: phoneVal,
          message: constructedMessage,
          company: companyVal,
        };

        if (submitBtn) submitBtn.disabled = true;
        if (submitSpinner) submitSpinner.classList.remove('hidden');
        if (submitLabel) submitLabel.textContent = 'در حال ثبت درخواست...';

        try {
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(payload),
          });

          const data = await res.json().catch(() => ({}));
          if (res.ok && (data.success || !data.error)) {
            showStatus('✓ درخواست شما با موفقیت ثبت شد. کارشناسان ما در سریع‌ترین زمان (کمتر از ۲ ساعت) با شما تماس خواهند گرفت.', true);
            form.reset();
          } else {
            showStatus(data.error || 'خطا در ثبت درخواست. لطفاً مجدداً تلاش نمایید یا مستقیماً تماس بگیرید.', false);
          }
        } catch (err) {
          showStatus('خطا در برقراری ارتباط با سرور. لطفاً مستقیماً تماس بگیرید.', false);
        } finally {
          if (submitBtn) submitBtn.disabled = false;
          if (submitSpinner) submitSpinner.classList.add('hidden');
          if (submitLabel) submitLabel.textContent = 'درخواست تماس و مشاوره تلفنی →';
        }
      });
    }

    document.addEventListener('astro:page-load', initConsultationPage);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initConsultationPage();
    }
  })();
</script>
