---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/astro/Breadcrumbs.astro';
import { type SupportedLanguage } from '../../types/language';
import { getDictionary } from '../../i18n/get-dictionary';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'fa' } },
    { params: { lang: 'ar' } },
  ];
}

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);

// Helper to translate strings
const t = (key: string, options?: { fallback: string }) => {
  const parts = key.split('.');
  let current: any = dictionary;
  for (const part of parts) {
    if (current && current[part] !== undefined) {
      current = current[part];
    } else {
      return options?.fallback || key;
    }
  }
  return typeof current === 'string' ? current : options?.fallback || key;
};

const titleText = t('about.title', { fallback: 'About Us' });
const descriptionText = t('about.subtitle', { fallback: 'We build digital solutions.' });

const aboutPageSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": titleText,
  "description": descriptionText,
  "mainEntity": {
    "@id": "https://webabc.ir/#organization"
  },
  "inLanguage": supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR'
};

const breadcrumbs = [
  { label: t('common.home'), url: `/${supportedLang}` },
  { label: titleText }
];
---

<Layout title={titleText} description={descriptionText} lang={supportedLang} slug="about">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(aboutPageSchema)} />

  <div class="max-w-6xl mx-auto pt-36 pb-12 px-4 sm:px-6 lg:px-8 w-full font-sans">
    <div class="space-y-16">
      
      <!-- Hero Section -->
      <div class="text-center">
        <Breadcrumbs items={breadcrumbs} lang={supportedLang} />
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4 leading-normal font-persian">
          {titleText}
        </h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto font-persian">
          {descriptionText}
        </p>
      </div>

      <!-- Mission Section -->
      <div class="p-8 bg-linear-to-br from-blue-50 to-purple-50 rounded-2xl border-0">
        <div class="max-w-3xl mx-auto text-center space-y-4">
          <h2 class="text-2xl font-semibold text-gray-800 font-persian">{t('about.mission', { fallback: 'Our Mission' })}</h2>
          <p class="text-gray-600 leading-relaxed font-persian">
            {t('about.missionText', { fallback: 'To empower businesses with high-performance web applications and search ranking optimization.' })}
          </p>
        </div>
      </div>

      <!-- Stats Section -->
      <div class="grid md:grid-cols-3 gap-8 text-center font-persian">
        <div class="py-8 border-0 bg-blue-50/80 rounded-2xl shadow-sm">
          <div class="text-3xl font-bold text-blue-600 mb-2">{t('about.stats.years.value', { fallback: '5+' })}</div>
          <div class="text-gray-700">{t('about.yearsExperience', { fallback: 'Years Experience' })}</div>
        </div>
        <div class="py-8 border-0 bg-purple-50/80 rounded-2xl shadow-sm">
          <div class="text-3xl font-bold text-purple-600 mb-2">{t('about.stats.projects.value', { fallback: '100+' })}</div>
          <div class="text-gray-700">{t('about.successfulProjects', { fallback: 'Successful Projects' })}</div>
        </div>
        <div class="py-8 border-0 bg-green-50/80 rounded-2xl shadow-sm">
          <div class="text-3xl font-bold text-green-600 mb-2">{t('about.stats.satisfaction.value', { fallback: '100%' })}</div>
          <div class="text-gray-700">{t('about.clientSatisfaction', { fallback: 'Client Satisfaction' })}</div>
        </div>
      </div>

    </div>
  </div>
</Layout>
