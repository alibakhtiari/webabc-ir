---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/astro/Breadcrumbs.astro';
import { getLanguageStaticPaths, type SupportedLanguage } from '@/types/language';
import { getDictionary } from '@/i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);

// Helper to translate strings
const t = createTranslator(dictionary);

const titleText = t('about.title', { fallback: 'About Us' });
const descriptionText = t('about.subtitle', { fallback: 'We build digital solutions.' });

const approachItems = [0, 1, 2, 3]
  .map((i) => ({
    title: t(`about.approach.items.${i}.title`, { fallback: '' }),
    description: t(`about.approach.items.${i}.description`, { fallback: '' }),
  }))
  .filter((item) => item.title && item.description);

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': `https://webabc.ir/${supportedLang}/about/#webpage`,
      url: `https://webabc.ir/${supportedLang}/about/`,
      name: titleText,
      description: descriptionText,
      inLanguage: supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR',
      isPartOf: {
        '@type': 'WebSite',
        '@id': 'https://webabc.ir/#website',
        name: 'WebABC',
        url: 'https://webabc.ir/',
      },
      about: {
        '@id': 'https://webabc.ir/#organization',
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `https://webabc.ir/${supportedLang}/about/#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: t('common.home', { fallback: 'Home' }),
          item: `https://webabc.ir/${supportedLang}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: titleText,
          item: `https://webabc.ir/${supportedLang}/about/`,
        },
      ],
    },
  ],
};

const breadcrumbs = [{ label: t('common.home'), url: `/${supportedLang}/` }, { label: titleText }];
---

<Layout title={titleText} description={descriptionText} lang={supportedLang} slug="about">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(aboutPageSchema)} />

  <div class="mx-auto w-full max-w-6xl px-4 pt-36 pb-12 font-sans sm:px-6 lg:px-8">
    <div class="space-y-16">
      <!-- Hero Section -->
      <div class="text-center">
        <Breadcrumbs items={breadcrumbs} lang={supportedLang} />
        <h1
          class="mb-4 font-persian text-4xl leading-normal font-bold text-gray-900 md:text-5xl dark:text-white"
        >
          {titleText}
        </h1>
        <p class="mx-auto max-w-2xl font-persian text-xl text-gray-600 dark:text-gray-300">
          {descriptionText}
        </p>
      </div>

      <!-- Mission Section -->
      <div
        class="rounded-2xl border border-transparent bg-linear-to-br from-blue-50 to-purple-50 p-8 dark:border-slate-800 dark:from-slate-900 dark:to-slate-800/80"
      >
        <div class="mx-auto max-w-3xl space-y-4 text-center">
          <h2 class="font-persian text-2xl font-semibold text-gray-800 dark:text-white">
            {t('about.mission', { fallback: 'Our Mission' })}
          </h2>
          <p class="font-persian leading-relaxed text-gray-600 dark:text-gray-300">
            {
              t('about.missionText', {
                fallback:
                  'To empower businesses with high-performance web applications and search ranking optimization.',
              })
            }
          </p>
        </div>
      </div>

      <!-- How We Work Section -->
      {
        approachItems.length > 0 && (
          <div class="space-y-10">
            <h2 class="text-center font-persian text-3xl font-bold text-gray-900 dark:text-white">
              {t('about.approach.title', { fallback: 'How We Work' })}
            </h2>
            <div class="grid gap-6 font-persian md:grid-cols-2">
              {approachItems.map((item) => (
                <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900">
                  <h3 class="mb-2 text-lg font-bold text-gray-800 dark:text-white">{item.title}</h3>
                  <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                    {item.description}
                  </p>
                </div>
              ))}
            </div>
          </div>
        )
      }

      <!-- Who We Serve Section -->
      <div class="mx-auto max-w-3xl space-y-4 text-center font-persian">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
          {t('about.whoWeServe.title', { fallback: 'Who We Work With' })}
        </h2>
        <p class="leading-relaxed text-gray-600 dark:text-gray-300">
          {t('about.whoWeServe.text', { fallback: '' })}
        </p>
      </div>

      <!-- Stats Section -->
      <div class="grid gap-8 text-center font-persian md:grid-cols-3">
        <div
          class="rounded-2xl border border-transparent bg-blue-50/80 py-8 shadow-sm dark:border-slate-800 dark:bg-slate-900"
        >
          <div class="mb-2 text-3xl font-bold text-blue-600 dark:text-blue-400">
            {t('about.stats.years.value', { fallback: '5+' })}
          </div>
          <div class="text-gray-700 dark:text-gray-300">
            {t('about.yearsExperience', { fallback: 'Years Experience' })}
          </div>
        </div>
        <div
          class="rounded-2xl border border-transparent bg-purple-50/80 py-8 shadow-sm dark:border-slate-800 dark:bg-slate-900"
        >
          <div class="mb-2 text-3xl font-bold text-purple-600 dark:text-purple-400">
            {t('about.stats.projects.value', { fallback: '100+' })}
          </div>
          <div class="text-gray-700 dark:text-gray-300">
            {t('about.successfulProjects', { fallback: 'Successful Projects' })}
          </div>
        </div>
        <div
          class="rounded-2xl border border-transparent bg-green-50/80 py-8 shadow-sm dark:border-slate-800 dark:bg-slate-900"
        >
          <div class="mb-2 text-3xl font-bold text-green-600 dark:text-green-400">
            {t('about.stats.satisfaction.value', { fallback: '100%' })}
          </div>
          <div class="text-gray-700 dark:text-gray-300">
            {t('about.clientSatisfaction', { fallback: 'Client Satisfaction' })}
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
