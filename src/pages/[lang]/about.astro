---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/astro/Hero.astro';
import CTA from '@/components/astro/CTA.astro';
import { getLanguageStaticPaths, type SupportedLanguage } from '@/types/language';
import { getDictionary } from '@/i18n/get-dictionary';
import { createTranslator } from '@/i18n/translate';

export const getStaticPaths = getLanguageStaticPaths;

const { lang } = Astro.params;
const supportedLang = lang as SupportedLanguage;
const dictionary = await getDictionary(supportedLang);
const isRtl = supportedLang === 'fa' || supportedLang === 'ar';
const fontClass =
  supportedLang === 'fa' ? 'font-persian' : supportedLang === 'ar' ? 'font-arabic' : 'font-sans';

const t = createTranslator(dictionary);

const titleText = t('about.title', { fallback: 'About Us' });
const descriptionText = t('about.subtitle', { fallback: 'We build digital solutions.' });
const headingText = t('common.about', { fallback: 'About Us' });

const approachItems = [0, 1, 2, 3]
  .map((i) => ({
    title: t(`about.approach.items.${i}.title`, { fallback: '' }),
    description: t(`about.approach.items.${i}.description`, { fallback: '' }),
  }))
  .filter((item) => item.title && item.description);

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `https://webabc.ir/${supportedLang}/about/#webpage`,
  url: `https://webabc.ir/${supportedLang}/about/`,
  name: titleText,
  description: descriptionText,
  inLanguage: supportedLang === 'en' ? 'en-US' : supportedLang === 'ar' ? 'ar-SA' : 'fa-IR',
  isPartOf: {
    '@type': 'WebSite',
    '@id': `https://webabc.ir/${supportedLang}/#website`,
    name: 'WebABC',
    url: `https://webabc.ir/${supportedLang}/`,
  },
  about: {
    '@id': 'https://webabc.ir/#organization',
  },
};

const breadcrumbs = [{ label: t('common.home'), url: `/${supportedLang}/` }, { label: headingText }];
---

<Layout title={titleText} description={descriptionText} lang={supportedLang} slug="about">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(aboutPageSchema)} />

  <Hero
    title={headingText}
    description={descriptionText}
    breadcrumbs={breadcrumbs}
    lang={supportedLang}
  >
    <div class={`mt-4 flex flex-wrap justify-center gap-3 ${fontClass}`}>
      <button
        type="button"
        data-open-consultation
        class="inline-flex h-10 cursor-pointer items-center gap-1.5 rounded border border-[var(--accent-green)] bg-[var(--accent-green-dim)] px-5 font-mono text-xs font-bold text-[var(--accent-contrast)] transition-all hover:bg-[var(--accent-green)] hover:text-[#090b0e] sm:text-sm"
      >
        <span>{t('common.freeConsultation', { fallback: 'Work With Our Team' })}</span>
        <span aria-hidden="true">{isRtl ? '←' : '→'}</span>
      </button>
      <a
        href={`/${supportedLang}/portfolio/`}
        class="inline-flex h-10 items-center gap-1.5 rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-4 font-mono text-xs font-bold text-[var(--text-primary)] transition-colors hover:border-[var(--accent-blue)] hover:text-[var(--accent-blue)] sm:text-sm"
      >
        <span>{t('common.viewPortfolio', { fallback: 'View Case Studies' })}</span>
      </a>
    </div>
  </Hero>

  <div class={`mx-auto w-full max-w-6xl px-4 py-12 sm:px-6 lg:px-8 ${fontClass}`}>
    <div class="space-y-12">
      <!-- Mission & Verified Stats -->
      <div class="grid gap-6 md:grid-cols-3">
        <div class="terminal-window p-6 text-center">
          <div class="font-mono text-3xl font-extrabold text-[var(--accent-green)] sm:text-4xl">
            {t('about.stats.years.value', { fallback: '10+' })}
          </div>
          <div class="mt-1 text-sm font-semibold text-[var(--text-secondary)]">
            {t('about.yearsExperience', { fallback: 'Years Experience' })}
          </div>
        </div>
        <div class="terminal-window p-6 text-center">
          <div class="font-mono text-3xl font-extrabold text-[var(--accent-blue)] sm:text-4xl">
            {t('about.stats.projects.value', { fallback: '500+' })}
          </div>
          <div class="mt-1 text-sm font-semibold text-[var(--text-secondary)]">
            {t('about.successfulProjects', { fallback: 'Successful Projects' })}
          </div>
        </div>
        <div class="terminal-window p-6 text-center">
          <div class="font-mono text-3xl font-extrabold text-[var(--accent-amber)] sm:text-4xl">
            {t('about.stats.satisfaction.value', { fallback: '98%' })}
          </div>
          <div class="mt-1 text-sm font-semibold text-[var(--text-secondary)]">
            {t('about.clientSatisfaction', { fallback: 'Client Satisfaction' })}
          </div>
        </div>
      </div>

      <!-- Mission Terminal Window -->
      <div class="terminal-window">
        <div class="terminal-chrome-bar" dir="ltr">
          <span class="slash-eyebrow text-xs" dir="ltr">/OUR-MISSION</span>
          <span class="monospace-telemetry-pill">ENGINEERING EXCELLENCE</span>
        </div>
        <div class="mx-auto max-w-3xl space-y-3 p-6 text-center sm:p-8">
          <h2 class="text-2xl font-bold text-[var(--text-primary)]">
            {t('about.mission', { fallback: 'Our Mission' })}
          </h2>
          <p class="leading-relaxed text-[var(--text-secondary)]">
            {
              t('about.missionText', {
                fallback:
                  'To empower businesses with high-performance web applications and search ranking optimization.',
              })
            }
          </p>
        </div>
      </div>

      {
        approachItems.length > 0 && (
          <div class="space-y-6">
            <div class="text-center">
              <span class="slash-eyebrow text-xs" dir="ltr">/METHODOLOGY</span>
              <h2 class="mt-1 text-2xl font-bold text-[var(--text-primary)] sm:text-3xl">
                {t('about.approach.title', { fallback: 'How We Work' })}
              </h2>
            </div>
            <div class="grid gap-5 md:grid-cols-2">
              {approachItems.map((item, idx) => (
                <div class="terminal-window p-6">
                  <div class="mb-3 flex items-center gap-2.5">
                    <span class="ltr-isolate font-mono text-sm font-bold text-[var(--accent-green)]" dir="ltr">
                      [0{idx + 1}]
                    </span>
                    <h3 class="text-lg font-bold text-[var(--text-primary)]">{item.title}</h3>
                  </div>
                  <p class="text-sm leading-relaxed text-[var(--text-secondary)]">
                    {item.description}
                  </p>
                </div>
              ))}
            </div>
          </div>
        )
      }

      <div class="terminal-window">
        <div class="terminal-chrome-bar" dir="ltr">
          <span class="slash-eyebrow text-xs" dir="ltr">/PARTNERSHIPS</span>
          <span class="monospace-telemetry-pill">MENA &amp; GLOBAL</span>
        </div>
        <div class="mx-auto max-w-3xl space-y-3 p-6 text-center sm:p-8">
          <h2 class="text-2xl font-bold text-[var(--text-primary)]">
            {t('about.whoWeServe.title', { fallback: 'Who We Work With' })}
          </h2>
          <p class="leading-relaxed text-[var(--text-secondary)]">
            {t('about.whoWeServe.text', { fallback: '' })}
          </p>
        </div>
      </div>

      <CTA
        lang={supportedLang}
        title={t('contact.consultation.title', { fallback: 'Request Free Consultation' })}
        description={t('contact.consultation.description', {
          fallback: 'Fill in the form below and our experts will contact you shortly.',
        })}
        buttonText={t('common.freeConsultation', { fallback: 'Free Consultation' })}
      />
    </div>
  </div>
</Layout>
