---
// Production worker handles 301 server-side redirect to /en/.
// This template serves as a fallback for static output, with full canonical and hreflang metadata.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WebABC – Web Design & SEO Agency</title>
    <meta
      name="description"
      content="WebABC provides high-performance web development and SEO services."
    />
    <meta name="robots" content="noindex, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://webabc.ir/en/" />
    <meta property="og:title" content="WebABC – Web Design & SEO Agency" />
    <meta property="og:image" content="https://webabc.ir/images/og-image.webp" />
    <link rel="canonical" href="https://webabc.ir/en/" />
    <link rel="alternate" hreflang="en" href="https://webabc.ir/en/" />
    <link rel="alternate" hreflang="fa" href="https://webabc.ir/fa/" />
    <link rel="alternate" hreflang="ar" href="https://webabc.ir/ar/" />
    <link rel="alternate" hreflang="x-default" href="https://webabc.ir/en/" />
    <noscript>
      <meta http-equiv="refresh" content="0;url=/en/" />
    </noscript>
    <script is:inline>
      (() => {
        const savedLang = typeof localStorage !== 'undefined' && localStorage.getItem('language');
        const supportedLangs = ['en', 'fa', 'ar'];
        const targetLang = supportedLangs.includes(savedLang) ? savedLang : 'en';
        window.location.replace('/' + targetLang + '/');
      })();
    </script>
  </head>
  <body class="flex min-h-screen items-center justify-center bg-slate-950 font-sans text-white">
    <noscript>
      <p>Redirecting to <a href="/en/" class="text-primary underline">WebABC English</a>...</p>
    </noscript>
  </body>
</html>
